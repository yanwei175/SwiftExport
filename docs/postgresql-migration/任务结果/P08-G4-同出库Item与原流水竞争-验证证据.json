  "finalSql": "SELECT uid,version,document_no,posting_status,is_deleted FROM public.inbound_document WHERE uid='b58dd7bf-095a-40d0-bb87-4a3503e9848e';\nSELECT uid,version,document_no,posting_status,is_deleted FROM public.outbound_document WHERE uid='4df39694-521c-49fa-89ec-4a3503e98506';\nSELECT uid,version,on_hand_qty,last_ledger_sequence,is_deleted FROM public.inventory_balance WHERE uid='6854a861-3728-4cb2-b6db-4a3503e984e1';\nSELECT uid,sequence,quantity_delta,balance_after,command_id,command_item_id,reversal_of_ledger_id,replacement_of_ledger_id,is_deleted FROM public.inventory_ledger_entry WHERE warehouse_site_id='ab00be69-2f47-4cb5-881b-4a3503e983c3' ORDER BY sequence;\nSELECT command_id,command_type FROM public.command_receipt WHERE command_id IN ('0a77ecca-8ebd-4da1-812f-a8f1c1f85f00','0a77ecca-8ebd-4da1-812f-a8f1c1f85f01','0a77ecca-8ebd-4da1-812f-a8f1c1f85f02','0a77ecca-8ebd-4da1-812f-a8f1c1f85f03','0a77ecca-8ebd-4da1-812f-a8f1c1f85f04','0a77ecca-8ebd-4da1-812f-a8f1c1f85f05','0a77ecca-8ebd-4da1-812f-a8f1c1f85f06','0a77ecca-8ebd-4da1-812f-a8f1c1f85f07','0a77ecca-8ebd-4da1-812f-a8f1c1f85f08','0a77ecca-8ebd-4da1-812f-a8f1c1f85f09','0a77ecca-8ebd-4da1-812f-a8f1c1f85f0a') ORDER BY command_id;\nSELECT (SELECT count(*) FROM public.inventory_ledger_entry WHERE command_item_id='55b10c45-1a10-4889-a080-4a3503e9850a') AS item_ledger_count,\n (SELECT count(*) FROM public.inventory_ledger_entry WHERE reversal_of_ledger_id='14504ccb-460c-4546-8072-4a3503e9864e') AS original_reversal_count,\n (SELECT count(*) FROM public.command_receipt WHERE command_id IN ('0a77ecca-8ebd-4da1-812f-a8f1c1f85f07','0a77ecca-8ebd-4da1-812f-a8f1c1f85f09')) AS failed_receipts,\n (SELECT count(*) FROM public.business_operation_log WHERE command_id IN ('0a77ecca-8ebd-4da1-812f-a8f1c1f85f07','0a77ecca-8ebd-4da1-812f-a8f1c1f85f09')) AS failed_logs;\nSELECT doc_type,year_month,current_no FROM public.document_sequence WHERE year_month='660210' OR (doc_type='PO' AND year_month='202610') OR (doc_type='CR' AND year_month='650410') ORDER BY doc_type,year_month;\nSELECT last_value,is_called FROM public.inventory_ledger_sequence;\nSELECT (SELECT count(*) FROM pg_stat_activity WHERE pid IN (3940,6128,4400) AND pid<>pg_backend_pid()) AS remaining_connections,\n (SELECT count(*) FROM pg_locks WHERE pid IN (3940,6128,4400) AND pid<>pg_backend_pid() AND locktype='advisory') AS remaining_advisory_locks;",
