  "finalSql": "SELECT uid,version,is_deleted,to_jsonb(h)->>'confirmation_status' AS confirmation_status,to_jsonb(h)->>'order_no' AS order_no FROM public.sales_order_header h WHERE uid IN ('96e513bb-d4ab-4495-8684-4a3503ddf34e','b3c5ab43-a7e8-41ba-8349-4a3503ddf3f6') ORDER BY uid;\nSELECT uid,source_uid,source_line_id,version,lifecycle_status,is_deleted,to_jsonb(d)->>'source_version' AS source_version FROM public.gross_demand d WHERE uid IN ('28da2f18-75fd-4b09-8aea-4a3503ddf3bc','4eec3745-a238-4a03-935a-4a3503ddf419') ORDER BY uid;\nSELECT uid,gross_demand_id,version,lifecycle_status,is_deleted,decomposition_revision,net_qty FROM public.net_demand WHERE uid IN ('b63a1c87-b287-4862-8bf3-4a3503ddf453','898c72ad-3efd-4592-b17e-4a3503ddf45c') ORDER BY uid;\nSELECT uid,version,order_no,lifecycle_status,to_jsonb(h)->>'confirmation_status' AS confirmation_status,demand_source_uid FROM public.purchase_order_head h WHERE uid='7a792690-ca8f-42d0-8dd9-4a3503ddf49f';\nSELECT uid,version,quantity,unlinked_qty,source_uid FROM public.purchase_order_line WHERE uid='a79a142d-75d1-4c6b-82ae-4a3503ddf4a1';\nSELECT command_id,command_type FROM public.command_receipt WHERE command_id IN ('eac1e32d-21b7-4f6e-84d1-a7a66ae10700','eac1e32d-21b7-4f6e-84d1-a7a66ae10702','eac1e32d-21b7-4f6e-84d1-a7a66ae10703','eac1e32d-21b7-4f6e-84d1-a7a66ae10705','eac1e32d-21b7-4f6e-84d1-a7a66ae10706','eac1e32d-21b7-4f6e-84d1-a7a66ae10707','eac1e32d-21b7-4f6e-84d1-a7a66ae10708','eac1e32d-21b7-4f6e-84d1-a7a66ae10709') ORDER BY command_id;\nSELECT (SELECT count(*) FROM public.demand_execution_link WHERE net_demand_id IN ('b63a1c87-b287-4862-8bf3-4a3503ddf453','898c72ad-3efd-4592-b17e-4a3503ddf45c') OR command_item_id='eac1e32d-21b7-4f6e-84d1-a7a66ae1070a') AS link_count,\n (SELECT count(*) FROM public.command_receipt WHERE command_id='eac1e32d-21b7-4f6e-84d1-a7a66ae10709') AS failed_receipt,\n (SELECT count(*) FROM public.business_operation_log WHERE command_id='eac1e32d-21b7-4f6e-84d1-a7a66ae10709') AS failed_log;\nSELECT doc_type,year_month,current_no FROM public.document_sequence WHERE year_month='660110' OR (doc_type='PO' AND year_month='202610') OR (doc_type='CR' AND year_month='650410') ORDER BY doc_type,year_month;\nSELECT last_value,is_called FROM public.inventory_ledger_sequence;\nSELECT (SELECT count(*) FROM pg_stat_activity WHERE pid IN (8188,7780,5232) AND pid<>pg_backend_pid()) AS remaining_candidate_connections,\n (SELECT count(*) FROM pg_locks WHERE pid IN (8188,7780,5232) AND pid<>pg_backend_pid() AND locktype='advisory') AS remaining_candidate_locks;",
