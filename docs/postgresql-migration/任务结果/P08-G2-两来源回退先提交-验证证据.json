  "uidsSql": "SELECT 'sales_order_header' AS table_name,jsonb_agg(uid ORDER BY uid)::text AS uids FROM public.sales_order_header WHERE uid IN ('96e513bb-d4ab-4495-8684-4a3503ddf34e','b3c5ab43-a7e8-41ba-8349-4a3503ddf3f6')\nUNION ALL SELECT 'sales_order_line',jsonb_agg(uid ORDER BY uid)::text FROM public.sales_order_line WHERE uid IN ('eac1e32d-21b7-4f6e-84d1-a7a66ae10701','eac1e32d-21b7-4f6e-84d1-a7a66ae10704')\nUNION ALL SELECT 'gross_demand',jsonb_agg(uid ORDER BY uid)::text FROM public.gross_demand WHERE uid IN ('28da2f18-75fd-4b09-8aea-4a3503ddf3bc','4eec3745-a238-4a03-935a-4a3503ddf419')\nUNION ALL SELECT 'net_demand',jsonb_agg(uid ORDER BY uid)::text FROM public.net_demand WHERE uid IN ('b63a1c87-b287-4862-8bf3-4a3503ddf453','898c72ad-3efd-4592-b17e-4a3503ddf45c')\nUNION ALL SELECT 'purchase_order_head',jsonb_agg(uid ORDER BY uid)::text FROM public.purchase_order_head WHERE uid='7a792690-ca8f-42d0-8dd9-4a3503ddf49f'\nUNION ALL SELECT 'purchase_order_line',jsonb_agg(uid ORDER BY uid)::text FROM public.purchase_order_line WHERE uid='a79a142d-75d1-4c6b-82ae-4a3503ddf4a1'\nUNION ALL SELECT 'business_operation_log',jsonb_agg(uid ORDER BY uid)::text FROM public.business_operation_log WHERE command_id IN ('eac1e32d-21b7-4f6e-84d1-a7a66ae10700','eac1e32d-21b7-4f6e-84d1-a7a66ae10702','eac1e32d-21b7-4f6e-84d1-a7a66ae10703','eac1e32d-21b7-4f6e-84d1-a7a66ae10705','eac1e32d-21b7-4f6e-84d1-a7a66ae10706','eac1e32d-21b7-4f6e-84d1-a7a66ae10707','eac1e32d-21b7-4f6e-84d1-a7a66ae10708','eac1e32d-21b7-4f6e-84d1-a7a66ae10709')\nUNION ALL SELECT 'command_receipt',jsonb_agg(uid ORDER BY uid)::text FROM public.command_receipt WHERE command_id IN ('eac1e32d-21b7-4f6e-84d1-a7a66ae10700','eac1e32d-21b7-4f6e-84d1-a7a66ae10702','eac1e32d-21b7-4f6e-84d1-a7a66ae10703','eac1e32d-21b7-4f6e-84d1-a7a66ae10705','eac1e32d-21b7-4f6e-84d1-a7a66ae10706','eac1e32d-21b7-4f6e-84d1-a7a66ae10707','eac1e32d-21b7-4f6e-84d1-a7a66ae10708','eac1e32d-21b7-4f6e-84d1-a7a66ae10709')\nUNION ALL SELECT 'document_sequence',jsonb_agg(uid ORDER BY uid)::text FROM public.document_sequence WHERE year_month='660110';",
