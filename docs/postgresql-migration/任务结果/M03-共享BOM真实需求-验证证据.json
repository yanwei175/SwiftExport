  "sql": {
    "digest_before": "SELECT c.relname table_name,(xpath('/row/row_count/text()',x.doc))[1]::text row_count,(xpath('/row/data_md5/text()',x.doc))[1]::text data_md5 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL (SELECT query_to_xml(format('SELECT count(*) AS row_count, md5(coalesce(string_agg(to_jsonb(t)::text, chr(10) ORDER BY to_jsonb(t)::text), '''')) AS data_md5 FROM public.%I t',c.relname),false,true,'') doc) x WHERE n.nspname='public' AND c.relkind='r' ORDER BY c.relname",
    "preflight": "SELECT current_database() AS database_name,\n(SELECT count(*) FROM public.sys_user WHERE user_name='dv' AND is_active AND NOT is_deleted) AS dv_count,\n(SELECT count(*) FROM public.product WHERE sku IN ('PGM03-36b5e4cf-R1','PGM03-36b5e4cf-R3','PGM03-36b5e4cf-C')) AS fixture_products,\n(SELECT count(*) FROM public.bom WHERE bom_no='PGM03-36b5e4cf') AS fixture_boms,\n(SELECT count(*) FROM public.command_receipt WHERE command_id IN ('36b5e4cf-f981-4356-bc94-54f8a8a69100','36b5e4cf-f981-4356-bc94-54f8a8a69101','36b5e4cf-f981-4356-bc94-54f8a8a69102')) AS receipts,\n(SELECT count(*) FROM public.business_operation_log WHERE command_id IN ('36b5e4cf-f981-4356-bc94-54f8a8a69100','36b5e4cf-f981-4356-bc94-54f8a8a69101','36b5e4cf-f981-4356-bc94-54f8a8a69102')) AS logs,\n(SELECT count(*) FROM public.document_sequence WHERE doc_type='SO' AND year_month='670310') AS sequence_rows,\n(SELECT last_value FROM public.inventory_ledger_sequence) AS inventory_sequence,\n(SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND backend_type='client backend' AND state='active' AND pid<>pg_backend_pid()) AS active_other_backends;",
    "ids_corrected": "SELECT 'product' AS table_name,uid::text AS uid FROM public.product WHERE uid IN ('a0d0986a-981b-498d-9127-4a35040fc82c','578d52ce-96be-4388-856a-4a35040fc840','b1932f3b-0291-4e4d-9622-4a35040fc843') UNION ALL SELECT 'bom' AS table_name,uid::text AS uid FROM public.bom WHERE uid='a7f00705-cfa2-4f15-98df-4a35040fc8a0' UNION ALL SELECT 'sales_order_header' AS table_name,uid::text AS uid FROM public.sales_order_header WHERE uid='1164f09b-24d4-437c-b49d-4a35040fc955' UNION ALL SELECT 'sales_order_line' AS table_name,uid::text AS uid FROM public.sales_order_line WHERE uid IN ('36b5e4cf-f981-4356-bc94-54f8a8a69103','36b5e4cf-f981-4356-bc94-54f8a8a69104') UNION ALL SELECT 'gross_demand' AS table_name,uid::text AS uid FROM public.gross_demand WHERE uid IN ('0cb8db04-32eb-454a-831a-4a35040fc9b5','86157fd4-900c-49b8-b9e5-4a35040fc9bd') UNION ALL SELECT 'net_demand' AS table_name,uid::text AS uid FROM public.net_demand WHERE uid IN ('5a6090d1-5a7e-4d3a-8933-4a35040fca08','ad2107ae-ee8c-4718-8fdc-4a35040fca08','26fc80e7-def8-429e-bc15-4a35040fca14','2321e14a-b8e2-4109-b4d1-4a35040fca14') UNION ALL SELECT 'business_operation_log' AS table_name,uid::text AS uid FROM public.business_operation_log WHERE command_id IN ('36b5e4cf-f981-4356-bc94-54f8a8a69100','36b5e4cf-f981-4356-bc94-54f8a8a69101','36b5e4cf-f981-4356-bc94-54f8a8a69102') UNION ALL SELECT 'command_receipt' AS table_name,uid::text AS uid FROM public.command_receipt WHERE command_id IN ('36b5e4cf-f981-4356-bc94-54f8a8a69100','36b5e4cf-f981-4356-bc94-54f8a8a69101','36b5e4cf-f981-4356-bc94-54f8a8a69102') UNION ALL SELECT 'document_sequence' AS table_name,uid::text AS uid FROM public.document_sequence WHERE doc_type='SO' AND year_month='670310' ORDER BY table_name,uid;",
    "protected_corrected": "SELECT c.relname table_name,(xpath('/row/row_count/text()',x.doc))[1]::text row_count,(xpath('/row/data_md5/text()',x.doc))[1]::text data_md5 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL (SELECT query_to_xml(format('SELECT count(*) AS row_count, md5(coalesce(string_agg(to_jsonb(t)::text, chr(10) ORDER BY to_jsonb(t)::text), '''')) AS data_md5 FROM public.%I t%s',c.relname,CASE c.relname WHEN 'bom' THEN ' WHERE NOT (uid IN (''a7f00705-cfa2-4f15-98df-4a35040fc8a0''))' WHEN 'business_operation_log' THEN ' WHERE NOT (uid IN (''29e40d2e-89eb-4a99-8319-4a35040fc9c1'',''ac754978-2a52-46de-8c01-4a35040fc9c8'',''c94a2437-9f73-4de3-8dbc-4a35040fca15''))' WHEN 'command_receipt' THEN ' WHERE NOT (uid IN (''0e5f8cd7-ff52-4159-8088-4a35040fc9cb'',''530f98d3-bd5a-4374-bee9-4a35040fc984'',''8365340d-57c7-4852-8199-4a35040fca19''))' WHEN 'document_sequence' THEN ' WHERE NOT (uid IN (''fae25c6f-ec78-4a55-bcbe-4a35040fc947''))' WHEN 'gross_demand' THEN ' WHERE NOT (uid IN (''0cb8db04-32eb-454a-831a-4a35040fc9b5'',''86157fd4-900c-49b8-b9e5-4a35040fc9bd''))' WHEN 'net_demand' THEN ' WHERE NOT (uid IN (''2321e14a-b8e2-4109-b4d1-4a35040fca14'',''26fc80e7-def8-429e-bc15-4a35040fca14'',''5a6090d1-5a7e-4d3a-8933-4a35040fca08'',''ad2107ae-ee8c-4718-8fdc-4a35040fca08''))' WHEN 'product' THEN ' WHERE NOT (uid IN (''578d52ce-96be-4388-856a-4a35040fc840'',''a0d0986a-981b-498d-9127-4a35040fc82c'',''b1932f3b-0291-4e4d-9622-4a35040fc843''))' WHEN 'sales_order_header' THEN ' WHERE NOT (uid IN (''1164f09b-24d4-437c-b49d-4a35040fc955''))' WHEN 'sales_order_line' THEN ' WHERE NOT (uid IN (''36b5e4cf-f981-4356-bc94-54f8a8a69103'',''36b5e4cf-f981-4356-bc94-54f8a8a69104''))' ELSE '' END),false,true,'') doc) x WHERE n.nspname='public' AND c.relkind='r' ORDER BY c.relname",
    "final": "SELECT uid,bom_no,bom_version,sku,material_type FROM public.product WHERE uid IN ('a0d0986a-981b-498d-9127-4a35040fc82c','578d52ce-96be-4388-856a-4a35040fc840','b1932f3b-0291-4e4d-9622-4a35040fc843') ORDER BY sku;\nSELECT to_jsonb(b) AS bom FROM public.bom b WHERE uid='a7f00705-cfa2-4f15-98df-4a35040fc8a0';\nSELECT to_jsonb(n) AS net FROM public.net_demand n WHERE uid IN ('5a6090d1-5a7e-4d3a-8933-4a35040fca08','ad2107ae-ee8c-4718-8fdc-4a35040fca08','26fc80e7-def8-429e-bc15-4a35040fca14','2321e14a-b8e2-4109-b4d1-4a35040fca14') ORDER BY gross_demand_id,line_number;\nSELECT command_id,count(*) AS receipt_count FROM public.command_receipt WHERE command_id IN ('36b5e4cf-f981-4356-bc94-54f8a8a69100','36b5e4cf-f981-4356-bc94-54f8a8a69101','36b5e4cf-f981-4356-bc94-54f8a8a69102') GROUP BY command_id ORDER BY command_id;\nSELECT last_value,is_called FROM public.inventory_ledger_sequence;\nSELECT count(*) AS active_own_backends FROM pg_stat_activity WHERE pid IN (7948,2160) AND state<>'idle';\nSELECT count(*) AS own_advisory_locks FROM pg_locks WHERE pid IN (7948,2160) AND locktype='advisory';"
  },
