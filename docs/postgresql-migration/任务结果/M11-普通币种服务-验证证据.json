  "final_sql": "SELECT uid,currency_code,rate_to_base,version,is_base,is_system,is_enabled,is_deleted FROM public.sys_dic_currency WHERE uid IN ('633492fb-a403-4278-89ad-4a35043906a1','a828a20e-df65-4b4b-800e-4a35043906a9') ORDER BY currency_code;\nSELECT uid,supplier_code,currency,version,is_deleted FROM public.supplier WHERE uid='fbe00cc1-d78e-45c8-b8fb-4a35043906e9';\nSELECT count(*) AS rolled_back_currency FROM public.sys_dic_currency WHERE currency_code='P11C61B0A';\nSELECT last_value,is_called FROM public.inventory_ledger_sequence;\nSELECT count(*) AS own_live_backends FROM pg_stat_activity WHERE pid IN (6512,3272);\nSELECT count(*) AS own_advisory FROM pg_locks WHERE locktype='advisory' AND pid IN (6512,3272);",
