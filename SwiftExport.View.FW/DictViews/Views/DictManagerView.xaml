<Window x:Class="SwiftExport.View.FW.DictViews.Views.DictManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        Title="字典管理中心" Height="420" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush_Bck_Page}">
    <Grid>
        <Border Margin="12" Padding="20" CornerRadius="6"
                Background="{DynamicResource Brush_Control_Background}"
                mt:ShadowAssist.Level="Medium">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="字典管理中心" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="（拆分为两个独立窗体）" Margin="12,5,0,0"
                               Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="20" CornerRadius="4"
                            BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="字典类型管理" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="维护字典分类、编码、名称和备注。" Margin="0,8,0,16"
                                       Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                            <Button Content="打开字典类型窗体" Height="36" Click="OpenTypeManager_Click"
                                    Style="{StaticResource ButtonPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="20" CornerRadius="4"
                            BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="字典值配置" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="按字典类型维护 Value/Label/排序等明细。" Margin="0,8,0,16"
                                       Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                            <Button Content="打开字典值窗体" Height="36" Click="OpenDataManager_Click"
                                    Style="{StaticResource ButtonPrimary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <mt:DialogHost />
    </Grid>
</Window>