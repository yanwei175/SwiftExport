<Window x:Class="SwiftExport.View.FW.DictViews.Views.DictTypeManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        Title="字典类型管理" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush_Bck_Page}">
    <Grid>
        <Border Margin="10" Padding="0" CornerRadius="4"
                Background="{DynamicResource Brush_Control_Background}"
                mt:ShadowAssist.Level="Medium">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="字典类型配置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button Margin="0,0,10,0" Command="{Binding AddNewRowCommand}" Content="新增"
                                mt:ButtonAssist.IconSize="12" mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                                Style="{StaticResource ButtonPrimary}"/>
                        <Button Margin="0,0,10,0" Command="{Binding BatchSaveCommand}" Content="保存"
                                mt:ButtonAssist.IconSize="12" mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                                Style="{StaticResource ButtonPrimary}"/>
                        <Button Command="{Binding LoadCommand}" Content="刷新"
                                mt:ButtonAssist.IconSize="12" mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                Style="{StaticResource ButtonBase}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderThickness="0,0,0,1" Padding="15,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="搜索字典类型（编码/名称/备注）..."
                             Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                </Border>

                <DataGrid Grid.Row="2" ItemsSource="{Binding ItemsView}" RowHeight="40" Margin="10"
                          CanUserAddRows="False" AutoGenerateColumns="False" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类型编码" Binding="{Binding DictCode}" Width="180"
                                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                        <DataGridTextColumn Header="类型名称" Binding="{Binding DictName}" Width="220"
                                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"
                                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                        <DataGridCheckBoxColumn Header="系统内置" Binding="{Binding IsSystem}" Width="100" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.TypeDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="60" Height="24" Padding="0"
                                            Content="删除" Style="{StaticResource ButtonDanger}"
                                            IsEnabled="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Background="{DynamicResource Brush_Control_Background}"
                        BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="0,1,0,0" Padding="15,5">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{DynamicResource Brush_Txt_Secondary}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <mt:DialogHost />
    </Grid>
</Window>
