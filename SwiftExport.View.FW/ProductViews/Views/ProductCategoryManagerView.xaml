<Window x:Class="SwiftExport.View.FW.ProductViews.Views.ProductCategoryManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        Title="产品分类管理" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="White">

    <Window.Resources>
        <ResourceDictionary>

            <HierarchicalDataTemplate x:Key="CategoryTreeTemplate" ItemsSource="{Binding Children}">
                <Border x:Name="ItemBorder" CornerRadius="4" Padding="5,5,5,5" Margin="0,2" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

                        <StackPanel.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.Resources>

                                    <Style TargetType="ContextMenu">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E5E5E5" Padding="4" Margin="5,5,5,10">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <Style TargetType="MenuItem">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource  Brush_Txt_Primary}"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush_Bck_Card}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Primary2Brush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style TargetType="Separator">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Margin" Value="0,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Height="1" Background="#F0F0F0" Margin="4,0"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                </ContextMenu.Resources>

                                <MenuItem Header="➕  新建同级分类" Command="{Binding AddSiblingCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="↘️  新建子分类" Command="{Binding AddChildCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>

                                <MenuItem Header="🗑️  删除此分类" Foreground="#FF4D4F" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter Property="Background" Value="#FFF1F0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>

                            </ContextMenu>
                        </StackPanel.ContextMenu>


                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ItemIcon" Width="12" Height="12" Fill="{DynamicResource Primary1Brush}" Stretch="Uniform" Margin="0,0,6,0"
                                Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                            <TextBlock x:Name="ItemText" Text="{Binding CategoryName}" FontSize="12" Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock  Text="{Binding FakeName}" Margin="3,0,0,0" FontSize="8" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource  Brush_Bck_Card}" />
                        <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}" />
                        <Setter TargetName="ItemText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="ItemIcon" Property="Fill" Value="{DynamicResource Brush_Txt_Primary}" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <mt:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="300" MaxWidth="500"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0"  CornerRadius="4"  Padding="10" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid  >
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+" FontSize="20"  Background="Transparent" Foreground="#888" Padding="5,0,5,0" 
                            Command="{Binding AddSiblingCommand}"
                           BorderThickness="0.5"  Margin="0,-10,5,0"/>
                    <TextBlock Text="类目结构 (拖拽可排序/右键管理)" Foreground="#888" FontSize="12" Margin="0,0,0,10"/>
                </StackPanel>
                

                <TreeView Grid.Row="1" 
                          ItemsSource="{Binding CategoryTree}"
                          ItemTemplate="{StaticResource CategoryTreeTemplate}"
                          BorderThickness="0" Background="Transparent"
                          x:Name="CategoryTreeView"
                          SelectedItemChanged="CategoryTreeView_SelectedItemChanged"
                          
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DropHandler="{Binding}"
                          dd:DragDrop.DropTargetAdornerBrush="{DynamicResource Primary1Brush}">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2"/>

                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                            </Style.Resources>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Background="Transparent" 
                      Cursor="SizeWE" 
                      ShowsPreview="True"/>

        <Border Grid.Column="2"  CornerRadius="4" Padding="20" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid DataContext="{Binding CurrentCategory}">
                <TextBlock Text="请在左侧选择一个分类进行编辑" Foreground="#CCC" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Visibility="{Binding Converter={StaticResource NotNullToVisibleConverter}}"/>

                <StackPanel>
                    <TextBlock Text="类目基础属性" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="分类名称：" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="假名：" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FakeName, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="分类代码：" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="排序号：" Width="80" VerticalAlignment="Center" Foreground="#888"/>
                        <TextBox Text="{Binding SortNo, Mode=OneWay}" Width="100" Height="30" IsReadOnly="True" Background="#F5F5F5" Foreground="#888" VerticalContentAlignment="Center" Padding="5,0" ToolTip="由左侧树拖拽自动计算"/>
                    </StackPanel>
                    


                    <Button Content="💾 保存所有结构更改" Style="{DynamicResource ButtonPrimary}" MaxWidth="170" HorizontalAlignment="Left"
                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"  
                        Height="35"/>
                </StackPanel>
            </Grid>
        </Border>


            <StackPanel Grid.Row="2" Grid.ColumnSpan="1"
                Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,10,0,8">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Red" Margin="0,0,265,0"/>
            </StackPanel>
        
        <mt:DialogHost />
    </Grid>
</Window>