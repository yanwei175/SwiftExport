<UserControl x:Class="SwiftExport.View.FW.ProductViews.Views.MainProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.ProductViews.ViewModels"

             xmlns:mt ="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
             xmlns:assists="clr-namespace:SwiftExport.View.FW.ProductViews.Assists"
             xmlns:controls="clr-namespace:SwiftExport.View.FW.ProductViews.Controls"
             xmlns:mtPopup="clr-namespace:MateWpfThemes.FW.AttachedProperties;assembly=MateWpfThemes.FW"
             d:DataContext="{d:DesignInstance Type=vm:MainProductManagerViewModel}"
             mc:Ignorable="d"
             d:Height="1080"
             d:Width="1920"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="{DynamicResource Brush_Bck_Page}">

    <UserControl.Resources>
        <ResourceDictionary>
            <mt:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>

            <Style x:Key="FinishAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.ProductFinishList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="ColorNameZh" />
                <Setter Property="mt:DataGridDropdownAssist.FilterMemberPaths" Value="ColorNameZh,ColorNameEn,ColorCode" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="SupplyTypeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.SupplyTypeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="CategoryNameAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.ProductCategoryList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="CategoryName" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="CustomerCodeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.CustomerCodeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="SupplierCodeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.SupplierCodeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--#region 左侧列表-->
        <Border Margin="5"
               Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="客户代码" FontWeight="SemiBold" Foreground="{StaticResource Brush_Txt_Primary}" Margin="0,8,0,8"/>

                    <controls:CustomerSelectorControl SelectedItem="{Binding FilterCustomerDto, Mode=OneWayToSource}" MinWidth="140" Height="30" />

                    <TextBlock Text="颜色" FontWeight="SemiBold" Foreground="{StaticResource Brush_Txt_Primary}" Margin="0,8,0,8"/>
                    
                    <controls:ColorSelectorControl SelectedItem="{Binding FilterColorDto, Mode=OneWayToSource}" MinWidth="140" Height="30" />
                    
                    <Button Style="{StaticResource ButtonOutline}" Margin="0,8,0,8"
                            Content="立即查询"
                            Command="{Binding LoadCommand}"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Search}" >
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Separator Background="{StaticResource Brush_Border_Light}" Height="1" Margin="0,10" />
                </StackPanel>


                <controls:CategoryTreeSelectorControl Grid.Row="2" Grid.RowSpan="3" 
                                                      SelectedItem="{Binding FilterCategory, Mode=OneWayToSource}" />
            </Grid>
        </Border>
        <!--#endregion 左侧列表-->

        <GridSplitter Width="8" 
                     Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

        <!-- 中文注释：右侧主工作区位于第 2 列（索引 1），避免使用越界列索引。 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6*" MinHeight="40" x:Name="MasterRow"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*" MinHeight="40" x:Name="DetailRow"/>
            </Grid.RowDefinitions>

            <ToggleButton Grid.Row="0"  x:Name="BtnToggleProduct"  
                     Height="20" Cursor="Hand"  Margin="8,5"
                     ToolTip="隐藏/显示 产品 明细"  Background="Transparent" BorderBrush="Transparent" BorderThickness="0" 
                     Click="BtnToggleProduct_Click" VerticalAlignment="Center"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <TextBlock  Text="产品区域" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ToggleButton>

            <!--#region 产品列表-->
            <Border Grid.Row="1"  x:Name="MasterBorder" Margin="5"
               Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel  Grid.Row="0" Orientation="Horizontal"
                            Margin="8"
                            Background="Transparent" HorizontalAlignment="Stretch">
                        <Button Command="{Binding AddProductCommand}" Margin="0,0,5,0" Style="{StaticResource   ButtonPrimary}"
                               Content="新建"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                        </Button>
                        <Button Command="{Binding BatchSaveProductAsyncCommand}" Margin="0,0,5,0" 
                                Style="{StaticResource   ButtonSuccess}"
                               Content="保存"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Save}">
                        </Button>
                        <Separator Margin="5,0"/>
                        <Button Command="{Binding DeleteProductAsyncCommand}" Margin="0,0,5,0"
                               Style="{StaticResource   ButtonDanger}"
                               Content="删除"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Delete}">
                        </Button>
                        <Button Command="{Binding RefreshProductCommand}" Margin="0,0,5,0" 
                                Style="{StaticResource   ButtonBase}"
                               Content="刷新"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                        <Button Command="{Binding InvertProductSelectionCommand}"  Margin="0,0,5,0" Style="{StaticResource ButtonBase}"
                                                         Content="反选"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <!-- 中文注释：主表选择模式切换按钮（整行选择 / 单元格+行头选择）。
                             使用 ToggleButton 的 IsChecked 来驱动 DataGrid.SelectionUnit，避免代码后台事件切换。 -->
                        <ToggleButton x:Name="BtnToggleSelectionUnit"
                                      Margin="0,0,5,0"
                                      Padding="10,6"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      IsChecked="False">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}">
                                    <Setter Property="ToolTip" Value="切换为整行选择"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="切换为单元格选择"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- 新增：批量操作菜单，只在有选中项时可用 -->
                        <Menu Margin="0,0,5,0" Background="Transparent" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedItems}">
                            <MenuItem Header="更多批量操作 ▼" Padding="10,6" 
                                      Background="{DynamicResource Brush_Control_Background}" 
                                      BorderBrush="{DynamicResource Brush_Border_Light}" 
                                      BorderThickness="1" 
                                      Foreground="{DynamicResource Brush_Txt_Primary}">
                                <!-- 此处暂时预留空白，用于未来扩展批量操作。可根据需要绑定ViewModel的命令 -->
                                <MenuItem Header="批量修改属性" />
                                <MenuItem Header="批量导出数据" />
                                <MenuItem Header="批量打印条码" />
                            </MenuItem>
                        </Menu>
                        <TextBlock Text="模糊搜索" FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush_Txt_Primary}" Margin="8,0,8,0"/>
                        <TextBox x:Name="MainSearchTextBox"
                                 Text="{Binding SearchProductTxt, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 VerticalContentAlignment="Center"
                                 mt:TextBoxAssist.Placeholder="键入搜索"
                                 mt:TextBoxAssist.ShowClearButton="True"
                                 />

                    </StackPanel>


                    <TabControl x:Name="MastTbCtrl"  Grid.Row="1" Margin="5" BorderThickness="0">

                        <TabItem Header="产品列表" FontSize="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!--主DataGrid-->
                                <DataGrid Grid.Row="0" x:Name="MasterDataGrid"
                                     ItemsSource="{Binding ProductList.Items}"
                                     SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                     HorizontalScrollBarVisibility="Auto" 
                                     HeadersVisibility="All" 
                                     RowHeight="60" Margin="0,5,0,0"
                                     EnableRowVirtualization="False"
                                     EnableColumnVirtualization="False"
                                     mt:DataGridAssist.ShowRowNumber="True" 
                                     mt:UndoManager.IsUndoEnabled="True"
                                     mt:DataGridAssist.AutoScrollToNewItem="True"
                                     mt:DataGridAssist.EnableSoftValidation="True"
                                     mt:DataGridExcelAssist.EnableExcelShortcuts="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"
                                     mt:DataGridExcelAssist.EnableDirtyTracking="True">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
                                            <!-- 中文注释：默认保持整行模式，便于稳定触发行选择联动（例如 BOM 加载）。 -->
                                            <Setter Property="SelectionUnit" Value="FullRow"/>
                                            <Style.Triggers>
                                                <!-- 中文注释：切到 CellOrRowHeader，便于单元格编辑场景。 -->
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}" Value="True">
                                                    <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>



                                    <DataGrid.Columns>
                                        <mtControls:CheckBoxDataGridTemplateColumn 
                                            AllCheckedPropertyName="IsAllChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            ItemCheckedCommandName="ItemCheckedChangedCommand"
                                            HeaderCheckBoxMargin="2,0,0,0"
                                            HeaderCheckBoxToolTip="全选/全不选"/>

                                        <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" 
                                           CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>


                                        <DataGridTextColumn Header="产品型号" Binding="{Binding Sku}" Width="160" FontWeight="Bold" 
                                                             />

                                        <DataGridTextColumn Header="主型号" Binding="{Binding MasterSku}" Width="160" FontWeight="Bold" 
                                                             />

                                        <DataGridTextColumn Header="描述" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="200" 
                                                            />

                                        <DataGridTextColumn Binding="{Binding Finish}" Width="110" 
                                                            EditingElementStyle="{StaticResource FinishAutoCompleteEditStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="颜色" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <Menu Background="Transparent">
                                                            <!-- 快捷功能选项卡卡 -->
                                                            <MenuItem Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="快捷功能">
                                                                <MenuItem.Header>
                                                                    <Path Data="{DynamicResource Icon.Add}" Fill="{DynamicResource Brush_Txt_Secondary}" Width="10" Height="10" Stretch="Uniform"/>
                                                                </MenuItem.Header>
                                                                <MenuItem Header="快速新增颜色" Command="{Binding DataContext.QuickAddFinishCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            </MenuItem>
                                                        </Menu>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="配置" Binding="{Binding Features}" Width="120"  
                                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"/>

                                        <DataGridTextColumn Header="供货类型" Binding="{Binding SupplyType}" Width="100" 
                                                            EditingElementStyle="{StaticResource SupplyTypeAutoCompleteEditStyle}" />

                                        <DataGridTextColumn Header="Bom号" Binding="{Binding BomNo}" Width="120" />

                                        <DataGridTextColumn Binding="{Binding CategoryName}" Width="120" 
                                                            EditingElementStyle="{StaticResource CategoryNameAutoCompleteEditStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="产品分类" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <Menu Background="Transparent">
                                                            <!-- 快捷功能选项卡卡 -->
                                                            <MenuItem Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="快捷功能">
                                                                <MenuItem.Header>
                                                                    <Path Data="{DynamicResource Icon.Add}" Fill="{DynamicResource Brush_Txt_Secondary}" Width="10" Height="10" Stretch="Uniform"/>
                                                                </MenuItem.Header>
                                                                <MenuItem Header="快速新增产品分类" Command="{Binding DataContext.QuickAddCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            </MenuItem>
                                                        </Menu>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="120"/>

                                        <DataGridTextColumn Header="销售型号" Binding="{Binding LinkSku}" Width="120"/>

                                        <DataGridTextColumn Header="图片地址" Binding="{Binding MainImage}" Width="120" />

                                        <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="80" 
                                                            EditingElementStyle="{StaticResource CustomerCodeAutoCompleteEditStyle}" />

                                        <DataGridTextColumn Header="客户型号" Binding="{Binding CSku}" Width="120" />

                                        <DataGridTextColumn Header="供应商代码" Binding="{Binding SupplierCode}" Width="80" 
                                                            EditingElementStyle="{StaticResource SupplierCodeAutoCompleteEditStyle}" />

                                        <DataGridTextColumn Header="供应商产品型号" Binding="{Binding SSku}" Width="120" />

                                    </DataGrid.Columns>
                                </DataGrid>

                                <mt:PageNavigator Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right" 
                                                   TotalCount="{Binding TotalCount}" 
                                                   PageIndex="{Binding PageIndex, Mode=OneWay}"
                                                   PageSize="{Binding PageSize, Mode=OneWay}"
                                                   PageChangeCommand="{Binding PageChangeCommand}"/>
                            </Grid>
                        </TabItem>

                        <TabItem Visibility="Hidden" Header="产品详情" FontSize="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <WrapPanel ItemWidth="280" ItemHeight="100" Orientation="Horizontal">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="产品大类：" Foreground="#888" Margin="0,0,0,4"/>
                                        <ComboBox  MinWidth="240" MinHeight="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="10">
                                        <TextBlock Text="条形码 (Barcode)：" Foreground="#888" Margin="0,0,0,4"/>
                                        <TextBox MinWidth="240" MinHeight="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="10">
                                        <TextBlock Text="默认发货仓库：" Foreground="#888" Margin="0,0,0,4"/>
                                        <ComboBox MinWidth="240" MinHeight="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="10">
                                        <TextBlock Text="安全库存上限：" Foreground="#888" Margin="0,0,0,4"/>
                                        <TextBox MinWidth="240" MinHeight="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="10">
                                        <TextBlock Text="重量(kg)：" Foreground="#888" Margin="0,0,0,4"/>
                                        <TextBox MinWidth="240" MinHeight="28"/>
                                    </StackPanel>

                                </WrapPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
            <!--#endregion-->

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="26" 
                     Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

            <ToggleButton Grid.Row="2" x:Name="BtnToggleBom"  
                     IsChecked="{Binding IsBomAreaCollapsed, Mode=TwoWay}"
                     Height="20" Cursor="Hand"  Margin="8,5" 
                     ToolTip="隐藏/显示 BOM 明细" 
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                     Background="Transparent" BorderBrush="Transparent" BorderThickness="0" 
                     Click="BtnToggleBom_Click" VerticalAlignment="Center">
                <TextBlock Text="BOM区域" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </ToggleButton>
            <!--#region BOM区域-->
            <Border Grid.Row="3" x:Name="DetailContainer" Margin="5"
               Background="{DynamicResource  Brush_Control_Background}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Orientation="Horizontal"  Grid.Row="0" 
                               Margin="5,2">
                        <!-- BOM 号标签：绑定到 SelectedProduct.BomNo，无BOM时显示 (无BOM) -->
                        <TextBlock Text="Bom号：" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding SelectedProduct.BomNo, TargetNullValue='(无BOM)'}" VerticalAlignment="Center"  Margin="0,0,15,0" Width="120" TextTrimming="CharacterEllipsis"/>
                        <Separator Margin="5,0"/>

                        <!-- 有BOM时显示的操作按钮区域（获取/保存/删除/筛选） -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EffBomNo}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Command="{Binding OpenProductSelectorCommand}" Margin="0,0,5,0" 
                                   Content="获取"
                                   Style="{StaticResource ButtonPrimary}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Add}"/>

                            <Button Command="{Binding BatchSaveBomCommand}" Margin="0,0,5,0"
                                   Content="保存"
                                   Style="{StaticResource ButtonSuccess}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Save}"/>
                            <Button Command="{Binding RemoveBomItemCommand}" Margin="0,0,5,0"
                                   Content="删除"
                                   Style="{StaticResource ButtonDanger}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"/>
                            <Separator Margin="5,0"/>
                            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBox Width="180" Text="{Binding BomSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                    VerticalContentAlignment="Center" 
                                    mt:TextBoxAssist.Placeholder="内存极速筛选"
                                    mt:TextBoxAssist.ShowClearButton="True"/>
                        </StackPanel>

                        <!-- 无BOM时显示的新建BOM按钮 -->
                        <Button Command="{Binding CreateBomCommand}" Margin="0,0,5,0"
                               Content="新建BOM"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EffBomNo}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>


                    <TabControl Grid.Row="1" Margin="5" Background="Transparent" BorderThickness="0">
                        <!--BOM-->
                        <TabItem Header="BOM明细" FontSize="13">
                            <Grid>
                                <DataGrid x:Name="DetailDataGrid" Margin="0,5,0,0"
                                      Style="{StaticResource  FullRowDataGrid}"
                                                 ItemsSource="{Binding BomList.Items}" 
                                                 SelectedItem="{Binding SelectedBomItem, Mode=TwoWay}"
                                                 HorizontalScrollBarVisibility="Auto" HeadersVisibility="All" 
                                                 RowHeight="40" 
                                                 SelectionUnit="FullRow"
                                                 EnableRowVirtualization="False"
                                                 EnableColumnVirtualization="False"
                                                 mt:DataGridAssist.ShowRowNumber="True" 
                                                 mt:UndoManager.IsUndoEnabled="True"
                                                 mt:DataGridAssist.AutoScrollToNewItem="True"
                                                 mt:DataGridAssist.EnableSoftValidation="True"
                                                 mt:DataGridExcelAssist.EnableDirtyTracking="True">

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" 
                                           CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>

                                        <DataGridTemplateColumn Header="子件型号" Width="150" SortMemberPath="SubSku">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SubSku}" VerticalAlignment="Center" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SubSku, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource DataGridTextBox}">
                                                        <i:Interaction.Behaviors>
                                                            <mt:TextBoxPopupAssist
                                                                    Popup="{Binding ElementName=PopupForSubModel}"
                                                                    SearchCommand="{Binding DataContext.SearchPdForBomPopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommitCommand="{Binding DataContext.CommitPdForBomPopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                        </i:Interaction.Behaviors>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn IsReadOnly="True" 
                                                        Header="子件描述" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="300" />

                                        <DataGridTextColumn Header="子件类型" Binding="{Binding BomSubType, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False}" Width="120" />

                                        <DataGridTextColumn Header="用量(分子)" Binding="{Binding Numerator, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False}" Width="80" />

                                        <DataGridTextColumn Header="底数(分母)" Binding="{Binding Denominator, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False}" Width="80" />

                                        <DataGridTemplateColumn Header="操作" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button x:Name="btnBomDelete"
                                                                Background="Transparent"
                                                                IsEnabled="True"
                                                                Foreground="{DynamicResource Brush_Primary}"
                                                                Command="{Binding DataContext.DeleteBomItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                mt:ButtonAssist.Icon="{StaticResource Icon.Delete}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <!-- 中文注释：当行已标记删除时，隐藏删除按钮，仅显示撤销按钮。 -->
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush_Btn_Primary_Disabled_Fck}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Deleted">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button x:Name="btnCancelBomDelete"
                                                                Background="Transparent"
                                                                Foreground="{DynamicResource Brush_Danger}"
                                                                Command="{Binding DataContext.CancelDeleteBomItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <!-- 中文注释：仅在行为 Deleted 状态时显示“撤销删除”。 -->
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Deleted">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                                        Header="备注" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="300" />

                                    </DataGrid.Columns>
                                </DataGrid>
                                <!--Bom条目快速搜索产品-->
                                <Popup x:Name="PopupForSubModel"
                                               IsOpen="{Binding IsPopupOpen}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               Focusable="False">

                                    <Border BorderBrush="{DynamicResource Brush_Border_Default}"
                                                    Background="{DynamicResource Brush_Bck_Card}"
                                                    BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                                    SnapsToDevicePixels="True">

                                        <ListBox ItemsSource="{Binding BomPopItemSource}"
                                                     SelectedItem="{Binding BomPopSelectedItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     BorderThickness="0"
                                                     Focusable="False"
                                                     MinWidth="280"
                                                     MinHeight="60"
                                                     MaxHeight="260">

                                            <!-- 每项模板：图片 + SKU + 描述 -->
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="2,3">
                                                        <Image DockPanel.Dock="Left"
                                                                       Width="32" Height="32"
                                                                       Margin="0,0,8,0"
                                                                       Stretch="Uniform"
                                                                       VerticalAlignment="Center"
                                                                       Source="{Binding MainImage, Converter={StaticResource ImgPathToImgConverter}}"/>

                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Sku}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                            <TextBlock Text="{Binding Description}"
                                                                               Foreground="#888"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="2"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                        </ListBox>
                                    </Border>
                                </Popup>


                            </Grid>


                        </TabItem>

                        <TabItem Header="BOM层级结构" FontSize="13">
                            <TreeView ItemsSource="{Binding BomTreeNodes}" Margin="0,5,0,0" BorderThickness="1" BorderBrush="#EAEAEA">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Path Width="14" Height="14" Fill="#FFCA28" Margin="0,0,6,0" Stretch="Uniform"
                                             Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                                            <TextBlock Text="{Binding ChildCode}" FontWeight="Bold" Foreground="#333"/>
                                            <TextBlock Text=" ------ " Foreground="#999"/>
                                            <TextBlock Text="{Binding ChildName}" Foreground="#666"/>
                                            <TextBlock Text="{Binding QtyText, StringFormat='  (单机用量: {0})'}" Foreground="#1677FF" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </TabItem>
                    </TabControl>

                    <StatusBar Grid.Row="2" Background="Transparent" 
                          BorderThickness="0,0,0,0" BorderBrush="{DynamicResource Brush_Border_Light}" Padding="10,2">
                        <StatusBarItem>
                            <TextBlock Text="就绪" Foreground="#888"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentBomItems.Count, StringFormat='BOM 明细总数：{0} 项'}" 
                                  Foreground="{DynamicResource Brush_Txt_Primary}" FontWeight="SemiBold"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </Border>

        </Grid>
        <!--#endregion-->
        <mt:DialogHost Grid.Column="1" Grid.RowSpan="4" d:IsHidden="True" />
    </Grid>
</UserControl>