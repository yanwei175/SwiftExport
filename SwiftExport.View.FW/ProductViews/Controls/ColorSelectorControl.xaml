<UserControl x:Class="SwiftExport.View.FW.ProductViews.Controls.ColorSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             mc:Ignorable="d" 
             x:Name="Root">
    <Grid>
        <mt:SearchableTextBox ItemsSource="{Binding Items, ElementName=Root}"
                              DisplayMemberPath="ColorNameZh"
                              FilterMemberPaths="ColorNameZh,ColorNameEn,ColorCodeUnique"
                              RequireItemMatch="True"
                              SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                              mt:TextBoxAssist.Placeholder="搜索颜色..." 
                              Height="30" />
    </Grid>
</UserControl>