<UserControl x:Class="SwiftExport.View.FW.PurchaseOrderViews.Views.PurchaseOrderManagerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.PurchaseOrderViews.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="980"
             d:DesignWidth="1680"
             d:DataContext="{d:DesignInstance vm:PurchaseOrderManagerViewModel}"
             Background="{DynamicResource Brush_Bck_Page}">

    <!--布局：上下分层，上方选单，下方显示 PurchaseOrderLine。
        交互：允许在表格中直接修改 ReadyQty、FollowUpRemarks 和 FollowExpectedDate。
        自动汇总：在状态栏实时显示当前选中订单的 TotalReadyCBM (逻辑：ReadyQty * UnitCBM) 和 TotalReadyWeight。-->
    <!--在 PurchaseOrderLine 的 DataGrid 中，将 ReadyQty, FollowUpRemarks, FollowExpectedDate 设置为可编辑。
        实时汇总面板：在 DataGrid 下方增加一个统计栏，实时计算选中订单中所有行的 Sum(ReadyQty * UnitCBM) 和 Sum(ReadyQty * UnitWeight)。
        颜色提示：
        若 ReadyQty > 0 但
            <QTY，ReadyQty 背景设为淡蓝色。
        若 ReadyQty >= QTY，背景设为淡绿色。
        若 FollowExpectedDate 晚于订单交期，该日期显示为红色。
        2. 批量保存：
        实现一个 SaveFollowUpCommand，一键保存用户在表格中修改的所有备注和进度。-->




    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 中文注释：定柜提示文字样式，达到阈值时使用红色强调。 -->
        <Style x:Key="ContainerHintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsContainerSuggestionWarning}" Value="True">
                    <Setter Property="Foreground" Value="#FFC62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid >
        
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- #region 左侧筛选栏 -->
        <Border Margin="5"
                Background="White"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush_Border_Light}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="供应商" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <ComboBox ItemsSource="{Binding SupplierItems}"
                              SelectedValue="{Binding SelectedSupplier, Mode=TwoWay}"
                              SelectedValuePath="SupplierCode"
                              DisplayMemberPath="SupplierName"
                              Height="30"/>

                    <TextBlock Text="订单状态" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                              SelectedValuePath="Key"
                              DisplayMemberPath="Value"
                              Height="30"/>

                    <TextBlock Text="下单日期(起)" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <DatePicker SelectedDate="{Binding OrderDateFrom, Mode=TwoWay}"/>

                    <TextBlock Text="下单日期(止)" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <DatePicker SelectedDate="{Binding OrderDateTo, Mode=TwoWay}"/>

                    <TextBlock Text="采购单号" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <TextBox Text="{Binding SearchPoNo, UpdateSourceTrigger=PropertyChanged}" Height="30" mt:TextBoxAssist.Placeholder="请输入业务单号"/>
                    <TextBlock Text="销售单号" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <TextBox Text="{Binding SearchSalesOrderNo, UpdateSourceTrigger=PropertyChanged}" Height="30" mt:TextBoxAssist.Placeholder="请输入来源销售单"/>

                    <TextBlock Text="InvoiceNo" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <TextBox Text="{Binding SearchInvoiceNo, UpdateSourceTrigger=PropertyChanged}" Height="30" mt:TextBoxAssist.Placeholder="请输入InvoiceNo"/>
                    

                    <Button Content="立即查询"
                            Style="{StaticResource ButtonPrimary}"
                            Margin="0,10,0,6"
                            Command="{Binding LoadCommand}"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Search}"
                            mt:ButtonAssist.IconSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- #endregion -->

        <GridSplitter Width="8" Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

        <TabControl Grid.Column="1">
            <TabItem Header="采购订单管理" IsSelected="True">
                
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" MinHeight="220"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="6*" MinHeight="220"/>
                    </Grid.RowDefinitions>

                    <!-- 主表区域 -->
                    <Border Grid.Row="0" Margin="5"
                                Background="White"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Brush_Border_Light}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">

                                <Button Content="新建订单" Margin="8,0,0,0"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding CreateOrderCommand}"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                                        mt:ButtonAssist.IconSize="12"/>

                                <Button Content="修改订单" Margin="8,0,0,0"
                                        Style="{StaticResource ButtonSuccess}"
                                        Command="{Binding EditOrderCommand}"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Edit}"
                                        mt:ButtonAssist.IconSize="12"/>
                                
                                <Button Content="关闭订单" Margin="8,0,0,0"
                                        Style="{StaticResource ButtonDanger}"
                                        Command="{Binding CloseOrderCommand}"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"
                                        mt:ButtonAssist.IconSize="12"/>
                                
                                <Button Content="刷新" Margin="8,0,0,0"
                                        Style="{StaticResource ButtonOutline}"
                                        Command="{Binding LoadCommand}"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                        mt:ButtonAssist.IconSize="12"/>
                                <TextBlock Text="审批状态" Margin="8,0,0,0"/>
                                
                                <ComboBox x:Name="审批状态" ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                          Margin="8,0,0,0"
                                          Width="100"
                                          Height="30"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource BaseDataGrid}"
                                      ItemsSource="{Binding HeadItems}"
                                      SelectedItem="{Binding SelectedHead, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionUnit="FullRow"
                                      RowHeight="35"
                                      mt:DataGridAssist.ShowRowNumber="True"
                                      Margin="8,0,8,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="订单状态" Binding="{Binding OrderStatus}" Width="90"/>
                                    <DataGridTextColumn Header="采购单号" Binding="{Binding OrderNo}" Width="160"/>
                                    <DataGridTextColumn Header="诗亦霖采购单号" Binding="{Binding BoNo}" Width="160"/>
                                    <DataGridTextColumn Header="供应商名称" Binding="{Binding SupplierName}" Width="160"/>
                                    <DataGridTextColumn Header="订单日期" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                                    <DataGridTextColumn Header="预计交期" Binding="{Binding ExpectedDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                                    <DataGridTextColumn Header="回复交期" Binding="{Binding ReplyDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                                    <DataGridTextColumn Header="订单总数量" Binding="{Binding TotalQty, StringFormat=F2}" Width="100"/>
                                    <DataGridTextColumn Header="未发货数量" Binding="{Binding TotalUnshippedQty, StringFormat=F2}" Width="100"/>
                                    <DataGridTextColumn Header="完工数量" Binding="{Binding TotalReadyQty, StringFormat=F2}" Width="100"/>
                                    <DataGridTextColumn Header="订单总金额" Binding="{Binding TotalAmountLocalCurrency, StringFormat=F2}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <mt:PageNavigator Grid.Row="2"
                                      Margin="0,0,8,8"
                                      HorizontalAlignment="Right"
                                      TotalCount="{Binding TotalCount}"
                                      PageIndex="{Binding PageIndex, Mode=OneWay}"
                                      PageSize="{Binding PageSize, Mode=OneWay}"
                                      PageChangeCommand="{Binding PageChangeCommand}"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="8" Background="Transparent" Cursor="SizeNS" ShowsPreview="True"/>

                    <!-- 详情区（Tab + 完工统计） -->
                    <Border Grid.Row="2" Margin="5"
                            Background="White"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush_Border_Light}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                                    <Button Content="批量保存"
                                        Style="{StaticResource ButtonSuccess}"
                                        Margin="0,0,6,0"
                                        Command="{Binding BatchSaveCommand}"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                                        mt:ButtonAssist.IconSize="12"/>
                                    <Button Content="快速入库(当前行)"
                                        Style="{StaticResource ButtonBase}"
                                        Margin="0,0,6,0"
                                        Command="{Binding QuickReceiveCommand}"/>
                                    <Button Content="批量快速入库"
                                        Style="{StaticResource ButtonPrimary}"
                                        Margin="0,0,6,0"
                                        Command="{Binding BatchQuickReceiveCommand}"/>
                                    <Button Content="打印合同(PDF)"
                                        Style="{StaticResource ButtonOutline}"
                                        Command="{Binding PrintCommand}"/>
                                </StackPanel>

                                <TabControl Grid.Row="1" Margin="8,0,8,8">
                                    <TabItem Header="订单明细">
                                        <DataGrid Style="{StaticResource BaseDataGrid}"
                                          ItemsSource="{Binding LineItems.Items}"
                                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                                  SelectionUnit="FullRow"
                                                  RowHeight="65"
                                                  mt:DataGridAssist.ShowRowNumber="True">
                                            <DataGrid.Columns>
                                                <mtControls:CheckBoxDataGridTemplateColumn
                                                            AllCheckedPropertyName="IsAllLineChecked"
                                                            ItemCheckedPropertyName="IsChecked"
                                                            HeaderCheckBoxMargin="2,0,0,0"
                                                            HeaderCheckBoxToolTip="全选/全不选"/>

                                                <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" 
                                                                    CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                                                <!-- 只读列 -->
                                                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="物料编号" Binding="{Binding Sku}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="产品型号" Binding="{Binding LinkSku}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="描述" Binding="{Binding DescriptionZh}" Width="180" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="表面处理" Binding="{Binding FinishZh}" Width="80" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="物料类型" Binding="{Binding MaterialType}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="订单数" Binding="{Binding QTY, StringFormat=F2}" Width="100" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="欠数" Binding="{Binding UnRecQty, StringFormat=F2}" Width="100" IsReadOnly="True"/>

                                                <!-- 可编辑列 -->
                                                <DataGridTextColumn Header="完工数" Binding="{Binding ReadyQty, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="100"/>

                                                <DataGridTemplateColumn Header="更新交货日期" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FollowExpectedDate, StringFormat=yyyy-MM-dd}" 
                                                                       Style="{StaticResource BaseTextBlock}"
                                                                       VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <DatePicker SelectedDate="{Binding FollowExpectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="跟进备注" Binding="{Binding FollowUpRemarks, UpdateSourceTrigger=PropertyChanged}" Width="180"/>

                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    
                                    <TabItem Header="跟进记录">
                                        <DataGrid Style="{StaticResource BaseDataGrid}"
                                                  ItemsSource="{Binding LogItems}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  mt:DataGridAssist.ShowRowNumber="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="跟进时间" Binding="{Binding LogTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                                <DataGridTextColumn Header="跟进人" Binding="{Binding Operator}" Width="120"/>
                                                <DataGridTextColumn Header="跟进详情" Width="*"
                                                                    EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                                                    Binding="{Binding Remark}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="入库记录">
                                        <DataGrid Style="{StaticResource BaseDataGrid}"
                                                  ItemsSource="{Binding ReceiptItems}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  mt:DataGridAssist.ShowRowNumber="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="入库单号" Binding="{Binding ReceiptNo}" Width="180"/>
                                                <DataGridTextColumn Header="入库日期" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                                <DataGridTextColumn Header="Sku" Binding="{Binding Sku}" Width="160"/>
                                                <DataGridTextColumn Header="数量" Binding="{Binding Qty, StringFormat=F2}" Width="100"/>
                                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="220"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                </TabControl>
                            </Grid>
                        </Border>
                </Grid>

            </TabItem>
            <TabItem Header="订单详情">
                
            </TabItem>
        </TabControl>
        <!-- #region 右侧主工作区 -->
        <!-- #endregion -->
    </Grid>
        <mt:DialogHost d:IsHidden="True"/>
    </Grid>
</UserControl>
