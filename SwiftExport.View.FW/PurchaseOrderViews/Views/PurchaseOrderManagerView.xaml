<UserControl x:Class="SwiftExport.View.FW.PurchaseOrderViews.Views.PurchaseOrderManagerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.PurchaseOrderViews.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="980"
             d:DesignWidth="1680"
             d:DataContext="{d:DesignInstance vm:PurchaseOrderManagerViewModel}"
             Background="{DynamicResource Brush_Bck_Page}">

    <!--布局：上下分层，上方选单，下方显示 PurchaseOrderLine。
        交互：允许在表格中直接修改 ReadyQty、FollowUpRemarks 和 FollowExpectedDate。
        自动汇总：在状态栏实时显示当前选中订单的 TotalReadyCBM (逻辑：ReadyQty * UnitCBM) 和 TotalReadyWeight。-->
    <!--在 PurchaseOrderLine 的 DataGrid 中，将 ReadyQty, FollowUpRemarks, FollowExpectedDate 设置为可编辑。
实时汇总面板：在 DataGrid 下方增加一个统计栏，实时计算选中订单中所有行的 Sum(ReadyQty * UnitCBM) 和 Sum(ReadyQty * UnitWeight)。
颜色提示：
若 ReadyQty > 0 但
    <QTY，ReadyQty 背景设为淡蓝色。
若 ReadyQty >= QTY，背景设为淡绿色。
若 FollowExpectedDate 晚于订单交期，该日期显示为红色。
2. 批量保存：

实现一个 SaveFollowUpCommand，一键保存用户在表格中修改的所有备注和进度。-->





        <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 中文注释：定柜提示文字样式，达到阈值时使用红色强调。 -->
        <Style x:Key="ContainerHintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsContainerSuggestionWarning}" Value="True">
                    <Setter Property="Foreground" Value="#FFC62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- #region 左侧筛选栏 -->
        <Border Margin="5"
                Background="White"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush_Border_Light}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="供应商" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <ComboBox ItemsSource="{Binding SupplierItems}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="SupplierName"
                              Height="30"/>

                    <TextBlock Text="订单状态" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              Height="30"/>

                    <TextBlock Text="下单日期(起)" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <DatePicker SelectedDate="{Binding OrderDateFrom, Mode=TwoWay}"/>

                    <TextBlock Text="下单日期(止)" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <DatePicker SelectedDate="{Binding OrderDateTo, Mode=TwoWay}"/>

                    <TextBlock Text="PO号" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <TextBox Text="{Binding SearchPoNo, UpdateSourceTrigger=PropertyChanged}" Height="30" mt:TextBoxAssist.Placeholder="请输入业务单号"/>

                    <TextBlock Text="关联SO号" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="{DynamicResource Brush_Txt_Primary}"/>
                    <TextBox Text="{Binding SearchSalesOrderNo, UpdateSourceTrigger=PropertyChanged}" Height="30" mt:TextBoxAssist.Placeholder="请输入来源销售单"/>

                    <Button Content="立即查询"
                            Style="{StaticResource ButtonPrimary}"
                            Margin="0,10,0,6"
                            Command="{Binding LoadCommand}"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Search}"
                            mt:ButtonAssist.IconSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- #endregion -->

        <GridSplitter Width="8" Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

        <!-- #region 右侧主工作区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="220"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="4*" MinHeight="220"/>
            </Grid.RowDefinitions>

            <!-- 主表区域 -->
            <Border Grid.Row="0" Margin="5"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush_Border_Light}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                        <Button Content="刷新"
                                Style="{StaticResource ButtonBase}"
                                Command="{Binding LoadCommand}"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                mt:ButtonAssist.IconSize="12"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource BaseDataGrid}"
                              ItemsSource="{Binding HeadItems}"
                              SelectedItem="{Binding SelectedHead, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              mt:DataGridAssist.ShowRowNumber="True"
                              Margin="8,0,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PoNo" Binding="{Binding PoNo}" Width="160"/>
                            <DataGridTextColumn Header="OrderNo" Binding="{Binding OrderNo}" Width="160"/>
                            <DataGridTextColumn Header="SupplierName" Binding="{Binding SupplierName}" Width="160"/>
                            <DataGridTextColumn Header="OrderDate" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="ApprovalStatus" Binding="{Binding ApprovalStatus}" Width="120"/>
                            <DataGridTextColumn Header="TotalQty" Binding="{Binding TotalQty, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="TotalAmount" Binding="{Binding TotalAmountLocalCurrency, StringFormat=F2}" Width="140"/>
                            <DataGridTextColumn Header="SalesOrderNo" Binding="{Binding SalesOrderNo}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <mt:PageNavigator Grid.Row="2"
                                      Margin="0,0,8,8"
                                      HorizontalAlignment="Right"
                                      TotalCount="{Binding TotalCount}"
                                      PageIndex="{Binding PageIndex, Mode=OneWay}"
                                      PageSize="{Binding PageSize, Mode=OneWay}"
                                      PageChangeCommand="{Binding PageChangeCommand}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="8" Background="Transparent" Cursor="SizeNS" ShowsPreview="True"/>

            <!-- 详情区（Tab + 完工统计） -->
            <Border Grid.Row="2" Margin="5"
                    Background="White"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush_Border_Light}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                        <Button Content="批量保存"
                                Style="{StaticResource ButtonSuccess}"
                                Margin="0,0,6,0"
                                Command="{Binding BatchSaveCommand}"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                                mt:ButtonAssist.IconSize="12"/>
                        <Button Content="快速入库(当前行)"
                                Style="{StaticResource ButtonBase}"
                                Margin="0,0,6,0"
                                Command="{Binding QuickReceiveCommand}"/>
                        <Button Content="批量快速入库"
                                Style="{StaticResource ButtonPrimary}"
                                Margin="0,0,6,0"
                                Command="{Binding BatchQuickReceiveCommand}"/>
                        <Button Content="打印合同(PDF)"
                                Style="{StaticResource ButtonBase}"
                                Command="{Binding PrintCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <TabControl Grid.Column="0">
                            <TabItem Header="订单明细">
                                <DataGrid Style="{StaticResource BaseDataGrid}"
                                          ItemsSource="{Binding LineItems.Items}"
                                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          mt:DataGridAssist.ShowRowNumber="True">
                                    <DataGrid.Columns>
                                        <mtControls:CheckBoxDataGridTemplateColumn
                                            AllCheckedPropertyName="IsAllLineChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            HeaderCheckBoxMargin="2,0,0,0"
                                            HeaderCheckBoxToolTip="全选/全不选"/>

                                        <!-- 只读列 -->
                                        <DataGridTextColumn Header="Sku" Binding="{Binding Sku}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding DescriptionZh}" Width="180" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="QTY(合同数)" Binding="{Binding QTY, StringFormat=F2}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="RecQTY(已入库)" Binding="{Binding RecQty, StringFormat=F2}" Width="110" IsReadOnly="True"/>

                                        <!-- 可编辑列 -->
                                        <DataGridTextColumn Header="ReadyQty" Binding="{Binding ReadyQty, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="100"/>
                                        <DataGridTemplateColumn Header="FollowExpectedDate" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FollowExpectedDate, StringFormat=yyyy-MM-dd}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding FollowExpectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="SubNote" Binding="{Binding SubNote, UpdateSourceTrigger=PropertyChanged}" Width="180"/>

                                        <!-- 统计辅助列 -->
                                        <DataGridTextColumn Header="UnitWeight" Binding="{Binding UnitWeight, StringFormat=F4}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="UnitCBM" Binding="{Binding UnitCBM, StringFormat=F4}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="MaterialType" Binding="{Binding MaterialType}" Width="100" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="入库记录">
                                <DataGrid Style="{StaticResource BaseDataGrid}"
                                          ItemsSource="{Binding ReceiptItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          mt:DataGridAssist.ShowRowNumber="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="入库单号" Binding="{Binding ReceiptNo}" Width="180"/>
                                        <DataGridTextColumn Header="入库日期" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                        <DataGridTextColumn Header="Sku" Binding="{Binding Sku}" Width="160"/>
                                        <DataGridTextColumn Header="数量" Binding="{Binding Qty, StringFormat=F2}" Width="100"/>
                                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>

                        <!-- 完工统计卡片 -->
                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10"
                                Background="{DynamicResource Brush_Bck_Card}"
                                BorderBrush="{DynamicResource Brush_Border_Light}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="完工统计" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding TotalReadyGw, StringFormat=Total GW: {0:F2}}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalReadyCbm, StringFormat=Total CBM: {0:F2}}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ContainerSuggestionText}" Style="{StaticResource ContainerHintTextStyle}" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Brush_Txt_Secondary}" FontSize="11"
                                           Text="计算口径：ReadyQty * UnitWeight / ReadyQty * UnitCBM" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        <!-- #endregion -->
    </Grid>
</UserControl>
