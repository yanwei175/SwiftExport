<UserControl x:Class="SwiftExport.View.FW.PurchaseOrderViews.Views.PurchaseOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SwiftExport.View.FW.PurchaseOrderViews.Views"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        
            xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
            xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
            xmlns:controls="clr-namespace:SwiftExport.View.FW.ProductViews.Controls"
            xmlns:customerControls="clr-namespace:SwiftExport.View.FW.PurchaseOrderViews.Controls"
            xmlns:converters="clr-namespace:MateWpfThemes.FW.Converters;assembly=MateWpfThemes.FW"
            xmlns:enums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
            xmlns:mvvm="clr-namespace:SwiftExport.View.FW.Mvvm"
             
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"        
             xmlns:vm="clr-namespace:SwiftExport.View.FW.PurchaseOrderViews.ViewModels"
            d:DataContext="{d:DesignInstance Type=vm:PurchaseOrderDetailViewModel}"
            Background="{DynamicResource Brush_Btn_Default_Background}">

    <UserControl.Resources>
        <mvvm:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <converters:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>

        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <mvvm:BindingProxy x:Key="SelectionUnitProxy" Data="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"/>

        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Margin" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style x:Name="BoldTextBlockMargin" TargetType="TextBlock" BasedOn="{StaticResource  BoldTextBlock}">
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="固定字段" Grid.Row="0" Margin="0,5">
            <StackPanel>
                <TextBlock Margin="5,0" Text="订单编号:"/>
                <TextBox Text="{Binding OrderHeader.OrderNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        MinWidth="110"
                        d:Text="SO2026050001"/>
                <Button Margin="0" Padding="0" 
                    Style="{StaticResource ButtonIcon}"
                    Command="{Binding GetNewSoNoCommand}"
                    mt:ButtonAssist.Icon="{StaticResource Icon.MoreVert}"/>
            </StackPanel>


            <StackPanel>
                <TextBlock Text="订单状态:" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                <TextBox Width="110" Text="{Binding OrderHeader.OrderDate, Mode=TwoWay}"
                         
                                                    d:Text="未完全发货"
                                                    IsReadOnly="True"
                                                     MinWidth="90"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="审批状态:" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                <TextBox Width="110" IsReadOnly="True"                               
                                        Text="{Binding OrderHeader.ApprovalStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            </StackPanel>

        </WrapPanel>
      

        <Grid Grid.Row="1" x:Name="采购表头表格"
              ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="35" />
                <RowDefinition Height="2*" MinHeight="35" />
                <RowDefinition Height="2*" MinHeight="35" />
                <RowDefinition Height="2*" MinHeight="35" />
                <RowDefinition Height="3*" MinHeight="60" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Margin="5,0"  Grid.Row="0" Grid.Column="0" Text="客户代码"/>
            <TextBlock Margin="5,0"  Grid.Row="1" Grid.Column="0" Text="客户PO号" />
            <TextBlock Margin="5,0"  Grid.Row="2" Grid.Column="0" Text="诗亦霖采购单号" />
            <TextBlock Margin="5,0"  Grid.Row="3" Grid.Column="0" Text="业务员" />
            <TextBlock Margin="5,0"  Grid.Row="4" Grid.Column="0" Text="特殊要求"/>
            
            <TextBlock Margin="5,0"  Grid.Row="0" Grid.Column="2" Text="下单日期"/>
            <TextBlock Margin="5,0"  Grid.Row="1" Grid.Column="2" Text="期望交期" />
            <TextBlock Margin="5,0"  Grid.Row="2" Grid.Column="2" Text="回复交期" />
            <TextBlock Margin="5,0"  Grid.Row="3" Grid.Column="2" Text="跟单员" />
            
            <TextBlock Margin="5,0" Grid.Row="0" Grid.Column="4" Text="供应商"/>
            <TextBlock Margin="5,0" Grid.Row="1" Grid.Column="4" Text="进水管" />
            <TextBlock Margin="5,0" Grid.Row="2" Grid.Column="4" Text="起泡器" />
            <TextBlock Margin="5,0" Grid.Row="3" Grid.Column="4" Text="托盘" />
            
            <TextBlock Margin="5,0"  Grid.Row="0" Grid.Column="6" Text="内盒"/>
            <TextBlock Margin="5,0"  Grid.Row="1" Grid.Column="6" Text="标贴" />
            <TextBlock Margin="5,0"  Grid.Row="2" Grid.Column="6" Text="说明书" />
            <TextBlock Margin="5,0"  Grid.Row="3" Grid.Column="6" Text="外箱" />
            
            <TextBlock Margin="5,0"  Grid.Row="0" Grid.Column="8" Text="光标" Grid.RowSpan="4"/>


            <TextBox  Grid.Row="0" Grid.Column="1" d:Text="客户代码"
                      mt:AutoCompleteAssist.ItemsSource="{Binding CustomerCodeList}"/>

            <TextBox  Grid.Row="1" Grid.Column="1" d:Text="PO2315464879" />
            <TextBox  Grid.Row="2" Grid.Column="1" d:Text="KB243601LYSD" />
            <TextBox  Grid.Row="3" Grid.Column="1" d:Text="WING" />
            <TextBox  Grid.Row="4" Grid.Column="1" d:Text="备注" Grid.ColumnSpan="10"
                            Style="{StaticResource MultiLineTextBoxStyle}"
                             VerticalAlignment="Stretch"/>
            
            <DatePicker  Grid.Row="0" Grid.Column="3"  d:Text="2026/06/06" 
                                Margin="0,5"
                                           Style="{StaticResource  OutlinedDatePicker}"
                                           SelectedDate="{Binding OrderHeader.DeliverDate, Mode=TwoWay, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            mt:HintAssist.Hint="Pick Date" />
            <DatePicker  Grid.Row="1" Grid.Column="3"  d:Text="2026/06/06" 
                         Margin="0,5"
                                           Style="{StaticResource  OutlinedDatePicker}"
                                           SelectedDate="{Binding OrderHeader.DeliverDate, Mode=TwoWay, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            mt:HintAssist.Hint="Pick Date" />
            <DatePicker  Grid.Row="2" Grid.Column="3"  d:Text="2026/06/06" 
                         Margin="0,5"
                                           Style="{StaticResource  OutlinedDatePicker}"
                                           SelectedDate="{Binding OrderHeader.DeliverDate, Mode=TwoWay, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            mt:HintAssist.Hint="Pick Date" />
            <TextBox  Grid.Row="3" Grid.Column="3" d:Text="跟单员" />


            <TextBox  Grid.Row="0" Grid.Column="5" d:Text="供应商" 
                      mt:DataGridDropdownAssist.DisplayMemberPath="SupplierName"
                      mt:DataGridDropdownAssist.ItemsSource="{Binding SupplierCodeList}"
                      mt:DataGridDropdownAssist.SelectedValuePath="SelectedSupplier"
                      mt:DataGridDropdownAssist.TargetValuePath="SupplierCode,SupplierName"
                      mt:DataGridDropdownAssist.RequireItemMatch="True"/>
            
            <TextBox  Grid.Row="1" Grid.Column="5" d:Text="进水管" />
            <TextBox  Grid.Row="2" Grid.Column="5" d:Text="起泡器" />
            <TextBox  Grid.Row="3" Grid.Column="5" d:Text="托盘" />
            
            <TextBox Margin="5,0,0,0" Grid.Row="0" Grid.Column="7" d:Text="内盒"/>
            <TextBox Margin="5,0,0,0" Grid.Row="1" Grid.Column="7" d:Text="标贴" />
            <TextBox Margin="5,0,0,0" Grid.Row="2" Grid.Column="7" d:Text="说明书" />
            <TextBox Margin="5,0,0,0" Grid.Row="3" Grid.Column="7" d:Text="外箱" />

            <TextBox  Grid.Row="0" Grid.Column="9" d:Text="光标" Grid.RowSpan="4" />

        </Grid>

        <GridSplitter x:Name="分割线" Grid.Row="2" BorderBrush="{DynamicResource Brush_Border_Light}" Margin="5" 
                      BorderThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" />


        <Grid x:Name="中部区域" Grid.Row="3" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel x:Name="工具栏" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8">
                <Button Command="{Binding AddLineCommand}" Margin="0,0,5,0"
                            Style="{StaticResource ButtonPrimary}"
                            Content="新增"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Add}"/>

                <Button Command="{Binding DeleteLineCommand}" Margin="0,0,5,0"
                            Style="{StaticResource ButtonDanger}"
                            Content="删除"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"/>
                <Button Command="{Binding InvertCheckCommand}" Margin="0,0,5,0"
                        mt:ButtonAssist.IconSize="12"
                        Style="{StaticResource ButtonBase}"
                        Content="反选"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"/>
                <!-- 主表选择模式切换按钮（整行选择 / 单元格+行头选择）。
                   使用 ToggleButton 的 IsChecked 来驱动 DataGrid.SelectionUnit，避免代码后台事件切换。 -->
                <ToggleButton x:Name="BtnToggleSelectionUnit"
                                      Margin="0,0,5,0"
                                      Padding="10,6"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      IsChecked="False">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}">
                            <Setter Property="ToolTip" Value="切换为整行选择"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="ToolTip" Value="切换为单元格选择"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <TextBlock x:Name="产品行数" Text="{Binding OrderLines.Items.Count, StringFormat='产品行数: {0}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Txt_Primary}"
                               Margin="20,0,0,0"/>

                <TextBlock x:Name="订单总数量" Text="{Binding OrderHeader.TotalQty, StringFormat='订单数量: {0:F2}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Primary}"
                               Margin="20,0,0,0"/>

                <TextBlock x:Name="订单总金额USD" Text="{Binding OrderLines.TotalUsdAmount, StringFormat='USD总额: {0:F2}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Primary}"
                               Margin="20,0,0,0"/>

                <TextBlock x:Name="订单总金额RMB" Text="{Binding OrderLines.TotalRmbAmount, StringFormat='RMB总额: {0:F2}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Visibility="{Binding OrderHeader.IsRmbCurrency,Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource Brush_Primary}"
                               Margin="20,0,0,0"/>

                <TextBlock x:Name="订单总箱数" Text="{Binding OrderLines.TotalCtns, StringFormat='总箱数: {0:F2}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Primary}"
                               Margin="20,0,0,0"/>

                <TextBlock x:Name="订单总体积" Text="{Binding OrderLines.TotalCbm, StringFormat='总CBM: {0:F3}'}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Primary}"
                               Margin="20,0,0,0"/>
            </StackPanel>


            <DataGrid x:Name="详情表格" Grid.Row="1" Grid.ColumnSpan="3" Margin="0"  
                          Tag="{Binding OrderHeader.IsRmbCurrency}"
                          ItemsSource="{Binding OrderLines.Items}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          HorizontalScrollBarVisibility="Auto"
                          HeadersVisibility="All"
                          RowHeight="64"
                          RowHeaderWidth="3"
                          EnableRowVirtualization="False"
                          EnableColumnVirtualization="False"
                          
                          mt:DataGridAssist.ShowRowNumber="False"
                          mt:DataGridAssist.AutoScrollToNewItem="True"
                          mt:DataGridExcelAssist.EnableExcelShortcuts="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"
                          mt:DataGridAssist.EnableSoftValidation="True">

                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
                        <Setter Property="SelectionUnit" Value="FullRow"/>
                        <Style.Triggers>
                            <!--中文注释：切到 CellOrRowHeader，便于单元格编辑场景。-->
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}" Value="True">
                                <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>



                <DataGrid.Columns>

                    <mtControls:CheckBoxDataGridTemplateColumn                          
                                            AllCheckedPropertyName="OrderLines.IsAllChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            ItemCheckedCommandName="ItemCheckedChangedCommand"
                                            HeaderCheckBoxMargin="3,0"
                                            HeaderCheckBoxToolTip="全选/全不选"/>
                    <DataGridTextColumn Header="行号" Visibility="Visible" Binding="{Binding LineNumber}" 
                                            SortMemberPath="LineNumber"
                                            Width="35" IsReadOnly="True"/>

                    <!-- 产品表：直接绑定到 SalesOrderLineModel 的字段 -->
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" 
                                                                    CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <!-- 链接物料编号（使用 DataGridTextColumn 保留原生编辑能力） -->
                    <DataGridTextColumn Header="物料编号"
                                        Width="120"
                                        SortMemberPath="Sku"
                                        IsReadOnly="{Binding Data, Source={StaticResource SelectionUnitProxy}}"
                                        Binding="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MultiLineDataGridTextBlockStyle}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DataGridTextBox}">
                                <!-- 中文注释：注入 DataGridDropdownAssist，下拉候选来自缓存Key，回写启用严格匹配（忽略大小写）。 -->
                                <Setter Property="mt:DataGridDropdownAssist.ItemsSource"
                                        Value="{Binding DataContext.SkuCacheKeys, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border CornerRadius="4"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Background="{TemplateBinding Background}">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2,0,24,0"/>
                                                </Border>

                                                <Button Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,2,0"
                                                        Padding="0"
                                                        Focusable="False"
                                                        Content="🔍"
                                                        ToolTip="搜索关联物料"
                                                        Command="{Binding DataContext.TriggerPopupButtonInCurrentCellCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    
                    <!-- 客户编号列：同样支持触发联想 Popup（与 SKU 列行为一致） -->
                    <DataGridTextColumn Header="客户编号"
                                        Width="120"
                                        Binding="{Binding CustomerSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MultiLineDataGridTextBlockStyle}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DataGridTextBox}">
                                <!-- 中文注释：注入 DataGridDropdownAssist，下拉候选来自缓存Key，回写启用严格匹配（忽略大小写）。 -->
                                <Setter Property="mt:DataGridDropdownAssist.ItemsSource"
                                        Value="{Binding DataContext.CustomerSkuCacheKeys, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border CornerRadius="4"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Background="{TemplateBinding Background}">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2,0,24,0"/>
                                                </Border>
                                                <Button Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,2,0"
                                                        Padding="0"
                                                        Focusable="False"
                                                        Content="🔍"
                                                        ToolTip="搜索客户SKU"
                                                        Command="{Binding DataContext.TriggerPopupButtonInCurrentCellCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="AQ编号" 
                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                            Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                    
                    <DataGridTextColumn Header="供应商编号" 
                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                            Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                    
                    <DataGridTextColumn Header="描述" 
                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                            Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                            Width="160"/>

                    <DataGridTextColumn Header="颜色" 
                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                            Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"/>

                    <DataGridTextColumn Header="配置" 
                                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                            Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                    <DataGridTextColumn Header="单价"
                                            mt:DataGridColumnAssist.BindableVisibility="{Binding Data.OrderHeader.IsRmbCurrency, Source={StaticResource VmProxy}}"
                                            Binding="{Binding CNYPrice, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, TargetNullValue=''}"
                                            Width="65"/>
                    <DataGridTextColumn Header="数量"
                                            Binding="{Binding QTY, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, TargetNullValue=''}"
                                            Width="65"/>
                    <DataGridTextColumn Header="金额"
                                            mt:DataGridColumnAssist.BindableVisibility="{Binding Data.OrderHeader.IsRmbCurrency, Source={StaticResource VmProxy}}"
                                            Binding="{Binding CNYAmount, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, TargetNullValue=''}"
                                            Width="65"/>
                    <DataGridTextColumn Header="备注"
                                            Binding="{Binding SubNote, UpdateSourceTrigger=PropertyChanged}"
                                            Width="220"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="合计行"  Grid.Row="2" Grid.ColumnSpan="3" Margin="0"
                      ItemsSource="{Binding Summary}"
                      HeadersVisibility="None"
                      IsReadOnly="True"
                      SelectionUnit="FullRow"                     
                      Height="30"/>

            <!--<customerControls:PurchaseOrderLinePopupSelectorControl x:Name="SupplierProductPopupSelector"
                                                                  IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                                                                  PopupPlacementTarget="{Binding PopupPlacementTarget}"
                                                                  RowContext="{Binding SelectedLine}"
                                                                  CustomerId="{Binding OrderHeader.CustomerId}"
                                                                  CustomerCode="{Binding OrderHeader.CustomerCode}"
                                                                  SubmitCommand="{Binding CommitPopupSelectionCommand}"/>-->
        </Grid>


        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>

                <TextBlock  Text="创建人:" Style="{StaticResource  BoldTextBlock}" Foreground="{DynamicResource Brush_Txt_Secondary}" />
                <TextBox Text="{Binding OrderHeader.CreatedBy}" d:Text="CreatedBy"

                             MinWidth="100"
                             Style="{StaticResource UnderLineTextBox}"
                             IsReadOnly="True"/>

                <TextBlock Text="创建时间:" Style="{StaticResource  BoldTextBlock}" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                <TextBox  Text="{Binding OrderHeader.CreatedDate, StringFormat=yyyy-MM-dd HH:mm:ss}" d:Text="2026/05/06"

                              Style="{StaticResource UnderLineTextBox}"
                              MinWidth="100"
                              IsReadOnly="True"/>

                <TextBlock  Text="更新人:" Style="{StaticResource  BoldTextBlock}" Foreground="{DynamicResource Brush_Txt_Secondary}" />
                <TextBox Text="{Binding OrderHeader.UpdatedBy}" d:Text="UpdatedBy"

                             Style="{StaticResource UnderLineTextBox}"
                             MinWidth="100"
                             IsReadOnly="True"/>

                <TextBlock  Text="更新时间:" Style="{StaticResource  BoldTextBlock}" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                <TextBox   Text="{Binding OrderHeader.UpdatedDate, StringFormat=yyyy-MM-dd HH:mm:ss}" d:Text="2026/05/06"

                               Style="{StaticResource UnderLineTextBox}"
                               MinWidth="100"
                               IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                <Button Command="{Binding SaveCommand}" Padding="20,8" Margin="0,0,8,0"
                        Style="{StaticResource ButtonSuccess}"
                        Content="保存"
                        Width="100"
                        Height="36"
                        FontSize="14"
                        mt:ButtonAssist.IconSize="10"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Save}"/>

                <Button Command="{Binding CancelCommand}" Padding="20,8"
                        Style="{StaticResource ButtonDanger}"
                        Content="取消"
                        Width="100"
                        Height="36"
                        FontSize="14"
                        IsCancel="True"
                        mt:ButtonAssist.IconSize="10"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Close}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
