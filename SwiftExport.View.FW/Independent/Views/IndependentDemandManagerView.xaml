<UserControl x:Class="SwiftExport.View.FW.Independent.Views.IndependentDemandManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SwiftExport.View.FW.Independent.Views"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.Independent.ViewModels"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             d:DataContext="{d:DesignInstance Type=vm:IndependentDemandManagerViewModel}"
             mc:Ignorable="d" 
             d:Background="{DynamicResource Brush_Bck_Page}" Width="1240" Height="684">
    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 筛选区 -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Background="{DynamicResource Brush_Control_Background}">
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Text="来源单号 " VerticalAlignment="Center"/>
                    <TextBox  Height="30" Width="100"
                         Style="{StaticResource MultiLineTextBoxStyle}"
                         Text="{Binding FilterSourceNo, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="关键字 " VerticalAlignment="Center"/>
                    <Grid Height="30" Width="180">
                        <TextBox x:Name="FilterTextBoxSmall"
                             Style="{StaticResource MultiLineTextBoxStyle}"
                             Text="{Binding FilterText, UpdateSourceTrigger=LostFocus}"
                             mt:TextBoxAssist.Placeholder="输入Sku,LinkSku,来源Sku搜索"
                             GotFocus="FilterTextBoxSmall_GotFocus"
                             IsReadOnly="True"
                             VerticalAlignment="Top"/>
                        <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterTextBoxSmall}"
                           Placement="Relative" VerticalOffset="0" HorizontalOffset="0"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           Opened="FilterPopup_Opened">
                            <TextBox x:Name="FilterPopupTextBox"
                                 Height="120"
                                 Width="{Binding ActualWidth, ElementName=FilterTextBoxSmall}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=LostFocus}"
                                 VerticalAlignment="Top" Margin="0"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 LostFocus="FilterPopupTextBox_LostFocus"
                                 Style="{StaticResource MultiLineTextBoxStyle}"/>
                        </Popup>
                    </Grid>

                    <TextBlock Text="开始日期 " VerticalAlignment="Center"/>
                    <DatePicker Height="30" Width="120" SelectedDate="{Binding FilterFromDate}"/>

                    <TextBlock Text="结束日期 " VerticalAlignment="Center"/>
                    <DatePicker Height="30" Width="120" SelectedDate="{Binding FilterToDate}"/>

                    <CheckBox Margin="0,0,10,0" VerticalAlignment="Center"
                          Width="100"
                          Content="仅未分解" IsChecked="{Binding FilterIsDecomposed}"/>

                    <Button Margin="0,0,8,0" MinWidth="80" Height="30"
                        Content="查询" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SearchCommand}"/>

                    <Button MinWidth="80" Height="30"
                        Content="重置" Style="{StaticResource ButtonBase}"
                        Command="{Binding ResetFilterCommand}"/>
                </StackPanel>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                    <Button Content="手工新建需求" Margin="0,0,8,0"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding CreatIndependComand}"/>

                    <Border Margin="8,0" Style="{StaticResource OutLineButtonStyleBorder}" >
                        <Grid  x:Name="导入">
                            <ToggleButton x:Name="MenuButton" Content="导入" Style="{StaticResource ExpanderUpHeaderStyle}" Padding="10,5"/>
                            <!-- Popup 负责折叠的内容 -->
                            <Popup IsOpen="{Binding IsChecked, ElementName=MenuButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" Placement="Bottom">
                                <Border Background="{DynamicResource Brush_Bck_Card}" BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel Width="180">
                                        <Button Margin="1" Content="从销售订单导入" Style="{StaticResource ButtonOutline}"
                                                Command="{Binding ImportFromSalesOrderCommand}"/>
                                        <Button Margin="1" Content="从售后订单导入" Style="{StaticResource ButtonOutline}"
                                                Command="{Binding ImportFromAfterSalesOrderCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <Button Width="60" Content="保存" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonSuccess}"
                            Command="{Binding SaveCommand}"/>

                    <Button Width="60" Content="确认" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding ConfirmCommand}"/>

                    <Button Width="80" Content="取消确认" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonDanger}"
                            Command="{Binding CancelConfirmCommand}"/>

                    <Button Content="将选定分解成净需求" Margin="0,0,8,0"
                            Style="{StaticResource ButtonSuccess}"
                            Command="{Binding DecomposeToDemandCommand}"/>

                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_Txt_Secondary}"
                               Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding HeadTable.Items}"
                      SelectedItem="{Binding SelectedHeadModel, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanUserAddRows="False"
                      RowHeight="64"
                      SelectionUnit="FullRow"
                      mt:DataGridAssist.ShowRowNumber="True">
                <DataGrid.Columns>
                    <mt:CheckBoxDataGridTemplateColumn
                        AllCheckedPropertyName="HeadTable.IsAllChecked"
                        ItemCheckedPropertyName="IsChecked"
                        ItemCheckedCommandName="{x:Null}"
                        HeaderCheckBoxMargin="3,0"
                        HeaderCheckBoxToolTip="全选/全不选"/>

                    <DataGridTemplateColumn Width="64" Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" />

                    <DataGridTextColumn Width="80" Header="状态" Binding="{Binding OrderStatus}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Header="来源单据类型" Binding="{Binding SourceType}"/>
                    <DataGridTextColumn Width="100" Header="来源单号" Binding="{Binding SourceNo}"/>
                    <DataGridTextColumn Width="100" Header="来源型号" Binding="{Binding SourceSku}"/>
                    <DataGridTextColumn Width="120" Header="Sku" Binding="{Binding Sku}"/>
                    <DataGridTextColumn Width="120" Header="LinkSku" Binding="{Binding Sku}"/>
                    <DataGridTextColumn Width="120" Header="期望交期" Binding="{Binding HopefulDate, StringFormat=yyyy-MM-dd}"/>
                    <DataGridTextColumn Width="120" Header="描述" Binding="{Binding Description}"/>
                    <DataGridTextColumn Width="120" Header="颜色" Binding="{Binding ColorName}"/>
                    <DataGridTextColumn Width="120" Header="规格" Binding="{Binding Features}"/>
                    <DataGridTextColumn Width="120" Header="需求数量" Binding="{Binding OriginalQty}"/>
                    <DataGridTextColumn Width="120" Header="已填充数量" Binding="{Binding FilledQty}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="120" Header="已发货数量" Binding="{Binding ShippedQty}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="120" Header="备注" Binding="{Binding Remark}" />
                    <DataGridTextColumn Width="120" Header="最近一次发货日期" Binding="{Binding LastShippedDate, StringFormat=yyyy-MM-dd}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="120" Header="审批状态" Binding="{Binding ApprovalStatus}" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Width="70" Header="是否齐套" Binding="{Binding IsKitted}" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Width="70" Header="是否已拆解" Binding="{Binding IsDecomposed}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="120" Header="最近一次拆解时间" Binding="{Binding DecomposedTime, StringFormat=yyyy-MM-dd}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="100" Header="创建人" Binding="{Binding CreatedBy}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Header="创建时间" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd-HH-mm-ss}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Header="更新人" Binding="{Binding UpdatedBy}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Header="更新时间" Binding="{Binding UpdatedDate, StringFormat=yyyy-MM-dd-HH-mm-ss}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 底部分页 -->
            <mt:PageNavigator Grid.Row="2" Margin="0,8,0,0"
                      HorizontalAlignment="Right"
                      TotalCount="{Binding TotalCount}"
                      PageIndex="{Binding PageIndex, Mode=OneWay}"
                      PageSize="{Binding PageSize, Mode=OneWay}"
                      PageChangeCommand="{Binding PageChangeCommand}"/>

        </Grid>
        <mt:DialogHost d:IsHidden="True"/>
    </Grid>
</UserControl>
