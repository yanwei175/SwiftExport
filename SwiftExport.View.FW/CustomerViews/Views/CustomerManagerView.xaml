<UserControl x:Class="SwiftExport.View.FW.CustomerViews.Views.CustomerManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        x:Name="RootUserCtrl"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        xmlns:vm="clr-namespace:SwiftExport.View.FW.CustomerViews.ViewModels"
        xmlns:views="clr-namespace:SwiftExport.View.FW.CustomerViews.Views"
        mc:Ignorable="d"
        d:DesignHeight="768" d:DesignWidth="1024"
        d:DataContext="{d:DesignInstance vm:CustomerManagerViewModel}"
        Background="{DynamicResource Brush_Bck_Card}">

    <UserControl.Resources>
        <ResourceDictionary>
            <mt:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>
            <mt:EnumToIntConverter x:Key="EnumToIntConverter"/>

            <Style x:Key="FinishAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.ProductFinishList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="ColorNameZh" />
                <Setter Property="mt:DataGridDropdownAssist.FilterMemberPaths" Value="ColorNameZh,ColorNameEn,ColorCode" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="CustomerCodeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.CustomerCodeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Margin="15" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding ActiveTab, Mode=TwoWay,Converter={StaticResource EnumToIntConverter}}"
                    d:SelectedIndex="0">

            <TabItem Header="客户列表" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="客户表工具栏" Grid.Row="0"  Background="{DynamicResource Brush_Bck_Card}" BorderThickness="0,0,0,1" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Margin="0,0,10,0"  
                                        Style="{StaticResource ButtonPrimary}"
                                        Content="新增"
                                        mt:ButtonAssist.IconSize="12"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                                        Command="{Binding AddCustomerCommand}" />
                                <Button  Margin="0,0,10,0" 
                                         Style="{StaticResource ButtonSuccess}"
                                         Content="保存"
                                         mt:ButtonAssist.IconSize="12"
                                         mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                                        Command="{Binding BatchSaveCustomerAsyncCommand}" />
                                <Button  Margin="0,0,10,0" 
                                         Style="{StaticResource ButtonDanger}"
                                         Content="删除"
                                         mt:ButtonAssist.IconSize="12"
                                         mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"
                                        Command="{Binding DeleteCustomerAsyncCommand}" />
                                <Button Margin="0,0,10,0"
                                       Style="{StaticResource ButtonBase}"
                                       Content="刷新"
                                        mt:ButtonAssist.IconSize="12"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                        Command="{Binding LoadCustomerAsyncCommand}"/>
                                <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                                <Button Margin="0,0,10,0"
                                       Style="{StaticResource ButtonBase}"
                                       Content="反选"
                                        mt:ButtonAssist.IconSize="12"
                                        mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                        Command="{Binding InvertCheckCommand}"/>
                                <TextBlock Text="筛选: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="250" Text="{Binding SearchCustomerText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="客户表DataGrid"
                                  ItemsSource="{Binding CurrentCustomerTable.Items}" 
                                  SelectedItem="{Binding SelectedCustomer}"
                                  SelectionUnit="FullRow"
                                  RowHeight="30"
                                  EnableRowVirtualization="False"
                                  EnableColumnVirtualization="False"
                                  mt:DataGridAssist.ShowRowNumber="True"
                                  mt:DataGridAssist.EnableSoftValidation="True"
                                  mt:DataGridAssist.AutoScrollToNewItem="True"
                                  >
                        <DataGrid.Columns>

                            <mt:CheckBoxDataGridTemplateColumn 
                                            AllCheckedPropertyName="CurrentCustomerTable.IsAllChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            ItemCheckedCommandName="{x:Null}"
                                            HeaderCheckBoxMargin="3"
                                            HeaderCheckBoxToolTip="全选/全不选"/>

                            <DataGridTextColumn Header="客户代码" 
                                            Binding="{Binding CustomerCode,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=False}" 
                                            Width="100" FontWeight="Bold"/>

                            <DataGridTextColumn Header="客户名称" Binding="{Binding CustomerName,UpdateSourceTrigger=PropertyChanged}" Width="150"/>

                            <DataGridTextColumn Header="单据关联号" Binding="{Binding DocRelateNo}" Width="120"/>

                            <DataGridTextColumn Header="联系人" Binding="{Binding ContactPerson}" Width="100"/>

                            <DataGridTextColumn Header="电话" Binding="{Binding PhoneNumber}" Width="140"/>

                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="150" 
                                            ElementStyle="{DynamicResource  MultiLineDataGridTextBlockStyle}" 
                                            EditingElementStyle="{DynamicResource MultiLineDataGridTextBoxStyle}"/>

                            <!-- ==================== 贸易条款默认值字段 ==================== -->
                            <DataGridTextColumn Header="贸易条款" Binding="{Binding Incoterm}" Width="90"/>

                            <DataGridTextColumn Header="贸易地点" Binding="{Binding IncotermLocation}" Width="100"/>

                            <DataGridTextColumn Header="定金比例" Binding="{Binding DepositRate}" Width="80"/>

                            <DataGridTextColumn Header="交货周期(天)" Binding="{Binding LeadTimeDays}" Width="100"/>

                            <DataGridTextColumn Header="付款方式" Binding="{Binding PaymentMethod}" Width="90"/>

                            <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="70"/>

                            <DataGridTextColumn Header="承运方式" Binding="{Binding ShippedBy}" Width="90"/>

                            <DataGridTextColumn Header="交期备注" Binding="{Binding EtdSortRemark}" Width="120"
                                            ElementStyle="{DynamicResource  MultiLineDataGridTextBlockStyle}" 
                                            EditingElementStyle="{DynamicResource MultiLineDataGridTextBoxStyle}"/>

                            <DataGridTextColumn Header="贸易条款备注" Binding="{Binding IncotermSortRemark}" Width="150"
                                            ElementStyle="{DynamicResource  MultiLineDataGridTextBlockStyle}" 
                                            EditingElementStyle="{DynamicResource MultiLineDataGridTextBoxStyle}"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <mt:PageNavigator Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right" 
                                                   TotalCount="{Binding TotalCustomerTableCount}" 
                                                   PageIndex="{Binding PageCustomerTableIndex, Mode=OneWay}"
                                                   PageSize="{Binding PageCustomerTableSize, Mode=OneWay}"
                                                   PageChangeCommand="{Binding PaginationCustomerTableChangedCommand}"/>

                </Grid>
            </TabItem>

            <TabItem Header="客户产品管理" Background="Transparent">
                <!-- 中文注释：子视图 CustomerProductManagerView，DataContext 由 code-behind 绑定到 CustomerProductVM -->
                <views:CustomerProductManagerView x:Name="CustomerProductSubView"/>
            </TabItem>

        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,5">

            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource Red8Brush}"
                               Style="{StaticResource BoldTextBlock}"
                               Text="{Binding SelectedCustomer.CustomerName,StringFormat='当前选择客户: {0}'}"/>

            <TextBlock FontSize="12" Foreground="{DynamicResource Red8Brush}" 
                           Margin="20,5"
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center"/>
        </StackPanel>


        <mt:DialogHost d:IsHidden="True" />
    </Grid>
</UserControl>