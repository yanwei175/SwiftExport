<Window x:Class="SwiftExport.View.FW.CustomerViews.Views.CustomerPoConfigManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        x:Name="RootWindow"
        
        xmlns:mt ="https://MateWpfTheme.com/wpf/framework/themes"
        
        xmlns:mock="clr-namespace:SwiftExport.View.FW.CustomerViews.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        
        Title="采购单客户默认配置管理" Height="768" Width="1026"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush_Bck_Page}">

    
    
    <Window.Resources>
        <ResourceDictionary>
            
            <Style x:Key="CustomerAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.Customers, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="CustomerCode" />
            </Style>

            <Style x:Key="SupplierAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.Suppliers, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="SupplierCode" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource Neutral1Brush}" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource  ButtonPrimary}" Command="{Binding AddNewRowCommand}" Margin="0,0,10,0"
                            Content="新建"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                        </Button>

                        <Button Style="{StaticResource  ButtonSuccess}" 
                            Command="{Binding BatchSaveCommand}" 
                            IsEnabled="{Binding HasChanges}"
                            Margin="0,0,10,0"
                                                         Content="保存"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Save}">
                        </Button>

                        <Button Style="{StaticResource ButtonDanger}" Command="{Binding DeleteCheckedCommand}" Margin="0,0,10,0" 
                            IsEnabled="{Binding HasSelectedItems}"
                                                         Content="删除"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Save}">
                        </Button>

                        <Button Command="{Binding LoadCommand}" Margin="0,0,10,0" Style="{StaticResource ButtonOutline}"
                                                   Content="刷新"
                        mt:ButtonAssist.IconSize="12"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>


                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                    <Button Command="{Binding InvertCheckCommand}"  Margin="0,0,5,0" Style="{StaticResource ButtonBase}"
                                                         Content="反选"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
 
                    </Button>



                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Brush_Txt_Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedCount, StringFormat='已选中 {0} 项'}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="查询: " VerticalAlignment="Center"  Margin="0,0,5,0"/>
                    <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource Brush_Bck_Page}" Padding="5">
            <DataGrid x:Name="MainDataGrid"
                    ItemsSource="{Binding ItemsView}" 
                    HorizontalScrollBarVisibility="Auto"  
                    HeadersVisibility="All" 
                    SelectionUnit="CellOrRowHeader"
                    FrozenColumnCount="3"
                    RowHeight="40"
                    mt:DataGridAssist.ShowRowNumber="True">

                <DataGrid.RowHeaderStyle>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Light}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="删除此行" 
                                              Foreground="{DynamicResource Brush_Warning}"
                                              Command="{Binding PlacementTarget.Tag.SingleDeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush_Btn_Default_Background}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowHeaderStyle>

                

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="35" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" 
                                      ToolTip="全选/全不选" 
                                      Margin="-9"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" 
                                      Command="{Binding DataContext.ItemCheckedChangedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="客户代码" Width="80" 
                                        Binding="{Binding CustomerCode}"
                                        EditingElementStyle="{StaticResource  CustomerAutoCompleteEditStyle}" 
                                        />
                    <DataGridTextColumn Header="供应商代码" Width="80" 
                                        Binding="{Binding SupplierCode}"
                                        EditingElementStyle="{StaticResource  SupplierAutoCompleteEditStyle}" />

                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="140" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}">
                        </DataGridTextColumn>

                    <DataGridTextColumn Header="光标" Binding="{Binding LogoType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="标贴" Binding="{Binding LabelType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="说明书" Binding="{Binding IMType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="内盒" Binding="{Binding BoxType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="外箱" Binding="{Binding CartonType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="进水管" Binding="{Binding InletHoseType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="起泡器" Binding="{Binding AeratorType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}" />
                    <DataGridTextColumn Header="业务员" Binding="{Binding SalesPerson}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="跟单员" Binding="{Binding Purchaser}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                    <DataGridTextColumn Header="托盘" Binding="{Binding PalletType}" Width="100" 
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" 
                                        EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource    Brush_Bck_Card}" BorderBrush="{DynamicResource Neutral1Brush}" BorderThickness="0,1,0,0" Padding="15,8">

            <mt:PaginationControl HorizontalAlignment="Right" 
                                    TotalCount="{Binding TotalCount}" 
                                    PageIndex="{Binding PageIndex, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    PageSize="{Binding PageSize, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        </Border>

        </Grid>
        <mt:DialogHost />
    </Grid>
</Window>