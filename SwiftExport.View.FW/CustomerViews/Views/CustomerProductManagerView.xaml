<UserControl x:Class="SwiftExport.View.FW.CustomerViews.Views.CustomerProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:assist="clr-namespace:MateWpfThemes.FW.AttachedProperties;assembly=MateWpfThemes.FW"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.CustomerViews.ViewModels"
             xmlns:mvvm="clr-namespace:SwiftExport.View.FW.Mvvm"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignHeight="600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:CustomerProductManagerViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <mt:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>
            <mvvm:BindingProxy x:Key="SelectionUnitProxy" Data="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <!-- 工具栏 -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid -->
                <RowDefinition Height="*"/>
                <!-- 翻页控件 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ====== 工具栏 ====== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush_Bck_Card}"
                    BorderThickness="0,0,0,1"
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">

                        <!-- 新增 -->
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource ButtonPrimary}"
                                Content="新增"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                                Command="{Binding AddProductCommand}"/>

                        <!-- 保存 -->
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource ButtonSuccess}"
                                Content="保存"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                                Command="{Binding BatchSaveProductAsyncCommand}"/>

                        <!-- 删除 -->
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource ButtonDanger}"
                                Content="删除"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"
                                Command="{Binding DeleteProductAsyncCommand}"/>

                        <!-- 刷新 -->
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource ButtonBase}"
                                Content="刷新"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                Command="{Binding RefreshProductCommand}"/>

                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                        <!-- 反选 -->
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource ButtonBase}"
                                Content="反选"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                Command="{Binding InvertProductSelectionCommand}"/>

                        <!-- 选择模式切换按钮（整行 / 单元格+行头） -->
                        <ToggleButton x:Name="BtnToggleSelectionUnit"
                                      Margin="0,0,5,0"
                                      Padding="10,6"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      IsChecked="False">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}">
                                    <Setter Property="ToolTip" Value="切换为整行选择"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="切换为单元格选择"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <TextBlock Text="筛选: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="250"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchProductTxt, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====== DataGrid ====== -->
            <DataGrid Grid.Row="1"
                      FrozenColumnCount="4"
                      x:Name="CustomerProductDataGrid"
                      ItemsSource="{Binding ProductList.Items}"
                      SelectedItem="{Binding SelectedProduct}"
                      FontSize="10"
                      HorizontalScrollBarVisibility="Auto"
                      HeadersVisibility="All"
                      Margin="0,5,0,0"
                      RowHeight="45"
                      EnableRowVirtualization="False"
                      EnableColumnVirtualization="False"
                      mt:DataGridAssist.ShowRowNumber="True"
                      mt:UndoManager.IsUndoEnabled="True"
                      mt:DataGridAssist.AutoScrollToNewItem="True"
                      mt:DataGridAssist.EnableSoftValidation="True"
                      mt:DataGridExcelAssist.EnableExcelShortcuts="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"
                      mt:DataGridExcelAssist.EnableDirtyTracking="True">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
                        <!-- 默认保持整行模式，便于稳定触发行选择 -->
                        <Setter Property="SelectionUnit" Value="FullRow"/>
                        <Style.Triggers>
                            <!-- 切换为单元格模式，便于单元格编辑 -->
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}" Value="True">
                                <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>

                    <!-- 勾选列 -->
                    <mt:CheckBoxDataGridTemplateColumn
                        AllCheckedPropertyName="ProductList.IsAllChecked"
                        ItemCheckedPropertyName="IsChecked"
                        ItemCheckedCommandName="{x:Null}"
                        HeaderCheckBoxMargin="3"
                        HeaderCheckBoxToolTip="全选/全不选"/>

                    <!-- 图片 -->
                    <DataGridTemplateColumn Header="图片" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding MainImage, Converter={StaticResource ImgPathToImgConverter}}"
                                       Width="48" Height="48"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 客户料号 -->
                    <DataGridTextColumn Header="客户料号"
                                        Binding="{Binding CustomerSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120" FontWeight="Bold"/>
                    
                    <!-- 链接物料编号（使用 DataGridTextColumn 保留原生编辑能力） -->
                    <DataGridTextColumn Header="关联物料编号"
                                        Width="130"
                                        SortMemberPath="Sku"
                                        IsReadOnly="{Binding Data, Source={StaticResource SelectionUnitProxy}}"
                                        Binding="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MultiLineDataGridTextBlockStyle}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DataGridTextBox}">
                                <!-- 中文注释：桥接附加属性方式挂载 Popup 行为，兼容 DataGridTextColumn 原生流程 -->
                                <Setter Property="assist:DataGridTextColumnAssist.IsEnabled" Value="True"/>
                                <Setter Property="assist:DataGridTextColumnAssist.Popup" Value="{Binding ElementName=PopupForCustomerProduct}"/>
                                <Setter Property="assist:DataGridTextColumnAssist.SearchCommand"
                                        Value="{Binding DataContext.SearchPdForBomPopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="assist:DataGridTextColumnAssist.CommitCommand"
                                        Value="{Binding DataContext.CommitPdForBomPopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Style.Triggers>
                                    <!-- 中文注释：单元格模式下禁用 Popup 搜索与提交，避免误选与性能开销。 -->
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}" Value="True">
                                        <Setter Property="assist:DataGridTextColumnAssist.IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    

                    <!-- 客户描述 -->
                    <DataGridTextColumn Header="客户描述" Width="150"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                        EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                        Binding="{Binding CustomerPdDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 产品系列 -->
                    <DataGridTextColumn Header="客户系列" Width="100"
                                        Binding="{Binding CustomerPdSeries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 客户颜色 -->
                    <DataGridTextColumn Header="客户颜色" Width="100"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                        EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                        Binding="{Binding CustomerColorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 客户配置 -->
                    <DataGridTextColumn Header="客户配置" Width="150"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                                        EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                                        Binding="{Binding CustomerPdFeatures, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 单位 -->
                    <DataGridTextColumn Header="单位" Width="80"
                                        Binding="{Binding CustomerSkuUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 币种 -->
                    <DataGridTextColumn Header="币种" Width="80"
                                        Binding="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 美元单价 -->
                    <DataGridTextColumn Header="USD单价" Width="90"
                                        Binding="{Binding USDPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 人民币单价 -->
                    <DataGridTextColumn Header="CNY单价" Width="90"
                                        Binding="{Binding CNYPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 条码1码制 -->
                    <DataGridTextColumn Header="条码1码制" Width="90"
                                        Binding="{Binding Barcode1Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 条码1 -->
                    <DataGridTextColumn Header="条码1" Width="150"
                                        Binding="{Binding CustomerBarcode1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 条码2码制 -->
                    <DataGridTextColumn Header="条码2码制" Width="90"
                                        Binding="{Binding Barcode2Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 条码2 -->
                    <DataGridTextColumn Header="条码2" Width="150"
                                        Binding="{Binding CustomerBarcode2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 最小起订量 -->
                    <DataGridTextColumn Header="起订量" Width="80"
                                        Binding="{Binding MOQ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 交期天数 -->
                    <DataGridTextColumn Header="交期(天)" Width="80"
                                        Binding="{Binding LeadTimeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 是否启用（只读展示） -->
                    <DataGridCheckBoxColumn Header="启用" Width="60" IsReadOnly="True"
                                            Binding="{Binding IsActive}"/>

                </DataGrid.Columns>
            </DataGrid>
            <!--快速搜索产品-->
            <Popup x:Name="PopupForCustomerProduct"
                   IsOpen="{Binding IsPopupOpen}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   Focusable="False">

                <Border BorderBrush="{DynamicResource Brush_Border_Default}"
                        Background="{DynamicResource Brush_Bck_Card}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4"
                        SnapsToDevicePixels="True">

                    <ListBox ItemsSource="{Binding PopItemSource}"
                             SelectedItem="{Binding PopSelectedItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Focusable="False"
                             MinWidth="280"
                             MinHeight="60"
                             MaxHeight="260">

                        <!-- 每项模板：图片 + SKU + 描述 -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <Image DockPanel.Dock="Left"
                                           Width="32" Height="32"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"
                                           Source="{Binding MainImage, Converter={StaticResource ImgPathToImgConverter}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sku}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#888"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>
                </Border>
            </Popup>
            <!-- ====== 翻页控件 ====== -->
            <mt:PageNavigator Grid.Row="2"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Right"
                              TotalCount="{Binding TotalCount}"
                              PageIndex="{Binding PageIndex, Mode=OneWay}"
                              PageSize="{Binding PageSize, Mode=OneWay}"
                              PageChangeCommand="{Binding PageChangeCommand}"/>
        </Grid>

        
        <mt:DialogHost d:IsHidden="True"/>
    </Grid>
</UserControl>
