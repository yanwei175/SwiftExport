<Window x:Class="SwiftExport.View.FW.CustomerViews.Views.CustomerSelectorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        xmlns:vm="clr-namespace:SwiftExport.View.FW.CustomerViews.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CustomerSelectorDialogViewModel}"
        Title="选择客户"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource ReadOnlyDataGridRow}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询区域 -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="搜索 (客户代码/名称/联系人):" Foreground="{DynamicResource Brush_Txt_Primary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SearchTextBox"
                             Height="30"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                             mt:TextBoxAssist.Placeholder="输入关键字进行查询"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="批量查询 (支持多行):" Foreground="{DynamicResource Brush_Txt_Primary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Height="80"
                             Padding="4"
                             mt:TextBoxAssist.Placeholder="每行输入一个客户代码或关键字"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表区域 -->
        <Grid Grid.Row="1" Margin="15">
            <DataGrid x:Name="SourceDataGrid"
                      ItemsSource="{Binding SourceCustomers}"
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      FontSize="11"
                      RowHeight="36"
                      MouseDoubleClick="SourceDataGrid_MouseDoubleClick"
                      PreviewKeyDown="SourceDataGrid_PreviewKeyDown"
                      ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                      mt:DataGridAssist.ShowRowNumber="True">


                    
                    <DataGrid.Columns>
                    <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="120" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="客户名称" Binding="{Binding CustomerName}" Width="220" ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="联系人" Binding="{Binding ContactPerson}" Width="120" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="联系电话" Binding="{Binding PhoneNumber}" Width="130" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="付款方式" Binding="{Binding PaymentMethod}" Width="120" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="80" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="交货天数" Binding="{Binding LeadTimeDays}" Width="90" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="贸易条款" Binding="{Binding Incoterm}" Width="110" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="条款地点" Binding="{Binding IncotermLocation}" Width="120" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="正在查询客户..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#0078D4"/>
            </Grid>
        </Grid>

        <!-- 底部操作区 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666" Margin="0,0,265,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ButtonDanger}"
                            Content="取消"
                            Command="{Binding CancelCommand}"/>

                    <Button Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource ButtonSuccess}"
                            IsDefault="True"
                            Content="确定"
                            Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <mt:DialogHost />
    </Grid>
</Window>
