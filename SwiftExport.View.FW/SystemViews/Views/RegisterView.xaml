<Window x:Class="SwiftExport.View.FW.SystemViews.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.SystemViews.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RegisterViewModel}"
             Height="750" Width="480"             
             WindowStyle="None"
             AllowsTransparency="True"
             WindowStartupLocation="CenterScreen"
             Title="注册"
             Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Margin="20" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Style="{StaticResource Dialog}" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonIcon}"
                            IsCancel="True"
                            mt:ButtonAssist.IconSize="10"
                            mt:ButtonAssist.IconForeground="Gray"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Close}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 标题 -->
                    <TextBlock Text="注册新用户"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush_Primary}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="仅管理员账号可创建新用户"
                               Foreground="{DynamicResource Brush_Txt_Secondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 管理员校验提示（非 admin 登录时显示橙色警告；code-behind 控制 Visibility）-->
                    <Border x:Name="AdminWarningBorder"
                            Background="Transparent"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  " FontSize="13" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Brush_Warning}"/>
                            <TextBlock Text="{Binding AdminHint}" FontSize="12" TextWrapping="Wrap"
                                        Foreground="{DynamicResource Brush_Warning}"/>
                        </StackPanel>
                    </Border>

                    <!-- 表单区（非 admin 时 code-behind 置灰）-->
                    <StackPanel x:Name="FormPanel">

                        <!-- 登录用户名（必填）-->
                        <TextBlock Text="登录用户名 *" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 mt:TextBoxAssist.Placeholder="字母/数字，唯一标识"
                                 mt:TextBoxAssist.ShowClearButton="True"
                                 Height="32" VerticalContentAlignment="Center"
                                 Margin="0,0,0,14"/>

                        <!-- 昵称（选填）-->
                        <TextBlock Text="昵称（显示名）" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}"
                                 mt:TextBoxAssist.Placeholder="可选，留空则同用户名"
                                 Height="32" VerticalContentAlignment="Center" 
                                 Margin="0,0,0,14"/>

                        <!-- 密码（必填）-->
                        <TextBlock Text="密码 *（至少6位）" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PwdBox"
                                     Height="32" 
                                     Margin="0,0,0,14"/>

                        <!-- 确认密码 -->
                        <TextBlock Text="确认密码 *" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPwdBox"
                                     Height="32" 
                                     Margin="0,0,0,14"/>

                        <!-- 邮箱（选填）-->
                        <TextBlock Text="邮箱" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 mt:TextBoxAssist.Placeholder="可选"
                                 Height="32" VerticalContentAlignment="Center" 
                                 Margin="0,0,0,14"/>

                        <!-- 手机号（选填）-->
                        <TextBlock Text="手机号" FontSize="12"
                                    Foreground="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 mt:TextBoxAssist.Placeholder="可选"
                                 Height="32" VerticalContentAlignment="Center" 
                                 Margin="0,0,0,24"/>

                    </StackPanel>

                    <!-- 操作按钮 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="清 空"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ButtonBase}"
                                Height="38"/>

                        <!-- 注册按钮：密码由 code-behind 合并传入 -->
                        <Button Grid.Column="2" x:Name="RegisterBtn"
                                Content="注册用户"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="38"/>
                    </Grid>

                    <!-- 状态提示 -->
                    <TextBlock x:Name="StatusTxt"
                               Text="{Binding StatusMessage}"
                               FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Danger}"/>

                    <!-- 忙碌进度条 -->
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                </StackPanel>
            </ScrollViewer>
            <mt:DialogHost/>
        </Grid>
    </Border>
</Window>
