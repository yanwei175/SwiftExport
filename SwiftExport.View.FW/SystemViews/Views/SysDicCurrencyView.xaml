<UserControl x:Class="SwiftExport.View.FW.SystemViews.Views.SysDicCurrencyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        xmlns:vm="clr-namespace:SwiftExport.View.FW.SystemViews.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SysDicCurrencyViewModel}"
        d:Height="720" d:Width="1200"
        Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <mt:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Margin="10" Padding="0" CornerRadius="4"
                Background="{DynamicResource Brush_Control_Background}"
                mt:ShadowAssist.Level="Medium">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 本位币切换栏 + 搜索栏 -->
                    <RowDefinition Height="*"/>     <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
                </Grid.RowDefinitions>

                <!-- ===== 工具栏 ===== -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Brush_Border_Light}" Padding="15,10">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="货币管理" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ButtonPrimary}"
                                Content="创建"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                                Command="{Binding CreateCommand}"/>
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ButtonBase}"
                                Content="刷新"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                Command="{Binding RefreshCommand}"/>

                        <Rectangle Width="1" Fill="{DynamicResource Brush_Border_Light}"
                                   Margin="5,4,12,4" VerticalAlignment="Stretch"/>

                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ButtonBase}"
                                Content="反选"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                                Command="{Binding InvertCheckCommand}"/>
                        <!-- ── 搜索栏 ── -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="280" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     mt:TextBoxAssist.Placeholder="搜索货币代码 / 名称 / 符号..."
                                     mt:TextBoxAssist.ShowClearButton="True"
                                     />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 本位币切换栏 + 搜索栏 ===== -->
                <Border Grid.Row="1" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Brush_Border_Light}" Padding="15,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>   <!-- 本币位显示 -->
                            <ColumnDefinition Width="5*"/>     <!-- 分隔 -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <!-- ── 本位币切换器（DataGrid 左上方核心控件）── -->
                            <TextBlock Width="90" Grid.Column="0" 
                                       d:Text="主币种: 人民币"
                                       Text="{Binding CurrentBaseNameZh,StringFormat='主币种: {0}'}" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button 
                                Style="{StaticResource ButtonIconEdit}"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Settings}"
                                Command="{Binding OpenEditBaseSwitchCommand}"/>
                        </StackPanel>
<!--右侧菜单区-->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== DataGrid ===== -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedItem}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          SelectionUnit="FullRow"
                          RowHeight="40"
                          CanUserAddRows="False"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="False"
                          EnableColumnVirtualization="False"
                          mt:DataGridAssist.ShowRowNumber="True"
                          mt:DataGridAssist.AutoScrollToNewItem="True">

                    <DataGrid.Columns>

                        <!-- 勾选列 -->
                        <mt:CheckBoxDataGridTemplateColumn
                            AllCheckedPropertyName="CurrentTable.IsAllChecked"
                            ItemCheckedPropertyName="IsChecked"
                            ItemCheckedCommandName="{x:Null}"
                            HeaderCheckBoxMargin="3"
                            HeaderCheckBoxToolTip="全选/全不选"/>

                        <!-- 货币代码（必填，加粗） -->
                        <DataGridTextColumn Header="货币ISO代码" Width="100" FontWeight="Bold"
                            Binding="{Binding CurrencyCode}"
                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 货币中文名 -->
                        <DataGridTextColumn Header="中文名称" Width="120"
                            Binding="{Binding CurrencyNameZh}"
                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 货币英文名 -->
                        <DataGridTextColumn Header="英文名称" Width="140"
                            Binding="{Binding CurrencyNameEn}"
                            ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"
                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 货币符号 -->
                        <DataGridTextColumn Header="符号" Width="60"
                            Binding="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"
										
                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 小数精度 -->
                        <DataGridTextColumn Header="精度" Width="55"
                            Binding="{Binding Precision}"
									
                            EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 汇率（切换本位币时会被清空） -->
                        <DataGridTextColumn Header="对本位币汇率" Width="120"
                            Binding="{Binding RateToBase}"
							EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>

                        <!-- 是否启用 -->
                        <DataGridCheckBoxColumn Header="启用状态" Width="80"
                            ElementStyle="{StaticResource  DataGridCheckBoxColumnStyle}"
                            Binding="{Binding IsEnabled}"/>

                            <!-- 系统内置（只读） -->
                            <DataGridCheckBoxColumn Header="系统内置" Width="80"
                                IsReadOnly="True"
                                ElementStyle="{StaticResource DataGridCheckBoxColumnStyle}"
                                Binding="{Binding IsSystem}"/>

                        <!-- 备注 -->
                        <DataGridTextColumn Header="备注" Width="*"
                            Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}"
                            ElementStyle="{DynamicResource MultiLineDataGridTextBlockStyle}"/>

                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ButtonIconEdit}"
                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                mt:ButtonAssist.IconSize="13"
                                                mt:ButtonAssist.Icon="{StaticResource Icon.Edit}"/>
                                        <Button Style="{StaticResource ButtonIconDelete}"
                                                IsEnabled="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                mt:ButtonAssist.IconSize="13"
                                                mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- ===== 状态栏 ===== -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Brush_Border_Light}"
                        BorderThickness="0,1,0,0" Padding="15,5">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{DynamicResource Brush_Txt_Secondary}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 编辑弹窗遮罩 ===== -->
        <Grid Background="#66000000" d:Visibility="Collapsed"
              Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="997"
              FocusManager.IsFocusScope="True">

            <Border Style="{StaticResource Dialog}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20" MinWidth="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="编辑货币" Style="{StaticResource BoldTextBlock}" Margin="0,0,0,10"/>

                    <!-- 表单字段 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="货币ISO代码:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Margin="0,5"
                                 IsReadOnly="{Binding EditingItem.IsSystem}"
                                 Text="{Binding EditingItem.CurrencyCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="中文名称:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,5"
                                 Text="{Binding EditingItem.CurrencyNameZh, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="英文名称:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Margin="0,5"
                                 Text="{Binding EditingItem.CurrencyNameEn, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="货币符号:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Margin="0,5"
                                 Text="{Binding EditingItem.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="小数精度:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="2" Margin="0,5"
                                 Text="{Binding EditingItem.Precision, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="对本位币汇率:" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox Grid.Row="5" Grid.Column="2" Margin="0,5"
                                 Text="{Binding EditingItem.RateToBase, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="是否启用:" TextAlignment="Right" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="7" Grid.Column="2" Margin="0,8"
                                  IsChecked="{Binding EditingItem.IsEnabled}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="备注:" TextAlignment="Right"/>
                        <TextBox Grid.Row="8" Grid.Column="2" Margin="0,5" Height="80"
                                 Style="{StaticResource MultiLineTextBoxStyle}"
                                 Text="{Binding EditingItem.Remark, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="70" Margin="0,0,8,0"
                                Style="{StaticResource ButtonBase}"
                                Content="取消"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Width="70"
                                Style="{StaticResource ButtonSuccess}"
                                Content="保存"
                                Command="{Binding SaveEditCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!--编辑主币种-->

        <Grid Background="#66000000" d:Visibility="Collapsed"
              Visibility="{Binding IsEditBaseSwitchDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999"
              FocusManager.IsFocusScope="True">

            <Border Style="{StaticResource Dialog}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20" MinWidth="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="设置主币种" Style="{StaticResource BoldTextBlock}" Margin="0,0,0,10"/>

                    <!-- 表单字段 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Margin="0,10,0,10" Width="300"
                                       HorizontalAlignment="Stretch"
                                       Text="设置币种后，所有其他币种的金额如需要进行货币换算，将以主币种的执行汇率进行换算。"/>

                        <ComboBox Grid.Row="1" Width="300"
                                      ItemsSource="{Binding CurrencyOptions}"
                                      SelectedItem="{Binding SelectedBaseCurrency, Mode=TwoWay}"
                                      VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrencyCode}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="—" Margin="0,0,6,0" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                                        <TextBlock Text="{Binding CurrencyNameZh}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding CurrencySymbol}"
                                                       Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="70" Margin="0,0,8,0"
                                Style="{StaticResource ButtonOutline}"
                                IsCancel="True"
                                Content="取消"
                                Command="{Binding CancelEditBaseSwitchCommand}"/>
                        <Button Width="70"
                                Style="{StaticResource ButtonSuccess}"
                                Content="保存"
                                Command="{Binding SaveEditBaseSwitchCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <mt:DialogHost d:IsHidden="True"/>
    </Grid>
</UserControl>
