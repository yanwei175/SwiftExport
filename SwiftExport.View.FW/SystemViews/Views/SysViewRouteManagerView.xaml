<UserControl x:Class="SwiftExport.View.FW.SystemViews.Views.SysViewRouteManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.SystemViews.ViewModels"
             mc:Ignorable="d"
             d:Height="600" d:Width="1000"
             d:DataContext="{d:DesignInstance Type=vm:SysViewRouteManagerViewModel}"
             Background="{DynamicResource Brush_Bck_Page}">
    <Grid>
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="新增"
                    Style="{StaticResource ButtonPrimary}"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Add}"
                    Command="{Binding AddCommand}"
                    Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="12"/>
            <Button Content="保存"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Save}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding BatchSaveAsyncCommand}"
                    Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="12"/>
            <Button Content="删除"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding DeleteAsyncCommand}"
                    Height="28" Padding="12,0" Margin="0,0,12,0" FontSize="12"/>
            
                <Button Content="反选"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                    Style="{StaticResource ButtonOutline}"
                    Command="{Binding InvertCheckCommand}"
                    Height="28" Padding="12,0" Margin="0,0,12,0" FontSize="12"/>
            
                <Button Content="刷新"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                    Style="{StaticResource ButtonOutline}"
                    IsEnabled="{Binding IsNotBusy}"
                    Command="{Binding LoadAsyncCommand}"
                    Height="28" Padding="12,0" Margin="0,0,12,0" FontSize="12"/>
            <!-- 刷新前端缓存：让数据库改动立即对路由跳转生效 -->
            <Button Content="刷新路由缓存"
                    mt:ButtonAssist.IconSize="12"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding RefreshCacheCommand}"
                    Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="12"
                    ToolTip="将数据库最新路由配置加载到前端内存缓存，使改动立即生效"/>
            <!-- 主表选择模式切换按钮（整行选择 / 单元格+行头选择）。
                   使用 ToggleButton 的 IsChecked 来驱动 DataGrid.SelectionUnit，避免代码后台事件切换。 -->
            <ToggleButton x:Name="BtnToggleSelectionUnit"
                                      Margin="0,0,5,0"
                                      Padding="10,6"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      IsChecked="False">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}">
                        <Setter Property="ToolTip" Value="切换为整行选择"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="ToolTip" Value="切换为单元格选择"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </StackPanel>

        <!-- ============ 路由配置表格 ============ -->
        <!--
            每列均可直接在 DataGrid 内编辑。
            ViewLocatorSelector 会根据 ViewModelTypeName 按约定自动找 View，
            因此 ViewTypeName 列通常留空即可。
        -->
        <DataGrid x:Name="DetailGrid"
                  Grid.Row="1"
                  RowHeight="50"
                  FontSize="10"
                  ItemsSource="{Binding CurrentTable.Items}"
                  SelectedItem="{Binding SelectedRoute}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="False"
                  EnableColumnVirtualization="False"
                  mt:DataGridAssist.ShowRowNumber="True"
                  mt:DataGridAssist.AutoScrollToNewItem="True"
                  mt:DataGridExcelAssist.EnableExcelShortcuts="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"
                  mt:DataGridAssist.EnableSoftValidation="True">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
                    <!-- 中文注释：默认保持整行模式，便于稳定触发行选择联动（例如 BOM 加载）。 -->
                    <Setter Property="SelectionUnit" Value="FullRow"/>
                    <Style.Triggers>
                        <!-- 中文注释：切到 CellOrRowHeader，便于单元格编辑场景。 -->
                        <DataTrigger Binding="{Binding Source={x:Reference BtnToggleSelectionUnit}, Path=IsChecked}" Value="True">
                            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            
            <DataGrid.Columns>
                <mt:CheckBoxDataGridTemplateColumn   
                                            AllCheckedPropertyName="IsAllChecked"
                                            HeaderCheckBoxMargin="2,0"
                                            ItemCheckedPropertyName="IsChecked"
                                            HeaderCheckBoxToolTip="全选/全不选"/>
                <DataGridTextColumn Header="路由键Key"          Binding="{Binding TargetViewKey,UpdateSourceTrigger=PropertyChanged}"     Width="120"/>
                    <DataGridTextColumn Header="ViewModel限定名" Binding="{Binding ViewModelTypeName,UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="View限定名(可选)" Binding="{Binding ViewTypeName}"    Width="150"
                                    ToolTipService.ToolTip="留空时由 ViewLocatorSelector 按约定自动推断"/>
                <DataGridTextColumn Header="模块名称"        Binding="{Binding DisplayName}"      Width="120"/>
                <DataGridTextColumn Header="分类"            Binding="{Binding RouteCategory}"    Width="80"/>
                <DataGridTextColumn Header="程序集"          Binding="{Binding AssemblyName}"     Width="120"
                                    ToolTipService.ToolTip="单程序集场景留空"/>
                <DataGridTextColumn Header="备注"            Binding="{Binding Remark}"           Width="*" MinWidth="40"/>
                <DataGridCheckBoxColumn Header="启用"        Binding="{Binding IsEnabled}"        Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============ 状态栏 ============ -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Neutral6Brush}"/>
        <mt:DialogHost d:IsHidden="True"/>
    </Grid>
        
    <mt:DialogHost d:IsHidden="True"/>
    </Grid>
</UserControl>
