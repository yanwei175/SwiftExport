<Window x:Class="SwiftExport.View.FW.SystemViews.Views.ResetPasswdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.SystemViews.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ResetPasswdViewModel}"
             Height="512" Width="512"
             WindowStyle="None"
             AllowsTransparency="True"
             WindowStartupLocation="CenterScreen"
             Title="重置密码"
             Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>


    <Border Margin="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Style="{StaticResource Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonIcon}"
                            IsCancel="True"
                            mt:ButtonAssist.IconSize="10"
                            mt:ButtonAssist.IconForeground="Gray"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Close}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="36,5,36,28">

                <TextBlock Text="重置密码"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource Brush_Primary}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="请输入用户名以重置密码"
                           FontSize="13"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <TextBlock Text="用户名" FontSize="12"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         mt:TextBoxAssist.Placeholder="请输入用户名"
                         mt:TextBoxAssist.ShowClearButton="True"
                         Margin="0,0,0,16"/>

                <TextBlock Text="新密码" FontSize="12"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                         mt:TextBoxAssist.Placeholder="请输入新密码"
                         mt:TextBoxAssist.ShowClearButton="True"
                         Margin="0,0,0,16"/>
                
                <TextBlock Text="校验码" FontSize="12"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                         mt:TextBoxAssist.Placeholder="请输入校验码"
                         mt:TextBoxAssist.ShowClearButton="True"
                         Margin="0,0,0,16"/>
                
                <Button Content="确认"
                        IsEnabled="{Binding IsNotBusy}"
                        x:Name="ConfirmBtn"
                        Style="{StaticResource ButtonPrimary}"
                        Height="40" FontSize="15" Margin="0,0,0,16"/>

                <Button Content="取消"
                        IsEnabled="{Binding IsNotBusy}"
                        x:Name="CancelBtn"
                        Style="{StaticResource ButtonOutline}"
                        Height="40" FontSize="15" Margin="0,0,0,16"/>

                <!-- 状态提示（有内容才显示）-->
                <TextBlock x:Name="StatusTxt"
                           Text="{Binding StatusMessage}"
                           FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush_Danger}"/>

                <!-- 忙碌进度条 -->
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
