<Window x:Class="SwiftExport.View.FW.SystemViews.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.SystemViews.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             Height="550" Width="520"
             WindowStyle="None"
             AllowsTransparency="True"
             WindowStartupLocation="CenterScreen"
             Title="登录"
             Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>


    <Border Margin="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Style="{StaticResource Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonIcon}"
                            IsCancel="True"
                            mt:ButtonAssist.IconSize="10"
                            mt:ButtonAssist.IconForeground="Gray"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Close}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="36,32,36,28">

                <!-- 标题 -->
                <TextBlock Text="SwiftExport"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource Brush_Primary}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="请登录以继续"
                           FontSize="13"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- 用户名 -->
                <TextBlock Text="用户名" FontSize="12"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         mt:TextBoxAssist.Placeholder="请输入用户名"
                         mt:TextBoxAssist.ShowClearButton="True"
                         Margin="0,0,0,16"/>

                <!-- 密码（PasswordBox 不支持双向绑定，由 code-behind 的 CommandParameter 处理）-->
                <TextBlock Text="密码" FontSize="12"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="PwdBox"
                             Style="{StaticResource BasePasswordBox}"
                             Margin="0,0,0,8"/>

                <!-- 明文密码输入框：默认隐藏，仅在“显示”状态启用 -->
                <TextBox x:Name="PwdTextBox"
                         mt:TextBoxAssist.Placeholder="请输入密码"
                         mt:TextBoxAssist.ShowClearButton="True"
                         Margin="0,0,0,8"
                         Visibility="Collapsed"/>

                <!-- 显示/隐藏 + 记住密码 -->
                <DockPanel Margin="0,0,0,24" LastChildFill="False">
                    <Button x:Name="TogglePwdVisibleBtn"
                            Content="显示"
                            Width="54"
                            Height="24"
                            Style="{StaticResource ButtonOutline}"/>

                    <CheckBox x:Name="RememberPwdCheckBox"
                              Content="记住密码"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Foreground="{DynamicResource Brush_Txt_Secondary}"/>
                </DockPanel>

                <!-- 登录按钮（CommandParameter 绑定 PasswordBox.Password）-->
                <Button Content="登 录"
                        IsEnabled="{Binding IsNotBusy}"
                        x:Name="LoginBtn"
                        Style="{StaticResource ButtonPrimary}"
                        Height="40" FontSize="15" Margin="0,0,0,16"/>
                
                <Button Content="忘记密码"
                        IsEnabled="{Binding IsNotBusy}"
                        x:Name="ResetPasswdBtn"
                        Style="{StaticResource ButtonOutline}"
                        Height="40" FontSize="15" Margin="0,0,0,16"/>

                <!-- 状态提示（有内容才显示）-->
                <TextBlock x:Name="StatusTxt"
                           Text="{Binding StatusMessage}"
                           FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush_Danger}"/>

                <!-- 忙碌进度条 -->
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
