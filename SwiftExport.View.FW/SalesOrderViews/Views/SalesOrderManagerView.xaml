<UserControl x:Class="SwiftExport.View.FW.SalesOrderViews.Views.SalesOrderManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"

             xmlns:mt ="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
             xmlns:assists="clr-namespace:SwiftExport.View.FW.ProductViews.Assists"
             xmlns:mtPopup="clr-namespace:MateWpfThemes.FW.AttachedProperties;assembly=MateWpfThemes.FW"
             
             xmlns:local="clr-namespace:SwiftExport.View.FW.SalesOrderViews.ViewModels"
             d:DataContext="{d:DesignInstance local:SalesOrderManagerViewModel}"
             
             mc:Ignorable="d"
             d:Height="1080"
             d:Width="1920"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="{DynamicResource Brush_Bck_Page}">

    <UserControl.Resources>
        <ResourceDictionary>
            <mt:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>

            <Style x:Key="FinishAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.ProductFinishList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="ColorNameZh" />
                <Setter Property="mt:DataGridDropdownAssist.FilterMemberPaths" Value="ColorNameZh,ColorNameEn,ColorCode" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="SupplyTypeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.SupplyTypeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="CategoryNameAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.ProductCategoryList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.DisplayMemberPath" Value="CategoryName" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="CustomerCodeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.CustomerCodeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>

            <Style x:Key="SupplierCodeAutoCompleteEditStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
                <Setter Property="mt:DataGridDropdownAssist.ItemsSource" Value="{Binding DataContext.SupplierCodeList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="mt:DataGridDropdownAssist.RequireItemMatch" Value="True" />
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--#region 左侧列表-->
        <Border Margin="5"
               Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="客户代码" FontWeight="SemiBold" Foreground="{StaticResource Brush_Txt_Primary}" Margin="0,8,0,2"/>
                    <mt:SearchableTextBox ItemsSource="{Binding CustomerFilterItems}" MinWidth="140"
                                          RequireItemMatch="True"
                                          Placeholder="键入搜索"
                                          Text="{Binding SelectedCustomerFilter, Mode=TwoWay}" Height="30" />
                    
                    <TextBlock Text="审批状态" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <ComboBox x:Name="ApprovalStatusComboBox" 
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding OrderStatusOptions}"
                            mt:MultiSelectComboBoxAssist.Enable="True"
                            mt:MultiSelectComboBoxAssist.DisplayMemberPath="Name"
                            mt:MultiSelectComboBoxAssist.SelectedItems="{Binding SelectedOrderStatuses, Mode=TwoWay}" />

                    <TextBlock Text="订单状态" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <ComboBox x:Name="OrderStatusComboBox" 
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding OrderStatusOptions}"
                            mt:MultiSelectComboBoxAssist.Enable="True"
                            mt:MultiSelectComboBoxAssist.DisplayMemberPath="Name"
                            mt:MultiSelectComboBoxAssist.SelectedItems="{Binding SelectedOrderStatuses, Mode=TwoWay}" />

                    <TextBlock Text="订单号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <mt:SearchableTextBox ItemsSource="{Binding OrderNoList}" MinWidth="140"
                                          RequireItemMatch="True"
                             Text="{Binding SelectedOrderNoFilter, Mode=TwoWay}" Height="30" />
                    
                    <TextBlock Text="发票号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <mt:SearchableTextBox ItemsSource="{Binding InvNoList}" MinWidth="140"
                                          RequireItemMatch="True"
                             Text="{Binding SelectedInvNoFilter, Mode=TwoWay}" Height="30" />


                    <TextBlock Text="产品颜色" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <mt:SearchableTextBox ItemsSource="{Binding ProductFinishList}"
                                          DisplayMemberPath="ColorNameZh"
                                          SelectedValuePath="ColorCodeUnique"
                                          FilterMemberPaths="ColorNameZh,ColorNameEn,ColorCodeUnique"
                                          RequireItemMatch="True"
                                          Text="{Binding SelectedColorFilterText, Mode=TwoWay}"
                                          SelectedValue="{Binding SelectedColorCodeUnique, Mode=TwoWay}"
                                          MinWidth="140"
                                          Height="30" />
                    
                    <TextBlock Text="包含产品型号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBox Style="{StaticResource MultiLineTextBoxStyle}"  Height="100"/>

                    <Button Style="{StaticResource ButtonOutline}" Margin="0,8,0,8"
                            Content="立即查询"
                           Command="{Binding LoadCommand}"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Search}" >
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Separator Background="{StaticResource Brush_Border_Light}" Height="1" Margin="0,10" />
                </StackPanel>


                <Grid Grid.Row="2" Margin="2,0,2,8" Visibility="Hidden">
                    <TextBlock Text="产品分类" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="清空条件" Command="{Binding ClearOtherSearchFiltersCommand}" Padding="4,2" Margin="0,0,4,0" FontSize="10" Style="{StaticResource ButtonBase}"/>
                        <Button Content="展开" Command="{Binding ExpandAllCategoryCommand}" Padding="4,2" Margin="0,0,4,0" FontSize="10" Style="{StaticResource ButtonBase}"/>
                        <Button Content="折叠" Command="{Binding CollapseAllCategoryCommand}" Padding="4,2" FontSize="10" Style="{StaticResource ButtonBase}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!--#endregion 左侧列表-->

        <GridSplitter Width="8" 
                     Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

        <!-- 中文注释：右侧主工作区位于第 2 列（索引 1），避免使用越界列索引。 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6*" MinHeight="40" x:Name="MasterRow"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*" MinHeight="40" x:Name="DetailRow"/>
            </Grid.RowDefinitions>

            <ToggleButton Grid.Row="0"  x:Name="BtnToggleMasterBorder"  
                     Height="20" Cursor="Hand"  Margin="8,5"
                     ToolTip="隐藏/显示订单明细"  Background="Transparent" BorderBrush="Transparent" BorderThickness="0" 
                     Click="BtnToggleMasterBorder_Click" VerticalAlignment="Center"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <TextBlock  Text="订单列表" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ToggleButton>

            <!--#region 订单列表-->
            <Border Grid.Row="1"  x:Name="MasterBorder" Margin="5"
               Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
<!--工具栏-->
                    <StackPanel  Grid.Row="0" Orientation="Horizontal"
                            Margin="8"
                            Background="Transparent" HorizontalAlignment="Stretch">
                        <Button Command="{Binding AddNewRowCommand}" Margin="0,0,5,0" Style="{StaticResource   ButtonPrimary}"
                               Content="新建"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                        </Button>
                        <Button Command="{Binding BatchSaveCommand}" Margin="0,0,5,0" 
                                Style="{StaticResource   ButtonSuccess}"
                               Content="保存"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Save}">
                        </Button>
                        <Separator Margin="5,0"/>
                        <Button Command="{Binding DeleteCheckedCommand}" Margin="0,0,5,0"
                               Style="{StaticResource   ButtonDanger}"
                               Content="删除"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Delete}">
                        </Button>
                        <Button Command="{Binding LoadCommand}" Margin="0,0,5,0" 
                                Style="{StaticResource   ButtonBase}"
                               Content="刷新"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                        <Button Command="{Binding InvertCheckCommand}"  Margin="0,0,5,0" Style="{StaticResource ButtonBase}"
                                                         Content="反选"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <!-- 中文注释：主表选择模式切换按钮（整行选择 / 单元格+行头选择）。
                             使用 ToggleButton 的 IsChecked 来驱动 DataGrid.SelectionUnit，避免代码后台事件切换。 -->
                        <ToggleButton x:Name="BtnToggleSelectionUnit"
                                      Margin="0,0,5,0"
                                      Padding="10,6"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      IsChecked="False">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}">
                                    <Setter Property="ToolTip" Value="切换为整行选择"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="切换为单元格选择"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- 新增：批量操作菜单，只在有选中项时可用 -->
                        <Menu Margin="0,0,5,0" Background="Transparent" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedItems}">
                            <MenuItem Header="更多批量操作 ▼" Padding="10,6" 
                                      Background="{DynamicResource Brush_Control_Background}" 
                                      BorderBrush="{DynamicResource Brush_Border_Light}" 
                                      BorderThickness="1" 
                                      Foreground="{DynamicResource Brush_Txt_Primary}">
                                <!-- 此处暂时预留空白，用于未来扩展批量操作。可根据需要绑定ViewModel的命令 -->
                                <MenuItem Header="批量修改属性" />
                                <MenuItem Header="批量导出数据" />
                                <MenuItem Header="批量打印条码" />
                            </MenuItem>
                        </Menu>
                        <TextBlock Text="模糊搜索" FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush_Txt_Primary}" Margin="8,0,8,0"/>
                        <TextBox x:Name="MainSearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 VerticalContentAlignment="Center"
                                 mt:TextBoxAssist.Placeholder="键入搜索"
                                 mt:TextBoxAssist.ShowClearButton="True"
                                 />

                    </StackPanel>

<!--主表区域-->
                    <TabControl x:Name="MastTbCtrl"  Grid.Row="1" Margin="5" BorderThickness="0">

                        <TabItem Header="订单列表" FontSize="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!--主DataGrid：绑定到 OrderHeaders.Items，选中项绑定 SelectedOrderHeader -->
                                <DataGrid Grid.Row="0" x:Name="MasterDataGrid"
                                     ItemsSource="{Binding OrderHeaders.Items}"
                                     SelectedItem="{Binding SelectedOrderHeader, Mode=TwoWay}"
                                     HorizontalScrollBarVisibility="Auto" 
                                     HeadersVisibility="All" 
                                     RowHeight="35" Margin="0,5,0,0"
                                     EnableRowVirtualization="False"
                                     EnableColumnVirtualization="False"
                                     mt:DataGridAssist.ShowRowNumber="True" 
                                     mt:UndoManager.IsUndoEnabled="True"
                                     mt:DataGridAssist.AutoScrollToNewItem="True"
                                     mt:DataGridAssist.EnableSoftValidation="True"
                                     mt:DataGridExcelAssist.EnableExcelShortcuts="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"
                                     mt:DataGridExcelAssist.EnableDirtyTracking="True">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
                                            <!-- 中文注释：默认保持整行模式，便于稳定触发行选择联动（例如 BOM 加载）。 -->
                                            <Setter Property="SelectionUnit" Value="FullRow"/>
                                            <Style.Triggers>
                                                <!-- 中文注释：切到 CellOrRowHeader，便于单元格编辑场景。 -->
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}" Value="True">
                                                    <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Added">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Modified">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                </DataTrigger>
                                                <!-- 中文注释：补齐待删除行的脏状态视觉反馈。 -->
                                                <DataTrigger Binding="{Binding State}" Value="Deleted">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <mtControls:CheckBoxDataGridTemplateColumn 
                                            AllCheckedPropertyName="IsAllChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            ItemCheckedCommandName="ItemCheckedChangedCommand"
                                            HeaderCheckBoxToolTip="全选/全不选"/>

                                        <!-- 主表列：绑定到 SalesOrderHeaderModel 的属性 -->
                                        <DataGridTextColumn Header="订单状态" Binding="{Binding OrderStatus}" Width="120" />
                                        <DataGridTextColumn Header="订单编号" Binding="{Binding OrderNo}" Width="160" />
                                        <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="100" />
                                        <DataGridTextColumn Header="客户PO号" Binding="{Binding CustomerPoNo}" Width="140" />
                                        <DataGridTextColumn Header="下单日期" Binding="{Binding OrderDate, StringFormat=d}" Width="120" />
                                        <DataGridTextColumn Header="发票号" Binding="{Binding InvoiceNo}" Width="120" />

                                        <DataGridTextColumn Header="行数" Binding="{Binding LineCount}" Width="80" />
                                        <DataGridTextColumn Header="总数量" Binding="{Binding TotalQty}" Width="100" />
                                        <DataGridTextColumn Header="原币总额" Binding="{Binding TotalAmountOriginalCurrency, StringFormat=N2}" Width="120" />
                                        <DataGridTextColumn Header="本币总额" Binding="{Binding TotalAmountLocalCurrency, StringFormat=N2}" Width="120" />

                                        <DataGridTextColumn Header="已发货数量" Binding="{Binding TotalShippedQty}" Width="120" />
                                        <DataGridTextColumn Header="未发货数量" Binding="{Binding TotalUnshippedQty}" Width="120" />

                                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="200" />
                                        <DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="120" />
                                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedDate, StringFormat=g}" Width="140" />
                                        <DataGridTextColumn Header="客户ID" Binding="{Binding CustomerId}" Width="100" />
                                        <DataGridTextColumn Header="承运方式" Binding="{Binding ShippedBy}" Width="120" />
                                        <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="80" />
                                        <DataGridTextColumn Header="汇率" Binding="{Binding ExchangeRate, StringFormat=N4}" Width="100" />
                                        <DataGridTextColumn Header="部分发货数量" Binding="{Binding TotalPartiallyShippedQty}" Width="120" />
                                        <DataGridTextColumn Header="收货人" Binding="{Binding ShipToName}" Width="140" />
                                        <DataGridTextColumn Header="收货地址" Binding="{Binding ShipToAddress}" Width="200" />
                                        <DataGridTextColumn Header="收货电话" Binding="{Binding ShipToPhone}" Width="120" />
                                        <DataGridTextColumn Header="贸易条款" Binding="{Binding Incoterm}" Width="80" />
                                        <DataGridTextColumn Header="条款地点" Binding="{Binding IncotermLocation}" Width="120" />
                                        <DataGridTextColumn Header="定金比例" Binding="{Binding DepositRate}" Width="80" />
                                        <DataGridTextColumn Header="生产周期(天)" Binding="{Binding LeadTimeDays}" Width="100" />
                                        <DataGridTextColumn Header="付款方式" Binding="{Binding PaymentMethod}" Width="100" />
                                        <DataGridTextColumn Header="交期" Binding="{Binding DeliveryDate, StringFormat=d}" Width="120" />
                                        <DataGridTextColumn Header="回复日期" Binding="{Binding ReplyDate, StringFormat=d}" Width="120" />
                                        <DataGridTextColumn Header="ETA" Binding="{Binding ETA, StringFormat=g}" Width="140" />
                                        <DataGridTextColumn Header="ETD" Binding="{Binding ETD, StringFormat=g}" Width="140" />
                                        <DataGridTextColumn Header="文件夹" Binding="{Binding SoFolder}" Width="160" />
                                        <DataGridTextColumn Header="版本号" Binding="{Binding VersionNo}" Width="100" />
                                        <DataGridTextColumn Header="审批状态" Binding="{Binding ApprovalStatus}" Width="120" />
                                        <DataGridCheckBoxColumn Header="已删除" Binding="{Binding IsDeleted}" Width="80" />
                                        <DataGridCheckBoxColumn Header="已锁定" Binding="{Binding IsLocked}" Width="80" />
                                        <DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="120" />
                                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedDate, StringFormat=g}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <mt:PaginationControl Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right" 
                                                   TotalCount="{Binding TotalCount}" 
                                                   PageIndex="{Binding PageIndex, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                   PageSize="{Binding PageSize, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="订单详情" FontSize="14">
                            <Viewbox />
                        </TabItem>
                    </TabControl>
                    
                    
                </Grid>
            </Border>
            <!--#endregion-->

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="26" 
                     Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

            <ToggleButton Grid.Row="2" x:Name="BtnToggleDetailContainer"  
                     IsChecked="{Binding IsBomAreaCollapsed, Mode=TwoWay}"
                     Height="20" Cursor="Hand"  Margin="8,5" 
                     ToolTip="隐藏/显示 BOM 明细" 
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                     Background="Transparent" BorderBrush="Transparent" BorderThickness="0" 
                     Click="BtnToggleDetailContainer_Click" VerticalAlignment="Center">
                <TextBlock Text="订单行" FontSize="9" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </ToggleButton>
            
            <!--#region底部区域-->
            <Border Grid.Row="3" x:Name="DetailContainer" Margin="5"
               Background="{DynamicResource  Brush_Control_Background}" CornerRadius="8" 
                    BorderThickness="1" BorderBrush="{DynamicResource Brush_Border_Light}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal"  Grid.Row="0" 
                               Margin="5,2">
                        <!-- 订单号标签：绑定到 SelectedOrderHeader.OrderNo，无订单时显示 (无订单) -->
                        <TextBlock Text="订单号：" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding SelectedOrderHeader.OrderNo, TargetNullValue='(无订单号)'}" VerticalAlignment="Center"  Margin="0,0,15,0" Width="120" TextTrimming="CharacterEllipsis"/>
                        <Separator Margin="5,0"/>

                        <!-- 有BOM时显示的操作按钮区域（获取/保存/删除/筛选） -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveBom}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Command="{Binding OpenProductSelectorCommand}" Margin="0,0,5,0" 
                                   Content="获取"
                                   Style="{StaticResource ButtonPrimary}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Add}"/>

                            <Button Command="{Binding SaveBomCommand}" Margin="0,0,5,0"
                                   Content="保存"
                                   Style="{StaticResource ButtonSuccess}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Save}"/>
                            <!--<Button Command="{Binding RemoveBomItemCommand}" Margin="0,0,5,0"
                                   Content="删除"
                                   Style="{StaticResource ButtonDanger}"
                                   mt:ButtonAssist.IconSize="12"
                                   mt:ButtonAssist.Icon="{StaticResource Icon.Delete}"/>-->
                            <Separator Margin="5,0"/>
                            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBox Width="180" Text="{Binding BomSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                    VerticalContentAlignment="Center" 
                                    mt:TextBoxAssist.Placeholder="内存极速筛选"
                                    mt:TextBoxAssist.ShowClearButton="True"/>
                        </StackPanel>

                        <!-- 无BOM时显示的新建BOM按钮 -->
                        <Button Command="{Binding CreateBomCommand}" Margin="0,0,5,0"
                               Content="新建BOM"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveBom}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>


                        <!--明细DataGrid-->

                    <Grid Grid.Row="1">
                        <!-- 次级明细 DataGrid：绑定到 CurrentOrderLines.Items -->
                        <DataGrid x:Name="DetailDataGrid" Margin="0,5,0,0"
                                      Style="{StaticResource  FullRowDataGrid}"
                                                 ItemsSource="{Binding CurrentOrderLines.Items}"
                                                 SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                                 HorizontalScrollBarVisibility="Auto" HeadersVisibility="All" 
                                                 RowHeight="40" 
                                                 SelectionUnit="FullRow"
                                                 EnableRowVirtualization="False"
                                                 EnableColumnVirtualization="False"
                                                 mt:DataGridAssist.ShowRowNumber="True" 
                                                 mt:UndoManager.IsUndoEnabled="True"
                                                 mt:DataGridAssist.AutoScrollToNewItem="True"
                                                 mt:DataGridAssist.EnableSoftValidation="True"
                                                 mt:DataGridExcelAssist.EnableDirtyTracking="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Added">
                                            <Setter Property="Foreground" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Modified">
                                            <Setter Property="Foreground" Value="#FFF8E1"/>
                                        </DataTrigger>
                                        <!-- 中文注释：补齐待删除行的脏状态视觉反馈。 -->
                                        <DataTrigger Binding="{Binding State}" Value="Deleted">
                                            <Setter Property="Foreground" Value="#FFEBEE"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- 次表列：绑定到 SalesOrderLineModel 的属性 -->
                                <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" Width="64" />

                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160" />
                                <DataGridTextColumn Header="订单号(行)" Binding="{Binding OrderNo}" Width="140" />
                                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerPdSku}" Width="140" />
                                <DataGridTextColumn Header="描述" Binding="{Binding CustomerPdDescription}" Width="240" />
                                <DataGridTextColumn Header="表面处理" Binding="{Binding CustomerPdFinish}" Width="120" />
                                <DataGridTextColumn Header="产品特性" Binding="{Binding CustomerPdFeatures}" Width="200" />

                                <DataGridTextColumn Header="数量" Binding="{Binding QTY, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="已发货" Binding="{Binding ShippedQty, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="未发货" Binding="{Binding UnshippedQty, StringFormat=N0}" Width="80" />

                                <DataGridTextColumn Header="每箱数量" Binding="{Binding PcsOfCarton}" Width="100" />
                                <DataGridTextColumn Header="每箱净重" Binding="{Binding NwOfCarton}" Width="100" />
                                <DataGridTextColumn Header="每箱毛重" Binding="{Binding GwOfCarton}" Width="100" />
                                <DataGridTextColumn Header="每箱体积" Binding="{Binding CbmOfCarton}" Width="100" />
                                <DataGridTextColumn Header="箱数" Binding="{Binding Ctns}" Width="80" />

                                <DataGridTextColumn Header="净重小计" Binding="{Binding NwSubTotal, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="毛重小计" Binding="{Binding GwSubTotal, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="体积小计" Binding="{Binding CbmSubTotal, StringFormat=N3}" Width="100" />

                                <DataGridTextColumn Header="USD单价" Binding="{Binding UsdPrice, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="USD金额" Binding="{Binding UsdAmount, StringFormat=N2}" Width="120" />
                                <DataGridTextColumn Header="RMB单价" Binding="{Binding RmbPrice, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="RMB金额" Binding="{Binding RmbAmount, StringFormat=N2}" Width="120" />

                                <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="80" />
                                <DataGridTextColumn Header="行ID" Binding="{Binding Id}" Width="80" />
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100" />
                                <DataGridCheckBoxColumn Header="部分发货" Binding="{Binding IsPartiallyShipped}" Width="100" />
                                <DataGridCheckBoxColumn Header="已全部发货" Binding="{Binding IsFullyShipped}" Width="100" />

                                <DataGridTextColumn EditingElementStyle="{StaticResource MultiLineDataGridTextBoxStyle}" Header="备注" Binding="{Binding SubRemark, UpdateSourceTrigger=PropertyChanged}" Width="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--快速搜索产品-->
                        <Popup x:Name="PopupForSubModel"
                                               IsOpen="{Binding IsPopupOpen}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               Focusable="False">

                            <Border BorderBrush="{DynamicResource Brush_Border_Default}"
                                                    Background="{DynamicResource Brush_Bck_Card}"
                                                    BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                                    SnapsToDevicePixels="True">

                                <ListBox ItemsSource="{Binding BomPopItemSource}"
                                                     SelectedItem="{Binding BomPopSelectedItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     BorderThickness="0"
                                                     Focusable="False"
                                                     MinWidth="280"
                                                     MinHeight="60"
                                                     MaxHeight="260">

                                    <!-- 每项模板：图片 + SKU + 描述 -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,3">
                                                <Image DockPanel.Dock="Left"
                                                                       Width="32" Height="32"
                                                                       Margin="0,0,8,0"
                                                                       Stretch="Uniform"
                                                                       VerticalAlignment="Center"
                                                                       Source="{Binding MainImage, Converter={StaticResource ImgPathToImgConverter}}"/>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sku}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Description}"
                                                                               Foreground="#888"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <StatusBar Grid.Row="2" Background="Transparent" 
                          BorderThickness="0,0,0,0" BorderBrush="{DynamicResource Brush_Border_Light}" Padding="10,2">
                        <StatusBarItem>
                            <TextBlock Text="就绪" Foreground="#888"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentBomItems.Count, StringFormat='BOM 明细总数：{0} 项'}" 
                                  Foreground="{DynamicResource Brush_Txt_Primary}" FontWeight="SemiBold"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </Border>

        </Grid>
        <!--#endregion-->
        <mt:DialogHost Grid.Column="1" Grid.RowSpan="4" />
    </Grid>
</UserControl>