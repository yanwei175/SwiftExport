<UserControl x:Class="SwiftExport.View.FW.SalesOrderViews.Views.SalesOrderManagerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mt ="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:mtControls="clr-namespace:MateWpfThemes.FW.Controls;assembly=MateWpfThemes.FW"
             xmlns:assists="clr-namespace:SwiftExport.View.FW.ProductViews.Assists"
             xmlns:mtPopup="clr-namespace:MateWpfThemes.FW.AttachedProperties;assembly=MateWpfThemes.FW"
             xmlns:mvvm="clr-namespace:SwiftExport.View.FW.Mvvm"
             xmlns:salesViews="clr-namespace:SwiftExport.View.FW.SalesOrderViews.Views"             
             xmlns:local="clr-namespace:SwiftExport.View.FW.SalesOrderViews.ViewModels"
             d:DataContext="{d:DesignInstance local:SalesOrderManagerViewModel}"
             
             mc:Ignorable="d"
             d:Height="1080"
             d:Width="1920"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="{DynamicResource Brush_Bck_Page}">

    <UserControl.Resources>
        <ResourceDictionary>
            <mt:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>
            <mvvm:BindingProxy x:Key="SelectionUnitProxy" Data="{Binding IsChecked, ElementName=BtnToggleSelectionUnit}"/>

            <!-- 确认状态标签样式：已确认-绿色，待确认-橙色，已驳回-红色。 -->
            <Style x:Key="ConfirmationStatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}">
                <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ConfirmationStatus}" Value="已确认">
                        <Setter Property="Foreground" Value="#FF2E7D32"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ConfirmationStatus}" Value="待确认">
                        <Setter Property="Foreground" Value="#FFF57C00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ConfirmationStatus}" Value="未确认">
                        <Setter Property="Foreground" Value="#FFF57C00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ConfirmationStatus}" Value="已取消">
                        <Setter Property="Foreground" Value="#FFC62828"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--#region 左侧筛选栏（参考 ProductManagerView）-->
        <Border Margin="5" Style="{StaticResource BaseBorder}" >
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="客户代码" FontWeight="SemiBold" Foreground="{StaticResource Brush_Txt_Primary}" Margin="0,8,0,2"/>
                    <mt:SearchableTextBox x:Name="CustomerFilter" Width="180" Height="30"  Margin="5"
                                          Placeholder="指定客户"
                                          VerticalAlignment="Top"
                                          ItemsSource="{Binding CustomerFilterItems}"
                                          DisplayMemberPath="CustomerName"
                                          FilterMemberPaths="CustomerCode,CustomerName,Address,PhoneNumber,ContactPerson"
                                          RequireItemMatch="False"
                                          SelectedValuePath="CustomerCode"
                                          SelectedValue="{Binding SelectedCustomerFilter}"/>
                    <TextBlock Text="确认状态" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <Grid x:Name="确认状态多选下拉框" Margin="0,0,8,0">
                        <ToggleButton x:Name="StatusFilter" Style="{StaticResource MutiSelectButtonStyle}" Padding="10,5"
                                      Cursor="Hand" BorderThickness="1">
                            <TextBlock Style="{StaticResource MultiLineDataGridTextBlockStyle}"
                                     Text="{Binding DataContext.SelectedConfirmStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ToggleButton>
                        <!-- Popup 负责折叠的内容 -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=StatusFilter}" StaysOpen="False"  AllowsTransparency="True"
                               PopupAnimation="Slide" Placement="Bottom">
                            <Border Background="{DynamicResource Brush_Bck_Card}" BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ConfirmStatusOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding}" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          Margin="0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>


                    <TextBlock Text="订单状态" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <Grid x:Name="订单状态多选下拉框" Margin="0,0,8,0">
                        <ToggleButton x:Name="OrderStatusFilter" Style="{StaticResource MutiSelectButtonStyle}" Padding="10,5" 
                                      Cursor="Hand" BorderThickness="1">
                            <TextBlock Style="{StaticResource MultiLineDataGridTextBlockStyle}"
                                     Text="{Binding DataContext.SelectedOrderStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ToggleButton>
                        <!-- Popup 负责折叠的内容 -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=OrderStatusFilter}" 
                               StaysOpen="False" 
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               Placement="Bottom">
                            <Border Background="{DynamicResource Brush_Bck_Card}" BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding OrderStatusOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>


                    <TextBlock Text="下单日期(起)" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <DatePicker SelectedDate="{Binding OrderDateFrom, Mode=TwoWay}"/>

                    <TextBlock Text="下单日期(止)" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <DatePicker SelectedDate="{Binding OrderDateTo, Mode=TwoWay}"/>

                    <TextBlock Text="订单号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding SelectedOrderNoFilter}"/>

                    <TextBlock Text="发票号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBox Text="{Binding SelectedInvNoFilter}"/>

                    <TextBlock Text="包含客户产品型号" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBox  Text="{Binding BatchCustomerSkuText, Mode=TwoWay}"  Style="{StaticResource MultiLineTextBoxStyle}"  Height="150"/>

                    <Button Style="{StaticResource ButtonPrimary}" Margin="0,8,0,8"
                            Content="立即查询"
                            Command="{Binding LoadCommand}"
                            mt:ButtonAssist.IconSize="12"
                            mt:ButtonAssist.Icon="{StaticResource Icon.Search}" >
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <Separator Background="{StaticResource Brush_Border_Light}" Height="1" Margin="0,10" />
                </StackPanel>

            </Grid>
        </Border>
        <!--#endregion 左侧列表-->

        <GridSplitter Width="8"  Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

        <!--#region 中文注释：右侧主工作区位于第 2 列（索引 1），避免使用越界列索引。 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="240" x:Name="MasterRow"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="5*" MinHeight="180" x:Name="DetailRow"/>
                <RowDefinition Height="Auto" MaxHeight="50"/>
            </Grid.RowDefinitions>


            <!--#region 订单列表-->
            <Border Margin="5" Grid.Row="0"  x:Name="MasterBorder" Style="{StaticResource BaseBorder}">
                <Grid Background="Transparent" MinHeight="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
<!--工具栏-->
                    <StackPanel  Grid.Row="0" Orientation="Horizontal"
                            Margin="8"
                            Background="Transparent" HorizontalAlignment="Stretch">
                        <Button Command="{Binding CreateOrderCommand}" Margin="0,0,5,0" Style="{StaticResource   ButtonPrimary}"
                               Content="新建"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Add}">
                        </Button>
                        <Button Command="{Binding EditOrderCommand}" Margin="0,0,5,0"
                                Style="{StaticResource ButtonOutline}"
                               Content="编辑"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Edit}">
                        </Button>
                        <Button Command="{Binding SaveCommand}" Margin="0,0,5,0"
                                Style="{StaticResource ButtonSuccess}"
                               Content="更新"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Save}">
                        </Button>
                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>
                        <Button Command="{Binding DeleteSelectedHeadCommand}" Margin="0,0,5,0"
                               Style="{StaticResource ButtonDanger}"
                               Content="关闭"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Delete}">
                        </Button>

                        <Button Command="{Binding ConfirmCommand}" Margin="0,0,5,0"
                               Style="{StaticResource ButtonSuccess}"
                               Content="确认"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Check}"/>

                        <Button Command="{Binding CancelConfirmCommand}" Margin="0,0,5,0"
                               Style="{StaticResource ButtonDanger}"
                               Content="取消确认"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Close}"/>
                        <Button Command="{Binding LoadCommand}" Margin="0,0,5,0" 
                                Style="{StaticResource ButtonBase}"
                               Content="刷新"
                               mt:ButtonAssist.IconSize="12"
                               mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <Rectangle Width="1" Fill="#E0E0E0" Margin="5,5,15,5" VerticalAlignment="Stretch"/>

                        <Button Command="{Binding InvertCheckCommand}"  Margin="0,0,5,0" Style="{StaticResource ButtonBase}"
                                 Content="反选"
                             mt:ButtonAssist.IconSize="12"
                             mt:ButtonAssist.Icon="{StaticResource Icon.Refresh}">
                        </Button>

                        <Border Style="{StaticResource OutLineButtonStyleBorder}">
                            <Grid Margin="0,0,0,0" x:Name="更多功能">
                                <ToggleButton x:Name="MenuButton" Content="更多" Style="{StaticResource ExpanderUpHeaderStyle}" Padding="10,5"/>
                                <!-- Popup 负责折叠的内容 -->
                                <Popup IsOpen="{Binding IsChecked, ElementName=MenuButton}" 
                                       StaysOpen="False" 
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide"
                                       Placement="Bottom">
                                    <Border Background="{DynamicResource Brush_Bck_Card}" 
                                            BorderBrush="{DynamicResource Brush_Border_Light}" 
                                            BorderThickness="1" CornerRadius="4" Padding="8">
                                        <StackPanel Width="180" Orientation="Vertical">
                                            <Button Margin="1" Content="批量修改属性" Style="{StaticResource ButtonOutline}"/>
                                            <Button Margin="1" Content="批量导出数据" Style="{StaticResource ButtonOutline}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <TextBlock Text="模糊搜索" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush_Txt_Primary}" Margin="8,0,8,0"/>
                        <TextBox x:Name="MainSearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180"
                                 VerticalContentAlignment="Center"
                                 mt:TextBoxAssist.Placeholder="键入搜索"
                                 mt:TextBoxAssist.ShowClearButton="True"
                                 />
                        <Button Style="{StaticResource ButtonPrimary}" Margin="8,0"
                                Content="立即查询"
                                Command="{Binding LoadCommand}"
                                mt:ButtonAssist.IconSize="12"
                                mt:ButtonAssist.Icon="{StaticResource Icon.Search}" >
                        </Button>
                    </StackPanel>

<!--主表区域-->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 主DataGrid：订单头列表 -->
                        <DataGrid Grid.Row="0" x:Name="MasterDataGrid"
                                  ItemsSource="{Binding OrderHeaders.Items}"
                                  SelectedItem="{Binding SelectedOrderHeader, Mode=TwoWay}"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0,0.5"
                                  HeadersVisibility="All" 
                                  RowHeight="35" Margin="0,5,0,0"
                                  EnableRowVirtualization="False"
                                  EnableColumnVirtualization="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  mt:DataGridAssist.ShowRowNumber="True" 
                                  mt:UndoManager.IsUndoEnabled="True"
                                  mt:DataGridAssist.AutoScrollToNewItem="True"
                                  mt:DataGridAssist.EnableSoftValidation="True"
                                  mt:DataGridExcelAssist.EnableDirtyTracking="True">

                            <DataGrid.Columns>
                                <mtControls:CheckBoxDataGridTemplateColumn 
                                            AllCheckedPropertyName="OrderHeaders.IsAllChecked"
                                            ItemCheckedPropertyName="IsChecked"
                                            ItemCheckedCommandName="{x:Null}"
                                            HeaderCheckBoxMargin="4,0"
                                            HeaderCheckBoxToolTip="全选/全不选"/>

                                <!-- 主表列：绑定到 SalesOrderHeaderManagerModel 的属性 -->
                                <DataGridTextColumn Header="订单状态" Binding="{Binding OrderStatusText}" Width="80"  IsReadOnly="True"
                                                    ElementStyle="{StaticResource ConfirmationStatusBadgeTextStyle}"/>
                                <DataGridTextColumn Header="订单编号" Binding="{Binding OrderNo}" Width="120"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="InvoiceNo" Binding="{Binding InvoiceNo}" Width="80" />
                                    <DataGridTextColumn Header="下单日期" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120" IsReadOnly="True" />
                                    
                                <DataGridTemplateColumn Header="预计交期" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeliveryDate, StringFormat=yyyy-MM-dd}" 
                                                                       Style="{StaticResource DataGridTextBlockStyle}"
                                                                       VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <DatePicker SelectedDate="{Binding DeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                 </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="回复日期" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ReplyDate, StringFormat=yyyy-MM-dd}" 
                                                                       Style="{StaticResource DataGridTextBlockStyle}"
                                                                       VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <DatePicker SelectedDate="{Binding ReplyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                 </DataGridTemplateColumn>
                                
                                
                                
                                <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="100"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="客户PO号" Binding="{Binding CustomerPoNo}" Width="120"/>
                                
                                <DataGridTextColumn Header="总数量" Binding="{Binding TotalQty}" Width="100"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="已发货数量" Binding="{Binding TotalShippedQty}" Width="100"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="未发货数量" Binding="{Binding TotalUnshippedQty}" Width="100"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="原币总额" Binding="{Binding TotalAmountOriginalCurrency, StringFormat=N2}" Width="120"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="本币总额" Binding="{Binding TotalAmountLocalCurrency, StringFormat=N2}" Width="120"  IsReadOnly="True"/>

                                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="200" />
                                <DataGridTextColumn Header="订单文件路径" Binding="{Binding SoFolder}" Width="160"/>
                                    <DataGridTextColumn Header="币种" Binding="{Binding Currency}" Width="80"   IsReadOnly="True"/>
                                    <DataGridTextColumn Header="汇率" Binding="{Binding ExchangeRate, StringFormat=N4}" Width="100"   IsReadOnly="True"/>

                                <DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="120"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedDate, StringFormat=g}" Width="140"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="120"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedDate, StringFormat=g}" Width="140"  IsReadOnly="True"/>

                                    <DataGridTextColumn Header="确认状态" Width="120"
                                                        Binding="{Binding ConfirmationStatusText}"
                                                        ElementStyle="{StaticResource ConfirmationStatusBadgeTextStyle}" />

                                </DataGrid.Columns>
                        </DataGrid>

                        <mt:PaginationControl Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Right"
                                                   TotalCount="{Binding TotalCount}" 
                                                   PageIndex="{Binding PageIndex, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                   PageSize="{Binding PageSize, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Grid>
            </Border>
            <!--#endregion-->

            <!--#region 订单详情-->

            <GridSplitter Height="8" Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>


            <Border Margin="5" Grid.Row="2" x:Name="DetailBorder" Padding="0,6" Style="{StaticResource BaseBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 中文注释：操作区移入第一个Tab（与 ProductManagerView 主从同区风格一致）。 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">

                        <Separator Margin="5,0"/>
                        <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="5,0,2,0"/>
                        <TextBox Width="180" VerticalContentAlignment="Center"
                                 Text="{Binding LineSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 mt:TextBoxAssist.Placeholder="内存极速筛选" 
                                 mt:TextBoxAssist.ShowClearButton="True"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" RowHeight="64"
                              x:Name="DetailDataGridInTab"
                              Style="{StaticResource ReadOnlyDataGrid}"
                              ItemsSource="{Binding CurrentOrderLines.Items}"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                              mt:DataGridSyncAttach.SyncTarget="{Binding ElementName=SummaryGrid}"
                              AutoGenerateColumns="False"
                              EnableRowVirtualization="False"
                              EnableColumnVirtualization="False"
                              mt:DataGridAssist.ShowRowNumber="True"
                              mt:DataGridAssist.EnableSoftValidation="True"
                              mt:DataGridExcelAssist.EnableDirtyTracking="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Visibility="Visible" Binding="{Binding LineNumber}" 
                                            SortMemberPath="LineNumber"
                                            Width="35" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" Width="64" />
                            <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku}" Width="140" 
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160" 
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding DescriptionEn}" Width="220" 
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="颜色" Binding="{Binding ColorNameEn}" Width="120" 
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Qty, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="已发货数量" Binding="{Binding ShippedQty, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="未发货数量" Binding="{Binding UnshippedQty, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="美金单价" Binding="{Binding UsdPrice, StringFormat=N2}" Width="120" />
                            <DataGridTextColumn Header="人民币单价" Binding="{Binding CnyPrice, StringFormat=N2}" Width="120" />
                            <DataGridTextColumn Header="美金金额" Binding="{Binding UsdAmount, StringFormat=N2}" Width="120" />
                            <DataGridTextColumn Header="人民币金额" Binding="{Binding CnyAmount, StringFormat=N2}" Width="120" />
                            <DataGridTextColumn Header="备注" Binding="{Binding SubNote}" Width="260" 
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="SummaryGrid" Style="{StaticResource SummaryDataGrid}"  Grid.Row="1" RowHeight="35" Height="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Num" />
                            <DataGridTextColumn Header="图片" />
                            <DataGridTextColumn Header="SKU" />
                            <DataGridTextColumn Header="客户型号" />
                            <DataGridTextColumn Header="描述" />
                            <DataGridTextColumn Header="颜色" Binding="{Binding Source='总计:'}"/>
                            <DataGridTextColumn Header="总数量" Binding="{Binding DataContext.CurrentOrderLines.SummaryQty, StringFormat=N0, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="已发货汇总" Binding="{Binding DataContext.CurrentOrderLines.SummaryShippedQty, StringFormat=N0, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="未发货汇总" Binding="{Binding DataContext.CurrentOrderLines.SummaryUnshippedQty, StringFormat=N0, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="美金单价"/>
                            <DataGridTextColumn Header="人民币单价"/>
                            <DataGridTextColumn Header="美金金额汇总" Binding="{Binding DataContext.CurrentOrderLines.SummaryUsdAmount, StringFormat=N2, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="人民币金额汇总" Binding="{Binding DataContext.CurrentOrderLines.SummaryCnyAmount, StringFormat=N2, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <DataGridTextColumn Header="备注" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--#endregion-->
            <StatusBar Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="4,2">
                <StatusBarItem>
                    <TextBlock Text="就绪" Foreground="#888"/>
                </StatusBarItem>
            </StatusBar>

        </Grid>
        <!--#endregion-->


    </Grid>

        <mt:DialogHost d:IsHidden="True" />
    </Grid>
</UserControl>