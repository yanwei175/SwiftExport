<Window x:Class="SwiftExport.View.FW.SalesOrderViews.Views.SalesOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SwiftExport.View.FW.SalesOrderViews.Views"
        mc:Ignorable="d"
        Title="销售订单详情"
        Height="1000" Width="1600"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!-- 中文注释：Window 作为弹窗容器，内容由 SalesOrderDetailView（UserControl）完全承载。
         不在 Window 层做任何数据绑定，保持 View 与 Window 解耦。-->
    <local:SalesOrderDetailView x:Name="DetailView"/>

</Window>
