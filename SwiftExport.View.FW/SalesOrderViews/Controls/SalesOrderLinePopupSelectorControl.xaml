<UserControl x:Class="SwiftExport.View.FW.SalesOrderViews.Controls.SalesOrderLinePopupSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:converters="clr-namespace:MateWpfThemes.FW.Converters;assembly=MateWpfThemes.FW"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="280">

    <UserControl.Resources>
        <converters:ImgPathToImgConverter x:Key="ImgPathToImgConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- 中文注释：Popup 承载在控件内部，对外只暴露 IsOpen/PlacementTarget/SubmitCommand 等必要参数。 -->
        <Popup x:Name="SelectorPopup"
               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding PopupPlacementTarget, RelativeSource={RelativeSource AncestorType=UserControl}}"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               Opened="SelectorPopup_Opened">

            <Border BorderBrush="{DynamicResource Brush_Border_Default}"
                    Background="{DynamicResource Brush_Bck_Card}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    SnapsToDevicePixels="True">

                <Grid Width="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="0"
                             Height="30"
                             Margin="0,0,0,6"
                             Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                             mt:TextBoxAssist.Placeholder="输入客户SKU/SKU/描述进行搜索"/>

                    <!-- 中文注释：列表不抢焦点，键盘上下/回车由上方搜索框统一处理。 -->
                    <ListBox x:Name="ResultListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                             BorderThickness="0"
                             Padding="0"
                             Focusable="False"
                             IsTabStop="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MinHeight="60"
                             MaxHeight="300"
                             MouseLeftButtonUp="ResultListBox_MouseLeftButtonUp">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0">
                                    <Image DockPanel.Dock="Left"
                                           Width="32"
                                           Height="32"
                                           Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"
                                           Source="{Binding MainImage, Converter={StaticResource ImgPathToImgConverter}}"/>
                                    
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock  Text="{Binding Sku}" FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock Text="{Binding MaterialType}" Foreground="#888" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock  Text="{Binding CustomerSKU}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding DescriptionEn}" Foreground="#888" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
