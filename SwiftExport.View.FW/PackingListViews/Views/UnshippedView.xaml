<Window x:Class="SwiftExport.View.FW.PackingListViews.Views.UnshippedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SwiftExport.View.FW.PackingListViews.Views"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        mc:Ignorable="d"
        Height="800" Width="1400"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Title="待出货列表"
        Background="Transparent">

    <Window.Resources>

    </Window.Resources>

    <Border Margin="20" Background="{DynamicResource Brush_Bck_Page}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="待出货列表" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            </StackPanel>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="5">
                <StackPanel x:Name="筛选条件" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBlock Text="客户选择" Margin="10,0" VerticalAlignment="Top"/>

                    <mt:SearchableTextBox x:Name="CustomerFilter" Width="120" Height="30"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding CustomerList}"
                          DisplayMemberPath="Name"
                          RequireItemMatch="True"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCustomerId}"/>
                    <TextBlock Text="搜索:"  VerticalAlignment="Top" Margin="10,0"/>
                    <TextBox x:Name="SearchBox" Height="120"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             mt:TextBoxAssist.Placeholder="搜索 (单号/物料/描述,支持物料换行)"
                             VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>


            <DataGrid x:Name="SourceDataGrid"
                           Grid.Row="2" Grid.Column="0"
                           ItemsSource="{Binding UnshippedList}"
                           AutoGenerateColumns="False"
                           CanUserAddRows="False"
                           CanUserDeleteRows="False"
                           IsReadOnly="True"
                           SelectionMode="Extended"
                           SelectionUnit="FullRow"
                           GridLinesVisibility="Horizontal"
                           SelectionChanged="SourceDataGrid_SelectionChanged"
                           MouseDoubleClick="SourceDataGrid_MouseDoubleClick"
                           PreviewKeyDown="SourceDataGrid_PreviewKeyDown"
                           ScrollViewer.ScrollChanged="DataGrid_ScrollChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}"
                                                    CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <DataGridTextColumn Header="系统单号" Binding="{Binding OrderNo}" Width="110"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="InvoiceNo" Binding="{Binding SourceNo}" Width="100"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="物料编码" Binding="{Binding Sku}" Width="120"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding DescriptionEn}" Width="*"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="颜色" Binding="{Binding FinishEn}" Width="100"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>

                    <DataGridTextColumn Header="订单数" Binding="{Binding QTY, StringFormat=N2}" Width="80"/>

                    <DataGridTextColumn Header="未发货数量" Binding="{Binding UnshippedQty, StringFormat=N2}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

            <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center">

                <Button Margin="0,0,0,15"
                               Content=">>" 
                               Style="{StaticResource ButtonPrimary}"
                               Command="{Binding SelectAllCommand}" />
                <Button Margin="0,0,0,30"
                               Content=">" 
                               Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SelectItemsCommand}" />
                <Button  Margin="0,0,0,15"
                               Content="&lt;" 
                                Style="{StaticResource ButtonDanger}"
                               Command="{Binding RemoveItemsCommand}" />
                <Button Style="{StaticResource ButtonDanger}"
                                Content="&lt;&lt;"
                                Command="{Binding RemoveAllCommand}" />
            </StackPanel>

            <DataGrid x:Name="TargetDataGrid"
                           Grid.Row="2" Grid.Column="2"
                           ItemsSource="{Binding SelectedOutboundLines}"
                           AutoGenerateColumns="False"
                           CanUserAddRows="False"
                           CanUserDeleteRows="False"
                           IsReadOnly="True"
                           SelectionMode="Extended"
                           SelectionUnit="FullRow"
                           SelectionChanged="TargetDataGrid_SelectionChanged"
                           MouseDoubleClick="TargetDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}"
                                                    CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <DataGridTextColumn Header="系统单号" Binding="{Binding OrderNo}" Width="110"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="InvoiceNo" Binding="{Binding SourceNo}" Width="100"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="物料编码" Binding="{Binding Sku}" Width="120"
                                                ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="订单数" Binding="{Binding QTY, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="未发货数量" Binding="{Binding RecQty, StringFormat=N2}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!--底部-->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,15,0"
                   Foreground="{DynamicResource Brush_Txt_Secondary}"/>

                <Button Content="确认" Margin="0,0,8,0"
                        Style="{StaticResource ButtonSuccess}"
                        mt:ButtonAssist.IconSize="10"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Check}"
                        Command="{Binding ConfirmCommand}"/>
                <Button Content="取消" Margin="0,0,8,0"
                        Style="{StaticResource ButtonDanger}"
                        mt:ButtonAssist.IconSize="10"
                        mt:ButtonAssist.Icon="{StaticResource Icon.Close}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>

            <mt:DialogHost d:IsHidden="True"/>
        </Grid>

    </Border>
</Window>
