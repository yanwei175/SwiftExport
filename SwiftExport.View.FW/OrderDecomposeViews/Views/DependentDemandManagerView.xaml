<UserControl x:Class="SwiftExport.View.FW.OrderDecomposeViews.Views.DependentDemandManagerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
             xmlns:vm="clr-namespace:SwiftExport.View.FW.OrderDecomposeViews.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="780"
             d:DesignWidth="1500"
             d:DataContext="{d:DesignInstance vm:DependentDemandManagerViewModel}">

    <UserControl.Resources>
        <!-- 任务清单行样式：供应商缺失高亮、层级配色、选中样式。 -->
        <Style x:Key="RequirementTaskRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="手动指定供应商"
                                  Command="{Binding PlacementTarget.Tag.SetSupplierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BomLevel}" Value="0">
                    <Setter Property="Background" Value="#FFF3F3F3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSupplierMissing}" Value="True">
                    <Setter Property="Background" Value="#FFFFF8C6"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 交期紧急：离今天不足 3 天字体标红。 -->
        <Style x:Key="RequiredDateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRequiredDateUrgent}" Value="True">
                    <Setter Property="Foreground" Value="#FFD32F2F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部任务筛选栏 -->
        <Border Grid.Row="0" Padding="12" Margin="0,0,0,8" Background="{DynamicResource Brush_Bck_Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="关键字" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Height="30" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="SKU" Margin="12,0,6,0"/>
                <TextBox Grid.Column="3" Height="30" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="供货类型" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="5" Height="30"
                          SelectedValue="{Binding SupplyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="全部" Tag=""/>
                    <ComboBoxItem Content="采购" Tag="Purchase"/>
                    <ComboBoxItem Content="生产" Tag="Produce"/>
                    <ComboBoxItem Content="直接采购" Tag="直接采购"/>
                </ComboBox>

                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="供应商" Margin="12,0,6,0"/>
                <TextBox Grid.Column="7" Height="30" Text="{Binding SupplierKeyword, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Grid.Column="8" VerticalAlignment="Center" IsChecked="{Binding ShowCompleted, Mode=TwoWay}" Content="显示已完成"/>

                <Menu Grid.Column="9" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="高级维护">
                        <MenuItem Header="单号拆解">
                            <MenuItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="单号拆解："/>
                                        <TextBox Width="140"
                                                 Margin="6,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding DataContext.SourceSoNoInput, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Width="64"
                                                Height="24"
                                                Content="执行"
                                                Command="{Binding DataContext.TriggerDecomposeCommand, ElementName=Root}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.HeaderTemplate>
                        </MenuItem>

                        <MenuItem Header="批量拆解">
                            <MenuItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="批量拆解："/>
                                        <TextBox Width="180"
                                                 Margin="6,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding DataContext.BatchSourceSoNosInput, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Width="64"
                                                Height="24"
                                                Content="执行"
                                                Command="{Binding DataContext.BatchTriggerDecomposeCommand, ElementName=Root}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.HeaderTemplate>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Button Grid.Column="10" Width="90" Height="30" Content="查询" Command="{Binding LoadCommand}"/>
                <TextBlock Grid.Column="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_Txt_Secondary}"
                           Text="{Binding FlowStageText}"/>
            </Grid>
        </Border>

        <!-- 两栏式任务布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧来源单任务列表 -->
            <Border Grid.Column="0" Padding="8" Background="{DynamicResource Brush_Bck_Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="4,0,4,8" FontWeight="SemiBold" Text="待下达来源单（按日期倒序）"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SourceTasks}"
                             SelectedItem="{Binding SelectedSourceTask, Mode=TwoWay}"
                             DisplayMemberPath="DisplayText"/>
                </Grid>
            </Border>

            <!-- 右侧明细任务区 -->
            <Border Grid.Column="2" Padding="8" Background="{DynamicResource Brush_Bck_Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{Binding SelectedSourceNo, StringFormat=当前任务单：{0}}"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Height="34"
                                Margin="0,0,8,0"
                                Content="选中行转采购"
                                Command="{Binding BatchIssuePurchaseCommand}"/>

                        <Button Grid.Column="2"
                                Height="34"
                                FontWeight="Bold"
                                Background="#FF2E7D32"
                                Foreground="White"
                                Content="基于当前销售单生成采购单"
                                Command="{Binding ConvertSelectedSourceToPurchaseCommand}"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource BaseDataGrid}"
                              ItemsSource="{Binding DetailItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Tag="{Binding DataContext, ElementName=Root}"
                              RowStyle="{StaticResource RequirementTaskRowStyle}"
                              mt:DataGridAssist.ShowRowNumber="True"
                              mt:DataGridAssist.EnableSoftValidation="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="!" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#FFF57C00" Text="⚠">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSupplierMissing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>

                            <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="80"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                            <DataGridTextColumn Header="ParentSku" Binding="{Binding ParentSku}" Width="120"/>
                            <DataGridTextColumn Header="供货类型" Binding="{Binding SupplyType}" Width="110"/>

                            <DataGridTemplateColumn Header="交期" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource RequiredDateTextStyle}" Text="{Binding RequiredDate, StringFormat=yyyy-MM-dd}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="毛需求" Binding="{Binding GrossQty, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="净需求" Binding="{Binding NetQty, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="已下达" Binding="{Binding ExecutedQty, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="库存可用" Binding="{Binding AvailableStockQty, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="缺口提醒" Binding="{Binding GapQty, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="已收货" Binding="{Binding ReceivedQty, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="已发货" Binding="{Binding ShippedQty, StringFormat=F2}" Width="85"/>

                            <DataGridTemplateColumn Header="目标单号" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button BorderThickness="0"
                                                Background="Transparent"
                                                Foreground="#FF1976D2"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenTargetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="{Binding TargetNo}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TargetNo}" Value="">
                                                            <Setter Property="Content" Value="点击转采购/工单"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="供应商编码" Binding="{Binding SupplierCode}" Width="110"/>
                            <DataGridTextColumn Header="供应商名称" Binding="{Binding SupplierName}" Width="130"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusFlag}" Width="70"/>
                            <DataGridCheckBoxColumn Header="齐套" Binding="{Binding IsKitted}" Width="60"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Foreground="{DynamicResource Brush_Txt_Secondary}" Text="{Binding StatusMessage}"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource Brush_Txt_Secondary}" Text="{Binding AvgKittingRateText}"/>
        </Grid>
    </Grid>
</UserControl>
