<Window x:Class="SwiftExport.View.FW.WarehouseViews.Views.AwatingInboundView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mt="https://MateWpfTheme.com/wpf/framework/themes"
        xmlns:conv="clr-namespace:SwiftExport.View.FW.WarehouseViews.Converters"
        xmlns:vm="clr-namespace:SwiftExport.View.FW.WarehouseViews.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AwatingInboundViewModel}"
        d:Background="White"
        WindowStartupLocation="CenterScreen"
        Height="680" Width="1280"
        Title="选择待入库行">
    <Window.Resources>
        <conv:AwaitingInboundPendingQtyConverter x:Key="PendingQtyConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="待入库列表" Margin="0,5,0,12"
                   Style="{StaticResource BoldTextBlock}"
                   HorizontalAlignment="Center"
                   FontSize="20"/>

        <Grid x:Name="中间区域" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="待选表格" Width="7*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="选定表格" Width="4*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="供应商列表" HorizontalAlignment="Center"
                       Style="{StaticResource BoldTextBlock}"/>

            <ListBox Grid.Row="1" x:Name="SupplierFilter"
                     ItemsSource="{Binding SupplierList}"
                     DisplayMemberPath="SupplierName"
                     SelectedValuePath="SupplierCode"
                     SelectedValue="{Binding SelectedSupplierCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"> 
            </ListBox>

            <GridSplitter Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Stretch"/>

            <StackPanel x:Name="筛选条件" Grid.Row="0" Grid.Column="2"
                        Height="40"
                        Orientation="Horizontal">
                <TextBlock Text="物料类型" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox Margin="0,0,8,0"
                          Width="120"
                          ItemsSource="{Binding MaterialTypes}"
                          SelectedItem="{Binding SelectedMaterialType, Mode=TwoWay}"
                          Height="30"/>
                <Button Content="全选" Margin="0,0,8,0"
                        Style="{StaticResource ButtonBase}"
                        Command="{Binding SelectAllCommand}"/>
                <Button Content="移除全部" Margin="0,0,8,0"
                        Style="{StaticResource ButtonBase}"
                        Command="{Binding RemoveAllCommand}"/>
            </StackPanel>

            <DataGrid x:Name="SourceDataGrid"
                      Grid.Row="1" Grid.Column="2"
                      Style="{StaticResource ReadOnlyDataGrid}"
                      ItemsSource="{Binding AwatingInboundList}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="SourceDataGrid_SelectionChanged"
                      MouseDoubleClick="SourceDataGrid_MouseDoubleClick"
                      PreviewKeyDown="SourceDataGrid_PreviewKeyDown"
                      ScrollViewer.ScrollChanged="DataGrid_ScrollChanged">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}"
                                            CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>

                    <DataGridTextColumn Header="系统单号" Binding="{Binding OrderNo}" Width="*"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="订单号" Binding="{Binding SourceNo}" Width="*"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="物料" Binding="{Binding Sku}" Width="*"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding DescriptionZh}" Width="*"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="物料类型" Binding="{Binding MaterialType}" Width="*"
                                        ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="订单数" Binding="{Binding QTY, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="已收数" Binding="{Binding RecQty, StringFormat=N2}" Width="*"/>
                    <DataGridTemplateColumn Header="待收数" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PendingQtyConverter}" StringFormat="N2">
                                            <Binding Path="QTY"/>
                                            <Binding Path="RecQty"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.RowSpan="2" Grid.Column="3" HorizontalAlignment="Stretch"/>

            <DataGrid x:Name="TargetDataGrid"
                      Grid.Row="1" Grid.Column="4"
                      Style="{StaticResource ReadOnlyDataGrid}"
                      ItemsSource="{Binding SelectedInboundLines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="TargetDataGrid_SelectionChanged"
                      MouseDoubleClick="TargetDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}"
                                            CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <DataGridTextColumn Header="订单号" Binding="{Binding SourceNo}" Width="*"/>
                    <DataGridTextColumn Header="物料" Binding="{Binding Sku}" Width="*"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding DescriptionZh}" Width="*"/>
                    <DataGridTextColumn Header="物料类型" Binding="{Binding MaterialType}" Width="*"/>
                    <DataGridTemplateColumn Header="待收数" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PendingQtyConverter}" StringFormat="N2">
                                            <Binding Path="QTY"/>
                                            <Binding Path="RecQty"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,15,0"
                       Foreground="{DynamicResource Brush_Txt_Secondary}"/>

            <Button Content="确认" Margin="0,0,8,0"
                    Style="{StaticResource ButtonSuccess}"
                    mt:ButtonAssist.IconSize="10"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Check}"
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="取消" Margin="0,0,8,0"
                    Style="{StaticResource ButtonDanger}"
                    mt:ButtonAssist.IconSize="10"
                    mt:ButtonAssist.Icon="{StaticResource Icon.Close}"
                    Command="{Binding CancelCommand}"/>

        </StackPanel>

        <mt:DialogHost/>
    </Grid>
</Window>
