<Window x:Class="SwiftExport.VSTO.UserWindow.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        Title="功能窗体标题" 
        Height="1048" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.VSTO;component/Resources/Styles/ErpTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainBorder"
            CornerRadius="12" 
            Background="White" 
            BorderBrush="#DDDDDD" 
            BorderThickness="1" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Background="Transparent">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                           VerticalAlignment="Center" 
                           Margin="15,0,0,0"
                           Foreground="#333333"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize"
                            Content="—"
                            Click="BtnMinimize_Click"/>

                    <Button x:Name="BtnClose"
                            Content="✕"
                            IsCancel="True"
                            FontSize="16"
                            Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF4444"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="15,0,15,15" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="White" Padding="5">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="新建" Command="{Binding AddCommand}" Width="60" Margin="2"/>
                            <Button Content="保存" Command="{Binding SaveCommand}" Width="60" Margin="2"/>
                            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="60" Margin="2"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="筛选:" VerticalAlignment="Center" Margin="5"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=350}" 
                             Width="200" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding DataView}" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="30"
                  AlternatingRowBackground="White">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="供应商代码" Binding="{Binding 供应商代码, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="单据关联号" Binding="{Binding 单据关联, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="供应商名称" Binding="{Binding 供应商名称, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="折扣" Binding="{Binding 折扣, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="折扣备注" Binding="{Binding 折扣备注, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Button Content="删除" 
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StatusBar Grid.Row="2" Background="White">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>


        </Grid>
    </Border>
</Window>