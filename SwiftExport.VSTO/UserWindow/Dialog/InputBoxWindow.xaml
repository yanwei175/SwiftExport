<Window x:Class="SwiftExport.VSTO.UserWindow.Dialog.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" 
        Height="Auto" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="Height"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftExport.VSTO;component/Resources/Styles/ErpTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="15" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Path Fill="{StaticResource PrimaryBrush}" 
                          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                </Viewbox>
                <TextBlock x:Name="TxtTitle" Text="请输入内容" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#333"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" Grid.Row="1" 
                       Text="请输入新的名称:" 
                       TextWrapping="Wrap" 
                       Margin="2,0,0,10" 
                       FontSize="13" 
                       Foreground="#666"/>

            <TextBox x:Name="TxtInput" Grid.Row="2"
                     Margin="0,0,0,20"
                     Height="32"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtInput_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" 
                        Click="BtnCancel_Click"
                        Margin="0,0,10,0"
                        Width="80"
                        IsCancel="True"/>
                <Button Content="确定" 
                        Click="BtnOk_Click"
                        Width="80"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>