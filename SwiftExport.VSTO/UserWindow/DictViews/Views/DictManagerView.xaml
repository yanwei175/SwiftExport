<Window x:Class="SwiftExport.VSTO.UserWindow.DictViews.Views.DictManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据字典 (枚举) 管理" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.VSTO;component/Resources/Styles/ErpTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
                    <TextBox Text="{Binding SearchTypeText, UpdateSourceTrigger=PropertyChanged}" 
                             Tag="搜索字典分类..." 
                             Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding DictTypesView}" 
                         SelectedItem="{Binding SelectedDictType, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Margin="0,5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DictName}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                                    <TextBlock Text="{Binding DictCode}" FontSize="12" Foreground="#999" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"
                                        Background="#FFF4E5" BorderBrush="#FF9800" BorderThickness="1" 
                                        CornerRadius="2" Padding="4,2" VerticalAlignment="Center">
                                    <TextBlock Text="系统内置" FontSize="10" Foreground="#FF9800"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="1" Background="Transparent" HorizontalAlignment="Center"/>

        <Border Grid.Column="2" Background="White" Margin="0,10,10,10" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDictType.DictName, FallbackValue='请选择字典'}" 
                                       FontSize="18" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <Button Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding AddNewRowCommand}">
                                <TextBlock Text="新增枚举项" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,10,0" Command="{Binding BatchSaveCommand}">
                                <TextBlock Text="保存" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{DynamicResource DefaultButtonStyle}" Command="{Binding LoadCommand}">
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsView}" RowHeight="40" Margin="10"
                          CanUserAddRows="False" AutoGenerateColumns="False" BorderThickness="1">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Added">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Modified">
                                    <Setter Property="Background" Value="#FFF8E1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Deleted">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#9E9E9E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="显示名称 (Label)" Binding="{Binding DictLabel}" Width="150" FontWeight="Bold"/>

                        <DataGridTextColumn Header="真实键值 (Value)" Binding="{Binding DictValue}" Width="150"
                                            IsReadOnly="{Binding IsSystem}"/>

                        <DataGridTextColumn Header="排序号" Binding="{Binding SortOrder}" Width="80"/>

                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button CommandParameter="{Binding}" Width="60" Height="24" Padding="0" Foreground="White"
                                            IsEnabled="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                <Setter Property="Content" Value="删除"/>
                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                <Setter Property="Command" Value="{Binding DataContext.SingleDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Deleted">
                                                        <Setter Property="Content" Value="撤销"/>
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="Command" Value="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,5">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>