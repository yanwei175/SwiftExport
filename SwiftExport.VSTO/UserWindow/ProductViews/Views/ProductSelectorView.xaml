<Window x:Class="SwiftExport.VSTO.UserWindow.ProductViews.Views.ProductSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

         xmlns:beh="clr-namespace:SwiftExport.View.FW.UserControls.Expand"
        xmlns:ctrl="clr-namespace:SwiftExport.View.FW.UserControls"
        
        xmlns:viewmodels="clr-namespace:SwiftExport.VSTO.UserWindow.ProductViews.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProductSelectorViewModel}"
        mc:Ignorable="d"
        Title="选择产品" Height="800" Width="1400" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.VSTO;component/Resources/Styles/ErpTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PaperBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="客户:" Foreground="{StaticResource RegularTextBrush}" Margin="0,0,0,4"/>
                    <ctrl:SearchableComboBox 
                        ItemsSource="{Binding Customers}" 
                        SelectedItem="{Binding SelectedCustomer}"
                        SelectionChangedCommand="{Binding CustomerChangedCommand}" />

                    <TextBlock Text="搜索 (型号/描述):" Foreground="{StaticResource RegularTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="批量查询 (支持多行):" Foreground="{StaticResource RegularTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="80" Padding="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="SourceDataGrid" Grid.Column="0" 
                      ItemsSource="{Binding SourceProducts}" 
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      FontSize="10"
                      RowHeight="64"
                      IsReadOnly="True"
                      SelectionChanged="SourceDataGrid_SelectionChanged"
                      MouseDoubleClick="SourceDataGrid_MouseDoubleClick"
                      ScrollViewer.ScrollChanged="DataGrid_ScrollChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <DataGridTextColumn Header="产品型号" Binding="{Binding Sku}" Width="120" FontWeight="Bold" ElementStyle="{StaticResource   MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource  MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="颜色" Binding="{Binding Finish}" Width="100" ElementStyle="{StaticResource  DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="80" ElementStyle="{StaticResource  DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="客户型号" Binding="{Binding CSku}" Width="120" ElementStyle="{StaticResource  DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="配置" Binding="{Binding Features}" Width="120"  ElementStyle="{StaticResource MultiLineDataGridTextBlockStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="0" Background="Transparent" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="正在查询..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#0078D4"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                
                <Button Style="{DynamicResource  PrimaryButtonStyle}" Margin="0,0,0,15" 
                        Content=">> 全选" 
                        Command="{Binding SelectAllCommand}" />
                
                <Button Style="{StaticResource  PrimaryButtonStyle}" Margin="0,0,0,30"
                    Content="> 选择" 
                    Command="{Binding SelectItemsCommand}" />
                
                <Button Style="{StaticResource  DefaultButtonStyle}" Margin="0,0,0,15"
                    Content="&lt; 移除" 
                    Command="{Binding RemoveItemsCommand}" />
                
                <Button Style="{StaticResource  DefaultButtonStyle}" 
                    Content="&lt;&lt; 清空" 
                    Command="{Binding RemoveAllCommand}" />
                
            </StackPanel>

            <DataGrid x:Name="TargetDataGrid" Grid.Column="2" 
                      ItemsSource="{Binding SelectedProducts}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      beh:DataGridBehavior.ShowAutoRowNumber="True"
                      FontSize="10"
                      RowHeight="64"
                      IsReadOnly="True"
                      SelectionChanged="TargetDataGrid_SelectionChanged"
                      MouseDoubleClick="TargetDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" CellStyle="{StaticResource ZeroPaddingCell}" CellTemplate="{StaticResource ImageCellTemplate}" Width="64"/>
                    <DataGridTextColumn Header="产品型号" Binding="{Binding Sku}" Width="120" FontWeight="Bold" ElementStyle="{StaticResource   MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource   MultiLineDataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="颜色" Binding="{Binding Finish}" Width="100" ElementStyle="{StaticResource  MultiLineDataGridTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" 
                Background="{StaticResource PaperBackgroundBrush}" 
                BorderBrush="{StaticResource LightBorderBrush}" 
                BorderThickness="0,1,0,0" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666" Margin="0,0,265,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Style="{StaticResource DefaultButtonStyle}" Width="100" Margin="0,0,10,0"
                        Content="暂时隐藏" IsCancel="True" Command="{Binding HideCommand}"  />

                    <Button Style="{StaticResource DefaultButtonStyle}" Width="100" Margin="0,0,10,0"
                        Content="取消" Command="{Binding CancelCommand}" />

                    <Button  Style="{StaticResource PrimaryButtonStyle}" Width="100" Margin="0,0,10,0"
                        Content="确定" Command="{Binding ConfirmCommand}" />
                    
                </StackPanel>
            </Grid>
        </Border>
        
        
    </Grid>
</Window>