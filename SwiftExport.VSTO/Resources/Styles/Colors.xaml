<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Primary">#1890FF</Color>
    <Color x:Key="Color.Primary.Hover">#40A9FF</Color>
    <Color x:Key="Color.Primary.Active">#096DD9</Color>
    <Color x:Key="Color.Primary.Light">#E6F7FF</Color>
    <Color x:Key="Color.Success">#52C41A</Color>
    <Color x:Key="Color.Success.Light">#F6FFED</Color>
    <Color x:Key="Color.Warning">#FAAD14</Color>
    <Color x:Key="Color.Warning.Light">#FFFBE6</Color>
    <Color x:Key="Color.Error">#F5222D</Color>
    <Color x:Key="Color.Error.Light">#FFF1F0</Color>
    <Color x:Key="Color.Info">#1890FF</Color>

    <Color x:Key="Color.Text.Title">#141414</Color>
    <Color x:Key="Color.Text.Primary">#262626</Color>
    <Color x:Key="Color.Text.Regular">#595959</Color>
    <Color x:Key="Color.Text.Secondary">#8C8C8C</Color>
    <Color x:Key="Color.Text.Disabled">#BFBFBF</Color>
    <Color x:Key="Color.Border.Heavy">#D9D9D9</Color>
    <Color x:Key="Color.Border.Light">#F0F0F0</Color>
    <Color x:Key="Color.Bg.App">#F0F2F5</Color>
    <Color x:Key="Color.Bg.Paper">#FFFFFF</Color>
    <Color x:Key="Color.Bg.Hover">#F5F5F5</Color>
    <Color x:Key="Color.Bg.Disabled">#F5F5F5</Color>


    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Color.Primary.Hover}" />
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource Color.Primary.Active}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Color.Primary.Light}" />


    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource Color.Success.Light}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource Color.Warning.Light}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource Color.Error.Light}" />
    <SolidColorBrush x:Key="TitleTextBrush" Color="{StaticResource Color.Text.Title}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource Color.Text.Primary}" />

    <SolidColorBrush x:Key="RegularTextBrush" Color="{StaticResource Color.Text.Regular}" />

    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource Color.Text.Secondary}" />

    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource Color.Text.Disabled}" />


    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border.Heavy}" />

    <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource Color.Border.Light}" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Color.Bg.App}" />

    <SolidColorBrush x:Key="PaperBackgroundBrush" Color="{StaticResource Color.Bg.Paper}" />

    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource Color.Bg.Hover}" />

    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource Color.Bg.Disabled}" />

</ResourceDictionary>