    <Import Project="$(NuGetPackageRoot)refit\10.0.1\buildTransitive\netstandard2.0\refit.targets" Condition="Exists('$(NuGetPackageRoot)refit\10.0.1\buildTransitive\netstandard2.0\refit.targets')" />
    <Import Project="$(NuGetPackageRoot)materialdesignthemes\5.3.0\build\MaterialDesignThemes.targets" Condition="Exists('$(NuGetPackageRoot)materialdesignthemes\5.3.0\build\MaterialDesignThemes.targets')" />
  </ImportGroup>
</Project>