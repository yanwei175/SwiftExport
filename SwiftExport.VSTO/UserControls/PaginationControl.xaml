<UserControl x:Class="SwiftExport.VSTO.UserControls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.VSTO;component/Resources/Styles/ErpTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PagerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource LightBorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">

        <TextBlock Text="共 " Foreground="{StaticResource RegularTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalCount, ElementName=Root, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text=" 条数据" Foreground="{StaticResource RegularTextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>

        <Rectangle Width="1" Height="14" Fill="{StaticResource LightBorderBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>

        <TextBlock Text="每页 " VerticalAlignment="Center" Foreground="{StaticResource RegularTextBrush}"/>
        <ComboBox Width="55" Margin="5,0" Padding="4,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                  ItemsSource="{Binding PageSizeOptions, ElementName=Root, Mode=OneWay}"
                  SelectedItem="{Binding PageSize, ElementName=Root, Mode=TwoWay}"/>
        <TextBlock Text="条" VerticalAlignment="Center" Foreground="{StaticResource RegularTextBrush}" Margin="0,0,15,0"/>

        <Button Content="首页" Style="{StaticResource PagerButtonStyle}" 
                IsEnabled="{Binding CanGoBack, ElementName=Root, Mode=OneWay}" 
                Command="{Binding FirstPageCommand, ElementName=Root}"/>

        <Button Content="上一页" Style="{StaticResource PagerButtonStyle}" 
                IsEnabled="{Binding CanGoBack, ElementName=Root, Mode=OneWay}" 
                Command="{Binding PrevPageCommand, ElementName=Root}"/>

        <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource PrimaryTextBrush}">
            <Run Text="{Binding PageIndex, ElementName=Root, Mode=OneWay}"/>
            <Run Text="/" Foreground="{StaticResource SecondaryTextBrush}"/>
            <Run Text="{Binding TotalPages, ElementName=Root, Mode=OneWay}"/>
        </TextBlock>

        <Button Content="下一页" Style="{StaticResource PagerButtonStyle}" 
                IsEnabled="{Binding CanGoForward, ElementName=Root, Mode=OneWay}" 
                Command="{Binding NextPageCommand, ElementName=Root}"/>

        <Button Content="尾页" Style="{StaticResource PagerButtonStyle}" 
                IsEnabled="{Binding CanGoForward, ElementName=Root, Mode=OneWay}" 
                Command="{Binding LastPageCommand, ElementName=Root}"/>
        <Rectangle Width="1" Height="14" Fill="{StaticResource LightBorderBrush}" Margin="15,0,15,0" VerticalAlignment="Center"/>

        <TextBlock Text="当前第 " VerticalAlignment="Center" Foreground="{StaticResource RegularTextBrush}"/>

        <ComboBox Width="60" Margin="5,0" Padding="4,2"
                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                  ItemsSource="{Binding PageNumbers, ElementName=Root, Mode=OneWay}"
                  SelectedItem="{Binding PageIndex, ElementName=Root, Mode=TwoWay}"/>

        <TextBlock Text="页" VerticalAlignment="Center" Foreground="{StaticResource RegularTextBrush}"/>
    </StackPanel>
</UserControl>