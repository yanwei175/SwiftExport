{
  "Api": {
    "BaseUrl": "https://localhost:7286"
  },
  "Client": {
    "ApplicationName": "SwiftExport",
    "Version": "0.1.0"
  },
  "ImageCache": {
    "MemoryLimitMegabytes": 64,
    "MemoryEntryLimit": 512,
    "DiskLimitMegabytes": 512,
    "DiskCleanupTargetRatio": 0.8,
    "ExpirationDays": 30,
    "DefaultDecodePixelWidth": 96,
    "MaximumDecodePixelWidth": 2048,
    "MaximumSourceFileMegabytes": 50,
    "MaximumConcurrentDecodes": 2,
    "NegativeCacheSeconds": 30
  }
}
