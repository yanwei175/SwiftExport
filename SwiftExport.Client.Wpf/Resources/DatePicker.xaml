<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type DatePickerTextBox}" >
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Height" Value="0"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style BasedOn="{StaticResource {x:Type DatePicker}}" TargetType="{x:Type DatePicker}" >
        <Setter Property="Height" Value="0"/>
    </Style>


    <Style x:Key="SwiftExportDatePicker" TargetType="{x:Type DatePicker}">
        <!-- 将官方主题限制在日期控件内部，包含输入框和弹出日历，不改变全局控件样式。 -->
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <!-- 必须先声明局部资源，再解析 BasedOn，避免引用全局 WPF-UI 的 DatePicker 样式。 -->
        <Style.BasedOn>
            <StaticResource ResourceKey="{x:Type DatePicker}" />
        </Style.BasedOn>
    </Style>












</ResourceDictionary>
