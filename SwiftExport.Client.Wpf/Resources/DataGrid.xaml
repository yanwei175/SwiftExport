<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
                    xmlns:converters="clr-namespace:SwiftExportClient.Resources.Converters"
                    xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
                    xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
                    xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
                    xmlns:gridState="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.State.Presentation;assembly=SwiftExport.Wpf.EnterpriseGrid"
                    xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <converters:FirstValidationErrorConverter x:Key="SwiftExportFirstValidationErrorConverter" />
    <gridValidation:GridCellValidationStateConverter x:Key="SwiftExportGridCellValidationStateConverter" />
    <gridSelection:GridCurrentCellStateConverter x:Key="SwiftExportGridCurrentCellStateConverter" />
    <gridSelection:GridCurrentRowStateConverter x:Key="SwiftExportGridCurrentRowStateConverter" />

    <DataTemplate x:Key="SwiftExportEnterpriseGridRowHeaderTemplate">
        <Grid MinWidth="24"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              SnapsToDevicePixels="True"
              ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRowHeader}},
              Path=(gridState:GridRowPresentation.MarkerText)}"
              AutomationProperties.Name="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRowHeader}}, Path=(gridState:GridRowPresentation.MarkerText), FallbackValue=普通行, TargetNullValue=普通行}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Margin="0,2,0,2"
                    Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRowHeader}},
                    Path=(gridState:GridRowPresentation.MarkerBrush)}" />
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                       Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRowHeader}}, Path=Content}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=(gridCore:GridRowHeader.ShowRowNumber)}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <Style x:Key="SwiftExportDataGridTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    </Style>
    
    <Style x:Key="SwiftExportDataGridWarpTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style x:Key="SwiftExportDataGridLongTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SwiftExportDataGridNumberTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="SwiftExportDataGridTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}"/>
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    </Style>
    
    <Style x:Key="SwiftExportDataGridWarpTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource SwiftExportDataGridTextBox}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>


    <Style x:Key="SwiftExportDataGridNumberTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource SwiftExportDataGridTextBox}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportDataGridValidationBorderThickness}" />
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors), Converter={StaticResource SwiftExportFirstValidationErrorConverter}, FallbackValue={x:Null}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportDataGridDateTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SwiftExportDataGridCheckBoxElementStyle" TargetType="{x:Type CheckBox}"  BasedOn="{StaticResource DefaultDataGridCheckBoxElementStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SwiftExportDataGridCheckBoxEditingElementStyle" TargetType="{x:Type CheckBox}"  BasedOn="{StaticResource DefaultDataGridCheckBoxEditingElementStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    

    <Style x:Key="SwiftExportDataGridDatePicker" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportDataGridValidationBorderThickness}" />
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors), Converter={StaticResource SwiftExportFirstValidationErrorConverter}, FallbackValue={x:Null}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportDataGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}" 
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="{DynamicResource SwiftExportDataGridHeaderPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SwiftExport.DataGridColumnHeaderNoResize" TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <Style x:Key="SwiftExportDataGridRowHeaderGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 完整接管 RowHeader 外层视觉；行号内容仍由 DataGrid.RowHeaderTemplate 提供。 -->
    <Style x:Key="SwiftExportDataGridRowHeader" TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                    <Grid>
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Control x:Name="ValidationErrorElement"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Focusable="False"
                                         SnapsToDevicePixels="False"
                                         Template="{Binding ValidationErrorTemplate, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_TopHeaderGripper"
                               VerticalAlignment="Top"
                               Style="{StaticResource SwiftExportDataGridRowHeaderGripper}" />
                        <Thumb x:Name="PART_BottomHeaderGripper"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource SwiftExportDataGridRowHeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(Validation.HasError)}"
                                     Value="True">
                            <Setter TargetName="ValidationErrorElement" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwiftExportDataGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="gridSelection:GridSelection.IsCurrentRow">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SwiftExportGridCurrentRowStateConverter}">
                    <Binding Mode="OneWay" ValidatesOnNotifyDataErrors="False" ValidatesOnDataErrors="False" />
                    <Binding Path="(gridSelection:GridSelection.NativeCurrentCellState)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridSelectedBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridSelection:GridSelection.IsCurrentRow)}"
                               Value="True" />
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                               Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridCurrentRowBackground}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportStateDataGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SwiftExportDataGridRow}">
        <Setter Property="gridValidation:GridValidation.RowState">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SwiftExportGridCellValidationStateConverter}">
                    <Binding Mode="OneWay" ValidatesOnNotifyDataErrors="False" ValidatesOnDataErrors="False" />
                    <Binding Path="(gridValidation:GridValidation.Errors)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Added">
                <Setter Property="gridState:GridRowPresentation.MarkerBrush" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                <Setter Property="gridState:GridRowPresentation.MarkerText" Value="新增行" />
                <Setter Property="gridState:GridRowPresentation.MarkerGlyph" Value="+" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Modified">
                <Setter Property="gridState:GridRowPresentation.MarkerBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="gridState:GridRowPresentation.MarkerText" Value="已修改行" />
                <Setter Property="gridState:GridRowPresentation.MarkerGlyph" Value="●" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Deleted">
                <Setter Property="gridState:GridRowPresentation.MarkerBrush" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                <Setter Property="gridState:GridRowPresentation.MarkerText" Value="已删除行" />
                <Setter Property="gridState:GridRowPresentation.MarkerGlyph" Value="×" />
                <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorSecondaryBrush}" />
                <Setter Property="Opacity" Value="0.72" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Deleted" />
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}" />
                <Setter Property="Opacity" Value="1" />
            </MultiDataTrigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="gridState:GridRowPresentation.MarkerBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="gridState:GridRowPresentation.MarkerText" Value="行验证错误" />
                <Setter Property="gridState:GridRowPresentation.MarkerGlyph" Value="!" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.RowState).HasError}"
                         Value="True">
                <Setter Property="gridState:GridRowPresentation.MarkerBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="gridState:GridRowPresentation.MarkerText" Value="行验证错误" />
                <Setter Property="gridState:GridRowPresentation.MarkerGlyph" Value="!" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportDataGridCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="{DynamicResource SwiftExportDataGridCellPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTip" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="gridValidation:GridValidation.CellState">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SwiftExportGridCellValidationStateConverter}">
                    <Binding Mode="OneWay" ValidatesOnNotifyDataErrors="False" ValidatesOnDataErrors="False" />
                    <Binding Path="Column.(gridColumns:GridColumn.Key)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="(gridValidation:GridValidation.Errors)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="gridSelection:GridSelection.IsCurrentCell">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource SwiftExportGridCurrentCellStateConverter}">
                    <Binding Mode="OneWay" ValidatesOnNotifyDataErrors="False" ValidatesOnDataErrors="False" />
                    <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="(gridSelection:GridSelection.NativeCurrentCellState)" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).HasError}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportDataGridValidationBorderThickness}" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).Message}" />
            </DataTrigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportDataGridValidationBorderThickness}" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors), Converter={StaticResource SwiftExportFirstValidationErrorConverter}, FallbackValue={x:Null}}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridSelectedBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridSelection:GridSelection.IsCurrentCell)}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextAccentBrush}" />
                <Setter Property="BorderThickness" Value="0.8" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).HasError}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).Message}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridSelection:GridSelection.IsCurrentCell)}" Value="True" />
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridSelection:GridSelection.IsCurrentCell)}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).HasError}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(gridValidation:GridValidation.CellState).Message}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>


    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{DynamicResource UserControlFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="8"/>
    </Style>

        <Style x:Key="SwiftExportDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportBorderThickness}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="RowHeaderWidth" Value="32" />
        <Setter Property="RowHeaderStyle" Value="{StaticResource SwiftExportDataGridRowHeader}" />
        <Setter Property="RowHeaderTemplate" Value="{StaticResource SwiftExportEnterpriseGridRowHeaderTemplate}" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource UserLayerFillColorAltBrush}" />
        <!--<Setter Property="ColumnHeaderStyle" Value="{StaticResource SwiftExportDataGridColumnHeader}" />-->
        <Setter Property="RowStyle" Value="{StaticResource SwiftExportDataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource SwiftExportDataGridCell}" />
    </Style>
    
    
</ResourceDictionary>
