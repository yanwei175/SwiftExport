<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeaderWidth" Value="32" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource SwiftExportFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{DynamicResource SwiftExportCellPadding}" />
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource SwiftExportCellPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
