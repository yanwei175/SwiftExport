<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:controls="clr-namespace:SwiftExportClient.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SwiftExportDataGridTextBlock"
           TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    </Style>

    <Style x:Key="SwiftExportDataGridLongTextBlock"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SwiftExportDataGridNumberTextBlock"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="SwiftExportDataGridTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBoxBase}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    </Style>

    <Style x:Key="SwiftExportDataGridNumberTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource SwiftExportDataGridTextBox}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="SwiftExportDataGridPopupTextBoxEditingStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource SwiftExportDataGridTextBox}">
        <Setter Property="controls:PopupTextBoxAssist.IsEnabled" Value="True" />
        <Setter Property="controls:PopupTextBoxAssist.PopupHeight" Value="220" />
        <Setter Property="controls:PopupTextBoxAssist.PopupMinWidth" Value="320" />
    </Style>

    <Style x:Key="SwiftExportDataGridColumnHeader"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="{DynamicResource SwiftExportDataGridHeaderPadding}" />
        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.DataGridGridLine}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SwiftExportDataGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridHoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DataGridSelectedBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportStateDataGridRow"
           TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource SwiftExportDataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Added">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.SuccessSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Modified">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.WarningSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Deleted">
                <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.DeletedSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
                <Setter Property="Opacity" Value="0.72" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportDataGridCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="{DynamicResource SwiftExportDataGridCellPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTip" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Error}" />
                <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportDataGridValidationBorderThickness}" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent, FallbackValue={x:Null}}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Accent}" />
                <Setter Property="BorderThickness" Value="0,0,0,0" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Accent}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportDataGrid"
           TargetType="{x:Type DataGrid}"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SwiftExportBrush.DataGridGridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SwiftExportBrush.DataGridGridLine}" />
        <Setter Property="RowHeaderWidth" Value="32" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource SwiftExportBorderThickness}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource SwiftExportDataGridColumnHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource SwiftExportDataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource SwiftExportDataGridCell}" />
    </Style>
</ResourceDictionary>
