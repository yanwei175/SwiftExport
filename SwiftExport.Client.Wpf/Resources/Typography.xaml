<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SwiftExportFontFamily">Segoe UI</FontFamily>

    <Style x:Key="CaptionTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextBlockStyle}"/>
    <Style x:Key="SecondaryTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
    </Style>
    <Style x:Key="LabelTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
    </Style>
    <Style x:Key="BodyTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextBlockStyle}"/>
    <Style x:Key="BodyStrongTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>
    <Style x:Key="SubtitleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubtitleTextBlockStyle}"/>
    <Style x:Key="TitleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TitleTextBlockStyle}"/>
    <Style x:Key="TitleLargeTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TitleLargeTextBlockStyle}"/>
    <Style x:Key="DisplayTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DisplayTextBlockStyle}"/>

</ResourceDictionary>
