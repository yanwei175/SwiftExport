<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SwiftExportFontFamily">Segoe UI</FontFamily>

    <Style x:Key="SwiftExportTitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SwiftExportFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
    </Style>

    <Style x:Key="SwiftExportHeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SwiftExportFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
    </Style>

    <Style x:Key="SwiftExportBodyText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SwiftExportFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="SwiftExportCaptionText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SwiftExportBodyText}">
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
