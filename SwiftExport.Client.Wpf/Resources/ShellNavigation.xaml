<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Thickness x:Key="SwiftExportShellNavigationPadding">16,16,16,12</Thickness>
    <Thickness x:Key="SwiftExportShellNavigationItemPadding">12,0</Thickness>
    <Thickness x:Key="SwiftExportShellNavigationChildMargin">24,4,0,0</Thickness>

    <Style x:Key="SwiftExportShellNavigationItemButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SwiftExportShellNavigationItemContainer"
           TargetType="{x:Type ContentPresenter}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SwiftExportShellNavigationIcon"
           TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SwiftExportShellNavigationText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource BodyTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SwiftExportShellNavigationChevron"
           TargetType="{x:Type ui:SymbolIcon}"
           BasedOn="{StaticResource SwiftExportShellNavigationIcon}">
        <Setter Property="Symbol" Value="ChevronDown20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
