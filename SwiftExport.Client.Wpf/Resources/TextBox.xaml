<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="{DynamicResource SwiftExportControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource SwiftExportControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource SwiftExportFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwiftExportBrush.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource SwiftExportBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
