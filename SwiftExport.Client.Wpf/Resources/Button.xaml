<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">


    
    <Style x:Key="AccentButton" TargetType="{x:Type ButtonBase}"/>


    <Style x:Key="SwiftExportShellMenuButton" TargetType="{x:Type Button}"  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="{StaticResource SwiftExportShellNavItemMargin}" />
    </Style>

    <Style x:Key="SwiftExportShellChildMenuButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SwiftExportShellMenuButton}">
        <Setter Property="Margin" Value="{StaticResource SwiftExportShellNavChildMargin}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="SwiftExportTabCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0" />
    </Style>
    
    <Style x:Key="MoreVerticalButtonStyleInDataGrid" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="0"/>

        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="MoreVerticalButtonStyleInTitle" TargetType="ui:Button" BasedOn="{StaticResource MoreVerticalButtonStyleInDataGrid}">
        <Setter Property="Icon" Value="{ui:SymbolIcon Symbol=MoreVertical24}"/>
    </Style>
    
    
</ResourceDictionary>
