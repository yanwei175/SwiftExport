<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}"/>


    <Style x:Key="SwiftExportShellMenuButton" TargetType="{x:Type Button}"  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,7" />
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>

    <Style x:Key="SwiftExportTabCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0" />
    </Style>
    
</ResourceDictionary>
