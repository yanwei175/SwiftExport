<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SwiftExportColor.WindowBackground">#F6F7F9</Color>
    <Color x:Key="SwiftExportColor.Surface">#FFFFFFFF</Color>
    <Color x:Key="SwiftExportColor.SurfaceMuted">#FFF2F4F7</Color>
    <Color x:Key="SwiftExportColor.Border">#FFD7DCE3</Color>
    <Color x:Key="SwiftExportColor.TextPrimary">#FF20242A</Color>
    <Color x:Key="SwiftExportColor.TextSecondary">#FF667085</Color>
    <Color x:Key="SwiftExportColor.Accent">#FF2563EB</Color>
    <Color x:Key="SwiftExportColor.AccentHover">#FF1D4ED8</Color>
    <Color x:Key="SwiftExportColor.SuccessSoft">#FFE8F5EF</Color>
    <Color x:Key="SwiftExportColor.WarningSoft">#FFFFF6E5</Color>


    <SolidColorBrush x:Key="SwiftExportBrush.WindowBackground" Color="{StaticResource SwiftExportColor.WindowBackground}" />
    <SolidColorBrush x:Key="SwiftExportBrush.Surface" Color="{StaticResource SwiftExportColor.Surface}" />
    <SolidColorBrush x:Key="SwiftExportBrush.SurfaceMuted" Color="{StaticResource SwiftExportColor.SurfaceMuted}" />
    <SolidColorBrush x:Key="SwiftExportBrush.Border" Color="{StaticResource SwiftExportColor.Border}" />
    <SolidColorBrush x:Key="SwiftExportBrush.TextPrimary" Color="{StaticResource SwiftExportColor.TextPrimary}" />
    <SolidColorBrush x:Key="SwiftExportBrush.TextSecondary" Color="{StaticResource SwiftExportColor.TextSecondary}" />
    <SolidColorBrush x:Key="SwiftExportBrush.Accent" Color="{StaticResource SwiftExportColor.Accent}" />
    <SolidColorBrush x:Key="SwiftExportBrush.AccentHover" Color="{StaticResource SwiftExportColor.AccentHover}" />
    <SolidColorBrush x:Key="SwiftExportBrush.SuccessSoft" Color="{StaticResource SwiftExportColor.SuccessSoft}" />
    <SolidColorBrush x:Key="SwiftExportBrush.WarningSoft" Color="{StaticResource SwiftExportColor.WarningSoft}" />

    
    
    
</ResourceDictionary>
