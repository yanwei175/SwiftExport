<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:shell="clr-namespace:SwiftExportClient.Shell"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shell 页签只呈现标题；保活内容宿主位于模板内，以保留从内容到 TabControl 的原生键盘路由。 -->
    <Style x:Key="ShellHeaderOnlyTabControlStyle"
           TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto,*">
                        <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <shell:KeepAliveTabContentHost Grid.Row="1"
                                                       ItemsSource="{TemplateBinding ItemsSource}"
                                                       SelectedItem="{TemplateBinding SelectedItem}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--TabItem 样式
        这个样式负责：
        选中标签页的圆角边框
        未选中标签之间的竖线
        鼠标悬停背景
        选中标签和内容区域连成一体-->
    <Style x:Key="SwiftExportTabItemStyle"       TargetType="{x:Type TabItem}"       BasedOn="{StaticResource {x:Type TabItem}}">

        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Height" Value="35" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UserControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <Border x:Name="TabSurface"
                        Margin="0,4,0,0"
                        Padding="4,0,4,0"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8,8,0,0"
                        SnapsToDevicePixels="True">

                            <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentSource="Header"
                        RecognizesAccessKey="True" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface"
                            Property="Background"
                            Value="{DynamicResource UserLayerFillColorAltBrush}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter TargetName="TabSurface"
                            Property="Background"
                            Value="{DynamicResource UserCardBackgroundFillColorDefaultBrush}" />
                            <Setter TargetName="TabSurface"
                            Property="BorderThickness"
                            Value="1,1,1,0" />
                            <Setter TargetName="TabSurface"
                            Property="Margin"
                            Value="0,4,0,-1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>










</ResourceDictionary>
