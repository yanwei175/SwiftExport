<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!--#region  覆盖WPF-UI的默认设置 -->
    
    
    <!-- 图标 -->
    <system:Double x:Key="DefaultIconFontSize">16</system:Double>
    
    <!-- 普通控件正文 -->
    <system:Double x:Key="ControlContentThemeFontSize">12</system:Double>
    <!-- ContentControl / Button 等正文 -->
    <system:Double x:Key="ContentControlFontSize">12</system:Double>
    

    <!-- 普通控件圆角 -->
    <CornerRadius x:Key="ControlCornerRadius">4,4,4,4</CornerRadius>
    <!-- Overlay / 浮层圆角 -->
    <CornerRadius x:Key="OverlayCornerRadius">4,4,4,4</CornerRadius>
    <!-- Popup / Flyout 圆角 -->
    <CornerRadius x:Key="PopupCornerRadius">8,8,8,8</CornerRadius>
    
    
    <!-- ========================================================= -->
    <!-- TextBox / 输入控件 -->
    <!-- ========================================================= -->
    
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    
    <!-- 原来 10,8,10,7 太松 -->
    <Thickness x:Key="TextControlThemePadding">8,5,8,5</Thickness>
    
    <!-- 建议整体输入框高度控制在 30 左右 -->    
    <system:Double x:Key="TextControlThemeMinHeight">30</system:Double>
    <system:Double x:Key="TextControlThemeMinWidth">0</system:Double>
    
    <!-- ========================================================= -->
    <!-- ListView / TreeView -->
    <!-- ========================================================= -->
    <!-- ERP 左侧导航 / 列表 -->
    <system:Double x:Key="ListViewItemMinHeight">30</system:Double>
    <!-- TreeView 更紧凑一些 -->
    <system:Double x:Key="TreeViewItemMinHeight">26</system:Double>    
    <system:Double x:Key="TreeViewItemMultiSelectCheckBoxMinHeight">26</system:Double>    
    <system:Double x:Key="TreeViewItemPresenterMargin">0</system:Double>    
    <system:Double x:Key="TreeViewItemPresenterPadding">0</system:Double>


    <!-- ========================================================= -->
    <!-- DatePicker / TimePicker -->
    <!-- ========================================================= -->
    
    <Thickness x:Key="TimePickerHostPadding">0,1,0,1</Thickness>
    <Thickness x:Key="DatePickerHostPadding">0,1,0,1</Thickness>
    <Thickness x:Key="DatePickerHostMonthPadding">8,0,0,1</Thickness>

    <!-- ========================================================= -->
    <!-- ComboBox -->
    <!-- ========================================================= -->
    <!-- Editable ComboBox 左右留白 -->
    <Thickness x:Key="ComboBoxEditableTextPadding">8,0,28,0</Thickness>
    <system:Double x:Key="ComboBoxMinHeight">30</system:Double>
    <!-- 原来 12,1,0,3 有点奇怪，ERP 可以更规整 -->
    <Thickness x:Key="ComboBoxPadding">8,2,0,2</Thickness>

    <!-- ========================================================= -->
    <!-- NavigationView -->
    <!-- ========================================================= -->
    <system:Double x:Key="NavigationViewItemOnLeftMinHeight">32</system:Double>
    
    <!--#endregion -->

    <!--#region 自定义设置 -->
    
    <CornerRadius x:Key="SwiftExportCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SwiftExportControlCornerRadius">4</CornerRadius>

    <Thickness x:Key="SwiftExportShellPadding">24</Thickness>
    <Thickness x:Key="SwiftExportControlPadding">12,7</Thickness>
    <Thickness x:Key="SwiftExportCellPadding">8,4</Thickness>
    <Thickness x:Key="SwiftExportDataGridHeaderPadding">8,8</Thickness>
    <Thickness x:Key="SwiftExportDataGridCellPadding">0,0</Thickness>
    <Thickness x:Key="SwiftExportDataGridValidationBorderThickness">0,0,0,2</Thickness>
    <Thickness x:Key="SwiftExportDataGridCurrentCellBorderThickness">1</Thickness>

    <Thickness x:Key="SwiftExportBorderThickness">1</Thickness>

    <system:Double x:Key="SwiftExportControlHeight">30</system:Double>

    <system:Double x:Key="SwiftExportDefaltFontSize">12</system:Double>

    <system:Double x:Key="SwiftExport.LookUpTextBoxFontSize">12</system:Double>
    <system:Double x:Key="SwiftExport.LookUpTextBoxFontSizeInTitle">12</system:Double>

    <system:Double x:Key="DataGridRowHeightSmall">35</system:Double>
    <system:Double x:Key="DataGridRowHeightMedium">60</system:Double>

    <Thickness x:Key="PagePadding">32</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,24</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,16</Thickness>
    <Thickness x:Key="CompactFieldMargin">0,0,0,12</Thickness>
    <Thickness x:Key="ButtonGroupMargin">0,24,0,0</Thickness>
    <Thickness x:Key="BetweenUIControlsAndLabel">0,0,8,0</Thickness>

    <Thickness x:Key="SwiftExportStackGap">0,0,0,12</Thickness>
    <Thickness x:Key="SwiftExportSectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="SwiftExportShellNavPadding">12</Thickness>
    <Thickness x:Key="SwiftExportShellNavItemMargin">0,0,0,8</Thickness>
    <Thickness x:Key="SwiftExportShellNavChildMargin">16,0,0,8</Thickness>
    <Thickness x:Key="SwiftExportWorkspaceMargin">16</Thickness>

    <system:Double x:Key="Space4">4</system:Double>
    <system:Double x:Key="Space8">8</system:Double>
    <system:Double x:Key="Space12">12</system:Double>
    <system:Double x:Key="Space16">16</system:Double>
    <system:Double x:Key="Space24">24</system:Double>
    <system:Double x:Key="Space32">32</system:Double>
    <system:Double x:Key="Space48">48</system:Double>

    <!--#endregion-->
    
    
</ResourceDictionary>