<UserControl x:Class="SwiftExportClient.Resources.Controls.RightDrawerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             KeyDown="OnKeyDown">
    <Grid x:Name="LayoutRoot" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DrawerColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <ContentPresenter x:Name="MainPresenter"
                          Grid.Column="0"
                          Content="{Binding MainContent, ElementName=Root}"
                          ContentTemplate="{Binding MainContentTemplate, ElementName=Root}" />

        <Border x:Name="DrawerBorder"
                Grid.Column="1"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                Margin="0,4,4,4"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <primitives:Thumb x:Name="ResizeThumb"
                                  Grid.Column="0"
                                  Cursor="SizeWE"
                                  Background="Transparent"
                                  ToolTip="拖动调整宽度"
                                  DragDelta="OnResizeThumbDragDelta" />
                <ContentPresenter Grid.Column="1"
                                  Content="{Binding DrawerContent, ElementName=Root}"
                                  ContentTemplate="{Binding DrawerContentTemplate, ElementName=Root}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
