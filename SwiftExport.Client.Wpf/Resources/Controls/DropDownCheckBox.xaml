<UserControl x:Class="SwiftExportClient.Resources.Controls.DropDownCheckBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinHeight="32">
    <Grid>
        <Button x:Name="DropDownButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="8,4"
                Click="DropDownButton_Click"
                PreviewMouseLeftButtonDown="DropDownButton_PreviewMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding SelectionText, ElementName=Root}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectionText, ElementName=Root}" />
                <ui:SymbolIcon Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Symbol="ChevronDown20" />
            </Grid>
        </Button>

        <Popup x:Name="DropDownPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=DropDownButton}"
               Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PopupAnimation="Fade"
               Opened="DropDownPopup_Opened"
               Closed="DropDownPopup_Closed">
            <Border x:Name="PopupSurface"
                    MinWidth="{Binding ActualWidth, ElementName=DropDownButton}"
                    MaxHeight="{Binding MaxDropDownHeight, ElementName=Root}"
                    Margin="0,4,0,0"
                    Padding="4"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{DynamicResource SwiftExportBorderThickness}"
                    CornerRadius="{DynamicResource SwiftExportControlCornerRadius}"
                    PreviewKeyDown="PopupSurface_PreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.16"
                                      Color="Black" />
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <StackPanel x:Name="ClearOptionPanel"
                                DockPanel.Dock="Top">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowClearOption, ElementName=Root}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button x:Name="ClearSelectionButton"
                                Margin="4,2"
                                Padding="8,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Content="清空选择"
                                ToolTip="清空全部已选项"
                                AutomationProperties.Name="清空选择"
                                Click="ClearSelectionButton_Click" />
                        <Separator Margin="4,2" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl x:Name="OptionItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="4,3"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Content="{Binding DisplayText}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
