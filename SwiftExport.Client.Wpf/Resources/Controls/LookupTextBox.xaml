<UserControl x:Class="SwiftExportClient.Resources.Controls.LookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             MinHeight="30">
    <UserControl.Resources>
        <!--
            LookupTextBox 由外层统一提供边框和清除按钮。
            内部输入框只保留 WPF TextBox 必需的 PART_ContentHost，避免 Fluent
            默认模板在聚焦且有文本时再生成一个 ClearButton。
        -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- 与紧凑 DataGrid 编辑器保持相同布局，但不依赖页面级命名资源。 -->
        <Style x:Key="LookupInputBaseStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBoxBase}}">
            <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}"/>
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2,0,0,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        </Style>
        <Style x:Key="LookupInputTextBoxStyle"
               TargetType="{x:Type TextBox}" BasedOn="{StaticResource LookupInputBaseStyle}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,1" />
            <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        </Style>

        <Style x:Key="LookupEditorBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border x:Name="EditorBorder"
                Height="{Binding ActualHeight, ElementName=Root}"
                Style="{DynamicResource LookupEditorBorderStyle}"
                MinHeight="30"
                Padding="0"
                MouseLeftButtonDown="EditorBorder_MouseLeftButtonDown">
            <Grid>
                <TextBox x:Name="InputTextBox"
                         Style="{StaticResource LookupInputTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         TextChanged="InputTextBox_TextChanged"
                         GotKeyboardFocus="InputTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="InputTextBox_LostKeyboardFocus"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                <Border x:Name="DisplayTextBlockBorder"
                        Height="{Binding ActualHeight, ElementName=Root}"
                        Style="{DynamicResource LookupEditorBorderStyle}"
                        BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
                        BorderThickness="{DynamicResource TextBoxBorderThemeThickness}"
                        Visibility="{Binding ElementName=DisplayTextBlock, Path=Visibility}">
                    <TextBlock x:Name="DisplayTextBlock"
                           Margin="14,0,0,0"
                           Padding="0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />
                </Border>


                <TextBlock x:Name="PlaceholderTextBlock"
                           Margin="14,0,0,0"
                           Padding="0,0"
                           FontSize="{DynamicResource ControlContentThemeFontSize}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}" />

                <ui:Button x:Name="BtnClear"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="{DynamicResource TextBoxClearButtonHeight}"
                        MinHeight="{DynamicResource TextBoxClearButtonHeight}"
                        Margin="{DynamicResource TextBoxClearButtonMargin}"
                        Padding="{DynamicResource TextBoxClearButtonPadding}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Appearance="Secondary"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Cursor="Arrow"
                        Foreground="{DynamicResource TextControlButtonForeground}"
                        IsTabStop="False"
                        MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                        PressedBorderBrush="Transparent"
                        Content="{ui:SymbolIcon Symbol=Dismiss24}"
                        ToolTip="清除"
                        AutomationProperties.Name="清除当前输入和选择"
                        Visibility="{Binding HasTextOrSelection, ElementName=Root,Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="BtnClear_Click">
                </ui:Button>

                <ProgressBar Height="2"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}"
                               BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Popup x:Name="DropdownPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=EditorBorder}"
               Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PopupAnimation="Fade">
            <Border MinWidth="{Binding ActualWidth, ElementName=EditorBorder}"
                    MaxHeight="260"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{DynamicResource SwiftExportBorderThickness}"
                    CornerRadius="{DynamicResource SwiftExportControlCornerRadius}"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.16"
                                      Color="Black" />
                </Border.Effect>

                    <ListBox x:Name="ResultList"
                             BorderThickness="0"
                             FontSize="{StaticResource SwiftExportDefaltFontSize}"
                             Background="White"
                             Focusable="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
