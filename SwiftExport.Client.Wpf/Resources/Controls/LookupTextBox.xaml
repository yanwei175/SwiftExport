<UserControl x:Class="SwiftExportClient.Resources.Controls.LookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontSize="{DynamicResource ContentControlFontSize}"
             mc:Ignorable="d" d:DesignHeight="30" d:DesignWidth="120"
             x:Name="Root" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ListBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--
            LookupTextBox 由外层统一提供边框和清除按钮。
            内部输入框只保留 WPF TextBox 必需的 PART_ContentHost，避免 Fluent
            默认模板在聚焦且有文本时再生成一个 ClearButton。
        -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <!-- 与紧凑 DataGrid 编辑器保持相同布局，但不依赖页面级命名资源。 -->
            <Style x:Key="LookupInputBaseStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            </Style>

            <Style x:Key="LookupInputTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource LookupInputBaseStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
                <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowDropDownButton, ElementName=Root}" Value="True">
                        <Setter Property="Padding" Value="8,5,28,5" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LookupOverlayTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{Binding FontSize, ElementName=Root}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowDropDownButton, ElementName=Root}" Value="True">
                        <Setter Property="Margin" Value="2,0,28,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LookupEditorBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UserControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--主Border-->
        <Border x:Name="EditorBorder" MouseLeftButtonDown="EditorBorder_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource LookupEditorBorderStyle}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StretchToHost, ElementName=Root}" Value="True">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                <!--输入TextBox-->
                <TextBox x:Name="InputTextBox"
                         FontSize="{Binding FontSize, ElementName=Root}"
                         VerticalContentAlignment="Center"
                         TextChanged="InputTextBox_TextChanged"
                         GotKeyboardFocus="InputTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="InputTextBox_LostKeyboardFocus"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown" >
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource LookupInputTextBoxStyle}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StretchToHost, ElementName=Root}" Value="True">
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!--选中候选后显示-->
                <Grid>                    
                    <Border x:Name="DisplayTextBlockBorder"
                            Style="{DynamicResource LookupEditorBorderStyle}"
                            Padding="{DynamicResource TextControlThemePadding}"
                            BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
                            BorderThickness="{DynamicResource TextBoxBorderThemeThickness}"
                            Visibility="{Binding ElementName=DisplayTextBlock, Path=Visibility}">
                        <TextBlock x:Name="DisplayTextBlock"
                                   Style="{StaticResource LookupOverlayTextStyle}"
                                   FontSize="{DynamicResource ContentControlFontSize}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />
                    </Border>
                    
                    <TextBox Panel.ZIndex="0" x:Name="SyncSizeTextBox" Visibility="Hidden" IsEnabled="False" IsReadOnly="True"/>
                </Grid>


                <!--PlaceHoder-->
                <TextBlock x:Name="PlaceholderTextBlock"
                           Style="{StaticResource LookupOverlayTextStyle}"
                           Padding="{DynamicResource TextControlThemePadding}"
                           FontSize="{DynamicResource ContentControlFontSize}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button x:Name="BtnClear"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                MinWidth="{DynamicResource TextBoxClearButtonHeight}"
                                Margin="0"
                                Padding="{DynamicResource TextControlThemePadding}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Appearance="Secondary"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Cursor="Arrow"
                                Foreground="{DynamicResource TextControlButtonForeground}"
                                IsTabStop="False"
                                MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                                MouseOverBorderBrush="Transparent"
                                PressedBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                                PressedBorderBrush="Transparent"
                                Content="{ui:SymbolIcon Symbol=Dismiss24}"
                                ToolTip="清除"
                                AutomationProperties.Name="清除当前输入和选择"
                                Visibility="{Binding HasTextOrSelection, ElementName=Root,Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="BtnClear_Click" />

                    <ui:Button x:Name="BtnDropDown"
                               MinWidth="{DynamicResource TextBoxClearButtonHeight}"
                               Margin="0"
                               Padding="{DynamicResource TextControlThemePadding}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Appearance="Secondary"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               BorderThickness="0"
                               Cursor="Arrow"
                               Focusable="False"
                               Foreground="{DynamicResource TextControlButtonForeground}"
                               IsTabStop="False"
                               MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                               MouseOverBorderBrush="Transparent"
                               PressedBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                               PressedBorderBrush="Transparent"
                               ToolTip="展开候选"
                               AutomationProperties.Name="展开或收起候选"
                               Visibility="{Binding ShowDropDownButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                               PreviewMouseLeftButtonDown="BtnDropDown_PreviewMouseLeftButtonDown"
                               Click="BtnDropDown_Click">
                        <ui:SymbolIcon Symbol="ChevronDown20" />
                    </ui:Button>
                </StackPanel>

                <ProgressBar Height="2" Margin="0"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
            
        </Border>

        <!--候选列表-->
        <Popup x:Name="DropdownPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=EditorBorder}"
               Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PopupAnimation="Fade"
               Closed="DropdownPopup_Closed">
            <Border MinWidth="{Binding ActualWidth, ElementName=EditorBorder}"
                    MaxHeight="260"
                    Style="{StaticResource LookupEditorBorderStyle}"
                    Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                    BorderThickness="{DynamicResource SwiftExportBorderThickness}"
                    CornerRadius="4"
                    Padding="6"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4"
                                      ShadowDepth="1"
                                      Opacity="0.16"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <ListBox x:Name="ResultList"
                             BorderThickness="0"
                             FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                             Background="Transparent"
                             Focusable="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SwiftExportListBoxItemStyle}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UserLayerFillColorAltBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <ContentPresenter x:Name="CustomDropDownPresenter"
                                      Content="{Binding CustomDropDownContent, ElementName=Root}"
                                      Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
