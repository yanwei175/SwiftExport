<UserControl x:Class="SwiftExportClient.Controls.LookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="30">
    <UserControl.Resources>
        <!--
            LookupTextBox 由外层统一提供边框和清除按钮。
            内部输入框只保留 WPF TextBox 必需的 PART_ContentHost，避免 Fluent
            默认模板在聚焦且有文本时再生成一个 ClearButton。
        -->
        <Style x:Key="LookupInputTextBoxStyle"
               TargetType="{x:Type TextBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="EditorBorder"
                Height="{Binding ActualHeight, ElementName=Root}"
                MinHeight="30"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="{DynamicResource SwiftExportBorderThickness}"
                CornerRadius="{DynamicResource SwiftExportControlCornerRadius}"
                MouseLeftButtonDown="EditorBorder_MouseLeftButtonDown">
            <Grid>
                <TextBox x:Name="InputTextBox"
                         Style="{StaticResource LookupInputTextBoxStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="4,0,32,0"
                         VerticalContentAlignment="Center"
                         TextChanged="InputTextBox_TextChanged"
                         GotKeyboardFocus="InputTextBox_GotKeyboardFocus"
                         LostKeyboardFocus="InputTextBox_LostKeyboardFocus"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />

                <TextBlock x:Name="DisplayTextBlock"
                           Margin="4,0,32,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />

                <TextBlock x:Name="PlaceholderTextBlock"
                           Margin="8,0,32,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}" />

                <Button x:Name="BtnClear"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Width="24"
                        MinHeight="24"
                        Focusable="False"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Content="x"
                        ToolTip="清除"
                        AutomationProperties.Name="清除当前输入和选择"
                        Click="BtnClear_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTextOrSelection, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ProgressBar Height="2"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}"
                               BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Popup x:Name="DropdownPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=EditorBorder}"
               Placement="Bottom"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               PopupAnimation="Fade">
            <Border MinWidth="{Binding ActualWidth, ElementName=EditorBorder}"
                    MaxHeight="260"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{DynamicResource SwiftExportBorderThickness}"
                    CornerRadius="{DynamicResource SwiftExportControlCornerRadius}"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.16"
                                      Color="Black" />
                </Border.Effect>

                <ScrollViewer CanContentScroll="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="ResultList"
                             BorderThickness="0"
                             Focusable="False"
                             PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
