<UserControl x:Class="SwiftExportClient.Controls.PopupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="30">
    <Grid>
        <Border x:Name="EditorBorder"
                Height="{Binding ActualHeight, ElementName=Root}"
                MinHeight="30"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="{StaticResource SwiftExportBorderThickness}"
                CornerRadius="{StaticResource SwiftExportControlCornerRadius}"
                MouseLeftButtonDown="EditorBorder_MouseLeftButtonDown">
            <Grid>
                <TextBox x:Name="CompactTextBox"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,0"
                         IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                         MaxLength="{Binding MaxLength, ElementName=Root}"
                         VerticalContentAlignment="Center"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="CompactTextBox_GotKeyboardFocus"
                         PreviewKeyDown="CompactTextBox_PreviewKeyDown" />

                <TextBlock x:Name="PreviewTextBlock"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Text="{Binding Text, ElementName=Root}"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="PlaceholderTextBlock"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}" />
            </Grid>
        </Border>

        <Popup x:Name="EditorPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=EditorBorder}"
               Placement="Bottom"
               IsOpen="{Binding IsPopupOpen, ElementName=Root, Mode=TwoWay}"
               PopupAnimation="Fade"
               Closed="EditorPopup_Closed"
               Opened="EditorPopup_Opened">
            <Border MinWidth="{Binding ActualWidth, ElementName=EditorBorder}"
                    Width="{Binding ResolvedPopupWidth, ElementName=Root}"
                    Height="{Binding PopupHeight, ElementName=Root}"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    CornerRadius="{StaticResource SwiftExportControlCornerRadius}"
                    Margin="0,4,0,0"
                    Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.16"
                                      Color="Black" />
                </Border.Effect>

                <TextBox x:Name="PopupEditorTextBox"
                         AcceptsReturn="True"
                         IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                         MaxLength="{Binding MaxLength, ElementName=Root}"
                         Padding="8"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="PopupEditorTextBox_PreviewKeyDown" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
