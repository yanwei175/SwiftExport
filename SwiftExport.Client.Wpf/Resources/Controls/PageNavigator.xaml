<UserControl x:Class="SwiftExportClient.Controls.PageNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="34">
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">
        <TextBlock Text="共"
                   Style="{StaticResource SecondaryTextBlock}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalCount, ElementName=Root, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextBlock}"
                   VerticalAlignment="Center"
                   Margin="4,0,4,0" />
        <TextBlock Text="条"
                   Style="{StaticResource SecondaryTextBlock}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0" />

        <Rectangle Width="1"
                   Height="16"
                   Fill="{DynamicResource SwiftExportBrush.Border}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0" />

        <TextBlock Text="每页"
                   Style="{StaticResource SecondaryTextBlock}"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="CboPageSize"
                  ItemsSource="{Binding PageSizeOptions, ElementName=Root, Mode=OneWay}"
                  SelectionChanged="CboPageSize_SelectionChanged"
                  Width="72"
                  MinHeight="{StaticResource SwiftExportControlHeight}"
                  Padding="8,4"
                  Margin="8,0" />
        <TextBlock Text="条"
                   Style="{StaticResource SecondaryTextBlock}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0" />

        <ItemsControl ItemsSource="{Binding PageItems, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding DisplayText}"
                            IsEnabled="{Binding IsClickable}"
                            Click="BtnPage_Click"
                            MinWidth="36"
                            MinHeight="{StaticResource SwiftExportControlHeight}"
                            Padding="8,4"
                            Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
