<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <ToolTip x:Key="SwiftExportCachedImageToolTip"
             x:Shared="False"
             Placement="Mouse"
             Padding="0"
             HasDropShadow="True">
        <Border Padding="4"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <controls:CachedImage MaxWidth="500"
                                  MaxHeight="500"
                                  DecodePixelWidth="400"
                                  Stretch="Uniform"
                                  SourcePath="{Binding PlacementTarget.SourcePath, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}" />
        </Border>
    </ToolTip>

    <!-- 命名样式避免覆盖普通 Image；适用于列表和 DataGrid 中的紧凑缩略图。 -->
    <Style x:Key="SwiftExportCachedImage"
           TargetType="{x:Type controls:CachedImage}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="DecodePixelWidth" Value="96" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ToolTip" Value="{StaticResource SwiftExportCachedImageToolTip}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Style.Triggers>
            <Trigger Property="SourcePath" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </Trigger>
            <Trigger Property="SourcePath" Value="{x:Null}">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
