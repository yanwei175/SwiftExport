<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <!-- 命名样式避免覆盖普通 Image；适用于列表和 DataGrid 中的紧凑缩略图。 -->
    <Style x:Key="SwiftExportCachedImage"
           TargetType="{x:Type controls:CachedImage}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="DecodePixelWidth" Value="96" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
</ResourceDictionary>
