<Application x:Class="SwiftExportClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--2026/09/02日,取消合并微软的PresentationFramework.Fluent,因为合并它与WPF-UI有些冲突,-->
                <!--<ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />-->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/UserWpfUiThemeResources.xaml" />
                <ResourceDictionary Source="Resources/Variables.xaml" />
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Grids.xaml" />
                <ResourceDictionary Source="Resources/Borders.xaml" />
                <ResourceDictionary Source="Resources/Button.xaml" />
                <ResourceDictionary Source="Resources/ContextMenu.xaml" />
                <ResourceDictionary Source="Resources/DatePicker.xaml" />
                <ResourceDictionary Source="Resources/DataGrid.xaml" />
                <ResourceDictionary Source="Resources/Image.xaml" />
                <ResourceDictionary Source="Resources/TabControl.xaml" />
                <ResourceDictionary Source="Resources/ListBox.xaml" />
                
                <ResourceDictionary Source="Features/Home/页面模板.xaml" />
                <ResourceDictionary Source="Features/Products/页面模板.xaml" />
                <ResourceDictionary Source="Features/Customers/页面模板.xaml" />
                <ResourceDictionary Source="Features/Suppliers/页面模板.xaml" />
                <ResourceDictionary Source="Features/Sales/页面模板.xaml" />
                <ResourceDictionary Source="Features/DemandPlanning/页面模板.xaml" />
                <ResourceDictionary Source="Features/Procurement/页面模板.xaml" />
                <ResourceDictionary Source="Features/QualityControl/页面模板.xaml" />
                <ResourceDictionary Source="Features/Inventory/页面模板.xaml" />
                <ResourceDictionary Source="Features/Shipping/页面模板.xaml" />
                <ResourceDictionary Source="Features/Planning/页面模板.xaml" />
                <ResourceDictionary Source="Features/SystemSettings/页面模板.xaml" />
                
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
            <converters:FirstValidationErrorConverter x:Key="FirstValidationErrorConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IsIntegerConverter x:Key="IsIntegerConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
