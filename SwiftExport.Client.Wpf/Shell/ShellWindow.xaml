<ui:FluentWindow x:Class="SwiftExportClient.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:home="clr-namespace:SwiftExportClient.Features.Home"
        xmlns:customerViews="clr-namespace:SwiftExportClient.Features.Customers.CustomerManagement.Views"
        xmlns:customerViewModels="clr-namespace:SwiftExportClient.Features.Customers.CustomerManagement.ViewModels"
        xmlns:customerProductViews="clr-namespace:SwiftExportClient.Features.Customers.CustomerProducts.Views"
        xmlns:customerProductViewModels="clr-namespace:SwiftExportClient.Features.Customers.CustomerProducts.ViewModels"
        xmlns:grossDemandViews="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.Views"
        xmlns:grossDemandViewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
        xmlns:netDemandViews="clr-namespace:SwiftExportClient.Features.DemandPlanning.NetDemand.Views"
        xmlns:netDemandViewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.NetDemand.ViewModels"
        xmlns:inventoryWarehouseViews="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Views"
        xmlns:inventoryWarehouseViewModels="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.ViewModels"
        xmlns:inventoryBalanceViews="clr-namespace:SwiftExportClient.Features.Inventory.Balances.Views"
        xmlns:inventoryBalanceViewModels="clr-namespace:SwiftExportClient.Features.Inventory.Balances.ViewModels"
        xmlns:inventoryLedgerViews="clr-namespace:SwiftExportClient.Features.Inventory.Ledger.Views"
        xmlns:inventoryLedgerViewModels="clr-namespace:SwiftExportClient.Features.Inventory.Ledger.ViewModels"
        xmlns:inboundViews="clr-namespace:SwiftExportClient.Features.Inventory.Inbounds.Views"
        xmlns:inboundViewModels="clr-namespace:SwiftExportClient.Features.Inventory.Inbounds.ViewModels"
        xmlns:outboundViews="clr-namespace:SwiftExportClient.Features.Inventory.Outbounds.Views"
        xmlns:outboundViewModels="clr-namespace:SwiftExportClient.Features.Inventory.Outbounds.ViewModels"
        xmlns:packingViews="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.Views"
        xmlns:packingViewModels="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.ViewModels"
        xmlns:planning="clr-namespace:SwiftExportClient.Features.Planning"
        xmlns:productCategoryViews="clr-namespace:SwiftExportClient.Features.Products.Categories.Views"
        xmlns:productCategoryViewModels="clr-namespace:SwiftExportClient.Features.Products.Categories.ViewModels"
        xmlns:productColorViews="clr-namespace:SwiftExportClient.Features.Products.Colors.Views"
        xmlns:productColorViewModels="clr-namespace:SwiftExportClient.Features.Products.Colors.ViewModels"
        xmlns:productListViews="clr-namespace:SwiftExportClient.Features.Products.ProductList.Views"
        xmlns:productListViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
        xmlns:procurementViews="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Views"
        xmlns:procurementViewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
        xmlns:productPlaceholderViews="clr-namespace:SwiftExportClient.Features.Products.Placeholders.Views"
        xmlns:productPlaceholderViewModels="clr-namespace:SwiftExportClient.Features.Products.Placeholders.ViewModels"
        xmlns:supplierViews="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierManagement.Views"
        xmlns:supplierViewModels="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierManagement.ViewModels"
        xmlns:supplierProductViews="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierProducts.Views"
        xmlns:supplierProductViewModels="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierProducts.ViewModels"
        xmlns:sales="clr-namespace:SwiftExportClient.Features.Sales"
        xmlns:salesOrderViews="clr-namespace:SwiftExportClient.Features.Sales.Orders.Views"
        xmlns:salesOrderViewModels="clr-namespace:SwiftExportClient.Features.Sales.Orders.ViewModels"
        xmlns:settingsViews="clr-namespace:SwiftExportClient.Features.SystemSettings.SettingsCenter.Views"
        xmlns:settingsViewModels="clr-namespace:SwiftExportClient.Features.SystemSettings.SettingsCenter.ViewModels"
        xmlns:uiServices="clr-namespace:SwiftExportClient.Services.UI"
        xmlns:shell="clr-namespace:SwiftExportClient.Shell"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1920"
        Height="1080"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shell:ShellNavigationItemsConverter x:Key="ShellNavigationItemsConverter" />
        <shell:RouteSelectionConverter x:Key="RouteSelectionConverter" />

        <Style x:Key="ShellStatusMessageIconStyle"
               TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="Symbol" Value="Info24" />
            <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.Accent}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Success}">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.RowStateAdded}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Warning}">
                    <Setter Property="Symbol" Value="Warning24" />
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.RowStateModified}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Error}">
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellStatusMessageTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CaptionTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.RowStateAdded}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.RowStateModified}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productListViewModels:ProductsViewModel}">
            <productListViews:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productListViewModels:ProductMasterManagerViewModel}">
            <productListViews:ProductMasterManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productListViewModels:ProductMasterDetailViewModel}">
            <productListViews:ProductMasterDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productCategoryViewModels:ProductCategoryManagerViewModel}">
            <productCategoryViews:ProductCategoryManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productColorViewModels:ProductColorsViewModel}">
            <productColorViews:ProductColorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productPlaceholderViewModels:ProductBomViewModel}">
            <productPlaceholderViews:ProductPlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customerViewModels:CustomerManagerViewModel}">
            <customerViews:CustomerManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customerProductViewModels:CustomerProductWorkspaceViewModel}">
            <customerProductViews:CustomerProductWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type supplierViewModels:SupplierManagerViewModel}">
            <supplierViews:SupplierManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type supplierProductViewModels:SupplierProductWorkspaceViewModel}">
            <supplierProductViews:SupplierProductWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <sales:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type salesOrderViewModels:SalesOrderManagerViewModel}">
            <salesOrderViews:SalesOrderManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type salesOrderViewModels:SalesOrderDetailViewModel}">
            <salesOrderViews:SalesOrderDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type grossDemandViewModels:GrossDemandWorkspaceViewModel}">
            <grossDemandViews:GrossDemandWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type netDemandViewModels:NetDemandWorkspaceViewModel}">
            <netDemandViews:NetDemandWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type procurementViewModels:PurchaseOrderManagerViewModel}">
            <procurementViews:PurchaseOrderManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type procurementViewModels:PurchaseOrderProgressWorkspaceViewModel}">
            <procurementViews:PurchaseOrderProgressWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type procurementViewModels:PurchaseOrderDetailViewModel}">
            <procurementViews:PurchaseOrderDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventoryWarehouseViewModels:WarehouseSitesViewModel}">
            <inventoryWarehouseViews:WarehouseSitesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventoryBalanceViewModels:InventoryBalancesViewModel}">
            <inventoryBalanceViews:InventoryBalancesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventoryLedgerViewModels:InventoryLedgerViewModel}">
            <inventoryLedgerViews:InventoryLedgerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type inboundViewModels:InboundWorkspaceViewModel}">
            <inboundViews:InboundWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type outboundViewModels:OutboundWorkspaceViewModel}">
            <outboundViews:OutboundWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type packingViewModels:PackingListWorkspaceViewModel}">
            <packingViews:PackingListWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type packingViewModels:PackingListDetailViewModel}">
            <packingViews:PackingListDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type planning:PlanningViewModel}">
            <planning:PlanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsViewModels:SettingsCenterViewModel}">
            <settingsViews:SettingsCenterView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid RowDefinitions="Auto,*">

            <ui:TitleBar Grid.Row="0"
                         Title="{Binding Title}"
                         ShowHelp="False"
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True"
                         Padding="16,0,0,0">
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="退出登录"
                                Command="{Binding LogoutCommand}"
                                MinWidth="88"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <ui:NavigationView Grid.Column="0"
                                   MenuItemsSource="{Binding FilteredMenuItems, Converter={StaticResource ShellNavigationItemsConverter}}"
                                   IsPaneOpen="{Binding IsNavigationPaneExpanded, Mode=TwoWay}"
                                   IsPaneToggleVisible="True"
                                   IsPaneVisible="True"
                                   IsBackButtonVisible="Collapsed"
                                   IsTopSeparatorVisible="False"
                                   IsFooterSeparatorVisible="True"
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="200"
                                   CompactPaneLength="40"
                                   HeaderVisibility="Collapsed"
                                   AlwaysShowHeader="False"
                                   Background="Transparent">
                    <ui:NavigationView.Style>
                        <Style TargetType="{x:Type ui:NavigationView}" BasedOn="{StaticResource {x:Type ui:NavigationView}}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsPaneOpen" Value="False">
                                    <Setter Property="Width" Value="40" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:NavigationView.Style>

                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem Content="设置"
                                               Command="{Binding OpenSettingsCommand}">
                            <ui:NavigationViewItem.Style>
                                <Style TargetType="{x:Type ui:NavigationViewItem}"
                                       BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRouteKey}" Value="settings-center">
                                            <Setter Property="IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:NavigationViewItem.Style>
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Settings24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <Grid Grid.Column="1" RowDefinitions="*,32">
                    <Border
                        Margin="0"
                        Background="{DynamicResource MicaControlBrush}"
                        BorderBrush="{DynamicResource SubFillColorSecondaryBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="4,0,0,0">
                        <TabControl ItemsSource="{Binding OpenTabs}"
                                Style="{StaticResource {x:Type TabControl}}"
                                Margin="8,8,0,4"
                                Padding="0,8,0,8"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                            <!-- 控制整个页签 TabItem 的 Margin -->
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="{x:Type TabItem}"  BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="MinWidth" Value="100" />
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,0">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"  HorizontalAlignment="Center" Margin="0,0,0,0" />
                                            <TextBlock Text="*"
                                               Margin="2,0,0,0"
                                               Foreground="{DynamicResource SwiftExportBrush.Accent}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ui:Button DockPanel.Dock="Right"
                                               Style="{StaticResource SwiftExportTabCloseButton}"
                                               Margin="4,0,-10,0"
                                            Content="{ui:SymbolIcon Symbol=Dismiss28}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding ContentViewModel}"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>

                    <Border Grid.Row="2" 
                            Height="32"
                            Background="{DynamicResource MicaControlBrush}"
                            Padding="16,0,8,0"
                            BorderBrush="{DynamicResource SubFillColorSecondaryBrush}"
                            BorderThickness="1,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="{Binding CurrentPageStatus}"
                               Style="{StaticResource CaptionTextBlock}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                            <Border Grid.Column="1"
                            Width="1"
                            Height="16"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SwiftExportBrush.Border}"
                            Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid Grid.Column="2"
                          MinWidth="0"
                          Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                       Margin="0,0,6,0"
                                       Style="{StaticResource ShellStatusMessageIconStyle}" />
                                <TextBlock Grid.Column="1"
                                   Text="{Binding StatusDisplayText}"
                                   ToolTip="{Binding StatusDisplayText}"
                                   Style="{StaticResource ShellStatusMessageTextStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <ui:Button Grid.Column="3"
                               Style="{StaticResource SwiftExportTabCloseButton}"
                               Content="{ui:SymbolIcon Symbol=Dismiss20}"
                               Command="{Binding DismissStatusMessageCommand}"
                               ToolTip="关闭状态消息"
                               Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" d:IsHidden="True" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="24,24,24,48" d:IsHidden="True" />
    </Grid>
</ui:FluentWindow>
