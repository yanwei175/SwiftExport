<ui:FluentWindow x:Class="SwiftExportClient.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:uiServices="clr-namespace:SwiftExportClient.Services.UI"
        xmlns:shell="clr-namespace:SwiftExportClient.Shell"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1920"
        Height="1080"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shell:ShellNavigationItemsConverter x:Key="ShellNavigationItemsConverter" />
        <shell:RouteSelectionConverter x:Key="RouteSelectionConverter" />
        
        <Style x:Key="ShellStatusMessageIconStyle"
               TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="Symbol" Value="Info24" />
            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Success}">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Warning}">
                    <Setter Property="Symbol" Value="Warning24" />
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Error}">
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellStatusMessageTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CaptionTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}"
                             Value="{x:Static uiServices:UiMessageSeverity.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*">

            <ui:TitleBar Grid.Row="0"
                         Title="{Binding Title}"
                         ShowHelp="False"
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True"
                         Padding="16,0,0,0">
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="退出登录"
                                Command="{Binding LogoutCommand}"
                                MinWidth="88"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <ui:NavigationView Grid.Column="0" 
                                   IsPaneOpen="{Binding IsNavigationPaneExpanded, Mode=TwoWay}"
                                   IsPaneToggleVisible="True"
                                   IsPaneVisible="True"
                                   IsBackButtonVisible="Collapsed"
                                   IsTopSeparatorVisible="False"
                                   IsFooterSeparatorVisible="True"                                   
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="200"
                                   CompactPaneLength="40"
                                   HeaderVisibility="Collapsed"
                                   AlwaysShowHeader="False">
                    <ui:NavigationView.MenuItemsSource>
                        <MultiBinding Converter="{StaticResource ShellNavigationItemsConverter}">
                            <Binding Path="FilteredMenuItems" />
                            <Binding />
                        </MultiBinding>
                    </ui:NavigationView.MenuItemsSource>
                    <ui:NavigationView.Style>
                        <Style TargetType="{x:Type ui:NavigationView}" BasedOn="{StaticResource {x:Type ui:NavigationView}}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsPaneOpen" Value="False">
                                    <Setter Property="Width" Value="40" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:NavigationView.Style>

                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem Content="设置"
                                               Command="{Binding OpenSettingsCommand}">
                            <ui:NavigationViewItem.Style>
                                <Style TargetType="{x:Type ui:NavigationViewItem}"
                                       BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRouteKey}" Value="settings-center">
                                            <Setter Property="IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:NavigationViewItem.Style>
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Settings24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <Grid Grid.Column="1" RowDefinitions="*,32" Margin="0,0,0,0">
                    <Border Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource UserSubtleFillColorSecondaryBrush}"
                            BorderThickness="1,1,0,0"
                            CornerRadius="8,0,0,0">
                        <TabControl ItemsSource="{Binding OpenTabs}"
                                Style="{StaticResource ShellHeaderOnlyTabControlStyle}"
                                Margin="8"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                            
                            <!-- 控制整个页签 TabItem -->
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="{x:Type TabItem}"  BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="MaxWidth" Value="180"/>
                                    <Setter Property="MinWidth" Value="80"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource UserControlAltFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <DockPanel LastChildFill="False">                                            
                                            <ui:Button DockPanel.Dock="Left" 
                                                       Style="{StaticResource SwiftExportTabCloseButton}"
                                                       Margin="-3,-6,2,0"
                                                       Content="{ui:SymbolIcon Symbol=Dismiss28}"
                                                       Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            
                                            <TextBlock Text="{Binding Title}" DockPanel.Dock="Right"
                                                       TextWrapping="NoWrap"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" 
                                                       Margin="2,-6,6,0" />
                                            <TextBlock Text="*" Margin="2,-6,0,0" DockPanel.Dock="Right"
                                                       Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Visibility="{Binding IsDirty,Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            

                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            
                        </TabControl>
                    </Border>

                    <Border Grid.Row="2" 
                            Height="32"
                            Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                            Padding="16,0,8,0"
                            BorderBrush="{DynamicResource UserSubtleFillColorSecondaryBrush}"
                            BorderThickness="1,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="{Binding CurrentPageStatus}"
                               Style="{StaticResource CaptionTextBlock}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                            <Border Grid.Column="1"
                                    Width="1"
                                    Height="16"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource UserControlStrokeColorDefaultBrush}"
                                    Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid Grid.Column="2"
                                  MinWidth="0"
                                  Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                       Margin="0,0,6,0"
                                       Style="{StaticResource ShellStatusMessageIconStyle}" />
                                <TextBlock Grid.Column="1"
                                   Text="{Binding StatusDisplayText}"
                                   ToolTip="{Binding StatusDisplayText}"
                                   Style="{StaticResource ShellStatusMessageTextStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <ui:Button Grid.Column="3"
                               Style="{StaticResource SwiftExportTabCloseButton}"
                               Content="{ui:SymbolIcon Symbol=Dismiss20}"
                               Command="{Binding DismissStatusMessageCommand}"
                               ToolTip="关闭状态消息"
                               Visibility="{Binding IsStatusMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" d:IsHidden="True" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="24,24,24,48" d:IsHidden="True" />
    </Grid>
</ui:FluentWindow>
