<ui:FluentWindow x:Class="SwiftExportClient.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:home="clr-namespace:SwiftExportClient.Features.Home"
        xmlns:customerViews="clr-namespace:SwiftExportClient.Features.Customers.CustomerManagement.Views"
        xmlns:customerViewModels="clr-namespace:SwiftExportClient.Features.Customers.CustomerManagement.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:planning="clr-namespace:SwiftExportClient.Features.Planning"
        xmlns:productCategoryViews="clr-namespace:SwiftExportClient.Features.Products.Categories.Views"
        xmlns:productCategoryViewModels="clr-namespace:SwiftExportClient.Features.Products.Categories.ViewModels"
        xmlns:productColorViews="clr-namespace:SwiftExportClient.Features.Products.Colors.Views"
        xmlns:productColorViewModels="clr-namespace:SwiftExportClient.Features.Products.Colors.ViewModels"
        xmlns:productListViews="clr-namespace:SwiftExportClient.Features.Products.ProductList.Views"
        xmlns:productListViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
        xmlns:productPlaceholderViews="clr-namespace:SwiftExportClient.Features.Products.Placeholders.Views"
        xmlns:productPlaceholderViewModels="clr-namespace:SwiftExportClient.Features.Products.Placeholders.ViewModels"
        xmlns:supplierViews="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierManagement.Views"
        xmlns:supplierViewModels="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierManagement.ViewModels"
        xmlns:purchasing="clr-namespace:SwiftExportClient.Features.Purchasing"
        xmlns:sales="clr-namespace:SwiftExportClient.Features.Sales"
        xmlns:shell="clr-namespace:SwiftExportClient.Shell"
        xmlns:shipping="clr-namespace:SwiftExportClient.Features.Shipping"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1920"
        Height="1080"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Tabbed"
        Background="Transparent"
        Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shell:ShellNavigationIconConverter x:Key="ShellNavigationIconConverter" />
        <shell:RouteSelectionConverter x:Key="RouteSelectionConverter" />

        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productListViewModels:ProductsViewModel}">
            <productListViews:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productCategoryViewModels:ProductCategoryManagerViewModel}">
            <productCategoryViews:ProductCategoryManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productColorViewModels:ProductColorsViewModel}">
            <productColorViews:ProductColorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type productPlaceholderViewModels:ProductBomViewModel}">
            <productPlaceholderViews:ProductPlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type customerViewModels:CustomerManagerViewModel}">
            <customerViews:CustomerManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type supplierViewModels:SupplierManagerViewModel}">
            <supplierViews:SupplierManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <sales:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type planning:PlanningViewModel}">
            <planning:PlanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shipping:ShippingViewModel}">
            <shipping:ShippingView />
        </DataTemplate>

        <DataTemplate x:Key="ShellNavigationItemTemplate">
            <Grid HorizontalAlignment="Stretch">
                <Button x:Name="LeafButton"
                        Style="{StaticResource SwiftExportShellNavigationItemButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding DataContext.OpenRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RouteKey}">
                    <Border x:Name="LeafSurface"
                            HorizontalAlignment="Stretch"
                            CornerRadius="{StaticResource SwiftExportCornerRadius}"
                            Background="Transparent">
                        <Grid MinHeight="40"
                              HorizontalAlignment="Stretch"
                              Margin="0"
                              ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="LeafSelectionRail"
                                    Grid.Column="0"
                                    Width="4"
                                    Background="{DynamicResource SwiftExportBrush.Accent}"
                                    CornerRadius="2"
                                    Visibility="Collapsed" />

                            <ui:SymbolIcon Grid.Column="2"
                                           Style="{StaticResource SwiftExportShellNavigationIcon}"
                                           Symbol="{Binding Icon, Converter={StaticResource ShellNavigationIconConverter}}" />

                            <TextBlock x:Name="LeafText"
                                       Grid.Column="4"
                                       Text="{Binding Title}"
                                       Style="{StaticResource SwiftExportShellNavigationText}" />
                        </Grid>
                        
                    </Border>
                </Button>

                <StackPanel x:Name="GroupPanel"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource SwiftExportShellNavigationItemButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.ToggleNavigationGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Border x:Name="GroupSurface"
                                HorizontalAlignment="Stretch"
                                CornerRadius="{StaticResource SwiftExportCornerRadius}"
                                Background="Transparent">
                            <Grid MinHeight="40"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="GroupChevronColumn" Width="24" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="2"
                                               Style="{StaticResource SwiftExportShellNavigationIcon}"
                                               Symbol="{Binding Icon, Converter={StaticResource ShellNavigationIconConverter}}" />

                                <TextBlock x:Name="GroupText"
                                           Grid.Column="4"
                                           Text="{Binding Title}"
                                           Style="{StaticResource SwiftExportShellNavigationText}" />

                                <ui:SymbolIcon x:Name="GroupChevron"
                                               Grid.Column="5"
                                               Style="{StaticResource SwiftExportShellNavigationChevron}" />
                            </Grid>
                        </Border>
                    </Button>

                    <ItemsControl x:Name="ChildrenItems"
                                  ItemsSource="{Binding Children}"
                                  HorizontalAlignment="Stretch"
                                  ItemContainerStyle="{StaticResource SwiftExportShellNavigationItemContainer}"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Margin="{StaticResource SwiftExportShellNavigationChildMargin}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="ChildButton"
                                        Style="{StaticResource SwiftExportShellNavigationItemButton}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.OpenRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding RouteKey}">
                                    <Border x:Name="ChildSurface"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="{StaticResource SwiftExportCornerRadius}"
                                            Background="Transparent">
                                        <Grid MinHeight="40"
                                              HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="ChildSelectionRail"
                                                    Grid.Column="0"
                                                    Width="4"
                                                    Background="{DynamicResource SwiftExportBrush.Accent}"
                                                    CornerRadius="2"
                                                    Visibility="Collapsed" />

                                            <ui:SymbolIcon Grid.Column="2"
                                                           Style="{StaticResource SwiftExportShellNavigationIcon}"
                                                           Symbol="{Binding Icon, Converter={StaticResource ShellNavigationIconConverter}}" />

                                            <TextBlock x:Name="ChildText"
                                                       Grid.Column="4"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource SwiftExportShellNavigationText}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource RouteSelectionConverter}">
                                                <Binding Path="RouteKey" />
                                                <Binding Path="DataContext.SelectedRouteKey"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="ChildSurface"
                                                Property="Background"
                                                Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                                        <Setter TargetName="ChildSelectionRail"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=ChildButton}" Value="True">
                                        <Setter TargetName="ChildSurface"
                                                Property="Background"
                                                Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsNavigationPaneExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter TargetName="ChildText"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                    <Setter TargetName="LeafButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GroupPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=LeafButton}" Value="True">
                    <Setter TargetName="LeafSurface"
                            Property="Background"
                            Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GroupPanel}" Value="True">
                    <Setter TargetName="GroupSurface"
                            Property="Background"
                            Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RouteSelectionConverter}">
                            <Binding Path="RouteKey" />
                            <Binding Path="DataContext.SelectedRouteKey"
                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="LeafSurface"
                            Property="Background"
                            Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                    <Setter TargetName="LeafSelectionRail"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsNavigationPaneExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter TargetName="LeafText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="GroupText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="GroupChevron"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="GroupChevronColumn"
                            Property="Width"
                            Value="0" />
                    <Setter TargetName="GroupPanel"
                            Property="ToolTip"
                            Value="{Binding Title}" />
                    <Setter TargetName="ChildrenItems"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0"
                         Title="{Binding Title}"
                         ShowHelp="False"
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True"
                         Padding="16,0,0,0">
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="退出登录"
                                Command="{Binding LogoutCommand}"
                                MinWidth="88"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <ui:InfoBar Grid.Row="1"
                        Title="{Binding InfoBarTitle}"
                        Message="{Binding InfoBarMessage}"
                        Severity="{Binding InfoBarSeverity}"
                        IsOpen="{Binding IsInfoBarOpen}"
                        Margin="16,8,16,0" />

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NavigationPaneWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="Transparent"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                        BorderThickness="0,0,1,0"
                        Padding="{StaticResource SwiftExportShellNavigationPadding}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Top"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SwiftExportShellNavigationIconButton}"
                                Command="{Binding ToggleNavigationPaneCommand}"
                                Margin="0,0,0,8"
                                ToolTip="折叠/展开导航">
                            <Border CornerRadius="{StaticResource SwiftExportCornerRadius}"
                                    Background="Transparent">
                                <Grid Width="40"
                                      MinHeight="40">
                                    <ui:SymbolIcon Style="{StaticResource SwiftExportShellNavigationIcon}"
                                                   Symbol="Navigation24" />
                                </Grid>
                            </Border>
                        </Button>

                        <ui:TextBox DockPanel.Dock="Top"
                                    PlaceholderText="搜索..."
                                    VerticalContentAlignment="Center"
                                    Text="{Binding MenuSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    MinHeight="25"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsNavigationPaneExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource SwiftExportShellNavigationItemButton}"
                                Command="{Binding OpenSettingsCommand}"
                                Margin="0,16,0,0">
                            <Border HorizontalAlignment="Stretch"
                                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                                    Background="Transparent">
                                <Grid MinHeight="40"
                                      HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="2"
                                                   Style="{StaticResource SwiftExportShellNavigationIcon}"
                                                   Symbol="Settings24" />
                                    <TextBlock Grid.Column="4"
                                               Text="Settings"
                                               Style="{StaticResource SwiftExportShellNavigationText}"
                                               Visibility="{Binding IsNavigationPaneExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Button>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredMenuItems}"
                                          HorizontalAlignment="Stretch"
                                          ItemContainerStyle="{StaticResource SwiftExportShellNavigationItemContainer}"
                                          ItemTemplate="{StaticResource ShellNavigationItemTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="16"
                        Background="{DynamicResource SwiftExportBrush.Surface}"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SwiftExportCornerRadius}">
                    <TabControl ItemsSource="{Binding OpenTabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button DockPanel.Dock="Right"
                                            Content="x"
                                            Style="{StaticResource SwiftExportTabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding ContentViewModel}"
                                                Margin="{StaticResource SwiftExportWorkspaceMargin}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Padding="16,8"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding CurrentPageStatus}"
                           Style="{StaticResource CaptionTextBlock}" />
            </Border>
            
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="24" />
    </Grid>
</ui:FluentWindow>
