<ui:FluentWindow x:Class="SwiftExportClient.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:home="clr-namespace:SwiftExportClient.Features.Home"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:planning="clr-namespace:SwiftExportClient.Features.Planning"
        xmlns:products="clr-namespace:SwiftExportClient.Features.Products"
        xmlns:purchasing="clr-namespace:SwiftExportClient.Features.Purchasing"
        xmlns:sales="clr-namespace:SwiftExportClient.Features.Sales"
        xmlns:shipping="clr-namespace:SwiftExportClient.Features.Shipping"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1920"
        Height="1080"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar ="True"
        WindowBackdropType ="Tabbed"
        Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type products:ProductsViewModel}">
            <products:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <sales:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type planning:PlanningViewModel}">
            <planning:PlanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shipping:ShippingViewModel}">
            <shipping:ShippingView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource SwiftExportBrush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,18"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource TitleTextBlock}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="退出登录"
                        Command="{Binding LogoutCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="菜单"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="8,0,0,12" />

                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Style="{StaticResource SwiftExportShellMenuButton}"
                                        Command="{Binding DataContext.OpenRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding RouteKey}"
                                        Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="18"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SwiftExportCornerRadius}">
                <TabControl ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Button DockPanel.Dock="Right"
                                        Content="x"
                                        Style="{StaticResource SwiftExportTabCloseButton}"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding ContentViewModel}"
                                            Margin="18" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding CurrentPageStatus}"
                       Style="{StaticResource CaptionTextBlock}" />
        </Border>
    </Grid>
</ui:FluentWindow>
