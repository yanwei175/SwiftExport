<ui:FluentWindow x:Class="SwiftExportClient.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:home="clr-namespace:SwiftExportClient.Features.Home"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:planning="clr-namespace:SwiftExportClient.Features.Planning"
        xmlns:products="clr-namespace:SwiftExportClient.Features.Products"
        xmlns:purchasing="clr-namespace:SwiftExportClient.Features.Purchasing"
        xmlns:sales="clr-namespace:SwiftExportClient.Features.Sales"
        xmlns:shipping="clr-namespace:SwiftExportClient.Features.Shipping"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1920"
        Height="1080"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Tabbed"
        Loaded="OnLoaded">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type products:ProductsViewModel}">
            <products:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <sales:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type planning:PlanningViewModel}">
            <planning:PlanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type purchasing:PurchasingViewModel}">
            <purchasing:PurchasingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type shipping:ShippingViewModel}">
            <shipping:ShippingView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource SwiftExportBrush.WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0"
                         Title="{Binding Title}"
                         ShowHelp="False"
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True"
                         Padding="16,0,0,0">
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="退出登录"
                                Command="{Binding LogoutCommand}"
                                MinWidth="88"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <ui:InfoBar Grid.Row="1"
                        Title="{Binding InfoBarTitle}"
                        Message="{Binding InfoBarMessage}"
                        Severity="{Binding InfoBarSeverity}"
                        IsOpen="{Binding IsInfoBarOpen}"
                        Margin="16,8,16,0" />

            <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="导航"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="8,0,0,12" />

                    <StackPanel>
                        <ui:NavigationViewItem Content="首页"
                                               TargetPageTag="home"
                                               Click="OnNavigationItemClick" />
                        <ui:NavigationViewItem Content="产品"
                                               IsExpanded="True">
                            <ui:NavigationViewItem.MenuItems>
                                <ui:NavigationViewItem Content="产品资料"
                                                       TargetPageTag="products"
                                                       Click="OnNavigationItemClick" />
                                <ui:NavigationViewItem Content="BOM"
                                                       TargetPageTag="product-bom"
                                                       Click="OnNavigationItemClick" />
                                <ui:NavigationViewItem Content="客户产品"
                                                       TargetPageTag="customer-products"
                                                       Click="OnNavigationItemClick" />
                                <ui:NavigationViewItem Content="供应商产品"
                                                       TargetPageTag="supplier-products"
                                                       Click="OnNavigationItemClick" />
                            </ui:NavigationViewItem.MenuItems>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="销售"
                                               TargetPageTag="sales"
                                               Click="OnNavigationItemClick" />
                        <ui:NavigationViewItem Content="计划"
                                               TargetPageTag="planning"
                                               Click="OnNavigationItemClick" />
                        <ui:NavigationViewItem Content="采购"
                                               TargetPageTag="purchasing"
                                               Click="OnNavigationItemClick" />
                        <ui:NavigationViewItem Content="出货"
                                               TargetPageTag="shipping"
                                               Click="OnNavigationItemClick" />
                    </StackPanel>
                </DockPanel>
            </Border>
                
             <GridSplitter Grid.RowSpan="2" Grid.Column="1" />

                <Border Grid.Column="1"
                    Margin="18"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SwiftExportCornerRadius}">
                <TabControl ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Button DockPanel.Dock="Right"
                                        Content="x"
                                        Style="{StaticResource SwiftExportTabCloseButton}"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding ContentViewModel}"
                                            Margin="18" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>
            </Grid>

            <Border Grid.Row="3"
                    Padding="16,8"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding CurrentPageStatus}"
                           Style="{StaticResource CaptionTextBlock}" />
            </Border>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" d:IsHidden="True" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="24" d:IsHidden="True" />
    </Grid>
</ui:FluentWindow>
