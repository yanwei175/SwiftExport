<Window x:Class="SwiftExportClient.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SwiftExportBrush.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <Border >
            <StackPanel>
                <TextBlock Text="SwiftExport"
                           Style="{StaticResource TitleTextBlock}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="请登录以继续"
                           Style="{StaticResource SubtitleTextBlock}"                           
                           HorizontalAlignment="Center"/>

                <TextBlock Text="用户名" Style="{StaticResource BodyStrongTextBlock}"/>

                <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="请输入用户名..."
                         Margin="0,6,0,18" />

                <TextBlock Text="密码" Style="{StaticResource BodyStrongTextBlock}"/>
                
                <ui:PasswordBox x:Name="PasswordBox"
                             MinHeight="{DynamicResource SwiftExportControlHeight}"
                             Padding="{DynamicResource SwiftExportControlPadding}"
                             PlaceholderText="请输入密码..."
                             Margin="0,6,0,22"
                             VerticalContentAlignment="Center" />

                <ui:Button x:Name="LoginButton"
                        Appearance="Primary"
                        HorizontalAlignment="Stretch"
                        Content="登录"
                        IsEnabled="{Binding IsNotBusy}" />

                <ui:Button x:Name="CancelButton"
                        HorizontalAlignment="Stretch"
                        Content="取消"
                        Margin="0,10,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,18,0,0" />

                <ProgressBar IsIndeterminate="True"
                             Height="2"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
