<Window x:Class="SwiftExportClient.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SwiftExportBrush.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SwiftExportCornerRadius}"
                Padding="32">
            <StackPanel>
                <TextBlock Text="SwiftExport"
                           Style="{StaticResource SwiftExportTitleText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="请登录以继续"
                           Style="{StaticResource SwiftExportCaptionText}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,30" />

                <TextBlock Text="用户名"
                           Style="{StaticResource SwiftExportCaptionText}" />
                
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,18" />

                <TextBlock Text="密码"
                           Style="{StaticResource SwiftExportCaptionText}" />
                
                <PasswordBox x:Name="PasswordBox"
                             MinHeight="{DynamicResource SwiftExportControlHeight}"
                             Padding="{DynamicResource SwiftExportControlPadding}"
                             Margin="0,6,0,22"
                             VerticalContentAlignment="Center" />

                <Button x:Name="LoginButton"
                        Content="登录"
                        Style="{StaticResource SwiftExportPrimaryButton}"
                        Height="40"
                        IsEnabled="{Binding IsNotBusy}" />
                <Button x:Name="CancelButton"
                        Content="取消"
                        Height="40"
                        Margin="0,10,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource SwiftExportCaptionText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,18,0,0" />

                <ProgressBar IsIndeterminate="True"
                             Height="2"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
