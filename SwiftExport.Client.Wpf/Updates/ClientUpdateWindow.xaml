<ui:FluentWindow x:Class="SwiftExportClient.Updates.ClientUpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="客户端更新" Width="560" Height="440" MinWidth="480" MinHeight="360"
    WindowStartupLocation="CenterOwner" Loaded="OnLoaded" Closing="OnClosing">
    <ui:FluentWindow.Resources>
        <Style x:Key="ClientUpdateActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="RequirementText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding CurrentVersion, StringFormat=当前版本：{0}}" />
            <TextBlock Text="{Binding AvailableRelease.Version, StringFormat=可用版本：{0}, TargetNullValue=尚未发现新版本}" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding AvailableRelease.ReleaseNotes}" TextWrapping="Wrap" />
        </ScrollViewer>
        <ProgressBar x:Name="DownloadProgressBar" Grid.Row="3" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,12"
                     Value="{Binding DownloadProgress, Mode=OneWay}" AutomationProperties.Name="更新下载进度" />
        <TextBlock x:Name="UpdateStatus" Grid.Row="4" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,16"
                   AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
            <Button x:Name="CheckButton" Content="检查更新" Command="{Binding CheckCommand}" Style="{StaticResource ClientUpdateActionButton}" />
            <Button x:Name="DownloadButton" Content="下载更新" Command="{Binding DownloadCommand}" Style="{StaticResource ClientUpdateActionButton}" />
            <Button x:Name="RestartButton" Content="重启更新" Command="{Binding RestartCommand}" Style="{StaticResource ClientUpdateActionButton}" />
            <Button x:Name="LaterButton" Content="稍后" Click="OnCloseClick" Style="{StaticResource ClientUpdateActionButton}" IsCancel="True" />
        </WrapPanel>
    </Grid>
    <ui:ContentDialogHost x:Name="UpdateDialogHost" />
    </Grid>
</ui:FluentWindow>
