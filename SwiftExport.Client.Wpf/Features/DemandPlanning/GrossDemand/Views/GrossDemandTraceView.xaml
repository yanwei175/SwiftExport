<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="12,8" RowDefinitions="Auto,Auto,Auto,*">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="刷新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" MinWidth="70" />
            <Button Content="打开来源单" Command="{Binding OpenSourceCommand}" DockPanel.Dock="Right" MinWidth="90" Margin="0,0,8,0" />
            <TextBlock Text="{Binding DocumentTitle}" FontSize="20" FontWeight="SemiBold" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="客户：" /><TextBlock Text="{Binding Detail.CustomerName}" Margin="0,0,16,0" />
            <TextBlock Text="状态：" /><TextBlock Text="{Binding Detail.LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,0,16,0" />
            <TextBlock Text="SKU：" /><TextBlock Text="{Binding Detail.Sku}" Margin="0,0,16,0" />
            <TextBlock Text="客户型号：" /><TextBlock Text="{Binding Detail.CustomerSku}" Margin="0,0,16,0" />
            <TextBlock Text="需求：" /><TextBlock Text="{Binding Detail.DemandQty, StringFormat=N0}" />
            <TextBlock Text="{Binding Detail.Unit}" Margin="4,0,16,0" />
            <TextBlock Text="正式已交：" /><TextBlock Text="{Binding Detail.DeliveredQty, StringFormat=N0, TargetNullValue=未知}" />
            <TextBlock Text="{Binding Detail.Unit}" Margin="4,0,16,0" />
            <TextBlock Text="交期：" /><TextBlock Text="{Binding Detail.RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未设置}" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="3" RowDefinitions="Auto,2*,8,Auto,2*,8,Auto,2*">
            
            <TextBlock Grid.Row="0" Text="拆解修订与物料需求"/>
            
            <ui:Card Grid.Row="1" Padding="0"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                
                <DataGrid ItemsSource="{Binding Detail.Materials}" 
                          Background="Transparent"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="修订" Binding="{Binding DecompositionRevision}" Width="55" />
                        <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="40" />
                        <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="65" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" />
                        <DataGridTextColumn Header="物料类型" Binding="{Binding MaterialType}" Width="85" />
                        <DataGridTextColumn Header="净需求" Binding="{Binding NetQty, StringFormat=N0}" Width="75" />
                        <DataGridTextColumn Header="有效采购贡献" Binding="{Binding ActivePurchaseQty, StringFormat=N0, TargetNullValue=需核实}" Width="105" />
                        <DataGridTextColumn Header="提示" Binding="{Binding ReviewReason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>
            
            <TextBlock Grid.Row="3" Text="采购关联与整行货好反馈"/>
            
            <ui:Card Grid.Row="4" Padding="0"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="4">
                        <Button Content="打开采购详情" Command="{Binding OpenPurchaseCommand}" DockPanel.Dock="Right" />
                        <TextBlock Text="货好属于整条采购行，共享行不向成品需求分摊。" Foreground="Gray" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Detail.Purchases}" SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                              Background="Transparent"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="采购单" Binding="{Binding PurchaseOrderNo}" Width="115" />
                            <DataGridTextColumn Header="单据" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="70" />
                            <DataGridTextColumn Header="确认" Binding="{Binding ConfirmationStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="70" />
                            <DataGridTextColumn Header="行" Binding="{Binding PurchaseLineNumber}" Width="40" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                            <DataGridTextColumn Header="Link贡献" Binding="{Binding LinkedQty, StringFormat=N0}" Width="75" />
                            <DataGridTextColumn Header="原分配" Binding="{Binding AllocatedQty, StringFormat=N0}" Width="70" />
                            <DataGridTextColumn Header="已释放" Binding="{Binding ReleasedQty, StringFormat=N0}" Width="70" />
                            <DataGridTextColumn Header="采购行数量" Binding="{Binding PurchaseLineQty, StringFormat=N0}" Width="85" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="55" />
                            <DataGridTextColumn Header="整行货好" Binding="{Binding PurchaseLineReadyQty, StringFormat=N0, TargetNullValue=未反馈}" Width="85" />
                            <DataGridTextColumn Header="整行入库" Binding="{Binding PurchaseLineReceivedQty, StringFormat=N0}" Width="85" />
                            <DataGridCheckBoxColumn Header="共享行" Binding="{Binding IsSharedPurchaseLine}" Width="65" />
                            <DataGridTextColumn Header="预计货好" Binding="{Binding ExpectedReadyDate, StringFormat=yyyy-MM-dd}" Width="100" />
                            <DataGridTextColumn Header="提示" Binding="{Binding ReviewReason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <TextBlock Grid.Row="6" Text="装箱交付与反向历史"/>
            
            <ui:Card Grid.Row="7" Padding="0"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Button Grid.Row="0" Content="打开装箱详情" Command="{Binding OpenPackingListCommand}"
                            HorizontalAlignment="Right" Margin="4" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Detail.Deliveries}" SelectedItem="{Binding SelectedDelivery, Mode=TwoWay}"
                              Background="Transparent"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="箱单号" Binding="{Binding PackingListNo}" Width="115" />
                            <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="40" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Qty, StringFormat=N0}" Width="75" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="55" />
                            <DataGridCheckBoxColumn Header="计入已交" Binding="{Binding CountsTowardDelivery}" Width="75" />
                            <DataGridTextColumn Header="过账" Binding="{Binding PostedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
                            <DataGridTextColumn Header="反向" Binding="{Binding ReversedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
                            <DataGridTextColumn Header="提示" Binding="{Binding ReviewReason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
