<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.Views"
             mc:Ignorable="d" d:Width="720" d:Height="800">
    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,2*,8,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="需求追溯" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="关闭"
                    Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType={x:Type views:GrossDemandWorkspaceView}}}"
                    MinWidth="72"
                    VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="2" DataContext="{Binding GrossDemand}" ColumnDefinitions="Auto,12,*,12,Auto,12,*">
            <StackPanel>
                <TextBlock Text="来源" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding SourceNo}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="SKU / 客户型号" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock><Run Text="{Binding Sku}"/><Run Text=" / "/><Run Text="{Binding CustomerSku}"/></TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="数量" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding DemandQty, StringFormat=N4}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="拆解版本" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding DecompositionRevision}" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="4" ItemsSource="{Binding NetDemands}" SelectedItem="{Binding SelectedNetDemand}"
                  Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                  RowHeight="34" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="打开" Padding="4,1"
                                    Command="{Binding DataContext.OpenNetDemandCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="版本" Width="54" Binding="{Binding DecompositionRevision}" />
                <DataGridTextColumn Header="行" Width="42" Binding="{Binding LineNumber}" />
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding LifecycleStatus}" />
                <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Sku}" />
                <DataGridTextColumn Header="物料类型" Width="84" Binding="{Binding MaterialType}" />
                <DataGridTextColumn Header="供货类型" Width="84" Binding="{Binding SupplyType}" />
                <DataGridTextColumn Header="净数量" Width="84" Binding="{Binding NetQty, StringFormat=N4}" />
                <DataGridTextColumn Header="计划供应商" Width="105" Binding="{Binding PreferredSupplierCode, TargetNullValue=未指定}" />
                <DataGridTextColumn Header="送达目标" Width="120" Binding="{Binding DeliveryTargetSku, TargetNullValue=标准交付}" />
                <DataGridTextColumn Header="执行进度" Width="95" Binding="{Binding ExecutionProgress}" />
                <DataGridTextColumn Header="描述" Width="180" Binding="{Binding Description}" />
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Row="6" ItemsSource="{Binding ExecutionLinks}"
                  Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="目标类型" Width="80" Binding="{Binding TargetType}" />
                <DataGridTextColumn Header="执行单号" Width="130" Binding="{Binding TargetNo}" />
                <DataGridTextColumn Header="链接状态" Width="84" Binding="{Binding LinkStatus}" />
                <DataGridTextColumn Header="分配数量" Width="84" Binding="{Binding AllocatedQty, StringFormat=N4}" />
                <DataGridTextColumn Header="完成数量" Width="84" Binding="{Binding CompletedQty, StringFormat=N4}" />
                <DataGridTextColumn Header="收货数量" Width="84" Binding="{Binding ReceivedQty, StringFormat=N4}" />
                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Remark}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
