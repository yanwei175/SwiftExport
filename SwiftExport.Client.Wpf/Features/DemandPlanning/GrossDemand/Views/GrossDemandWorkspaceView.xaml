<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:views="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:GrossDemandWorkspaceViewModel}"
             d:Width="1600" d:Height="900">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type viewModels:GrossDemandManualEditorViewModel}">
            <views:GrossDemandManualEditorView />
        </DataTemplate>

        <Style x:Key="GrossDemandToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="70" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <DockPanel Margin="12" LastChildFill="True">
        <Border DockPanel.Dock="Left"
                        Width="180"
                        Margin="0,0,8,0"
                        Padding="4"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowDefinitions="Auto,4,Auto,4,Auto,4,Auto,8,*,4,Auto">
                <TextBlock Margin="4,2"
                                   FontWeight="SemiBold"
                                   Text="来源单号" />

                <Grid Grid.Row="2" ColumnDefinitions="5*,5*">
                    <controls:DropDownCheckBox Grid.Column="0"
                                                       Placeholder="状态"
                                                       DisplayMemberPath="DisplayText"
                                                       ItemsSource="{Binding LifecycleStatusOptions}"
                                                       SelectedItems="{Binding SourceLifecycleStatuses, Mode=OneWay}" />
                </Grid>

                <Button Grid.Row="6"
                                HorizontalAlignment="Stretch"
                                Content="清空筛选"
                                Command="{Binding ClearSourceFiltersCommand}" />

                <ListBox Grid.Row="8"
                                 Background="Transparent"
                                 ItemsSource="{Binding SourceGroups}"
                                 SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
                                 SelectionChanged="OnSourceGroupSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}"
                                 VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                                       Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CountText}"
                                                   Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="10"
                                   Margin="4,0"
                                   Text="{Binding SourceGroupSummary}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,8,Auto,8,Auto,8,*,8,Auto">

            <!--条件筛选区域-->
            <Grid RowDefinitions="Auto,8, *">
                <Grid ColumnDefinitions="3*,3*,3*">
                    <TextBlock Text="成品需求" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                    <!--搜索框-->
                    <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="来源单号、SKU、客户型号或描述">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <ui:Button  Content="查询"  Appearance="Primary" Margin="8,0,0,0"
                                    VerticalAlignment="Stretch"
                                    Command="{Binding SearchCommand}" MinWidth="70"/>

                        <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                        <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0"
                               VerticalAlignment="Stretch" MinWidth="70"/>
                    </StackPanel>

                </Grid>
            </Grid>



            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ui:Button Content="新增独立需求"
                               Command="{Binding CreateManualCommand}" 
                               Appearance="Primary" 
                               Margin="0,0,8,0"/>
                
                <ui:Button Command="{Binding EditSelectedManualCommand}" 
                            Style="{StaticResource GrossDemandToolbarButton}" 
                            Content="编辑独立需求" Margin="0,0,8,0" />
                
                <ui:Button Command="{Binding CloseSelectedManualCommand}" 
                            Style="{StaticResource GrossDemandToolbarButton}" 
                            Content="关闭独立需求" Margin="0,0,8,0"/>

                <ui:Button Content="上追踪" MinWidth="70" Margin="0,0,8,0"
                        Command="{Binding OpenSourceCommand}" 
                       Style="{StaticResource GrossDemandToolbarButton}"/>

                <ui:Button Content="链路追踪" MinWidth="80" Margin="0,0,8,0"
                        Command="{Binding OpenTraceCommand}" />
                
                <ToggleButton Content="来源单号分组" Margin="0,0,8,0"
                              Command="{Binding ToggleSourcePanelCommand}"
                              IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}"
                              HorizontalAlignment="Left" />
                
                <Separator Margin="0,0,8,0"/>
                
                

                <controls:DropDownCheckBox Grid.Column="4" Placeholder="来源类型" 
                                               DisplayMemberPath="DisplayText"
                                                Margin="0,0,8,0" MinWidth="70"
                                               ItemsSource="{Binding SourceTypeOptions}" 
                                               SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}" />

                <controls:DropDownCheckBox Grid.Column="6" Placeholder="状态" 
                                               MinWidth="70" DisplayMemberPath="DisplayText"
                                                Margin="0,0,8,0"
                                               ItemsSource="{Binding LifecycleStatusOptions}"
                                               SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" />

                <ComboBox Grid.Column="8" VerticalContentAlignment="Center"  Margin="0,0,8,0"
                                  ItemsSource="{Binding StandardTypeOptions}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedStandardType}" />

                <ComboBox Width="125" VerticalContentAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding TraceViewOptions}" DisplayMemberPath="DisplayText"
                          SelectedItem="{Binding SelectedTraceView}" />

                <ui:TextBox Width="120" Margin="0,0,8,0" PlaceholderText="客户编码/名称"
                            Text="{Binding CustomerKeyword,UpdateSourceTrigger=PropertyChanged}" />
                
                <ToggleButton x:Name="OptionsToggle"  Content="更多条件" Margin="0,0,8,0"/>

                <Popup IsOpen="{Binding IsChecked, ElementName=OptionsToggle, Mode=TwoWay}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                                Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                        <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,220,8,220,8,220">

                            <TextBlock Text="需求交期起 : "/>
                            <DatePicker Grid.Column="2" VerticalAlignment="Top" 
                                            SelectedDateFormat="Short" SelectedDate="{Binding RequiredDateFrom}" />

                            <TextBlock Grid.Column="4" Text="需求交期至 : "/>
                            <DatePicker Grid.Column="6" VerticalAlignment="Top" SelectedDateFormat="Short" SelectedDate="{Binding RequiredDateTo}" />

                            <ui:TextBox Grid.Column="8" PlaceholderText="来源单号（支持多行）"
                                            Text="{Binding SourceNosText}"
                                            AcceptsReturn="True"
                                            VerticalAlignment="Top"
                                            MinHeight="220" />
                            <ui:TextBox Grid.Column="10" PlaceholderText="SKU（支持多行）"
                                            Text="{Binding SkusText}"
                                            VerticalAlignment="Top"
                                            AcceptsReturn="True"
                                            MinHeight="220" />
                            <ui:TextBox Grid.Column="12"
                                            PlaceholderText="客户型号（支持多行）"
                                            Text="{Binding CustomerSkusText}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Top"
                                            MinHeight="220" />
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>

            <controls:RightDrawerHost Grid.Row="6" IsOpen="{Binding IsDrawerOpen, Mode=OneWay}"
                                      
                              DrawerContent="{Binding ActiveDrawerContent}"
                              CloseCommand="{Binding CloseDrawerCommand}"
                              CloseOnEscape="True"
                              DrawerWidth="1050" 
                              MinDrawerWidth="440" 
                              MaxDrawerWidth="1050"
                              DisplayMode="Overlay" 
                              IsResizable="True">
                <controls:RightDrawerHost.MainContent>
                    <DataGrid ItemsSource="{Binding Items}" 
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              Style="{StaticResource SwiftExportDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="{StaticResource DataGridRowHeightMedium}" 
                              FontSize="{StaticResource SwiftExportDefaltFontSize}" 
                              SelectionMode="Extended" 
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True" 
                              EnableColumnVirtualization="True"
                              gridCore:EnterpriseGrid.IsEnabled="True"
                              gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True"
                              gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                              gridSelection:GridSelection.CurrentRow="{Binding SelectedItem, Mode=TwoWay}">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsThreeState="False" 
                                                  IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="来源" Width="70" Binding="{Binding SourceTypeText}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                                gridColumns:GridColumn.Key="source-type" />
                            <DataGridTextColumn Header="来源行" Width="60" Binding="{Binding SourceLineNumber}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            gridColumns:GridColumn.Key="source-line" />

                            <DataGridTextColumn Header="状态" Width="48" Binding="{Binding LifecycleStatusText}"
                                            gridColumns:GridColumn.Key="lifecycle" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding LifecycleStatusText}" Value="活动">
                                                <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding LifecycleStatusText}"  Value="警告">
                                                <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding LifecycleStatusText}" Value="已作废">
                                                <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="链路证据" Width="180" Binding="{Binding TraceSummary}"
                                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                                gridColumns:GridColumn.Key="trace-summary" />

                            <DataGridTextColumn Header="来源单号" Width="100" Binding="{Binding SourceNo}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            gridColumns:GridColumn.Key="source-no" />

                            <DataGridTextColumn Header="物料类型" Width="72" 
                                                    Binding="{Binding ItemTypeText}" 
                                            gridColumns:GridColumn.Key="item-type" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" 
                                               BasedOn="{StaticResource SwiftExportDataGridDateTextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemTypeText}"  Value="非标件">
                                                <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False" gridColumns:GridColumn.Key="image">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="56" Height="56" Margin="2" 
                                                          Style="{StaticResource SwiftExportCachedImage}"
                                                          SourcePath="{Binding ImagePath}" 
                                                          DecodePixelWidth="80" 
                                                          Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Sku}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            gridColumns:GridColumn.Key="sku" />

                            <DataGridTextColumn Header="Link SKU" Width="110" Binding="{Binding LinkSku}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="link-sku" />

                            <DataGridTextColumn Header="客户型号" Width="120" Binding="{Binding CustomerSku}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="customer-sku" />

                            <DataGridTextColumn Header="需求交期" Width="96" Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                                gridColumns:GridColumn.Key="required-date" />

                            <DataGridTextColumn Header="数量" Width="58" Binding="{Binding DemandQty, StringFormat=N1}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                gridColumns:GridColumn.Key="demand-qty" />

                            <DataGridTextColumn Header="描述" Width="200" Binding="{Binding Description}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="description" />

                            <DataGridTextColumn Header="颜色" Width="100" Binding="{Binding Color}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="color" />

                            <DataGridTextColumn Header="规格" Width="150" Binding="{Binding Specification}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="specification" />

                            <DataGridTextColumn Header="备注" Width="180" Binding="{Binding Remark}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="remark" />
                            <DataGridTextColumn Header="创建人" Width="88" Binding="{Binding CreatedBy}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="created-by" />
                            <DataGridTextColumn Header="创建时间" Width="132" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd HH:mm}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                                gridColumns:GridColumn.Key="created-at" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RightDrawerHost.MainContent>
            </controls:RightDrawerHost>
            <Grid Grid.Row="8" ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding ResultSummary}" 
               Style="{StaticResource CaptionTextBlock}" 
               VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" 
               Text="{Binding CheckedCount, StringFormat=已选 {0} 条}" 
               Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" 
               Text="{Binding PageStatus}" 
               Margin="16,0" 
               Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}"
                        PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}">
                    <controls:PageNavigator.Style>
                        <Style TargetType="controls:PageNavigator">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:PageNavigator.Style>
                </controls:PageNavigator>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
