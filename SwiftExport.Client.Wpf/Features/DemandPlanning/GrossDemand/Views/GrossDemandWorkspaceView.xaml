<UserControl
  x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandWorkspaceView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
  xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
  xmlns:views="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.Views"
  xmlns:viewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
  xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
  xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
  xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <DataTemplate
      DataType="{x:Type viewModels:GrossDemandManualEditorViewModel}">
      <views:GrossDemandManualEditorView />
    </DataTemplate>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
    <Style
      x:Key="OptionalMessage"
      TargetType="TextBlock"
      BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter
        Property="TextWrapping"
        Value="Wrap" />
      <Style.Triggers>
        <Trigger
          Property="Text"
          Value="">
          <Setter
            Property="Visibility"
            Value="Collapsed" />
        </Trigger>
        <Trigger
          Property="Text"
          Value="{x:Null}">
          <Setter
            Property="Visibility"
            Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid
    Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="Auto" />
      <ColumnDefinition
        Width="Auto" />
      <ColumnDefinition
        Width="*" />
    </Grid.ColumnDefinitions>
    <Border
      x:Name="SourcePanel"
      Width="240"
      MinWidth="160"
      MaxWidth="440"
      Padding="4"
      BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4"
      Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
          Text="来源导航"
          FontWeight="SemiBold"
          Margin="4,2,4,8" />
        <WrapPanel
          Grid.Row="1"
          Margin="0,0,0,8">
          <controls:DropDownCheckBox
            Placeholder="来源状态"
            DisplayMemberPath="DisplayText"
            ItemsSource="{Binding LifecycleStatusOptions}"
            SelectedItems="{Binding SourceLifecycleStatuses, Mode=OneWay}"
            MinWidth="105" />
          <Button
            Content="清空筛选"
            Command="{Binding ClearSourceFiltersCommand}"
            Margin="4,0,0,0" />
        </WrapPanel>
        <ListBox
          x:Name="SourceList"
          Grid.Row="2"
          ItemsSource="{Binding SourceGroups}"
          SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
          SelectionChanged="OnSourceGroupSelectionChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
          ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="*" />
                  <ColumnDefinition
                    Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock
                    Text="{Binding DisplaySourceNo}"
                    ToolTip="{Binding SourceNo}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Text="{Binding SourceTypeText}"
                    Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding CountText}"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock
          Grid.Row="3"
          Text="{Binding SourceGroupSummary}"
          TextWrapping="Wrap"
          Margin="4,8,4,0"
          Style="{StaticResource CaptionTextBlock}" />
      </Grid>
    </Border>
    <Thumb
      Grid.Column="1"
      Width="6"
      Cursor="SizeWE"
      DragDelta="OnSourceResizeDelta"
      ToolTip="拖动调整来源导航宽度"
      Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <Grid
      Grid.Column="2"
      Margin="4,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <WrapPanel
        Margin="0,0,0,8">
        <TextBlock
          Text="成品需求"
          Style="{StaticResource SubtitleTextBlock}"
          Margin="0,0,12,0"
          VerticalAlignment="Center" />
        <Button
          Content="新增独立需求"
          Command="{Binding CreateManualCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="编辑独立需求"
          Command="{Binding EditSelectedManualCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="关闭独立需求"
          Command="{Binding CloseSelectedManualCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="查看来源单据"
          Command="{Binding OpenSourceCommand}"
          Margin="0,0,8,4"
          ToolTip="按现有来源单据权限打开，独立需求可通过编辑查看。" />
        <Button
          Content="打开跟踪"
          Command="{Binding OpenTraceCommand}"
          Margin="0,0,8,4"
          ToolTip="打开订单跟踪明细，需要订单跟踪查看权限。" />
        <ToggleButton
          Content="来源导航"
          Command="{Binding ToggleSourcePanelCommand}"
          IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}"
          Margin="0,0,8,4" />
        <Button
          Content="返回全部需求"
          Command="{Binding ReturnToAllCommand}"
          Visibility="{Binding IsSourceSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
          Margin="0,0,8,4" />
      </WrapPanel>
      <WrapPanel
        Grid.Row="1"
        IsEnabled="{Binding CanEditMainFilters}"
        Margin="0,0,0,4">
        <ui:TextBox
          x:Name="KeywordBox"
          PlaceholderText="单号、产品/中性/客户型号或描述"
          Width="260"
          Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
          ToolTip="来源单号、产品编码、中性型号、客户型号或描述"
          AutomationProperties.Name="成品需求关键词"
          Margin="0,0,8,4">
          <ui:TextBox.InputBindings>
            <KeyBinding
              Key="Enter"
              Command="{Binding SearchCommand}" />
          </ui:TextBox.InputBindings>
        </ui:TextBox>
        <lookup:MultiSelectLookupButton
          Header="来源类型"
          DisplayMemberPath="DisplayText"
          ItemsSource="{Binding SourceTypeOptions}"
          SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}"
          MinWidth="100"
          Margin="0,0,8,4" />
        <lookup:MultiSelectLookupButton
          Header="生命周期"
          DisplayMemberPath="DisplayText"
          ItemsSource="{Binding LifecycleStatusOptions}"
          SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}"
          MinWidth="100"
          Margin="0,0,8,4" />
        <ComboBox
          ItemsSource="{Binding StandardTypeOptions}"
          DisplayMemberPath="DisplayText"
          SelectedItem="{Binding SelectedStandardType}"
          AutomationProperties.Name="需求类型"
          MinWidth="100"
          Margin="0,0,8,4" />
        <lookup:MultiSelectLookupButton
          x:Name="CustomerSelector"
          Header="客户"
          DisplayMemberPath="DisplayText"
          ItemsSource="{Binding CustomerOptions}"
          SelectedItems="{Binding SelectedCustomers, Mode=OneWay}"
          MinWidth="130"
          Margin="0,0,8,4"
          AutomationProperties.Name="成品需求客户多选" />
        <ToggleButton
          x:Name="OptionsToggle"
          Content="更多条件"
          IsChecked="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
          Margin="0,0,8,4" />
        <Button
          Content="查询"
          Command="{Binding SearchCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="清空并查询"
          Command="{Binding ClearFiltersCommand}"
          Margin="0,0,8,4" />
      </WrapPanel>
      <StackPanel
        Grid.Row="2"
        Margin="0,0,0,6">
        <WrapPanel>
          <TextBlock
            Text="{Binding QueryModeText}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            MaxWidth="720"
            Margin="0,0,8,4" />
          <Button
            Content="刷新已应用查询"
            Command="{Binding RefreshCommand}"
            Margin="0,0,8,4" />
          <Button
            Content="清除当前表头筛选"
            Command="{x:Static commands:DataGridFilterCommands.Clear}"
            CommandParameter="{Binding ElementName=GrossDrawer, Path=MainContent}"
            Margin="0,0,8,4" />
        </WrapPanel>
        <WrapPanel>
          <TextBlock
            Text="{Binding CustomerLoadError}"
            Style="{StaticResource OptionalMessage}" />
          <Button
            Content="刷新客户候选"
            Command="{Binding RefreshCustomerOptionsCommand}"
            Margin="8,0,0,4" />
        </WrapPanel>
      </StackPanel>
      <Popup
        IsOpen="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=OptionsToggle}"
        StaysOpen="False"
        AllowsTransparency="True">
        <Border
          Padding="12"
          Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4">
          <StackPanel
            Width="740">
            <TextBlock
              Text="更多条件 · 修改后点击应用，收起会保留输入。"
              Margin="0,0,0,8" />
            <WrapPanel
              Margin="0,0,0,8">
              <TextBlock
                Text="要求交期起"
                VerticalAlignment="Center"
                Margin="0,0,6,0" />
              <DatePicker
                SelectedDate="{Binding RequiredDateFrom}"
                Width="135"
                Margin="0,0,12,0" />
              <TextBlock
                Text="至"
                VerticalAlignment="Center"
                Margin="0,0,6,0" />
              <DatePicker
                SelectedDate="{Binding RequiredDateTo}"
                Width="135" />
            </WrapPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel
                Margin="0,0,8,0">
                <TextBlock
                  Text="来源单号（每行一项）" />
                <TextBox
                  Text="{Binding SourceNosText, UpdateSourceTrigger=PropertyChanged}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Height="150"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="批量来源单号" />
              </StackPanel>
              <StackPanel
                Grid.Column="1"
                Margin="0,0,8,0">
                <TextBlock
                  Text="产品编码（每行一项）" />
                <TextBox
                  Text="{Binding SkusText, UpdateSourceTrigger=PropertyChanged}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Height="150"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="批量产品编码" />
              </StackPanel>
              <StackPanel
                Grid.Column="2">
                <TextBlock
                  Text="客户型号（每行一项）" />
                <TextBox
                  Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  Height="150"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="批量客户型号" />
              </StackPanel>
            </Grid>
            <StackPanel
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              Margin="0,12,0,0">
              <Button
                Content="应用并查询"
                Command="{Binding ApplyMoreFiltersCommand}"
                Margin="0,0,8,0" />
              <Button
                Content="清空更多条件"
                Command="{Binding ClearMoreFiltersCommand}"
                Margin="0,0,8,0" />
              <Button
                Content="收起"
                Command="{Binding CollapseMoreFiltersCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>
      <controls:RightDrawerHost
        x:Name="GrossDrawer"
        Grid.Row="3"
        IsOpen="{Binding IsDrawerOpen, Mode=OneWay}"
        DrawerContent="{Binding ActiveDrawerContent}"
        CloseCommand="{Binding CloseDrawerCommand}"
        CloseOnEscape="True"
        DrawerWidth="1050"
        MinDrawerWidth="440"
        MaxDrawerWidth="1050"
        DisplayMode="Overlay"
        IsResizable="True">
        <controls:RightDrawerHost.MainContent>
          <DataGrid
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Style="{StaticResource SwiftExportDataGrid}"
            IsReadOnly="True"
            AutoGenerateColumns="False"
            RowHeight="60"
            EnableRowVirtualization="True"
            EnableColumnVirtualization="True"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            ClipboardCopyMode="IncludeHeader"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            gridCore:GridRowHeader.ShowRowNumber="True"
            ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
            dgx:DataGridFilter.IsAutoFilterEnabled="True"
            dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
            PreviewMouseRightButtonDown="OnDemandRightClick"
            MouseDoubleClick="OnDemandDoubleClick"
            AutomationProperties.Name="成品需求当前加载数据">
            <i:Interaction.Behaviors>
              <gridCore:DataGridColumnVisibilityBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
              <ContextMenu
                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem
                  Header="查看来源单据"
                  Command="{Binding OpenSourceCommand}" />
                <MenuItem
                  Header="打开跟踪"
                  Command="{Binding OpenTraceCommand}" />
                <MenuItem
                  Header="编辑独立需求"
                  Command="{Binding EditSelectedManualCommand}" />
                <MenuItem
                  Header="关闭独立需求"
                  Command="{Binding CloseSelectedManualCommand}" />
                <Separator />
                <MenuItem
                  Header="复制所选行（可多选）"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="来源单号"
                Width="140"
                Binding="{Binding SourceNo}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTemplateColumn
                Header="图片"
                Width="64"
                ClipboardContentBinding="{Binding ImagePath}"
                dgx:DataGridFilterColumn.IsFilterVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <controls:CachedImage
                      Width="56"
                      Height="56"
                      SourcePath="{Binding ImagePath}"
                      Style="{StaticResource SwiftExportCachedImage}"
                      Stretch="Uniform"
                      DecodePixelWidth="80" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn
                Header="产品编码"
                Width="130"
                Binding="{Binding Sku}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="中性型号"
                Width="120"
                Binding="{Binding LinkSku}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="客户型号"
                Width="120"
                Binding="{Binding CustomerSku}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="数量"
                Width="100"
                Binding="{Binding DemandQty, StringFormat={}{0:0.############################}}"
                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="单位"
                Width="70"
                Binding="{Binding Unit}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="要求交期"
                Width="110"
                Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd}"
                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="需求类型"
                Width="90"
                Binding="{Binding ItemTypeText}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="状态"
                Width="80"
                Binding="{Binding LifecycleStatusText}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="来源"
                Width="80"
                Binding="{Binding SourceTypeText}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="来源行"
                Width="70"
                Binding="{Binding SourceLineNumber}"
                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="描述"
                Width="200"
                Binding="{Binding Description}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="颜色"
                Width="100"
                Binding="{Binding Color}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="规格"
                Width="150"
                Binding="{Binding Specification}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="备注"
                Width="180"
                Binding="{Binding Remark}"
                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="创建人"
                Width="90"
                Binding="{Binding CreatedBy}"
                Visibility="Collapsed"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
              <DataGridTextColumn
                Header="创建时间"
                Width="140"
                Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd HH:mm}"
                Visibility="Collapsed"
                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            </DataGrid.Columns>
          </DataGrid>
        </controls:RightDrawerHost.MainContent>
      </controls:RightDrawerHost>
      <DockPanel
        Grid.Row="4"
        Margin="0,8,0,0">
        <StackPanel>
          <TextBlock
            Text="{Binding ResultSummary}"
            TextWrapping="Wrap" />
          <TextBlock
            Text="{Binding PageStatus}"
            Style="{StaticResource CaptionTextBlock}" />
        </StackPanel>
        <controls:PageNavigator
          HorizontalAlignment="Right"
          TotalCount="{Binding TotalCount}"
          PageIndex="{Binding PageIndex}"
          PageSize="{Binding PageSize}"
          PageChangeCommand="{Binding PageChangeCommand}">
          <controls:PageNavigator.Style>
            <Style
              TargetType="controls:PageNavigator">
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding IsSourceSelected}"
                  Value="True">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:PageNavigator.Style>
        </controls:PageNavigator>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
