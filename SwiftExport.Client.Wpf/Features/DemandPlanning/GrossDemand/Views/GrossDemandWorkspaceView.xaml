<UserControl
    x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
    xmlns:views="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.Views">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:GrossDemandManualEditorViewModel}">
            <views:GrossDemandManualEditorView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style
            x:Key="OptionalMessage"
            BasedOn="{StaticResource {x:Type TextBlock}}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="SourcePanel"
            Width="240"
            MinWidth="160"
            MaxWidth="440"
            Padding="4"
            Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="4,2,4,8"
                    FontWeight="SemiBold"
                    Text="来源导航" />
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <controls:DropDownCheckBox
                        MinWidth="105"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding LifecycleStatusOptions}"
                        Placeholder="来源状态"
                        SelectedItems="{Binding SourceLifecycleStatuses, Mode=OneWay}" />
                    <Button
                        Margin="4,0,0,0"
                        Command="{Binding ClearSourceFiltersCommand}"
                        Content="清空筛选" />
                </WrapPanel>
                <ListBox
                    x:Name="SourceList"
                    Grid.Row="2"
                    ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}"
                    ItemsSource="{Binding SourceGroups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
                    SelectionChanged="OnSourceGroupSelectionChanged"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding DisplaySourceNo}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SourceNo}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding SourceTypeText}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding CountText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    Grid.Row="3"
                    Margin="4,8,4,0"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding SourceGroupSummary}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Thumb
            Grid.Column="1"
            Width="6"
            Cursor="SizeWE"
            DragDelta="OnSourceResizeDelta"
            ToolTip="拖动调整来源导航宽度"
            Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Grid.Column="2" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="成品需求" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding CreateManualCommand}"
                    Content="新增独立需求" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding EditSelectedManualCommand}"
                    Content="编辑独立需求" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding CloseSelectedManualCommand}"
                    Content="关闭独立需求" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding OpenSourceCommand}"
                    Content="查看来源单据"
                    ToolTip="按现有来源单据权限打开，独立需求可通过编辑查看。" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding OpenTraceCommand}"
                    Content="打开跟踪"
                    ToolTip="打开订单跟踪明细，需要订单跟踪查看权限。" />
                <ToggleButton
                    Margin="0,0,8,4"
                    Command="{Binding ToggleSourcePanelCommand}"
                    Content="来源导航"
                    IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding ReturnToAllCommand}"
                    Content="返回全部需求"
                    Visibility="{Binding IsSourceSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
            <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding CanEditMainFilters}">
                    <ui:TextBox
                        x:Name="KeywordBox"
                        Width="260"
                        Margin="0,0,8,4"
                        AutomationProperties.Name="成品需求关键词"
                        PlaceholderText="单号、产品/中性/客户型号或描述"
                        Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="来源单号、产品编码、中性型号、客户型号或描述">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <lookup:MultiSelectLookupButton
                        MinWidth="100"
                        Margin="0,0,8,4"
                        DisplayMemberPath="DisplayText"
                        Header="来源类型"
                        ItemsSource="{Binding SourceTypeOptions}"
                        SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}" />
                    <lookup:MultiSelectLookupButton
                        MinWidth="100"
                        Margin="0,0,8,4"
                        DisplayMemberPath="DisplayText"
                        Header="生命周期"
                        ItemsSource="{Binding LifecycleStatusOptions}"
                        SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" />
                    <ComboBox
                        MinWidth="100"
                        Margin="0,0,8,4"
                        AutomationProperties.Name="需求类型"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding StandardTypeOptions}"
                        SelectedItem="{Binding SelectedStandardType}" />
                    <lookup:MultiSelectLookupButton
                        x:Name="CustomerSelector"
                        MinWidth="130"
                        Margin="0,0,8,4"
                        AutomationProperties.Name="成品需求客户多选"
                        DisplayMemberPath="DisplayText"
                        Header="客户"
                        ItemsSource="{Binding CustomerOptions}"
                        SelectedItems="{Binding SelectedCustomers, Mode=OneWay}" />
                    <ToggleButton
                        x:Name="OptionsToggle"
                        Margin="0,0,8,4"
                        Content="更多条件"
                        IsChecked="{Binding IsMultiLineFilterOpen, Mode=TwoWay}" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding SearchCommand}"
                        Content="查询" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空并查询" />
                </WrapPanel>
                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    StaysOpen="False"
                    VerticalOffset="4">
                    <Border
                        Padding="12"
                        Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="更多条件 · 修改后点击应用，收起会保留输入。" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="要求交期起" />
                                <DatePicker
                                    Width="135"
                                    Margin="0,0,12,0"
                                    SelectedDate="{Binding RequiredDateFrom}" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="至" />
                                <DatePicker Width="135" SelectedDate="{Binding RequiredDateTo}" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="来源单号（每行一项）" />
                                    <TextBox
                                        Height="150"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量来源单号"
                                        Text="{Binding SourceNosText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="产品编码（每行一项）" />
                                    <TextBox
                                        Height="150"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量产品编码"
                                        Text="{Binding SkusText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="客户型号（每行一项）" />
                                    <TextBox
                                        Height="150"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量客户型号"
                                        Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding ApplyMoreFiltersCommand}"
                                    Content="应用并查询" />
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding ClearMoreFiltersCommand}"
                                    Content="清空更多条件" />
                                <Button Command="{Binding CollapseMoreFiltersCommand}" Content="收起" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,6">
                <WrapPanel>
                    <TextBlock
                        MaxWidth="720"
                        Margin="0,0,8,4"
                        VerticalAlignment="Center"
                        Text="{Binding QueryModeText}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding RefreshCommand}"
                        Content="刷新已应用查询" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{x:Static commands:DataGridFilterCommands.Clear}"
                        CommandParameter="{Binding ElementName=GrossDrawer, Path=MainContent}"
                        Content="清除当前表头筛选" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding CustomerLoadError}" />
                    <Button
                        Margin="8,0,0,4"
                        Command="{Binding RefreshCustomerOptionsCommand}"
                        Content="刷新客户候选" />
                </WrapPanel>
            </StackPanel>
            <controls:RightDrawerHost
                x:Name="GrossDrawer"
                Grid.Row="3"
                CloseCommand="{Binding CloseDrawerCommand}"
                CloseOnEscape="True"
                DisplayMode="Overlay"
                DrawerContent="{Binding ActiveDrawerContent}"
                DrawerWidth="1050"
                IsOpen="{Binding IsDrawerOpen, Mode=OneWay}"
                IsResizable="True"
                MaxDrawerWidth="1050"
                MinDrawerWidth="440">
                <controls:RightDrawerHost.MainContent>
                    <DataGrid
                        dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
                        dgx:DataGridFilter.IsAutoFilterEnabled="True"
                        gridCore:GridRowHeader.ShowRowNumber="True"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="成品需求当前加载数据"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        ClipboardCopyMode="IncludeHeader"
                        ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        IsReadOnly="True"
                        ItemsSource="{Binding Items}"
                        MouseDoubleClick="OnDemandDoubleClick"
                        PreviewMouseRightButtonDown="OnDemandRightClick"
                        RowHeight="60"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        Style="{StaticResource SwiftExportDataGrid}">
                        <i:Interaction.Behaviors>
                            <gridCore:DataGridColumnVisibilityBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding OpenSourceCommand}" Header="查看来源单据" />
                                <MenuItem Command="{Binding OpenTraceCommand}" Header="打开跟踪" />
                                <MenuItem Command="{Binding EditSelectedManualCommand}" Header="编辑独立需求" />
                                <MenuItem Command="{Binding CloseSelectedManualCommand}" Header="关闭独立需求" />
                                <Separator />
                                <MenuItem
                                    Command="ApplicationCommands.Copy"
                                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="复制所选行（可多选）" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="140"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding SourceNo}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="来源单号" />
                            <DataGridTemplateColumn
                                Width="64"
                                dgx:DataGridFilterColumn.IsFilterVisible="False"
                                ClipboardContentBinding="{Binding ImagePath}"
                                Header="图片">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage
                                            Width="56"
                                            Height="56"
                                            DecodePixelWidth="80"
                                            SourcePath="{Binding ImagePath}"
                                            Stretch="Uniform"
                                            Style="{StaticResource SwiftExportCachedImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="130"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Sku}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="产品编码" />
                            <DataGridTextColumn
                                Width="120"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding LinkSku}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="中性型号" />
                            <DataGridTextColumn
                                Width="120"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding CustomerSku}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="客户型号" />
                            <DataGridTextColumn
                                Width="100"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding DemandQty, StringFormat={}{0:0.############################}}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="数量" />
                            <DataGridTextColumn
                                Width="70"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Unit}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="单位" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd}"
                                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                Header="要求交期" />
                            <DataGridTextColumn
                                Width="90"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding ItemTypeText}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="需求类型" />
                            <DataGridTextColumn
                                Width="80"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding LifecycleStatusText}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="状态" />
                            <DataGridTextColumn
                                Width="80"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding SourceTypeText}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="来源" />
                            <DataGridTextColumn
                                Width="70"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding SourceLineNumber}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="来源行" />
                            <DataGridTextColumn
                                Width="200"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Description}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="描述" />
                            <DataGridTextColumn
                                Width="100"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Color}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="颜色" />
                            <DataGridTextColumn
                                Width="150"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Specification}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="规格" />
                            <DataGridTextColumn
                                Width="180"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Remark}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="备注" />
                            <DataGridTextColumn
                                Width="90"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding CreatedBy}"
                                Header="创建人"
                                Visibility="Collapsed" />
                            <DataGridTextColumn
                                Width="140"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd HH:mm}"
                                Header="创建时间"
                                Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RightDrawerHost.MainContent>
            </controls:RightDrawerHost>
            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding PageStatus}" />
                </StackPanel>
                <controls:PageNavigator
                    HorizontalAlignment="Right"
                    PageChangeCommand="{Binding PageChangeCommand}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageIndex="{Binding PageIndex}">
                    <controls:PageNavigator.Style>
                        <Style TargetType="controls:PageNavigator">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:PageNavigator.Style>
                </controls:PageNavigator>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
