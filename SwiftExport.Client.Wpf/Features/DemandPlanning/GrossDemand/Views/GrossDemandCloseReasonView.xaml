<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.GrossDemand.Views.GrossDemandCloseReasonView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="4" FocusManager.FocusedElement="{Binding ElementName=ReasonBox}">
  <TextBlock Text="{Binding SourceNo}" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Text="关闭后保留需求历史，不能继续建立物料需求。已有活动物料需求时由服务端拒绝关闭。请填写本次关闭原因。" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <Label Content="关闭原因（必填，最多500字）" Target="{Binding ElementName=ReasonBox}"/>
  <TextBox x:Name="ReasonBox" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="独立需求关闭原因"/>
 </StackPanel>
</UserControl>
