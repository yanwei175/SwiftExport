<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.MaterialDemandTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12,8" RowDefinitions="Auto,Auto,Auto,*">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="刷新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" MinWidth="70" />
            <Button Content="打开来源追踪" Command="{Binding OpenSourceTraceCommand}" DockPanel.Dock="Right" MinWidth="100" Margin="0,0,8,0" />
            <TextBlock Text="{Binding DocumentTitle}" FontSize="20" FontWeight="SemiBold" />
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="状态："/><TextBlock Text="{Binding Detail.LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,0,16,0"/>
            <TextBlock Text="拆解修订："/><TextBlock Text="{Binding Detail.DecompositionRevision}" Margin="0,0,16,0"/>
            <TextBlock Text="净需求："/><TextBlock Text="{Binding Detail.NetQty, StringFormat=N1}"/>
            <TextBlock Text="{Binding Detail.Unit}" Margin="4,0,16,0"/>
            <TextBlock Text="有效承接："/><TextBlock Text="{Binding Detail.AssociatedPurchaseQty, StringFormat=N1, TargetNullValue=需核实}" Margin="0,0,16,0"/>
            <TextBlock Text="当前收货覆盖："/><TextBlock Text="{Binding Detail.CurrentReceiptCoverageQty, StringFormat=N1, TargetNullValue=需核实}" Margin="0,0,16,0"/>
            <TextBlock Text="交期："/><TextBlock Text="{Binding Detail.RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未设置}"/>
        </WrapPanel>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*,8,Auto,2*">
            <DockPanel Grid.Row="0"><TextBlock Text="同树拆解修订与父子关系"/>
                <TextBlock DockPanel.Dock="Right" Text="回退原因："/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail.RolledBackReason}"/>
            </DockPanel>
            <ui:Card Grid.Row="1" Padding="0">
                <DataGrid ItemsSource="{Binding Detail.TreeItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="修订" Binding="{Binding DecompositionRevision}" Width="60"/>
                        <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="40"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="70"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/>
                        <DataGridTextColumn Header="父行 Uid" Binding="{Binding ParentNetDemandId}" Width="240"/>
                        <DataGridTextColumn Header="净需求" Binding="{Binding NetQty, StringFormat=N1}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>
            <DockPanel Grid.Row="3" Margin="0,8,0,4">
                <Button Content="打开采购详情" Command="{Binding OpenPurchaseCommand}" DockPanel.Dock="Right"/>
                <TextBlock Text="采购关联、整行货好／实收与当前覆盖。未覆盖实收是查询投影，不代表历史归属或专属库存。"/>
            </DockPanel>
            <ui:Card Grid.Row="4" Padding="0">
                <DataGrid ItemsSource="{Binding Detail.Purchases}" SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="采购单" Binding="{Binding PurchaseOrderNo}" Width="115"/>
                        <DataGridTextColumn Header="行" Binding="{Binding PurchaseLineNumber}" Width="40"/>
                        <DataGridTextColumn Header="实际供应商" Binding="{Binding ActualSupplierName}" Width="130"/>
                        <DataGridTextColumn Header="单据" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="70"/>
                        <DataGridTextColumn Header="确认" Binding="{Binding ConfirmationStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="70"/>
                        <DataGridCheckBoxColumn Header="活动 Link" Binding="{Binding IsActiveLink}" Width="75"/>
                        <DataGridTextColumn Header="原分配" Binding="{Binding AllocatedQty, StringFormat=N1}" Width="75"/>
                        <DataGridTextColumn Header="已释放" Binding="{Binding ReleasedQty, StringFormat=N1}" Width="70"/>
                        <DataGridTextColumn Header="净贡献" Binding="{Binding LinkedQty, StringFormat=N1}" Width="70"/>
                        <DataGridTextColumn Header="整行货好" Binding="{Binding PurchaseLineReadyQty, StringFormat=N1, TargetNullValue=未反馈}" Width="80"/>
                        <DataGridTextColumn Header="整行实收" Binding="{Binding PurchaseLineReceivedQty, StringFormat=N1}" Width="80"/>
                        <DataGridTextColumn Header="当前覆盖" Binding="{Binding CurrentReceiptCoverageQty, StringFormat=N1, TargetNullValue=需核实}" Width="80"/>
                        <DataGridTextColumn Header="未覆盖实收" Binding="{Binding ReceiptOutsideCurrentCoverageQty, StringFormat=N1, TargetNullValue=需核实}" Width="85"/>
                        <DataGridTextColumn Header="历史贡献" Binding="{Binding HistoricalLinkedQty, StringFormat=N1}" Width="80"/>
                        <DataGridCheckBoxColumn Header="共享行" Binding="{Binding IsSharedPurchaseLine}" Width="65"/>
                        <DataGridTextColumn Header="提示" Binding="{Binding ReviewReason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
