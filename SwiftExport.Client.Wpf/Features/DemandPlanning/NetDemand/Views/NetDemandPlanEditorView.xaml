<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.NetDemandPlanEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SinglePlanField" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12" RowDefinitions="Auto,12,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,12,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="净需求计划" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="保存计划" Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Padding="12,5" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                <StackPanel>
                    <TextBlock Text="来源" Style="{StaticResource CaptionTextBlock}" />
                    <TextBlock Text="{Binding SourceSummary}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SKU / 角色" Style="{StaticResource CaptionTextBlock}" />
                    <TextBlock><Run Text="{Binding Sku, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DemandRoleText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*,12,*">
                <StackPanel>
                    <TextBlock Text="计划数量" Style="{StaticResource CaptionTextBlock}" />
                    <TextBlock Text="{Binding PlannedQty, StringFormat=N4}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource SinglePlanField}">
                    <TextBlock Text="原需求交期（不可修改）" Style="{StaticResource CaptionTextBlock}" />
                    <TextBlock Text="{Binding DemandRequiredDate, StringFormat=yyyy-MM-dd}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="6" Style="{StaticResource SinglePlanField}">
                <TextBlock Text="执行方式" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ExecutionTypeOptions}" DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                          SelectedValue="{Binding ExecutionType, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="8" Style="{StaticResource SinglePlanField}">
                <TextBlock Text="计划交期" Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding PlannedDeliveryDate}" />
            </StackPanel>

            <StackPanel Grid.Row="10">
                <TextBlock Text="采购供应商" Margin="0,0,0,4" />
                <controls:LookupTextBox Placeholder="输入供应商代码或名称"
                                        SearchMode="Remote" MinimumSearchLength="0"
                                        Text="{Binding SupplierKeyword, Mode=TwoWay}"
                                        ItemsSource="{Binding SupplierCandidates}"
                                        DisplayMemberPath="SupplierName" FilterMemberPaths="SupplierCode,SupplierName"
                                        SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                        SelectedValuePath="Uid" SearchCommand="{Binding SearchSuppliersCommand}"
                                        IsBusy="{Binding IsSupplierLookupBusy}" />
            </StackPanel>

            <StackPanel Grid.Row="12" Style="{StaticResource SinglePlanField}">
                <TextBlock Text="送达目标" Margin="0,0,0,4" />
                <TextBox Text="{Binding DeliveryTargetSummary, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Text="客供件送达供应商由父件计划联动，客户端不能直接修改。"
                           Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>

            <StackPanel Grid.Row="14">
                <TextBlock Text="{Binding RelatedPlansSummary}" FontWeight="SemiBold" />
                <DataGrid ItemsSource="{Binding RelatedCustomerSuppliedPlans}" Margin="0,4,0,8" MaxHeight="150"
                          Visibility="{Binding HasRelatedCustomerSuppliedPlans, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="客供件 SKU" Width="120" Binding="{Binding Sku}" />
                        <DataGridTextColumn Header="采购供应商" Width="150" Binding="{Binding PurchaseSupplierName, TargetNullValue=待分配}" />
                        <DataGridTextColumn Header="当前送达目标" Width="150" Binding="{Binding DeliveryTargetSupplierName, TargetNullValue=待父件分配}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding BlockersSummary}" FontWeight="SemiBold" />
                <DataGrid ItemsSource="{Binding BlockingExecutionLinks}" Margin="0,4,0,8" MaxHeight="150"
                          Visibility="{Binding HasBlockingExecutionLinks, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="执行单号" Width="140" Binding="{Binding TargetNo}" />
                        <DataGridTextColumn Header="行" Width="50" Binding="{Binding TargetLineNumber}" />
                        <DataGridTextColumn Header="已分配数量" Width="100" Binding="{Binding AllocatedQty, StringFormat=N4}" />
                        <DataGridTextColumn Header="状态" Width="90" Binding="{Binding LinkStatus}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="存在上述阻断时，请先取消安全采购草稿；已进入正式执行的单据必须走反向处理。"
                           TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource SwiftExportBrush.Error}"
                           Visibility="{Binding HasBlockingExecutionLinks, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="变更原因（必填）" Margin="0,0,0,4" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
            </StackPanel>

            <TextBlock Grid.Row="16" Text="{Binding ValidationSummary}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SwiftExportBrush.Error}" />
        </Grid>
    </ScrollViewer>
</UserControl>
