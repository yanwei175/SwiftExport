<UserControl
    x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.NetDemandManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:procurementComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Border
            Width="240"
            Margin="0,0,8,0"
            Padding="8"
            Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            DockPanel.Dock="Left"
            Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowDefinitions="Auto,8,Auto,8,Auto,8,*,8,Auto">
                <TextBlock FontWeight="SemiBold" Text="来源导航 · 独立筛选" />
                <lookup:MultiSelectLookupButton
                    Grid.Row="2"
                    AutomationProperties.Name="来源导航类型多选"
                    DisplayMemberPath="DisplayText"
                    FilterMemberPaths="DisplayText"
                    ItemsSource="{Binding SourceTypeOptions}"
                    Placeholder="来源类型"
                    SelectedItems="{Binding SourceSourceTypes, Mode=OneWay}" />
                <WrapPanel Grid.Row="4">
                    <Button
                        Margin="0,0,4,4"
                        Command="{Binding ClearSourceFiltersCommand}"
                        Content="清空来源筛选" />
                    <Button
                        Margin="0,0,4,4"
                        Command="{Binding RefreshSourceGroupsCommand}"
                        Content="刷新来源" />
                </WrapPanel>
                <ListBox
                    Grid.Row="6"
                    AutomationProperties.Name="物料需求来源导航"
                    ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}"
                    ItemsSource="{Binding SourceGroups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
                    SelectionChanged="OnSourceGroupSelectionChanged"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding DisplaySourceNo}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SourceNo}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding SourceTypeText}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding CountText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    Grid.Row="8"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding SourceGroupSummary}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <WrapPanel Margin="0,0,0,8">
                <TextBlock
                    Margin="0,0,16,4"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="物料需求" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding EstablishFromSourcesCommand}"
                    Content="从成品需求建立" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding RollbackSourceEstablishmentCommand}"
                    Content="安全回退" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding SaveSuggestedSuppliersCommand}"
                    Content="保存推荐采购供应商" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding CancelSuggestedSupplierChangesCommand}"
                    Content="取消修改" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding OpenTraceCommand}"
                    Content="打开物料跟踪" />
                <ToggleButton
                    Margin="0,0,8,4"
                    Command="{Binding ToggleSourcePanelCommand}"
                    Content="来源导航"
                    IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding RefreshCommand}"
                    Content="刷新已应用查询" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding ReturnToAllCommand}"
                    Content="返回全部物料需求" />
            </WrapPanel>
            <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding CanEditMainFilters}">
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,8,4"
                        AutomationProperties.Name="物料需求关键词"
                        PlaceholderText="来源单号、SKU、客户型号或描述"
                        Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <lookup:MultiSelectLookupButton
                        Margin="0,0,8,4"
                        AutomationProperties.Name="查询来源类型多选"
                        DisplayMemberPath="DisplayText"
                        FilterMemberPaths="DisplayText"
                        ItemsSource="{Binding SourceTypeOptions}"
                        Placeholder="来源类型"
                        SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}" />
                    <ComboBox
                        Width="105"
                        Margin="0,0,8,4"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="物料生命周期"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding LifecycleOptions}"
                        SelectedItem="{Binding SelectedLifecycle}" />
                    <ComboBox
                        Width="125"
                        Margin="0,0,8,4"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="采购承接快捷条件"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding QuickViewOptions}"
                        SelectedItem="{Binding SelectedQuickView}" />
                    <ComboBox
                        Width="100"
                        Margin="0,0,8,4"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="物料角色"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding DemandRoleOptions}"
                        SelectedItem="{Binding SelectedDemandRole}" />
                    <ToggleButton
                        x:Name="OptionsToggle"
                        Margin="0,0,8,4"
                        Content="更多条件"
                        IsChecked="{Binding IsMultiLineFilterOpen, Mode=TwoWay}" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding SearchCommand}"
                        Content="查询" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空条件并查询" />
                </WrapPanel>
                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    StaysOpen="False"
                    VerticalOffset="4">
                    <Border
                        Padding="12"
                        Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel IsEnabled="{Binding CanEditMainFilters}">
                            <TextBlock Margin="0,0,0,8" Text="更多条件 · 修改后点击应用，收起保留输入。" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="需求交期起" />
                                <DatePicker
                                    Width="136"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="需求交期起"
                                    SelectedDate="{Binding DemandRequiredDateFrom}" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="至" />
                                <DatePicker
                                    Width="136"
                                    AutomationProperties.Name="需求交期至"
                                    SelectedDate="{Binding DemandRequiredDateTo}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4" Text="来源单号（每行一项）" />
                                    <TextBox
                                        Height="152"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量来源单号"
                                        Text="{Binding SourceNosText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        ToolTip="来源单号，每行一项"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4" Text="物料编号（每行一项）" />
                                    <TextBox
                                        Height="152"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量物料编号"
                                        Text="{Binding SkusText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        ToolTip="物料编号，每行一项"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Margin="0,0,0,4" Text="客户型号（每行一项）" />
                                    <TextBox
                                        Height="152"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="批量客户型号"
                                        Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        ToolTip="客户型号，每行一项"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <ui:TextBox
                                    Width="232"
                                    Margin="0,0,8,4"
                                    AutomationProperties.Name="推荐采购供应商条件"
                                    PlaceholderText="推荐采购供应商编码/名称"
                                    Text="{Binding SuggestedSupplierKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox
                                    Width="232"
                                    Margin="0,0,8,4"
                                    AutomationProperties.Name="实际采购供应商条件"
                                    IsEnabled="{Binding CanViewPurchaseDetails}"
                                    PlaceholderText="实际采购供应商编码/名称"
                                    Text="{Binding ActualSupplierKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox
                                    Width="232"
                                    Margin="0,0,8,4"
                                    AutomationProperties.Name="采购单号条件"
                                    IsEnabled="{Binding CanViewPurchaseDetails}"
                                    PlaceholderText="采购单号（精确）"
                                    Text="{Binding PurchaseOrderNoFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding ApplyMoreFiltersCommand}"
                                    Content="应用" />
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding ClearMoreFiltersCommand}"
                                    Content="清除更多条件" />
                                <Button Command="{Binding CollapseMoreFiltersCommand}" Content="收起" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding QueryModeText}" TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlock}"
                    Text="表头筛选只影响当前已加载数据；表头全选只勾选当前可见行。回退始终按成品需求整修订执行。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding PurchasePermissionHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <DataGrid
                x:Name="MaterialGrid"
                Grid.Row="3"
                dgx:DataGridFilter.IsAutoFilterEnabled="True"
                gridCore:GridRowHeader.ShowRowNumber="True"
                AutoGenerateColumns="False"
                ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                FontSize="{StaticResource SwiftExportDefaltFontSize}"
                FrozenColumnCount="8"
                IsReadOnly="{Binding IsSuggestionReadOnly}"
                ItemsSource="{Binding Items}"
                Loaded="OnGridLoaded"
                PreviewMouseRightButtonDown="OnDemandRightClick"
                RowHeight="60"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource SwiftExportDataGrid}"
                Tag="{Binding}"
                Unloaded="OnGridUnloaded">
                <i:Interaction.Behaviors>
                    <gridCore:DataGridColumnVisibilityBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem
                            Command="{x:Static ApplicationCommands.Copy}"
                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="复制所选行" />
                        <MenuItem Command="{Binding OpenTraceCommand}" Header="打开物料跟踪" />
                        <MenuItem Command="{Binding RollbackSourceEstablishmentCommand}" Header="安全回退整个物料修订" />
                        <Separator />
                        <MenuItem
                            Command="{x:Static commands:DataGridFilterCommands.Clear}"
                            CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="清除当前表头筛选" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="45"
                        dgx:DataGridFilterColumn.IsFilterVisible="False"
                        CanUserSort="False"
                        ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                        HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" IsThreeState="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="60"
                        dgx:DataGridFilterColumn.IsFilterVisible="False"
                        CanUserSort="False"
                        Header="图片"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="56"
                                    Height="56"
                                    Margin="2"
                                    DecodePixelWidth="80"
                                    SourcePath="{Binding ImagePath}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="76"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding LifecycleStatusText}"
                        Header="状态"
                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LifecycleStatusText}" Value="活动">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LifecycleStatusText}" Value="已回退">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LifecycleStatusText}" Value="已作废">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceTypeText}"
                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                        Header="来源"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                        Header="来源单号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="44"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceLineNumber}"
                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                        Header="行"
                        IsReadOnly="True"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="70"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DemandRoleText}"
                        Header="角色"
                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DemandRoleText}" Value="父件">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DemandRoleText}" Value="客供件">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DisplaySku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="物料编号"
                        IsReadOnly="True"
                        SortMemberPath="Sku" />
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding LinkSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="产品型号"
                        IsReadOnly="True"
                        SortMemberPath="LinkSku" />
                    <DataGridTextColumn
                        Width="140"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户型号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="96"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SupplyType}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="供货方式"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn
                        Width="136"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        ClipboardContentBinding="{Binding SuggestedPurchaseSupplierDisplay, Mode=OneWay}"
                        Header="推荐采购供应商"
                        SortMemberPath="SuggestedPurchaseSupplierDisplay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SuggestedPurchaseSupplierDisplay}" ToolTip="{Binding SuggestedPurchaseSupplierName}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}" TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SuggestedPurchaseSupplierDisplay}" Value="未设置">
                                                    <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <procurementComponents:PurchaseSupplierLookupTextBox
                                    AutomationProperties.Name="推荐采购供应商"
                                    IsBusy="{Binding DataContext.IsSuggestedSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    IsEnabled="{Binding IsSuggestionEditable}"
                                    ItemsSource="{Binding DataContext.SuggestedSupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Placeholder="搜索推荐采购供应商"
                                    SearchCommand="{Binding DataContext.SearchSuggestedSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedSupplier="{Binding SuggestedPurchaseSupplierSelection, Mode=OneWay}"
                                    SelectionClearedCommand="{Binding ClearSuggestedSupplierSelectionCommand}"
                                    SelectionCommittedCommand="{Binding CommitSuggestedSupplierSelectionCommand}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SuggestedDeliverySupplierDisplay, TargetNullValue=未确定}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客供送至"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="112"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DemandRequiredDate, StringFormat=yyyy-MM-dd}"
                        ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                        Header="原需求交期"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="96"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding NetQty, StringFormat=0.############################}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="物料需求"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="76"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Unit}"
                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                        Header="单位"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="112"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding AssociatedPurchaseQty, StringFormat=0.############################}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="采购总占用"
                        IsReadOnly="True"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="104"
                        Binding="{Binding PurchasedQty, StringFormat=0.####, TargetNullValue=需核实}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="已采购"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="104"
                        Binding="{Binding DraftOccupiedQty, StringFormat=0.####, TargetNullValue=需核实}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="草稿占用"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="104"
                        Binding="{Binding UnpurchasedQty, StringFormat=0.####, TargetNullValue=需核实}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="未采购"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="96"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CreatableQty, StringFormat=0.####, TargetNullValue=需核实}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="可创建"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        Width="160"
                        Header="占用草稿"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding DraftOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding DataContext.OpenDraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding OrderNo}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="96"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ProcurementStatus}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="承接状态"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="96"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DueHint}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="交期提示"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="140"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ActualPurchaseSuppliers}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="实际采购供应商"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ReviewReason}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="需核实"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding PurchaseOrderNos}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                        Header="采购单号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="200"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Description}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="描述"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding RootSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="根SKU"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid
                Grid.Row="4"
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding ResultSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding CheckedCount, StringFormat=已选 {0} 条}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding PageStatus}" />
                <controls:PageNavigator
                    Grid.Column="3"
                    PageChangeCommand="{Binding PageChangeCommand}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageIndex="{Binding PageIndex}">
                    <controls:PageNavigator.Style>
                        <Style TargetType="controls:PageNavigator">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:PageNavigator.Style>
                </controls:PageNavigator>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>