<UserControl
  x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.NetDemandManagerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
  xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
  xmlns:procurementComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
  xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
  xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
  xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
  <UserControl.Resources>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <DockPanel
    Margin="12">
    <Border
      DockPanel.Dock="Left"
      Width="240"
      Margin="0,0,8,0"
      Padding="8"
      BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4"
      Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid
        RowDefinitions="Auto,8,Auto,8,Auto,8,*,8,Auto">
        <TextBlock
          Text="来源导航 · 独立筛选"
          FontWeight="SemiBold" />
        <lookup:MultiSelectLookupButton
          Grid.Row="2"
          Placeholder="来源类型"
          ItemsSource="{Binding SourceTypeOptions}"
          SelectedItems="{Binding SourceSourceTypes, Mode=OneWay}"
          DisplayMemberPath="DisplayText"
          FilterMemberPaths="DisplayText"
          AutomationProperties.Name="来源导航类型多选" />
        <WrapPanel
          Grid.Row="4">
          <Button
            Content="清空来源筛选"
            Command="{Binding ClearSourceFiltersCommand}"
            Margin="0,0,4,4" />
          <Button
            Content="刷新来源"
            Command="{Binding RefreshSourceGroupsCommand}"
            Margin="0,0,4,4" />
        </WrapPanel>
        <ListBox
          Grid.Row="6"
          ItemsSource="{Binding SourceGroups}"
          SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
          SelectionChanged="OnSourceGroupSelectionChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
          ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}"
          AutomationProperties.Name="物料需求来源导航">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock
                    Text="{Binding DisplaySourceNo}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding SourceNo}" />
                  <TextBlock
                    Text="{Binding SourceTypeText}"
                    Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding CountText}"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock
          Grid.Row="8"
          Text="{Binding SourceGroupSummary}"
          TextWrapping="Wrap"
          Style="{StaticResource CaptionTextBlock}" />
      </Grid>
    </Border>
    <Grid
      RowDefinitions="Auto,Auto,Auto,*,Auto">
      <WrapPanel
        Margin="0,0,0,8">
        <TextBlock
          Text="物料需求"
          Style="{StaticResource SubtitleTextBlock}"
          VerticalAlignment="Center"
          Margin="0,0,16,4" />
        <Button
          Content="从成品需求建立"
          Command="{Binding EstablishFromSourcesCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="安全回退"
          Command="{Binding RollbackSourceEstablishmentCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="保存推荐采购供应商"
          Command="{Binding SaveSuggestedSuppliersCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="取消修改"
          Command="{Binding CancelSuggestedSupplierChangesCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="打开物料跟踪"
          Command="{Binding OpenTraceCommand}"
          Margin="0,0,8,4" />
        <ToggleButton
          Content="来源导航"
          IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}"
          Command="{Binding ToggleSourcePanelCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="刷新已应用查询"
          Command="{Binding RefreshCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="返回全部物料需求"
          Command="{Binding ReturnToAllCommand}"
          Margin="0,0,8,4" />
      </WrapPanel>
      <StackPanel Grid.Row="1">
        <WrapPanel
          Margin="0,0,0,4"
          IsEnabled="{Binding CanEditMainFilters}">
          <ui:TextBox
            Width="260"
            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="来源单号、SKU、客户型号或描述"
            AutomationProperties.Name="物料需求关键词"
            Margin="0,0,8,4">
            <ui:TextBox.InputBindings>
              <KeyBinding
                Key="Enter"
                Command="{Binding SearchCommand}" />
            </ui:TextBox.InputBindings>
          </ui:TextBox>
          <lookup:MultiSelectLookupButton
            Placeholder="来源类型"
            ItemsSource="{Binding SourceTypeOptions}"
            SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}"
            DisplayMemberPath="DisplayText"
            FilterMemberPaths="DisplayText"
            Margin="0,0,8,4"
            AutomationProperties.Name="查询来源类型多选" />
          <ComboBox
            Width="105"
            ItemsSource="{Binding LifecycleOptions}"
            DisplayMemberPath="DisplayText"
            SelectedItem="{Binding SelectedLifecycle}"
            Margin="0,0,8,4"
            AutomationProperties.Name="物料生命周期" />
          <ComboBox
            Width="125"
            ItemsSource="{Binding QuickViewOptions}"
            DisplayMemberPath="DisplayText"
            SelectedItem="{Binding SelectedQuickView}"
            Margin="0,0,8,4"
            AutomationProperties.Name="采购承接快捷条件" />
          <ComboBox
            Width="100"
            ItemsSource="{Binding DemandRoleOptions}"
            DisplayMemberPath="DisplayText"
            SelectedItem="{Binding SelectedDemandRole}"
            Margin="0,0,8,4"
            AutomationProperties.Name="物料角色" />
          <ToggleButton
            x:Name="OptionsToggle"
            Content="更多条件"
            IsChecked="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
            Margin="0,0,8,4" />
          <Button
            Content="查询"
            Command="{Binding SearchCommand}"
            Margin="0,0,8,4" />
          <Button
            Content="清空条件并查询"
            Command="{Binding ClearFiltersCommand}"
            Margin="0,0,8,4" />
        </WrapPanel>
        <Popup
          IsOpen="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
          Placement="Bottom"
          PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
          Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
          VerticalOffset="4"
          StaysOpen="False"
          AllowsTransparency="True">
          <Border
            Padding="12"
            Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel
              IsEnabled="{Binding CanEditMainFilters}">
              <TextBlock
                Text="更多条件 · 修改后点击应用，收起保留输入。"
                Margin="0,0,0,8" />
              <WrapPanel
                Margin="0,0,0,8">
                <TextBlock
                  Text="需求交期起"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0" />
                <DatePicker
                  SelectedDate="{Binding DemandRequiredDateFrom}"
                  Width="136"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="需求交期起" />
                <TextBlock
                  Text="至"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0" />
                <DatePicker
                  SelectedDate="{Binding DemandRequiredDateTo}"
                  Width="136"
                  AutomationProperties.Name="需求交期至" />
              </WrapPanel>
              <Grid
                ColumnDefinitions="*,8,*,8,*">
                <StackPanel
                  Grid.Column="0">
                  <TextBlock
                    Text="来源单号（每行一项）"
                    Margin="0,0,0,4" />
                  <TextBox
                    Text="{Binding SourceNosText, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="152"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="批量来源单号"
                    ToolTip="来源单号，每行一项" />
                </StackPanel>
                <StackPanel
                  Grid.Column="2">
                  <TextBlock
                    Text="物料编号（每行一项）"
                    Margin="0,0,0,4" />
                  <TextBox
                    Text="{Binding SkusText, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="152"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="批量物料编号"
                    ToolTip="物料编号，每行一项" />
                </StackPanel>
                <StackPanel
                  Grid.Column="4">
                  <TextBlock
                    Text="客户型号（每行一项）"
                    Margin="0,0,0,4" />
                  <TextBox
                    Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="152"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="批量客户型号"
                    ToolTip="客户型号，每行一项" />
                </StackPanel>
              </Grid>
              <WrapPanel
                Margin="0,8,0,0">
                <ui:TextBox
                  Width="232"
                  Text="{Binding SuggestedSupplierKeyword, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="推荐采购供应商编码/名称"
                  AutomationProperties.Name="推荐采购供应商条件"
                  Margin="0,0,8,4" />
                <ui:TextBox
                  Width="232"
                  Text="{Binding ActualSupplierKeyword, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="实际采购供应商编码/名称"
                  AutomationProperties.Name="实际采购供应商条件"
                  IsEnabled="{Binding CanViewPurchaseDetails}"
                  Margin="0,0,8,4" />
                <ui:TextBox
                  Width="232"
                  Text="{Binding PurchaseOrderNoFilter, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="采购单号（精确）"
                  AutomationProperties.Name="采购单号条件"
                  IsEnabled="{Binding CanViewPurchaseDetails}"
                  Margin="0,0,8,4" />
              </WrapPanel>
              <WrapPanel
                Margin="0,8,0,0">
                <Button
                  Content="应用"
                  Command="{Binding ApplyMoreFiltersCommand}"
                  Margin="0,0,8,0" />
                <Button
                  Content="清除更多条件"
                  Command="{Binding ClearMoreFiltersCommand}"
                  Margin="0,0,8,0" />
                <Button
                  Content="收起"
                  Command="{Binding CollapseMoreFiltersCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel
        Grid.Row="2"
        Margin="0,0,0,8">
        <TextBlock
          Text="{Binding QueryModeText}"
          TextWrapping="Wrap" />
        <TextBlock
          Text="表头筛选只影响当前已加载数据；表头全选只勾选当前可见行。回退始终按成品需求整修订执行。"
          TextWrapping="Wrap"
          Style="{StaticResource CaptionTextBlock}" />
        <TextBlock
          Text="{Binding PurchasePermissionHint}"
          TextWrapping="Wrap"
          Style="{StaticResource CaptionTextBlock}" />
      </StackPanel>
      <DataGrid
        Grid.Row="3"
        ItemsSource="{Binding Items}"
        Style="{StaticResource SwiftExportDataGrid}"
        AutoGenerateColumns="False"
        IsReadOnly="{Binding IsSuggestionReadOnly}"
        RowHeight="60"
        FontSize="{StaticResource SwiftExportDefaltFontSize}"
        FrozenColumnCount="8"
        SelectionMode="Extended"
        SelectionUnit="FullRow"
        EnableRowVirtualization="True"
        EnableColumnVirtualization="True"
        gridCore:GridRowHeader.ShowRowNumber="True"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        x:Name="MaterialGrid"
        dgx:DataGridFilter.IsAutoFilterEnabled="True"
        PreviewMouseRightButtonDown="OnDemandRightClick"
        Loaded="OnGridLoaded"
        Unloaded="OnGridUnloaded"
        Tag="{Binding}"
        ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}">
        <i:Interaction.Behaviors>
          <gridCore:DataGridColumnVisibilityBehavior />
        </i:Interaction.Behaviors>
        <DataGrid.ContextMenu>
          <ContextMenu
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem
              Header="复制所选行"
              Command="{x:Static ApplicationCommands.Copy}"
              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem
              Header="打开物料跟踪"
              Command="{Binding OpenTraceCommand}" />
            <MenuItem
              Header="安全回退整个物料修订"
              Command="{Binding RollbackSourceEstablishmentCommand}" />
            <Separator />
            <MenuItem
              Header="清除当前表头筛选"
              Command="{x:Static commands:DataGridFilterCommands.Clear}"
              CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn
            ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
            Width="45"
            CanUserSort="False"
            IsReadOnly="True"
            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}"
            dgx:DataGridFilterColumn.IsFilterVisible="False">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <CheckBox
                  IsThreeState="False"
                  IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox
                  HorizontalAlignment="Center"
                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="图片"
            Width="60"
            CanUserSort="False"
            IsReadOnly="True"
            dgx:DataGridFilterColumn.IsFilterVisible="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <controls:CachedImage
                  Width="56"
                  Height="56"
                  Margin="2"
                  Style="{StaticResource SwiftExportCachedImage}"
                  SourcePath="{Binding ImagePath}"
                  DecodePixelWidth="80"
                  Stretch="Uniform" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn
            Header="状态"
            Width="76"
            Binding="{Binding LifecycleStatusText}"
            IsReadOnly="True"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}">
            <DataGridTextColumn.ElementStyle>
              <Style
                TargetType="TextBlock"
                BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding LifecycleStatusText}"
                    Value="活动">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource UserBusinessTextAccentBrush}" />
                  </DataTrigger>
                  <DataTrigger
                    Binding="{Binding LifecycleStatusText}"
                    Value="已回退">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                  </DataTrigger>
                  <DataTrigger
                    Binding="{Binding LifecycleStatusText}"
                    Value="已作废">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn
            Header="来源"
            Width="80"
            Binding="{Binding SourceTypeText}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="来源单号"
            Width="100"
            Binding="{Binding SourceNo}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="行"
            Width="44"
            Binding="{Binding SourceLineNumber}"
            IsReadOnly="True"
            Visibility="Collapsed"
            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="角色"
            Width="70"
            Binding="{Binding DemandRoleText}"
            IsReadOnly="True"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}">
            <DataGridTextColumn.ElementStyle>
              <Style
                TargetType="TextBlock"
                BasedOn="{StaticResource SwiftExportDataGridTextBlock}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding DemandRoleText}"
                    Value="父件">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource UserBusinessTextAccentBrush}" />
                  </DataTrigger>
                  <DataTrigger
                    Binding="{Binding DemandRoleText}"
                    Value="客供件">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn
            Header="物料编号"
            Width="150"
            Binding="{Binding DisplaySku}"
            SortMemberPath="Sku"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="产品型号"
            Width="150"
            Binding="{Binding LinkSku}"
            SortMemberPath="LinkSku"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="客户型号"
            Width="140"
            Binding="{Binding CustomerSku}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="供货方式"
            Width="96"
            Binding="{Binding SupplyType}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTemplateColumn
            ClipboardContentBinding="{Binding SuggestedPurchaseSupplierDisplay, Mode=OneWay}"
            Header="推荐采购供应商"
            Width="136"
            SortMemberPath="SuggestedPurchaseSupplierDisplay"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding SuggestedPurchaseSupplierDisplay}"
                  ToolTip="{Binding SuggestedPurchaseSupplierName}">
                  <TextBlock.Style>
                    <Style
                      TargetType="TextBlock"
                      BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}">
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding SuggestedPurchaseSupplierDisplay}"
                          Value="未设置">
                          <Setter
                            Property="Foreground"
                            Value="{DynamicResource UserSystemFillColorCautionBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <procurementComponents:PurchaseSupplierLookupTextBox
                  ItemsSource="{Binding DataContext.SuggestedSupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  SelectedSupplier="{Binding SuggestedPurchaseSupplierSelection, Mode=OneWay}"
                  SearchCommand="{Binding DataContext.SearchSuggestedSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  SelectionCommittedCommand="{Binding CommitSuggestedSupplierSelectionCommand}"
                  SelectionClearedCommand="{Binding ClearSuggestedSupplierSelectionCommand}"
                  IsBusy="{Binding DataContext.IsSuggestedSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  IsEnabled="{Binding IsSuggestionEditable}"
                  Placeholder="搜索推荐采购供应商"
                  AutomationProperties.Name="推荐采购供应商" />
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn
            Header="客供送至"
            Width="100"
            Binding="{Binding SuggestedDeliverySupplierDisplay, TargetNullValue=未确定}"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            IsReadOnly="True"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="原需求交期"
            Width="112"
            Binding="{Binding DemandRequiredDate, StringFormat=yyyy-MM-dd}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="物料需求"
            Width="96"
            Binding="{Binding NetQty, StringFormat=0.############################}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="单位"
            Width="76"
            Binding="{Binding Unit}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="关联采购量"
            Width="112"
            Binding="{Binding AssociatedPurchaseQty, StringFormat=0.############################}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="未承接量"
            Width="96"
            Binding="{Binding RemainingQty, StringFormat=0.############################, TargetNullValue=需核实}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="承接状态"
            Width="96"
            Binding="{Binding ProcurementStatus}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="交期提示"
            Width="96"
            Binding="{Binding DueHint}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="实际采购供应商"
            Width="140"
            Binding="{Binding ActualPurchaseSuppliers}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="需核实"
            Width="160"
            Binding="{Binding ReviewReason}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="采购单号"
            Width="160"
            Binding="{Binding PurchaseOrderNos}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            Foreground="{DynamicResource UserBusinessTextAccentBrush}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="描述"
            Width="200"
            Binding="{Binding Description}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn
            Header="根SKU"
            Width="120"
            Binding="{Binding RootSku}"
            IsReadOnly="True"
            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
        </DataGrid.Columns>
      </DataGrid>
      <Grid
        Grid.Row="4"
        ColumnDefinitions="*,Auto,Auto,Auto"
        Margin="0,8,0,0">
        <TextBlock
          Text="{Binding ResultSummary}"
          TextWrapping="Wrap"
          Style="{StaticResource CaptionTextBlock}"
          VerticalAlignment="Center" />
        <TextBlock
          Grid.Column="1"
          Text="{Binding CheckedCount, StringFormat=已选 {0} 条}"
          Style="{StaticResource CaptionTextBlock}"
          VerticalAlignment="Center" />
        <TextBlock
          Grid.Column="2"
          Text="{Binding PageStatus}"
          Margin="16,0"
          Style="{StaticResource CaptionTextBlock}"
          VerticalAlignment="Center" />
        <controls:PageNavigator
          Grid.Column="3"
          TotalCount="{Binding TotalCount}"
          PageIndex="{Binding PageIndex}"
          PageSize="{Binding PageSize}"
          PageChangeCommand="{Binding PageChangeCommand}">
          <controls:PageNavigator.Style>
            <Style
              TargetType="controls:PageNavigator">
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding IsSourceSelected}"
                  Value="True">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:PageNavigator.Style>
        </controls:PageNavigator>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>