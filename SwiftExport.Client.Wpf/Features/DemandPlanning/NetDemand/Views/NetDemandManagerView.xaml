<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.NetDemandManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:procurementComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.DemandPlanning.NetDemand.ViewModels"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:NetDemandManagerViewModel}"
             d:Width="1600" d:Height="900">
    <UserControl.Resources>
        <Style x:Key="NetDemandToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <DockPanel Margin="12" LastChildFill="True">
        <Border x:Name="左侧隐藏筛选区"
                DockPanel.Dock="Left"
                Width="180"
                Margin="0,0,8,0"
                Padding="4"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsSourcePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowDefinitions="Auto,4,Auto,4,Auto,8,*,4,Auto">
                <TextBlock Margin="4,2"
                           FontWeight="SemiBold"
                           Text="来源单号" />

                <Grid Grid.Row="2">
                    <controls:DropDownCheckBox
                                               Placeholder="来源"
                                               DisplayMemberPath="DisplayText"
                                               ItemsSource="{Binding SourceTypeOptions}"
                                               SelectedItems="{Binding SourceSourceTypes, Mode=OneWay}" />
                </Grid>

                <Button Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        Content="清空筛选"
                        Command="{Binding ClearSourceFiltersCommand}" />

                <ListBox Grid.Row="6"
                         Background="Transparent"
                         ItemsSource="{Binding SourceGroups}"
                         SelectedItem="{Binding SelectedSourceGroup, Mode=TwoWay}"
                         SelectionChanged="OnSourceGroupSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                               Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CountText}"
                                           Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="8"
                           Margin="4,0"
                           Text="{Binding SourceGroupSummary}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,8,Auto,8,Auto,8,*,8,Auto">
            <!--条件筛选区域-->
            <Grid RowDefinitions="Auto,8, *">
                <Grid ColumnDefinitions="3*,3*,3*">
                    <TextBlock Text="物料需求" 
                           Style="{StaticResource SubtitleTextBlock}"
                           VerticalAlignment="Center"/>
                    <!--搜索框-->
                    <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="来源单号、SKU、客户型号或描述">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                        <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                        <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0"
                               VerticalAlignment="Stretch" MinWidth="70"/>
                    </StackPanel>
                </Grid>
            </Grid>



            <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*">

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="从成品需求建立" Margin="0,0,8,0" 
                               Command="{Binding EstablishFromSourcesCommand}" 
                               Appearance="Info"/>

                    <ui:Button Content="安全回退"  Margin="0,0,8,0" 
                               Command="{Binding RollbackSourceEstablishmentCommand}"/>

                    <ui:Button Content="保存默认供应商" Margin="0,0,8,0" 
                               Command="{Binding SaveSuggestedSuppliersCommand}"/>

                    <ui:Button Content="取消修改" Margin="0,0,8,0" 
                               Command="{Binding CancelSuggestedSupplierChangesCommand}"/>

                    <ui:Button Content="追踪选中物料" Margin="0,0,8,0"
                               Command="{Binding OpenTraceCommand}"/>

                    <ComboBox Width="105" Margin="0,0,8,0" ItemsSource="{Binding LifecycleOptions}"
                              DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedLifecycle}" />

                    <ComboBox Width="125" Margin="0,0,8,0" ItemsSource="{Binding QuickViewOptions}"
                              DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedQuickView}" />

                    <ToggleButton Content="来源单号" Margin="0,0,8,0"                                   
                                  Command="{Binding ToggleSourcePanelCommand}"
                                  IsChecked="{Binding IsSourcePanelOpen, Mode=OneWay}"
                                  HorizontalAlignment="Left" />

                    <controls:DropDownCheckBox Placeholder="来源类型"  Margin="0,0,8,0"                                                
                                               DisplayMemberPath="DisplayText"
                                               ItemsSource="{Binding SourceTypeOptions}" 
                                               SelectedItems="{Binding SelectedSourceTypes, Mode=OneWay}" />

                    <ComboBox Grid.Column="4" MinWidth="120" Margin="0,0,8,0" 
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding DemandRoleOptions}" 
                              DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedDemandRole}" />

                    <ToggleButton Content="更多条件" Margin="0,0,8,0" 
                                  IsChecked="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
                                  HorizontalAlignment="Left" />
                    
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4">
                <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,*">
                    


                </Grid>
                <Popup IsOpen="{Binding IsMultiLineFilterOpen, Mode=TwoWay}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="6"
                            Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <WrapPanel Margin="0,4">
                            <TextBlock Text=" 需求交期起 : "/>
                            <DatePicker  Margin="0,0,8,0" VerticalAlignment="Top" SelectedDate="{Binding DemandRequiredDateFrom}" />
                            
                            <TextBlock Text=" 需求交期至 : "/>
                            <DatePicker  Margin="0,0,8,0" VerticalAlignment="Top" SelectedDate="{Binding DemandRequiredDateTo}" />

                            <Separator Height="4" Background="Transparent" BorderThickness="0"/>

                            <ui:TextBox Margin="0,0,8,0" Width="210" Height="220" PlaceholderText="来源单号（支持多行）"
                                            Text="{Binding SourceNosText}" AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalAlignment="Top"/>
                            
                            <ui:TextBox Margin="0,0,8,0" Width="210" Height="220" PlaceholderText="SKU（支持多行）"
                                            Text="{Binding SkusText}" AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalAlignment="Top" />
                            
                            <ui:TextBox Margin="0,0,8,0" Width="210" Height="220" PlaceholderText="客户型号（支持多行）"
                                            Text="{Binding CustomerSkusText}" AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalAlignment="Top"/>

                            <ui:TextBox Margin="0,0,8,0" Width="150" PlaceholderText="推荐供应商编码/名称"
                                        Text="{Binding SuggestedSupplierKeyword}" VerticalAlignment="Top"/>
                            <ui:TextBox Margin="0,0,8,0" Width="150" PlaceholderText="实际采购供应商编码/名称"
                                        Text="{Binding ActualSupplierKeyword}" VerticalAlignment="Top"/>
                            <ui:TextBox Width="130" PlaceholderText="采购单号（精确）"
                                        Text="{Binding PurchaseOrderNoFilter}" VerticalAlignment="Top"/>

                        </WrapPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <DataGrid Grid.Row="6" ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding IsSuggestionReadOnly}"
                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          FrozenColumnCount="8"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True" 
                          EnableColumnVirtualization="True"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding SelectedItem, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="45" CanUserSort="False" IsReadOnly="True"
                                                gridColumns:GridColumn.Key="selected"
                                                gridColumns:GridColumn.CanExport="False"
                                                gridColumns:GridColumn.CanFilter="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="False"
                                              IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox  HorizontalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False" IsReadOnly="True"
                                                gridColumns:GridColumn.Key="image"
                                                gridColumns:GridColumn.CanExport="False"
                                                gridColumns:GridColumn.CanFilter="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56" Height="56" Margin="2"
                                                                    Style="{StaticResource SwiftExportCachedImage}"
                                                                    SourcePath="{Binding ImagePath}"
                                                                    DecodePixelWidth="80"
                                                                    Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="状态" Width="45" Binding="{Binding LifecycleStatusText}" IsReadOnly="True"
                                             gridColumns:GridColumn.Key="material-status" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding LifecycleStatusText}" Value="活动">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding LifecycleStatusText}"  Value="已回退">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding LifecycleStatusText}" Value="已作废">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="来源" Width="80" Binding="{Binding SourceTypeText}" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            gridColumns:GridColumn.Key="source-type" />

                    <DataGridTextColumn Header="来源单号" Width="100" Binding="{Binding SourceNo}" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            gridColumns:GridColumn.Key="source-no" />

                    <DataGridTextColumn Header="行" Width="44" Binding="{Binding SourceLineNumber}" IsReadOnly="True"
                                                Visibility="Collapsed"
                                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                                gridColumns:GridColumn.Key="source-line" />

                    <DataGridTextColumn Header="角色" Width="70" Binding="{Binding DemandRoleText}" 
                                                IsReadOnly="True"
                                                gridColumns:GridColumn.Key="demand-role" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding DemandRoleText}" Value="父件">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding DemandRoleText}"  Value="客供件">
                                        <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="物料编号" Width="150" Binding="{Binding DisplaySku}" SortMemberPath="Sku" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            gridColumns:GridColumn.Key="sku" gridColumns:GridColumn.FieldPath="Sku" />

                    <DataGridTextColumn Header="产品型号" Width="150" Binding="{Binding LinkSku}" SortMemberPath="LinkSku" IsReadOnly="True"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.Key="link-sku" gridColumns:GridColumn.FieldPath="LinkSku" />

                    <DataGridTextColumn Header="客户型号" Width="140" Binding="{Binding CustomerSku}" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            gridColumns:GridColumn.Key="customer-sku" />

                    <DataGridTextColumn Header="供货方式" Width="70" Binding="{Binding SupplyType}" IsReadOnly="True"
                                             ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                             gridColumns:GridColumn.Key="supply-type" />

                    <DataGridTemplateColumn Header="推荐采购供应商" Width="100"
                                                    SortMemberPath="SuggestedPurchaseSupplierCode"
                                                    gridColumns:GridColumn.Key="suggested-purchase-supplier">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SuggestedPurchaseSupplierDisplay}"
                                           ToolTip="{Binding SuggestedPurchaseSupplierName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}">
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SuggestedPurchaseSupplierDisplay}" Value="未设置">
                                                    <Setter Property="Foreground" Value="{DynamicResource UserSystemFillColorCautionBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <procurementComponents:PurchaseSupplierLookupTextBox 
                                            ItemsSource="{Binding DataContext.SuggestedSupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedSupplier="{Binding SuggestedPurchaseSupplierSelection, Mode=OneWay}"
                                            SearchCommand="{Binding DataContext.SearchSuggestedSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommand="{Binding CommitSuggestedSupplierSelectionCommand}"
                                            SelectionClearedCommand="{Binding ClearSuggestedSupplierSelectionCommand}"
                                            IsBusy="{Binding DataContext.IsSuggestedSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            IsEnabled="{Binding IsSuggestionEditable}"
                                            Placeholder="搜索推荐采购供应商"
                                            AutomationProperties.Name="推荐采购供应商" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="客供送至" Width="100"
                                                Binding="{Binding SuggestedDeliverySupplierDisplay, TargetNullValue=未确定}"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                IsReadOnly="True"
                                                gridColumns:GridColumn.Key="suggested-delivery-supplier" />

                    <DataGridTextColumn Header="原需求交期" Width="102" Binding="{Binding DemandRequiredDate, StringFormat=yyyy-MM-dd}" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                            gridColumns:GridColumn.Key="demand-required-date" />

                    <DataGridTextColumn Header="物料需求" Width="70" 
                                                Binding="{Binding NetQty, StringFormat=N1}" IsReadOnly="True"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            gridColumns:GridColumn.Key="net-qty" />

                    <DataGridTextColumn Header="关联采购量" Width="80" Binding="{Binding AssociatedPurchaseQty, StringFormat=N1}" IsReadOnly="True"
                                             ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                             gridColumns:GridColumn.Key="associated-purchase-qty" />

                    <DataGridTextColumn Header="未承接量" Width="80" Binding="{Binding RemainingQty, StringFormat=N1, TargetNullValue=需核实}" IsReadOnly="True"
                                        gridColumns:GridColumn.Key="remaining-qty" />
                    <DataGridTextColumn Header="承接状态" Width="85" Binding="{Binding ProcurementStatus}" IsReadOnly="True"
                                        gridColumns:GridColumn.Key="procurement-status" />
                    <DataGridTextColumn Header="交期提示" Width="90" Binding="{Binding DueHint}" IsReadOnly="True"
                                        gridColumns:GridColumn.Key="due-hint" />
                    <DataGridTextColumn Header="实际采购供应商" Width="140" Binding="{Binding ActualPurchaseSuppliers}" IsReadOnly="True"
                                        gridColumns:GridColumn.Key="actual-supplier" />
                    <DataGridTextColumn Header="需核实" Width="160" Binding="{Binding ReviewReason}" IsReadOnly="True"
                                        gridColumns:GridColumn.Key="review-reason" />

                    <DataGridTextColumn Header="采购单号" Width="160" Binding="{Binding PurchaseOrderNos}" 
                                        IsReadOnly="True" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                                        gridColumns:GridColumn.Key="purchase-orders" />


                    <DataGridTextColumn Header="描述" Width="200" Binding="{Binding Description}" IsReadOnly="True"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        gridColumns:GridColumn.Key="description" />

                    <DataGridTextColumn Header="根SKU" Width="120" Binding="{Binding RootSku}" IsReadOnly="True"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    gridColumns:GridColumn.Key="root-sku" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="8" ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CheckedCount, StringFormat=已选 {0} 条}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding PageStatus}" Margin="16,0" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}"
                                        PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}">
                    <controls:PageNavigator.Style>
                        <Style TargetType="controls:PageNavigator">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:PageNavigator.Style>
                </controls:PageNavigator>
            </Grid>

        </Grid>
    </DockPanel>
</UserControl>
