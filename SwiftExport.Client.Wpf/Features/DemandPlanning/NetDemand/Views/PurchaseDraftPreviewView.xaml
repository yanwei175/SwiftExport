<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.PurchaseDraftPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Width="1120" Height="700" d:Width="1120" d:Height="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="4" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
        <Grid ColumnDefinitions="Auto,12,240,12,*,Auto,8,Auto">
            <StackPanel>
                <TextBlock Text="入口" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding EntryModeText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="采购行生成方式" Style="{StaticResource CaptionTextBlock}" />
                <ComboBox ItemsSource="{Binding LineModeOptions}" DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                          SelectedValue="{Binding LineMode, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Grid.Column="4" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            <Button Grid.Column="5" Content="重新预览" Command="{Binding PreviewCommand}" Padding="12,5" />
            <Button Grid.Column="7" Content="创建采购草稿" 
                    Command="{Binding CreateCommand}" Padding="12,5" />
        </Grid>

        <Border Grid.Row="2" Padding="8" Background="{DynamicResource SwiftExportBrush.WarningSoft}"
                Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="当前预览已失效：数量、合并方式或追加目标修改后，必须点击“重新预览”。" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="4">
            <TabItem Header="本次计划">
                <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源单号" Width="120" Binding="{Binding SourceNo}" IsReadOnly="True" />
                        <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Sku}" IsReadOnly="True" />
                        <DataGridTextColumn Header="剩余可转" Width="100" Binding="{Binding ExpectedRemainingQty, StringFormat=N4}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="本次采购数量" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PurchaseQty, UpdateSourceTrigger=LostFocus, StringFormat=N4}"
                                             IsReadOnly="{Binding IsQuantityReadOnly}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="数量校验" Width="*" Binding="{Binding QuantityError}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="采购草稿预览">
                <Grid RowDefinitions="Auto,8,*">
                    <DataGrid ItemsSource="{Binding Targets}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" RowHeight="34" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="来源单号" Width="120" Binding="{Binding SourceNo}" IsReadOnly="True" />
                            <DataGridTextColumn Header="采购供应商" Width="180" Binding="{Binding SupplierName}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="草稿目标" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PreviewLines}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="来源" Width="110" Binding="{Binding SourceNo}" />
                            <DataGridTextColumn Header="供应商" Width="160" Binding="{Binding SupplierName}" />
                            <DataGridTextColumn Header="SKU" Width="120" Binding="{Binding Sku}" />
                            <DataGridTextColumn Header="客户型号" Width="110" Binding="{Binding CustomerSku}" />
                            <DataGridTextColumn Header="采购数量" Width="95" Binding="{Binding PurchaseQty, StringFormat=N4}" />
                            <DataGridTextColumn Header="计划交期" Width="95" Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}" />
                            <DataGridTextColumn Header="送达供应商" Width="140" Binding="{Binding DeliveryTargetSupplierName}" />
                            <DataGridCheckBoxColumn Header="资料待补" Width="80" Binding="{Binding PurchaseDataIncomplete}" />
                            <DataGridTextColumn Header="来源贡献" Width="80" Binding="{Binding ContributionCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="警告与阻断">
                <Grid RowDefinitions="*,8,Auto">
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8" BorderBrush="{DynamicResource SwiftExportBrush.Border}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}"
                                                  IsEnabled="{Binding RequiresConfirmation}"
                                                  Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Code}"/><Run Text="  "/><Run Text="{Binding Message}"/></TextBlock>
                                            <TextBlock Text="阻断项：必须修复后重新预览" Foreground="{DynamicResource SwiftExportBrush.Error}"
                                                       Visibility="{Binding IsBlocker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="强提示：勾选确认后才能创建" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                                                       Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SkippedItems}" Style="{StaticResource SwiftExportDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="跳过 Allocation" Width="220" Binding="{Binding AllocationId}" />
                            <DataGridTextColumn Header="执行方式" Width="90" Binding="{Binding ExecutionType}" />
                            <DataGridTextColumn Header="原因" Width="*" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="执行结果">
                <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源类型" Width="90" Binding="{Binding SourceType}" />
                        <DataGridTextColumn Header="来源 Uid" Width="220" Binding="{Binding SourceUid}" />
                        <DataGridTextColumn Header="结果" Width="100" Binding="{Binding Outcome}" />
                        <DataGridTextColumn Header="错误码" Width="150" Binding="{Binding ErrorCode}" />
                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}" />
                        <DataGridTextColumn Header="采购草稿号" Width="180" Binding="{Binding PurchaseOrderNos}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="创建按钮仅在预览最新、无阻断且强提示全部确认后启用。"
                       Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
