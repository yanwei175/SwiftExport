<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.SourceDemandCandidatePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="800" d:Width="1200">

    <Grid Margin="8" ColumnDefinitions="220,8,*">
        <Border Padding="8"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,8,*,8,Auto">
                <TextBlock FontWeight="SemiBold" Text="待建立来源单" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SourceGroups}"
                         SelectedItem="{Binding SelectedSourceGroup, Mode=OneWay}"
                         SelectionChanged="OnSourceGroupSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                               Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CountText}"
                                           Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Text="{Binding SourceGroupStatusText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="Auto,8,*,8,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="未分解成品需求" />
                    <TextBlock Margin="0,2,0,0"
                               Text="选择左侧来源单后，将一次加载该单全部待建立行。"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button MinWidth="88"
                            Margin="0,0,8,0"
                            Command="{Binding ToggleAllCommand}"
                            Content="全选/取消" />
                    <ui:Button MinWidth="112"
                               Appearance="Primary"
                            Command="{Binding EstablishSelectedCommand}"
                            Content="建立选中需求" />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2"
                      RowHeight="{DynamicResource DataGridRowHeightMedium}"
                      FontSize="12"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="64" CanUserSort="False" 
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate >
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleAllCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          AutomationProperties.Name="全选或取消当前来源单全部行"
                                          ToolTip="全选或取消当前来源单全部行"
                                          />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="选择该成品需求"
                                          ToolTip="选择该成品需求" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56" Height="56" Margin="2"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding Demand.ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="来源类型" Width="88" Binding="{Binding Demand.SourceType}" />
                    <DataGridTextColumn Header="来源单号" Width="140" Binding="{Binding Demand.SourceNo}" />
                    <DataGridTextColumn Header="行号" Width="60" Binding="{Binding Demand.SourceLineNumber}" />
                    <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Demand.Sku}" />
                    <DataGridTextColumn Header="LinkSku" Width="130" Binding="{Binding Demand.LinkSku}" />
                    <DataGridTextColumn Header="客户型号" Width="130" Binding="{Binding Demand.CustomerSku}" />
                    <DataGridTextColumn Header="描述" Width="*" MinWidth="180" Binding="{Binding Demand.Description}" />
                    <DataGridTextColumn Header="数量" Width="86" Binding="{Binding Demand.DemandQty}" />
                    <DataGridTextColumn Header="交期" Width="104" Binding="{Binding Demand.RequiredDate, StringFormat=yyyy-MM-dd}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
