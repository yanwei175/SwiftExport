<UserControl x:Class="SwiftExportClient.Features.DemandPlanning.NetDemand.Views.SourceDemandCandidatePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="900" MinHeight="480">
    <Grid Margin="8" RowDefinitions="Auto,8,*,8,Auto">
        <Grid ColumnDefinitions="*,8,Auto">
            <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="来源单号、SKU、客户型号或描述">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <Button Grid.Column="2" Command="{Binding SearchCommand}" Content="查询" Padding="12,4" />
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Width="52" Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" />
                <DataGridTextColumn Header="来源类型" Width="90" Binding="{Binding Demand.SourceType}" />
                <DataGridTextColumn Header="来源单号" Width="150" Binding="{Binding Demand.SourceNo}" />
                <DataGridTextColumn Header="行号" Width="60" Binding="{Binding Demand.SourceLineNumber}" />
                <DataGridTextColumn Header="SKU" Width="150" Binding="{Binding Demand.Sku}" />
                <DataGridTextColumn Header="客户型号" Width="150" Binding="{Binding Demand.CustomerSku}" />
                <DataGridTextColumn Header="描述" Width="*" Binding="{Binding Demand.Description}" />
                <DataGridTextColumn Header="数量" Width="90" Binding="{Binding Demand.DemandQty}" />
                <DataGridTextColumn Header="交期" Width="110" Binding="{Binding Demand.RequiredDate, StringFormat=yyyy-MM-dd}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
