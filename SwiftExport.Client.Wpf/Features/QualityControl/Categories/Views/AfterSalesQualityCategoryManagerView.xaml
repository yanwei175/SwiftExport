<UserControl
    x:Class="SwiftExportClient.Features.QualityControl.Categories.Views.AfterSalesQualityCategoryManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:models="clr-namespace:SwiftExportClient.Features.QualityControl.Categories.Models"
    x:Name="Root"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:AfterSalesQualityCategoryNode}" ItemsSource="{Binding Children}">
            <StackPanel Margin="0,4" Orientation="Horizontal">
                <TextBlock Text="{Binding CategoryName}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                    Text="{Binding FakeName}" />
                <TextBlock
                    Margin="8,0,0,0"
                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                    Text="{Binding EnabledText}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style
            x:Key="CategoryTreeItem"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding AddSiblingCommand}" Header="新增同级" />
                        <MenuItem Command="{Binding AddChildCommand}" Header="新增子级" />
                        <MenuItem Command="{Binding DeleteCommand}" Header="删除" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,12">
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlock}"
                Text="售后品质分类" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding AddSiblingCommand}"
                Content="新增同级" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding AddChildCommand}"
                Content="新增子级" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding DeleteCommand}"
                Content="删除" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                Content="保存" />
            <Button Command="{Binding RefreshCommand}" Content="刷新" />
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Border Padding="12" Style="{StaticResource SwiftCardStyle}">
                <DockPanel>
                    <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding MoveUpCommand}"
                            Content="上移" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding MoveDownCommand}"
                            Content="下移" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding PromoteCommand}"
                            Content="提升一级" />
                        <Button Command="{Binding DemoteCommand}" Content="降低一级" />
                    </WrapPanel>
                    <TreeView
                        x:Name="CategoryTree"
                        dd:DragDrop.DropHandler="{Binding ElementName=Root}"
                        dd:DragDrop.IsDragSource="{Binding CanEdit}"
                        dd:DragDrop.IsDropTarget="{Binding CanEdit}"
                        AutomationProperties.Name="售后品质分类结构"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource CategoryTreeItem}"
                        ItemsSource="{Binding Tree.Roots}"
                        PreviewMouseRightButtonDown="OnRightClick"
                        SelectedItemChanged="OnSelectedItemChanged" />
                </DockPanel>
            </Border>
            <Border
                Grid.Column="2"
                Padding="16"
                Style="{StaticResource SwiftCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlock}"
                            Text="分类属性" />
                        <TextBlock
                            Margin="0,0,0,16"
                            Text="父级和末级均可用于售后服务单。"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="Editor"
                            DataContext="{Binding CurrentCategory}"
                            IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}">
                            <TextBlock Text="分类名称（必填）" />
                            <TextBox
                                Margin="0,4,0,12"
                                AutomationProperties.Name="分类名称"
                                Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="别名" />
                            <TextBox
                                Margin="0,4,0,12"
                                AutomationProperties.Name="分类别名"
                                Text="{Binding FakeName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="分类编码（可空）" />
                            <TextBox
                                Margin="0,4,0,12"
                                AutomationProperties.Name="分类编码"
                                Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="排序" />
                            <TextBox
                                Margin="0,4,0,12"
                                AutomationProperties.Name="分类排序"
                                Text="{Binding SortNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                            <CheckBox
                                AutomationProperties.Name="启用品质分类"
                                Content="启用"
                                IsChecked="{Binding IsEnabled}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock
                AutomationProperties.Name="分类验证提示"
                Text="{Binding ValidationSummary}"
                TextWrapping="Wrap" />
            <TextBlock
                AutomationProperties.Name="分类操作结果"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
