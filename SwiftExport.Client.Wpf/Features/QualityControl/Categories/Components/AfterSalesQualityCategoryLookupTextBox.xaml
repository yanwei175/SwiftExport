<UserControl x:Class="SwiftExportClient.Features.QualityControl.Categories.Components.AfterSalesQualityCategoryLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SwiftExportClient.Features.QualityControl.Categories.Components"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             x:Name="Root" MinHeight="30">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type components:AfterSalesQualityCategoryLookupNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{Binding Source.CategoryName}"/>
                <TextBlock Text="{Binding Source.CategoryCode}" Margin="8,0,0,0" Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Source.EnabledText}" Margin="8,0,0,0" Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="LookupTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        </Style>
    </UserControl.Resources>
    <controls:LookupTextBox x:Name="LookupEditor" ShowDropDownButton="True" SearchMode="Local"
                            ItemsSource="{Binding SelectableItems, ElementName=Root}"
                            DisplayMemberPath="CategoryName" FilterMemberPaths="CategoryName,CategoryCode,FakeName" SelectedValuePath="Uid"
                            ClearSelectionOnEdit="False" RequireItemMatch="True" Placeholder="搜索品质分类"
                            IsBusy="{Binding IsRefreshing, ElementName=Root}"
                            SelectionCommitted="OnCommitted" SelectionClearedCommand="{Binding ClearSelectionCommand, ElementName=Root}"
                            AutomationProperties.Name="售后品质分类选择">
        <controls:LookupTextBox.CustomDropDownContent>
            <DockPanel MinWidth="320" MaxHeight="320">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                    <TextBlock Text="品质分类" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="展开全部" Click="OnExpandAll" Margin="0,0,8,0"/>
                    <Button Content="折叠全部" Click="OnCollapseAll" Margin="0,0,8,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <TreeView ItemsSource="{Binding FilteredRoots}" ItemContainerStyle="{StaticResource LookupTreeItem}"
                          BorderThickness="0" AutomationProperties.Name="可选择的品质分类树"
                          SelectedItemChanged="OnTreeSelectionChanged" PreviewMouseLeftButtonUp="OnMouseCommit"/>
            </DockPanel>
        </controls:LookupTextBox.CustomDropDownContent>
    </controls:LookupTextBox>
</UserControl>
