<UserControl
    x:Class="SwiftExportClient.Features.QualityControl.AfterSales.Views.AfterSalesManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:customerComponents="clr-namespace:SwiftExportClient.Features.Customers.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    d:DesignHeight="760"
    d:DesignWidth="1300"
    mc:Ignorable="d">

    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,*,8,Auto">

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="售后投诉" />
                <!--  搜索框  -->
                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="售后单号、客户型号、AQ型号或SKU"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />

                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding CreateCommand}"
                            Content="新建售后单"
                            ToolTip="新建售后单" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding OpenDetailCommand}"
                            Content="打开详情"
                            ToolTip="打开详情" />

                        <customerComponents:CustomerAutoSuggestComboBox
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="客户筛选"
                            ItemsSource="{Binding CustomerOptions}"
                            SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}" />

                        <supplierComponents:SupplierAutoSuggestComboBox
                            Grid.Column="4"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="责任方筛选"
                            ItemsSource="{Binding SupplierOptions}"
                            SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}" />

                        <ComboBox
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="生命周期筛选"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding DocumentStatusOptions}"
                            SelectedItem="{Binding SelectedDocumentStatus}" />

                        <ComboBox
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="实物确认筛选"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding ConfirmationOptions}"
                            SelectedItem="{Binding SelectedConfirmationStatus}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{DynamicResource LabelTextBlock}"
                            Text=" 受理日期起 : " />
                        <DatePicker
                            Margin="0,0,8,0"
                            AutomationProperties.Name="受理日期起"
                            SelectedDate="{Binding DateFrom}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{DynamicResource LabelTextBlock}"
                            Text=" 受理日期止 : " />
                        <DatePicker
                            Margin="0,0,8,0"
                            AutomationProperties.Name="受理日期止"
                            SelectedDate="{Binding DateTo}" />


                        <ToggleButton
                            x:Name="OptionsToggleButton"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Content="更多条件" />

                    </WrapPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" />

                </DockPanel>

                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">
                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel MinHeight="120" Orientation="Horizontal">

                            <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto,Auto" />
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            AutomationProperties.Name="售后服务单列表"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            IsReadOnly="True"
            ItemsSource="{Binding Orders}"
            RowHeight="{DynamicResource DataGridRowHeightSmall}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.InputBindings>
                <MouseBinding Command="{Binding OpenDetailCommand}" MouseAction="LeftDoubleClick" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding CustomerComplaintNo}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="客户投诉单号" />

                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding AfterSalesNo}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="售后单号" />

                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding CustomerDisplay}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="客户" />

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding AcceptedDate, StringFormat=yyyy-MM-dd}"
                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                    Header="受理日期" />

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding OwnerName}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="负责人" />

                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding IssueModels}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="问题型号摘要" />

                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding ResponsibleSuppliers}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="责任方摘要" />

                <DataGridTextColumn
                    Width="85"
                    Binding="{Binding DocumentStatusText}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="生命周期" />

                <DataGridTextColumn
                    Width="95"
                    Binding="{Binding ConfirmationStatusText}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="实物需求" />

                <DataGridTextColumn
                    Width="125"
                    Binding="{Binding AmountText}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="人民币金额" />

            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding ResultSummary}" />
            <controls:PageNavigator
                Grid.Column="1"
                IsEnabled="{Binding IsNotBusy}"
                PageChangeCommand="{Binding PageChangeCommand}"
                PageSize="{Binding PageSize, Mode=OneWay}"
                TotalCount="{Binding TotalCount}"
                PageIndex="{Binding PageIndex, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
