<UserControl x:Class="SwiftExportClient.Features.QualityControl.AfterSales.Views.AfterSalesDetailView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             xmlns:vm="clr-namespace:SwiftExportClient.Features.QualityControl.AfterSales.ViewModels"
             xmlns:customerComponents="clr-namespace:SwiftExportClient.Features.Customers.Components" 
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components" 
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components" 
             mc:Ignorable="d" d:DesignHeight="950" d:DesignWidth="1500"
             d:DataContext="{d:DesignInstance vm:AfterSalesDetailViewModel}">

    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
        <!--title-->
        <DockPanel LastChildFill="True" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,8,Auto,8,Auto">

                <TextBlock Text="售后单详情" Grid.RowSpan="3" 
                           Style="{StaticResource TitleTextBlock}" 
                           VerticalAlignment="Center" />

                <Border Grid.Row="0" Grid.Column="2" Padding="6" VerticalAlignment="Center" 
                        HorizontalAlignment="Left" 
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="4">

                    <TextBlock Text="{Binding DocumentStatusText}" d:Text="待处理" 
                               TextAlignment="Left" 
                               Foreground="{DynamicResource UserSystemAccentColorSecondaryBrush}" 
                               Style="{StaticResource BodyTextBlock}" />
                </Border>

                <Border Grid.Row="0"  Grid.Column="4" Padding="6" VerticalAlignment="Center" 
                        HorizontalAlignment="Left" 
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="4">

                    <TextBlock Text="{Binding ConfirmationStatusText}" d:Text="待确认" 
                               TextAlignment="Left" Foreground="{DynamicResource UserSystemAccentColorSecondaryBrush}" 
                               Style="{StaticResource BodyTextBlock}" />
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Save24}" Content="保存" Command="{Binding SaveCommand}" MinWidth="76" Appearance="Primary" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Content="确认实物需求" Command="{Binding ConfirmDemandCommand}" MinWidth="112" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Content="取消确认" Command="{Binding CancelDemandConfirmationCommand}" MinWidth="88" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Archive24}" Content="结案" Command="{Binding CloseCommand}" MinWidth="72" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=CalendarReply24}" Content="重开" Command="{Binding ReopenCommand}" MinWidth="72" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Delete24}" Content="作废" Command="{Binding VoidCommand}" MinWidth="72" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Content="重新加载" Command="{Binding ReloadCommand}" MinWidth="84" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Content="刷新关联候选" Command="{Binding RefreshLookupsCommand}" MinWidth="108" ToolTip="客户改变后刷新产品和原订单候选" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Padding="12" Style="{StaticResource SwiftCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                <StackPanel>
                    <TextBlock Text="投诉信息" Style="{StaticResource SubtitleTextBlock}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="150"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="120" />
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                            <ColumnDefinition Width="1*" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="售后单号" Margin="0,0,0,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Header.AfterSalesNo,Mode=OneWay}" Margin="0,8,8,8"
                                        IsReadOnly="True" 
                                        PlaceholderText="保存后生成" 
                                        Tag="Header.AfterSalesNo" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="客户" Margin="0,0,0,4" />
                        <customerComponents:CustomerAutoSuggestComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,8"
                                                                        ItemsSource="{Binding Customers}" SelectedCustomer="{Binding SelectedCustomer,Mode=TwoWay}" IsEnabled="{Binding CanEditFacts}" Tag="Header.CustomerId" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="客户投诉单号" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="1" Grid.Column="2" Margin="0,8,8,8"
                                    Text="{Binding Header.CustomerComplaintNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" IsEnabled="{Binding CanEditSupplement}" AutomationProperties.Name="客户投诉单号" Tag="Header.CustomerComplaintNo" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="受理日期" Margin="0,0,0,4" />
                        <DatePicker Grid.Row="1" Grid.Column="3" Margin="0,8,8,8"
                                    SelectedDate="{Binding Header.AcceptedDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                        SelectedDateFormat="Short"
                                        IsEnabled="{Binding CanEditFacts}" 
                                        AutomationProperties.Name="受理日期" 
                                        Tag="Header.AcceptedDate" />

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="投诉描述（必填）" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="1" Grid.Column="4"  Grid.RowSpan="5" Margin="0,8,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Text="{Binding Header.IssueDescription,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                        AcceptsReturn="True" 
                                    TextWrapping="Wrap" 
                                    IsEnabled="{Binding CanEditSupplement}" 
                                    AutomationProperties.Name="投诉描述（必填）" 
                                    Tag="Header.IssueDescription" />

                        <Border Grid.Row="1" Grid.Column="5" Grid.RowSpan="5" Margin="0,8,8,8"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource UserCardStrokeColorDefaultBrush}" CornerRadius="4">

                            <controls:CachedImage Margin="4" Width="140" Height="140" Stretch="Uniform"
                                              SourcePath="{Binding Header.ImagePath}" DecodePixelWidth="96" />
                        </Border>


                        <TextBlock Grid.Row="2" Grid.Column="0" Text="关联销售单"/>
                        <ComboBox Grid.Row="3" Grid.Column="0" IsEditable="True" Margin="0,8,8,8"
                                    IsTextSearchEnabled="True" VerticalContentAlignment="Center"
                                    ItemsSource="{Binding SalesOrderLines}" 
                                    SelectedValue="{Binding Header.OriginalSalesOrderLineId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnExceptions=True,
                                    NotifyOnValidationError=True}" 
                                    SelectedValuePath="Uid" 
                                    DisplayMemberPath="Code" 
                                    IsEnabled="{Binding CanEditFacts}" 
                                    AutomationProperties.Name="原销售行" 
                                    Tag="Header.OriginalSalesOrderLineId" />

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="责任供应商" Margin="0,0,0,4" />
                        <supplierComponents:SupplierAutoSuggestComboBox Grid.Row="3" Grid.Column="1" Margin="0,8,8,8"
                                                                        ItemsSource="{Binding Suppliers}" SelectedSupplier="{Binding Header.SelectedResponsibleSupplier,Mode=TwoWay}" IsEnabled="{Binding CanEditFacts}" AutomationProperties.Name="责任供应商" Tag="Header.ResponsibleSupplierId" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="业务员" Margin="0,0,0,4" />
                        <ComboBox  Grid.Row="3" Grid.Column="2" Margin="0,8,8,8" VerticalContentAlignment="Center"
                                   IsEditable="True" IsTextSearchEnabled="True" 
                                   ItemsSource="{Binding Owners}" 
                                   SelectedValue="{Binding Header.OwnerId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                   SelectedValuePath="Uid" 
                                   DisplayMemberPath="Code" 
                                   IsEnabled="{Binding CanEditFacts}" 
                                   AutomationProperties.Name="业务员" Tag="Header.OwnerId" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="要求交期" Margin="0,0,0,4" />
                        <DatePicker Grid.Row="3" Grid.Column="3" Margin="0,8,8,8" SelectedDateFormat="Short"
                                    SelectedDate="{Binding Header.RequiredDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" IsEnabled="{Binding CanEditFacts}" AutomationProperties.Name="要求交期" Tag="Header.RequiredDate" />


                        <TextBlock Grid.Row="4" Grid.Column="0" Text="问题物料" Margin="0,0,0,4" />
                        
                        <productComponents:ProductLookupTextBox  Grid.Row="5" Grid.Column="0" Margin="0,8,8,8" 
                                                                 Text="{Binding Header.IssueSkuSnapshot,Mode=OneWay}" 
                                                                 ItemsSource="{Binding ProductCandidates}"
                                                                 SelectedProduct="{Binding SelectedProductCandidate,Mode=OneWayToSource}" 
                                                                 SearchCommand="{Binding SearchProductsCommand}"
                                                                 SelectionCommittedCommand="{Binding CommitIssueProductCommand}" 
                                                                 SelectionClearedCommand="{Binding ClearIssueProductCommand}"
                                                                 IsBusy="{Binding IsProductSearchBusy}" 
                                                                 IsEnabled="{Binding CanEditFacts}" 
                                                                 Tag="Header.IssueProductId" 
                                                                 AutomationProperties.Name="问题产品"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="问题客户型号" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="5" Grid.Column="1" Margin="0,8,8,8"
                                    Text="{Binding Header.IssueCustomerSkuSnapshot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnExceptions=True,
                                    NotifyOnValidationError=True}" 
                                    IsEnabled="{Binding CanEditFacts}" 
                                    AutomationProperties.Name="问题客户型号" 
                                    Tag="Header.IssueCustomerSkuSnapshot" />

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="问题型号" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="5" Grid.Column="2" Margin="0,8,8,8"
                                    Text="{Binding Header.IssueLinkSkuSnapshot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" IsEnabled="{Binding CanEditFacts}" AutomationProperties.Name="问题 AQ 型号" Tag="Header.IssueLinkSkuSnapshot" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="退回收到日期" Margin="0,0,0,4" />
                        <DatePicker Grid.Row="5" Grid.Column="3" Margin="0,8,8,8" SelectedDateFormat="Short"
                                    SelectedDate="{Binding Header.ReturnedReceivedDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" IsEnabled="{Binding CanEditSupplement}" AutomationProperties.Name="退回收到日期" Tag="Header.ReturnedReceivedDate" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="投诉单备注" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="7" Grid.Column="0" Margin="0,8,8,8"
                                   Text="{Binding Header.Remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                    IsEnabled="{Binding CanEditSupplement}" 
                                    AcceptsReturn="True" TextWrapping="Wrap"
                                    AutomationProperties.Name="整单备注" Tag="Header.Remark" />

                        <TextBlock Grid.Row="6" Grid.Column="1" Text="原因分析" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,8,8"
                                   Text="{Binding Header.CauseAnalysis,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                   AcceptsReturn="True"  TextWrapping="Wrap" 
                                    IsEnabled="{Binding CanEditSupplement}" 
                                   AutomationProperties.Name="原因分析" Tag="Header.CauseAnalysis" />

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="处理说明" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="7" Grid.Column="2" Margin="0,8,8,8"
                                   Text="{Binding Header.TreatmentDescription,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                   AcceptsReturn="True"  TextWrapping="Wrap" 
                                   IsEnabled="{Binding CanEditSupplement}" 
                                   AutomationProperties.Name="处理说明" Tag="Header.TreatmentDescription" />

                        <TextBlock Grid.Row="6" Grid.Column="3" Text="预计处理完成" Margin="0,0,0,4" />
                        <DatePicker Grid.Row="7" Grid.Column="3" Margin="0,8,8,8" VerticalAlignment="Top" SelectedDateFormat="Short"
                                    SelectedDate="{Binding Header.ExpectedCompletionDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" IsEnabled="{Binding CanEditFacts}" AutomationProperties.Name="预计处理完成" Tag="Header.ExpectedCompletionDate" />

                        <TextBlock Grid.Row="6" Grid.Column="4" Text="投诉资料文件夹" Margin="0,0,0,4"/>
                        <ui:TextBox Grid.Row="7" Grid.Column="4" Margin="0,8,8,8"
                                    Text="{Binding Header.LocalFileFolder,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSupplement}"
                            PlaceholderText="填写本机文件夹路径" AutomationProperties.Name="投诉资料文件夹" Tag="Header.LocalFileFolder"/>

                        <TextBlock Grid.Row="6" Grid.Column="5" Text="付费售后金额" Margin="0,0,0,4" />
                        <ui:TextBox Grid.Row="7" Grid.Column="5" Margin="0,8,8,8" VerticalAlignment="Top"
                                    Text="{Binding Header.ServiceAmountCny,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" 
                                    IsEnabled="{Binding CanEditFacts}" 
                                    PlaceholderText="留空为不付费售后"
                                    AutomationProperties.Name="付费售后金额" 
                                    Tag="Header.ServiceAmountCny" />



                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Padding="12" Style="{StaticResource SwiftCardStyle}">
            <Grid RowDefinitions="Auto,8,*">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="补件明细" Style="{StaticResource SubtitleTextBlock}" Margin="0,0,16,0" />
                    <ui:Button Content="新增补件" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="删除当前补件" Command="{Binding DeleteLineCommand}" />
                    <TextBlock Text="无补件可直接保存投诉；空或零数量不创建来源需求。" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="ReplacementGrid"  Style="{StaticResource SwiftExportDataGrid}"
                          Grid.Row="2" 
                          RowHeight="{DynamicResource DataGridRowHeightMedium}"
                          ItemsSource="{Binding Lines}" 
                          SelectedItem="{Binding SelectedLine,Mode=TwoWay}"
                            AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          SelectionMode="Single"                          
                            EnableRowVirtualization="True" 
                          EnableColumnVirtualization="True" 
                          BeginningEdit="OnBeginningEdit" 
                          PreparingCellForEdit="OnPreparingCellForEdit"
                            AutomationProperties.Name="补件明细可编辑表格">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"  IsReadOnly="True" Width="48"/>

                        <DataGridTemplateColumn Header="图片" IsReadOnly="True" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage SourcePath="{Binding ImagePath}" Width="48" Height="48" DecodePixelWidth="96"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="补货物料" SortMemberPath="ProductId" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SkuSnapshot}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <productComponents:ProductLookupTextBox Text="{Binding SkuSnapshot,Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ProductCandidates,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedProduct="{Binding DataContext.SelectedProductCandidate,RelativeSource={RelativeSource AncestorType=DataGrid},Mode=OneWayToSource}"
                                    SearchCommand="{Binding DataContext.SearchProductsCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionClearedCommandParameter="{Binding}"
                                    IsBusy="{Binding DataContext.IsProductSearchBusy,RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="补件产品搜索"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="非标" Width="60" SortMemberPath="IsNonStandard">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsNonStandard,Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>                       

                        <DataGridTextColumn Header="客户型号" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            Binding="{Binding CustomerSkuSnapshot,Mode=TwoWay}" Width="110"/>

                        <DataGridTextColumn Header="产品型号" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            Binding="{Binding LinkSkuSnapshot,Mode=TwoWay}" Width="110"/>

                        <DataGridTextColumn Header="描述" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            Binding="{Binding DescriptionSnapshot,Mode=TwoWay}" Width="200"/>

                        
                        <DataGridTemplateColumn Header="颜色" SortMemberPath="ColorId" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ColorSnapshot}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>                                    
                                    <ComboBox VerticalContentAlignment="Center"
                                        ItemsSource="{Binding DataContext.Colors,RelativeSource={RelativeSource AncestorType=DataGrid}}"                                              
                                              SelectedValue="{Binding ColorId,Mode=TwoWay}" 
                                              SelectedValuePath="Uid" 
                                              DisplayMemberPath="ColorNameZh" 
                                              AutomationProperties.Name="补件颜色"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="规格" SortMemberPath="SpecificationSnapshot" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            Binding="{Binding SpecificationSnapshot,Mode=TwoWay}" 
                                            Width="160"/>

                        <DataGridTextColumn Header="数量" SortMemberPath="Quantity" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            Binding="{Binding Quantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="90"/>

                        <DataGridTextColumn Header="备注" SortMemberPath="Remark" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            Binding="{Binding Remark,Mode=TwoWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding ResultSummary}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Foreground="{DynamicResource UserBusinessTextWarningBrush}" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </Grid>
</UserControl>
