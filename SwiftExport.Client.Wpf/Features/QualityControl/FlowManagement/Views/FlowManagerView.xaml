<UserControl x:Class="SwiftExportClient.Features.QualityControl.FlowManagement.Views.FlowManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:products="clr-namespace:SwiftExportClient.Features.Products.Components">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <TextBlock Text="流量管理" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="新建测试组" Command="{Binding CreateCommand}" Margin="8,0,0,0" Padding="12,4" ToolTip="每次重新实测都建立新测试组"/>
    <Button Content="打开详情" Command="{Binding OpenCommand}" Margin="8,0,0,0" Padding="12,4"/>
    <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="12,4"/>
   </StackPanel>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="物料" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <products:ProductLookupTextBox Width="240" SelectedProduct="{Binding SelectedMaterial,Mode=TwoWay}"
    ItemsSource="{Binding MaterialOptions}" SearchCommand="{Binding SearchMaterialsCommand}" IsBusy="{Binding IsMaterialSearchBusy}"
    AutomationProperties.Name="按物料筛选" Placeholder="搜索并选择物料" Margin="0,0,8,8"/>
   <Button Content="清除物料" Command="{Binding ClearMaterialCommand}" Margin="0,0,12,8"/>
   <TextBlock Text="SKU" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox Width="180" Text="{Binding Sku,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SKU快照筛选" Margin="0,0,12,8">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
   </TextBox>
   <TextBlock Text="测试日期起" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding DateFrom}" AutomationProperties.Name="测试日期起" Margin="0,0,12,8"/>
   <TextBlock Text="止" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding DateTo}" AutomationProperties.Name="测试日期止" Margin="0,0,12,8"/>
   <Button Content="查询" Command="{Binding SearchCommand}" Padding="12,4" Margin="0,0,0,8"/>
  </WrapPanel>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" IsReadOnly="True"
   AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
   EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="流量测试组列表">
   <DataGrid.Columns>
    <DataGridTextColumn Header="SKU快照" Binding="{Binding SkuSnapshot}" Width="180"/>
    <DataGridTextColumn Header="测试日期" Binding="{Binding TestDate,StringFormat=yyyy-MM-dd}" Width="120"/>
    <DataGridTextColumn Header="市场说明" Binding="{Binding MarketDescription}" Width="220"/>
    <DataGridTextColumn Header="公共配件配置" Binding="{Binding ConfigurationDescription}" Width="*"/>
    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="220"/>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding BusyMessage}" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Padding="12,4"/>
    <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Margin="12,0"/>
    <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="12,4"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
