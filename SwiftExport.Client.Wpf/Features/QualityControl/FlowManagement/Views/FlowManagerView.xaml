<UserControl
    x:Class="SwiftExportClient.Features.QualityControl.FlowManagement.Views.FlowManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:products="clr-namespace:SwiftExportClient.Features.Products.Components">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="流量管理" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding CreateCommand}"
                    Content="新建测试组"
                    ToolTip="每次重新实测都建立新测试组" />
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding OpenCommand}"
                    Content="打开详情" />
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Command="{Binding RefreshCommand}"
                    Content="刷新" />
            </StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="物料" />
            <products:ProductLookupTextBox
                Width="240"
                Margin="0,0,8,8"
                AutomationProperties.Name="按物料筛选"
                IsBusy="{Binding IsMaterialSearchBusy}"
                ItemsSource="{Binding MaterialOptions}"
                Placeholder="搜索并选择物料"
                SearchCommand="{Binding SearchMaterialsCommand}"
                SelectedProduct="{Binding SelectedMaterial, Mode=TwoWay}" />
            <Button
                Margin="0,0,12,8"
                Command="{Binding ClearMaterialCommand}"
                Content="清除物料" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="SKU" />
            <TextBox
                Width="180"
                Margin="0,0,12,8"
                AutomationProperties.Name="SKU快照筛选"
                Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="测试日期起" />
            <DatePicker
                Margin="0,0,12,8"
                AutomationProperties.Name="测试日期起"
                SelectedDate="{Binding DateFrom}"
                SelectedDateFormat="Short" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="止" />
            <DatePicker
                Margin="0,0,12,8"
                AutomationProperties.Name="测试日期止"
                SelectedDate="{Binding DateTo}"
                SelectedDateFormat="Short" />
            <Button
                Margin="0,0,0,8"
                Padding="12,4"
                Command="{Binding SearchCommand}"
                Content="查询" />
        </WrapPanel>
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            AutomationProperties.Name="流量测试组列表"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            IsReadOnly="True"
            ItemsSource="{Binding Groups}"
            SelectedItem="{Binding SelectedGroup}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding SkuSnapshot}"
                    Header="SKU快照" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding TestDate, StringFormat=yyyy-MM-dd}"
                    Header="测试日期" />
                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding MarketDescription}"
                    Header="市场说明" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ConfigurationDescription}"
                    Header="公共配件配置" />
                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding Remark}"
                    Header="备注" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding BusyMessage}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ValidationSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ResultSummary}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    Padding="12,4"
                    Command="{Binding PreviousPageCommand}"
                    Content="上一页" />
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="{Binding PageStatus}" />
                <Button
                    Padding="12,4"
                    Command="{Binding NextPageCommand}"
                    Content="下一页" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
