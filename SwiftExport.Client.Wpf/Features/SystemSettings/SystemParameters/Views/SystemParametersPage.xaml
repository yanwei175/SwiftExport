<Page x:Class="SwiftExportClient.Features.SystemSettings.SystemParameters.Views.SystemParametersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"  d:DesignHeight="460" d:DesignWidth="840"
      AutomationProperties.Name="系统参数维护">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Padding="12,4"
                    AutomationProperties.Name="刷新系统参数" />
            <StackPanel>
                <TextBlock Text="系统参数" Style="{DynamicResource TitleTextBlock}" />
                <TextBlock Text="每个参数独立保存，刷新会保留未保存的输入。" Margin="0,8,16,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        
        <DataGrid x:Name="ParameterGrid" Grid.Row="1" ItemsSource="{Binding Rows}"
                  RowHeight="{DynamicResource DataGridRowHeightMedium}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VerticalAlignment="Stretch" MinHeight="160" AutomationProperties.Name="系统参数列表">
            <DataGrid.Columns>
                
                <DataGridTemplateColumn Header="参数" Width="240" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Key}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="参数值" Width="2*" MinWidth="280" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8" VerticalAlignment="Stretch">
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         IsEnabled="{Binding DataContext.IsInteractionEnabled, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                         AutomationProperties.Name="{Binding DisplayName}"
                                         AutomationProperties.HelpText="{Binding Description}" />
                                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="说明" Width="2*" MinWidth="240" IsReadOnly="True"
                                    Binding="{Binding Description}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                
                <DataGridTemplateColumn Header="操作" Width="148" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8">
                                <Button Content="保存" Padding="8,4" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=保存{0}}" />
                                <Button Content="撤销" Padding="8,4"
                                        Command="{Binding DataContext.RejectChangesCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=撤销{0}编辑}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
