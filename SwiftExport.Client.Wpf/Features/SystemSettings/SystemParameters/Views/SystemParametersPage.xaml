<Page x:Class="SwiftExportClient.Features.SystemSettings.SystemParameters.Views.SystemParametersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.Name="系统参数维护">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="系统参数" Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="{Binding DisplayName}" FontSize="18" Margin="0,16,0,4" />
            <TextBlock Text="{Binding Key}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="参数值" Margin="0,0,0,4" />
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="520"
                     IsEnabled="{Binding IsInteractionEnabled}" AutomationProperties.Name="产品图片基础地址"
                     AutomationProperties.HelpText="填写原图目录的 HTTP 或 HTTPS 地址，保存后无需重启客户端。" />
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="撤销编辑" Command="{Binding RejectChangesCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Page>
