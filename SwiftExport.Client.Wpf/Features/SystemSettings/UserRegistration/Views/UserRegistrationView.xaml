<UserControl x:Class="SwiftExportClient.Features.SystemSettings.UserRegistration.Views.UserRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="创建用户表单">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FormPanel" Margin="24">
            <TextBlock Text="账号创建成功后，再单独分配角色。" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="用户名" />
            <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,12" AutomationProperties.Name="新用户名" />
            <TextBlock Text="显示名称" />
            <TextBox Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="邮箱" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="电话" />
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="初始密码" />
            <PasswordBox x:Name="PasswordInput" Margin="0,4,0,12" AutomationProperties.Name="初始密码" />
            <TextBlock Text="确认密码" />
            <PasswordBox x:Name="ConfirmInput" Margin="0,4,0,12" AutomationProperties.Name="确认初始密码" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="OnCancel" Margin="0,0,8,0" AutomationProperties.Name="取消创建用户" />
                <Button Content="创建用户" Click="OnSubmit" IsDefault="True"
                        AutomationProperties.Name="提交创建用户" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
