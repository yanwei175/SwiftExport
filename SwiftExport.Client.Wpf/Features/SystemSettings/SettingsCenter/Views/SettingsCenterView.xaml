<UserControl x:Class="SwiftExportClient.Features.SystemSettings.SettingsCenter.Views.SettingsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="设置中心">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SettingsActionButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0" Text="设置" Style="{StaticResource TitleTextBlock}"/>

        <TextBlock Grid.Row="2"
                       Text="管理个人凭据和系统配置。"
                       Style="{StaticResource BodyTextBlock}"/>
        
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="150"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                       Text="个人设置"
                       Style="{StaticResource BodyTextBlock}"/>
                
                <StackPanel Grid.Row="2">
                    <ui:Button Content="修改我的密码" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Icon="{ui:SymbolIcon Symbol=Key24}"
                               Command="{Binding ChangePasswordCommand}" AutomationProperties.Name="修改我的密码"/>
                    <ui:Button Content="刷新我的权限" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                               Command="{Binding RefreshPermissionsCommand}" AutomationProperties.Name="刷新我的权限"/>
                    <TextBlock Text="{Binding RefreshStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                
                <TextBlock Grid.Row="4"
                       Text="系统设置"
                       Style="{StaticResource BodyTextBlock}"/>
                
                <Grid Grid.Row="6" Visibility="{Binding CanManageSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Content="打开系统设置" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Command="{Binding OpenSystemSettingsCommand}"
                               AutomationProperties.Name="打开系统设置"/>

                </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
