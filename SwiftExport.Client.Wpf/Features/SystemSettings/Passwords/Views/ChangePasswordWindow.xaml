<ui:FluentWindow x:Class="SwiftExportClient.Features.SystemSettings.Passwords.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="修改我的密码"
        Width="480" Height="500" MinWidth="440" MinHeight="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" AutomationProperties.Name="修改我的密码窗口">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="修改我的密码" Style="{StaticResource TitleTextBlock}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" Text="修改后旧 Token 会失效，需要重新登录。" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="当前密码" />
        <ui:PasswordBox x:Name="CurrentPasswordBox" Grid.Row="3" Margin="0,4,0,12"
                        PlaceholderText="请输入当前密码"
                        AutomationProperties.Name="当前密码" />
        <StackPanel Grid.Row="4">
            <TextBlock Text="新密码" />
            <ui:PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12"
                            PlaceholderText="请输入新密码"
                            AutomationProperties.Name="新密码" />
            <TextBlock Text="确认新密码" />
            <ui:PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,12"
                            PlaceholderText="请再次输入新密码"
                            AutomationProperties.Name="确认新密码" />
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Grid.Row="6" Height="2" Margin="0,12,0,0" VerticalAlignment="Top"
                     IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel Grid.Row="7" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <ui:Button x:Name="SubmitButton" Content="修改密码" Appearance="Primary" IsDefault="True"
                       IsEnabled="{Binding IsNotBusy}" MinWidth="104" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
