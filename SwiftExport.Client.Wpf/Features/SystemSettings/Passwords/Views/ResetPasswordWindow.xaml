<ui:FluentWindow x:Class="SwiftExportClient.Features.SystemSettings.Passwords.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="重置用户密码" Width="520" Height="560" MinWidth="480" MinHeight="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        AutomationProperties.Name="重置用户密码窗口">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="重置用户密码" Style="{StaticResource TitleTextBlock}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,16" Text="只能重置普通用户；管理员账号必须使用本机恢复工具。" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="目标用户" />
            <ComboBox x:Name="UserBox" Margin="0,4,0,12" ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                      AutomationProperties.Name="目标用户">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserName}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding NickName}" />
                            <TextBlock Margin="8,0,0,0" Text="管理员">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="新密码" />
            <ui:PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12" AutomationProperties.Name="新密码" />
            <TextBlock Text="确认新密码" />
            <ui:PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,12" AutomationProperties.Name="确认新密码" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Grid.Row="5" Height="2" Margin="0,12,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel Grid.Row="7" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <ui:Button x:Name="SubmitButton" Content="重置密码" Appearance="Primary" IsDefault="True"
                       IsEnabled="{Binding IsNotBusy}" MinWidth="104" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
