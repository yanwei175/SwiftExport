<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Passwords.Reset.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="重置密码表单">
    <DockPanel>
        <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}" Command="{Binding CloseState.CloseCommand}"
                   BorderThickness="0"
                HorizontalAlignment="Right" MinWidth="32" MinHeight="32" ToolTip="关闭"
                AutomationProperties.Name="关闭表单" />

        <StackPanel x:Name="FormPanel" IsEnabled="{Binding IsNotBusy}" Margin="12">
            <TextBlock Text="只能重置当前选中的普通用户；管理员密码由本机恢复工具处理。"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
            
            <TextBlock Text="目标用户" />
            
            <TextBox x:Name="TargetUserBox" Text="{Binding SelectedUser.UserName}" IsReadOnly="True"
                 Margin="0,4,0,12" AutomationProperties.Name="重置密码目标用户" />
            <TextBlock Text="新密码" />
            
            <PasswordBox x:Name="PasswordInput" Margin="0,4,0,12" AutomationProperties.Name="重置新密码" />
            <TextBlock Text="确认新密码" />
            
            <PasswordBox x:Name="ConfirmInput" Margin="0,4,0,12" AutomationProperties.Name="确认重置密码" />
            
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" />
            
        </StackPanel>
    </DockPanel>
</UserControl>
