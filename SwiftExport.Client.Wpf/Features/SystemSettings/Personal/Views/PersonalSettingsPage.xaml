<Page x:Class="SwiftExportClient.Features.SystemSettings.Personal.Views.PersonalSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="24">
  <TextBlock Text="个人设置" Style="{StaticResource TitleTextBlock}" />
  <TextBlock Text="通过左侧菜单修改我的密码或刷新我的权限。" Margin="0,12,0,0" TextWrapping="Wrap" />
  <TextBlock Text="{Binding RefreshStatus}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  <Button Content="刷新系统参数" Command="{Binding RefreshSystemParametersCommand}" HorizontalAlignment="Left"
          Margin="0,20,0,0" AutomationProperties.Name="刷新系统参数" />
  <TextBlock Text="管理员修改系统参数后，可在此刷新，无需重启客户端。" Margin="0,8,0,0" TextWrapping="Wrap" />
  <TextBlock Text="{Binding ParameterRefreshStatus}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
 </StackPanel>
</Page>
