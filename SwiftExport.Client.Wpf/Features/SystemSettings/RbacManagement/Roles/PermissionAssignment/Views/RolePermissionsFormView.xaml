<UserControl x:Class="SwiftExportClient.Features.SystemSettings.RbacManagement.Roles.PermissionAssignment.Views.RolePermissionsFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="分配角色权限表单">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel>
        <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}" Command="{Binding CloseState.CloseCommand}"
                   BorderThickness="0"
                HorizontalAlignment="Right" MinWidth="32" MinHeight="32" ToolTip="关闭"
                AutomationProperties.Name="关闭表单" />

        <Grid Margin="0" RowDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBox x:Name="PermissionSearch" Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" AutomationProperties.Name="筛选角色权限" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <WrapPanel>
                    <ItemsControl x:Name="PermissionItems" ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}" Margin="0,4"
                                          AutomationProperties.Name="{Binding DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,8" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
