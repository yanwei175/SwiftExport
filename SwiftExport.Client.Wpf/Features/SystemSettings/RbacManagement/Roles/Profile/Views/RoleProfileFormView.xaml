<UserControl x:Class="SwiftExportClient.Features.SystemSettings.RbacManagement.Roles.Profile.Views.RoleProfileFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}"
             AutomationProperties.Name="角色资料表单">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <DockPanel>
        <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}" Command="{Binding CloseState.CloseCommand}"
                   BorderThickness="0"
                HorizontalAlignment="Right" MinWidth="32" MinHeight="32" ToolTip="关闭"
                AutomationProperties.Name="关闭表单" />

    <StackPanel Margin="12" MinWidth="360">

        <StackPanel x:Name="CreateFields" Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="角色编码（创建后不可修改）" />
            <TextBox Text="{Binding RoleCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="角色名称" />
            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="说明" />
            <TextBox Text="{Binding RoleDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        </StackPanel>

        <StackPanel x:Name="EditFields" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="角色编码" />
            <TextBox Text="{Binding RoleCode}" IsReadOnly="True" Margin="0,4,0,12" />
            <TextBlock Text="角色名称" />
            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="说明" />
            <ui:TextBox Text="{Binding RoleDescription, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="80"
                        TextWrapping="Wrap"                        
                        AcceptsReturn="True"
                        Margin="0,4,0,12" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
    </StackPanel>
    </DockPanel>
</UserControl>
