<UserControl x:Class="SwiftExportClient.Features.SystemSettings.RbacManagement.Users.Profile.Views.UserProfileFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="编辑用户资料表单">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <DockPanel>
        <ui:Button DockPanel.Dock="Top" Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}"
                Command="{Binding CloseState.CloseCommand}"
                HorizontalAlignment="Right" 
                BorderThickness="0"
                ToolTip="关闭"
                AutomationProperties.Name="关闭表单" />

        <StackPanel Margin="12" MinWidth="360">
            
            <TextBlock Text="用户名" />
            <TextBox Text="{Binding UserName,Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,12" />

            <TextBlock Text="显示名称" />
            <TextBox Text="{Binding UserNickName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

            <TextBlock Text="邮箱" />
            <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

            <TextBlock Text="电话" />
            <TextBox Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />

        </StackPanel>
    </DockPanel>
</UserControl>
