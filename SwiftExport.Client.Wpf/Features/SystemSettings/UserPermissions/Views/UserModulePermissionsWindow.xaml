<ui:FluentWindow x:Class="SwiftExportClient.Features.SystemSettings.UserPermissions.Views.UserModulePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="模块权限" Width="680" Height="640" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        AutomationProperties.Name="模块权限窗口">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0" Text="模块权限" Style="{StaticResource TitleTextBlock}" />
            <TextBlock Grid.Row="1" Margin="0,4,0,16" Text="保存完整模块集合；变更在目标用户下次登录后生效。" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="目标用户" />
                <ComboBox x:Name="UserBox" Margin="0,4,0,16" ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=OneWay}"
                          AutomationProperties.Name="模块权限目标用户">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserName}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding NickName}" />
                                <TextBlock Margin="8,0,0,0" Text="管理员">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Border Grid.Row="3" Padding="16" BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="1" CornerRadius="4">
                <ItemsControl ItemsSource="{Binding Modules}" IsEnabled="{Binding IsTargetEditable}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="4,8" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Height="2" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="关闭" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
                <ui:Button Content="保存模块权限" Appearance="Primary" IsDefault="True"
                           Command="{Binding SaveCommand}" MinWidth="128" />
            </StackPanel>
        </Grid>
        <ui:ContentDialogHost x:Name="LocalDialogHost" />
    </Grid>
</ui:FluentWindow>
