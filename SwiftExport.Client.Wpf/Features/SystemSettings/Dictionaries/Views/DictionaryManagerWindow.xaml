<ui:FluentWindow x:Class="SwiftExportClient.Features.SystemSettings.Dictionaries.Views.DictionaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="字典管理"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AutomationProperties.Name="字典管理窗口">
    <Grid RowDefinitions="Auto,*">
        <ui:TitleBar Grid.Row="0"
                     Title="字典管理"
                     ShowHelp="False"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />
        <Grid Grid.Row="1">
            <local:DictionaryManagerView x:Name="DictionaryView"
                   xmlns:local="clr-namespace:SwiftExportClient.Features.SystemSettings.Dictionaries.Views" />
            <ui:InfoBar x:Name="WindowInfoBar"
                        Margin="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        IsOpen="False"
                        IsClosable="True"
                        Panel.ZIndex="20" />
            <ui:ContentDialogHost x:Name="LocalDialogHost" Panel.ZIndex="30" />
        </Grid>
    </Grid>
</ui:FluentWindow>
