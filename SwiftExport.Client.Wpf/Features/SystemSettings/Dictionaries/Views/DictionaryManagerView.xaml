<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Dictionaries.Views.DictionaryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:components="clr-namespace:SwiftExportClient.Features.SystemSettings.Dictionaries.Components"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             mc:Ignorable="d"
             d:Width="1280"
             d:Height="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DictionaryEnabledCheckBox" TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource SwiftExportDataGridCheckBoxElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="内置字典值必须保持启用。" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DictionaryEnabledCheckBoxEditor" TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource SwiftExportDataGridCheckBoxEditingElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DictionaryNavigationButton" TargetType="{x:Type Button}"  BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="字典类型"
                                   Style="{StaticResource BodyStrongTextBlock}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="系统类型锁定，自定义类型可维护。"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Width="36"
                               Height="32"
                               Command="{Binding AddDictionaryTypeCommand}"
                               Icon="{ui:SymbolIcon Symbol=Add24}"
                               ToolTip="新增字典类型" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Dictionaries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DictionaryNavigationButton}"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.SelectDictionaryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource BodyStrongTextBlock}" />
                                            
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding Code}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                                            
                                        </StackPanel>
                                        
                                        <ui:SymbolIcon Grid.Column="3"
                                                       Margin="8,0,0,0"
                                                       Symbol="LockClosed24"
                                                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ui:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Padding="12" IsEnabled="{Binding HasTypeEditor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="字典类型属性"
                                       Style="{StaticResource BodyStrongTextBlock}" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="系统类型只读"
                                       Style="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                       Visibility="{Binding TypeEditor.IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Success"
                                       Command="{Binding SaveDictionaryTypeCommand}"
                                       Icon="{ui:SymbolIcon Symbol=Save24}"
                                       Content="保存类型" />
                            <ui:Button Margin="6,0,0,0"
                                       Command="{Binding RejectDictionaryTypeChangesCommand}"
                                       Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                       Content="放弃类型变更" />
                            <ui:Button Margin="6,0,0,0"
                                       Appearance="Danger"
                                       Command="{Binding DeleteDictionaryTypeCommand}"
                                       Icon="{ui:SymbolIcon Symbol=Delete24}"
                                       Content="删除类型" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="字典编码" Style="{StaticResource CaptionTextBlock}" />
                            <TextBox Margin="0,4,0,0"
                                     MinHeight="32"
                                     IsReadOnly="{Binding IsTypeEditorReadOnly}"
                                     Text="{Binding TypeEditor.DictCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="字典名称" Style="{StaticResource CaptionTextBlock}" />
                            <TextBox Margin="0,4,0,0"
                                     MinHeight="32"
                                     IsReadOnly="{Binding IsTypeEditorReadOnly}"
                                     Text="{Binding TypeEditor.DictName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="排序" Style="{StaticResource CaptionTextBlock}" />
                            <TextBox Margin="0,4,0,0"
                                     MinHeight="32"
                                     IsReadOnly="{Binding IsTypeEditorReadOnly}"
                                     Text="{Binding TypeEditor.SortOrder, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="备注" Style="{StaticResource CaptionTextBlock}" />
                            <TextBox Margin="0,4,0,0"
                                     MinHeight="32"
                                     IsReadOnly="{Binding IsTypeEditorReadOnly}"
                                     Text="{Binding TypeEditor.Remark, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:InfoBar Grid.Row="2"
                        Title="请检查当前数据"
                        Message="{Binding ValidationSummary}"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{Binding HasValidationError}" />

            <components:DictionaryDataEditor x:Name="ValueEditor" Grid.Row="4" Grid.RowSpan="5" DataContext="{Binding Values}" />
        </Grid>
    </Grid>
</UserControl>
