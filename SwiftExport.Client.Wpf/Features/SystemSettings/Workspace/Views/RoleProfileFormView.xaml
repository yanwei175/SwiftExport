<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.RoleProfileFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="角色资料表单">
    <StackPanel Margin="12" MinWidth="360">
        
        <StackPanel x:Name="CreateFields">
            <TextBlock Text="角色编码（创建后不可修改）" />
            <TextBox Text="{Binding NewRoleCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="角色名称" />
            <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="说明" />
            <TextBox Text="{Binding NewRoleDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        </StackPanel>
        
        <StackPanel x:Name="EditFields">
            <TextBlock Text="角色编码" />
            <TextBox Text="{Binding SelectedRole.RoleCode}" IsReadOnly="True" Margin="0,4,0,12" />
            <TextBlock Text="角色名称" />
            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="说明" />
            <TextBox Text="{Binding RoleDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
        
        <Button x:Name="SaveButton" Click="OnSave" HorizontalAlignment="Right"
                AutomationProperties.Name="保存角色资料" />
    </StackPanel>
</UserControl>
