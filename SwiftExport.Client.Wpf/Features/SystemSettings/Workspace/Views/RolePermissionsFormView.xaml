<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.RolePermissionsFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="分配角色权限表单">
    <Grid Margin="12" MinWidth="480" MaxHeight="600" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="{Binding SelectedRole.RoleName}" FontWeight="SemiBold" Margin="0,0,0,8" />
        
        <TextBox x:Name="PermissionSearch" Grid.Row="1" TextChanged="OnFilterChanged"
                 Margin="0,0,0,8" AutomationProperties.Name="筛选角色权限" />
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PermissionItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}" Margin="0,4"
                              AutomationProperties.Name="{Binding DisplayName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,8" />
            
            <Button x:Name="SaveButton" Content="保存完整权限集合" Click="OnSave"
                    HorizontalAlignment="Right" AutomationProperties.Name="保存角色完整权限集合" />
        </StackPanel>
    </Grid>
</UserControl>
