<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.UserRolesFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="分配用户角色表单">
    <Grid Margin="12" MinWidth="420" MaxHeight="560" RowDefinitions="Auto,*,Auto,Auto,Auto">
        
        <TextBlock Text="{Binding SelectedUser.UserName}" FontWeight="SemiBold" Margin="0,0,0,8" />
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding UserRoleChoices}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,4" AutomationProperties.Name="{Binding DisplayName}" />
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <TextBlock Grid.Row="2" Text="有效权限（只读）" Margin="0,8,0,4" />
        
        <ListBox Grid.Row="3" ItemsSource="{Binding EffectivePermissions}" Height="100" />
        
        <StackPanel Grid.Row="4">
            
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,8" />
            
            <ui:Button x:Name="SaveButton" Content="保存角色" Click="OnSave" Appearance="Primary"
                    HorizontalAlignment="Right" AutomationProperties.Name="保存用户完整角色集合" />
            
        </StackPanel>
    </Grid>
</UserControl>
