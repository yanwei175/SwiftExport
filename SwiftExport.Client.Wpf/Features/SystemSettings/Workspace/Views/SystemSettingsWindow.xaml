<ui:FluentWindow x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SwiftExport · 系统设置" Width="1280" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        AutomationProperties.Name="系统设置窗口">
    <Grid RowDefinitions="Auto,*">
        <ui:TitleBar Grid.Row="0" Title="SwiftExport · 系统设置"
                     ShowHelp="False" ShowMaximize="True" ShowMinimize="True" ShowClose="True" />
        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left" OpenPaneLength="208"
                               IsPaneOpen="True" IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed"
                               HeaderVisibility="Collapsed" AlwaysShowHeader="False">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="UsersNavigation" Content="用户管理" Click="OnUsersNavigation"
                                           AutomationProperties.Name="用户管理" />
                    <ui:NavigationViewItem x:Name="RolesNavigation" Content="角色管理" Click="OnRolesNavigation"
                                           AutomationProperties.Name="角色管理" />
                    <ui:NavigationViewItem x:Name="PermissionsNavigation" Content="权限定义" Click="OnPermissionsNavigation"
                                           AutomationProperties.Name="权限定义" />
                    <ui:NavigationViewItem x:Name="DictionaryNavigation" Content="字典管理" Click="OnDictionaryNavigation"
                                           AutomationProperties.Name="字典管理" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>
            <ui:InfoBar x:Name="WindowInfoBar" Margin="224,16,16,0" HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" IsOpen="False" IsClosable="True" Panel.ZIndex="20" />
            <ui:ContentDialogHost x:Name="LocalDialogHost" Panel.ZIndex="30" />
        </Grid>
    </Grid>
</ui:FluentWindow>
