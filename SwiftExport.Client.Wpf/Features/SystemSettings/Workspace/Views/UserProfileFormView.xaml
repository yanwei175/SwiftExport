<UserControl x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.UserProfileFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsEnabled="{Binding IsNotBusy}" AutomationProperties.Name="编辑用户资料表单">
    <StackPanel Margin="12" MinWidth="360">
        <TextBlock Text="用户名" />
        <TextBox Text="{Binding SelectedUser.UserName}" IsReadOnly="True" Margin="0,4,0,12" />
        
        <TextBlock Text="显示名称" />
        <TextBox Text="{Binding UserNickName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        
        <TextBlock Text="邮箱" />
        <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        
        <TextBlock Text="电话" />
        <TextBox Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
        
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
        
        <ui:Button x:Name="SaveButton" Content="保存资料" Click="OnSave" Appearance="Primary"
                HorizontalAlignment="Right" AutomationProperties.Name="保存用户资料" />
        
    </StackPanel>
</UserControl>
