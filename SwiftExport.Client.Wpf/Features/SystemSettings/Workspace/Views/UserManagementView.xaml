<Page x:Class="SwiftExportClient.Features.SystemSettings.Workspace.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        AutomationProperties.Name="用户管理页面">
    <Grid Margin="24" RowDefinitions="Auto,12,*,Auto">
        <DockPanel Grid.Row="0">
            <TextBlock Text="用户管理" Style="{StaticResource TitleTextBlock}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CreateUserButton" Content="新增用户" Click="OnCreateUser" Margin="0,0,8,0"
                        AutomationProperties.Name="打开新增用户表单" />
                <Button Content="刷新用户" Click="OnRefresh" AutomationProperties.Name="刷新用户列表" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,8,*,8,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,8,0"
                         PlaceholderText="按用户名或显示名称筛选已载入用户"
                         TextChanged="OnFilterChanged" AutomationProperties.Name="筛选用户" />
                <ComboBox x:Name="StatusFilter" Width="120" SelectedIndex="0" VerticalContentAlignment="Center"
                          SelectionChanged="OnFilterChanged" AutomationProperties.Name="用户状态筛选">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="已启用" />
                    <ComboBoxItem Content="已停用" />
                </ComboBox>
            </StackPanel>
            
            <DataGrid x:Name="UserGrid" Grid.Row="2" ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser, Mode=OneWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" AutomationProperties.Name="用户列表">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="140" />
                    
                    <DataGridTextColumn Header="显示名称" Binding="{Binding NickName}" Width="*" MinWidth="120" />
                    
                    <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="180" />
                    
                    <DataGridTextColumn Header="电话" Binding="{Binding PhoneNumber}" Width="130" />
                    
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="64"
                                            ElementStyle="{StaticResource SwiftExportDataGridCheckBoxElementStyle}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridCheckBoxEditingElementStyle}"/>
                    <DataGridCheckBoxColumn Header="管理员" Binding="{Binding IsAdmin}" Width="76"
                                            ElementStyle="{StaticResource SwiftExportDataGridCheckBoxElementStyle}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridCheckBoxEditingElementStyle}" />
                    
                    
                    <DataGridTemplateColumn Header="操作" Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="编辑" Click="OnEditUser" Margin="0,0,4,0" />
                                    <Button Content="分配角色" Click="OnAssignRoles" Margin="0,0,4,0" />
                                    <Button Content="重置密码" Click="OnResetPassword" Margin="0,0,4,0" />
                                    <Button Content="启/停" Click="OnSetUserStatus" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="CountText" Grid.Row="4" Text="0 条" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
