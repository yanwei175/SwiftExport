<UserControl x:Class="SwiftExportClient.Features.Customers.CustomerPoConfigs.Views.CustomerPoConfigManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:customerComponents="clr-namespace:SwiftExportClient.Features.Customers.Components"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridNumeric="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns.Numeric;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d" d:Height="760" d:Width="1320">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <DataTemplate x:Key="CustomerPoConfigCurrencyOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CurrencyCode}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding CurrencyNameZh}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*" RowDefinitions="Auto">
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="搜索客户编码或供应商编码">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <DockPanel Grid.Column="2" >
                    <ui:Button Appearance="Primary" Margin="8,0,0,0" 
                               Content="查询" VerticalAlignment="Stretch"
                               Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" 
                                VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" 
                               VerticalAlignment="Stretch" MinWidth="70"/>

                </DockPanel>
            </Grid>

            <DockPanel Grid.Row="2" >

                <ui:Button Content="新增" Command="{Binding AddRowCommand}"  Margin="0,0,8,0"  MinWidth="70"/>

                <ui:Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0"  Appearance="Info"
                           MinWidth="70" />

                <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" MinWidth="70"/>


                <ui:Button Content="放弃" Command="{Binding RejectListChangesCommand}" Margin="0,0,8,0"  MinWidth="70"/>

                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
            </DockPanel>
        </Grid>

        <DataGrid x:Name="ConfigGrid" Grid.Row="2"
                  ItemsSource="{Binding Lines.Items}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  RowHeight="{StaticResource DataGridRowHeightSmall}"
                  AutoGenerateColumns="False"
                  IsReadOnly="{Binding IsReadOnly}"
                  SelectionMode="Extended"
                  SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                  FrozenColumnCount="3"
                  gridCore:EnterpriseGrid.IsEnabled="True"
                  gridCore:GridVirtualization.IsEnabled="True"
                  gridCore:GridRowHeader.ShowRowNumber="True"
                  gridOperations:GridOperations.IsEnabled="True"
                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                  gridValidation:GridValidation.IsEnabled="True"
                  AutomationProperties.Name="客户采购默认配置可编辑列表">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DataContext.Lines.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" AutomationProperties.Name="全选配置" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" AutomationProperties.Name="选择配置行" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="客户" Width="150" SortMemberPath="CustomerCode"
                                        gridColumns:GridColumn.Key="customer-code"
                                        gridColumns:GridColumn.FieldPath="CustomerCode"
                                        gridColumns:GridColumn.CanFillDown="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CustomerCode}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <customerComponents:CustomerAutoSuggestComboBox
                                ItemsSource="{Binding DataContext.CustomerOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}"
                                SelectionCommittedCommand="{Binding DataContext.CommitCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                SelectionClearedCommand="{Binding DataContext.ClearCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}" Placeholder="选择客户" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="供应商" Width="150" SortMemberPath="SupplierCode"
                                        gridColumns:GridColumn.Key="supplier-code"
                                        gridColumns:GridColumn.FieldPath="SupplierCode"
                                        gridColumns:GridColumn.CanFillDown="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SupplierCode}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <supplierComponents:SupplierAutoSuggestComboBox
                                StretchToHost="True"
                                ItemsSource="{Binding DataContext.SupplierOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                                SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}" Placeholder="选择供应商" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="币种" Width="140"
                                        SortMemberPath="Currency"
                                        gridColumns:GridColumn.Key="currency"
                                        gridColumns:GridColumn.FieldPath="Currency">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="4,0"
                                      FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                                      ItemsSource="{Binding DataContext.CurrencyOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      ItemTemplate="{StaticResource CustomerPoConfigCurrencyOptionTemplate}"
                                      SelectedValuePath="CurrencyCode"
                                      SelectedValue="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="CurrencyCode"
                                      AutomationProperties.Name="默认币种" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <gridNumeric:NumericDataGridColumn Header="默认折扣率（≥0；1.05 表示涨价 5%）" Width="230"
                                                   Binding="{Binding DefaultDiscountRate, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" AllowEmpty="True" MaximumDecimalPlaces="6"
                                                   ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                   EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                   gridColumns:GridColumn.Key="default-discount-rate"
                                                   gridColumns:GridColumn.FieldPath="DefaultDiscountRate" />

                <DataGridTextColumn Header="折扣备注" Width="220"
                                    Binding="{Binding DiscountRemark, UpdateSourceTrigger=LostFocus}"
                                    ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                    gridColumns:GridColumn.Key="discount-remark"
                                    gridColumns:GridColumn.FieldPath="DiscountRemark" />

                <DataGridTextColumn Header="进水管" Width="120" Binding="{Binding InletHoseType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="inlet-hose-type" gridColumns:GridColumn.FieldPath="InletHoseType" />
                <DataGridTextColumn Header="起泡器" Width="120" Binding="{Binding AeratorType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="aerator-type" gridColumns:GridColumn.FieldPath="AeratorType" />
                <DataGridTextColumn Header="托盘" Width="120" Binding="{Binding PalletType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="pallet-type" gridColumns:GridColumn.FieldPath="PalletType" />
                <DataGridTextColumn Header="包装盒" Width="120" Binding="{Binding BoxType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="box-type" gridColumns:GridColumn.FieldPath="BoxType" />
                <DataGridTextColumn Header="标签" Width="120" Binding="{Binding LabelType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="label-type" gridColumns:GridColumn.FieldPath="LabelType" />
                <DataGridTextColumn Header="说明书" Width="120" Binding="{Binding IMType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="im-type" gridColumns:GridColumn.FieldPath="IMType" />
                <DataGridTextColumn Header="外箱" Width="120" Binding="{Binding CartonType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="carton-type" gridColumns:GridColumn.FieldPath="CartonType" />
                <DataGridTextColumn Header="标志" Width="120" Binding="{Binding LogoType, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="logo-type" gridColumns:GridColumn.FieldPath="LogoType" />
                <DataGridTextColumn Header="销售人员" Width="110" Binding="{Binding SalesPerson, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="sales-person" gridColumns:GridColumn.FieldPath="SalesPerson" />
                <DataGridTextColumn Header="采购人员" Width="110" Binding="{Binding Purchaser, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="purchaser" gridColumns:GridColumn.FieldPath="Purchaser" />
                <DataGridTextColumn Header="备注" Width="220" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" gridColumns:GridColumn.Key="note" gridColumns:GridColumn.FieldPath="Note" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ValidationSummary}" Margin="12,0,0,0" Foreground="{DynamicResource UserBusinessTextWarningBrush}" Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Margin="12,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
