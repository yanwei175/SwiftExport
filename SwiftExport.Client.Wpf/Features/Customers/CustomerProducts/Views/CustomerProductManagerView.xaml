<UserControl x:Class="SwiftExportClient.Features.Customers.CustomerProducts.Views.CustomerProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SwiftExportClient.Features.Customers.CustomerProducts.Views"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"  d:DesignHeight="450" d:DesignWidth="1200">

    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    
    <Grid Margin="12" RowDefinitions="Auto,8,*,8,Auto">
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*" RowDefinitions="Auto">
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="客户料号、SKU、描述或系列">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <DockPanel Grid.Column="2" >
                    <ui:Button Appearance="Primary" Margin="8,0,0,0" 
                               Content="查询" VerticalAlignment="Stretch"
                               Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" 
                                VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" 
                               VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="关闭" Command="{Binding CloseCommand}" Margin="8,0,0,0"  
                               VerticalAlignment="Stretch" HorizontalAlignment="Right" MinWidth="70"/>
                </DockPanel>
            </Grid>

            <DockPanel Grid.Row="2" >
                <ui:Button Content="新增" Command="{Binding AddItemCommand}"  Margin="0,0,8,0"  MinWidth="70"/>
                
                <ui:Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0"  Appearance="Info"
                           MinWidth="70" />
                
                <ui:Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" Content="删除" MinWidth="70"/>
                
                <ui:Button Command="{Binding RejectCommand}" Margin="0,0,8,0" Content="放弃" MinWidth="70"/>

                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
            </DockPanel>
        </Grid>
        
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Products.Items}" 
                  SelectionMode="Extended" 
                  SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                  FrozenColumnCount="4" 
                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True"
                  gridCore:GridRowHeader.ShowRowNumber="True" gridOperations:GridOperations.IsEnabled="True"
                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                  gridValidation:GridValidation.IsEnabled="True">
            <DataGrid.Columns>

                <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding DataContext.Products.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox  HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="图片" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="56" Height="56" Style="{StaticResource SwiftExportCachedImage}" DecodePixelWidth="96" SourcePath="{Binding MainImage}" Stretch="Uniform" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                

                <DataGridTextColumn Header="客户型号" Width="140" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTemplateColumn Header="关联Sku" Width="150" SortMemberPath="Sku">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <productComponents:ProductLookupTextBox
                                Text="{Binding Sku, Mode=OneWay}"
                                FontSize="10"
                                ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}"
                                IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="客户描述" Width="180" Binding="{Binding CustomerPdDescription, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                
                <DataGridTextColumn Header="客户系列名" Width="110" Binding="{Binding CustomerPdSeries, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTextColumn Header="客户颜色名" Width="100" Binding="{Binding CustomerColorName, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTextColumn Header="客户专用规格" Width="180" Binding="{Binding CustomerPdFeatures, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />

                <DataGridTextColumn Header="条码1" Width="120" Binding="{Binding CustomerBarcode1, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
                
                <DataGridTextColumn Header="条码2" Width="120" Binding="{Binding CustomerBarcode2, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
                
                <DataGridTextColumn Header="备注" Width="160" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                
                <DataGridTextColumn Header="MOQ" Width="70" Binding="{Binding Moq, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                
                <DataGridTextColumn Header="交期(天)" Width="78" Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="美元价" Width="90" Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="人民币价" Width="90" Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                
                <DataGridTemplateColumn Header="启用" Width="60" SortMemberPath="IsActive">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            
            <TextBlock Grid.Column="1" 
                       Text="{Binding PageStatus}" 
                       Style="{StaticResource CaptionTextBlock}" 
                       VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" 
                            TotalCount="{Binding TotalCount}" 
                            PageIndex="{Binding PageIndex}" 
                            PageSize="{Binding PageSize}" 
                            PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
