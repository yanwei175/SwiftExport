<UserControl x:Class="SwiftExportClient.Features.Customers.CustomerProducts.Views.CustomerProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:LookupTextBox Placeholder="客户料号、SKU、描述或系列" MinimumSearchLength="0"
                                    Text="{Binding Keyword, Mode=TwoWay}" QueryCommand="{Binding SearchCommand}" />
            <ui:Button Grid.Column="2" 
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Search24}"
                    Width="36" 
                    Command="{Binding SearchCommand}" 
                    ToolTip="查询"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddItemCommand}"  Margin="0,0,4,0" Content="新增" />
                <Button Command="{Binding SaveCommand}" Margin="0,0,4,0" Content="保存" />
                <Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0" Content="删除" />
                <Button Command="{Binding RejectCommand}" Margin="0,0,4,0" Content="放弃" />
                <Button Command="{Binding RefreshCommand}" Content="刷新" />
            </StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                <Button Command="{Binding CloseCommand}" Content="关闭" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
        <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding Products.Items}" 
                  Style="{StaticResource SwiftExportDataGrid}" 
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  SelectionMode="Extended" 
                  SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                  FrozenColumnCount="4" 
                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                  gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True"
                  gridCore:GridRowHeader.ShowRowNumber="True" gridOperations:GridOperations.IsEnabled="True"
                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                  gridValidation:GridValidation.IsEnabled="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding DataContext.Products.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox  HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="图片" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                    <controls:CachedImage Width="56" Height="56" Style="{StaticResource SwiftExportCachedImage}" DecodePixelWidth="96" SourcePath="{Binding MainImage}" Stretch="Uniform" />
                </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="标准 SKU" Width="150" SortMemberPath="Sku">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridTextBlock}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                        <productComponents:ProductLookupTextBox
                            Text="{Binding Sku, Mode=OneWay}"
                            FontSize="10"
                            ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                            SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionCommittedCommandParameter="{Binding}"
                            SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionClearedCommandParameter="{Binding}"
                            IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="客户料号" Width="140" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="客户描述" Width="180" Binding="{Binding CustomerPdDescription, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                <DataGridTextColumn Header="客户系列" Width="110" Binding="{Binding CustomerPdSeries, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="客户颜色" Width="100" Binding="{Binding CustomerColorName, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="客户规格" Width="180" Binding="{Binding CustomerPdFeatures, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />

                <DataGridTextColumn Header="美元价" Width="90" Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="人民币价" Width="90" Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="条码1" Width="120" Binding="{Binding CustomerBarcode1, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="条码2" Width="120" Binding="{Binding CustomerBarcode2, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="MOQ" Width="70" Binding="{Binding Moq, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="交期(天)" Width="78" Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="备注" Width="160" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                <DataGridTemplateColumn Header="启用" Width="60" SortMemberPath="IsActive">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
