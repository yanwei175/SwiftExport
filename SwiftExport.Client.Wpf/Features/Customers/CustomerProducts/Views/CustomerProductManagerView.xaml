<UserControl xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="SwiftExportClient.Features.Customers.CustomerProducts.Views.CustomerProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:customers="clr-namespace:SwiftExportClient.Features.Customers.Components"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged" mc:Ignorable="d"  d:DesignHeight="450" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="CustomerProductSelectionMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    
    <Grid Margin="12" RowDefinitions="Auto,8,*,8,Auto">
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid x:Name="CustomerSearchGrid" ColumnDefinitions="3*,3*,Auto" RowDefinitions="Auto">
                <customers:CustomerAutoSuggestComboBox x:Name="CustomerSelector" Grid.Column="0" Margin="0,0,8,0" Placeholder="输入客户代码或名称"
                    ItemsSource="{Binding CustomerOptions}" SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}"
                    SelectionCommittedCommand="{Binding CommitCustomerCommand}" SelectionClearedCommand="{Binding ClearCustomerCommand}"
                    IsEnabled="{Binding CanChangeCustomer}" AutomationProperties.Name="选择客户产品所属客户"/>
                <!--搜索框-->
                <ui:TextBox x:Name="SearchTextBox" Grid.Column="1" IsEnabled="{Binding CanEditProducts}" VerticalAlignment="Stretch"
                            FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="客户料号、SKU、描述或系列">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <DockPanel Grid.Column="2" >
                    <ui:Button Appearance="Primary" Margin="8,0,0,0" 
                               Content="查询" VerticalAlignment="Stretch"
                               Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" 
                                VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button x:Name="ClearCustomerButton" Content="清空客户" Command="{Binding ClearCustomerCommand}" Margin="8,0,0,0"
                               VerticalAlignment="Stretch" HorizontalAlignment="Right" MinWidth="70"/>
                </DockPanel>
            </Grid>

            <DockPanel Grid.Row="2" IsEnabled="{Binding CanEditProducts}">
                <ui:Button Content="新增" Command="{Binding AddItemCommand}"  Margin="0,0,8,0"  MinWidth="70"/>
                
                <ui:Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0"  Appearance="Info"
                           MinWidth="70" />
                
                <ui:Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" Content="删除" MinWidth="70"/>
                
                <ui:Button Command="{Binding RejectCommand}" Margin="0,0,8,0" Content="放弃" MinWidth="70"/>

                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
            </DockPanel>
        </Grid>
        
        <DataGrid x:Name="ProductGrid" Grid.Row="2"
                  ItemsSource="{Binding Products.Items}" IsEnabled="{Binding CanEditProducts}"
                  SelectionMode="Extended" 
                  SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                  FrozenColumnCount="4" 
                  RowHeight="{StaticResource DataGridRowHeightSmall}"
                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  gridCore:GridRowHeader.ShowRowNumber="True"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                        <fill:DataGridColumnVisibilityBehavior />
                    </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="客户产品批量勾选">
                    <MenuItem Header="勾选(选区)" Style="{StaticResource CustomerProductSelectionMenuItem}" Command="{Binding CheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkSquare24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="取消勾选(选区)" Style="{StaticResource CustomerProductSelectionMenuItem}" Command="{Binding UncheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Square24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(选区)" Style="{StaticResource CustomerProductSelectionMenuItem}" Command="{Binding InvertSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="全选(当前页)" Command="{Binding CheckVisibleCommand}" ToolTip="仅勾选当前页显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(当前页)" Command="{Binding InvertVisibleCommand}" ToolTip="仅反转当前页显示行的勾选"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOff24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="删除" Command="{Binding DeleteSelectedCommand}" ToolTip="删除已勾选客户产品；未勾选时删除当前产品"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" Margin="0" Padding="0" AutomationProperties.Name="勾选当前页显示行"
                                      IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                      Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox  HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="图片" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="24" Height="24"
                                                  Style="{StaticResource SwiftExportCachedImage}" 
                                                  DecodePixelWidth="96" 
                                                  SourcePath="{Binding MainImage}" Stretch="Uniform" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                

                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerSku" Header="客户型号" Width="140" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTemplateColumn ClipboardContentBinding="{Binding Sku, Mode=OneWay}" Header="关联Sku" Width="150" SortMemberPath="Sku">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <productComponents:ProductLookupTextBox
                                Text="{Binding Sku, Mode=OneWay}" 
                                ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}"
                                IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerPdDescription" Header="客户描述" Width="180" Binding="{Binding CustomerPdDescription, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerPdSeries" Header="客户系列名" Width="110" Binding="{Binding CustomerPdSeries, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerColorName" Header="客户颜色名" Width="100" Binding="{Binding CustomerColorName, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerPdFeatures" Header="客户专用规格" Width="180" Binding="{Binding CustomerPdFeatures, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />

                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerBarcode1" Header="条码1" Width="120" Binding="{Binding CustomerBarcode1, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CustomerBarcode2" Header="条码2" Width="120" Binding="{Binding CustomerBarcode2, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="Note" Header="备注" Width="160" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="Moq" Header="MOQ" Width="70" Binding="{Binding Moq, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                
                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="LeadTimeDays" Header="交期(天)" Width="78" Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="UsdPrice" Header="美元价" Width="90" Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn fill:DataGridFillDownBehavior.Field="CnyPrice" Header="人民币价" Width="90" Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                
                <DataGridTemplateColumn ClipboardContentBinding="{Binding IsActive, Mode=OneWay}" Header="启用" Width="60" SortMemberPath="IsActive">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" IsEnabled="{Binding CanEditProducts}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            
            <TextBlock Grid.Column="1" 
                       Text="{Binding PageStatus}" 
                       Style="{StaticResource CaptionTextBlock}" 
                       VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" 
                            TotalCount="{Binding TotalCount}" 
                            PageIndex="{Binding PageIndex}" 
                            PageSize="{Binding PageSize}" 
                            PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="请先选择客户" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="选择一个已保存客户后，才能管理该客户的产品。" Margin="0,8,0,0" Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
