<UserControl x:Class="SwiftExportClient.Features.Customers.Components.CustomerAutoSuggestComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:customers="clr-namespace:SwiftExport.Contracts.DTOs.Customers;assembly=SwiftExport.Contracts"
             FontSize="{DynamicResource ContentControlFontSize}"
             mc:Ignorable="d" d:DesignHeight="30" d:DesignWidth="120"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="CustomerItemTemplate" DataType="{x:Type customers:CustomerDto}">
            <Grid MinWidth="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding CustomerCode}" 
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor" StretchToHost="False"
                            automation:AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedCustomer, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="CustomerCode"
                            FilterMemberPaths="CustomerCode,CustomerName"
                            SelectedValuePath="Uid"
                            RequireItemMatch="True"
                            ClearSelectionOnEdit="False"
                            ShowDropDownButton="True"
                            MatchSuggestionFontSize="True"
                            ItemTemplate="{StaticResource CustomerItemTemplate}" />
</UserControl>
