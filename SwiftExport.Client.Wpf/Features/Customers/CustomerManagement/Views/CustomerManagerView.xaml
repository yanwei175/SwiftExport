<UserControl x:Class="SwiftExportClient.Features.Customers.CustomerManagement.Views.CustomerManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:drawerViews="clr-namespace:SwiftExportClient.Features.Customers.CustomerProducts.Views"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <DataTemplate x:Key="CustomerDictionaryOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DataNameEn}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                           Text="{Binding DataNameZh}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CustomerCurrencyOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CurrencyCode}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                           Text="{Binding CurrencyNameZh}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:LookupTextBox Placeholder="客户代码或名称"
                                    MinimumSearchLength="0"
                                    Text="{Binding Keyword, Mode=TwoWay}"
                                    QueryCommand="{Binding SearchCommand}" />
            <ui:Button Grid.Column="2" Width="36" Command="{Binding SearchCommand}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Search24}"
                       ToolTip="查询"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ui:Button Command="{Binding AddRowCommand}"
                           Content="新增"
                           Icon="{ui:SymbolIcon Symbol=Add24}"
                           Appearance="Primary"
                           Margin="0,0,4,0"/>

                <ui:Button Command="{Binding SaveCommand}" 
                           Icon="{ui:SymbolIcon Symbol=Save24}"
                           Content="保存"
                            Margin="0,0,4,0"/>

                <Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" /><TextBlock Margin="6,0,0,0" Text="删除" /></StackPanel></Button>
                <Button Command="{Binding RejectCommand}" 
                        Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset24" />
                        <TextBlock Margin="6,0,0,0" Text="放弃" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" /><TextBlock Margin="6,0,0,0" Text="刷新" /></StackPanel></Button>
            </StackPanel>
            <StackPanel Grid.Column="6" Orientation="Horizontal">
                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsEnabled="{Binding CanChangeSelectionMode}"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                <ui:ToggleSwitch VerticalAlignment="Center"
                                 Content="快速管理客户产品"
                                 IsChecked="{Binding CustomerProducts.IsOpen, Mode=OneWay}"
                                 Command="{Binding ToggleCustomerProductsCommand}" />
            </StackPanel>
        </Grid>

        <controls:RightDrawerHost Grid.Row="2" DisplayMode="Overlay"
                                  DrawerWidth="1360"
                                  MinDrawerWidth="520"
                                  IsResizable="True"
                                  DrawerContent="{Binding CustomerProducts}"
                                  IsOpen="{Binding CustomerProducts.IsOpen, Mode=OneWay}"
                                  CloseCommand="{Binding CustomerProducts.CloseCommand}">
            <controls:RightDrawerHost.MainContent>
                <DataGrid ItemsSource="{Binding Customers.Items}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          SelectionMode="Extended"
                          SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                          FrozenColumnCount="3"
                          RowHeight="{StaticResource DataGridRowHeightSmall}"
                          FontSize="12"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True"
                          gridOperations:GridOperations.IsEnabled="True"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                          gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsChecked="{Binding DataContext.Customers.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" Margin="0,0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="客户代码" Width="110" 
                                            Binding="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="客户名称" Width="180" 
                                            Binding="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="单据关联号" Width="120" 
                                            Binding="{Binding DocRelateNo, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="联系人" Width="100" 
                                            Binding="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="电话" Width="120" 
                                            Binding="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="地址" Width="220" 
                                            Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        
                        <DataGridTemplateColumn Header="贸易条款" Width="90"
                                                SortMemberPath="Incoterm"
                                                gridColumns:GridColumn.Key="incoterm"
                                                gridColumns:GridColumn.FieldPath="Incoterm">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4,0"
                                              ItemsSource="{Binding DataContext.IncotermOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerDictionaryOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              SelectedValue="{Binding Incoterm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="DataNameEn" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="条款地点" Width="140"
                                                SortMemberPath="IncotermLocation"
                                                gridColumns:GridColumn.Key="incoterm-location"
                                                gridColumns:GridColumn.FieldPath="IncotermLocation">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="8,0"
                                              ItemsSource="{Binding DataContext.IncotermLocationOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerDictionaryOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              SelectedValue="{Binding IncotermLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="DataNameEn" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="条款备注" Width="180"
                                                SortMemberPath="IncotermSortRemark"
                                                gridColumns:GridColumn.Key="incoterm-sort-remark"
                                                gridColumns:GridColumn.FieldPath="IncotermSortRemark">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="8,0"
                                              ItemsSource="{Binding DataContext.IncotermSortRemarkOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerDictionaryOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              SelectedValue="{Binding IncotermSortRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="DataNameEn" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="定金比例" 
                                            Width="88" 
                                            Binding="{Binding DepositRate, UpdateSourceTrigger=LostFocus, StringFormat=P0}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                        
                        <DataGridTextColumn Header="交期(天)" Width="78" 
                                            Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                        
                        <DataGridTemplateColumn Header="付款方式" Width="120"
                                                SortMemberPath="PaymentMethod"
                                                gridColumns:GridColumn.Key="payment-method"
                                                gridColumns:GridColumn.FieldPath="PaymentMethod">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4,0"
                                              ItemsSource="{Binding DataContext.PaymentMethodOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerDictionaryOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              SelectedValue="{Binding PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="DataNameEn" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="币种" Width="140"
                                                SortMemberPath="Currency"
                                                gridColumns:GridColumn.Key="currency"
                                                gridColumns:GridColumn.FieldPath="Currency">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4,0"
                                              ItemsSource="{Binding DataContext.CurrencyOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerCurrencyOptionTemplate}"
                                              SelectedValuePath="CurrencyCode"
                                              SelectedValue="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="CurrencyCode" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="承运方式" Width="100"
                                                SortMemberPath="ShippedBy"
                                                gridColumns:GridColumn.Key="shipped-by"
                                                gridColumns:GridColumn.FieldPath="ShippedBy">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4,0"
                                              ItemsSource="{Binding DataContext.ShippedByOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ItemTemplate="{StaticResource CustomerDictionaryOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              IsEditable="False"
                                              SelectedValue="{Binding ShippedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="DataNameEn" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="ETD备注" 
                                            Width="160" 
                                            Binding="{Binding EtdSortRemark, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContentTemplate>
                <DataTemplate>
                    <drawerViews:CustomerProductManagerView/>
                </DataTemplate>
            </controls:RightDrawerHost.DrawerContentTemplate>

        </controls:RightDrawerHost>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResultSummary}"
                       Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}"
                       Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2"
                                    TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}"
                                    PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
