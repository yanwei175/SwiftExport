<UserControl x:Class="SwiftExportClient.Features.Customers.CustomerManagement.Views.CustomerManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:drawerViews="clr-namespace:SwiftExportClient.Features.Customers.CustomerProducts.Views"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:LookupTextBox Placeholder="客户代码或名称"
                                    MinimumSearchLength="0"
                                    Text="{Binding Keyword, Mode=TwoWay}"
                                    QueryCommand="{Binding SearchCommand}" />
            <Button Grid.Column="2" Width="36" Command="{Binding SearchCommand}"
                    Style="{StaticResource AccentButton}" ToolTip="查询">
                <ui:SymbolIcon Symbol="Search24" />
            </Button>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddRowCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" /><TextBlock Margin="6,0,0,0" Text="新增" /></StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" /><TextBlock Margin="6,0,0,0" Text="保存" /></StackPanel></Button>
                <Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" /><TextBlock Margin="6,0,0,0" Text="删除" /></StackPanel></Button>
                <Button Command="{Binding RejectCommand}" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowReset24" /><TextBlock Margin="6,0,0,0" Text="放弃" /></StackPanel></Button>
                <Button Command="{Binding RefreshCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" /><TextBlock Margin="6,0,0,0" Text="刷新" /></StackPanel></Button>
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="6" VerticalAlignment="Center"
                             Content="管理客户产品"
                             IsChecked="{Binding CustomerProducts.IsOpen, Mode=OneWay}"
                             Command="{Binding CustomerProducts.ToggleCommand}"
                             CommandParameter="{Binding SelectedLine}" />
        </Grid>

        <controls:RightDrawerHost Grid.Row="2" DisplayMode="Overlay"
                                  DrawerWidth="960" MinDrawerWidth="520" IsResizable="True"
                                  DrawerContent="{Binding CustomerProducts}"
                                  IsOpen="{Binding CustomerProducts.IsOpen, Mode=OneWay}"
                                  CloseCommand="{Binding CustomerProducts.CloseCommand}">
            <controls:RightDrawerHost.MainContent>
                <DataGrid ItemsSource="{Binding Customers.Items}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          FrozenColumnCount="3"
                          RowHeight="{StaticResource DataGridRowHeightSmall}"
                          FontSize="12"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True"
                          gridOperations:GridOperations.IsEnabled="True"
                          gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="43" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Left"                                               
                                              IsChecked="{Binding DataContext.Customers.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Left" Margin="4,0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="客户代码" Width="110" Binding="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="客户名称" Width="180" Binding="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="单据关联号" Width="120" Binding="{Binding DocRelateNo, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="联系人" Width="100" Binding="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="电话" Width="120" Binding="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="地址" Width="220" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn Header="贸易条款" Width="90" Binding="{Binding Incoterm, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="条款地点" Width="120" Binding="{Binding IncotermLocation, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="条款备注" Width="160" Binding="{Binding IncotermSortRemark, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn Header="定金比例" Width="88" Binding="{Binding DepositRate, UpdateSourceTrigger=LostFocus, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        <DataGridTextColumn Header="交期(天)" Width="78" Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        <DataGridTextColumn Header="付款方式" Width="100" Binding="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="币种" Width="70" Binding="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="承运方式" Width="100" Binding="{Binding ShippedBy, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="ETD备注" Width="160" Binding="{Binding EtdSortRemark, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContentTemplate>
                <DataTemplate>
                    <drawerViews:CustomerProductManagerView />
                </DataTemplate>
            </controls:RightDrawerHost.DrawerContentTemplate>

        </controls:RightDrawerHost>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResultSummary}"
                       Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}"
                       Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2"
                                    TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}"
                                    PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
