<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             >


    <Grid Margin="12,8" RowDefinitions="Auto,*">

        <!--命令与条件工具栏：命令、常用文本条件、状态及日期条件分行，避免窄窗口互相挤压。-->
        <Grid RowDefinitions="Auto,4,Auto,4,Auto">
            <DockPanel LastChildFill="True">
                <TextBlock Text="采购工作台" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="从净需求获取" Command="{Binding GetFromNetDemandCommand}" Style="{StaticResource AccentButton}" Margin="4,0,0,0"/>
                    <Button Content="快速查看" Command="{Binding OpenDrawerCommand}" Margin="4,0,0,0"/>
                    <Button Content="查看详情" Command="{Binding OpenDetailCommand}" Margin="4,0,0,0"/>
                    <Button Content="确认" Command="{Binding ConfirmCommand}" Margin="4,0,0,0"/>
                    <Button Content="取消确认" Command="{Binding PrepareCancelConfirmationCommand}" Margin="4,0,0,0"/>
                    <Button Content="追踪" Command="{Binding OpenTraceCommand}" Margin="4,0,0,0"/>
                    <Button Content="导出" Command="{Binding ExportCommand}" Margin="4,0,0,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="4,0,0,0"/>
                </WrapPanel>
            </DockPanel>

            <Grid Grid.Row="2" ColumnDefinitions="2*,8,140,8,140,8,160,8,130,8,Auto,4,Auto">
                <ui:TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="采购单、来源、供应商"/>
                <ui:TextBox Grid.Column="2" Text="{Binding OrderNo}" PlaceholderText="采购单号"/>
                <ui:TextBox Grid.Column="4" Text="{Binding SourceNo}" PlaceholderText="来源单号"/>
                <ui:TextBox Grid.Column="6" Text="{Binding SupplierKeyword}" PlaceholderText="供应商"/>
                <ui:TextBox Grid.Column="8" Text="{Binding Sku}" PlaceholderText="SKU"/>
                <Button Grid.Column="10" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/>
                <Button Grid.Column="12" Content="清空筛选" Command="{Binding ClearFiltersCommand}"/>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="145,8,145,8,145,8,125,8,125,8,125,8,125,*">
                <controls:DropDownCheckBox Placeholder="确认状态" DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding ConfirmationOptions}"
                                           SelectedItems="{Binding SelectedConfirmationStatuses,Mode=OneWay}"/>
                <controls:DropDownCheckBox Grid.Column="2" Placeholder="生命周期" DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding LifecycleOptions}"
                                           SelectedItems="{Binding SelectedLifecycleStatuses,Mode=OneWay}"/>
                <controls:DropDownCheckBox Grid.Column="4" Placeholder="安排状态" DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding ArrangementOptions}"
                                           SelectedItems="{Binding SelectedArrangementStatuses,Mode=OneWay}"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding PlannedDeliveryDateFrom}"
                            controls:DatePickerAssist.PlaceholderText="计划交期起"/>
                <DatePicker Grid.Column="8" SelectedDate="{Binding PlannedDeliveryDateTo}"
                            controls:DatePickerAssist.PlaceholderText="计划交期至"/>
                <DatePicker Grid.Column="10" SelectedDate="{Binding ExpectedReadyDateFrom}"
                            controls:DatePickerAssist.PlaceholderText="预计备妥起"/>
                <DatePicker Grid.Column="12" SelectedDate="{Binding ExpectedReadyDateTo}"
                            controls:DatePickerAssist.PlaceholderText="预计备妥至"/>
            </Grid>
        </Grid>

        <!--主区域-->
        <controls:RightDrawerHost Grid.Row="1"
                                  IsOpen="{Binding IsDrawerOpen}"
                                  CloseCommand="{Binding CloseDrawerCommand}"
                                  DrawerWidth="760"
                                  MinDrawerWidth="620"
                                  MaxDrawerWidth="1050"
                                  IsResizable="True"
                                  DisplayMode="Overlay">

            <controls:RightDrawerHost.DrawerContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="关闭"
                                    Command="{Binding CloseDrawerCommand}"
                                    Padding="12,4" ToolTip="关闭快速查看"/>
                            <TextBlock Text="{Binding SelectedOrder.OrderNo}"
                                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Margin="0,4,0,10"
                                   Text="{Binding SelectedOrder.ReadOnlyReason}"
                                   Foreground="DarkOrange" />

                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <TextBlock Text="{Binding ArrangementSummary}"/>
                            <TextBlock Grid.Column="2" Text="{Binding InboundText,StringFormat=已入库：{0}}"/>
                            <TextBlock Grid.Column="4" Text="{Binding ShippedText,StringFormat=最终已发货：{0}}"/>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="取消确认原因" FontWeight="SemiBold"/>

                        <TextBox Margin="0,4,0,0" Text="{Binding CancellationReason,UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="提交取消确认"
                                Command="{Binding CancelConfirmationCommand}" Style="{StaticResource AccentButton}"/>

                        <TextBlock Margin="0,12,0,4" Text="所选采购行摘要"
                                   FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,*">
                            <TextBlock Text="行号" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LineNumber}"/>
                            <TextBlock Grid.Column="4" Text="SKU" Foreground="Gray"/>
                            <TextBlock Grid.Column="6" Text="{Binding SelectedLine.Sku}"/>
                        </Grid>

                        <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,8,Auto,8,*">
                            <TextBlock Text="数量" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedLine.Quantity,StringFormat=N4}"/>
                            <TextBlock Grid.Column="4" Text="已备好" Foreground="Gray"/>
                            <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestReadyQty,StringFormat=N4}"/>
                        </Grid>

                        <TextBlock Margin="0,8,0,2" Text="所选采购行的需求来源贡献" FontWeight="SemiBold" />

                        <DataGrid ItemsSource="{Binding SelectedLine.Contributions}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="130"/>
                                <DataGridTextColumn Header="来源行" Binding="{Binding SourceLineNumber}" Width="65"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                                <DataGridTextColumn Header="有效贡献" Binding="{Binding EffectiveQty,StringFormat=N4}" Width="90"/>
                                <DataGridTextColumn Header="原需求交期" Binding="{Binding DemandRequiredDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                                <DataGridTextColumn Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,8,0,2" Text="采购备注"/>

                        <TextBlock Text="{Binding Remark}" TextWrapping="Wrap"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="供应商进度反馈（累计口径）" FontWeight="SemiBold"/>

                        <Grid Margin="0,6" ColumnDefinitions="160,8,120,8,130,8,130">
                            <ComboBox ItemsSource="{Binding ReportArrangementOptions}" SelectedItem="{Binding ReportArrangementStatus}" />
                            <TextBox Grid.Column="2" Text="{Binding ReportReadyQty,UpdateSourceTrigger=PropertyChanged}" ToolTip="累计已备好数量"/>
                            <DatePicker Grid.Column="4" SelectedDate="{Binding ReportExpectedReadyDate}" ToolTip="预计备妥日期"/>
                            <DatePicker Grid.Column="6" SelectedDate="{Binding ReportedDate}" ToolTip="供应商反馈日期"/>
                        </Grid>

                        <TextBox Text="{Binding ReportNote}" ToolTip="反馈备注"/>

                        <TextBox Margin="0,4,0,0" Text="{Binding CorrectionReason}" ToolTip="累计数量下降时必填纠错原因"/>

                        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="登记不可覆盖反馈" Command="{Binding ReportProgressCommand}"/>

                        <DataGrid Margin="0,6,0,0" ItemsSource="{Binding SelectedLine.ProgressHistory}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="50"/>
                                <DataGridTextColumn Header="安排" Binding="{Binding ArrangementStatus}" Width="80"/>
                                <DataGridTextColumn Header="已备好" Binding="{Binding ReadyQty,StringFormat=N4}" Width="90"/>
                                <DataGridTextColumn Header="反馈日期" Binding="{Binding SupplierReportedDate,StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Operations}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=MM-dd HH:mm}" Width="95"/>
                                <DataGridTextColumn Header="操作" Binding="{Binding OperationName}" Width="150"/>
                                <DataGridTextColumn Header="操作人" Binding="{Binding UserName}" Width="90"/>
                                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </controls:RightDrawerHost.DrawerContent>

            <controls:RightDrawerHost.MainContent>
                <!--数据区域-->
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" MinHeight="200"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="6*" MinHeight="200"/>
                    </Grid.RowDefinitions>
                    <!--单明细-->
                    <Grid Grid.Row="0" RowDefinitions="*,Auto">
                        <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="{StaticResource DataGridRowHeightSmall}"
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDetailCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="订单状态" Binding="{Binding OrderStatusText}" Width="85"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="采购单号" Binding="{Binding OrderNo}" Width="145"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="诗亦霖采购单号" Binding="{Binding BoNo}" Width="140"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="来源单号" Binding="{Binding DemandSourceNo}" Width="130"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="170"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="确认" Binding="{Binding ConfirmationStatus}" Width="70"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="日期" Binding="{Binding OrderDate,StringFormat=yyyy-MM-dd}" Width="100"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="预计交期" Binding="{Binding ExpectedDate,StringFormat=yyyy-MM-dd}" Width="105"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="回复交期" Binding="{Binding ReplyDate,StringFormat=yyyy-MM-dd}" Width="105"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="行数" Binding="{Binding LineCount}" Width="60"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="数量" Binding="{Binding TotalQty,StringFormat=N1}" Width="95"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount,StringFormat=N2}" Width="110"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="未发货" Binding="{Binding UnshippedQtyText}" Width="85"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="已安排" Binding="{Binding ArrangedLineCount}" Width="70"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="已反馈" Binding="{Binding ReportedLineCount}" Width="70"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="已备好" Binding="{Binding LatestReadyQty,StringFormat=N1}" Width="95"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="预计备妥" Binding="{Binding LatestExpectedReadyDate,StringFormat=yyyy-MM-dd}" Width="105"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="只读原因" Binding="{Binding ReadOnlyReason}" Width="200"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,Auto,12,Auto">

                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>

                            <controls:PageNavigator Grid.Column="3"
                                            TotalCount="{Binding TotalCount}"
                                            PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}"
                                            PageChangeCommand="{Binding PageChangeCommand}"/>
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                    <!--行明细-->
                    <Grid Grid.Row="2" RowDefinitions="Auto,4,*">
                        <Grid ColumnDefinitions="Auto,12,Auto,8,Auto,16,Auto,8,Auto,*">
                            <TextBlock Text="采购行明细" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="采购单：" Foreground="Gray"/>
                            <TextBlock Grid.Column="4" Text="{Binding SelectedOrder.OrderNo}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="供应商：" Foreground="Gray"/>
                            <TextBlock Grid.Column="8" Text="{Binding SelectedOrder.SupplierName}"/>
                            <TextBlock Grid.Column="9" HorizontalAlignment="Right" Text="{Binding DetailStatusText}" Foreground="Gray"
                                       ToolTip="双击单头或点击“查看详情”打开完整采购详情"/>
                        </Grid>
                        <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Lines}"
                              SelectedItem="{Binding SelectedLine}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="{StaticResource DataGridRowHeightMedium}"
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              Style="{StaticResource SwiftExportDataGrid}"
                              gridCore:EnterpriseGrid.IsEnabled="True"
                              gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="42"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False" 
                                                        gridColumns:GridColumn.Key="image">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CachedImage Width="56" Height="56" Margin="2" 
                                                          Style="{StaticResource SwiftExportCachedImage}"
                                                          SourcePath="{Binding MainImage}" 
                                                          DecodePixelWidth="80" 
                                                          Stretch="Uniform" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku}" Width="105"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="物料编号" Binding="{Binding Sku}" Width="115"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="AQ/关联型号" Binding="{Binding LinkSku}" Width="115"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="供应商型号" Binding="{Binding SupplierSku}" Width="120"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="中文描述" Binding="{Binding DescriptionZh}" Width="180"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="表面处理/颜色" Binding="{Binding FinishZh}" Width="110"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="配置" Binding="{Binding FeaturesZh}" Width="130"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="物料类型" Binding="{Binding MaterialType}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="供货方式" Binding="{Binding SupplyType}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity,StringFormat=N1}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="未收货" Binding="{Binding UnreceivedQtyText}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="累计已备好"
                                                Binding="{Binding LatestReadyQty,StringFormat=N1}" Width="95"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="计划交期"
                                                Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}"
                                                Width="105"
                                                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="预计备妥"
                                                Binding="{Binding LatestExpectedReadyDate,StringFormat=yyyy-MM-dd}"
                                                Width="105"
                                                ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="未税价"
                                                Binding="{Binding UnitPrice,StringFormat=N4}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="含税价"
                                                Binding="{Binding TaxPrice,StringFormat=N4}" Width="85"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="未税金额"
                                                Binding="{Binding UnitAmount,StringFormat=N2}" Width="95"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="含税金额"
                                                Binding="{Binding TaxAmount,StringFormat=N2}" Width="95"
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="送达供应商"
                                                Binding="{Binding DeliverySupplierName}" Width="150"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="来源"
                                                Binding="{Binding SourceSummary}" Width="150"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="行备注"
                                                Binding="{Binding SubNote}" Width="180"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </controls:RightDrawerHost.MainContent>
        </controls:RightDrawerHost>
    </Grid>
</UserControl>
