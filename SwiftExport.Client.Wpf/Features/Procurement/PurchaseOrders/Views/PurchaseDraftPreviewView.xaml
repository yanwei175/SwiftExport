<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseDraftPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Models"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseDraftWorkflowViewModel}"
             d:Width="1400" d:Height="820">
    <Grid RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="采购单审核" />
                <TextBlock Text="供应商、数量、价格、交期如需修改，请返回采购准备；此处只审核后端生成的只读单据快照。"
                                   Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.WarningText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Column="1" MinWidth="150">

                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedDocument.Target.SelectedChoiceDisplayText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDocument.Target.HasMultipleChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--选择草稿目标后需重新计算单据-->
                <ComboBox ItemsSource="{Binding SelectedDocument.Target.Choices}"
                                  AutomationProperties.Name="采购草稿目标"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedDocument.Target.SelectedChoice, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditInputs}"
                                  ToolTip="选择草稿目标后需重新计算单据。">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDocument.Target.HasMultipleChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding PreviewSummaryText}" />
            <Button Grid.Column="5"
                            Content="{Binding PreviewActionText}"
                            Command="{Binding PreviewCommand}"
                            ToolTip="草稿目标变化可直接重新生成；采购输入变化请返回采购准备修改并重新校验。" />
            <ui:Button Grid.Column="7" Content="创建采购草稿"
                       Appearance="Primary"
                            Command="{Binding CreateCommand}"
                            IsEnabled="{Binding CanCreateCurrent}" />
            <Button Grid.Column="9" Content="返回采购准备修改"
                            Command="{Binding ReturnToPreparationCommand}"
                            ToolTip="返回后修改供应商、数量、价格或交期，再重新校验进入审核。" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*">
            <!--左侧列表-->
            <Border Padding="8" 
                   BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                   BorderThickness="0.5"
                   CornerRadius="8">
                <DataGrid ItemsSource="{Binding Documents}" 
                              SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                              FontSize="12" 
                              RowHeight="{StaticResource DataGridRowHeightSmall}"
                              GridLinesVisibility="Horizontal"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源单" Width="110" 
                                                Binding="{Binding SourceNo}" />
                        <DataGridTextColumn Header="供应商" Width="90" 
                                                Binding="{Binding SupplierDisplay}" />
                        <DataGridTextColumn Header="行数" Width="52" 
                                                Binding="{Binding Lines.Count}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!--右侧-->
            <Grid Grid.Column="2" RowDefinitions="5*,8,8*,8,5*">
                <!--单头区域-->
                <Border Padding="12"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Border.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">

                        <Grid DataContext="{Binding SelectedDocument}"
                              d:DataContext="{d:DesignInstance models:PurchaseDraftDocumentReviewModel}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="来源单号" />
                            <ui:TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SourceNo, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="系统单号" />
                            <ui:TextBox Grid.Row="0" Grid.Column="6" Text="{Binding Header.OrderNoDisplay, Mode=OneWay}" IsReadOnly="True" />



                            <TextBlock Grid.Row="2" Grid.Column="0" Text="客户" />
                            <ui:TextBox Grid.Row="2" Grid.Column="2"
                                            PlaceholderText="客户"
                                            Text="{Binding CustomerDisplay, Mode=OneWay}"
                                            IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="客户PO号" />
                            <ui:TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Header.CustomerPoNo, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="自定义采购单号" />
                            <ui:TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Header.BoNo, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="业务员" />
                            <ui:TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Header.SalesPerson, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="特殊要求" />
                            
                            <!--<ui:TextBlock Grid.Row="10" Grid.RowSpan="3" 
                                        Grid.Column="2" Grid.ColumnSpan="5"
                                        Text="{Binding Header.Remark, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        MinHeight="56" />-->
                            <TextBox Grid.Row="10" 
                                     Grid.RowSpan="3" 
                                     Grid.Column="2" 
                                     Grid.ColumnSpan="5"
                                     Text="{Binding Header.Remark, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="56" />



                            <TextBlock Grid.Row="2" Grid.Column="4" Text="下单日期" />
                            <ui:TextBox Grid.Row="2" Grid.Column="6" Text="{Binding Header.OrderDateDisplay, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Grid.Column="4" Text="期望交期" />
                            <ui:TextBox Grid.Row="4" Grid.Column="6" Text="{Binding Header.ExpectedDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" />
                            <TextBlock Grid.Row="8" Grid.Column="4" Text="跟单员" />
                            <ui:TextBox Grid.Row="8" Grid.Column="6" Text="{Binding Header.PurchasePerson, Mode=OneWay}" IsReadOnly="True" />

                            <TextBlock Grid.Row="2" Grid.Column="8" Text="供应商" />
                            <ui:TextBox Grid.Row="2" Grid.Column="10" Text="{Binding SupplierDisplay, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Grid.Column="8" Text="进水管" />
                            <ui:TextBox Grid.Row="4" Grid.Column="10" Text="{Binding Header.InletHoseType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="6" Grid.Column="8" Text="起泡器" />
                            <ui:TextBox Grid.Row="6" Grid.Column="10" Text="{Binding Header.AeratorType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="8" Grid.Column="8" Text="托盘" />
                            <ui:TextBox Grid.Row="8" Grid.Column="10" Text="{Binding Header.PalletType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="10" Grid.Column="8" Text="币种" />
                            <ui:TextBox Grid.Row="10" Grid.Column="10" Text="{Binding Header.Currency, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="12" Grid.Column="8" Text="价格浮动" />
                            <ui:TextBox Grid.Row="12" Grid.Column="10" Text="{Binding Header.DiscountRate, Mode=OneWay}" IsReadOnly="True" />


                            <TextBlock Grid.Row="2" Grid.Column="12" Text="内盒" />
                            <ui:TextBox Grid.Row="2" Grid.Column="14" Text="{Binding Header.BoxType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Grid.Column="12" Text="标贴" />
                            <ui:TextBox Grid.Row="4" Grid.Column="14" Text="{Binding Header.LabelType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="6" Grid.Column="12" Text="说明书" />
                            <ui:TextBox Grid.Row="6" Grid.Column="14" Text="{Binding Header.InstructionManualType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="8" Grid.Column="12" Text="外箱" />
                            <ui:TextBox Grid.Row="8" Grid.Column="14" Text="{Binding Header.CartonType, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="10" Grid.Column="12" Text="折扣备注" />
                            <ui:TextBox Grid.Row="10" Grid.Column="14" Text="{Binding Header.DiscountRemark, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="12" Grid.Column="12" Text="整单折扣" />
                            <ui:TextBox Grid.Row="12" Grid.Column="14" Text="{Binding Header.DiscountAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />

                            <TextBlock Grid.Row="2" Grid.RowSpan="6" Grid.Column="16" Text="光标" />
                            <ui:TextBox Grid.Row="2" Grid.RowSpan="5" Grid.Column="18"
                                            ClearButtonEnabled="False"
                                            FontWeight="Bold"
                                            FontSize="25"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Header.LogoType, Mode=OneWay}"
                                            IsReadOnly="True" />
                            <TextBlock Grid.Row="8" Grid.Column="16" Text="未税合计" />
                            <ui:TextBox Grid.Row="8" Grid.Column="18" Text="{Binding Header.UntaxedTotalAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />
                            <TextBlock Grid.Row="10" Grid.Column="16" Text="含税合计" />
                            <ui:TextBox Grid.Row="10" Grid.Column="18" Text="{Binding Header.TaxIncludedTotalAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />
                        </Grid>
                    </ScrollViewer>
                </Border>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                <!--单行区域-->
                <Border Grid.Row="2" 
                        Padding="8" 
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                        BorderThickness="0.5"
                        CornerRadius="8">
                    <DataGrid Grid.Row="2" FontSize="12"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  ItemsSource="{Binding SelectedDocument.Lines}" 
                                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SKU" Width="160" 
                                                    Binding="{Binding Sku}" />

                            <DataGridTextColumn Header="产品型号" Width="160" 
                                                    Binding="{Binding LinkSku}" />

                            <DataGridTextColumn Header="描述" Width="*" 
                                                    Binding="{Binding Description}" />

                            <DataGridTextColumn Header="供应商型号" Width="120" 
                                                    Binding="{Binding SupplierSku}" />

                            <DataGridTextColumn Header="数量" Width="82" 
                                                    Binding="{Binding PurchaseQty, StringFormat=N1}" />

                            <DataGridTextColumn Header="未税价" Width="82" 
                                                    Binding="{Binding UnitPrice, StringFormat=N2}" />

                            <DataGridTextColumn Header="含税价" Width="82" 
                                                    Binding="{Binding TaxPrice, StringFormat=N2}" />

                            <DataGridTextColumn Header="交期" Width="96"
                                                    Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                
                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent"/>
                
                <!--单行来源-->
                <Border Grid.Row="4" 
                        Padding="8" 
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                        BorderThickness="0.5"
                        CornerRadius="8">
                    <Grid RowDefinitions="Auto,4,*">
                        <TextBlock FontWeight="SemiBold" Text="当前采购行的来源贡献" />
                        <DataGrid Grid.Row="2" FontSize="12"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                                          ItemsSource="{Binding SelectedLine.Contributions}" 
                                          AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="来源单" Width="110" Binding="{Binding SourceNo}" />
                                <DataGridTextColumn Header="行" 
                                                            Visibility="Collapsed"
                                                            Width="52" Binding="{Binding SourceLineNumber}" />
                                <DataGridTextColumn Header="SKU" Width="160" Binding="{Binding Sku}" />
                                <DataGridTextColumn Header="产品型号" Width="160" Binding="{Binding LinkSku}" />
                                <DataGridTextColumn Header="待采数量" Width="90" 
                                                            Binding="{Binding ExpectedRemainingQty, StringFormat=N1}" />
                                <DataGridTextColumn Header="采购数量" Width="90" 
                                                            Binding="{Binding PurchaseQty, StringFormat=N1}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
