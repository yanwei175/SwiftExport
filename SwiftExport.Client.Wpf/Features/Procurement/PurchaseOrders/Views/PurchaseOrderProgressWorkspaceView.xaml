<UserControl
    x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderProgressWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="12,8" RowDefinitions="Auto,8,Auto,8,*">
        <DockPanel LastChildFill="True">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="供应商反馈录入" />
                <TextBlock Foreground="Gray" Text="独立登记累计已备好数量、预计交期和反馈备注" />
                <TextBlock Text="{Binding SelectionBlockReason}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">

                <Button Command="{Binding OpenDrawerCommand}" Content="登记/查看反馈" />

                <Button
                    Margin="4,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="刷新" />
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding RetryReportCommand}"
                    Content="重试原反馈" />

            </WrapPanel>
        </DockPanel>

        <Grid
            x:Name="FeedbackFilters"
            Grid.Row="2"
            IsEnabled="{Binding CanChangeSelection}"
            RowDefinitions="Auto,4,Auto">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOrderDocument}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid ColumnDefinitions="160,8,180,8,160,8,145,8,145,8,Auto,4,Auto">

                <ui:TextBox PlaceholderText="采购单号" Text="{Binding OrderNo}" />

                <ui:TextBox
                    Grid.Column="2"
                    PlaceholderText="供应商"
                    Text="{Binding SupplierKeyword}" />

                <ui:TextBox
                    Grid.Column="4"
                    PlaceholderText="SKU"
                    Text="{Binding Sku}" />

                <controls:DropDownCheckBox
                    Grid.Column="6"
                    DisplayMemberPath="DisplayText"
                    ItemsSource="{Binding ConfirmationOptions}"
                    Placeholder="是否确认"
                    SelectedItems="{Binding SelectedConfirmationStatuses, Mode=OneWay}" />

                <controls:DropDownCheckBox
                    Grid.Column="8"
                    DisplayMemberPath="DisplayText"
                    ItemsSource="{Binding LifecycleOptions}"
                    Placeholder="订单状态"
                    SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" />



                <Button
                    Grid.Column="10"
                    Command="{Binding SearchCommand}"
                    Content="查询" />

                <Button
                    Grid.Column="12"
                    Command="{Binding ResetFiltersCommand}"
                    Content="重置筛选" />

            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="125,8,125,16,125,8,125,*">

                <DatePicker
                    SelectedDate="{Binding PlannedDeliveryDateFrom}"
                    SelectedDateFormat="Short"
                    ToolTip="计划交期起" />

                <DatePicker
                    Grid.Column="2"
                    SelectedDate="{Binding PlannedDeliveryDateTo}"
                    ToolTip="计划交期至" />

                <TextBlock
                    Grid.Column="7"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="默认仅显示活动且已确认采购单；清除状态选择可查看只读历史。" />
            </Grid>
        </Grid>

        <controls:RightDrawerHost
            Grid.Row="4"
            CloseCommand="{Binding CloseDrawerCommand}"
            DisplayMode="Overlay"
            DrawerWidth="700"
            IsOpen="{Binding IsDrawerOpen}"
            IsResizable="True"
            MaxDrawerWidth="980"
            MinDrawerWidth="620">
            <controls:RightDrawerHost.DrawerContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <DockPanel LastChildFill="True">
                            <Button
                                Padding="12,4"
                                Command="{Binding CloseDrawerCommand}"
                                Content="关闭"
                                DockPanel.Dock="Right" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentOrder.OrderNo}" />
                                <TextBlock Foreground="Gray" Text="{Binding CurrentOrder.SupplierName}" />
                            </StackPanel>
                        </DockPanel>

                        <Border
                            Margin="0,12,0,0"
                            Padding="12"
                            BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="所选采购行" />
                                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Foreground="Gray" Text="行号" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LineNumber}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Foreground="Gray"
                                        Text="SKU" />
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.Sku}" />
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Foreground="Gray" Text="采购数量" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.Quantity, StringFormat={}{0:0.####}}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Foreground="Gray"
                                        Text="累计已备好" />
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestReadyQtyText}" />
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Foreground="Gray" Text="最近反馈" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LatestFollowUpDateText}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Foreground="Gray"
                                        Text="跟单员" />
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestFollowUpUserText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Foreground="DarkOrange"
                            Text="{Binding FollowUpPermissionText}"
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="0,8,0,0"
                            AutomationProperties.AutomationId="FeedbackInputPanel"
                            IsEnabled="{Binding CanEditReport}">
                            <TextBlock FontWeight="SemiBold" Text="登记供应商反馈（可只填一项）" />
                            <Grid Margin="0,6,0,0" ColumnDefinitions="*,8,*">


                                <ui:TextBox
                                    AutomationProperties.AutomationId="ReadyQtyInput"
                                    AutomationProperties.Name="累计已备好数量"
                                    PlaceholderText="累计已备好数量（可留空）"
                                    Text="{Binding ReportReadyQtyInput, UpdateSourceTrigger=PropertyChanged}" />
                                <DatePicker
                                    Grid.Column="2"
                                    AutomationProperties.Name="预计交期"
                                    SelectedDate="{Binding ReportExpectedReadyDate}"
                                    SelectedDateFormat="Short"
                                    ToolTip="预计交期日期" />
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,0"
                                Foreground="Gray"
                                Text="数量和日期留空表示本次不更新；反馈时间和跟单员由服务器记录" />
                            <ui:TextBox
                                Margin="0,6,0,0"
                                AutomationProperties.AutomationId="ReportNoteInput"
                                AutomationProperties.Name="反馈备注"
                                PlaceholderText="反馈备注"
                                Text="{Binding ReportNote, UpdateSourceTrigger=PropertyChanged}" />
                            <Border
                                Margin="0,6,0,0"
                                Padding="8"
                                Background="#FFFFF4CE"
                                BorderBrush="#FFE5A000"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProgressCorrection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#FF8A4B00"
                                    Text="{Binding ProgressCorrectionWarning}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <ui:TextBox
                                Margin="0,6,0,0"
                                AutomationProperties.Name="累计数量纠错原因"
                                PlaceholderText="累计数量下降时必填纠错原因"
                                Text="{Binding CorrectionReason, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ReportProgressCommand}"
                                Content="登记供应商反馈" />
                        </StackPanel>

                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Text="完整反馈历史（每次反馈后的累计快照）" />
                        <DataGrid
                            MaxHeight="300"
                            Margin="0,6,0,0"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding SelectedLine.ProgressHistory}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Sequence}"
                                    Header="序号" />
                                <DataGridTextColumn
                                    Width="105"
                                    Binding="{Binding ReadyQty, TargetNullValue=尚未反馈, StringFormat={}{0:0.####}}"
                                    Header="累计已备好" />
                                <DataGridTextColumn
                                    Width="105"
                                    Binding="{Binding ExpectedReadyDate, StringFormat=yyyy-MM-dd}"
                                    Header="预计交期" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding SupplierReportedDate, StringFormat=yyyy-MM-dd HH:mm}"
                                    Header="反馈时间" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding CreatedBy}"
                                    Header="跟单员" />
                                <DataGridTemplateColumn
                                    Width="55"
                                    ClipboardContentBinding="{Binding IsCorrection, Mode=OneWay}"
                                    Header="纠错">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Focusable="False"
                                                IsChecked="{Binding IsCorrection, Mode=OneWay}"
                                                IsHitTestVisible="False" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="160"
                                    Binding="{Binding Note}"
                                    Header="备注" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding CorrectionReason}"
                                    Header="纠错原因" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </controls:RightDrawerHost.DrawerContent>

            <controls:RightDrawerHost.MainContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="4*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrderDocument}" Value="True">
                                            <Setter Property="Height" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrderDocument}" Value="True">
                                            <Setter Property="Height" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>
                    <Grid AutomationProperties.AutomationId="OrdersSection" RowDefinitions="*,Auto">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrderDocument}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <DataGrid
                            gridCore:GridRowHeader.ShowRowNumber="True"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="OrdersGrid"
                            FontSize="{StaticResource SwiftExportDefaltFontSize}"
                            IsEnabled="{Binding CanChangeSelection}"
                            IsReadOnly="True"
                            ItemsSource="{Binding Orders}"
                            RowHeight="{StaticResource DataGridRowHeightSmall}"
                            SelectedItem="{Binding SelectedOrder}"
                            SelectionChanged="OrdersGrid_OnSelectionChanged"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            Style="{StaticResource SwiftExportDataGrid}">
                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding ConfirmationStatus}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="确认状态" />

                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="订单状态" />

                                <DataGridTextColumn
                                    Width="145"
                                    Binding="{Binding OrderNo}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="采购单号" />

                                <DataGridTextColumn
                                    Width="145"
                                    Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Header="订单日期" />

                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding BoNo}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="诗亦霖采购单号" />

                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding SupplierName}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="供应商" />

                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding LineCount}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Header="订单条目" />

                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding DemandSourceNo}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="来源单号" />

                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            ColumnDefinitions="*,Auto,12,Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlock}"
                                Text="{Binding ResultSummary}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlock}"
                                Text="{Binding PageStatus}" />
                            <controls:PageNavigator
                                Grid.Column="3"
                                IsEnabled="{Binding CanChangeSelection}"
                                PageChangeCommand="{Binding PageChangeCommand}"
                                PageSize="{Binding PageSize}"
                                TotalCount="{Binding TotalCount}"
                                PageIndex="{Binding PageIndex}" />
                        </Grid>
                    </Grid>

                    <GridSplitter
                        Grid.Row="1"
                        Height="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrderDocument}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>

                    <Grid Grid.Row="2" RowDefinitions="Auto,4,*">
                        <DockPanel LastChildFill="True">
                            <Button
                                Command="{Binding OpenDrawerCommand}"
                                Content="登记/查看反馈"
                                DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="采购行反馈" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    AutomationProperties.AutomationId="CurrentOrderNoText"
                                    Text="{Binding CurrentOrder.OrderNo}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    Foreground="Gray"
                                    Text="{Binding DetailStatusText}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid
                            Grid.Row="2"
                            gridCore:GridRowHeader.ShowRowNumber="True"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="LinesGrid"
                            FontSize="{StaticResource SwiftExportDefaltFontSize}"
                            IsEnabled="{Binding CanChangeSelection}"
                            IsReadOnly="True"
                            ItemsSource="{Binding Lines}"
                            MouseDoubleClick="LinesGrid_OnMouseDoubleClick"
                            RowHeight="{StaticResource DataGridRowHeightMedium}"
                            SelectedItem="{Binding SelectedLine}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            Style="{StaticResource SwiftExportDataGrid}">
                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Width="45"
                                    Binding="{Binding LineNumber}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="行号"
                                    Visibility="Collapsed" />

                                <DataGridTemplateColumn
                                    Width="64"
                                    CanUserSort="False"
                                    Header="图片">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CachedImage
                                                Width="56"
                                                Height="56"
                                                Margin="2"
                                                DecodePixelWidth="80"
                                                SourcePath="{Binding MainImage}"
                                                Stretch="Uniform"
                                                Style="{StaticResource SwiftExportCachedImage}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="125"
                                    Binding="{Binding Sku}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="SKU" />

                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding SupplierSku}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="供应商型号" />

                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding DescriptionZh}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="描述" />

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Quantity, StringFormat={}{0:0.####}}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Header="采购数量" />



                                <DataGridTextColumn
                                    Width="105"
                                    Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}"
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Header="计划交期" />



                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding LatestReadyQtyText}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Header="货好数量" />

                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding LatestExpectedReadyDateText}"
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Header="预期货好时间" />

                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding LatestFollowUpDateText}"
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Header="最近反馈" />

                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding LatestFollowUpUserText}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="反馈人" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </controls:RightDrawerHost.MainContent>
        </controls:RightDrawerHost>
    </Grid>
</UserControl>
