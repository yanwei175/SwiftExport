<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderProgressWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid">
    
    <Grid Margin="12,8" RowDefinitions="Auto,8,Auto,8,*">
        <DockPanel LastChildFill="True">
            <StackPanel>
                <TextBlock Text="采购订单跟进" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="聚焦采购数量、供应商安排、累计已备好和预计备妥信息" Foreground="Gray"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                
                <Button Content="登记/查看跟进" Command="{Binding OpenDrawerCommand}" 
                        />
                
                <Button Margin="4,0,0,0" Content="刷新" 
                        Command="{Binding RefreshCommand}"/>
                
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,4,Auto">
            <Grid ColumnDefinitions="160,8,180,8,160,8,145,8,145,8,145,8,Auto,4,Auto">
                
                <ui:TextBox Text="{Binding OrderNo}" 
                            PlaceholderText="采购单号"/>
                
                <ui:TextBox Grid.Column="2" 
                            Text="{Binding SupplierKeyword}" 
                            PlaceholderText="供应商"/>
                
                <ui:TextBox Grid.Column="4" 
                            Text="{Binding Sku}" 
                            PlaceholderText="SKU"/>
                
                <controls:DropDownCheckBox Grid.Column="6" Placeholder="是否确认" 
                                           DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding ConfirmationOptions}"
                                           SelectedItems="{Binding SelectedConfirmationStatuses,Mode=OneWay}"/>
                
                <controls:DropDownCheckBox Grid.Column="8" Placeholder="订单状态" DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding LifecycleOptions}"
                                           SelectedItems="{Binding SelectedLifecycleStatuses,Mode=OneWay}"/>
                
                <controls:DropDownCheckBox Grid.Column="10" Placeholder="供应商安排状态" 
                                           DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding ArrangementOptions}"
                                           SelectedItems="{Binding SelectedArrangementStatuses,Mode=OneWay}"/>
                
                <Button Grid.Column="12" Content="查询" Command="{Binding SearchCommand}" />
                
                <Button Grid.Column="14" Content="重置筛选" Command="{Binding ResetFiltersCommand}"/>
                
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="125,8,125,16,125,8,125,*">
                
                <DatePicker Style="{StaticResource SwiftExportDatePicker}" SelectedDate="{Binding PlannedDeliveryDateFrom}"
                            controls:DatePickerAssist.PlaceholderText="计划交期起"/>
                
                <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="2" SelectedDate="{Binding PlannedDeliveryDateTo}"
                            controls:DatePickerAssist.PlaceholderText="计划交期至"/>
                
                <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="4" SelectedDate="{Binding ExpectedReadyDateFrom}"
                            controls:DatePickerAssist.PlaceholderText="预计备妥起"/>
                
                <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="6" SelectedDate="{Binding ExpectedReadyDateTo}"
                            controls:DatePickerAssist.PlaceholderText="预计备妥至"/>
                
                <TextBlock Grid.Column="7" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                           Text="默认仅显示活动且已确认采购单；清除状态选择可查看只读历史。"/>
            </Grid>
        </Grid>

        <controls:RightDrawerHost Grid.Row="4"
                                  IsOpen="{Binding IsDrawerOpen}"
                                  CloseCommand="{Binding CloseDrawerCommand}"
                                  DrawerWidth="700"
                                  MinDrawerWidth="620"
                                  MaxDrawerWidth="980"
                                  IsResizable="True"
                                  DisplayMode="Overlay">
            <controls:RightDrawerHost.DrawerContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseDrawerCommand}" Padding="12,4"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOrder.OrderNo}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedOrder.SupplierName}" Foreground="Gray"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,12,0,0" Padding="12" BorderBrush="{DynamicResource SwiftExportBrush.Border}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="所选采购行" FontWeight="SemiBold"/>
                                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Text="行号" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LineNumber}"/>
                                    <TextBlock Grid.Column="4" Text="SKU" Foreground="Gray"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.Sku}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Text="采购数量" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.Quantity,StringFormat={}{0:0.####}}"/>
                                    <TextBlock Grid.Column="4" Text="累计已备好" Foreground="Gray"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestReadyQtyText}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Text="供应商安排" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LatestArrangementText}"/>
                                    <TextBlock Grid.Column="4" Text="预计备妥" Foreground="Gray"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestExpectedReadyDateText}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,8,*,16,Auto,8,*">
                                    <TextBlock Text="最近跟进" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedLine.LatestFollowUpDateText}"/>
                                    <TextBlock Grid.Column="4" Text="跟单员" Foreground="Gray"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SelectedLine.LatestFollowUpUserText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,12,0,0" Text="{Binding FollowUpPermissionText}" Foreground="DarkOrange" TextWrapping="Wrap"/>

                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding CanReportSelectedOrder}">
                            <TextBlock Text="登记供应商反馈（累计口径）" FontWeight="SemiBold"/>
                            <Grid Margin="0,6,0,0" ColumnDefinitions="160,8,130,8,135,*">
                                <ComboBox ItemsSource="{Binding ReportArrangementOptions}" 
                                          SelectedIndex="2"
                                          SelectedItem="{Binding ReportArrangementStatus}" 
                                          ToolTip="供应商安排状态">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <TextBox Grid.Column="2" Text="{Binding ReportReadyQty,UpdateSourceTrigger=PropertyChanged}" ToolTip="累计已备好数量"/>
                                <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="4" SelectedDate="{Binding ReportExpectedReadyDate}" ToolTip="预计备妥日期"/>
                            </Grid>
                            
                            <TextBlock Margin="0,6,0,0" Text="跟进时间和跟单员由服务器自动记录" Foreground="Gray"/>
                            <TextBox Margin="0,6,0,0" Text="{Binding ReportNote}" ToolTip="跟进备注"/>
                            <Border Margin="0,6,0,0" Padding="8" 
                                    Background="#FFFFF4CE" 
                                    BorderBrush="#FFE5A000" 
                                    BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProgressCorrection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ProgressCorrectionWarning}" 
                                           TextWrapping="Wrap" 
                                           Foreground="#FF8A4B00" 
                                           FontWeight="SemiBold"/>
                            </Border>
                            
                            <TextBox Margin="0,6,0,0" Text="{Binding CorrectionReason}" ToolTip="累计数量下降时必填纠错原因"/>
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="登记不可覆盖反馈"
                                    Command="{Binding ReportProgressCommand}" />
                        </StackPanel>

                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="完整反馈历史" FontWeight="SemiBold"/>
                        <DataGrid Margin="0,6,0,0" ItemsSource="{Binding SelectedLine.ProgressHistory}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="50"/>
                                <DataGridTextColumn Header="供应商安排" Binding="{Binding ArrangementStatus,Converter={StaticResource EnumDescriptionConverter}}" Width="95"/>
                                <DataGridTextColumn Header="累计已备好" Binding="{Binding ReadyQty,StringFormat={}{0:0.####}}" Width="105"/>
                                <DataGridTextColumn Header="预计备妥" Binding="{Binding ExpectedReadyDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                                <DataGridTextColumn Header="跟进时间" Binding="{Binding SupplierReportedDate,StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                                <DataGridTextColumn Header="跟单员" Binding="{Binding CreatedBy}" Width="90"/>
                                <DataGridCheckBoxColumn Header="纠错" Binding="{Binding IsCorrection}" Width="55"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="160"/>
                                <DataGridTextColumn Header="纠错原因" Binding="{Binding CorrectionReason}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </controls:RightDrawerHost.DrawerContent>

            <controls:RightDrawerHost.MainContent>
                <Grid RowDefinitions="4*,8,6*">
                    <Grid RowDefinitions="*,Auto">
                        <DataGrid ItemsSource="{Binding Orders}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  SelectionChanged="OrdersGrid_OnSelectionChanged"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="{StaticResource DataGridRowHeightSmall}"
                                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                                  Style="{StaticResource SwiftExportDataGrid}"
                                  gridCore:EnterpriseGrid.IsEnabled="True"
                                  gridCore:GridVirtualization.IsEnabled="True"
                                  gridCore:GridRowHeader.ShowRowNumber="True">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="确认状态" Binding="{Binding ConfirmationStatus}" Width="70"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="订单状态" Binding="{Binding LifecycleStatus,Converter={StaticResource EnumDescriptionConverter}}" Width="85"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                
                                <DataGridTextColumn Header="采购单号" Binding="{Binding OrderNo}" Width="145"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="订单日期" Binding="{Binding OrderDate,StringFormat=yyyy-MM-dd}" Width="145"
                                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>
                                
                                <DataGridTextColumn Header="诗亦霖采购单号" Binding="{Binding BoNo}" Width="140"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="180"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                
                                <DataGridTextColumn Header="订单条目" Binding="{Binding LineCount}" Width="70"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
                                
                                <DataGridTextColumn Header="已跟进条目" Binding="{Binding ReportedLineCount}" Width="80"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>                                
                                
                                <DataGridTextColumn Header="采购总数量" Binding="{Binding TotalQty,StringFormat={}{0:0.####}}" Width="105"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
                                
                                <DataGridTemplateColumn Header="最新累计已备好合计" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
                                                        <Setter Property="Text" Value="{Binding LatestReadyQty,StringFormat={}{0:0.####}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReportedLineCount}" Value="0">
                                                                <Setter Property="Text" Value="尚未跟进"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="最新预计备妥" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridDateTextBlock}">
                                                        <Setter Property="Text" Value="{Binding LatestExpectedReadyDate,StringFormat=yyyy-MM-dd}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReportedLineCount}" Value="0">
                                                                <Setter Property="Text" Value="尚未跟进"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="来源单号" Binding="{Binding DemandSourceNo}" Width="130"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,Auto,12,Auto">
                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                            <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}"
                                                    PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}"/>
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Row="2" RowDefinitions="Auto,4,*">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="登记/查看跟进" Command="{Binding OpenDrawerCommand}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="采购行跟进" FontWeight="SemiBold"/>
                                <TextBlock Margin="12,0,0,0" Text="{Binding SelectedOrder.OrderNo}"/>
                                <TextBlock Margin="12,0,0,0" Text="{Binding DetailStatusText}" Foreground="Gray"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Lines}"
                                  SelectedItem="{Binding SelectedLine}"
                                  MouseDoubleClick="LinesGrid_OnMouseDoubleClick"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                                  Style="{StaticResource SwiftExportDataGrid}"
                                  gridCore:EnterpriseGrid.IsEnabled="True"
                                  gridCore:GridVirtualization.IsEnabled="True"
                                  gridCore:GridRowHeader.ShowRowNumber="True">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="45"
                                                    Visibility="Collapsed"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                
                                <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CachedImage Width="56" Height="56" Margin="2" 
                                                          Style="{StaticResource SwiftExportCachedImage}"
                                                          SourcePath="{Binding MainImage}" 
                                                          DecodePixelWidth="80" 
                                                          Stretch="Uniform" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="125"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="供应商型号" Binding="{Binding SupplierSku}" Width="130"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="描述" Binding="{Binding DescriptionZh}" Width="180"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="采购数量" Binding="{Binding Quantity,StringFormat={}{0:0.####}}" Width="100"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="未收货数量" Binding="{Binding UnreceivedQtyText}" Width="90"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="105"
                                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="供应商安排" Binding="{Binding LatestArrangementText}" Width="95"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

                                <DataGridTextColumn Header="货好数量" Binding="{Binding LatestReadyQtyText}" Width="110"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>

                                <DataGridTextColumn Header="预期货好时间" Binding="{Binding LatestExpectedReadyDateText}" Width="110"
                                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="最近跟进" Binding="{Binding LatestFollowUpDateText}" Width="130"
                                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>

                                <DataGridTextColumn Header="跟进人" Binding="{Binding LatestFollowUpUserText}" Width="95"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </controls:RightDrawerHost.MainContent>
        </controls:RightDrawerHost>
    </Grid>
</UserControl>
