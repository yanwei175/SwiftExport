<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.NetDemandPurchasePickerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Width="900" Height="560" Margin="8" RowDefinitions="Auto,8,*,8,Auto">
  <Grid ColumnDefinitions="220,8,180,8,Auto">
   <TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU、描述或供应商" />
   <TextBox Grid.Column="2" Text="{Binding SourceNo,UpdateSourceTrigger=PropertyChanged}" ToolTip="来源单号" />
   <Button Grid.Column="4" Content="查询" Command="{Binding SearchCommand}" />
  </Grid>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended">
   <DataGrid.Columns>
    <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsChecked,Mode=TwoWay}" Width="52" />
    <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="130" IsReadOnly="True" />
    <DataGridTextColumn Header="行" Binding="{Binding SourceLineNumber}" Width="45" IsReadOnly="True" />
    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True" />
    <DataGridTextColumn Header="供应商" Binding="{Binding PurchaseSupplierName}" Width="180" IsReadOnly="True" />
    <DataGridTextColumn Header="剩余数量" Binding="{Binding RemainingQty,StringFormat=N4}" Width="100" IsReadOnly="True" />
    <DataGridTextColumn Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="105" IsReadOnly="True" />
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="{Binding StatusText}" />
 </Grid>
</UserControl>
