<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderFromMaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             xmlns:models="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseOrderFromMaterialViewModel}"
             d:Width="1400" d:Height="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="4" RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="从物料需求建立采购草稿" />
                <TextBlock Text="先完成采购输入与验证，再审核待建采购单。" Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>
            
            <ui:Button Grid.Column="1" Content="返回采购准备" 
                    Appearance="Primary"
                    Command="{Binding BackToSelectionCommand}"
                    Visibility="{Binding IsPreviewStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            
            <ui:Button Grid.Column="3" Content="验证并进入单据审核" 
                       Appearance="Primary"
                    Command="{Binding ContinueToPreviewCommand}"
                    Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,Auto,8,*">
                <Border Padding="8" Background="{DynamicResource SwiftExportBrush.WarningSoft}"
                        Visibility="{Binding Picker.IsSourceSwitchPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnDefinitions="*,Auto,8,Auto">                        
                        <TextBlock Text="{Binding Picker.SourceSwitchPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        
                        <Button Grid.Column="1" Content="继续切换" Command="{Binding Picker.ConfirmSourceSwitchCommand}" />
                        
                        <Button Grid.Column="3" Content="保留当前选择" Command="{Binding Picker.CancelSourceSwitchCommand}" />
                        
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SelectionValidationText}" 
                                   Foreground="{DynamicResource SwiftExportBrush.Error}" 
                                   TextWrapping="Wrap" />
                        <TextBlock Text="验证覆盖全部已选行，包括筛选隐藏的行；修改任一输入会撤销旧验证。"
                                   Style="{StaticResource CaptionTextBlock}" 
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="采购行生成方式" Style="{StaticResource CaptionTextBlock}" />
                        
                        <ComboBox ItemsSource="{Binding Preview.LineModeOptions}" 
                                  DisplayMemberPath="DisplayText" 
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Preview.LineMode, Mode=TwoWay}" />
                        
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="4" RowDefinitions="*,8,Auto">
                    
                    <views:PurchaseCandidateSelectionView DataContext="{Binding Picker}" />
                    
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Preview.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8" 
                                        BorderThickness="1" 
                                        BorderBrush="{DynamicResource SwiftExportBrush.Border}">
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}" 
                                                  IsEnabled="{Binding RequiresConfirmation}"
                                                  Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlock}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <Grid DataContext="{Binding Preview}"
                  d:DataContext="{d:DesignInstance viewModels:PurchaseDraftWorkflowViewModel}"
                  Visibility="{Binding DataContext.IsPreviewStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,*">
                <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="采购单审核" />
                        <TextBlock Text="供应商、数量、价格、交期如需修改，请返回采购准备；此处只审核单据和编辑新单单头。"
                                   Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PreviewSummaryText}" />
                    <Button Grid.Column="3" Content="重新计算单据" Command="{Binding PreviewCommand}" />
                    <Button Grid.Column="5" Content="创建采购草稿"
                            Command="{Binding DataContext.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding CanCreateCurrent}" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*">
                    <Border 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                        <DataGrid ItemsSource="{Binding Documents}" 
                              SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                              FontSize="12" 
                              RowHeight="{StaticResource DataGridRowHeightSmall}"
                              GridLinesVisibility="Horizontal"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源单" Width="110" 
                                                Binding="{Binding SourceNo}" />
                                <DataGridTextColumn Header="供应商" Width="90" 
                                                Binding="{Binding SupplierDisplay}" />
                                <DataGridTextColumn Header="行数" Width="52" 
                                                Binding="{Binding Lines.Count}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="Auto,8,5*,8,5*">
                        <!--准备修改的单头-->
                        <Border Padding="12"
                                HorizontalAlignment="Stretch"
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Border.Resources>
                            <Grid DataContext="{Binding SelectedDocument}"
                                  d:DataContext="{d:DesignInstance models:PurchaseDraftDocumentReviewModel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="客户" />
                                <ui:TextBox Grid.Row="0" Grid.Column="2"
                                            PlaceholderText="客户"
                                            Text="{Binding CustomerDisplay, Mode=OneWay}"
                                            IsReadOnly="True" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="草稿目标" />
                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          ItemsSource="{Binding Target.Choices}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding Target.SelectedChoice, Mode=TwoWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="业务员" />
                                <ui:TextBox Grid.Row="4" Grid.Column="2"
                                            PlaceholderText="业务员"
                                            Text="{Binding Header.SalesPerson, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="采购员" />
                                <ui:TextBox Grid.Row="6" Grid.Column="2"
                                            PlaceholderText="采购员"
                                            Text="{Binding Header.PurchasePerson, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="进水管" />
                                <ui:TextBox Grid.Row="0" Grid.Column="6"
                                            PlaceholderText="进水管"
                                            Text="{Binding Header.InletHoseType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="起泡器" />
                                <ui:TextBox Grid.Row="2" Grid.Column="6"
                                            PlaceholderText="起泡器"
                                            Text="{Binding Header.AeratorType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="4" Text="托盘" />
                                <ui:TextBox Grid.Row="4" Grid.Column="6"
                                            PlaceholderText="托盘"
                                            Text="{Binding Header.PalletType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="8" Text="内盒" />
                                <ui:TextBox Grid.Row="0" Grid.Column="10"
                                            PlaceholderText="内盒"
                                            Text="{Binding Header.BoxType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="8" Text="标贴" />
                                <ui:TextBox Grid.Row="2" Grid.Column="10"
                                            PlaceholderText="标贴"
                                            Text="{Binding Header.LabelType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="8" Text="说明书" />
                                <ui:TextBox Grid.Row="4" Grid.Column="10"
                                            PlaceholderText="说明书"
                                            Text="{Binding Header.InstructionManualType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="12" Text="外箱" />
                                <ui:TextBox Grid.Row="0" Grid.Column="14"
                                            PlaceholderText="外箱"
                                            Text="{Binding Header.CartonType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="16" Text="Logo" />
                                <ui:TextBox Grid.Row="0" Grid.RowSpan="7" Grid.Column="18"
                                            ClearButtonEnabled="False"
                                            FontWeight="Bold"
                                            FontSize="25"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Header.LogoType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="备注" />
                                <ui:TextBox Grid.Row="8" Grid.RowSpan="3" Grid.Column="2" Grid.ColumnSpan="17"
                                            PlaceholderText="特殊要求或备注"
                                            Text="{Binding Header.Remark, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="56" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                            <DataGrid Grid.Row="2" FontSize="12"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  ItemsSource="{Binding SelectedDocument.Lines}" 
                                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="SKU" Width="160" 
                                                    Binding="{Binding Sku}" />

                                    <DataGridTextColumn Header="产品型号" Width="160" 
                                                    Binding="{Binding LinkSku}" />

                                    <DataGridTextColumn Header="描述" Width="*" 
                                                    Binding="{Binding Description}" />

                                    <DataGridTextColumn Header="供应商型号" Width="120" 
                                                    Binding="{Binding SupplierSku}" />

                                    <DataGridTextColumn Header="数量" Width="82" 
                                                    Binding="{Binding PurchaseQty, StringFormat=N1}" />

                                    <DataGridTextColumn Header="未税价" Width="82" 
                                                    Binding="{Binding UnitPrice, StringFormat=N2}" />

                                    <DataGridTextColumn Header="含税价" Width="82" 
                                                    Binding="{Binding TaxPrice, StringFormat=N2}" />

                                    <DataGridTextColumn Header="交期" Width="96"
                                                    Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}" />

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="4" 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                            <Grid RowDefinitions="Auto,4,*">
                                <TextBlock FontWeight="SemiBold" Text="当前采购行的来源贡献" />
                                <DataGrid Grid.Row="2" FontSize="12"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                                          ItemsSource="{Binding SelectedLine.Contributions}" 
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="来源单" Width="110" Binding="{Binding SourceNo}" />
                                        <DataGridTextColumn Header="行" 
                                                            Visibility="Collapsed"
                                                            Width="52" Binding="{Binding SourceLineNumber}" />
                                        <DataGridTextColumn Header="SKU" Width="160" Binding="{Binding Sku}" />
                                        <DataGridTextColumn Header="产品型号" Width="160" Binding="{Binding LinkSku}" />
                                        <DataGridTextColumn Header="待采数量" Width="90" 
                                                            Binding="{Binding ExpectedRemainingQty, StringFormat=N1}" />
                                        <DataGridTextColumn Header="采购数量" Width="90" 
                                                            Binding="{Binding PurchaseQty, StringFormat=N1}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Visibility="{Binding IsResultStage, Converter={StaticResource BooleanToVisibilityConverter}}" 
                  RowDefinitions="Auto,8,*">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="创建结果" />
                        <TextBlock Text="{Binding Preview.ResultSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="返回未完成项" Command="{Binding ReturnToPreviewCommand}" />
                </Grid>
                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding Preview.Results}" 
                          Style="{StaticResource SwiftExportDataGrid}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源" Width="180" Binding="{Binding SourceDisplay}" />
                        <DataGridTextColumn Header="结果" Width="110" Binding="{Binding OutcomeText}" />
                        <DataGridTextColumn Header="采购单号" Width="180" Binding="{Binding PurchaseOrderNos}" />
                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
