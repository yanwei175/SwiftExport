<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderFromMaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             xmlns:models="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseOrderFromMaterialViewModel}"
             d:Width="1400" d:Height="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="4" RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="从物料需求建立采购草稿" />
                <TextBlock Text="先完成采购输入与验证，再审核待建采购单。" Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>
            
            <ui:Button Grid.Column="1" Content="返回采购准备修改"
                    Appearance="Primary"
                    Command="{Binding BackToSelectionCommand}"
                    ToolTip="返回后修改供应商、数量、价格或交期，再重新校验进入审核。"
                    Visibility="{Binding IsPreviewStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            
            <ui:Button Grid.Column="3" Content="{Binding PreparationActionText}"
                       Appearance="Primary"
                    Command="{Binding ContinueToPreviewCommand}"
                    AutomationProperties.Name="校验所选物料并进入单据审核"
                    Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,Auto,8,*">
                <Border Padding="8" Background="{DynamicResource SwiftExportBrush.WarningSoft}"
                        Visibility="{Binding Picker.IsSourceSwitchPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnDefinitions="*,Auto,8,Auto">                        
                        <TextBlock Text="{Binding Picker.SourceSwitchPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        
                        <Button Grid.Column="1" Content="继续切换" Command="{Binding Picker.ConfirmSourceSwitchCommand}" />
                        
                        <Button Grid.Column="3" Content="保留当前选择" Command="{Binding Picker.CancelSourceSwitchCommand}" />
                        
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SelectionValidationText}" 
                                   Foreground="{DynamicResource SwiftExportBrush.Error}" 
                                   TextWrapping="Wrap" />
                        <TextBlock Text="验证覆盖全部已选行，包括筛选隐藏的行；修改任一输入会撤销旧验证。"
                                   Style="{StaticResource CaptionTextBlock}" 
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="采购行生成方式" Style="{StaticResource CaptionTextBlock}" />
                        
                        <ComboBox ItemsSource="{Binding Preview.LineModeOptions}" 
                                  DisplayMemberPath="DisplayText" 
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Preview.LineMode, Mode=TwoWay}" />
                        
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="4" RowDefinitions="*,8,Auto">
                    
                    <views:PurchaseCandidateSelectionView DataContext="{Binding Picker}" />
                    
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Preview.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8" 
                                        BorderThickness="1" 
                                        BorderBrush="{DynamicResource SwiftExportBrush.Border}">
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}" 
                                                  IsEnabled="{Binding RequiresConfirmation}"
                                                  Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlock}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <Grid DataContext="{Binding Preview}"
                  d:DataContext="{d:DesignInstance viewModels:PurchaseDraftWorkflowViewModel}"
                  Visibility="{Binding DataContext.IsPreviewStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,*">
                <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto,8,Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="采购单审核" />
                        <TextBlock Text="供应商、数量、价格、交期如需修改，请返回采购准备；此处只审核后端生成的只读单据快照。"
                                   Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SwiftExportBrush.WarningText}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Grid Grid.Column="1" MinWidth="150">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding SelectedDocument.Target.SelectedChoiceDisplayText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDocument.Target.HasMultipleChoices}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding SelectedDocument.Target.Choices}"
                                  AutomationProperties.Name="采购草稿目标"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedDocument.Target.SelectedChoice, Mode=TwoWay}"
                                  ToolTip="选择草稿目标后需重新计算单据。">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDocument.Target.HasMultipleChoices}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding PreviewSummaryText}" />
                    <Button Grid.Column="5"
                            Content="{Binding PreviewActionText}"
                            Command="{Binding PreviewCommand}"
                            ToolTip="草稿目标变化可直接重新生成；采购输入变化请返回采购准备修改并重新校验。" />
                    <Button Grid.Column="7" Content="创建采购草稿"
                            Command="{Binding DataContext.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding CanCreateCurrent}" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*">
                    <Border 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                        <DataGrid ItemsSource="{Binding Documents}" 
                              SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                              FontSize="12" 
                              RowHeight="{StaticResource DataGridRowHeightSmall}"
                              GridLinesVisibility="Horizontal"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源单" Width="110" 
                                                Binding="{Binding SourceNo}" />
                                <DataGridTextColumn Header="供应商" Width="90" 
                                                Binding="{Binding SupplierDisplay}" />
                                <DataGridTextColumn Header="行数" Width="52" 
                                                Binding="{Binding Lines.Count}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Grid Grid.Column="2" RowDefinitions="3*,8,5*,8,5*">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                        <Border Padding="12"
                                HorizontalAlignment="Stretch"
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Border.Resources>
                            <Grid DataContext="{Binding SelectedDocument}"
                                  d:DataContext="{d:DesignInstance models:PurchaseDraftDocumentReviewModel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="35" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="客户" />
                                <ui:TextBox Grid.Row="0" Grid.Column="2"
                                            PlaceholderText="客户"
                                            Text="{Binding CustomerDisplay, Mode=OneWay}"
                                            IsReadOnly="True" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="客户PO号" />
                                <ui:TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Header.CustomerPoNo, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="来源单号" />
                                <ui:TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SourceNo, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="内部单号" />
                                <ui:TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Header.BoNo, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="采购单号" />
                                <ui:TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Header.OrderNoDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="草稿目标" />
                                <ui:TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Target.SelectedChoiceDisplayText, Mode=OneWay}" IsReadOnly="True" />

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="供应商" />
                                <ui:TextBox Grid.Row="0" Grid.Column="6" Text="{Binding SupplierDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="币种" />
                                <ui:TextBox Grid.Row="2" Grid.Column="6" Text="{Binding Header.Currency, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="价格倍率" />
                                <ui:TextBox Grid.Row="4" Grid.Column="6" Text="{Binding Header.DiscountRate, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="6" Grid.Column="4" Text="整单折扣" />
                                <ui:TextBox Grid.Row="6" Grid.Column="6" Text="{Binding Header.DiscountAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />
                                <TextBlock Grid.Row="8" Grid.Column="4" Text="未税合计" />
                                <ui:TextBox Grid.Row="8" Grid.Column="6" Text="{Binding Header.UntaxedTotalAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />
                                <TextBlock Grid.Row="10" Grid.Column="4" Text="含税合计" />
                                <ui:TextBox Grid.Row="10" Grid.Column="6" Text="{Binding Header.TaxIncludedTotalAmount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" />

                                <TextBlock Grid.Row="0" Grid.Column="8" Text="下单日期" />
                                <ui:TextBox Grid.Row="0" Grid.Column="10" Text="{Binding Header.OrderDateDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="2" Grid.Column="8" Text="期望交期" />
                                <ui:TextBox Grid.Row="2" Grid.Column="10" Text="{Binding Header.ExpectedDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" IsReadOnly="True" />
                                <TextBlock Grid.Row="4" Grid.Column="8" Text="业务员" />
                                <ui:TextBox Grid.Row="4" Grid.Column="10" Text="{Binding Header.SalesPerson, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="6" Grid.Column="8" Text="采购员" />
                                <ui:TextBox Grid.Row="6" Grid.Column="10" Text="{Binding Header.PurchasePerson, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="8" Grid.Column="8" Text="进水管" />
                                <ui:TextBox Grid.Row="8" Grid.Column="10" Text="{Binding Header.InletHoseType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="10" Grid.Column="8" Text="起泡器" />
                                <ui:TextBox Grid.Row="10" Grid.Column="10" Text="{Binding Header.AeratorType, Mode=OneWay}" IsReadOnly="True" />

                                <TextBlock Grid.Row="0" Grid.Column="12" Text="托盘" />
                                <ui:TextBox Grid.Row="0" Grid.Column="14" Text="{Binding Header.PalletType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="2" Grid.Column="12" Text="内盒" />
                                <ui:TextBox Grid.Row="2" Grid.Column="14" Text="{Binding Header.BoxType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="4" Grid.Column="12" Text="标贴" />
                                <ui:TextBox Grid.Row="4" Grid.Column="14" Text="{Binding Header.LabelType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="6" Grid.Column="12" Text="说明书" />
                                <ui:TextBox Grid.Row="6" Grid.Column="14" Text="{Binding Header.InstructionManualType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="8" Grid.Column="12" Text="外箱" />
                                <ui:TextBox Grid.Row="8" Grid.Column="14" Text="{Binding Header.CartonType, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Grid.Row="10" Grid.Column="12" Text="折扣备注" />
                                <ui:TextBox Grid.Row="10" Grid.Column="14" Text="{Binding Header.DiscountRemark, Mode=OneWay}" IsReadOnly="True" />

                                <TextBlock Grid.Row="0" Grid.Column="16" Text="Logo" />
                                <ui:TextBox Grid.Row="0" Grid.RowSpan="5" Grid.Column="18"
                                            ClearButtonEnabled="False"
                                            FontWeight="Bold"
                                            FontSize="25"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Header.LogoType, Mode=OneWay}"
                                            IsReadOnly="True" />

                                <TextBlock Grid.Row="6" Grid.Column="16" Text="特殊要求" />

                                <ui:TextBox Grid.Row="6" Grid.RowSpan="5" Grid.Column="18"
                                            PlaceholderText="特殊要求或备注"
                                            Text="{Binding Header.Remark, Mode=OneWay}"
                                            IsReadOnly="True"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="56" />
                            </Grid>
                        </Border>
                        </ScrollViewer>
                        <Border Grid.Row="2" 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                            <DataGrid Grid.Row="2" FontSize="12"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  ItemsSource="{Binding SelectedDocument.Lines}" 
                                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="SKU" Width="160" 
                                                    Binding="{Binding Sku}" />

                                    <DataGridTextColumn Header="产品型号" Width="160" 
                                                    Binding="{Binding LinkSku}" />

                                    <DataGridTextColumn Header="描述" Width="*" 
                                                    Binding="{Binding Description}" />

                                    <DataGridTextColumn Header="供应商型号" Width="120" 
                                                    Binding="{Binding SupplierSku}" />

                                    <DataGridTextColumn Header="数量" Width="82" 
                                                    Binding="{Binding PurchaseQty, StringFormat=N1}" />

                                    <DataGridTextColumn Header="未税价" Width="82" 
                                                    Binding="{Binding UnitPrice, StringFormat=N2}" />

                                    <DataGridTextColumn Header="含税价" Width="82" 
                                                    Binding="{Binding TaxPrice, StringFormat=N2}" />

                                    <DataGridTextColumn Header="交期" Width="96"
                                                    Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}" />

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="4" 
                                Padding="8" 
                                BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                                BorderThickness="0.5"
                                CornerRadius="8">
                            <Grid RowDefinitions="Auto,4,*">
                                <TextBlock FontWeight="SemiBold" Text="当前采购行的来源贡献" />
                                <DataGrid Grid.Row="2" FontSize="12"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                                          ItemsSource="{Binding SelectedLine.Contributions}" 
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="1"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="来源单" Width="110" Binding="{Binding SourceNo}" />
                                        <DataGridTextColumn Header="行" 
                                                            Visibility="Collapsed"
                                                            Width="52" Binding="{Binding SourceLineNumber}" />
                                        <DataGridTextColumn Header="SKU" Width="160" Binding="{Binding Sku}" />
                                        <DataGridTextColumn Header="产品型号" Width="160" Binding="{Binding LinkSku}" />
                                        <DataGridTextColumn Header="待采数量" Width="90" 
                                                            Binding="{Binding ExpectedRemainingQty, StringFormat=N1}" />
                                        <DataGridTextColumn Header="采购数量" Width="90" 
                                                            Binding="{Binding PurchaseQty, StringFormat=N1}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Visibility="{Binding IsResultStage, Converter={StaticResource BooleanToVisibilityConverter}}" 
                  RowDefinitions="Auto,8,*">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="创建结果" />
                        <TextBlock Text="{Binding Preview.ResultSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="返回未完成项" Command="{Binding ReturnToPreviewCommand}" />
                </Grid>
                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding Preview.Results}" 
                          Style="{StaticResource SwiftExportDataGrid}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源" Width="180" Binding="{Binding SourceDisplay}" />
                        <DataGridTextColumn Header="结果" Width="110" Binding="{Binding OutcomeText}" />
                        <DataGridTextColumn Header="采购单号" Width="180" Binding="{Binding PurchaseOrderNos}" />
                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
