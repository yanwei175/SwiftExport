<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderFromMaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Views"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="1400" d:Height="820">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="4" RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="从物料需求建立采购草稿" />
                <TextBlock Text="选择物料、核对预览和查看创建结果均在当前弹窗完成。"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="返回选择" Command="{Binding BackToSelectionCommand}"
                    Visibility="{Binding IsPreviewStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="3" Content="进入预览" Command="{Binding ContinueToPreviewCommand}"
                    Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsSelectionStage, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,*">
                <Border Padding="8" Background="{DynamicResource SwiftExportBrush.WarningSoft}"
                        Visibility="{Binding Picker.IsSourceSwitchPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnDefinitions="*,Auto,8,Auto">
                        <TextBlock Text="{Binding Picker.SourceSwitchPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="继续切换" Command="{Binding Picker.ConfirmSourceSwitchCommand}" />
                        <Button Grid.Column="3" Content="保留当前选择" Command="{Binding Picker.CancelSourceSwitchCommand}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding SelectionValidationText}"
                           Foreground="{DynamicResource SwiftExportBrush.Error}" />
                <views:PurchaseCandidateSelectionView Grid.Row="2" DataContext="{Binding Picker}" />
            </Grid>

            <Grid DataContext="{Binding Preview}"
                  Visibility="{Binding DataContext.IsPreviewStage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,Auto,8,*">
                <Grid ColumnDefinitions="Auto,12,240,12,*,Auto,8,Auto">
                    <StackPanel>
                        <TextBlock Text="入口" Style="{StaticResource CaptionTextBlock}" />
                        <TextBlock Text="{Binding EntryModeText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="采购行生成方式" Style="{StaticResource CaptionTextBlock}" />
                        <ComboBox ItemsSource="{Binding LineModeOptions}" DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                  SelectedValue="{Binding LineMode, Mode=TwoWay}"
                                  IsEnabled="{Binding HasUnknownCreateResult, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding PreviewSummaryText}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="5" Content="重新预览" Command="{Binding PreviewCommand}" />
                    <Button Grid.Column="7" Content="创建采购草稿"
                            Command="{Binding DataContext.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsEnabled="{Binding CanCreateCurrent}" />
                </Grid>

                <Border Grid.Row="2" Padding="8" Background="{DynamicResource SwiftExportBrush.WarningSoft}"
                        Visibility="{Binding IsStale, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="当前预览已失效：数量、合并方式或追加目标修改后，必须重新预览。" TextWrapping="Wrap" />
                </Border>

                <TabControl Grid.Row="4">
                    <TabItem Header="本次计划">
                        <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" RowHeight="34"
                                  IsEnabled="{Binding HasUnknownCreateResult, Converter={StaticResource InverseBooleanConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源单号" Width="120" Binding="{Binding SourceNo}" IsReadOnly="True" />
                                <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Sku}" IsReadOnly="True" />
                                <DataGridTextColumn Header="剩余可转" Width="100" Binding="{Binding ExpectedRemainingQty, StringFormat=N4}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="本次采购数量" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Text="{Binding PurchaseQty, UpdateSourceTrigger=LostFocus, StringFormat=N4}" IsReadOnly="{Binding IsQuantityReadOnly}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="数量校验" Width="*" Binding="{Binding QuantityError}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="采购草稿预览">
                        <Grid RowDefinitions="Auto,8,*">
                            <DataGrid ItemsSource="{Binding Targets}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" RowHeight="34" MaxHeight="180"
                                      IsEnabled="{Binding HasUnknownCreateResult, Converter={StaticResource InverseBooleanConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="来源单号" Width="120" Binding="{Binding SourceNo}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="采购供应商" Width="180" Binding="{Binding SupplierName}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="草稿目标" Width="220">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding PreviewLines}"
                                      Style="{StaticResource SwiftExportDataGrid}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="60"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      EnableRowVirtualization="True"
                                      AutomationProperties.Name="采购草稿预览行，选择一行可查看来源贡献">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,4,8,8"
                                                Padding="8"
                                                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,4,Auto,*">
                                                <TextBlock FontWeight="SemiBold" Text="来源贡献（逐条数量之和等于本采购行数量）" />
                                                <Grid Grid.Row="2" ColumnDefinitions="110,56,110,110,95,95,95,95">
                                                    <TextBlock Text="来源单号" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="1" Text="行号" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="2" Text="物料 SKU" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="3" Text="产品型号" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="4" Text="原剩余量" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="5" Text="本次贡献" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="6" Text="需求交期" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Grid.Column="7" Text="原计划交期" Style="{StaticResource CaptionTextBlock}" />
                                                </Grid>
                                                <ScrollViewer Grid.Row="3" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Contributions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4,0,0" ColumnDefinitions="110,56,110,110,95,95,95,95">
                                                                    <TextBlock Text="{Binding SourceNo}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceLineNumber}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding LinkSku}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding ExpectedRemainingQty, StringFormat=N4}" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding PurchaseQty, StringFormat=N4}" />
                                                                    <TextBlock Grid.Column="6" Text="{Binding DemandRequiredDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                                                    <TextBlock Grid.Column="7" Text="{Binding PlannedDeliveryDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="来源" Width="105" Binding="{Binding SourceNo}" />
                                    <DataGridTemplateColumn Header="图片" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:CachedImage Width="52" Height="52"
                                                                      Margin="2"
                                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                                      SourcePath="{Binding ImagePath}"
                                                                      DecodePixelWidth="96"
                                                                      Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SKU" Width="120" Binding="{Binding Sku}" />
                                    <DataGridTextColumn Header="产品型号" Width="120" Binding="{Binding LinkSku}" />
                                    <DataGridTextColumn Header="客户型号" Width="110" Binding="{Binding CustomerSku}" />
                                    <DataGridTextColumn Header="描述" Width="170" Binding="{Binding Description}" />
                                    <DataGridTextColumn Header="物料属性" Width="140" Binding="{Binding AttributeSummary}" />
                                    <DataGridTextColumn Header="供货属性" Width="90" Binding="{Binding DeliveryModeText}" />
                                    <DataGridTextColumn Header="单位" Width="65" Binding="{Binding Unit}" />
                                    <DataGridTextColumn Header="实际采购供应商" Width="150" Binding="{Binding SupplierDisplay}" />
                                    <DataGridTextColumn Header="供应商型号" Width="120" Binding="{Binding SupplierSku}" />
                                    <DataGridTextColumn Header="未税价(CNY)" Width="95" Binding="{Binding UnitPrice, StringFormat=N4}" />
                                    <DataGridTextColumn Header="含税价(CNY)" Width="95" Binding="{Binding TaxPrice, StringFormat=N4}" />
                                    <DataGridTextColumn Header="实际送达方" Width="140" Binding="{Binding DeliveryTargetSupplierName}" />
                                    <DataGridTextColumn Header="采购数量" Width="90" Binding="{Binding PurchaseQty, StringFormat=N4}" />
                                    <DataGridTextColumn Header="采用交期" Width="95" Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}" />
                                    <DataGridTextColumn Header="未合并原因" Width="190" Binding="{Binding MergeDifferenceReason}" />
                                    <DataGridCheckBoxColumn Header="资料待补" Width="80" Binding="{Binding PurchaseDataIncomplete}" />
                                    <DataGridTextColumn Header="来源贡献" Width="80" Binding="{Binding ContributionCount}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="警告与阻断">
                        <Grid RowDefinitions="*,8,Auto">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="8" BorderBrush="{DynamicResource SwiftExportBrush.Border}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,8,*">
                                                    <CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}" IsEnabled="{Binding RequiresConfirmation}"
                                                              Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Code}"/><Run Text="  "/><Run Text="{Binding Message}"/></TextBlock>
                                                        <TextBlock Text="阻断项：必须修复后重新预览" Foreground="{DynamicResource SwiftExportBrush.Error}"
                                                                   Visibility="{Binding IsBlocker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding SkippedItems}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="跳过物料需求" Width="220" Binding="{Binding NetDemandId}" />
                                    <DataGridTextColumn Header="执行方式" Width="90" Binding="{Binding ExecutionType}" />
                                    <DataGridTextColumn Header="原因" Width="*" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Visibility="{Binding IsResultStage, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowDefinitions="Auto,8,*,8,Auto">
                <TextBlock Text="{Binding Preview.ResultSummary}" FontWeight="SemiBold" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding Preview.Results}" Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源类型" Width="90" Binding="{Binding SourceType}" />
                        <DataGridTextColumn Header="来源 Uid" Width="220" Binding="{Binding SourceUid}" />
                        <DataGridTextColumn Header="结果" Width="100" Binding="{Binding Outcome}" />
                        <DataGridTextColumn Header="错误码" Width="150" Binding="{Binding ErrorCode}" />
                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}" />
                        <DataGridTextColumn Header="采购草稿号" Width="180" Binding="{Binding PurchaseOrderNos}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="4" HorizontalAlignment="Right" Content="返回预览" Command="{Binding ReturnToPreviewCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
