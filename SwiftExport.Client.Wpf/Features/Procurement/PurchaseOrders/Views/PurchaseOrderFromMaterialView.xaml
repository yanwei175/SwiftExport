<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderFromMaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseOrderFromMaterialViewModel}"
             d:Width="1400" d:Height="820">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:PurchaseCandidateSelectionViewModel}">
            <views:PurchasePreparationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PurchaseDraftResultViewModel}">
            <views:PurchaseDraftResultView />
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding CurrentPage}" />
</UserControl>
