<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="640" Margin="16">
        <TextBlock Text="采购追溯" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,20" Text="功能待实现，当前不查询或展示追溯数据。" TextWrapping="Wrap" />
        <TextBlock Text="来源需求" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,16" Text="未来展示来源单、物料需求、采购行贡献数量及引用释放状态；独立采购显示无来源需求。" TextWrapping="Wrap" />
        <TextBlock Text="收货记录" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,16" Text="未来展示关联入库单、实际仓库、收货数量及过账、反过账状态。" TextWrapping="Wrap" />
        <TextBlock Text="操作历史" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,16" Text="未来展示创建、确认、取消确认、删行和作废的时间、人员及原因。" TextWrapping="Wrap" />
        <TextBlock Text="已释放引用、已删除采购行及反过账记录仍需可追溯。PackingList 关联待实际链路接通后再加入。" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
