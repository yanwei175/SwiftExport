<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderTraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,Auto,8,2*,8,3*">
        <DockPanel>
            <StackPanel>
                <TextBlock Text="采购追溯" Style="{StaticResource SubtitleTextBlock}"/>
                <TextBlock Text="{Binding Detail.OrderNo}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OriginText}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Content="刷新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" MinWidth="72"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="4" Text="货好、正式净收货与需求来源分别列示；需求贡献不表示每笔入库的专属归属。"
                   TextWrapping="Wrap" Foreground="Gray"/>
        <DataGrid Grid.Row="6" ItemsSource="{Binding Detail.Lines}" SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="历史行" Binding="{Binding IsDeleted}" Width="70"/>
                <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="55"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                <DataGridTextColumn Header="采购数量" Binding="{Binding Quantity,StringFormat={}{0:0.####}}" Width="95"/>
                <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="70"/>
                <DataGridTextColumn Header="最新货好" Binding="{Binding LatestReadyQty,StringFormat={}{0:0.####}}" Width="95"/>
                <DataGridTextColumn Header="正式净收" Binding="{Binding FormalReceivedQty,StringFormat={}{0:0.####}}" Width="95"/>
                <DataGridTextColumn Header="未关联量" Binding="{Binding UnlinkedQty,StringFormat={}{0:0.####}}" Width="90"/>
                <DataGridTextColumn Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                <DataGridTextColumn Header="核实提示" Binding="{Binding ReviewReason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TabControl Grid.Row="8">
            <TabItem Header="需求来源 Link">
                <Grid RowDefinitions="Auto,4,*">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开物料追踪" Command="{Binding OpenMaterialTraceCommand}" Margin="4"/>
                        <Button Content="打开来源追踪" Command="{Binding OpenSourceTraceCommand}" Margin="4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedLine.Links}" SelectedItem="{Binding SelectedLink}"
                              AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="125"/>
                            <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="95"/>
                            <DataGridTextColumn Header="来源行" Binding="{Binding SourceLineNumber}" Width="65"/>
                            <DataGridTextColumn Header="来源版本" Binding="{Binding SourceVersion}" Width="80"/>
                            <DataGridTextColumn Header="需求版本快照" Binding="{Binding SourceDemandVersionSnapshot}" Width="105"/>
                            <DataGridTextColumn Header="来源版本快照" Binding="{Binding SourceVersionSnapshot}" Width="105"/>
                            <DataGridTextColumn Header="拆解修订" Binding="{Binding DecompositionRevision}" Width="75"/>
                            <DataGridTextColumn Header="来源单位" Binding="{Binding UnitSnapshot}" Width="75"/>
                            <DataGridTextColumn Header="最初贡献" Binding="{Binding AllocatedQty}" Width="85"/>
                            <DataGridTextColumn Header="已释放" Binding="{Binding ReleasedQty}" Width="75"/>
                            <DataGridTextColumn Header="当前贡献" Binding="{Binding EffectiveQty}" Width="85"/>
                            <DataGridCheckBoxColumn Header="历史删除" Binding="{Binding IsDeleted}" Width="80"/>
                            <DataGridTextColumn Header="Link状态" Binding="{Binding LinkStatus,Converter={StaticResource EnumDescriptionConverter}}" Width="80"/>
                            <DataGridTextColumn Header="取消原因" Binding="{Binding CancelledReason}" Width="140"/>
                            <DataGridTextColumn Header="需求指纹" Binding="{Binding DemandBasisFingerprint}" Width="170"/>
                            <DataGridTextColumn Header="核实原因" Binding="{Binding ReviewReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="供应商反馈">
                <DataGrid ItemsSource="{Binding SelectedLine.ProgressHistory}" AutoGenerateColumns="False"
                          IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="55"/>
                        <DataGridTextColumn Header="累计货好" Binding="{Binding ReadyQty}" Width="95"/>
                        <DataGridTextColumn Header="预计备好" Binding="{Binding ExpectedReadyDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridTextColumn Header="反馈日期" Binding="{Binding SupplierReportedDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridCheckBoxColumn Header="纠错" Binding="{Binding IsCorrection}" Width="55"/>
                        <DataGridTextColumn Header="原因" Binding="{Binding CorrectionReason}" Width="180"/>
                        <DataGridTextColumn Header="跟单员" Binding="{Binding CreatedBy}" Width="95"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="正式入库与反向">
                <Grid RowDefinitions="Auto,4,*">
                    <Button Content="打开所选入库单" Command="{Binding OpenInboundCommand}"
                            HorizontalAlignment="Left" Margin="4"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedLine.Receipts}" SelectedItem="{Binding SelectedReceipt}"
                              AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="入库单号" Binding="{Binding DocumentNo}" Width="140"/>
                            <DataGridTextColumn Header="过账状态" Binding="{Binding PostingStatus}" Width="90"/>
                            <DataGridTextColumn Header="原收货量" Binding="{Binding Quantity}" Width="90"/>
                            <DataGridTextColumn Header="净贡献" Binding="{Binding NetQuantity}" Width="90"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="65"/>
                            <DataGridTextColumn Header="仓库" Binding="{Binding WarehouseNameSnapshot}" Width="120"/>
                            <DataGridTextColumn Header="收货日" Binding="{Binding ReceiptDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                            <DataGridTextColumn Header="过账人" Binding="{Binding PostedBy}" Width="90"/>
                            <DataGridTextColumn Header="反向日" Binding="{Binding ReversedDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                            <DataGridTextColumn Header="反向人" Binding="{Binding ReversedBy}" Width="90"/>
                            <DataGridTextColumn Header="反向原因" Binding="{Binding ReverseReason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="业务操作历史">
                <DataGrid ItemsSource="{Binding Detail.Operations}" AutoGenerateColumns="False"
                          IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="145"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding OperationName}" Width="130"/>
                        <DataGridTextColumn Header="操作人" Binding="{Binding UserName}" Width="95"/>
                        <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="180"/>
                        <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
