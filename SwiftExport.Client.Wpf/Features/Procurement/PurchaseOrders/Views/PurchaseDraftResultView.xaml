<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseDraftResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseDraftResultViewModel}"
             d:Width="800" d:Height="400">
    <Grid Margin="4" RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="创建结果" />
                <TextBlock Text="{Binding Session.ResultSummary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="返回未完成项" Command="{Binding ReturnToPreparationCommand}" />
        </Grid>
        <DataGrid Grid.Row="2"
                  FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                  ItemsSource="{Binding Session.Results}"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeRows="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="来源" Width="180" Binding="{Binding SourceDisplay}" />
                <DataGridTextColumn Header="结果" Width="110" Binding="{Binding OutcomeText}" />
                <DataGridTextColumn Header="采购单号" Width="210" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding PurchaseOrderNos}" />
                <DataGridTextColumn Header="说明" Width="*" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding Message}" 
                                    />
                <DataGridTextColumn Header="错误代码" Width="180" Binding="{Binding ErrorCode}" />
                <DataGridTemplateColumn Header="打开草稿" Width="180">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <ItemsControl ItemsSource="{Binding PurchaseDrafts}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding OrderNo}" Command="{Binding DataContext.OpenPurchaseOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
