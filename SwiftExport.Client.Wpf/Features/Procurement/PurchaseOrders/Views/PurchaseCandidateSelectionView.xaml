<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseCandidateSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:purchaseComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseCandidateSelectionViewModel}"
             d:Width="1400" d:Height="600"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <Grid Margin="8" ColumnDefinitions="240,8,*">
        <Border Padding="8"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,8,*,8,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购来源" />
                    <TextBlock Margin="0,2,0,0"
                               Text="选择来源后一次加载完整候选"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </StackPanel>

                <ListBox x:Name="SourceGroupList"
                         Grid.Row="2"
                         ItemsSource="{Binding SourceGroups}"
                         SelectedItem="{Binding SelectedSourceGroup, Mode=OneWay}"
                         SelectionChanged="OnSourceGroupSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplaySourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                               Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CountText}"
                                           Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Text="{Binding SourceGroupStatusText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </Grid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购物料" />
                    <TextBlock Margin="0,2,0,0"
                               Text="上方条件仅筛选当前已加载数据，不会重新查询。"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="112"
                        Command="{Binding ToggleAllVisibleCommand}"
                        Content="全选当前筛选"
                        AutomationProperties.Name="全选或取消当前筛选可见物料" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="260,8,180,8,Auto,8,Auto,8,Auto">
                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="筛选 SKU、产品型号、描述或推荐供应商"
                         AutomationProperties.Name="待采购物料关键词筛选" />
                <ui:TextBox Grid.Column="2"
                         Text="{Binding SourceNo, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="仅筛选已加载数据中的来源单号"
                         AutomationProperties.Name="来源单号筛选" />
                <Button Grid.Column="4"
                        MinWidth="72"
                        Command="{Binding ApplyFilterCommand}"
                        Content="筛选" />
                <Button Grid.Column="6"
                        MinWidth="72"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空" />
                <CheckBox Grid.Column="8"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowOnlyErrors, Mode=TwoWay}"
                          Content="只看错误" />
            </Grid>

            <DataGrid Grid.Row="4"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridCore:GridVirtualization.IsEnabled="True"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      gridOperations:GridOperations.IsEnabled="True"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding SelectedItem, Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="56" CanUserSort="False"
                                            gridColumns:GridColumn.Key="Select"
                                            gridColumns:GridColumn.FieldPath="IsChecked"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleAllVisibleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          AutomationProperties.Name="全选或取消当前筛选可见物料"
                                          ToolTip="全选或取消当前筛选可见物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="选择该待采购物料"
                                          ToolTip="选择该待采购物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True" gridColumns:GridColumn.Key="Image">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="2"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="来源单号" Width="100" 
                                        Binding="{Binding SourceNo}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="SourceNo" />
                    
                    <DataGridTextColumn Header="行" Width="52" gridColumns:GridColumn.Key="SourceLineNumber"
                                        Binding="{Binding SourceLineNumber}"
                                        Visibility="Collapsed"/>
                    
                    <DataGridTextColumn Header="SKU" Width="140" 
                                        Binding="{Binding Sku}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="Sku" />
                    
                    <DataGridTextColumn Header="产品型号" Width="140" 
                                        Binding="{Binding LinkSku}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="LinkSku" />
                    
                    <DataGridTextColumn Header="描述" Width="150" 
                                        Binding="{Binding Description}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="Description" />
                    
                    <DataGridTemplateColumn Header="供应商" 
                                            Width="100" 
                                            gridColumns:GridColumn.Key="PurchaseSupplier" 
                                            gridColumns:GridColumn.FieldPath="SupplierId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <purchaseComponents:PurchaseSupplierLookupTextBox
                                    Text="{Binding PurchaseSupplierSearchText, Mode=TwoWay}"
                                    ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedSupplier="{Binding PurchaseSupplierSelection, Mode=TwoWay}"
                                    SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitPurchaseSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearPurchaseSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}"
                                    IsBusy="{Binding DataContext.IsSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Placeholder="搜索实际采购方" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="客供送至" Width="100" 
                                            gridColumns:GridColumn.Key="DeliverySupplier" 
                                            gridColumns:GridColumn.FieldPath="DeliveryTargetSupplierId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <purchaseComponents:PurchaseSupplierLookupTextBox
                                    Text="{Binding DeliverySupplierSearchText, Mode=TwoWay}"
                                    ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedSupplier="{Binding DeliverySupplierSelection, Mode=TwoWay}"
                                    SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitDeliverySupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearDeliverySupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}"
                                    IsBusy="{Binding DataContext.IsSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    IsEnabled="{Binding IsCustomerSupplied}"
                                    Placeholder="搜索实际送达方" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="待采数量" Width="70" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding RemainingQty, StringFormat=N1}" IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="RemainingQty" />

                    <DataGridTextColumn Header="采购数量" Width="70" 
                                        Binding="{Binding PurchaseQty, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N1}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        gridColumns:GridColumn.Key="PurchaseQty" />

                    <DataGridTextColumn Header="未税价" Width="70" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                        gridColumns:GridColumn.Key="UnitPrice" />

                    <DataGridTextColumn Header="含税价" Width="70" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding TaxPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                        gridColumns:GridColumn.Key="TaxPrice" />

                    <DataGridTemplateColumn Header="计划交期" Width="120"
                                            gridColumns:GridColumn.Key="PlannedDeliveryDate" 
                                            gridColumns:GridColumn.FieldPath="PlannedDeliveryDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}"
                                           Style="{StaticResource SwiftExportDataGridDateTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker FontSize="8" 
                                            SelectedDate="{Binding PlannedDeliveryDate, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="验证结果" Width="260" 
                                        Binding="{Binding ValidationMessage}" IsReadOnly="True" 
                                        gridColumns:GridColumn.Key="ValidationMessage" />
                    
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</UserControl>
