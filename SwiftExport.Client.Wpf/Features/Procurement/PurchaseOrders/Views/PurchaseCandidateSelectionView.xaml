<UserControl xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseCandidateSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:purchaseComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:PurchaseCandidateSelectionViewModel}"
             d:Width="1400" d:Height="600"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <Grid Margin="8" ColumnDefinitions="240,8,*">
        <Border Padding="8"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,8,*,8,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购来源" />
                    <TextBlock Margin="0,2,0,0"
                               Text="选择来源后一次加载完整候选"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListBox x:Name="SourceGroupList"
                         Grid.Row="2"
                         IsEnabled="{Binding IsInputEnabled}"
                         ItemsSource="{Binding SourceGroups}"
                         SelectedItem="{Binding SelectedSourceGroup, Mode=OneWay}"
                         SelectionChanged="OnSourceGroupSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplaySourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                               Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CountText}"
                                           Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Text="{Binding SourceGroupStatusText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购物料" />
                    <TextBlock Margin="0,2,0,0"
                               Text="供应商双击或按 F2 编辑；选择同列连续单元格后按 Ctrl+D 向下填充。上方条件只筛选已加载数据。"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>
                

            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="260,8,280,8,Auto,8,Auto,8,Auto,8,Auto">
                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="筛选 SKU、产品型号、描述或推荐供应商"
                         AutomationProperties.Name="待采购物料关键词筛选" />
                
                <ui:TextBox Grid.Column="2"
                             Text="{Binding SourceNo, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="仅筛选已加载数据中的来源单号"
                             AutomationProperties.Name="来源单号筛选" />
                
                <Button Grid.Column="4"
                        MinWidth="72"
                        Command="{Binding ApplyFilterCommand}"
                        Content="筛选" />
                <Button Grid.Column="6"
                        MinWidth="72"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空" />
                <CheckBox Grid.Column="10"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowOnlyErrors, Mode=TwoWay}"
                          Content="只看错误" />
                <Button Grid.Column="8"
                        MinWidth="72"
                        Command="{Binding InvertVisibleSelectionCommand}"
                        Content="反选当前筛选"
                        AutomationProperties.Name="反选当前筛选可见物料" />
            </Grid>

            <DataGrid x:Name="CandidateGrid"
                      Grid.Row="4"
                      IsEnabled="{Binding IsInputEnabled}"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      ItemsSource="{Binding ItemsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionUnit="CellOrRowHeader"
                      BeginningEdit="OnBeginningEdit"
                      PreparingCellForEdit="OnPreparingCellForEdit"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      CurrentItem="{Binding SelectedItem, Mode=TwoWay}">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                    </i:Interaction.Behaviors>
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="56" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleAllVisibleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          AutomationProperties.Name="全选或取消当前筛选可见物料"
                                          ToolTip="全选或取消当前筛选可见物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="选择该待采购物料"
                                          ToolTip="选择该待采购物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="2"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="来源单号" Width="100" 
                                        Binding="{Binding SourceNo}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" />
                    
                    <DataGridTextColumn Header="行" Width="52"
                                        Binding="{Binding SourceLineNumber}"
                                        Visibility="Collapsed"/>
                    
                    <DataGridTextColumn Header="SKU" Width="140" 
                                        Binding="{Binding Sku}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" />
                    
                    <DataGridTextColumn Header="产品型号" Width="140" 
                                        Binding="{Binding LinkSku}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" />
                    
                    <DataGridTextColumn Header="描述" Width="150" 
                                        Binding="{Binding Description}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        IsReadOnly="True" />
                    
                    <DataGridTemplateColumn x:Name="PurchaseSupplierColumn" fill:DataGridFillDownBehavior.Field="SupplierId" ClipboardContentBinding="{Binding PurchaseSupplierDisplay, Mode=OneWay}" Header="供应商"
                                            Width="80"
                                            IsReadOnly="False"
                                            SortMemberPath="PurchaseSupplierCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PurchaseSupplierDisplay}"
                                           ToolTip="{Binding PurchaseSupplierDisplay}"
                                           Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <purchaseComponents:PurchaseSupplierLookupTextBox
                                                    Text="{Binding PurchaseSupplierSearchText, Mode=OneWay}"
                                                    ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectedSupplier="{Binding PurchaseSupplierSelection, Mode=TwoWay}"
                                                    SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommand="{Binding DataContext.CommitPurchaseSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommandParameter="{Binding}"
                                                    SelectionClearedCommand="{Binding DataContext.ClearPurchaseSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionClearedCommandParameter="{Binding}"
                                                    IsBusy="{Binding DataContext.IsSupplierSearchBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    IsEnabled="{Binding CanEditPurchaseSupplier}"
                                                    Placeholder="搜索实际采购方" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn ClipboardContentBinding="{Binding DeliverySupplierDisplay, Mode=OneWay}" Header="客供送至" Width="100"
                                            IsReadOnly="True"
                                            SortMemberPath="DeliverySupplierCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeliverySupplierDisplay}"
                                           ToolTip="{Binding DeliverySupplierDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeliverySupplierDisplay}" Value="不适用">
                                                    <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DeliverySupplierDisplay}" Value="未选择">
                                                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="待采数量" Width="70" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding RemainingQty, StringFormat=N1}" IsReadOnly="True" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="PurchaseQty" Header="本次采购" Width="70"
                                        Binding="{Binding PurchaseQty, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N1}" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="UnitPrice" Header="未税价" Width="70"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="TaxPrice" Header="含税价" Width="70"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding TaxPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />

                    <DataGridTemplateColumn fill:DataGridFillDownBehavior.Field="PlannedDeliveryDate" ClipboardContentBinding="{Binding PlannedDeliveryDate, Mode=OneWay}" Header="计划交期" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}"
                                           Style="{StaticResource SwiftExportDataGridDateTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker FontSize="8" 
                                            SelectedDate="{Binding PlannedDeliveryDate, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn ClipboardContentBinding="{Binding ValidationDisplayMessage, Mode=OneWay}" Header="验证结果" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ValidationDisplayMessage}"
                                           Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                                           Margin="2"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</UserControl>
