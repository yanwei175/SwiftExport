<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseCandidateSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
             d:Width="1400" d:Height="600"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <Grid Margin="8" ColumnDefinitions="240,8,*">
        <Border Padding="8"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,8,*,8,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购来源" />
                    <TextBlock Margin="0,2,0,0"
                               Text="选择来源后一次加载完整候选"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </StackPanel>

                <ListBox x:Name="SourceGroupList"
                         Grid.Row="2"
                         ItemsSource="{Binding SourceGroups}"
                         SelectedItem="{Binding SelectedSourceGroup, Mode=OneWay}"
                         SelectionChanged="OnSourceGroupSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource SwiftExportListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplaySourceNo}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplaySourceNo}" />
                                    <TextBlock Text="{Binding SourceTypeText}"
                                               Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CountText}"
                                           Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Text="{Binding SourceGroupStatusText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </Grid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="待采购物料" />
                    <TextBlock Margin="0,2,0,0"
                               Text="上方条件仅筛选当前已加载数据，不会重新查询。"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="112"
                        Command="{Binding ToggleAllVisibleCommand}"
                        Content="全选当前筛选"
                        AutomationProperties.Name="全选或取消当前筛选可见物料" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="260,8,180,8,Auto,8,Auto">
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="筛选 SKU、产品型号、描述或推荐供应商"
                         AutomationProperties.Name="待采购物料关键词筛选" />
                <TextBox Grid.Column="2"
                         Text="{Binding SourceNo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅筛选已加载数据中的来源单号"
                         AutomationProperties.Name="来源单号筛选" />
                <Button Grid.Column="4"
                        MinWidth="72"
                        Command="{Binding ApplyFilterCommand}"
                        Content="筛选" />
                <Button Grid.Column="6"
                        MinWidth="72"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空" />
            </Grid>

            <DataGrid Grid.Row="4"
                      RowHeight="64"
                      FontSize="12"
                      ItemsSource="{Binding ItemsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="56" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleAllVisibleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          AutomationProperties.Name="全选或取消当前筛选可见物料"
                                          ToolTip="全选或取消当前筛选可见物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="选择该待采购物料"
                                          ToolTip="选择该待采购物料" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="72" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56"
                                                      Height="56"
                                                      Margin="2"
                                                      Style="{StaticResource SwiftExportCachedImage}"
                                                      SourcePath="{Binding ImagePath}"
                                                      DecodePixelWidth="80"
                                                      Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="来源单号" Width="132" Binding="{Binding SourceNo}" />
                    <DataGridTextColumn Header="行" Width="52" Binding="{Binding SourceLineNumber}" />
                    <DataGridTextColumn Header="SKU" Width="132" Binding="{Binding Sku}" />
                    <DataGridTextColumn Header="产品型号" Width="132" Binding="{Binding LinkSku}" />
                    <DataGridTextColumn Header="描述" Width="*" MinWidth="160" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="推荐供应商" Width="160" Binding="{Binding SuggestedPurchaseSupplierName}" />
                    <DataGridTextColumn Header="剩余数量" Width="96" Binding="{Binding RemainingQty, StringFormat=N4}" />
                    <DataGridTextColumn Header="需求交期" Width="104" Binding="{Binding DemandRequiredDate, StringFormat=yyyy-MM-dd}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</UserControl>
