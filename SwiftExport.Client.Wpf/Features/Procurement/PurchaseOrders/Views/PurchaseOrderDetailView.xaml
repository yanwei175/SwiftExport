<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:purchaseComponents="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--title-->
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="创建草稿" Command="{Binding CreateCommand}" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="保存草稿" Command="{Binding SaveCommand}" Margin="0,0,4,0"/>
                <Button Content="确认订单" Command="{Binding ConfirmCommand}" Margin="0,0,4,0"/>
                <Button Content="取消确认" Command="{Binding CancelConfirmationCommand}" Margin="0,0,4,0"/>
                <Button Content="删除选定行" Command="{Binding DeleteDraftLinesCommand}" Margin="0,0,4,0"/>
                <Button Content="整单作废" Command="{Binding VoidOrderCommand}" Margin="0,0,4,0"/>
                <Button Content="重试原操作" Command="{Binding RetryReversalCommand}" Margin="0,0,4,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,4,0"/>
                <Button Content="关闭" Command="{Binding CloseDocumentCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Header.OrderNo}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Header.OrderStatusText}" Foreground="DarkSlateBlue"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="2">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanInteractWithDocument}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid RowDefinitions="Auto,4,Auto,4,*,4">
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>

                <Border Grid.Row="0"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="系统单号"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="0" PlaceholderText="采购单号" Text="{Binding Header.OrderNo,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="4" Grid.Row="0" Text="来源单号"/>
                        <ui:TextBox Grid.Column="6" Grid.Row="0" PlaceholderText="来源单号" Text="{Binding Header.SourceNo,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="8" Grid.Row="0" Text="确认状态"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="0" Text="{Binding Header.ConfirmationStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="12" Grid.Row="0" Text="生命周期"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="0" Text="{Binding Header.LifecycleStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="16" Grid.Row="0" Text="确认人"/>
                        <ui:TextBox Grid.Column="18" Grid.Row="0" PlaceholderText="确认人" Text="{Binding Header.ConfirmedBy,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="20" Grid.Row="0" Text="确认时间"/>
                        <ui:TextBox Grid.Column="22" Grid.Row="0" PlaceholderText="确认时间" Text="{Binding Header.ConfirmedDate,StringFormat=yyyy-MM-dd HH:mm,Mode=OneWay}" IsReadOnly="True"/>


                        <TextBlock Grid.Column="24" Grid.Row="0" Text="复核人"/>
                        <ui:TextBox Grid.Column="26" Grid.Row="0" PlaceholderText="复核人" Text="{Binding Header.ReviewedBy,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="28" Grid.Row="0" Text="取消确认原因"/>
                        <ui:TextBox Grid.Column="30" Grid.Row="0" PlaceholderText="反向操作原因在确认弹窗填写" Text="{Binding CancellationReason}" IsReadOnly="True"/>


                    </Grid>
                </Border>
                <!--订单头-->
                <Border Grid.Row="2"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Border.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="客户"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="客户PO号"/>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="采购单号"/>
                        <TextBlock Grid.Column="0" Grid.Row="6" Text="业务员"/>
                        <TextBlock Grid.Column="0" Grid.Row="8" Text="特殊要求"/>

                        <purchaseComponents:PurchaseCustomerLookupTextBox Grid.Column="2" Grid.Row="0"
                            Text="{Binding CustomerLookupText,Mode=TwoWay}" ItemsSource="{Binding CustomerCandidates}"
                            SelectedCustomer="{Binding SelectedCustomer,Mode=TwoWay}" SearchCommand="{Binding SearchCustomersCommand}"
                            SelectionCommittedCommand="{Binding CommitCustomerCommand}" SelectionClearedCommand="{Binding ClearCustomerCommand}"
                            IsBusy="{Binding IsCustomerSearchBusy}" IsEnabled="{Binding IsCreateMode}" Placeholder="搜索客户代码或名称"/>

                        <ui:TextBox Grid.Column="2" Grid.Row="2" PlaceholderText="客户PO号" Text="{Binding Header.CustomerPoNo}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="4" PlaceholderText="可随意修改的采购单号" Text="{Binding Header.BoNo}" IsReadOnly="True" />
                        <ui:TextBox Grid.Column="2" Grid.Row="6" PlaceholderText="业务员" Text="{Binding Header.SalesPerson}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="8" PlaceholderText="特殊要求"
                                    Grid.RowSpan="3" Grid.ColumnSpan="5"
                                    Text="{Binding Header.Remark,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}" AcceptsReturn="True" MinHeight="56"/>

                        <TextBlock Grid.Column="4" Grid.Row="0" Text="下单日期"/>
                        <TextBlock Grid.Column="4" Grid.Row="2" Text="期望交期"/>
                        <TextBlock Grid.Column="4" Grid.Row="4" Text="回复交期"/>
                        <TextBlock Grid.Column="4" Grid.Row="6" Text="跟单员"/>

                        <DatePicker Grid.Column="6" Grid.Row="0" controls:DatePickerAssist.PlaceholderText="下单日期" SelectedDate="{Binding Header.OrderDate,Mode=OneWay}" IsEnabled="False">
                            <DatePicker.Style>
                                <Style TargetType="DatePicker" BasedOn="{StaticResource SwiftExportDatePicker}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DatePicker.Style>
                        </DatePicker>
                        <DatePicker Grid.Column="6" Grid.Row="0" SelectedDate="{Binding OrderDate}">
                            <DatePicker.Style>
                                <Style TargetType="DatePicker" BasedOn="{StaticResource SwiftExportDatePicker}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DatePicker.Style>
                        </DatePicker>
                        <ui:TextBox Grid.Column="6" Grid.Row="2" PlaceholderText="期望交期"/>
                        <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="6" Grid.Row="4" controls:DatePickerAssist.PlaceholderText="回复交期" SelectedDate="{Binding Header.ReplyDate}" IsEnabled="False"/>
                        <ui:TextBox Grid.Column="6" Grid.Row="6" PlaceholderText="跟单员" Text="{Binding Header.PurchasePerson}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="8" Grid.Row="0" Text="供应商"/>
                        <TextBlock Grid.Column="8" Grid.Row="2" Text="进水管"/>
                        <TextBlock Grid.Column="8" Grid.Row="4" Text="起泡器"/>
                        <TextBlock Grid.Column="8" Grid.Row="6" Text="托盘"/>
                        <TextBlock Grid.Column="8" Grid.Row="8" Text="币种"/>
                        <TextBlock Grid.Column="8" Grid.Row="10" Text="包装要求"/>


                        <purchaseComponents:PurchaseSupplierLookupTextBox Grid.Column="10" Grid.Row="0"
                            Text="{Binding SupplierLookupText,Mode=TwoWay}" ItemsSource="{Binding SupplierCandidates}"
                            SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" SearchCommand="{Binding SearchSuppliersCommand}"
                            SelectionCommittedCommand="{Binding CommitSupplierCommand}" SelectionClearedCommand="{Binding ClearSupplierCommand}"
                            IsBusy="{Binding IsSupplierSearchBusy}" IsEnabled="{Binding IsCreateMode}" Placeholder="搜索实际供应商"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="2" PlaceholderText="进水管" Text="{Binding Header.InletHoseType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="4" PlaceholderText="起泡器" Text="{Binding Header.AeratorType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="6" PlaceholderText="托盘" Text="{Binding Header.PalletType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="8" PlaceholderText="币种" Text="{Binding Header.Currency,Mode=OneWay}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="10" PlaceholderText="包装商务要求" Text="{Binding Header.PackagingRequirements,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>



                        <TextBlock Grid.Column="12" Grid.Row="0" Text="内盒"/>
                        <TextBlock Grid.Column="12" Grid.Row="2" Text="标贴" />
                        <TextBlock Grid.Column="12" Grid.Row="4" Text="说明书"/>
                        <TextBlock Grid.Column="12" Grid.Row="6" Text="外箱"/>
                        <TextBlock Grid.Column="12" Grid.Row="8" Text="折扣备注"/>

                        <ui:TextBox Grid.Column="14" Grid.Row="0" PlaceholderText="内盒" Text="{Binding Header.BoxType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="2" PlaceholderText="标贴" Text="{Binding Header.LabelType}" IsReadOnly="True" />
                        <ui:TextBox Grid.Column="14" Grid.Row="4" PlaceholderText="说明书" Text="{Binding Header.InstructionManualType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="6" PlaceholderText="外箱" Text="{Binding Header.CartonType}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="8" Grid.RowSpan="3"
                                    PlaceholderText="折扣备注"
                                    Text="{Binding Header.DiscountRemark,UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding Header.CanEditDraft}" AcceptsReturn="True"/>

                        <TextBlock Grid.Column="16" Grid.RowSpan="7" Text="光标"/>
                        <TextBlock Grid.Column="16" Grid.Row="8" Text="文件地址"/>

                        <ui:TextBox Grid.Column="18" Grid.RowSpan="7"
                                    ClearButtonEnabled="False"
                                    FontWeight="Bold" FontSize="25"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding Header.LogoType}" IsReadOnly="True"/>

                        <ui:TextBox Grid.Column="18" Grid.Row="8" Grid.RowSpan="3"
                                    PlaceholderText="采购订单文件夹地址"
                                    Text="{Binding Header.PurchaseOrderFolder,Mode=OneWay}"
                                    IsReadOnly="True"/>


                    </Grid>
                </Border>

                <!--采购行-->
                <TabControl Grid.Row="4" SelectedIndex="{Binding SelectedDetailTabIndex}">
                    <TabItem Header="采购行">
                        <Grid RowDefinitions="Auto,4,*">
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Content="新增采购行" Command="{Binding AddLineCommand}" Margin="0,0,4,0"/>
                                <Button Content="删除新增行" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding Lines.SelectedItem}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Lines.Items}"
                                  SelectedItem="{Binding Lines.SelectedItem}"
                                  AutoGenerateColumns="False"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  gridCore:EnterpriseGrid.IsEnabled="True"
                                  gridCore:GridVirtualization.IsEnabled="True"
                                  gridOperations:GridOperations.IsEnabled="True"
                                  gridOperations:DataGridLineReorder.IsEnabled="{Binding IsCreateMode}"
                                  gridOperations:DataGridLineReorder.MoveUpCommand="{Binding MoveLineUpCommand}"
                                  gridOperations:DataGridLineReorder.MoveDownCommand="{Binding MoveLineDownCommand}"
                                  gridOperations:DataGridLineReorder.ShowWhenReadOnly="False"
                                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                                  gridSelection:GridSelection.CurrentRow="{Binding Lines.SelectedItem,Mode=TwoWay}"
                                  gridValidation:GridValidation.IsEnabled="True">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource SwiftExportDataGrid}">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Header.CanEditDraft}" Value="True">
                                                <Setter Property="IsReadOnly" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                                <Setter Property="IsReadOnly" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                        Header="行号" 
                                        Binding="{Binding LineNumber}" 
                                        Width="55" 
                                        gridColumns:GridColumn.Key="line-number"
                                        gridColumns:GridColumn.FieldPath="LineNumber"
                                        IsReadOnly="True"/>

                                    <DataGridTemplateColumn Header="图片" Width="64" gridColumns:GridColumn.Key="image">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:CachedImage Width="52" Height="52" Style="{StaticResource SwiftExportCachedImage}" SourcePath="{Binding MainImage}" DecodePixelWidth="96" Stretch="Uniform"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="SKU" Width="155" gridColumns:GridColumn.Key="sku">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <purchaseComponents:PurchaseProductLookupTextBox x:Name="ProductLookup"
                                                    Text="{Binding Sku,Mode=OneWay}"
                                                    FontSize="10"
                                                    ItemsSource="{Binding DataContext.ProductCandidates,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectedProduct="{Binding DataContext.SelectedProductCandidate,RelativeSource={RelativeSource AncestorType=DataGrid},Mode=OneWayToSource}"
                                                    SearchCommand="{Binding DataContext.SearchProductsCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommand="{Binding DataContext.CommitProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommandParameter="{Binding}"
                                                    SelectionClearedCommand="{Binding DataContext.ClearProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionClearedCommandParameter="{Binding}"
                                                    IsBusy="{Binding DataContext.IsProductSearchBusy,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    IsEnabled="{Binding IsNew}" Placeholder="搜索采购产品"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客户型号" Binding="{Binding CustomerSku}"
                                                        Width="105"
                                                        gridColumns:GridColumn.Key="customer-sku"
                                                        gridColumns:GridColumn.FieldPath="CustomerSku"
                                                        IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="关联型号" Binding="{Binding LinkSku}"
                                                        Width="110"
                                                        gridColumns:GridColumn.Key="link-sku"
                                                        gridColumns:GridColumn.FieldPath="LinkSku"
                                                        IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="供应商型号"
                                                    Binding="{Binding SupplierSku,UpdateSourceTrigger=PropertyChanged}"
                                                    gridColumns:GridColumn.Key="supplier-sku"
                                                    gridColumns:GridColumn.FieldPath="SupplierSku"
                                                    Width="120"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="中文描述"
                                                    Binding="{Binding DescriptionZh,UpdateSourceTrigger=PropertyChanged}"
                                                    gridColumns:GridColumn.Key="description-zh"
                                                    gridColumns:GridColumn.FieldPath="DescriptionZh"
                                                    Width="180"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="表面处理"
                                                    Binding="{Binding FinishZh}"
                                                    gridColumns:GridColumn.Key="finish-zh"
                                                    gridColumns:GridColumn.FieldPath="FinishZh"
                                                    Width="110"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="配置" Binding="{Binding FeaturesZh}"
                                                    gridColumns:GridColumn.Key="features-zh"
                                                    gridColumns:GridColumn.FieldPath="FeaturesZh"
                                                    Width="130"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="物料类型" Binding="{Binding MaterialType}"
                                                    gridColumns:GridColumn.Key="material-type"
                                                    gridColumns:GridColumn.FieldPath="MaterialType"
                                                    Width="80"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="供货方式"
                                                    Binding="{Binding SupplyType}"
                                                    gridColumns:GridColumn.Key="supply-type"
                                                    gridColumns:GridColumn.FieldPath="SupplyType"
                                                    Width="80"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="产品单位" Binding="{Binding UnitSnapshot}" Width="80"
                                                        gridColumns:GridColumn.Key="unit" gridColumns:GridColumn.FieldPath="UnitSnapshot" IsReadOnly="True"/>

                                    <DataGridTemplateColumn Header="数量" Width="85"
                                                            gridColumns:GridColumn.Key="quantity" gridColumns:GridColumn.FieldPath="Quantity">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Quantity,StringFormat=N1}"/>
                                                    <TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="未税单价"
                                                    Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged,StringFormat=N4}"
                                                    gridColumns:GridColumn.Key="unit-price"
                                                    gridColumns:GridColumn.FieldPath="UnitPrice"
                                                    Width="85"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="未税总价"
                                                    Binding="{Binding UnitAmount,StringFormat=N2}"
                                                    gridColumns:GridColumn.Key="unit-amount"
                                                    gridColumns:GridColumn.FieldPath="UnitAmount"
                                                     Width="95"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="计划交期"
                                                    Binding="{Binding PlannedDeliveryDate,UpdateSourceTrigger=PropertyChanged,StringFormat=yyyy-MM-dd}"
                                                    gridColumns:GridColumn.Key="planned-delivery-date"
                                                    gridColumns:GridColumn.FieldPath="PlannedDeliveryDate"
                                                    Width="105"/>

                                    <DataGridTemplateColumn Header="收货目标" Width="150"
                                                            gridColumns:GridColumn.Key="warehouse-target" gridColumns:GridColumn.FieldPath="WarehouseSiteId">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding WarehouseName}"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.WarehouseCandidates,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="送至供应商" Width="150"
                                                            gridColumns:GridColumn.Key="delivery-supplier" gridColumns:GridColumn.FieldPath="DeliverySupplierId">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DeliverySupplierName}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <purchaseComponents:PurchaseSupplierLookupTextBox Text="{Binding DeliverySupplierName,Mode=OneWay}"
                                                    ItemsSource="{Binding DataContext.DeliverySupplierCandidates,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedSupplier="{Binding DeliverySupplier,Mode=TwoWay}"
                                                    SearchCommand="{Binding DataContext.SearchDeliverySuppliersCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectionCommittedCommand="{Binding DataContext.CommitDeliverySupplierCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectionCommittedCommandParameter="{Binding}"
                                                    SelectionClearedCommand="{Binding DataContext.ClearDeliverySupplierCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectionClearedCommandParameter="{Binding}"
                                                    IsBusy="{Binding DataContext.IsDeliverySupplierSearchBusy,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding RequiresDeliverySupplier}" Placeholder="搜索送达供应商"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="来源单/行"
                                                    Binding="{Binding SourceSummary}"
                                                    gridColumns:GridColumn.Key="source-summary"
                                                    gridColumns:GridColumn.FieldPath="SourceSummary"
                                                    Width="120"
                                                    IsReadOnly="True"/>

                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="备注"
                                                    Binding="{Binding SubNote,UpdateSourceTrigger=PropertyChanged}"
                                                    gridColumns:GridColumn.Key="note"
                                                    gridColumns:GridColumn.FieldPath="SubNote"
                                                    Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="确认消耗绑定">
                        <TabItem.Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConfirmationBindings}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <Grid RowDefinitions="Auto,4,*" Margin="4">
                            <TextBlock Text="确认时仅为客供件完整 BOM 路径选择消耗仓；它不等于采购行收货目标。" Foreground="DarkOrange"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding ConfirmationBindings}" AutoGenerateColumns="False" Style="{StaticResource SwiftExportDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="52" gridColumns:GridColumn.Key="reversal-selected"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="BOM 路径" Binding="{Binding Path}" IsReadOnly="True" Width="2*"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客供件" Binding="{Binding ComponentSku}" IsReadOnly="True" Width="140"/>
                                    <DataGridTemplateColumn Header="消耗仓库" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.WarehouseCandidates,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <!--信息提示-->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel>
                <TextBlock Text="{Binding Header.LineCount,StringFormat=产品行数：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.TotalQty,StringFormat=订单数量：{0:N4}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.TotalAmount,StringFormat=人民币总额：{0:N2}}" Margin="0,0,16,0"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="创建："/>
                <TextBlock Text="{Binding Header.CreatedBy}"/>
                <TextBlock Text="{Binding Header.CreatedDate,StringFormat= yyyy-MM-dd HH:mm}" Margin="0,0,12,0"/>
                <TextBlock Text="更新："/>
                <TextBlock Text="{Binding Header.UpdatedBy}"/>
                <TextBlock Text="{Binding Header.UpdatedDate,StringFormat= yyyy-MM-dd HH:mm}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
