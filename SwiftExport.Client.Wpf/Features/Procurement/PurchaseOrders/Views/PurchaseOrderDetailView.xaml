<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--title-->
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="保存草稿" Command="{Binding SaveCommand}" Margin="0,0,4,0"/>
                <Button Content="确认" Command="{Binding ConfirmCommand}" Margin="0,0,4,0"/>
                <Button Content="取消确认" Command="{Binding CancelConfirmationCommand}" Margin="0,0,4,0"/>
                <Button Content="Trace" Command="{Binding OpenTraceCommand}" Margin="0,0,4,0"/>
                <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,4,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,4,0"/>
                <Button Content="关闭" Command="{Binding CloseDocumentCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Header.OrderNo}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Header.OrderStatusText}" Foreground="DarkSlateBlue"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="2">
            <Grid RowDefinitions="Auto,4,Auto,4,*,4">
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>

                <Border Grid.Row="0"                        
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="系统单号"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="0" PlaceholderText="采购单号" Text="{Binding Header.OrderNo,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="4" Grid.Row="0" Text="来源单号"/>
                        <ui:TextBox Grid.Column="6" Grid.Row="0" PlaceholderText="来源单号" Text="{Binding Header.SourceNo,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="8" Grid.Row="0" Text="状态"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="0" PlaceholderText="确认/生命周期" Text="{Binding Header.ConfirmationStatus}" IsReadOnly="True" ToolTip="生命周期在采购单状态中组合展示"/>

                        <TextBlock Grid.Column="12" Grid.Row="0" Text="预计交期"/>
                        <DatePicker Grid.Column="14" Grid.Row="0" controls:DatePickerAssist.PlaceholderText="预计交期" SelectedDate="{Binding Header.ExpectedDate,Mode=OneWay}" IsEnabled="False"/>

                        <TextBlock Grid.Column="16" Grid.Row="0" Text="确认信息"/>
                        <ui:TextBox Grid.Column="18" Grid.Row="0" PlaceholderText="确认信息" Text="{Binding Header.ConfirmedBy}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="20" Grid.Row="0" Text="确认时间"/>
                        <ui:TextBox Grid.Column="22" Grid.Row="0" PlaceholderText="确认时间" Text="{Binding Header.ConfirmedDate,StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True"/>


                        <TextBlock Grid.Column="24" Grid.Row="0" Text="复核人"/>
                        <ui:TextBox Grid.Column="26" Grid.Row="0" PlaceholderText="复核人" Text="{Binding Header.ReviewedBy,Mode=OneWay}" IsReadOnly="True"/>

                        <TextBlock Grid.Column="28" Grid.Row="0" Text="取消确认原因"/>
                        <ui:TextBox Grid.Column="30" Grid.Row="0" PlaceholderText="取消确认原因" Text="{Binding CancellationReason,UpdateSourceTrigger=PropertyChanged}"/>


                    </Grid>
                </Border>
                <!--订单头-->
                <Border Grid.Row="2" 
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource SwiftExportBrush.Border}" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Border.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="客户代码"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="客户PO号"/>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="采购单号"/>
                        <TextBlock Grid.Column="0" Grid.Row="6" Text="业务员"/>
                        <TextBlock Grid.Column="0" Grid.Row="8" Text="特殊要求"/>

                        <ui:TextBox Grid.Column="2" Grid.Row="0" PlaceholderText="客户代码" Text="{Binding Header.CustomerCode,Mode=OneWay}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="2" PlaceholderText="客户PO号" Text="{Binding Header.CustomerPoNo,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="4" PlaceholderText="可重复可修改采购单号" Text="{Binding Header.BoNo,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}" />
                        <ui:TextBox Grid.Column="2" Grid.Row="6" PlaceholderText="业务员" Text="{Binding Header.SalesPerson,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="2" Grid.Row="8" PlaceholderText="特殊要求" 
                                    Grid.RowSpan="3" Grid.ColumnSpan="5" 
                                    Text="{Binding Header.Remark,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}" AcceptsReturn="True" MinHeight="56"/>

                        <TextBlock Grid.Column="4" Grid.Row="0" Text="下单日期"/>
                        <TextBlock Grid.Column="4" Grid.Row="2" Text="期望交期"/>
                        <TextBlock Grid.Column="4" Grid.Row="4" Text="回复交期"/>
                        <TextBlock Grid.Column="4" Grid.Row="6" Text="跟单员"/>

                        <DatePicker Grid.Column="6" Grid.Row="0" controls:DatePickerAssist.PlaceholderText="下单日期" SelectedDate="{Binding Header.OrderDate,Mode=OneWay}" IsEnabled="False"/>
                        <ui:TextBox Grid.Column="6" Grid.Row="2" PlaceholderText="期望交期"/>
                        <DatePicker Grid.Column="6" Grid.Row="4" controls:DatePickerAssist.PlaceholderText="回复交期" SelectedDate="{Binding Header.ReplyDate,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="6" Grid.Row="6" PlaceholderText="跟单员" Text="{Binding Header.PurchasePerson,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>

                        <TextBlock Grid.Column="8" Grid.Row="0" Text="供应商"/>
                        <TextBlock Grid.Column="8" Grid.Row="2" Text="进水管"/>
                        <TextBlock Grid.Column="8" Grid.Row="4" Text="起跑器"/>
                        <TextBlock Grid.Column="8" Grid.Row="6" Text="托盘"/>
                        <TextBlock Grid.Column="8" Grid.Row="8" Text="币种"/>
                        <TextBlock Grid.Column="8" Grid.Row="10" Text="折扣"/>


                        <ui:TextBox Grid.Column="10" Grid.Row="0" PlaceholderText="供应商" Text="{Binding Header.SupplierName,Mode=OneWay}" IsReadOnly="True"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="2" PlaceholderText="进水管" Text="{Binding Header.InletHoseType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="4" PlaceholderText="起跑器" Text="{Binding Header.AeratorType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="6" PlaceholderText="托盘"  Text="{Binding Header.PalletType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="10" Grid.Row="8" PlaceholderText="币种" Text="{Binding Header.Currency,Mode=OneWay}" IsReadOnly="True"/>



                        <TextBlock Grid.Column="12" Grid.Row="0" Text="内盒"/>
                        <TextBlock Grid.Column="12" Grid.Row="2" Text="标贴" />
                        <TextBlock Grid.Column="12" Grid.Row="4" Text="说明书"/>
                        <TextBlock Grid.Column="12" Grid.Row="6" Text="外箱"/>
                        <TextBlock Grid.Column="12" Grid.Row="8" Text="折扣备注"/>

                        <ui:TextBox Grid.Column="14" Grid.Row="0" PlaceholderText="内盒" Text="{Binding Header.BoxType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="2" PlaceholderText="标贴" Text="{Binding Header.LabelType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}" />
                        <ui:TextBox Grid.Column="14" Grid.Row="4" PlaceholderText="说明书" Text="{Binding Header.InstructionManualType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="6" PlaceholderText="外箱" Text="{Binding Header.CartonType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>
                        <ui:TextBox Grid.Column="14" Grid.Row="8" Grid.RowSpan="3"
                                    PlaceholderText="折扣备注" 
                                    Text="{Binding Header.DiscountRemark,UpdateSourceTrigger=PropertyChanged}" 
                                    IsEnabled="{Binding Header.CanEditDraft}" AcceptsReturn="True"/>

                        <TextBlock Grid.Column="16" Grid.RowSpan="7" Text="光标"/>
                        <TextBlock Grid.Column="16" Grid.Row="8" Text="文件地址"/>

                        <ui:TextBox Grid.Column="18" Grid.RowSpan="7"
                                    ClearButtonEnabled="False"
                                    FontWeight="Bold" FontSize="25"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding Header.LogoType,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Header.CanEditDraft}"/>

                        <ui:TextBox Grid.Column="18" Grid.Row="8" Grid.RowSpan="3"
                                    PlaceholderText="采购订单文件夹地址" 
                                    Text="{Binding Header.PurchaseOrderFolder,Mode=OneWay}" 
                                    IsReadOnly="True"/>


                    </Grid>
                </Border>

                <!--采购行-->
                <TabControl Grid.Row="4">
                    <TabItem Header="采购行">
                        <DataGrid ItemsSource="{Binding Lines}" 
                                  SelectedItem="{Binding SelectedLine}" 
                                  AutoGenerateColumns="False"
                                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                                  gridCore:GridRowHeader.ShowRowNumber="True"
                                  gridCore:EnterpriseGrid.IsEnabled="True" 
                                  gridCore:GridVirtualization.IsEnabled="True" 
                                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine,Mode=TwoWay}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource SwiftExportDataGrid}">
                                    <Setter Property="IsReadOnly" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Header.CanEditDraft}" Value="True">
                                            <Setter Property="IsReadOnly" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="42" IsReadOnly="True" Visibility="Collapsed"/>

                                <DataGridTemplateColumn Header="图片" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CachedImage Width="52" Height="52" Style="{StaticResource SwiftExportCachedImage}" SourcePath="{Binding MainImage}" DecodePixelWidth="96" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="客户型号" Binding="{Binding CustomerSku}" Width="105" IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="SKU" Binding="{Binding Sku}" Width="130" IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="关联型号" Binding="{Binding LinkSku}" Width="110" IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="供应商型号" 
                                                    Binding="{Binding SupplierSku,UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="120"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="中文描述" 
                                                    Binding="{Binding DescriptionZh,UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="180"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="表面处理" 
                                                    Binding="{Binding FinishZh}" 
                                                    Width="110" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="配置" Binding="{Binding FeaturesZh}" 
                                                    Width="130" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="物料类型" Binding="{Binding MaterialType}" 
                                                    Width="80" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="供货方式" 
                                                    Binding="{Binding SupplyType}" 
                                                    Width="80" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    Header="数量" 
                                                    Binding="{Binding Quantity,StringFormat=N1}" 
                                                    Width="85" 
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                     Header="未收货" 
                                                    Binding="{Binding UnreceivedQtyText}" Width="85" IsReadOnly="True"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                     Header="已备好" 
                                                    Binding="{Binding LatestReadyQtyText}" Width="95" IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="最新安排" 
                                                    Binding="{Binding LatestArrangementText}" Width="95" IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                                     Header="计划交期" 
                                                    Binding="{Binding PlannedDeliveryDate,UpdateSourceTrigger=PropertyChanged,StringFormat=yyyy-MM-dd}" 
                                                    Width="105"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                                     Header="预计备妥" 
                                                    Binding="{Binding LatestExpectedReadyDateText}" 
                                                    Width="105" 
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                                     Header="最近跟进" Binding="{Binding LatestFollowUpDateText}" 
                                                    Width="130" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="跟单员" Binding="{Binding LatestFollowUpUserText}" 
                                                    Width="95" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                     Header="未税价" 
                                                    Binding="{Binding UnitPrice,UpdateSourceTrigger=PropertyChanged,StringFormat=N4}" 
                                                    Width="85"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    Header="含税价" 
                                                    Binding="{Binding TaxPrice,UpdateSourceTrigger=PropertyChanged,StringFormat=N4}" 
                                                    Width="85"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                     Header="未税金额" 
                                                    Binding="{Binding UnitAmount,StringFormat=N2}" 
                                                    Width="95" 
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                     Header="含税金额" 
                                                    Binding="{Binding TaxAmount,StringFormat=N2}" 
                                                    Width="95" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                     Header="送达供应商" 
                                                    Binding="{Binding DeliverySupplierName}" 
                                                    Width="130" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="来源单/行" 
                                                    Binding="{Binding SourceSummary}" 
                                                    Width="120" 
                                                    IsReadOnly="True"/>
                                
                                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    Header="备注" 
                                                    Binding="{Binding SubNote,UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="来源贡献">
                        <DataGrid ItemsSource="{Binding SelectedLine.Contributions}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="140"/>
                                <DataGridTextColumn Header="来源行" Binding="{Binding SourceLineNumber}" Width="70"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                                <DataGridTextColumn Header="有效贡献" Binding="{Binding EffectiveQty,StringFormat=N4}" Width="100"/>
                                <DataGridTextColumn Header="原需求交期" Binding="{Binding DemandRequiredDate,StringFormat=yyyy-MM-dd}" Width="110"/>
                                <DataGridTextColumn Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="入库记录">
                        <Grid Margin="8">
                            <TextBlock Text="入库模块尚未接入" Foreground="DarkOrange" FontWeight="SemiBold"/>
                            <DataGrid Margin="0,28,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="入库单号" Width="160"/>
                                    <DataGridTextColumn Header="入库日期" Width="140"/>
                                    <DataGridTextColumn Header="SKU" Width="120"/>
                                    <DataGridTextColumn Header="数量" Width="90"/>
                                    <DataGridTextColumn Header="备注" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="业务操作记录">
                        <DataGrid ItemsSource="{Binding Operations}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="135"/>
                                <DataGridTextColumn Header="操作" Binding="{Binding OperationName}" Width="160"/>
                                <DataGridTextColumn Header="操作人" Binding="{Binding UserName}" Width="100"/>
                                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="160"/>
                                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <!--信息提示-->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel>
                <TextBlock Text="{Binding Header.LineCount,StringFormat=产品行数：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.TotalQty,StringFormat=订单数量：{0:N4}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.TotalAmount,StringFormat=人民币总额：{0:N2}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.UsdTotalText,StringFormat=USD总额：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.CartonTotalText,StringFormat=总箱数：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.CbmTotalText,StringFormat=总CBM：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.InboundStatusText,StringFormat=已入库：{0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Header.ShippedStatusText,StringFormat=最终已发货：{0}}"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="创建："/>
                <TextBlock Text="{Binding Header.CreatedBy}"/>
                <TextBlock Text="{Binding Header.CreatedDate,StringFormat= yyyy-MM-dd HH:mm}" Margin="0,0,12,0"/>
                <TextBlock Text="更新："/>
                <TextBlock Text="{Binding Header.UpdatedBy}"/>
                <TextBlock Text="{Binding Header.UpdatedDate,StringFormat= yyyy-MM-dd HH:mm}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
