<UserControl
  x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderManagerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
  xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
  xmlns:vm="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels"
  xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
  xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
  <UserControl.Resources>
    <DataTemplate
      x:Key="PurchaseStateChoice">
      <TextBlock
        Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid
    Margin="12"
    RowDefinitions="Auto,Auto,Auto,*">
    <WrapPanel
      Margin="0,0,0,8">
      <TextBlock
        Text="采购订单管理"
        Style="{StaticResource SubtitleTextBlock}"
        Margin="0,0,16,4"
        VerticalAlignment="Center" />
      <Button
        Content="从物料需求创建"
        Command="{Binding GetFromNetDemandCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="新建无关联采购"
        Command="{Binding CreateIndependentCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="确认"
        Command="{Binding ConfirmCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="批量确认"
        Command="{Binding BatchConfirmCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="取消确认"
        ToolTip="取消确认保留需求承接，不释放需求贡献。"
        Command="{Binding CancelConfirmationCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="删除整张草稿"
        Command="{Binding DeleteDraftCommand}"
        ToolTip="{Binding SelectedOrder.DeleteDraftBlockReason}"
        Margin="0,0,8,4" />
      <Button
        Content="整单作废"
        Command="{Binding VoidOrderCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="重试原提交"
        Command="{Binding RetryPendingCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="重试原反向操作"
        Command="{Binding RetryReversalCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="核实/刷新"
        Command="{Binding RefreshCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="采购跟进"
        Command="{Binding OpenFollowUpCommand}"
        Margin="0,0,8,4" />
      <Button
        Content="采购追溯"
        Command="{Binding OpenTraceCommand}"
        Margin="0,0,8,4" />
    </WrapPanel>
    <StackPanel
      Grid.Row="1"
      Margin="0,0,0,8">
      <WrapPanel>
        <ui:TextBox
          Width="260"
          PlaceholderText="采购单号、来源单号、SKU 等关键词"
          Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
          AutomationProperties.Name="采购查询关键词"
          Margin="0,0,8,4">
          <ui:TextBox.InputBindings>
            <KeyBinding
              Key="Enter"
              Command="{Binding SearchCommand}" />
          </ui:TextBox.InputBindings>
        </ui:TextBox>
        <lookup:MultiSelectLookupButton
          Header="客户"
          Placeholder="客户"
          MinWidth="130"
          DisplayMemberPath="CustomerCode"
          FilterMemberPaths="CustomerCode,CustomerName"
          SelectedValuePath="Uid"
          ItemsSource="{Binding CustomerOptions}"
          SelectedItems="{Binding SelectedCustomers, Mode=OneWay}"
          Margin="0,0,8,4"
          AutomationProperties.Name="采购客户多选" />
        <lookup:MultiSelectLookupButton
          Header="供应商"
          Placeholder="供应商"
          MinWidth="130"
          DisplayMemberPath="SupplierName"
          FilterMemberPaths="SupplierCode,SupplierName"
          SelectedValuePath="Uid"
          ItemsSource="{Binding SupplierOptions}"
          SelectedItems="{Binding SelectedSuppliers, Mode=OneWay}"
          Margin="0,0,8,4"
          AutomationProperties.Name="采购供应商多选" />
        <lookup:MultiSelectLookupButton
          Header="确认状态"
          Placeholder="确认状态"
          ItemTemplate="{StaticResource PurchaseStateChoice}"
          ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.ConfirmationStatuses}"
          SelectedItems="{Binding SelectedConfirmationStatuses, Mode=OneWay}"
          MinWidth="112"
          Margin="0,0,8,4" />
        <lookup:MultiSelectLookupButton
          Header="生命周期"
          Placeholder="生命周期"
          ItemTemplate="{StaticResource PurchaseStateChoice}"
          ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.LifecycleStatuses}"
          SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}"
          MinWidth="112"
          Margin="0,0,8,4" />
        <lookup:MultiSelectLookupButton
          Header="货好状态"
          Placeholder="货好状态"
          ItemTemplate="{StaticResource PurchaseStateChoice}"
          ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.ReadyStatuses}"
          SelectedItems="{Binding SelectedReadyStatuses, Mode=OneWay}"
          MinWidth="112"
          Margin="0,0,8,4" />
        <lookup:MultiSelectLookupButton
          Header="收货状态"
          Placeholder="收货状态"
          ItemTemplate="{StaticResource PurchaseStateChoice}"
          ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.ReceiptStatuses}"
          SelectedItems="{Binding SelectedReceiptStatuses, Mode=OneWay}"
          MinWidth="112"
          Margin="0,0,8,4" />
        <ComboBox
          Width="140"
          ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.DueViews}"
          SelectedItem="{Binding SelectedDueView}"
          ItemTemplate="{StaticResource PurchaseStateChoice}"
          AutomationProperties.Name="采购交期风险"
          Margin="0,0,8,4" />
        <ToggleButton
          x:Name="OptionsToggleButton"
          Content="更多条件"
          IsChecked="{Binding IsMoreFiltersOpen, Mode=TwoWay}"
          Margin="0,0,8,4" />
        <Button
          Content="查询"
          Command="{Binding SearchCommand}"
          Margin="0,0,8,4" />
        <Button
          Content="清空条件并查询"
          Command="{Binding ClearFiltersCommand}"
          Margin="0,0,8,4" />
      </WrapPanel>
      <Popup
        IsOpen="{Binding IsMoreFiltersOpen, Mode=TwoWay}"
        Placement="Bottom"
        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
        Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
        VerticalOffset="4"
        AllowsTransparency="True"
        StaysOpen="True">
        <Border
          Padding="12"
          Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4">
          <StackPanel>
            <TextBlock
              Text="更多条件 · 应用后查询，收起保留输入。"
              Margin="0,0,0,8" />
            <Grid
              ColumnDefinitions="Auto,136,Auto,136"
              RowDefinitions="Auto,Auto,Auto">
              <TextBlock
                Text="订单日期起"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Column="1"
                SelectedDate="{Binding OrderDateFrom}"
                Margin="0,0,8,8" />
              <TextBlock
                Grid.Column="2"
                Text="至"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Column="3"
                SelectedDate="{Binding OrderDateTo}"
                Margin="0,0,0,8" />
              <TextBlock
                Grid.Row="1"
                Text="计划交期起"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Row="1"
                Grid.Column="1"
                SelectedDate="{Binding PlannedDeliveryDateFrom}"
                Margin="0,0,8,8" />
              <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Text="至"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Row="1"
                Grid.Column="3"
                SelectedDate="{Binding PlannedDeliveryDateTo}"
                Margin="0,0,0,8" />
              <TextBlock
                Grid.Row="2"
                Text="预计完成起"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Row="2"
                Grid.Column="1"
                SelectedDate="{Binding ExpectedCompletionDateFrom}"
                Margin="0,0,8,8" />
              <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                Text="至"
                Margin="0,0,8,8" />
              <DatePicker
                Grid.Row="2"
                Grid.Column="3"
                SelectedDate="{Binding ExpectedCompletionDateTo}"
                Margin="0,0,0,8" />
            </Grid>
            <WrapPanel>
              <Button
                Content="应用"
                Command="{Binding ApplyMoreFiltersCommand}"
                Margin="0,0,8,0" />
              <Button
                Content="清除更多条件"
                Command="{Binding ClearMoreFiltersCommand}"
                Margin="0,0,8,0" />
              <Button
                Content="收起"
                Command="{Binding CollapseMoreFiltersCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Popup>
    </StackPanel>
    <TextBlock
      Grid.Row="2"
      Text="修改筛选后点击查询；翻页和刷新使用已应用条件。表头筛选仅作用于当前加载数据，批量确认仅处理可见勾选行。"
      TextWrapping="Wrap"
      Margin="0,0,0,8" />
    <Grid
      Grid.Row="3"
      RowDefinitions="4*,8,4*">
      <Grid
        RowDefinitions="*,Auto">
        <DataGrid
          ItemsSource="{Binding Orders}"
          SelectedItem="{Binding SelectedOrder}"
          PreviewMouseDoubleClick="OnOrdersPreviewMouseDoubleClick"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          RowHeight="{StaticResource DataGridRowHeightSmall}"
          FontSize="{StaticResource SwiftExportDefaltFontSize}"
          Style="{StaticResource SwiftExportDataGrid}"
          gridCore:GridRowHeader.ShowRowNumber="True"
          x:Name="OrdersGrid"
          SelectionUnit="FullRow"
          SelectionMode="Extended"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
          dgx:DataGridFilter.IsAutoFilterEnabled="True"
          PreviewMouseRightButtonDown="OnGridRightClick"
          Tag="{Binding}"
          Loaded="OnOrdersLoaded"
          Unloaded="OnOrdersUnloaded">
          <i:Interaction.Behaviors>
            <gridCore:DataGridColumnVisibilityBehavior />
          </i:Interaction.Behaviors>
          <DataGrid.ContextMenu>
            <ContextMenu
              DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
              <MenuItem
                Header="打开采购详情"
                Command="{Binding OpenDetailCommand}" />
              <MenuItem
                Header="采购追溯"
                Command="{Binding OpenTraceCommand}" />
              <MenuItem
                Header="确认采购"
                Command="{Binding ConfirmCommand}" />
              <MenuItem
                Header="重试原提交"
                Command="{Binding RetryPendingCommand}" />
              <MenuItem
                Header="复制所选行"
                Command="{x:Static ApplicationCommands.Copy}"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
              Width="45"
              CanUserSort="False"
              HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}"
              dgx:DataGridFilterColumn.IsFilterVisible="False">
              <DataGridTemplateColumn.HeaderTemplate>
                <DataTemplate>
                  <CheckBox
                    IsThreeState="False"
                    IsChecked="{Binding DataContext.IsAllCurrentPageChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    ToolTip="全选或清除当前可见采购单"
                    AutomationProperties.Name="全选或清除当前可见采购单" />
                </DataTemplate>
              </DataGridTemplateColumn.HeaderTemplate>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    ToolTip="{Binding BatchConfirmationStatus}"
                    AutomationProperties.Name="{Binding OrderNo, StringFormat=选择采购单 {0}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="单据状态"
              Binding="{Binding LifecycleStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="采购单号"
              Binding="{Binding OrderNo}"
              Width="145"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="自定义采购单号"
              Binding="{Binding BoNo}"
              Width="140"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="客户代码"
              Binding="{Binding CustomerCode}"
              Width="120"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="供应商"
              Binding="{Binding SupplierName}"
              Width="170"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="确认状态"
              Binding="{Binding ConfirmationStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="采购日期"
              Binding="{Binding OrderDate,StringFormat=yyyy-MM-dd}"
              Width="100"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="预计交期"
              Binding="{Binding ExpectedDate,StringFormat=yyyy-MM-dd}"
              Width="105"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="回复交期"
              Binding="{Binding ReplyDate,StringFormat=yyyy-MM-dd}"
              Width="105"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="行数"
              Binding="{Binding LineCount}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="货好状态"
              Binding="{Binding ReadyStatus,Converter={StaticResource EnumDescriptionConverter}}"
              Width="105"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="收货状态"
              Binding="{Binding ReceiptStatus,Converter={StaticResource EnumDescriptionConverter}}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="已知已备好合计"
              Binding="{Binding LatestReadyQty,StringFormat={}{0:0.####}}"
              Width="120"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="总数量"
              Binding="{Binding TotalQty,StringFormat=0.####, TargetNullValue=需核实}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="单位"
              Binding="{Binding UnitSnapshot}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="收货进度"
              Binding="{Binding ReceiptProgress}"
              Width="100"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="交期命中行"
              Binding="{Binding DueHitLineCount}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="最早命中交期"
              Binding="{Binding EarliestDueHitDate,StringFormat=yyyy-MM-dd}"
              Width="110"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              Header="未确认货好风险"
              Binding="{Binding ReadyRiskText}"
              Width="160"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="核实提示"
              Binding="{Binding ReviewReason}"
              Width="220"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="含税总金额"
              Binding="{Binding TaxTotalAmount,StringFormat=N2}"
              Width="110"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="已反馈行数"
              Binding="{Binding ReportedLineCount}"
              Width="90"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="预计完成"
              Binding="{Binding ExpectedCompletionDate,StringFormat=yyyy-MM-dd}"
              Width="105"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
          </DataGrid.Columns>
        </DataGrid>
        <Grid
          Grid.Row="1"
          ColumnDefinitions="Auto,12,*,Auto,12,Auto"
          Margin="0,8,0,0">
          <TextBlock
            Text="{Binding SelectionSummary}"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlock}" />
          <TextBlock
            Grid.Column="2"
            Text="{Binding ResultSummary}"
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlock}" />
          <TextBlock
            Grid.Column="3"
            Text="{Binding PageStatus}"
            Style="{StaticResource CaptionTextBlock}" />
          <controls:PageNavigator
            Grid.Column="5"
            TotalCount="{Binding TotalCount}"
            PageIndex="{Binding PageIndex}"
            PageSize="{Binding PageSize}"
            PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
      </Grid>
      <GridSplitter
        Grid.Row="1"
        Style="{StaticResource SwiftExportGridSplitterHorizontal}" />
      <Grid
        Grid.Row="2"
        RowDefinitions="Auto,8,*">
        <WrapPanel>
          <TextBlock
            Text="采购单：" />
          <TextBlock
            Text="{Binding SelectedOrder.OrderNo}"
            Margin="0,0,16,0" />
          <TextBlock
            Text="供应商：" />
          <TextBlock
            Text="{Binding SelectedOrder.SupplierName}"
            Margin="0,0,16,0" />
          <TextBlock
            Text="{Binding DetailStatusText}"
            TextWrapping="Wrap" />
        </WrapPanel>
        <DataGrid
          Grid.Row="2"
          ItemsSource="{Binding Lines}"
          SelectedItem="{Binding SelectedLine}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          RowHeight="{StaticResource DataGridRowHeightMedium}"
          FontSize="{StaticResource SwiftExportDefaltFontSize}"
          Style="{StaticResource SwiftExportDataGrid}"
          x:Name="LinesGrid"
          SelectionUnit="FullRow"
          SelectionMode="Extended"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
          dgx:DataGridFilter.IsAutoFilterEnabled="True"
          PreviewMouseRightButtonDown="OnGridRightClick"
          Tag="{Binding}">
          <i:Interaction.Behaviors>
            <gridCore:DataGridColumnVisibilityBehavior />
          </i:Interaction.Behaviors>
          <DataGrid.ContextMenu>
            <ContextMenu
              DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
              <MenuItem
                Header="查看采购及贡献追溯"
                Command="{Binding OpenTraceCommand}" />
              <MenuItem
                Header="复制所选行"
                Command="{x:Static ApplicationCommands.Copy}"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="行"
              Binding="{Binding LineNumber}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTemplateColumn
              Header="图片"
              Width="64"
              CanUserSort="False"
              dgx:DataGridFilterColumn.IsFilterVisible="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:CachedImage
                    Width="56"
                    Height="56"
                    Margin="2"
                    Style="{StaticResource SwiftExportCachedImage}"
                    SourcePath="{Binding MainImage}"
                    DecodePixelWidth="80"
                    Stretch="Uniform" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="客户型号"
              Binding="{Binding CustomerSku}"
              Width="105"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="物料编号"
              Binding="{Binding Sku}"
              Width="115"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="AQ/关联型号"
              Binding="{Binding LinkSku}"
              Width="115"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="供应商型号"
              Binding="{Binding SupplierSku}"
              Width="120"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="中文描述"
              Binding="{Binding DescriptionZh}"
              Width="180"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="表面处理"
              Binding="{Binding FinishZh}"
              Width="110"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="配置"
              Binding="{Binding FeaturesZh}"
              Width="130"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="物料类型"
              Binding="{Binding MaterialType}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="供货方式"
              Binding="{Binding SupplyType}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="数量"
              Binding="{Binding Quantity,StringFormat=0.####}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="单位"
              Binding="{Binding UnitSnapshot}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              Header="已收货"
              Binding="{Binding ReceivedQty, StringFormat=0.####, TargetNullValue=需核实}"
              Width="100"
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              Header="已关联量"
              Binding="{Binding LinkedDemandQtyText}"
              Width="108"
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              Header="未关联量"
              Binding="{Binding UnlinkedQtyText}"
              Width="108"
