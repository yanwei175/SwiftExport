<UserControl
    x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Procurement.PurchaseOrders.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="PurchaseStateChoice">
            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*">
        <WrapPanel Margin="0,0,0,8">
            <TextBlock
                Margin="0,0,16,4"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlock}"
                Text="采购订单管理" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding GetFromNetDemandCommand}"
                Content="从物料需求创建" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding CreateIndependentCommand}"
                Content="新建无关联采购" />
            <Button
                MinWidth="70"
                Margin="0,0,8,4"
                Command="{Binding ConfirmCommand}"
                Content="确认" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding BatchConfirmCommand}"
                Content="批量确认" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding CancelConfirmationCommand}"
                Content="取消确认"
                ToolTip="取消确认保留需求承接，不释放需求贡献。" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding DeleteDraftCommand}"
                Content="删除整张草稿"
                ToolTip="{Binding SelectedOrder.DeleteDraftBlockReason}" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding VoidOrderCommand}"
                Content="整单作废" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding RetryPendingCommand}"
                Content="重试原提交" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding RetryReversalCommand}"
                Content="重试原反向操作" />
            <Button
                Margin="0,0,8,4"
                Command="{Binding RefreshCommand}"
                Content="核实/刷新" />


        </WrapPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel>
                <ui:TextBox
                    Width="260"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="采购查询关键词"
                    PlaceholderText="采购单号、来源单号、SKU 等关键词"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <lookup:MultiSelectLookupButton
                    MinWidth="130"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="采购客户多选"
                    DisplayMemberPath="CustomerCode"
                    FilterMemberPaths="CustomerCode,CustomerName"
                    Header="客户"
                    ItemsSource="{Binding CustomerOptions}"
                    Placeholder="客户"
                    SelectedItems="{Binding SelectedCustomers, Mode=OneWay}"
                    SelectedValuePath="Uid" />
                <lookup:MultiSelectLookupButton
                    MinWidth="130"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="采购供应商多选"
                    DisplayMemberPath="SupplierName"
                    FilterMemberPaths="SupplierCode,SupplierName"
                    Header="供应商"
                    ItemsSource="{Binding SupplierOptions}"
                    Placeholder="供应商"
                    SelectedItems="{Binding SelectedSuppliers, Mode=OneWay}"
                    SelectedValuePath="Uid" />
                <lookup:MultiSelectLookupButton
                    MinWidth="112"
                    Margin="0,0,8,4"
                    Header="确认状态"
                    ItemTemplate="{StaticResource PurchaseStateChoice}"
                    ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.ConfirmationStatuses}"
                    Placeholder="确认状态"
                    SelectedItems="{Binding SelectedConfirmationStatuses, Mode=OneWay}" />
                <lookup:MultiSelectLookupButton
                    MinWidth="112"
                    Margin="0,0,8,4"
                    Header="生命周期"
                    ItemTemplate="{StaticResource PurchaseStateChoice}"
                    ItemsSource="{x:Static vm:PurchaseOrderManagerViewModel.LifecycleStatuses}"
                    Placeholder="生命周期"
                    SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" />



                <ToggleButton
                    x:Name="OptionsToggleButton"
                    Margin="0,0,8,4"
                    Content="更多条件"
                    IsChecked="{Binding IsMoreFiltersOpen, Mode=TwoWay}" />
                <Button
                    MinWidth="70"
                    Margin="0,0,8,4"
                    Command="{Binding SearchCommand}"
                    Content="查询" />
                <Button
                    Margin="0,0,8,4"
                    Command="{Binding ClearFiltersCommand}"
                    Content="清空条件并查询" />
            </WrapPanel>
            <Popup
                Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                AllowsTransparency="True"
                IsOpen="{Binding IsMoreFiltersOpen, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                StaysOpen="True"
                VerticalOffset="4">
                <Border
                    Padding="12"
                    Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Text="更多条件 · 应用后查询，收起保留输入。" />
                        <Grid ColumnDefinitions="Auto,136,Auto,136" RowDefinitions="Auto,Auto">
                            <TextBlock Margin="0,0,8,8" Text="订单日期起" />
                            <DatePicker
                                Grid.Column="1"
                                Margin="0,0,8,8"
                                SelectedDate="{Binding OrderDateFrom}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,8,8"
                                Text="至" />
                            <DatePicker
                                Grid.Column="3"
                                Margin="0,0,0,8"
                                SelectedDate="{Binding OrderDateTo}" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,0,8,8"
                                Text="计划交期起" />
                            <DatePicker
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,8,8"
                                SelectedDate="{Binding PlannedDeliveryDateFrom}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,8,8"
                                Text="至" />
                            <DatePicker
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,0,0,8"
                                SelectedDate="{Binding PlannedDeliveryDateTo}" />
                        </Grid>
                        <WrapPanel>
                            <Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding ApplyMoreFiltersCommand}"
                                Content="应用" />
                            <Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding ClearMoreFiltersCommand}"
                                Content="清除更多条件" />
                            <Button
                                MinWidth="70"
                                Command="{Binding CollapseMoreFiltersCommand}"
                                Content="收起" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            Text="修改筛选后点击查询；翻页和刷新使用已应用条件。表头筛选仅作用于当前加载数据，批量确认仅处理可见勾选行。"
            TextWrapping="Wrap" />
        <Grid Grid.Row="3" RowDefinitions="4*,8,4*">
            <Grid RowDefinitions="*,Auto">
                <DataGrid
                    x:Name="OrdersGrid"
                    dgx:DataGridFilter.IsAutoFilterEnabled="True"
                    gridCore:GridRowHeader.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    FontSize="{StaticResource SwiftExportDefaltFontSize}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Orders}"
                    Loaded="OnOrdersLoaded"
                    PreviewMouseDoubleClick="OnOrdersPreviewMouseDoubleClick"
                    PreviewMouseRightButtonDown="OnGridRightClick"
                    RowHeight="{StaticResource DataGridRowHeightSmall}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedOrder}"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Style="{StaticResource SwiftExportDataGrid}"
                    Tag="{Binding}"
                    Unloaded="OnOrdersUnloaded">
                    <i:Interaction.Behaviors>
                        <gridCore:DataGridColumnVisibilityBehavior />
                    </i:Interaction.Behaviors>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding OpenDetailCommand}" Header="打开采购详情" />
                            <MenuItem Command="{Binding OpenFeedbackCommand}" Header="登记/查看反馈" />

                            <MenuItem Command="{Binding ConfirmCommand}" Header="确认采购" />
                            <MenuItem Command="{Binding RetryPendingCommand}" Header="重试原提交" />
                            <MenuItem
                                Command="{x:Static ApplicationCommands.Copy}"
                                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="复制所选行" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="45"
                            dgx:DataGridFilterColumn.IsFilterVisible="False"
                            CanUserSort="False"
                            ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        AutomationProperties.Name="全选或清除当前可见采购单"
                                        IsChecked="{Binding DataContext.IsAllCurrentPageChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        IsThreeState="False"
                                        ToolTip="全选或清除当前可见采购单" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding OrderNo, StringFormat=选择采购单 {0}}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ToolTip="{Binding BatchConfirmationStatus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding LifecycleStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单据状态" />
                        <DataGridTextColumn
                            Width="145"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding OrderNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="采购单号" />
                        <DataGridTextColumn
                            Width="140"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding BoNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="自定义采购单号" />
                        <DataGridTextColumn
                            Width="120"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding CustomerCode}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户代码" />
                        <DataGridTextColumn
                            Width="170"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding SupplierName}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="供应商" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding ConfirmationStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="确认状态" />
                        <DataGridTextColumn
                            Width="100"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="采购日期" />
                        <DataGridTextColumn
                            Width="105"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding ExpectedDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="预计交期"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="105"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding ReplyDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="回复交期"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding LineCount}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="行数" />



                        <DataGridTextColumn
                            Width="95"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding TotalQty, StringFormat=0.####, TargetNullValue=需核实}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="总数量" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding UnitSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单位" />





                        <DataGridTextColumn
                            Width="110"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding TaxTotalAmount, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="含税总金额" />


                    </DataGrid.Columns>
                </DataGrid>

                <Grid
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    ColumnDefinitions="Auto,12,*,Auto,12,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding SelectionSummary}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding ResultSummary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding PageStatus}" />
                    <controls:PageNavigator
                        Grid.Column="5"
                        PageChangeCommand="{Binding PageChangeCommand}"
                        PageSize="{Binding PageSize}"
                        TotalCount="{Binding TotalCount}"
                        PageIndex="{Binding PageIndex}" />
                </Grid>
            </Grid>
            <GridSplitter Grid.Row="1" Style="{StaticResource SwiftExportGridSplitterHorizontal}" />
            <Grid Grid.Row="2" RowDefinitions="Auto,8,*">
                <WrapPanel>
                    <TextBlock Text="采购单：" />
                    <TextBlock Margin="0,0,16,0" Text="{Binding SelectedOrder.OrderNo}" />
                    <TextBlock Text="供应商：" />
                    <TextBlock Margin="0,0,16,0" Text="{Binding SelectedOrder.SupplierName}" />
                    <TextBlock Text="{Binding DetailStatusText}" TextWrapping="Wrap" />
                </WrapPanel>
                <DataGrid
                    x:Name="LinesGrid"
                    Grid.Row="2"
                    dgx:DataGridFilter.IsAutoFilterEnabled="True"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    FontSize="{StaticResource SwiftExportDefaltFontSize}"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Lines}"
                    Loaded="OnLinesLoaded"
                    PreviewMouseRightButtonDown="OnGridRightClick"
                    RowHeight="{StaticResource DataGridRowHeightMedium}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedLine}"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    Style="{StaticResource SwiftExportDataGrid}"
                    Tag="{Binding}"
                    Unloaded="OnLinesUnloaded">
                    <i:Interaction.Behaviors>
                        <gridCore:DataGridColumnVisibilityBehavior />
                    </i:Interaction.Behaviors>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">

                            <MenuItem
                                Command="{x:Static ApplicationCommands.Copy}"
                                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="复制所选行" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding LineNumber}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="行" />
                        <DataGridTemplateColumn
                            Width="64"
                            dgx:DataGridFilterColumn.IsFilterVisible="False"
                            CanUserSort="False"
                            Header="图片">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage
                                        Width="56"
                                        Height="56"
                                        Margin="2"
                                        DecodePixelWidth="80"
                                        SourcePath="{Binding MainImage}"
                                        Stretch="Uniform"
                                        Style="{StaticResource SwiftExportCachedImage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="105"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding CustomerSku}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户型号" />
                        <DataGridTextColumn
                            Width="115"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding Sku}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="物料编号" />
                        <DataGridTextColumn
                            Width="115"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding LinkSku}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="AQ/关联型号"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="120"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding SupplierSku}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="供应商型号" />
                        <DataGridTextColumn
                            Width="180"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding DescriptionZh}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="中文描述" />
                        <DataGridTextColumn
                            Width="110"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding FinishZh}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="表面处理"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="130"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding FeaturesZh}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="配置"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding MaterialType}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="物料类型"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding SupplyType}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="供货方式"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding Quantity, StringFormat=0.####}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="数量" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding UnitSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单位" />

                        <DataGridTextColumn
                            Width="108"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding LinkedDemandQtyText}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="已关联量"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="108"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding UnlinkedQtyText}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="未关联量"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="112"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding AssociationStatus, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                            Header="关联状态" />
                        <DataGridTextColumn
                            Width="260"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding ReviewText}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="核实提示" />


                        <DataGridTextColumn
                            Width="105"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="计划交期" />



                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding UnitPrice, StringFormat=N4}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="未税价"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="96"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding TaxPrice, StringFormat=N4}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="含税价"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="95"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding UnitAmount, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="未税金额"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="95"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding TaxAmount, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="含税金额"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="150"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding DeliverySupplierName}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="送至供应商"
                            Visibility="Collapsed" />
                        <DataGridTextColumn
                            Width="150"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding SourceSummary}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="来源" />
                        <DataGridTextColumn
                            Width="180"
                            dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                            Binding="{Binding SubNote}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="行备注"
                            Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
