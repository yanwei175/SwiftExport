              Binding="{Binding LatestFollowUpDateText}"
              Width="130"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="跟进人"
              Binding="{Binding LatestFollowUpUserText}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
              Visibility="Collapsed" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="未税价"
              Binding="{Binding UnitPrice,StringFormat=N4}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="含税价"
              Binding="{Binding TaxPrice,StringFormat=N4}"
              Width="96"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="未税金额"
              Binding="{Binding UnitAmount,StringFormat=N2}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
              Header="含税金额"
              Binding="{Binding TaxAmount,StringFormat=N2}"
              Width="95"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="送至供应商"
              Binding="{Binding DeliverySupplierName}"
              Width="150"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="来源"
              Binding="{Binding SourceSummary}"
              Width="150"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
            <DataGridTextColumn
              ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
              Header="行备注"
              Binding="{Binding SubNote}"
              Width="180"
              dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>