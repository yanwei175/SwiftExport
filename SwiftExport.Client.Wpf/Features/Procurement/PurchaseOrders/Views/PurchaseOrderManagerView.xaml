<UserControl x:Class="SwiftExportClient.Features.Procurement.PurchaseOrders.Views.PurchaseOrderManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid">

    <Grid Margin="12,8" RowDefinitions="Auto,8,Auto,8,*">
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="采购单管理" 
                           Style="{StaticResource SubtitleTextBlock}"
                           VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="综合关键词">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </Grid>
        </Grid>


        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,4,Auto">
            
            <DockPanel LastChildFill="True">
                <WrapPanel HorizontalAlignment="Left">
                    <ui:DropDownButton Content="新建采购单" Margin="4,0,0,0" >
                        <ui:DropDownButton.Flyout>
                            <ContextMenu MinWidth="150" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="从物料需求创建" Command="{Binding GetFromNetDemandCommand}"/>
                                <MenuItem Header="新建无关联采购" Command="{Binding CreateIndependentCommand}"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <Button Content="确认" Command="{Binding ConfirmCommand}" MinWidth="70" Margin="4,0,0,0"/>
                    <Button Content="批量确认" Command="{Binding BatchConfirmCommand}" Margin="4,0,0,0"/>
                    <Button Content="取消确认" Command="{Binding CancelConfirmationCommand}" Margin="4,0,0,0"/>
                    <Button Content="整单作废" Command="{Binding VoidOrderCommand}" Margin="4,0,0,0"/>
                    <Button Content="重试原操作" Command="{Binding RetryReversalCommand}" Margin="4,0,0,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" MinWidth="70" Margin="4,0,0,0"/>
                    <Button Content="采购跟进" Command="{Binding OpenFollowUpCommand}" Margin="4,0,0,0"/>
                </WrapPanel>
            </DockPanel>

            <Grid Grid.Row="2" ColumnDefinitions="120,8,120,8,120,8,120,8,100,8,100,8,120,8,120,8,120,8,120,8,Auto,4,Auto">
                <ui:TextBox Grid.Column="0" Text="{Binding OrderNo}" PlaceholderText="系统采购单号">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:TextBox Grid.Column="2" Text="{Binding SourceNo}" PlaceholderText="系统来源单号">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:TextBox Grid.Column="4" Text="{Binding SupplierKeyword}" PlaceholderText="供应商">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:TextBox Grid.Column="6" Text="{Binding Sku}" PlaceholderText="SKU">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <controls:DropDownCheckBox Grid.Column="8" Placeholder="确认状态" 
                                           ItemsSource="{Binding ConfirmationOptions}" 
                                           DisplayMemberPath="DisplayText"
                                           SelectedItems="{Binding SelectedConfirmationStatuses,Mode=OneWay}"/>
                <controls:DropDownCheckBox Grid.Column="10" Placeholder="生命周期" 
                                           ItemsSource="{Binding LifecycleOptions}" 
                                           DisplayMemberPath="DisplayText"
                                           SelectedItems="{Binding SelectedLifecycleStatuses,Mode=OneWay}"/>

                <DatePicker Grid.Column="12" Style="{StaticResource SwiftExportDatePicker}" SelectedDateFormat="Short" SelectedDate="{Binding PlannedDeliveryDateFrom}" controls:DatePickerAssist.PlaceholderText="计划交期起"/>
                <DatePicker Grid.Column="14" Style="{StaticResource SwiftExportDatePicker}" SelectedDateFormat="Short" SelectedDate="{Binding PlannedDeliveryDateTo}" controls:DatePickerAssist.PlaceholderText="计划交期至"/>
                <DatePicker Grid.Column="16" Style="{StaticResource SwiftExportDatePicker}" SelectedDateFormat="Short" SelectedDate="{Binding ExpectedCompletionDateFrom}" controls:DatePickerAssist.PlaceholderText="预计完成起"/>
                <DatePicker Grid.Column="18" Style="{StaticResource SwiftExportDatePicker}" SelectedDateFormat="Short" SelectedDate="{Binding ExpectedCompletionDateTo}" controls:DatePickerAssist.PlaceholderText="预计完成至"/>
                
                <Button Grid.Column="20" Content="查询" Command="{Binding SearchCommand}" MinWidth="70"/>
                <Button Grid.Column="22" Content="清空筛选" Command="{Binding ClearFiltersCommand}"/>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="160,8,160,8,125,8,125,8,125,8,125,*">

                

            </Grid>
        </Grid>
        <!--主区域-->
        <Grid Grid.Row="4" RowDefinitions="4*,8,6*">
            <Grid RowDefinitions="*,Auto">
                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          PreviewMouseDoubleClick="OnOrdersPreviewMouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="{StaticResource DataGridRowHeightSmall}"
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsThreeState="False"
                                              IsChecked="{Binding DataContext.IsAllCurrentPageChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ToolTip="全选或清除当前加载页"
                                              AutomationProperties.Name="全选或清除当前页采购单"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              ToolTip="{Binding BatchConfirmationStatus}"
                                              AutomationProperties.Name="{Binding OrderNo, StringFormat=选择采购单 {0}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="生命周期"
                                            Binding="{Binding LifecycleStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}"
                                            Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="采购单号" Binding="{Binding OrderNo}" Width="145"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="自定义采购单号" Binding="{Binding BoNo}" Width="140"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客户代码" Binding="{Binding CustomerCode}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="供应商" Binding="{Binding SupplierName}" Width="170"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="确认状态" Binding="{Binding ConfirmationStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="采购日期" Binding="{Binding OrderDate,StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="预计交期" Binding="{Binding ExpectedDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="回复交期" Binding="{Binding ReplyDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="行数" Binding="{Binding LineCount}" Width="60"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="已知已备好合计" Binding="{Binding LatestReadyQty,StringFormat={}{0:0.####}}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="总数量" Binding="{Binding TotalQty,StringFormat=N1}" Width="95"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="收货进度" Binding="{Binding ReceiptProgress}" Width="100"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="含税总金额" Binding="{Binding TaxTotalAmount,StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="已反馈行数" Binding="{Binding ReportedLineCount}" Width="90"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="预计完成" Binding="{Binding ExpectedCompletionDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="Auto,12,*,Auto,12,Auto">
                    <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlock}"/>

                    <TextBlock Grid.Column="2" Text="{Binding ResultSummary}" 
                                VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlock}"/>

                    <TextBlock Grid.Column="3" Text="{Binding PageStatus}"  
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlock}"/>

                    <controls:PageNavigator Grid.Column="5" 
                                            TotalCount="{Binding TotalCount}" 
                                            PageIndex="{Binding PageIndex}" 
                                            PageSize="{Binding PageSize}" 
                                            PageChangeCommand="{Binding PageChangeCommand}"/>
                </Grid>

            </Grid>

            <GridSplitter Grid.Row="1" Style="{StaticResource SwiftExportGridSplitterHorizontal}"/>

            <Grid Grid.Row="2" RowDefinitions="Auto,8,*">

                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,8,Auto,18,Auto,8,Auto,*">

                    <TextBlock Grid.Column="0" Text="采购单：" Style="{StaticResource BodyStrongTextBlock}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SelectedOrder.OrderNo}" Style="{StaticResource BodyTextBlock}"/>

                    <TextBlock Grid.Column="4" Text="供应商：" Style="{StaticResource BodyStrongTextBlock}"/>
                    <TextBlock Grid.Column="6" Text="{Binding SelectedOrder.SupplierName}" Style="{StaticResource BodyTextBlock}"/>

                    <TextBlock Grid.Column="7" 
                               HorizontalAlignment="Right" 
                               Text="{Binding DetailStatusText}" 
                               Style="{StaticResource BodyTextBlock}"/>
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" 
                          SelectedItem="{Binding SelectedLine}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="{StaticResource DataGridRowHeightMedium}" 
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          Style="{StaticResource SwiftExportDataGrid}" 
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="行" 
                                            Binding="{Binding LineNumber}" Width="32"/>

                        <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False" gridColumns:GridColumn.Key="image">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage Width="56" Height="56" Margin="2" Style="{StaticResource SwiftExportCachedImage}" SourcePath="{Binding MainImage}" DecodePixelWidth="80" Stretch="Uniform"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客户型号" Binding="{Binding CustomerSku}" Width="105"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="物料编号" Binding="{Binding Sku}" Width="115"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="AQ/关联型号" Binding="{Binding LinkSku}" Width="115"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="供应商型号" Binding="{Binding SupplierSku}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="中文描述" Binding="{Binding DescriptionZh}" Width="180"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="表面处理" Binding="{Binding FinishZh}" Width="110"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="配置" Binding="{Binding FeaturesZh}" Width="130"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="物料类型" Binding="{Binding MaterialType}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="供货方式" Binding="{Binding SupplyType}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="数量" Binding="{Binding Quantity,StringFormat=N1}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="未收货" Binding="{Binding UnreceivedQty,StringFormat=N1}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="已备好" Binding="{Binding LatestReadyQtyText}" Width="105"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="计划交期" Binding="{Binding PlannedDeliveryDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="预计完成" Binding="{Binding ExpectedCompletionDateText}" Width="110"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="最近跟进" Binding="{Binding LatestFollowUpDateText}" Width="130"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="跟进人" Binding="{Binding LatestFollowUpUserText}" Width="95"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="未税价" Binding="{Binding UnitPrice,StringFormat=N4}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="含税价" Binding="{Binding TaxPrice,StringFormat=N4}" Width="85"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="未税金额" Binding="{Binding UnitAmount,StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="含税金额" Binding="{Binding TaxAmount,StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="送至供应商" Binding="{Binding DeliverySupplierName}" Width="150"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="来源" Binding="{Binding SourceSummary}" Width="150"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="行备注" Binding="{Binding SubNote}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
