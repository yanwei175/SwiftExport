<UserControl
    x:Class="SwiftExportClient.Features.Products.Attributes.Views.ProductAttributeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:gridcore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="clr-namespace:SwiftExportClient.Mvvm"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.Attributes.ViewModels"
    d:DataContext="{d:DesignInstance vm:ProductAttributeManagerViewModel}"
    d:Height="680"
    d:Width="1920"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewLostKeyboardFocus="OnPreviewLostKeyboardFocus"
    PreviewMouseLeftButtonDown="OnPreviewMouseDown"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="DefinitionRowState">
            <TextBlock>
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}" TargetType="TextBlock">
                        <Setter Property="Text" Value="已保存" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static mvvm:LineState.Added}">
                                <Setter Property="Text" Value="新增" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static mvvm:LineState.Modified}">
                                <Setter Property="Text" Value="修改" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="自定义属性" />
            <TextBlock
                Margin="0,4,0,0"
                Text="属性组和值在所有关联模板中共用；每个产品对象独立选择属性值。"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Text="{Binding EditStateMessage}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                AutomationProperties.Name="保存全部属性组、值和模板关联"
                Command="{Binding SaveCommand}"
                Content="保存全部" />
            <ui:Button
                MinWidth="70"
                Margin="8,0,0,0"
                AutomationProperties.Name="刷新自定义属性和模板候选"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
            <ui:Button
                Margin="8,0,0,0"
                Command="{Binding RejectCommand}"
                Content="撤销编辑" />
            <ui:Button
                Margin="8,0,0,0"
                AutomationProperties.Name="在独立页签管理产品属性模板"
                Command="{Binding ManageAttributeProfilesCommand}"
                Content="管理属性模板" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="450" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="属性组" />
                    <Button Command="{Binding AddGroupCommand}" Content="新增组" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding DeleteGroupCommand}"
                        Content="删除组" />
                </StackPanel>

                <DataGrid
                    x:Name="GroupGrid"
                    Grid.Row="1"
                    gridcore:GridRowHeader.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="共享属性组定义"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    IsEnabled="{Binding IsInteractionEnabled}"
                    IsReadOnly="{Binding AreGridsReadOnly}"
                    ItemsSource="{Binding Groups.Items}"
                    SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource SwiftExportDataGrid}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn
                            Width="64"
                            CellTemplate="{StaticResource DefinitionRowState}"
                            Header="状态"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding GroupCode, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="编码" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="名称" />

                        <DataGridTemplateColumn
                            Width="96"
                            ClipboardContentBinding="{Binding SelectionMode, Mode=OneWay}"
                            Header="选择方式">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        VerticalContentAlignment="Center"
                                        AutomationProperties.Name="属性组选项选择方式"
                                        DisplayMemberPath="Value"
                                        IsEnabled="{Binding DataContext.CanEditDefinitions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ItemsSource="{Binding DataContext.SelectionModes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding SelectionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Key" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="64"
                            Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="排序" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <TabControl
                x:Name="GroupDetailsTabs"
                Grid.Column="2"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="属性值">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Button Command="{Binding AddOptionCommand}" Content="新增值选项" />
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding DeleteOptionCommand}"
                                Content="删除值选项" />
                        </StackPanel>
                        <DataGrid
                            x:Name="OptionGrid"
                            Grid.Row="1"
                            gridcore:GridRowHeader.ShowRowNumber="True"
                            AutoGenerateColumns="False"
                            AutomationProperties.Name="当前属性组的属性值定义"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            IsEnabled="{Binding IsInteractionEnabled}"
                            IsReadOnly="{Binding AreGridsReadOnly}"
                            ItemsSource="{Binding CurrentOptions}"
                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            Style="{StaticResource SwiftExportDataGrid}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="64"
                                    CellTemplate="{StaticResource DefinitionRowState}"
                                    Header="状态"
                                    IsReadOnly="True" />

                                <DataGridTextColumn
                                    Width="112"
                                    Binding="{Binding OptionCode, UpdateSourceTrigger=PropertyChanged}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="编码" />

                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding OptionName, UpdateSourceTrigger=PropertyChanged}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Header="名称" />

                                <DataGridTextColumn
                                    Width="64"
                                    Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Header="排序" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="关联模板">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>

                            <TextBlock
                                Margin="0,0,0,12"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedGroup.GroupName, StringFormat=当前属性组：{0}}" />

                            <filter:MultiSelectLookupButton
                                x:Name="ProfilePicker"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="当前属性组直接关联的模板"
                                DisplayMemberPath="ProfileName"
                                FilterMemberPaths="ProfileName,ProfileCode"
                                Header="直接关联模板"
                                IsEnabled="{Binding CanEditCurrentGroup}"
                                ItemsSource="{Binding ProfileCandidates}"
                                Placeholder="搜索模板名称或代码"
                                SelectedItems="{Binding SelectedProfileSelection.SelectedProfiles, Mode=OneWay}"
                                SelectedValuePath="Uid"
                                ShowSearchBox="True" />

                            <TextBlock
                                Margin="0,12,0,8"
                                Text="勾选适用的属性模板，同一组可供多个模板共用。"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,0,0,16"
                                Text="下拉框的“确定”只更新当前组草稿；请使用“保存全部”提交整页变更。"
                                TextWrapping="Wrap" />

                        </StackPanel>
                        <ListBox
                            x:Name="SelectedProfilesList"
                            Grid.Row="1"
                            Padding="0"
                            AutomationProperties.Name="当前属性组已直接关联的属性模板"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding SelectedProfileSelection.SelectedProfiles}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource SwiftExportListBoxItemStyle}" TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ProfileName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Padding="12,8">
                                        <TextBlock Text="{Binding ProfileName}" TextWrapping="Wrap" />
                                    </ui:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Text="尚未直接关联属性模板。"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=SelectedProfilesList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding PendingChangeSummary}" TextWrapping="Wrap" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

