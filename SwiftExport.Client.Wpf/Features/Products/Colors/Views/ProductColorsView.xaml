<UserControl xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="SwiftExportClient.Features.Products.Colors.Views.ProductColorsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Width="1200"
             d:Height="800"
             xmlns:rowDrag="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:gridValidation="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />

        <Style x:Key="ProductColorsToolbarButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="ProductColorsStatusText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource CaptionTextBlock}">
            <Setter Property="Text" Value="所有更改已保存" />
            <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="Text" Value="有未保存更改" />
                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="产品颜色管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="按颜色代码、英文名或中文名查询">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>
            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <ui:Button Margin="0,0,8,0" MinWidth="70" 
                                        Command="{Binding AddRowCommand}"
                                        Content="新增"
                                        ToolTip="新增产品颜色"/>

                            <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" MinWidth="70" />

                            <ui:Button  Margin="0,0,8,0" MinWidth="70"
                                           Command="{Binding RejectAllChangesCommand}"
                                           CommandTarget="{Binding ElementName=ColorsGrid}"
                                           Content="撤销全部"
                                           ToolTip="撤销本页全部未保存变更"/>



                            <ui:DropDownButton Content="更多功能" Margin="0,0,8,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu MinWidth="180" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="导入颜色" Command="{Binding MoreCommand}" CommandParameter="导入颜色" />
                                        <MenuItem Header="导出颜色"  Command="{Binding MoreCommand}" CommandParameter="导出颜色" />
                                        <Separator />
                                        <MenuItem Header="批量规范化代码" Command="{Binding MoreCommand}" CommandParameter="批量规范化代码" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>

                            <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />



                            <ui:ToggleSwitch Grid.Column="4" Margin="0,0,8,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             OffContent="整行模式"
                                             OnContent="单元格模式"
                                             IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />

                            <Border Padding="8,4" Background="Transparent" CornerRadius="{StaticResource SwiftExportControlCornerRadius}">
                                <TextBlock Style="{StaticResource ProductColorsStatusText}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                    </WrapPanel>
                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top"
                                          Content="关闭" MinWidth="70"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"/>

                            <StackPanel Orientation="Horizontal" MinHeight="120">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <ui:InfoBar Grid.Row="0"
                    Title="请检查当前数据"
                    Message="{Binding ValidationSummary}"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{Binding HasValidationError}" />

            <Grid Grid.Row="2">
                <DataGrid x:Name="ColorsGrid"
                      ItemsSource="{Binding ColorsView}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                      IsReadOnly="{Binding IsReadOnly}"
                      CanUserSortColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                      RowHeight="{StaticResource DataGridRowHeightSmall}"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      rowDrag:RowDragReorder.IsEnabled="{Binding CanReorder}"
                      rowDrag:RowDragReorder.MoveCommand="{Binding ReorderLineCommand}"
                      CurrentItem="{Binding SelectedLine, Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="True">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                    </i:Interaction.Behaviors>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="排序" Width="48" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="ColorReorderHandle" 
                                               rowDrag:RowDragReorder.IsHandle="True" Text="≡" FontSize="20"
                                               Background="Transparent" Cursor="SizeAll"
                                               HorizontalAlignment="Stretch" TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsEnabled="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               AutomationProperties.Name="拖动调整颜色顺序"
                                               ToolTip="拖动调整顺序；Alt+↑ / Alt+↓ 移动当前行，保存后生效" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="55"
                                            CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DataContext.Lines.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                          HorizontalAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="排序号" Width="80" IsReadOnly="True"
                                            Binding="{Binding SortNo}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
                        <DataGridTextColumn Header="唯一颜色代码"
                                        Width="180"
                                        Binding="{Binding ColorCodeUnique, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn fill:DataGridFillDownBehavior.Field="ColorCode" Header="颜色代码"
                                        Width="160"
                                        Binding="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn fill:DataGridFillDownBehavior.Field="ColorNameEn" Header="英文名称"
                                        Width="2*"
                                        Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn fill:DataGridFillDownBehavior.Field="ColorNameZh" Header="中文名称"
                                        Width="2*"
                                        Binding="{Binding ColorNameZh, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="暂无匹配的产品颜色"
                           Style="{StaticResource BodyStrongTextBlock}"
                           HorizontalAlignment="Center" />
                    <TextBlock Margin="0,4,0,0"
                           Text="调整关键词后查询，或新增第一条颜色记录。"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Panel.ZIndex="10"
                    Background="Transparent"
                    BorderBrush="{DynamicResource UserSubtleFillColorSecondaryBrush}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" d:IsHidden="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing Width="28"
                                     Height="28"
                                     IsIndeterminate="True" />
                        <TextBlock Margin="0,8,0,0"
                               Text="{Binding BusyMessage, FallbackValue=正在处理...}"
                               Style="{StaticResource BodyTextBlock}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultSummary}"
                           Style="{StaticResource CaptionTextBlock}" />
                    <TextBlock Margin="8,0,0,0"
                           Text="{Binding ElementName=ColorsGrid, Path=(gridValidation:GridValidation.ErrorCount), StringFormat=表格错误 {0} 项}"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
