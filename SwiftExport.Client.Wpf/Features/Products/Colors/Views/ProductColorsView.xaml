<UserControl x:Class="SwiftExportClient.Features.Products.Colors.Views.ProductColorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:SwiftExportClient.Controls"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource BodyTextBlock}"
                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="{StaticResource SwiftExportBorderThickness}"
                CornerRadius="{StaticResource SwiftExportCornerRadius}"
                Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="关键词"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="320" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="立即查询"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Content="新增"
                        Command="{Binding AddRowCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96" />
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="删除"
                        Command="{Binding DeleteSelectedCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="撤销"
                        Command="{Binding RejectChangesCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <ui:DropDownButton Content="更多"
                                   MinWidth="96"
                                   Margin="8,0,0,0">
                    <ui:DropDownButton.Flyout>
                        <ui:Flyout Placement="Bottom">
                            <StackPanel MinWidth="180"
                                        Margin="4">
                                <Button Content="导入颜色"
                                        Command="{Binding MoreCommand}"
                                        CommandParameter="导入颜色"
                                        HorizontalAlignment="Stretch" />
                                <Button Content="导出颜色"
                                        Command="{Binding MoreCommand}"
                                        CommandParameter="导出颜色"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,4,0,0" />
                                <Button Content="批量规范化代码"
                                        Command="{Binding MoreCommand}"
                                        CommandParameter="批量规范化代码"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:Flyout>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding ResultSummary}"
                       Style="{StaticResource CaptionTextBlock}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="6">
            <DataGrid ItemsSource="{Binding Lines.Items}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                      IsReadOnly="False"
                      CanUserSortColumns="True"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        gridColumns:GridColumn.Key="row-index"
                                        Binding="{Binding RowIndex}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Width="48"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="唯一颜色代码"
                                        gridColumns:GridColumn.Key="color-code-unique"
                                        Binding="{Binding ColorCodeUnique, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Width="180" />
                    <DataGridTextColumn Header="颜色代码"
                                        gridColumns:GridColumn.Key="color-code"
                                        Binding="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Width="160" />
                    <DataGridTextColumn Header="英文名称"
                                        gridColumns:GridColumn.Key="color-name-en"
                                        Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Width="2*" />
                    <DataGridTextColumn Header="中文名称"
                                        gridColumns:GridColumn.Key="color-name-zh"
                                        Binding="{Binding ColorNameZh, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="暂无产品颜色数据"
                       Style="{StaticResource BodyTextBlock}"
                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PageStatus}"
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text=" · "
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding ValidationSummary}"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>

            <controls:PageNavigator Grid.Column="1"
                                    TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex, Mode=OneWay}"
                                    PageSize="{Binding PageSize, Mode=OneWay}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
