<UserControl x:Class="SwiftExportClient.Features.Products.ProductMasterImportExport.Views.ProductMasterImportExportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:files="clr-namespace:SwiftExportClient.Features.Products.ProductMasterImportExport.Services" Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
 <Grid Margin="12,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding FilterSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <WrapPanel Grid.Row="2">
   <ui:Button Content="下载导入模板" Click="OnDownloadTemplate" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0" AutomationProperties.Name="下载父级型号导入模板"/>
   <ui:Button Content="选择 Excel" Click="OnChooseFile" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0" AutomationProperties.Name="选择父级型号导入文件"/>
   <ComboBox Width="180" ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedSheet}" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0" AutomationProperties.Name="导入工作表"/>
   <ui:Button Content="读取工作表" Command="{Binding ReadSheetCommand}" Margin="0,0,8,0"/>
   <ui:Button Content="校验与匹配" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <ui:Button Content="移除当前行" Command="{Binding RemoveRowCommand}" Margin="0,0,8,0"/>
   <ui:Button Content="提交导入" Appearance="Primary" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
   <ui:Button Content="导出筛选数据" Click="OnExport" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0" AutomationProperties.Name="导出来源筛选的全部父级型号"/>
   <ui:Button Content="取消操作" Command="{Binding CancelOperationCommand}" AutomationProperties.Name="请求停止当前文件或导入操作"/>
  </WrapPanel>
  <StackPanel Grid.Row="4">
   <TextBlock Text="{Binding FilePath,StringFormat=当前选择：{0}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding BatchSource}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding UploadPermissionHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock Text="第一行为字段名称，主型号必填；空白不覆盖已有值。装率为正整数，重量和体积非负。单次导入最多 1000 行。" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <DataGrid x:Name="ImportGrid" Grid.Row="6" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
   Style="{StaticResource SwiftExportDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
   IsReadOnly="{Binding IsGridReadOnly}" EnableRowVirtualization="True" EnableColumnVirtualization="True"
   ScrollViewer.CanContentScroll="True" AutomationProperties.Name="父级型号导入预览与编辑">
   <DataGrid.Columns>
    <DataGridTextColumn Header="文件行" Binding="{Binding SourceRowNumber}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="80"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.MasterSkuHeader}" Binding="{Binding MasterSku,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultDescriptionZhHeader}" Binding="{Binding DefaultDescriptionZh,UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultDescriptionEnHeader}" Binding="{Binding DefaultDescriptionEn,UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultFeaturesZhHeader}" Binding="{Binding DefaultFeaturesZh,UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultFeaturesEnHeader}" Binding="{Binding DefaultFeaturesEn,UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultPcsPerPackageHeader}" Binding="{Binding DefaultPcsPerPackage,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultNetWeightHeader}" Binding="{Binding DefaultNetWeight,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultGrossWeightHeader}" Binding="{Binding DefaultGrossWeight,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultCbmHeader}" Binding="{Binding DefaultCbm,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.CategoryPathHeader}" Binding="{Binding CategoryPath,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="{x:Static files:ProductMasterWorkbookService.DefaultSupplierCodeHeader}" Binding="{Binding DefaultSupplierCode,UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
    <DataGridTextColumn Header="错误原因" Binding="{Binding ErrorSummary}" IsReadOnly="True" Width="280" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
    <DataGridTextColumn Header="拟保存差异" Binding="{Binding DifferenceSummary}" IsReadOnly="True" Width="320" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="8"><TextBlock Text="{Binding BusyMessage}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</UserControl>
