<UserControl
    x:Class="SwiftExportClient.Features.Products.Bom.Views.BomManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:core="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:products="clr-namespace:SwiftExportClient.Features.Products.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:validation="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.Bom.ViewModels"
    d:DataContext="{d:DesignInstance vm:BomManagerViewModel}"
    d:Height="800"
    d:Width="1280"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="S"
            Command="{Binding SaveCommand}"
            Modifiers="Control" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="8" />
            <RowDefinition Height="3*" MinHeight="180" />
        </Grid.RowDefinitions>
        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="BOM 管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="主型号、SKU、中英文描述、BOM 编号"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />

                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">

                <DockPanel LastChildFill="True">

                    <WrapPanel HorizontalAlignment="Left">

                        <ComboBox
                            MinWidth="100"
                            Margin="0,0,8,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="绑定状态"
                            ItemsSource="{Binding BindingFilters}"
                            SelectedIndex="{Binding BindingFilterIndex}" />

                        <filter:MultiSelectLookupButton
                            Width="160"
                            Margin="0,0,8,0"
                            DisplayMemberPath="CategoryPath"
                            FilterMemberPaths="CategoryName,CategoryPath"
                            Header="分类"
                            ItemsSource="{Binding ReferenceDataCache.ProductCategories}"
                            SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                            SelectedValuePath="Uid"
                            ShowSearchBox="True" />

                        <filter:MultiSelectLookupButton
                            Width="160"
                            DisplayMemberPath="ColorNameZh"
                            FilterMemberPaths="ColorCode,ColorNameZh,ColorNameEn"
                            Header="颜色"
                            ItemsSource="{Binding ReferenceDataCache.ProductColors}"
                            SelectedItems="{Binding FilterColors, Mode=OneWay}"
                            SelectedValuePath="Uid"
                            ShowSearchBox="True" />

                    </WrapPanel>

                </DockPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid
                x:Name="ProductGrid"
                core:GridRowHeader.ShowRowNumber="True"
                AutoGenerateColumns="False"
                AutomationProperties.Name="BOM 成品主表"
                CanUserAddRows="False"
                IsEnabled="{Binding CanSelectProduct}"
                IsReadOnly="True"
                ItemsSource="{Binding Products}"
                RowHeight="{DynamicResource DataGridRowHeightMedium}"
                SelectedItem="{Binding SelectedProduct, Mode=OneWay}"
                SelectionChanged="OnProductSelectionChanged"
                SelectionMode="Single"
                Style="{StaticResource SwiftExportDataGrid}">
                <i:Interaction.Behaviors>
                    <core:DataGridColumnVisibilityBehavior />
                </i:Interaction.Behaviors>

                <DataGrid.Columns>

                    <DataGridTemplateColumn
                        Width="64"
                        CanUserSort="False"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="48"
                                    Height="48"
                                    Margin="2"
                                    DecodePixelWidth="96"
                                    SourcePath="{Binding MainImage}"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding MasterSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="主型号" />

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding Sku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="SKU" />

                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding DescriptionZh}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="中文描述" />

                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding DescriptionEn}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="英文描述" />

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding Finish}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="颜色" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding CategoryName}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="分类" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SupplyType}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="供货类型" />

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding BomNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="BOM 编号" />

                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding StatusText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="状态" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding ComponentCount}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="子件数" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SharedProductCount}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="共享产品数" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <controls:PageNavigator
                    DockPanel.Dock="Right"
                    PageChangeCommand="{Binding PageChangeCommand}"
                    PageSize="{Binding PageSize, Mode=TwoWay}"
                    TotalCount="{Binding TotalCount}"
                    PageIndex="{Binding PageIndex, Mode=TwoWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding ResultSummary}" />
            </DockPanel>
        </Grid>
        <GridSplitter
            Grid.Row="3"
            Height="8"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="调整主从表高度"
            Background="{DynamicResource UserControlStrokeColorDefaultBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel>
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding BindCommand}"
                    Content="建立 / 绑定" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding AddItemCommand}"
                    Content="新增子件" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding DeleteItemCommand}"
                    Content="删除子件" />
                <ui:Button
                    Margin="0,0,8,4"
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="保存" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding RejectCommand}"
                    Content="放弃修改" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding CopyCommand}"
                    Content="复制组成" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding ValidateCommand}"
                    Content="校验" />
                <ui:Button
                    Margin="0,0,8,4"
                    Command="{Binding ShowTreeCommand}"
                    Content="结构树" />
            </WrapPanel>
            <TextBlock
                Grid.Row="1"
                Margin="0,4,0,8"
                Text="{Binding BomStatusText}"
                TextWrapping="Wrap" />
            <DataGrid
                x:Name="ComponentGrid"
                Grid.Row="2"
                core:GridRowHeader.ShowRowNumber="True"
                AutoGenerateColumns="False"
                AutomationProperties.Name="BOM 子件组成表"
                BeginningEdit="OnBeginningEdit"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                ItemsSource="{Binding Boms.Items}"
                RowHeight="{DynamicResource DataGridRowHeightMedium}"
                SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                SelectionMode="Single">
                <DataGrid.Style>
                    <Style BasedOn="{StaticResource SwiftExportDataGrid}" TargetType="DataGrid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanEditComponents}" Value="False">
                                <Setter Property="IsReadOnly" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSaveOutcomeUnknown}" Value="True">
                                <Setter Property="IsReadOnly" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>

                    <DataGridTemplateColumn
                        Width="56"
                        Header="图片"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="40"
                                    Height="40"
                                    DecodePixelWidth="96"
                                    SourcePath="{Binding MainImage}"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="180"
                        ClipboardContentBinding="{Binding SubSku, Mode=OneWay}"
                        Header="子件 SKU">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding SubSku}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <products:ProductLookupTextBox
                                    IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    Text="{Binding SubSku, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Description}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="描述"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Finish}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="颜色"
                        IsReadOnly="True" />


                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Features}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="配置"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Numerator, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="分子" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Denominator, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="分母" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="160"
                        Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="备注" />

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                Text="{Binding ValidationSummary}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
