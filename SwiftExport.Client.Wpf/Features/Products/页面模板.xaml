<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:listViews="clr-namespace:SwiftExportClient.Features.Products.ProductList.Views"
                    xmlns:listViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
                    xmlns:categoryViews="clr-namespace:SwiftExportClient.Features.Products.Categories.Views"
                    xmlns:categoryViewModels="clr-namespace:SwiftExportClient.Features.Products.Categories.ViewModels"
                    xmlns:colorViews="clr-namespace:SwiftExportClient.Features.Products.Colors.Views"
                    xmlns:colorViewModels="clr-namespace:SwiftExportClient.Features.Products.Colors.ViewModels"
                    xmlns:placeholderViews="clr-namespace:SwiftExportClient.Features.Products.Placeholders.Views"
                    xmlns:placeholderViewModels="clr-namespace:SwiftExportClient.Features.Products.Placeholders.ViewModels">
    <DataTemplate DataType="{x:Type listViewModels:ProductsViewModel}"><listViews:ProductsView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductMasterManagerViewModel}"><listViews:ProductMasterManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductNeutralManagerViewModel}"><listViews:ProductNeutralManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductMasterDetailViewModel}"><listViews:ProductMasterDetailView /></DataTemplate>
    <DataTemplate DataType="{x:Type categoryViewModels:ProductCategoryManagerViewModel}"><categoryViews:ProductCategoryManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type colorViewModels:ProductColorsViewModel}"><colorViews:ProductColorsView /></DataTemplate>
    <DataTemplate DataType="{x:Type placeholderViewModels:ProductBomViewModel}"><placeholderViews:ProductPlaceholderView /></DataTemplate>
</ResourceDictionary>
