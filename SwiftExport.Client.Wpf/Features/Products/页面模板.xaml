<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:listViews="clr-namespace:SwiftExportClient.Features.Products.ProductList.Views"
                    xmlns:listViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
                    xmlns:attributeViews="clr-namespace:SwiftExportClient.Features.Products.Attributes.Views"
                    xmlns:attributeViewModels="clr-namespace:SwiftExportClient.Features.Products.Attributes.ViewModels"
                    xmlns:categoryViews="clr-namespace:SwiftExportClient.Features.Products.Categories.Views"
                    xmlns:categoryViewModels="clr-namespace:SwiftExportClient.Features.Products.Categories.ViewModels"
                    xmlns:colorViews="clr-namespace:SwiftExportClient.Features.Products.Colors.Views"
                    xmlns:colorViewModels="clr-namespace:SwiftExportClient.Features.Products.Colors.ViewModels"
                    xmlns:bomViews="clr-namespace:SwiftExportClient.Features.Products.Bom.Views"
                    xmlns:bomViewModels="clr-namespace:SwiftExportClient.Features.Products.Bom.ViewModels"
                    xmlns:importViews="clr-namespace:SwiftExportClient.Features.Products.ProductMasterImport.Views"
                    xmlns:importViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductMasterImport.ViewModels"
                    xmlns:neutralImportViews="clr-namespace:SwiftExportClient.Features.Products.ProductNeutralImport.Views"
                    xmlns:neutralImportViewModels="clr-namespace:SwiftExportClient.Features.Products.ProductNeutralImport.ViewModels">
    <DataTemplate DataType="{x:Type neutralImportViewModels:ProductNeutralImportViewModel}"><neutralImportViews:ProductNeutralImportView /></DataTemplate>
    <DataTemplate DataType="{x:Type importViewModels:ProductMasterImportViewModel}"><importViews:ProductMasterImportView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductsViewModel}"><listViews:ProductsView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductMasterManagerViewModel}"><listViews:ProductMasterManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductNeutralManagerViewModel}"><listViews:ProductNeutralManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductMasterDetailViewModel}"><listViews:ProductMasterDetailView /></DataTemplate>
    <DataTemplate DataType="{x:Type listViewModels:ProductDetailViewModel}"><listViews:ProductDetailView /></DataTemplate>
    <DataTemplate DataType="{x:Type categoryViewModels:ProductCategoryManagerViewModel}"><categoryViews:ProductCategoryManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type attributeViewModels:ProductAttributeManagerViewModel}"><attributeViews:ProductAttributeManagerView /></DataTemplate>
    <DataTemplate DataType="{x:Type colorViewModels:ProductColorsViewModel}"><colorViews:ProductColorsView /></DataTemplate>
    <DataTemplate DataType="{x:Type bomViewModels:BomManagerViewModel}"><bomViews:BomManagerView /></DataTemplate>
</ResourceDictionary>
