<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SwiftExportClient.Features.Products.ProductList.Views"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProductDetailViewModel}"
             d:DesignHeight="800" d:DesignWidth="1280">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Stretch">
            <StackPanel  DockPanel.Dock="Left" Orientation="Horizontal" 
                         VerticalAlignment="Center">
                <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}"  Margin="0,0,4,0" />
                <ui:Button Content="放弃" Command="{Binding RejectDetailChangesCommand}"  Margin="0,0,4,0" />
                <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,4,0" />
            </StackPanel>

            <StackPanel Panel.ZIndex="999" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="{Binding DocumentTitle}" 
                           TextAlignment="Center"
                           Style="{StaticResource SubtitleTextBlock}" 
                           Foreground="{DynamicResource UserSystemAccentColorPrimaryBrush}"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}" 
                           TextAlignment="Center"
                           Style="{StaticResource SecondaryTextBlock}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right">
                <ui:Button Content="关闭页签" 
                           Appearance="Primary" 
                           Command="{Binding CloseDocumentCommand}" />
            </StackPanel>

        </Grid>

        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}" 
                BorderThickness="1"
                CornerRadius="{StaticResource SwiftExportCornerRadius}" 
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Column="0" Grid.Row="0" Text="物料编号: *" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="1" Grid.Row="0"
                                    Text="{Binding Product.Sku, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="关联主型号:" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="3" Grid.Row="0"
                                    Text="{Binding Product.MasterSku, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <TextBlock Grid.Column="4" Grid.Row="0" Text="关联产品型号:" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="5" Grid.Row="0"
                                    Text="{Binding Product.LinkSku, UpdateSourceTrigger=PropertyChanged}" />
                    
                    
                    <TextBlock Grid.Column="6" Grid.Row="0" Text="关联客户:" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="7" Grid.Row="0"
                                    Text="{Binding Product.LinkSku, UpdateSourceTrigger=PropertyChanged}" />
                    
                    
                    
                    
                    
                    <TextBlock Grid.Column="6" Grid.Row="0" Text="物料分类:" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="7" Grid.Row="0" PlaceholderText="产品分类:"
                                    Text="{Binding Product.CategoryId, UpdateSourceTrigger=PropertyChanged}" />                    
                    
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="物料颜色:" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="1" Grid.Row="1" PlaceholderText="改为自定义控件:"
                                    Text="{Binding Product.ColorId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2" Grid.Row="1" Text="物料类型:" VerticalAlignment="Center" />
                    <ui:TextBox  Grid.Column="3" Grid.Row="1"  Text="{Binding Product.MaterialType, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <TextBlock Grid.Column="4" Grid.Row="1" Text="供货类型:" VerticalAlignment="Center" />
                    <ui:TextBox  Grid.Column="5" Grid.Row="1"  Text="{Binding Product.SupplyType, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="6" Grid.Row="1" Text="单位:" VerticalAlignment="Center" />
                    <ui:TextBox  Grid.Column="7" Grid.Row="1"  Text="{Binding Product.Unit, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="是否有BOM:" VerticalAlignment="Center" />
                    <CheckBox  Grid.Column="1" Grid.Row="2"  IsChecked="{Binding Product.BomVersion,Mode=TwoWay}" />
                    
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="BOM号:" VerticalAlignment="Center" />
                    <ui:TextBox  Grid.Column="3" Grid.Row="2"  Text="{Binding Product.BomVersion, UpdateSourceTrigger=PropertyChanged}" />


                    <TextBlock Grid.Column="4" Grid.Row="2" Text="供应商:" VerticalAlignment="Center" />
                    
                    
                    <TextBlock Grid.Column="6" Grid.Row="2" Text="仓库:" VerticalAlignment="Center" />
                    
                    
                    <TextBlock Grid.Column="0" Grid.Row="3" Text="制造商:" VerticalAlignment="Center" />
                    
                    
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="制造商型号:" VerticalAlignment="Center" />






                    <TextBlock Grid.Column="4" Grid.Row="0" Text="中文描述:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="6" Grid.Row="0" Grid.ColumnSpan="5"
                                    Text="{Binding Product.DescriptionZh, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="12" Grid.Row="0" 
                               Text="产品分类:" VerticalAlignment="Center" />







                    <TextBlock Grid.Column="4" Grid.Row="2" Text="英文描述:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="6" Grid.Row="2" Grid.ColumnSpan="5"
                                Text="{Binding Product.DescriptionEn, UpdateSourceTrigger=PropertyChanged}" />


                    <TextBlock  Grid.Column="0" Grid.Row="4" Text="每箱数量: *" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="2" Grid.Row="4" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Product.PcsOfCarton, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Column="4" Grid.Row="4" Text="净重:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="6" Grid.Row="4" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Product.NwOfCarton, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Column="8" Grid.Row="4" Text="中文配置:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="10" Grid.Row="4" Grid.RowSpan="6"
                                FontSize="12"
                                Text="{Binding Product.FeaturesZh, UpdateSourceTrigger=PropertyChanged}"                                     
                                TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Grid.Column="12" Grid.Row="4" Text="英文配置:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="14" Grid.Row="4" Grid.RowSpan="5"
                                FontSize="12"
                                Text="{Binding Product.FeaturesEn, UpdateSourceTrigger=PropertyChanged}"                                    
                                TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Grid.Column="0" Grid.Row="6" Text="毛重:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="2" Grid.Row="6" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Product.GwOfCarton, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock  Grid.Column="4" Grid.Row="6" Text="体积:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="6" Grid.Row="6" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  PlaceholderText="0.000"
                                  Text="{Binding Product.CbmOfCarton, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" Width="240" MinHeight="240"
                            CornerRadius="4"
                            Padding="8">
                        <controls:CachedImage Style="{StaticResource SwiftExportCachedImage}"
                                          Width="Auto"
                                          Height="Auto"
                                          DecodePixelWidth="800"
                                          SourcePath="{Binding MainImagePath}"
                                          Stretch="Uniform" />
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding ValidationSummary}" Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                   Style="{StaticResource CaptionTextBlock}" />
    </Grid>
</UserControl>
