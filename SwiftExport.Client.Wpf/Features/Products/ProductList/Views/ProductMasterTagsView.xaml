<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductMasterTagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TagBooleanVisibility" />
    </UserControl.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="刷新标签" Command="{Binding RefreshProductAttributesCommand}"
                    AutomationProperties.Name="刷新分类标签定义" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Tags.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tags.Groups}" IsEnabled="{Binding CanEditTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding GroupName}" TextWrapping="Wrap" />
                                    <TextBlock Text="单选" Style="{StaticResource SecondaryTextBlock}"
                                               Visibility="{Binding IsSingle, Converter={StaticResource TagBooleanVisibility}}" />
                                    <TextBlock Text="多选" Style="{StaticResource SecondaryTextBlock}"
                                               Visibility="{Binding IsMultiple, Converter={StaticResource TagBooleanVisibility}}" />
                                </StackPanel>
                                <Grid Grid.Column="1" Visibility="{Binding IsSingle, Converter={StaticResource TagBooleanVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="OptionName"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding GroupName}" />
                                    <Button Grid.Column="1" Content="清除" Command="{Binding ClearSingleSelectionCommand}"
                                            AutomationProperties.Name="清除单选标签" Margin="4,0,0,0" />
                                </Grid>
                                <filter:MultiSelectLookupButton Grid.Column="1" Header="选择标签" ItemsSource="{Binding Options}"
                                         SelectedItems="{Binding SelectedItems, Mode=OneWay}" SelectedValuePath="Uid"
                                         DisplayMemberPath="OptionName" FilterMemberPaths="OptionName,OptionCode"
                                         Placeholder="搜索名称或编码" SelectionCommittedCommand="{Binding CommitMultipleSelectionCommand}"
                                         Loaded="OnMultiSelectLoaded" Unloaded="OnMultiSelectUnloaded"
                                         AutomationProperties.Name="{Binding GroupName}"
                                         Visibility="{Binding IsMultiple, Converter={StaticResource TagBooleanVisibility}}" />
                                <TextBlock Grid.Column="2" Text="{Binding SelectionSummary}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="当前组已改为单选，原有多个值已保留，请重新选择或清除。"
                                           Foreground="{DynamicResource UserBusinessTextWarningBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasSingleSelectionConflict, Converter={StaticResource TagBooleanVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Tags.MissingSelections}" IsEnabled="{Binding CanEditTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource UserBusinessTextWarningBrush}" />
                                <Button Content="移除失效标签" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.Tags.RemoveMissingSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AutomationProperties.Name="移除当前失效标签" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
