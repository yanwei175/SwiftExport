<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:Height="800"
             xmlns:controls="clr-namespace:SwiftExportClient.Controls"
             xmlns:imageControls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <CollectionViewSource x:Key="ProductMaterialTypesView" Source="{Binding MaterialTypes}" />
        <CollectionViewSource x:Key="ProductSupplyTypesView" Source="{Binding SupplyTypes}" />
        <Style x:Key="ProductsToolbarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:LookupTextBox Grid.Column="0"
                                    Placeholder="Search..."
                                    MinimumSearchLength="0"
                                    Text="{Binding Keyword, Mode=TwoWay}"
                                    QueryCommand="{Binding SearchCommand}" />
            <Button Grid.Column="2" Width="36" MinHeight="32" Padding="6,4"
                    Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" ToolTip="查询">
                <ui:SymbolIcon Symbol="Search24" />
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddRowCommand}" Style="{StaticResource AccentButton}"
                        MinHeight="32" Padding="8,4" Margin="0,0,4,0" ToolTip="新增产品">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" /><TextBlock Margin="6,0,0,0" Text="新增" /></StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource ProductsToolbarButton}" ToolTip="保存产品">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" /><TextBlock Margin="6,0,0,0" Text="保存" /></StackPanel>
                </Button>
                <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ProductsToolbarButton}" ToolTip="删除产品">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" /><TextBlock Margin="6,0,0,0" Text="删除" /></StackPanel>
                </Button>
                <Button Command="{Binding RejectProductChangesCommand}" Style="{StaticResource ProductsToolbarButton}" ToolTip="放弃产品修改">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowReset24" /><TextBlock Margin="6,0,0,0" Text="放弃" /></StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ProductsToolbarButton}" ToolTip="刷新">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" /><TextBlock Margin="6,0,0,0" Text="刷新" /></StackPanel>
                </Button>
                <Button Command="{Binding OpenCategoryManagerCommand}" Style="{StaticResource ProductsToolbarButton}" ToolTip="产品分类管理">
                    <TextBlock Text="分类管理" />
                </Button>
            </StackPanel>

            <ui:ToggleSwitch Grid.Column="6"
                             OffContent="BOM 关闭"
                             OnContent="BOM 打开"
                             IsChecked="{Binding BomDrawer.IsOpen, Mode=OneWay}"
                             Command="{Binding BomDrawer.ToggleCommand}"
                             CommandParameter="{Binding SelectedLine}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:LookupTextBox Grid.Column="0" Placeholder="客户"
                                    SearchMode="Remote" SearchCommand="{Binding SearchCustomersCommand}"
                                    IsBusy="{Binding IsCustomerLookupBusy}" ItemsSource="{Binding CustomerCandidates}"
                                    DisplayMemberPath="CustomerCode" FilterMemberPaths="CustomerCode,CustomerName"
                                    SelectedValuePath="Uid" SelectedItem="{Binding FilterCustomer, Mode=TwoWay}" />
            <controls:LookupTextBox Grid.Column="2" Placeholder="颜色"
                                    SearchMode="Remote" SearchCommand="{Binding SearchColorsCommand}"
                                    IsBusy="{Binding IsColorLookupBusy}" ItemsSource="{Binding ColorCandidates}"
                                    DisplayMemberPath="ColorNameZh" FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                                    SelectedValuePath="Uid" SelectedItem="{Binding FilterColor, Mode=TwoWay}" />
            <controls:LookupTextBox Grid.Column="4" Placeholder="产品分类"
                                    SearchMode="Local" ItemsSource="{Binding CategoryCandidates}"
                                    DisplayMemberPath="CategoryName" FilterMemberPaths="CategoryName,CategoryCode"
                                    SelectedValuePath="Uid" SelectedItem="{Binding FilterCategory, Mode=TwoWay}" />
            <controls:LookupTextBox Grid.Column="6" Placeholder="物料类型"
                                    SearchMode="Local" ItemsSource="{Binding MaterialTypes}"
                                    SelectedItem="{Binding FilterMaterialType, Mode=TwoWay}" />
            <Button Grid.Column="8" Content="重置筛选" Command="{Binding ResetFiltersCommand}" MinHeight="32" Padding="8,4" />
        </Grid>

        <controls:RightDrawerHost Grid.Row="4"
                                  DisplayMode="Overlay"
                                  DrawerWidth="520"
                                  MinDrawerWidth="360"
                                  IsResizable="True"
                                  IsOpen="{Binding BomDrawer.IsOpen, Mode=OneWay}"
                                  CloseCommand="{Binding BomDrawer.CloseCommand}">
            <controls:RightDrawerHost.MainContent>
                <DataGrid
                          ItemsSource="{Binding Products.Items}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          FrozenColumnCount="4" RowHeight="56"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True"
                          gridOperations:GridOperations.IsEnabled="True"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                          gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>
                        <gridColumns:CheckBoxDataGridColumn Width="36"
                                                            HeaderStyle="{StaticResource SwiftExportDataGridCheckBoxColumnHeader}"
                                                            HeaderCheckBoxWidth="16" HeaderCheckBoxHeight="16"
                                                            CellCheckBoxWidth="16" CellCheckBoxHeight="16"
                                                            HeaderCheckBoxStyle="{StaticResource SwiftExportDataGridCompactCheckBox}"
                                                            CellCheckBoxStyle="{StaticResource SwiftExportDataGridCompactCheckBox}"
                                                            ItemCheckBinding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            AllCheckBinding="{Binding DataContext.Products.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
                        <DataGridTemplateColumn Header="图片" Width="64" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <imageControls:CachedImage Width="48" Height="48" Margin="2"
                                                               Style="{StaticResource SwiftExportCachedImage}"
                                                               Stretch="Uniform" DecodePixelWidth="96"
                                                               SourcePath="{Binding MainImage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="SKU" Width="130" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="主SKU" Width="120" Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="英文描述" Width="180" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="中文描述" Width="180" Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="颜色" Width="120"
                                            Binding="{Binding Finish, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="分类" Width="130"
                                            Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridComboBoxColumn Header="物料类型" Width="100"
                                                ItemsSource="{Binding Source={StaticResource ProductMaterialTypesView}}"
                                                SelectedItemBinding="{Binding MaterialType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        
                        <DataGridComboBoxColumn Header="供货类型" Width="100"
                                                ItemsSource="{Binding Source={StaticResource ProductSupplyTypesView}}"
                                                SelectedItemBinding="{Binding SupplyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        
                        <DataGridTextColumn Header="BOM" Width="110" Binding="{Binding BomNo, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
                        
                        <DataGridTextColumn Header="客户代码" Width="110"
                                            Binding="{Binding DefaultCustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="客户型号" Width="120" Binding="{Binding DefaultCustomerSku, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>
                        
                        <DataGridTextColumn Header="供应商代码" Width="110"
                                            Binding="{Binding DefaultSupplierCode, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="供应商型号" Width="120" 
                                            Binding="{Binding DefaultSupplierSku, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
                        
                        <DataGridTextColumn Header="人民币价" Width="100" 
                                            Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        
                        <DataGridTextColumn Header="美元价" Width="100" 
                                            Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        
                        <DataGridTextColumn Header="备注" Width="180" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContent>
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增" Command="{Binding BomDrawer.AddItemCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0" />
                            <Button Content="保存" Command="{Binding BomDrawer.SaveCommand}" Margin="0,0,4,0" />
                            <Button Content="删除" Command="{Binding BomDrawer.DeleteItemCommand}" Margin="0,0,4,0" />
                            <Button Content="放弃" Command="{Binding BomDrawer.RejectCommand}" Margin="0,0,4,0" />
                            <Button Content="刷新" Command="{Binding BomDrawer.RefreshCommand}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭" Command="{Binding BomDrawer.CloseCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding BomDrawer.StatusText}" Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding BomDrawer.Boms.Items}" SelectedItem="{Binding BomDrawer.SelectedLine, Mode=TwoWay}"
                              Style="{StaticResource SwiftExportDataGrid}" RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              RowHeight="48" gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True" gridValidation:GridValidation.IsEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="图片" Width="56" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <imageControls:CachedImage Width="40" Height="40"
                                                           Style="{StaticResource SwiftExportCachedImage}"
                                                           DecodePixelWidth="96" SourcePath="{Binding MainImage}" Stretch="Uniform" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="子件 SKU" Width="130"
                                                Binding="{Binding SubSku, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                            <DataGridTextColumn Header="描述" Width="180" Binding="{Binding Description}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" />
                            <DataGridTextColumn Header="分子" Width="64" Binding="{Binding Numerator, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                            <DataGridTextColumn Header="分母" Width="64" Binding="{Binding Denominator, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                            <DataGridTextColumn Header="备注" Width="140" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </controls:RightDrawerHost.DrawerContent>

        </controls:RightDrawerHost>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
