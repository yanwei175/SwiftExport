<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
             xmlns:resourceProxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:imageControls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
             d:Height="800">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <resourceProxies:BindingProxy x:Key="ProductsViewModelProxy" Data="{Binding}" />
        <DataTemplate x:Key="ProductUnitOptionTemplate">
            <StackPanel Margin="0,0" Orientation="Horizontal">
                <TextBlock Text="{Binding DataNameEn}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DataNameZh}" Margin="4,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ProductsToolbarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="物料管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="采购单号、来源单号、SKU 等关键词">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="清空" Command="{Binding ResetFiltersCommand}" Margin="8,0,0,0"
                               VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>

            </Grid>
            
            
            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">
                        
                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Appearance="Primary"
                                   Command="{Binding AddRowCommand}"
                                   Content="新增"
                                   ToolTip="新增产品">
                        </ui:Button>

                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Appearance="Success"
                                   Content="保存"
                                   Command="{Binding SaveCommand}"
                                   ToolTip="保存产品">
                        </ui:Button>

                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Content="删除"
                                   Command="{Binding DeleteSelectedCommand}"
                                   ToolTip="删除产品"/>

                        <ui:Button Content="放弃修改" Margin="0,0,8,0" MinWidth="70"  
                                   Appearance="Transparent"
                                Command="{Binding RejectProductChangesCommand}" 
                                ToolTip="放弃产品修改"/>

                        <controls:LookupTextBox Width="120" Margin="0,0,8,0"
                                    Placeholder="客户"
                                    SearchMode="Remote" 
                                    ClearSelectionOnEdit="False"
                                    SearchCommand="{Binding SearchCustomersCommand}"
                                    IsBusy="{Binding IsCustomerLookupBusy}" 
                                    ItemsSource="{Binding CustomerCandidates}"
                                    DisplayMemberPath="CustomerCode" 
                                    FilterMemberPaths="CustomerCode,CustomerName"
                                    SelectedValuePath="Uid" 
                                    SelectedItem="{Binding FilterCustomer, Mode=TwoWay}" />

                        <controls:LookupTextBox  Width="120" Margin="0,0,8,0" Placeholder="颜色"
                                    ClearSelectionOnEdit="False"
                                    SearchMode="Local"
                                    ShowDropDownButton="True"
                                    ItemsSource="{Binding ReferenceDataCache.ProductColors}"
                                    DisplayMemberPath="ColorNameZh" 
                                    FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                                    SelectedValuePath="Uid" SelectedItem="{Binding FilterColor, Mode=TwoWay}" />
                        

                        <productComponents:ProductCategoryLookupTextBox Width="120" Margin="0,0,8,0"
                                    Placeholder="产品分类"
                                    ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                                    SelectedCategory="{Binding FilterCategory, Mode=TwoWay}"
                                    RefreshCommand="{Binding RefreshProductCategoriesCommand}"
                                    IsRefreshing="{Binding IsCategoryCacheRefreshing}" />

                        <controls:DropDownCheckBox  Width="120" Margin="0,0,8,0"
                                       ShowClearOption="True"
                                       Placeholder="物料类型"
                                       ItemsSource="{Binding MaterialTypes}"
                                       SelectedItems="{Binding FilterMaterialTypes, Mode=OneWay}" />
                        
                        <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        
                        <ui:ToggleSwitch VerticalAlignment="Center"
                                 OffContent="简单字段"
                                 OnContent="复杂字段"
                                 IsChecked="{Binding IsComplexFieldMode, Mode=TwoWay}" />
                        
                        <ui:ToggleSwitch Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                        
                        <ui:ToggleSwitch Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         OffContent="BOM 关闭"
                                         OnContent="BOM 打开"
                                         IsChecked="{Binding BomDrawer.IsOpen, Mode=OneWay}"
                                         Command="{Binding BomDrawer.ToggleCommand}"
                                         CommandParameter="{Binding SelectedLine}" />
                    </StackPanel>

                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                   Placement="Bottom"
                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                   Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                   VerticalOffset="4"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" MinHeight="120">

                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">

                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>
        
        <controls:RightDrawerHost Grid.Row="2"
                                  DisplayMode="Overlay"
                                  DrawerWidth="820"
                                  MinDrawerWidth="360"
                                  IsResizable="True"
                                  IsOpen="{Binding BomDrawer.IsOpen, Mode=OneWay}"
                                  CloseCommand="{Binding BomDrawer.CloseCommand}">
            <controls:RightDrawerHost.MainContent>
                <Grid>
                    <DataGrid ItemsSource="{Binding Products.Items}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          IsReadOnly="{Binding IsReadOnly}"
                          SelectionMode="Extended"
                          SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                          FrozenColumnCount="4"                           
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True"
                          gridOperations:GridOperations.IsEnabled="True"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                          gridValidation:GridValidation.IsEnabled="True">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                        IsChecked="{Binding DataContext.Products.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                        HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,0" 
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="图片" Width="64"
                                                CanUserSort="False"
                                                gridColumns:GridColumn.Key="main-image"
                                                gridColumns:GridColumn.FieldPath="MainImage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <imageControls:CachedImage Width="48" Height="48" Margin="2"
                                                               Style="{StaticResource SwiftExportCachedImage}"
                                                               Stretch="Uniform" DecodePixelWidth="96"
                                                               SourcePath="{Binding MainImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SwiftExportDataGridTextBox}"
                                             ToolTip="{Binding MainImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="主产品型号" Width="110" Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="master-sku" />

                            <DataGridTextColumn Header="产品型号" Width="120"
                                            Binding="{Binding LinkSku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="link-sku" />

                            <DataGridTextColumn Header="物料编号" Width="130" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="product-sku" />

                            <DataGridTextColumn Header="英文描述" Width="180" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="description-en" />

                            <DataGridTextColumn Header="中文描述" Width="180" Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" 
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="description-zh" />

                            <DataGridTextColumn Header="中文配置" Width="180"
                                            Binding="{Binding FeaturesZh, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            gridColumns:GridColumn.Key="features-zh" />

                            <DataGridTextColumn Header="英文配置" Width="180"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            gridColumns:GridColumn.Key="features-en" />

                            <DataGridTemplateColumn Header="颜色" Width="120"
                                                SortMemberPath="Finish"
                                                gridColumns:GridColumn.FillDownFieldPaths="ColorId,Finish"
                                                gridColumns:GridColumn.Key="finish">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Finish}" Style="{StaticResource SwiftExportDataGridTextBlock}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductColorLookupTextBox
                                        Text="{Binding Finish, Mode=OneWay}"
                                        FontSize="10"
                                        ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWayToSource}"
                                        SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        SelectionCommittedCommandParameter="{Binding}"
                                        SelectionClearedCommand="{Binding DataContext.ClearColorCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        SelectionClearedCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="分类" Width="110"
                                                SortMemberPath="CategoryName"
                                                gridColumns:GridColumn.Key="category-name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}"
                                               Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="物料类型" 
                                                Width="100"
                                                gridColumns:GridColumn.Key="material-type"
                                                gridColumns:GridColumn.FieldPath="MaterialType"
                                                SortMemberPath="MaterialType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="6" VerticalContentAlignment="Center"
                                        ItemsSource="{x:Static staticEnums:MaterialTypesEnum.MaterialTypes}"
                                        SelectedValue="{Binding MaterialType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="基础单位"
                                                Width="110"
                                                SortMemberPath="Unit"
                                                gridColumns:GridColumn.Key="product-unit"
                                                gridColumns:GridColumn.FieldPath="Unit">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="6" VerticalContentAlignment="Center"
                                              ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              ItemTemplate="{StaticResource ProductUnitOptionTemplate}"
                                              SelectedValuePath="DataNameEn"
                                              SelectedValue="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="供货类型" Width="90" 
                                                gridColumns:GridColumn.Key="supply-type"
                                                gridColumns:GridColumn.FieldPath="SupplyType"
                                                SortMemberPath="SupplyType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="6" VerticalContentAlignment="Center"
                                        ItemsSource="{x:Static staticEnums:SupplyTypeEnums.SupplyTypes}"
                                        SelectedValue="{Binding SupplyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTextColumn Header="BOM" Width="110"
                                            Binding="{Binding BomNo, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            gridColumns:GridColumn.Key="bom-no" />

                            <DataGridTextColumn Header="BOM版本" Width="80"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding BomVersion, UpdateSourceTrigger=LostFocus}"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="bom-version" />

                            <DataGridTextColumn Header="客户代码" Width="80"
                                            Binding="{Binding DefaultCustomerCode, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="default-customer-code" />

                            <DataGridTextColumn Header="客户型号" Width="120"
                                            Binding="{Binding DefaultCustomerSku, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="default-customer-sku" />

                            <DataGridTemplateColumn Header="默认供应商" Width="90"
                                                SortMemberPath="DefaultSupplierCode"
                                                gridColumns:GridColumn.Key="default-supplier-code"
                                                gridColumns:GridColumn.FillDownFieldPaths="DefaultSupplierId,DefaultSupplierCode,SupplierName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DefaultSupplierCode}"
                                               ToolTip="{Binding SupplierName}"
                                               Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierLookupTextBox 
                                                        Text="{Binding DefaultSupplierCode, Mode=OneWay}"
                                                        ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                        SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        SelectionCommittedCommandParameter="{Binding}"
                                                        SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        SelectionClearedCommandParameter="{Binding}"
                                                        IsBusy="{Binding DataContext.IsSupplierLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="供应商名称" Width="150" IsReadOnly="True"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding SupplierName, Mode=OneWay}"
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            gridColumns:GridColumn.Key="supplier-name" />

                            <DataGridTextColumn Header="供应商型号" Width="120" 
                                            Binding="{Binding DefaultSupplierSku, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                            gridColumns:GridColumn.Key="default-supplier-sku" />

                            <DataGridTextColumn Header="人民币价" Width="80" 
                                            Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="cny-price" />

                            <DataGridTextColumn Header="美元价" Width="80" 
                                            Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="usd-price" />

                            <DataGridTextColumn Header="装箱数" Width="90"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding PcsOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="pcs-of-carton" />

                            <DataGridTextColumn Header="箱净重" Width="90"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding NwOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="nw-of-carton" />

                            <DataGridTextColumn Header="箱毛重" Width="90"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding GwOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="gw-of-carton" />

                            <DataGridTextColumn Header="箱体积" Width="90"
                                            Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Binding="{Binding CbmOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N3}"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            gridColumns:GridColumn.Key="cbm-of-carton" />

                            <DataGridTextColumn Header="备注" Width="180" Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            gridColumns:GridColumn.Key="note" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Panel.ZIndex="10"
                            Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                            BorderThickness="{StaticResource SwiftExportBorderThickness}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                            d:IsHidden="True">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ui:ProgressRing Width="32"
                                             Height="32"
                                             IsIndeterminate="True" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding BusyMessage, FallbackValue=正在加载产品资料...}"
                                       Style="{StaticResource BodyTextBlock}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContent>
                <Grid Margin="8" Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}" RowDefinitions="Auto,8,Auto,8,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="新增" Command="{Binding BomDrawer.AddItemCommand}"  Margin="0,0,8,0" MinWidth="70"/>
                            <ui:Button Content="保存" Command="{Binding BomDrawer.SaveCommand}"     Margin="0,0,8,0" MinWidth="70" Appearance="Primary" />
                            <ui:Button Content="删除" Command="{Binding BomDrawer.DeleteItemCommand}" Margin="0,0,8,0" MinWidth="70"/>
                            <ui:Button Content="放弃" Command="{Binding BomDrawer.RejectCommand}" Margin="0,0,8,0" MinWidth="70"/>
                            <ui:Button Content="刷新" Command="{Binding BomDrawer.RefreshCommand}" Margin="0,0,8,0" MinWidth="70"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="关闭" Command="{Binding BomDrawer.CloseCommand}" MinWidth="70"/>
                    </Grid>
                    
                    <TextBlock Grid.Row="2" Text="{Binding BomDrawer.StatusText}" Style="{StaticResource CaptionTextBlock}" 
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                    
                    <DataGrid Grid.Row="4" 
                              ItemsSource="{Binding BomDrawer.Boms.Items}" 
                              SelectedItem="{Binding BomDrawer.SelectedLine, Mode=TwoWay}"
                              Style="{StaticResource SwiftExportDataGrid}" 
                              RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              RowHeight="45" 
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              gridCore:EnterpriseGrid.IsEnabled="True" 
                              gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True" 
                              gridValidation:GridValidation.IsEnabled="True">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="图片" Width="56" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <imageControls:CachedImage Width="40" Height="40"
                                                               Style="{StaticResource SwiftExportCachedImage}"
                                                               DecodePixelWidth="96" SourcePath="{Binding MainImage}" Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="子件 SKU" Width="160"
                                                    SortMemberPath="SubSku"
                                                    gridColumns:GridColumn.Key="bom-sub-sku">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SubSku}"
                                                   Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <!--
                                            Lookup 只在当前单元格编辑时创建；不声明 FieldPath，
                                            避免 Ctrl+D 只复制 SKU 而遗漏产品 Id、图片等组合字段。
                                        -->
                                        <productComponents:ProductLookupTextBox
                                            Text="{Binding SubSku, Mode=OneWay}"
                                            ItemsSource="{Binding DataContext.BomDrawer.ProductCandidates, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectedProduct="{Binding DataContext.BomDrawer.SelectedCandidate, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWayToSource}"
                                            SearchCommand="{Binding DataContext.BomDrawer.SearchProductsCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectionCommittedCommand="{Binding DataContext.BomDrawer.CommitProductCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            IsBusy="{Binding DataContext.BomDrawer.IsLookupBusy, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="描述" Width="180" Binding="{Binding Description}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                            <DataGridTextColumn Header="用量(分子)" Width="80" 
                                                Binding="{Binding Numerator, UpdateSourceTrigger=PropertyChanged}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />

                            <DataGridTextColumn Header="底数(分母)" Width="80" 
                                                Binding="{Binding Denominator, UpdateSourceTrigger=PropertyChanged}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />

                            <DataGridTextColumn Header="备注" Width="*" 
                                                Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </controls:RightDrawerHost.DrawerContent>

        </controls:RightDrawerHost>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" FontSize="12" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
