<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="clr-namespace:SwiftExportClient.Controls"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridEditing="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Editing;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridFilter="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Filtering;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridNumeric="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns.Numeric;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource BodyTextBlock}"
                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource SwiftExportBrush.Surface}"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="{StaticResource SwiftExportBorderThickness}"
                CornerRadius="{StaticResource SwiftExportCornerRadius}"
                Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="关键词"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="240" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="分类"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="材质"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="160" />
                </StackPanel>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="查询"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="96" />
                    <Button Content="重置"
                            Command="{Binding ResetCommand}"
                            MinWidth="96"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Content="新增"
                        Command="{Binding AddRowCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96" />
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="删除"
                        Command="{Binding DeleteSelectedCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="撤销"
                        Command="{Binding RejectChangesCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="分类管理"
                        Command="{Binding OpenCategoryManagerCommand}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding ResultSummary}"
                       Style="{StaticResource CaptionTextBlock}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="6" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <gridFilter:GridFilterRow Grid.Row="0"
                                      TargetGrid="{Binding ElementName=ProductsGrid}"
                                      FilterDelay="0:0:0.3" />
            <DataGrid x:Name="ProductsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Lines.Items}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  IsReadOnly="False"
                  CanUserSortColumns="True"
                  gridCore:EnterpriseGrid.IsEnabled="True"
                  gridEditing:GridEditing.IsEnabled="True"
                  gridFilter:GridFilter.Mode="Local"
                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                  gridValidation:GridValidation.IsEnabled="True"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"
                                    gridColumns:GridColumn.Key="row-index"
                                    gridColumns:GridColumn.CanFilter="False"
                                    Binding="{Binding RowIndex}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="48"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="SKU"
                                    gridColumns:GridColumn.Key="sku"
                                    Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="140" />
                <DataGridTextColumn Header="主 SKU"
                                    gridColumns:GridColumn.Key="master-sku"
                                    Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="140" />
                <DataGridTextColumn Header="英文描述"
                                    gridColumns:GridColumn.Key="description-en"
                                    Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="2*" />
                <DataGridTextColumn Header="中文描述"
                                    gridColumns:GridColumn.Key="description-zh"
                                    Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="2*" />
                <DataGridTextColumn Header="分类"
                                    gridColumns:GridColumn.Key="category-name"
                                    Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="140" />
                <DataGridTextColumn Header="材质"
                                    gridColumns:GridColumn.Key="material-type"
                                    Binding="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="120" />
                <DataGridTextColumn Header="供货类型"
                                    gridColumns:GridColumn.Key="supply-type"
                                    Binding="{Binding SupplyType, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="120" />
                <DataGridTextColumn Header="BOM"
                                    gridColumns:GridColumn.Key="bom-no"
                                    Binding="{Binding BomNo, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Width="120" />
                <gridNumeric:NumericDataGridColumn Header="人民币价"
                                                   gridColumns:GridColumn.Key="cny-price"
                                                   gridFilter:GridFilter.Operator="Equals"
                                                   Binding="{Binding CnyPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                   Minimum="0"
                                                   MaximumDecimalPlaces="2"
                                                   ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                   EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                   Width="100" />
                <gridNumeric:NumericDataGridColumn Header="美元价"
                                                   gridColumns:GridColumn.Key="usd-price"
                                                   gridFilter:GridFilter.Operator="Equals"
                                                   Binding="{Binding UsdPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                   Minimum="0"
                                                   MaximumDecimalPlaces="2"
                                                   ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                   EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                   Width="100" />
                <DataGridTextColumn Header="备注"
                                    gridColumns:GridColumn.Key="note"
                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridPopupTextBoxEditingStyle}"
                                    Width="2*" />
            </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PageStatus}"
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text=" · "
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding ValidationSummary}"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>

            <controls:PageNavigator Grid.Column="1"
                                    TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex, Mode=OneWay}"
                                    PageSize="{Binding PageSize, Mode=OneWay}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
