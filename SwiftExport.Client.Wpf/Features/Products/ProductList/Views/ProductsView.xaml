<UserControl
    x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:imageControls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
    xmlns:resourceProxies="clr-namespace:SwiftExportClient.Resources.Proxies"
    xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
    xmlns:warehouseComponents="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Components"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
    d:Height="800"
    d:Width="1300"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SelectionCheckMenuItem"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <resourceProxies:BindingProxy x:Key="ProductsViewModelProxy" Data="{Binding}" />

        <DataTemplate x:Key="ProductUnitOptionTemplate">
            <StackPanel Margin="0,0" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding DataNameEn}" />
                <TextBlock
                    Margin="4,0"
                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                    Text="{Binding DataNameZh}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <Style
            x:Key="ProductsToolbarButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="物料管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="采购单号、来源单号、SKU 等关键词"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding ResetFiltersCommand}"
                        Content="清空" />
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding AddRowCommand}"
                            Content="新增"
                            ToolTip="新增产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="编辑当前物料详情"
                            Command="{Binding OpenDetailCommand}"
                            Content="编辑"
                            ToolTip="打开当前物料详情" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Success"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            ToolTip="保存产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除"
                            ToolTip="删除产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding RejectProductChangesCommand}"
                            Content="放弃修改"
                            ToolTip="放弃产品修改" />

                        <filter:MultiSelectLookupButton
                            Width="120"
                            Margin="0,0,8,0"
                            DisplayMemberPath="CustomerName"
                            FilterMemberPaths="CustomerCode,CustomerName"
                            Header="客户"
                            ItemsSource="{Binding ReferenceDataCache.Customers}"
                            SelectedItems="{Binding FilterCustomerList}"
                            SelectedValuePath="Uid"
                            SelectionCommittedCommand="{Binding SearchCommand}"
                            ShowSearchBox="True" />

                        <filter:MultiSelectLookupButton
                            Width="120"
                            Margin="0,0,8,0"
                            DisplayMemberPath="ColorNameZh"
                            FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                            Header="颜色"
                            ItemsSource="{Binding ReferenceDataCache.ProductColors}"
                            SelectedItems="{Binding FilterColorList}"
                            SelectedValuePath="Uid"
                            SelectionCommittedCommand="{Binding SearchCommand}"
                            ShowSearchBox="True" />

                        <productComponents:ProductCategoryMutiSelectButton
                            Width="120"
                            Margin="0,0,8,0"
                            Header="分类"
                            ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                            SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                            SelectionCommittedCommand="{Binding SearchCommand}" />

                        <controls:DropDownCheckBox
                            Width="120"
                            Margin="0,0,8,0"
                            ItemsSource="{Binding MaterialTypes}"
                            Placeholder="物料类型"
                            SelectedItems="{Binding FilterMaterialTypes, Mode=OneWay}"
                            ShowClearOption="True" />

                        <ToggleButton
                            x:Name="OptionsToggleButton"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Content="更多条件" />

                        <ui:DropDownButton x:Name="MoreFunction" Content="更多功能">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu MinWidth="180" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding UploadImagesCommand}" Header="批量上传主图" />
                                    <Separator />
                                    <MenuItem Command="{Binding PullMasterDescriptionsCommand}" Header="从主型号拉取描述" />
                                    <MenuItem Command="{Binding PullMasterFeaturesCommand}" Header="从主型号拉取配置" />
                                    <MenuItem Command="{Binding PullMasterSupplierCommand}" Header="从主型号拉取供应商" />
                                    <MenuItem Command="{Binding PullMasterWeightVolumeCommand}" Header="从主型号拉取毛重和体积" />
                                    <MenuItem Command="{Binding PullMasterAllCommand}" Header="从主型号拉取全部资料" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </WrapPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <ui:ToggleSwitch
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsComplexFieldMode, Mode=TwoWay}"
                            OffContent="简单字段"
                            OnContent="复杂字段" />

                        <ui:ToggleSwitch
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                            OffContent="整行模式"
                            OnContent="格子模式" />

                        <ui:ToggleSwitch
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="{Binding BomDrawer.EntryHint}"
                            Command="{Binding BomDrawer.ToggleCommand}"
                            CommandParameter="{Binding SelectedLine}"
                            IsChecked="{Binding BomDrawer.IsOpen, Mode=OneWay}"
                            OffContent="快速BOM关"
                            OnContent="快速BOM开"
                            ToolTip="{Binding BomDrawer.EntryHint}"
                            ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>

                </DockPanel>

                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">
                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton
                                MinWidth="70"
                                VerticalAlignment="Top"
                                Content="关闭"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}" />

                            <StackPanel MinHeight="120" Orientation="Horizontal">
                                <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto,Auto" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <controls:RightDrawerHost
            Grid.Row="2"
            CloseCommand="{Binding BomDrawer.CloseCommand}"
            DisplayMode="Overlay"
            DrawerWidth="820"
            IsOpen="{Binding BomDrawer.IsOpen, Mode=OneWay}"
            IsResizable="True"
            MinDrawerWidth="360">
            <controls:RightDrawerHost.MainContent>
                <Grid>
                    <DataGrid
                        gridCore:GridRowHeader.ShowRowNumber="True"
                        FontSize="{StaticResource SwiftExportDefaltFontSize}"
                        FrozenColumnCount="4"
                        IsEnabled="{Binding IsNotBusy}"
                        IsReadOnly="{Binding IsReadOnly}"
                        ItemsSource="{Binding Products.Items}"
                        Loaded="OnProductGridLoaded"
                        RowHeight="{StaticResource DataGridRowHeightMedium}"
                        RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                        SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                        SelectionMode="Extended"
                        SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                        Style="{StaticResource SwiftExportDataGrid}"
                        Unloaded="OnProductGridUnloaded">
                        <i:Interaction.Behaviors>
                            <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                            <fill:DataGridColumnVisibilityBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ContextMenu>
                            <ContextMenu AutomationProperties.Name="物料当前页列表操作" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding CheckSelectionCommand}"
                                    Header="勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding UncheckSelectionCommand}"
                                    Header="取消勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Square24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertSelectionCommand}"
                                    Header="反选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding CheckVisibleCommand}"
                                    Header="全选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOn24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertVisibleCommand}"
                                    Header="反选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOff24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding OpenDetailCommand}" Header="物料详情">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Edit24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding DeleteSelectedCommand}" Header="删除">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Header="表格模式"
                                    IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                                    Style="{StaticResource ToggleMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Table24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>

                            <DataGridTemplateColumn
                                Width="45"
                                CanUserSort="False"
                                ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                                HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="勾选物料当前页显示行"
                                            Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                            IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,0"
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="64"
                                CanUserSort="False"
                                Header="图片">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <imageControls:CachedImage
                                            Width="48"
                                            Height="48"
                                            Margin="2"
                                            DecodePixelWidth="96"
                                            SourcePath="{Binding MainImage}"
                                            Stretch="Uniform"
                                            Style="{StaticResource SwiftExportCachedImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Style="{StaticResource SwiftExportDataGridTextBox}"
                                            Text="{Binding MainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding MainImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="110"
                                fill:DataGridFillDownBehavior.Field="ProductMasterId"
                                ClipboardContentBinding="{Binding MasterSku, Mode=OneWay}"
                                Header="主产品型号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding MasterSku}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button
                                                AutomationProperties.Name="清除失效主型号引用"
                                                Command="{Binding DataContext.ClearProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="清除"
                                                DockPanel.Dock="Right">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MasterSku}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProductMasterId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <productComponents:ProductMasterLookupTextBox
                                                IsBusy="{Binding DataContext.IsProductMasterLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ItemsSource="{Binding DataContext.ProductMasterCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SearchCommand="{Binding DataContext.SearchProductMastersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectedProductMaster="{Binding DataContext.EditProductMaster, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                SelectionClearedCommand="{Binding DataContext.ClearProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionClearedCommandParameter="{Binding}"
                                                SelectionCommittedCommand="{Binding DataContext.CommitProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionCommittedCommandParameter="{Binding}"
                                                Text="{Binding MasterSku, Mode=OneWay}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="150"
                                fill:DataGridFillDownBehavior.Field="LinkSku"
                                ClipboardContentBinding="{Binding LinkSku, Mode=OneWay}"
                                Header="产品型号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding LinkSku}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductNeutralLookupTextBox
                                            IsBusy="{Binding DataContext.IsProductNeutralLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ItemsSource="{Binding DataContext.ProductNeutralCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            RequireItemMatch="False"
                                            SearchCommand="{Binding DataContext.SearchProductNeutralsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedProductNeutral="{Binding DataContext.EditProductNeutral, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearProductNeutralCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitProductNeutralCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding LinkSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                Header="物料编号" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="DescriptionEn"
                                Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="英文描述"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="DescriptionZh"
                                Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="中文描述" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="FeaturesZh"
                                Binding="{Binding FeaturesZh, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="中文配置" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="FeaturesEn"
                                Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="英文配置"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTemplateColumn
                                Width="120"
                                fill:DataGridFillDownBehavior.Field="ColorId"
                                ClipboardContentBinding="{Binding Finish, Mode=OneWay}"
                                Header="颜色"
                                SortMemberPath="Finish">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding Finish}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductColorLookupTextBox
                                            FontSize="10"
                                            ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearColorCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding Finish, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="110"
                                ClipboardContentBinding="{Binding CategoryName, Mode=OneWay}"
                                Header="分类"
                                SortMemberPath="CategoryName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding CategoryName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="100"
                                fill:DataGridFillDownBehavior.Field="MaterialType"
                                ClipboardContentBinding="{Binding MaterialType, Mode=OneWay}"
                                Header="物料类型"
                                SortMemberPath="MaterialType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Margin="6"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{x:Static staticEnums:MaterialTypesEnum.MaterialTypes}"
                                            SelectedValue="{Binding MaterialType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="110"
                                fill:DataGridFillDownBehavior.Field="Unit"
                                ClipboardContentBinding="{Binding Unit, Mode=OneWay}"
                                Header="基础单位"
                                SortMemberPath="Unit">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Margin="6"
                                            VerticalContentAlignment="Center"
                                            ItemTemplate="{StaticResource ProductUnitOptionTemplate}"
                                            ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectedValue="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="DataNameEn" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="SupplyType"
                                ClipboardContentBinding="{Binding SupplyType, Mode=OneWay}"
                                Header="供货类型"
                                SortMemberPath="SupplyType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Margin="6"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{x:Static staticEnums:SupplyTypeEnums.SupplyTypes}"
                                            SelectedValue="{Binding SupplyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn
                                Width="110"
                                gridCore:GridValidation.FieldPath="BomNo"
                                ClipboardContentBinding="{Binding BomNo, Mode=OneWay}"
                                Header="BOM"
                                SortMemberPath="BomNo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding BomNo}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox AutomationProperties.Name="自定义 BOM 编号" Text="{Binding BomNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style BasedOn="{StaticResource SwiftExportDataGridWarpTextBox}" TargetType="TextBox">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditBomNo}" Value="True">
                                                            <Setter Property="IsReadOnly" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="90"
                                gridCore:GridValidation.FieldPath="RequiresBom"
                                ClipboardContentBinding="{Binding RequiresBom, Mode=OneWay}"
                                Header="需要 BOM"
                                SortMemberPath="BomVersion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.HelpText="{Binding BomRequirementHint}"
                                            AutomationProperties.Name="需要 BOM"
                                            IsChecked="{Binding RequiresBom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding BomRequirementHint}"
                                            ToolTipService.ShowOnDisabled="True">
                                            <CheckBox.Style>
                                                <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CanChangeBomRequirement}" Value="True" />
                                                                <Condition Binding="{Binding Data.CanWrite, Source={StaticResource ProductsViewModelProxy}}" Value="True" />
                                                                <Condition Binding="{Binding Data.IsNotBusy, Source={StaticResource ProductsViewModelProxy}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="IsEnabled" Value="True" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="DefaultSupplierId"
                                ClipboardContentBinding="{Binding DefaultSupplierCode, Mode=OneWay}"
                                Header="默认供应商"
                                SortMemberPath="DefaultSupplierCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Style="{StaticResource SwiftExportDataGridTextBlock}"
                                            Text="{Binding DefaultSupplierCode}"
                                            ToolTip="{Binding SupplierName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierLookupTextBox
                                            IsBusy="{Binding DataContext.IsSupplierLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding DefaultSupplierCode, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding SupplierName, Mode=OneWay}"
                                ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                Header="供应商名称"
                                IsReadOnly="True"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTemplateColumn
                                Width="120"
                                fill:DataGridFillDownBehavior.Field="ManufacturerId"
                                ClipboardContentBinding="{Binding ManufacturerCode, Mode=OneWay}"
                                Header="制造商"
                                SortMemberPath="ManufacturerCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ManufacturerCode}" ToolTip="{Binding ManufacturerName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierLookupTextBox
                                            IsBusy="{Binding DataContext.IsSupplierLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedSupplier="{Binding DataContext.EditManufacturer, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearManufacturerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitManufacturerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding ManufacturerCode, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="140"
                                fill:DataGridFillDownBehavior.Field="ManufacturerModel"
                                Binding="{Binding ManufacturerModel, UpdateSourceTrigger=PropertyChanged}"
                                Header="制造商型号" />
                            <DataGridTemplateColumn
                                Width="160"
                                fill:DataGridFillDownBehavior.Field="DefaultWarehouseSiteId"
                                ClipboardContentBinding="{Binding DefaultWarehouseCode, Mode=OneWay}"
                                Header="产品默认仓库（参考）"
                                SortMemberPath="DefaultWarehouseCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DefaultWarehouseCode}" ToolTip="{Binding DefaultWarehouseName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <warehouseComponents:WarehouseAutoSuggestComboBox
                                            ItemsSource="{Binding DataContext.WarehouseCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedWarehouse="{Binding DataContext.EditWarehouse, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding DefaultWarehouseCode, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="80"
                                fill:DataGridFillDownBehavior.Field="CnyPrice"
                                Binding="{Binding CnyPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="人民币价" />

                            <DataGridTextColumn
                                Width="80"
                                fill:DataGridFillDownBehavior.Field="UsdPrice"
                                Binding="{Binding UsdPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="美元价" />

                            <DataGridTextColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="PcsOfCarton"
                                Binding="{Binding PcsOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="装箱数"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="NwOfCarton"
                                Binding="{Binding NwOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="箱净重"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="GwOfCarton"
                                Binding="{Binding GwOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="箱毛重"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="CbmOfCarton"
                                Binding="{Binding CbmOfCarton, UpdateSourceTrigger=LostFocus, StringFormat=N3}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="箱体积"
                                Visibility="{Binding Data.IsComplexFieldMode, Source={StaticResource ProductsViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="Note"
                                Binding="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="备注" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border
                        Panel.ZIndex="10"
                        d:IsHidden="True"
                        Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource SwiftExportBorderThickness}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing
                                Width="32"
                                Height="32"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource BodyTextBlock}"
                                Text="{Binding BusyMessage, FallbackValue=正在加载产品资料...}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContent>
                <Grid
                    Margin="8"
                    Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                    RowDefinitions="Auto,8,Auto,8,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding BomDrawer.AddItemCommand}"
                                Content="新增" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding BomDrawer.SaveCommand}"
                                Content="保存" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding BomDrawer.DeleteItemCommand}"
                                Content="删除" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding BomDrawer.RejectCommand}"
                                Content="放弃" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding BomDrawer.RefreshCommand}"
                                Content="刷新" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="1"
                            MinWidth="70"
                            Command="{Binding BomDrawer.CloseCommand}"
                            Content="关闭" />
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding BomDrawer.StatusText}" />

                    <DataGrid
                        Grid.Row="4"
                        gridCore:GridRowHeader.ShowRowNumber="True"
                        FontSize="{StaticResource SwiftExportDefaltFontSize}"
                        ItemsSource="{Binding BomDrawer.Boms.Items}"
                        RowHeight="45"
                        RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                        SelectedItem="{Binding BomDrawer.SelectedLine, Mode=TwoWay}"
                        Style="{StaticResource SwiftExportDataGrid}">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn
                                Width="56"
                                Header="图片"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <imageControls:CachedImage
                                            Width="40"
                                            Height="40"
                                            DecodePixelWidth="96"
                                            SourcePath="{Binding MainImage}"
                                            Stretch="Uniform"
                                            Style="{StaticResource SwiftExportCachedImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="160"
                                ClipboardContentBinding="{Binding SubSku, Mode=OneWay}"
                                Header="子件 SKU"
                                SortMemberPath="SubSku">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding SubSku}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <!--
                                            Lookup 只在当前单元格编辑时创建；不声明 FieldPath，
                                            避免 Ctrl+D 只复制 SKU 而遗漏产品 Id、图片等组合字段。
                                        -->
                                        <productComponents:ProductLookupTextBox
                                            IsBusy="{Binding DataContext.BomDrawer.IsLookupBusy, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            ItemsSource="{Binding DataContext.BomDrawer.ProductCandidates, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SearchCommand="{Binding DataContext.BomDrawer.SearchProductsCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectedProduct="{Binding DataContext.BomDrawer.SelectedCandidate, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.BomDrawer.CommitProductCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding SubSku, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Description}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="描述" />

                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Numerator, UpdateSourceTrigger=PropertyChanged}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="用量(分子)" />

                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Denominator, UpdateSourceTrigger=PropertyChanged}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="底数(分母)" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                Header="备注" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </controls:RightDrawerHost.DrawerContent>

        </controls:RightDrawerHost>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Style="{StaticResource CaptionTextBlock}"
                Text="{Binding ResultSummary}" />
            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                FontSize="12"
                Style="{StaticResource CaptionTextBlock}"
                Text="{Binding PageStatus}" />
            <controls:PageNavigator
                Grid.Column="2"
                PageChangeCommand="{Binding PageChangeCommand}"
                PageSize="{Binding PageSize}"
                TotalCount="{Binding TotalCount}"
                PageIndex="{Binding PageIndex}" />
        </Grid>
    </Grid>
</UserControl>
