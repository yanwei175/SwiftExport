<UserControl
    x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductMasterManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
    xmlns:resourceProxies="clr-namespace:SwiftExportClient.Resources.Proxies"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
    d:DataContext="{d:DesignInstance vm:ProductMasterManagerViewModel}"
    d:Height="800"
    d:Width="1280"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SelectionCheckMenuItem"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <resourceProxies:BindingProxy x:Key="ProductMasterManagerViewModelProxy" Data="{Binding}" />

        <Style x:Key="ProductMasterCardItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="主产品管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="搜索主型号、描述、类型、标签或中性产品编码"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding AddRowCommand}"
                            Content="新增"
                            IsEnabled="{Binding IsCardView, Converter={StaticResource InverseBooleanConverter}}" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding OpenDetailCommand}"
                            Content="编辑" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="保存" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding RejectListChangesCommand}"
                            Content="放弃修改" />

                        <ui:DropDownButton Margin="0,0,8,0" Content="更多功能">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Command="{Binding PlacementTarget.DataContext.OpenImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="批量导入" />
                                    <MenuItem Command="{Binding PlacementTarget.DataContext.CreateDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="从详情新建" />
                                    <MenuItem Command="{Binding PlacementTarget.DataContext.SetMainImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="批量设置主图" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ToggleButton
                            x:Name="OptionsToggleButton"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Content="更多条件" />

                        <productComponents:ProductCategoryMutiSelectButton
                            Width="120"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="主产品分类筛选"
                            Header="分类"
                            ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                            SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                            SelectionCommittedCommand="{Binding ApplySelectedCategoriesCommand}"
                            ShowUncategorizedOption="True" />

                        <ui:ToggleSwitch
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsEnglishFieldsVisible, Mode=TwoWay}"
                            IsEnabled="{Binding IsCardView, Converter={StaticResource InverseBooleanConverter}}"
                            OffContent="隐藏英文"
                            OnContent="显示英文" />
                        <ui:ToggleSwitch
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                            IsEnabled="{Binding IsCardView, Converter={StaticResource InverseBooleanConverter}}"
                            OffContent="整行模式"
                            OnContent="格子模式" />
                        <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                            <ui:ToggleSwitch
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsCardView, Mode=TwoWay}"
                                OffContent="列表"
                                OnContent="卡片" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">
                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton
                                MinWidth="70"
                                VerticalAlignment="Top"
                                Content="关闭"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}" />

                            <StackPanel MinHeight="120" Orientation="Horizontal">
                                <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto,Auto" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>



        <Grid Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="6" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="4*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!--  主表和卡片切换内容行，分页及结果提示共用底部行。  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <DataGrid
                        x:Name="MasterGrid"
                        gridCore:GridRowHeader.ShowRowNumber="True"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="主型号可编辑列表"
                        FontSize="{StaticResource SwiftExportDefaltFontSize}"
                        FrozenColumnCount="2"
                        ItemsSource="{Binding Masters.Items}"
                        PreparingCellForEdit="OnMasterPreparingCellForEdit"
                        RowHeight="{StaticResource DataGridRowHeightMedium}"
                        RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                        SelectedItem="{Binding SelectedMaster, Mode=TwoWay}"
                        SelectionMode="Extended"
                        SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}">
                        <i:Interaction.Behaviors>
                            <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                            <fill:DataGridColumnVisibilityBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ContextMenu>
                            <ContextMenu AutomationProperties.Name="主型号当前页列表操作" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding CheckMasterSelectionCommand}"
                                    Header="勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding UncheckMasterSelectionCommand}"
                                    Header="取消勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Square24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertMasterSelectionCommand}"
                                    Header="反选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding CheckMasterVisibleCommand}"
                                    Header="全选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOn24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertMasterVisibleCommand}"
                                    Header="反选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOff24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding OpenDetailCommand}" Header="编辑详情">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Edit24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding DeleteSelectedCommand}" Header="删除">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Header="表格模式"
                                    IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                                    Style="{StaticResource ToggleMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Table24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Style>
                            <Style BasedOn="{StaticResource SwiftExportDataGrid}" TargetType="{x:Type DataGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="45"
                                CanUserSort="False"
                                ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                                HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="勾选主型号当前页显示行"
                                            Command="{Binding DataContext.SetMasterVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                            IsChecked="{Binding DataContext.IsAllMasterVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="72"
                                CanUserSort="False"
                                Header="图片"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage
                                            Width="52"
                                            Height="52"
                                            DecodePixelWidth="104"
                                            SourcePath="{Binding MainImagePath}"
                                            Stretch="Uniform"
                                            Style="{StaticResource SwiftExportCachedImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="主型号" />

                            <DataGridTextColumn
                                Width="190"
                                fill:DataGridFillDownBehavior.Field="DefaultDescriptionZh"
                                Binding="{Binding DefaultDescriptionZh, UpdateSourceTrigger=LostFocus}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="中文描述" />

                            <DataGridTextColumn
                                Width="190"
                                fill:DataGridFillDownBehavior.Field="DefaultDescriptionEn"
                                Binding="{Binding DefaultDescriptionEn, UpdateSourceTrigger=LostFocus}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="英文描述"
                                Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="DefaultFeaturesZh"
                                Binding="{Binding DefaultFeaturesZh, UpdateSourceTrigger=LostFocus}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="中文配置" />
                            <DataGridTextColumn
                                Width="180"
                                fill:DataGridFillDownBehavior.Field="DefaultFeaturesEn"
                                Binding="{Binding DefaultFeaturesEn, UpdateSourceTrigger=LostFocus}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="英文配置"
                                Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <DataGridTextColumn
                                Width="50"
                                fill:DataGridFillDownBehavior.Field="DefaultPcsPerPackage"
                                Binding="{Binding DefaultPcsPerPackage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="箱容" />

                            <DataGridTextColumn
                                Width="70"
                                fill:DataGridFillDownBehavior.Field="DefaultNetWeight"
                                Binding="{Binding DefaultNetWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="净重kg" />

                            <DataGridTextColumn
                                Width="70"
                                fill:DataGridFillDownBehavior.Field="DefaultGrossWeight"
                                Binding="{Binding DefaultGrossWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="毛重kg" />

                            <DataGridTextColumn
                                Width="70"
                                fill:DataGridFillDownBehavior.Field="DefaultCbm"
                                Binding="{Binding DefaultCbm, UpdateSourceTrigger=LostFocus, StringFormat=N3, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="体积m3" />


                            <DataGridTemplateColumn
                                Width="160"
                                fill:DataGridFillDownBehavior.Field="CategoryId"
                                ClipboardContentBinding="{Binding CategoryName, Mode=OneWay}"
                                Header="分类"
                                SortMemberPath="CategoryName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="未分类">
                                                            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductCategoryFlatLookupTextBox
                                            ItemsSource="{Binding DataContext.ReferenceDataCache.ProductCategories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedCategory="{Binding DataContext.EditCategory, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding CategoryName, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                x:Name="MasterSupplierColumn"
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="DefaultSupplierId"
                                ClipboardContentBinding="{Binding DefaultSupplierName, Mode=OneWay}"
                                Header="默认供应商">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding DefaultSupplierName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierAutoSuggestComboBox
                                            AutomationProperties.Name="当前主型号默认供应商"
                                            ItemsSource="{Binding DataContext.SupplierOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Placeholder="{Binding DefaultSupplierName}"
                                            SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                            SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            StretchToHost="True" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="150"
                                fill:DataGridFillDownBehavior.Field="ProductAttributeProfileId"
                                ClipboardContentBinding="{Binding ProductAttributeProfileName, Mode=OneWay}"
                                Header="属性模板"
                                SortMemberPath="ProductAttributeProfileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding ProductAttributeProfileName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductAttributeProfileLookupTextBox
                                            AutomationProperties.Name="当前主型号属性模板"
                                            ItemsSource="{Binding DataContext.ProfileCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedProfile="{Binding DataContext.EditProfile, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding ProductAttributeProfileName, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="140"
                                fill:DataGridFillDownBehavior.Field="ProductSeriesId"
                                ClipboardContentBinding="{Binding ProductSeriesName, Mode=OneWay}"
                                Header="产品系列"
                                SortMemberPath="ProductSeriesName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding ProductSeriesName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductSeriesAutoSuggestComboBox
                                            AutomationProperties.Name="当前主型号产品系列"
                                            ItemsSource="{Binding DataContext.SeriesCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Placeholder="产品系列（可空）"
                                            SelectedSeries="{Binding DataContext.EditSeries, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionClearedCommand="{Binding DataContext.ClearSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding ProductSeriesName, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="240"
                                Binding="{Binding TagSummary, Mode=OneWay}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="标签"
                                IsReadOnly="True" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ProductMasterCardItemStyle}"
                        ItemsSource="{Binding Masters.Items}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedMaster, Mode=TwoWay}">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="240"
                                    MinHeight="240"
                                    Margin="6"
                                    Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource SwiftExportCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource UserControlStrokeColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="210" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Padding="8"
                                            Background="White"
                                            CornerRadius="4,4,0,0">
                                            <controls:CachedImage
                                                Width="Auto"
                                                Height="Auto"
                                                DecodePixelWidth="800"
                                                SourcePath="{Binding MainImagePath}"
                                                Stretch="Uniform"
                                                Style="{StaticResource SwiftExportCachedImage}" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="12">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlock}"
                                                Text="{Binding MasterSku}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                MinHeight="40"
                                                MaxHeight="40"
                                                Margin="0,4,0,0"
                                                Style="{StaticResource BodyTextBlock}"
                                                Text="{Binding DefaultDescriptionEn}"
                                                TextWrapping="Wrap"
                                                ToolTip="{Binding DefaultDescriptionEn}" />

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="销售价" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                                                        Text="{Binding DefaultSalesPriceUsd, StringFormat=US$ {0:N2}, TargetNullValue=--}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource CaptionTextBlock}" Text="采购价" />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DefaultPurchasePriceCny, StringFormat=¥ {0:N2}, TargetNullValue=--}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                                    Text="{Binding DefaultSupplierName, StringFormat=供应商：{0}, TargetNullValue=供应商：--}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DefaultSupplierName}" />
                                                <ui:Button
                                                    Grid.Column="1"
                                                    Appearance="Primary"
                                                    Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Symbol=Search24}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding ResultSummary}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                                Style="{StaticResource CaptionTextBlock}"
                                Text="{Binding ValidationSummary}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Text="{Binding PageStatus}" />
                        <controls:PageNavigator
                            Grid.Column="2"
                            PageChangeCommand="{Binding PageChangeCommand}"
                            PageSize="{Binding PageSize}"
                            TotalCount="{Binding TotalCount}"
                            PageIndex="{Binding PageIndex}" />
                    </Grid>

                </Grid>

                <GridSplitter
                    Grid.Row="1"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,4,0"
                                Appearance="Primary"
                                Command="{Binding AddNeutralCommand}"
                                Content="新增" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,4,0"
                                Command="{Binding DeleteNeutralCommand}"
                                Content="删除" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,4,0"
                                Appearance="Primary"
                                Command="{Binding SaveNeutralsCommand}"
                                Content="保存" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,4,0"
                                Command="{Binding RefreshNeutralsCommand}"
                                Content="刷新" />
                            <ui:Button
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Command="{Binding RejectNeutralChangesCommand}"
                                Content="放弃修改" />
                            <ui:DropDownButton Margin="0,0,4,0" Content="更多功能">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="占位" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                            <ui:ToggleSwitch
                                AutomationProperties.Name="中性产品选择模式"
                                IsChecked="{Binding IsNeutralCellSelectionMode, Mode=TwoWay}"
                                OffContent="整行模式"
                                OnContent="格子模式" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Text="{Binding NeutralStatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DataGrid
                        x:Name="NeutralGrid"
                        Grid.Row="2"
                        gridCore:GridRowHeader.ShowRowNumber="True"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="中性产品可编辑列表"
                        FontSize="{StaticResource SwiftExportDefaltFontSize}"
                        IsEnabled="{Binding CanEditNeutrals}"
                        ItemsSource="{Binding Neutrals.Items}"
                        RowHeight="{StaticResource DataGridRowHeightMedium}"
                        RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                        SelectedItem="{Binding SelectedNeutral, Mode=TwoWay}"
                        SelectionMode="Extended"
                        SelectionUnit="{Binding IsNeutralCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                        Style="{StaticResource SwiftExportDataGrid}">
                        <i:Interaction.Behaviors>
                            <fill:DataGridFillDownBehavior Command="{Binding FillDownNeutralsCommand}" />
                            <fill:DataGridColumnVisibilityBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ContextMenu>
                            <ContextMenu AutomationProperties.Name="当前主型号中性产品列表操作" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding CheckNeutralSelectionCommand}"
                                    Header="勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding UncheckNeutralSelectionCommand}"
                                    Header="取消勾选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Square24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertNeutralSelectionCommand}"
                                    Header="反选(选区)"
                                    Style="{StaticResource SelectionCheckMenuItem}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding CheckNeutralVisibleCommand}"
                                    Header="全选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOn24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding InvertNeutralVisibleCommand}"
                                    Header="反选(当前显示行)"
                                    ToolTip="仅操作本表当前显示行">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SelectAllOff24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding AddNeutralCommand}" Header="新增中性产品">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Add24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding DeleteNeutralCommand}" Header="删除">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding RefreshNeutralsCommand}" Header="刷新">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Header="表格模式"
                                    IsChecked="{Binding IsNeutralCellSelectionMode, Mode=TwoWay}"
                                    Style="{StaticResource ToggleMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Table24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="45"
                                CanUserSort="False"
                                ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                                HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="勾选当前主型号中性产品显示行"
                                            Command="{Binding DataContext.SetNeutralVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                            IsChecked="{Binding DataContext.IsAllNeutralVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="72"
                                ClipboardContentBinding="{Binding IsMainImage, Mode=OneWay}"
                                Header="默认主图">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="设为默认主图"
                                            Command="{Binding DataContext.SetMainImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            IsChecked="{Binding IsMainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Width="64"
                                CanUserSort="False"
                                Header="图片">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage
                                            Width="48"
                                            Height="48"
                                            DecodePixelWidth="96"
                                            SourcePath="{Binding ImagePath}"
                                            Stretch="Uniform"
                                            Style="{StaticResource SwiftExportCachedImage}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource SwiftExportDataGridTextBox}" Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="产品编码" />

                            <DataGridTemplateColumn
                                Width="140"
                                fill:DataGridFillDownBehavior.Field="ColorId"
                                ClipboardContentBinding="{Binding ColorName, Mode=OneWay}"
                                Header="颜色">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding ColorName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductColorLookupTextBox
                                            ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            Text="{Binding ColorName, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="110"
                                fill:DataGridFillDownBehavior.Field="DefaultSalesPriceUsd"
                                Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="美元销售价" />

                            <DataGridTextColumn
                                Width="100"
                                fill:DataGridFillDownBehavior.Field="DefaultExchangeRate"
                                Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="计算汇率" />

                            <DataGridTextColumn
                                Width="90"
                                fill:DataGridFillDownBehavior.Field="ProfitMargin"
                                Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="利润率" />

                            <DataGridTextColumn
                                Width="120"
                                fill:DataGridFillDownBehavior.Field="DefaultPurchasePriceCny"
                                Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="人民币采购价" />

                            <DataGridTemplateColumn Width="*" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button
                                                Margin="4,0,0,8"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                                ToolTip="重建图片地址"
                                                ToolTipService.HasDropShadow="True"
                                                ToolTipService.InitialShowDelay="200"
                                                ToolTipService.Placement="Top" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
