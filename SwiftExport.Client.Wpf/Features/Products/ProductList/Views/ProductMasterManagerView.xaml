<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductMasterManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:resourceProxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d" d:Height="800" d:Width="1280"
             d:DataContext="{d:DesignInstance vm:ProductMasterManagerViewModel}">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <resourceProxies:BindingProxy x:Key="ProductMasterManagerViewModelProxy" Data="{Binding}" />

        <Style x:Key="ProductMasterCardItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="主产品管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="搜索主型号、描述、类型、标签或中性产品编码">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <ui:Button Content="新增" MinWidth="70" IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                       Command="{Binding AddRowCommand}"
                                       Margin="0,0,8,0" />

                            <ui:Button Content="编辑" Command="{Binding OpenDetailCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" MinWidth="70" />

                            <ui:Button Content="放弃修改" Command="{Binding RejectListChangesCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:DropDownButton Content="更多功能" Margin="0,0,8,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="批量导入" Command="{Binding PlacementTarget.DataContext.OpenImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="从详情新建" Command="{Binding PlacementTarget.DataContext.CreateDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>

                            <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />


                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                 VerticalAlignment="Center"
                                 OffContent="隐藏英文"
                                 OnContent="显示英文"
                                 IsChecked="{Binding IsEnglishFieldsVisible, Mode=TwoWay}" />
                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 OffContent="列表"
                                 OnContent="卡片"
                                 IsChecked="{Binding IsCardView, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top"
                                              Content="关闭" MinWidth="70"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"/>
                                
                                <StackPanel Orientation="Horizontal" MinHeight="120">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">
                                </Grid>
                                </StackPanel>
                            </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>



        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="280" MaxWidth="480" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>

            <ui:Card HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="产品分类" Style="{StaticResource BodyStrongTextBlock}" />
                    <productComponents:ProductCategoryFilterTreeView Grid.Row="2"
                              Categories="{Binding ReferenceDataCache.ProductCategoryTree}"
                              Selection="{Binding CategoryFilter, Mode=TwoWay}"
                              SelectionChangedCommand="{Binding ApplyCategoryFilterCommand}"
                              AutomationProperties.Name="主产品分类筛选" />
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="1" Background="Transparent"
                          Width="4" 
                          HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="6" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="4*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <DataGrid x:Name="MasterGrid" PreparingCellForEdit="OnMasterPreparingCellForEdit"
                              ItemsSource="{Binding Masters.Items}"
                              SelectedItem="{Binding SelectedMaster, Mode=TwoWay}"
                              RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              RowHeight="{StaticResource DataGridRowHeightMedium}"
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                              FrozenColumnCount="2"
                              gridCore:EnterpriseGrid.IsEnabled="True"
                              gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True"
                              gridOperations:GridOperations.IsEnabled="True"
                              gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                              gridValidation:GridValidation.IsEnabled="True"
                              AutomationProperties.Name="主型号可编辑列表">
                        <DataGrid.Style>
                            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource SwiftExportDataGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="45" CanUserSort="False" 
                                                        HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.Masters.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="图片" Width="72" IsReadOnly="True" CanUserSort="False"
                                                        gridColumns:GridColumn.Key="main-image"
                                                        gridColumns:GridColumn.FieldPath="MainImagePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="52" Height="52"
                                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                                  DecodePixelWidth="104"
                                                                  SourcePath="{Binding MainImagePath}"
                                                                  Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="主型号" Width="100" 
                                                Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                                gridColumns:GridColumn.CanFillDown="False"
                                                    gridColumns:GridColumn.Key="master-sku"/>

                            <DataGridTextColumn Header="中文描述" Width="190" Binding="{Binding DefaultDescriptionZh, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                                    gridColumns:GridColumn.Key="description-zh" gridColumns:GridColumn.FieldPath="DefaultDescriptionZh" />

                            <DataGridTextColumn Header="英文描述" Width="190" Binding="{Binding DefaultDescriptionEn, UpdateSourceTrigger=LostFocus}"
                                                    Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                                    gridColumns:GridColumn.Key="description-en" gridColumns:GridColumn.FieldPath="DefaultDescriptionEn" />

                            <DataGridTextColumn Header="中文配置" Width="180" Binding="{Binding DefaultFeaturesZh, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                                    gridColumns:GridColumn.Key="features-zh" gridColumns:GridColumn.FieldPath="DefaultFeaturesZh" />
                            <DataGridTextColumn Header="英文配置" Width="180" 
                                                    Binding="{Binding DefaultFeaturesEn, UpdateSourceTrigger=LostFocus}"
                                                    Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                                    gridColumns:GridColumn.Key="features-en" gridColumns:GridColumn.FieldPath="DefaultFeaturesEn" />

                            <DataGridTextColumn Header="箱容" Width="50" 
                                                    Binding="{Binding DefaultPcsPerPackage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                    gridColumns:GridColumn.Key="pcs-per-package" 
                                                    gridColumns:GridColumn.FieldPath="DefaultPcsPerPackage" />

                            <DataGridTextColumn Header="净重kg" Width="70" 
                                                    Binding="{Binding DefaultNetWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                    gridColumns:GridColumn.Key="net-weight" 
                                                    gridColumns:GridColumn.FieldPath="DefaultNetWeight" />

                            <DataGridTextColumn Header="毛重kg" Width="70" 
                                                    Binding="{Binding DefaultGrossWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                    gridColumns:GridColumn.Key="gross-weight" 
                                                    gridColumns:GridColumn.FieldPath="DefaultGrossWeight" />

                            <DataGridTextColumn Header="体积m3" Width="70" 
                                                    Binding="{Binding DefaultCbm, UpdateSourceTrigger=LostFocus, StringFormat=N3, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                                    gridColumns:GridColumn.Key="cbm" 
                                                    gridColumns:GridColumn.FieldPath="DefaultCbm" />


                            <DataGridTemplateColumn Header="分类" Width="160"
                                                    SortMemberPath="CategoryName"
                                                    gridColumns:GridColumn.FillDownFieldPaths="CategoryId,CategoryName"
                                                    gridColumns:GridColumn.Key="category">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                       Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductCategoryFlatLookupTextBox 
                                                Text="{Binding CategoryName, Mode=OneWay}"                                            
                                                ItemsSource="{Binding DataContext.ReferenceDataCache.ProductCategories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectedCategory="{Binding DataContext.EditCategory, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                SelectionCommittedCommand="{Binding DataContext.CommitCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionCommittedCommandParameter="{Binding}"
                                                SelectionClearedCommand="{Binding DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionClearedCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="默认供应商" Width="90" 
                                                        gridColumns:GridColumn.Key="default-supplier" 
                                                        gridColumns:GridColumn.FillDownFieldPaths="DefaultSupplierId,DefaultSupplierName"
                                                        gridColumns:GridColumn.FieldPath="DefaultSupplierId,DefaultSupplierName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DefaultSupplierName}"
                                                       Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierAutoSuggestComboBox StretchToHost="True"
                                                                    ItemsSource="{Binding DataContext.SupplierOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                                    Placeholder="{Binding DefaultSupplierName}"
                                                                    SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectionCommittedCommandParameter="{Binding}"
                                                                    SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectionClearedCommandParameter="{Binding}"
                                                                    AutomationProperties.Name="当前主型号默认供应商" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="属性模板" Width="150" SortMemberPath="ProductAttributeProfileName"
                                                    gridColumns:GridColumn.Key="attribute-profile"
                                                    gridColumns:GridColumn.FieldPath="ProductAttributeProfileName"
                                                    gridColumns:GridColumn.FillDownFieldPaths="ProductAttributeProfileId,ProductAttributeProfileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductAttributeProfileName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductAttributeProfileLookupTextBox 
                                            Text="{Binding ProductAttributeProfileName, Mode=OneWay}"
                                            ItemsSource="{Binding DataContext.ProfileCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedProfile="{Binding DataContext.EditProfile, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            SelectionClearedCommand="{Binding DataContext.ClearProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            AutomationProperties.Name="当前主型号属性模板" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="产品系列" Width="140" SortMemberPath="ProductSeriesName"
                                                    gridColumns:GridColumn.Key="product-series"
                                                    gridColumns:GridColumn.FieldPath="ProductSeriesName"
                                                    gridColumns:GridColumn.FillDownFieldPaths="ProductSeriesId,ProductSeriesName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductSeriesName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductSeriesAutoSuggestComboBox Text="{Binding ProductSeriesName, Mode=OneWay}"
                                            ItemsSource="{Binding DataContext.SeriesCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedSeries="{Binding DataContext.EditSeries, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            SelectionClearedCommand="{Binding DataContext.ClearSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            Placeholder="产品系列（可空）" AutomationProperties.Name="当前主型号产品系列" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="标签" Width="240" IsReadOnly="True"
                                                Binding="{Binding TagSummary, Mode=OneWay}"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                gridColumns:GridColumn.CanFillDown="False"
                                                gridColumns:GridColumn.Key="attribute-tags" 
                                                gridColumns:GridColumn.FieldPath="TagSummary" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ResultSummary}" 
                                       Style="{StaticResource CaptionTextBlock}" />
                            <TextBlock Text="{Binding ValidationSummary}" 
                                       Margin="12,0,0,0" 
                                       Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                                       Style="{StaticResource CaptionTextBlock}" />
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding PageStatus}" 
                                   Margin="12,0" 
                                   VerticalAlignment="Center" />
                        <controls:PageNavigator Grid.Column="2" 
                                                TotalCount="{Binding TotalCount}" 
                                                PageIndex="{Binding PageIndex}" 
                                                PageSize="{Binding PageSize}" 
                                                PageChangeCommand="{Binding PageChangeCommand}" />
                    </Grid>
                    
                </Grid>

                <ListBox Grid.RowSpan="3" ItemsSource="{Binding Masters.Items}"
                         SelectedItem="{Binding SelectedMaster, Mode=TwoWay}" 
                         ItemContainerStyle="{StaticResource ProductMasterCardItemStyle}"
                         BorderThickness="0" 
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style>
                        <Style TargetType="{x:Type ListBox}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" MinHeight="240" Margin="6"
                                    Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource SwiftExportCornerRadius}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource UserControlStrokeColorDefaultBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="210" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="White"
                                            CornerRadius="4,4,0,0"
                                            Padding="8">
                                        <controls:CachedImage Style="{StaticResource SwiftExportCachedImage}"
                                                              Width="Auto"
                                                              Height="Auto"
                                                              DecodePixelWidth="800"
                                                              SourcePath="{Binding MainImagePath}"
                                                              Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="12">
                                        <TextBlock Text="{Binding MasterSku}"
                                                   Style="{StaticResource BodyStrongTextBlock}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Margin="0,4,0,0"
                                                   MinHeight="40"
                                                   MaxHeight="40"
                                                   Style="{StaticResource BodyTextBlock}"
                                                   Text="{Binding DefaultDescriptionEn}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding DefaultDescriptionEn}" />

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="销售价" Style="{StaticResource CaptionTextBlock}" />
                                                <TextBlock Text="{Binding DefaultSalesPriceUsd, StringFormat=US$ {0:N2}, TargetNullValue=--}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource UserBusinessTextAccentBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="采购价" Style="{StaticResource CaptionTextBlock}" />
                                                <TextBlock Text="{Binding DefaultPurchasePriceCny, StringFormat=¥ {0:N2}, TargetNullValue=--}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding DefaultSupplierName, StringFormat=供应商：{0}, TargetNullValue=供应商：--}"
                                                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DefaultSupplierName}" />
                                            <ui:Button Grid.Column="1" 
                                                       Appearance="Primary"
                                                       Icon="{ui:SymbolIcon Symbol=Search24}"
                                                       Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel  Orientation="Horizontal">
                            <ui:Button Content="新增" Appearance="Primary" MinWidth="70"
                                       Command="{Binding AddNeutralCommand}" Margin="0,0,4,0" />
                            <ui:Button Content="删除"  Command="{Binding DeleteNeutralCommand}" Margin="0,0,4,0" MinWidth="70"/>
                            <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveNeutralsCommand}" MinWidth="70" Margin="0,0,4,0" />
                            <ui:Button Content="刷新"  Command="{Binding RefreshNeutralsCommand}" MinWidth="70" Margin="0,0,4,0" />
                            <ui:Button Content="放弃修改"  Command="{Binding RejectNeutralChangesCommand}" MinWidth="70" Margin="0,0,8,0" />
                            <ui:DropDownButton Content="更多功能" Margin="0,0,4,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="占位" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                            <ui:ToggleSwitch OffContent="整行模式" OnContent="格子模式"
                                             IsChecked="{Binding IsNeutralCellSelectionMode, Mode=TwoWay}"
                                             AutomationProperties.Name="中性产品选择模式" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Text="{Binding NeutralStatusText}" 
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DataGrid x:Name="NeutralGrid" Grid.Row="2" 
                              IsEnabled="{Binding CanEditNeutrals}" 
                              ItemsSource="{Binding Neutrals.Items}"
                              SelectedItem="{Binding SelectedNeutral, Mode=TwoWay}"
                              Style="{StaticResource SwiftExportDataGrid}"
                              RowHeight="{StaticResource DataGridRowHeightMedium}"
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              AutoGenerateColumns="False" 
                              SelectionMode="Extended" 
                              SelectionUnit="{Binding IsNeutralCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                              gridCore:EnterpriseGrid.IsEnabled="True" 
                              gridCore:GridVirtualization.IsEnabled="True"
                              gridCore:GridRowHeader.ShowRowNumber="True" 
                              gridOperations:GridOperations.IsEnabled="True"
                              gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                              gridValidation:GridValidation.IsEnabled="False" 
                              AutomationProperties.Name="中性产品可编辑列表">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="45" CanUserSort="False" 
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.Neutrals.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="默认主图" Width="72"
                                            gridColumns:GridColumn.Key="neutral-is-main-image"
                                            gridColumns:GridColumn.FieldPath="IsMainImage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsMainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.SetMainImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="设为默认主图" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False" 
                                            gridColumns:GridColumn.Key="neutral-image" 
                                            gridColumns:GridColumn.FieldPath="ImagePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="48" Height="48"
                                                      Style="{StaticResource SwiftExportCachedImage}" 
                                                      DecodePixelWidth="96"
                                                      SourcePath="{Binding ImagePath}" Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" 
                                         Style="{StaticResource SwiftExportDataGridTextBox}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="产品编码" Width="160" 
                                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        gridColumns:GridColumn.Key="neutral-product-code" 
                                        gridColumns:GridColumn.FieldPath="ProductCode" />

                            <DataGridTemplateColumn Header="颜色" Width="140" 
                                            gridColumns:GridColumn.Key="neutral-color" 
                                            gridColumns:GridColumn.FieldPath="ColorId">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ColorName}" 
                                           Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductColorLookupTextBox Text="{Binding ColorName, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="美元销售价" Width="110" 
                                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        gridColumns:GridColumn.Key="neutral-sales-price-usd" gridColumns:GridColumn.FieldPath="DefaultSalesPriceUsd" />

                            <DataGridTextColumn Header="计算汇率" Width="100" 
                                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        gridColumns:GridColumn.Key="neutral-exchange-rate" gridColumns:GridColumn.FieldPath="DefaultExchangeRate" />

                            <DataGridTextColumn Header="利润率" Width="90" Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        gridColumns:GridColumn.Key="neutral-profit-margin" gridColumns:GridColumn.FieldPath="ProfitMargin" />

                            <DataGridTextColumn Header="人民币采购价" Width="120"
                                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        gridColumns:GridColumn.Key="neutral-purchase-price-cny"
                                        gridColumns:GridColumn.FieldPath="DefaultPurchasePriceCny" />

                            <DataGridTemplateColumn Header="操作" Width="*"
                                            gridColumns:GridColumn.Key="rebuild-image-path"
                                            gridColumns:GridColumn.FieldPath="ReBuildImagePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Transparent" Margin="4,0,0,8"
                                                   Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                                       ToolTip="重建图片地址"
                                                       ToolTipService.HasDropShadow="True"
                                                       ToolTipService.Placement="Top"
                                                       ToolTipService.InitialShowDelay="200"
                                                       Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
