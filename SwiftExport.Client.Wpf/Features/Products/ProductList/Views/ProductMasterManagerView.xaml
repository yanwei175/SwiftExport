<UserControl xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductMasterManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:resourceProxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductList.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d" d:Height="800" d:Width="1280"
             d:DataContext="{d:DesignInstance vm:ProductMasterManagerViewModel}">
    <UserControl.Resources>
        <Style x:Key="SelectionCheckMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <resourceProxies:BindingProxy x:Key="ProductMasterManagerViewModelProxy" Data="{Binding}" />

        <Style x:Key="ProductMasterCardItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="主产品管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="搜索主型号、描述、类型、标签或中性产品编码">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                            <ui:Button Content="新增" MinWidth="70" IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                       Command="{Binding AddRowCommand}"
                                       Margin="0,0,8,0" />

                            <ui:Button Content="编辑" Command="{Binding OpenDetailCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" MinWidth="70" />

                            <ui:Button Content="放弃修改" Command="{Binding RejectListChangesCommand}" Margin="0,0,8,0" MinWidth="70"/>

                            <ui:DropDownButton Content="更多功能" Margin="0,0,8,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="批量导入" Command="{Binding PlacementTarget.DataContext.OpenImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="从详情新建" Command="{Binding PlacementTarget.DataContext.CreateDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="批量设置主图" Command="{Binding PlacementTarget.DataContext.SetMainImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>

                            <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />

                            <productComponents:ProductCategoryMutiSelectButton Width="120" Margin="0,0,8,0"
                                       Header="分类"
                                       ShowUncategorizedOption="True"
                                       ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                                       SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                                       SelectionCommittedCommand="{Binding ApplySelectedCategoriesCommand}"
                                       AutomationProperties.Name="主产品分类筛选" />

                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                 VerticalAlignment="Center"
                                 OffContent="隐藏英文"
                                 OnContent="显示英文"
                                 IsChecked="{Binding IsEnglishFieldsVisible, Mode=TwoWay}" />
                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 IsEnabled="{Binding IsCardView,Converter={StaticResource InverseBooleanConverter}}"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                            <ui:ToggleSwitch Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 OffContent="列表"
                                 OnContent="卡片"
                                 IsChecked="{Binding IsCardView, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top"
                                              Content="关闭" MinWidth="70"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"/>
                                
                                <StackPanel Orientation="Horizontal" MinHeight="120">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">
                                </Grid>
                                </StackPanel>
                            </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>



        <Grid Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="6" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="4*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- 主表和卡片切换内容行，分页及结果提示共用底部行。 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <DataGrid x:Name="MasterGrid" PreparingCellForEdit="OnMasterPreparingCellForEdit"
                              ItemsSource="{Binding Masters.Items}"
                              SelectedItem="{Binding SelectedMaster, Mode=TwoWay}"
                              RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              RowHeight="{StaticResource DataGridRowHeightMedium}"
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                              FrozenColumnCount="2"
                              gridCore:GridRowHeader.ShowRowNumber="True"
                              AutomationProperties.Name="主型号可编辑列表">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                        <fill:DataGridColumnVisibilityBehavior />
                    </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="主型号当前页列表操作">
                    <MenuItem Header="勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding CheckMasterSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkSquare24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="取消勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding UncheckMasterSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Square24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding InvertMasterSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="全选(当前显示行)" Command="{Binding CheckMasterVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(当前显示行)" Command="{Binding InvertMasterVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOff24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="编辑详情" Command="{Binding OpenDetailCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Edit24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="删除" Command="{Binding DeleteSelectedCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
                        <DataGrid.Style>
                            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource SwiftExportDataGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False"
                                                        HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" Margin="0" Padding="0" AutomationProperties.Name="勾选主型号当前页显示行"
                                                  IsChecked="{Binding DataContext.IsAllMasterVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                  Command="{Binding DataContext.SetMasterVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="图片" Width="72" IsReadOnly="True" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="52" Height="52"
                                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                                  DecodePixelWidth="104"
                                                                  SourcePath="{Binding MainImagePath}"
                                                                  Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="主型号" Width="100" 
                                                Binding="{Binding MasterSku, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultDescriptionZh" Header="中文描述" Width="190" Binding="{Binding DefaultDescriptionZh, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultDescriptionEn" Header="英文描述" Width="190" Binding="{Binding DefaultDescriptionEn, UpdateSourceTrigger=LostFocus}"
                                                    Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultFeaturesZh" Header="中文配置" Width="180" Binding="{Binding DefaultFeaturesZh, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultFeaturesEn" Header="英文配置" Width="180"
                                                    Binding="{Binding DefaultFeaturesEn, UpdateSourceTrigger=LostFocus}"
                                                    Visibility="{Binding Data.IsEnglishFieldsVisible, Source={StaticResource ProductMasterManagerViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultPcsPerPackage" Header="箱容" Width="50"
                                                    Binding="{Binding DefaultPcsPerPackage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultNetWeight" Header="净重kg" Width="70"
                                                    Binding="{Binding DefaultNetWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultGrossWeight" Header="毛重kg" Width="70"
                                                    Binding="{Binding DefaultGrossWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultCbm" Header="体积m3" Width="70"
                                                    Binding="{Binding DefaultCbm, UpdateSourceTrigger=LostFocus, StringFormat=N3, TargetNullValue=''}"
                                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />


                            <DataGridTemplateColumn fill:DataGridFillDownBehavior.Field="CategoryId" ClipboardContentBinding="{Binding CategoryName, Mode=OneWay}" Header="分类" Width="160"
                                                    SortMemberPath="CategoryName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"   BasedOn="{StaticResource SwiftExportDataGridTextBlock}" >
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="未分类">
                                                            <Setter  Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductCategoryFlatLookupTextBox 
                                                Text="{Binding CategoryName, Mode=OneWay}"                                            
                                                ItemsSource="{Binding DataContext.ReferenceDataCache.ProductCategories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectedCategory="{Binding DataContext.EditCategory, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                SelectionCommittedCommand="{Binding DataContext.CommitCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionCommittedCommandParameter="{Binding}"
                                                SelectionClearedCommand="{Binding DataContext.ClearCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectionClearedCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="MasterSupplierColumn" fill:DataGridFillDownBehavior.Field="DefaultSupplierId" ClipboardContentBinding="{Binding DefaultSupplierName, Mode=OneWay}" Header="默认供应商" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DefaultSupplierName}"
                                                       Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <supplierComponents:SupplierAutoSuggestComboBox StretchToHost="True"
                                                                    ItemsSource="{Binding DataContext.SupplierOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                                    Placeholder="{Binding DefaultSupplierName}"
                                                                    SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectionCommittedCommandParameter="{Binding}"
                                                                    SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    SelectionClearedCommandParameter="{Binding}"
                                                                    AutomationProperties.Name="当前主型号默认供应商" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn fill:DataGridFillDownBehavior.Field="ProductAttributeProfileId" ClipboardContentBinding="{Binding ProductAttributeProfileName, Mode=OneWay}" Header="属性模板" Width="150" SortMemberPath="ProductAttributeProfileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductAttributeProfileName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductAttributeProfileLookupTextBox 
                                            Text="{Binding ProductAttributeProfileName, Mode=OneWay}"
                                            ItemsSource="{Binding DataContext.ProfileCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedProfile="{Binding DataContext.EditProfile, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            SelectionClearedCommand="{Binding DataContext.ClearProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            AutomationProperties.Name="当前主型号属性模板" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn fill:DataGridFillDownBehavior.Field="ProductSeriesId" ClipboardContentBinding="{Binding ProductSeriesName, Mode=OneWay}" Header="产品系列" Width="140" SortMemberPath="ProductSeriesName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductSeriesName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductSeriesAutoSuggestComboBox Text="{Binding ProductSeriesName, Mode=OneWay}"
                                            ItemsSource="{Binding DataContext.SeriesCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedSeries="{Binding DataContext.EditSeries, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                            SelectionCommittedCommand="{Binding DataContext.CommitSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionCommittedCommandParameter="{Binding}"
                                            SelectionClearedCommand="{Binding DataContext.ClearSeriesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectionClearedCommandParameter="{Binding}"
                                            Placeholder="产品系列（可空）" AutomationProperties.Name="当前主型号产品系列" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="标签" Width="240" IsReadOnly="True"
                                                Binding="{Binding TagSummary, Mode=OneWay}"
                                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox Grid.Row="0" ItemsSource="{Binding Masters.Items}"
                             SelectedItem="{Binding SelectedMaster, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ProductMasterCardItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" MinHeight="240" Margin="6"
                                        Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource SwiftExportCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource UserControlStrokeColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource UserSystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="210" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="White"
                                                CornerRadius="4,4,0,0"
                                                Padding="8">
                                            <controls:CachedImage Style="{StaticResource SwiftExportCachedImage}"
                                                                  Width="Auto"
                                                                  Height="Auto"
                                                                  DecodePixelWidth="800"
                                                                  SourcePath="{Binding MainImagePath}"
                                                                  Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="12">
                                            <TextBlock Text="{Binding MasterSku}"
                                                       Style="{StaticResource BodyStrongTextBlock}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Margin="0,4,0,0"
                                                       MinHeight="40"
                                                       MaxHeight="40"
                                                       Style="{StaticResource BodyTextBlock}"
                                                       Text="{Binding DefaultDescriptionEn}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding DefaultDescriptionEn}" />

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="销售价" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Text="{Binding DefaultSalesPriceUsd, StringFormat=US$ {0:N2}, TargetNullValue=--}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource UserBusinessTextAccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="采购价" Style="{StaticResource CaptionTextBlock}" />
                                                    <TextBlock Text="{Binding DefaultPurchasePriceCny, StringFormat=¥ {0:N2}, TargetNullValue=--}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding DefaultSupplierName, StringFormat=供应商：{0}, TargetNullValue=供应商：--}"
                                                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DefaultSupplierName}" />
                                                <ui:Button Grid.Column="1"
                                                           Appearance="Primary"
                                                           Icon="{ui:SymbolIcon Symbol=Search24}"
                                                           Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ResultSummary}" 
                                       Style="{StaticResource CaptionTextBlock}" />
                            <TextBlock Text="{Binding ValidationSummary}" 
                                       Margin="12,0,0,0" 
                                       Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                                       Style="{StaticResource CaptionTextBlock}" />
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding PageStatus}" 
                                   Margin="12,0" 
                                   VerticalAlignment="Center" />
                        <controls:PageNavigator Grid.Column="2" 
                                                TotalCount="{Binding TotalCount}" 
                                                PageIndex="{Binding PageIndex}" 
                                                PageSize="{Binding PageSize}" 
                                                PageChangeCommand="{Binding PageChangeCommand}" />
                    </Grid>
                    
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel  Orientation="Horizontal">
                            <ui:Button Content="新增" Appearance="Primary" MinWidth="70"
                                       Command="{Binding AddNeutralCommand}" Margin="0,0,4,0" />
                            <ui:Button Content="删除"  Command="{Binding DeleteNeutralCommand}" Margin="0,0,4,0" MinWidth="70"/>
                            <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveNeutralsCommand}" MinWidth="70" Margin="0,0,4,0" />
                            <ui:Button Content="刷新"  Command="{Binding RefreshNeutralsCommand}" MinWidth="70" Margin="0,0,4,0" />
                            <ui:Button Content="放弃修改"  Command="{Binding RejectNeutralChangesCommand}" MinWidth="70" Margin="0,0,8,0" />
                            <ui:DropDownButton Content="更多功能" Margin="0,0,4,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="占位" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                            <ui:ToggleSwitch OffContent="整行模式" OnContent="格子模式"
                                             IsChecked="{Binding IsNeutralCellSelectionMode, Mode=TwoWay}"
                                             AutomationProperties.Name="中性产品选择模式" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Text="{Binding NeutralStatusText}" 
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DataGrid x:Name="NeutralGrid" Grid.Row="2" 
                              IsEnabled="{Binding CanEditNeutrals}" 
                              ItemsSource="{Binding Neutrals.Items}"
                              SelectedItem="{Binding SelectedNeutral, Mode=TwoWay}"
                              Style="{StaticResource SwiftExportDataGrid}"
                              RowHeight="{StaticResource DataGridRowHeightMedium}"
                              FontSize="{StaticResource SwiftExportDefaltFontSize}"
                              RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                              AutoGenerateColumns="False" 
                              SelectionMode="Extended" 
                              SelectionUnit="{Binding IsNeutralCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                              gridCore:GridRowHeader.ShowRowNumber="True" 
                              AutomationProperties.Name="中性产品可编辑列表">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownNeutralsCommand}" />
                        <fill:DataGridColumnVisibilityBehavior />
                    </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="当前主型号中性产品列表操作">
                    <MenuItem Header="勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding CheckNeutralSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkSquare24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="取消勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding UncheckNeutralSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Square24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding InvertNeutralSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="全选(当前显示行)" Command="{Binding CheckNeutralVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(当前显示行)" Command="{Binding InvertNeutralVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOff24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="新增中性产品" Command="{Binding AddNeutralCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Add24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="删除" Command="{Binding DeleteNeutralCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="刷新" Command="{Binding RefreshNeutralsCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsNeutralCellSelectionMode, Mode=TwoWay}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" Margin="0" Padding="0" AutomationProperties.Name="勾选当前主型号中性产品显示行"
                                                  IsChecked="{Binding DataContext.IsAllNeutralVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                  Command="{Binding DataContext.SetNeutralVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn ClipboardContentBinding="{Binding IsMainImage, Mode=OneWay}" Header="默认主图" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsMainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.SetMainImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="设为默认主图" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:CachedImage Width="48" Height="48"
                                                      Style="{StaticResource SwiftExportCachedImage}" 
                                                      DecodePixelWidth="96"
                                                      SourcePath="{Binding ImagePath}" Stretch="Uniform" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" 
                                         Style="{StaticResource SwiftExportDataGridTextBox}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="产品编码" Width="160" 
                                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />

                            <DataGridTemplateColumn fill:DataGridFillDownBehavior.Field="ColorId" ClipboardContentBinding="{Binding ColorName, Mode=OneWay}" Header="颜色" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ColorName}" 
                                           Style="{StaticResource SwiftExportDataGridTextBlock}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <productComponents:ProductColorLookupTextBox Text="{Binding ColorName, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultSalesPriceUsd" Header="美元销售价" Width="110"
                                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultExchangeRate" Header="计算汇率" Width="100"
                                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="ProfitMargin" Header="利润率" Width="90" Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultPurchasePriceCny" Header="人民币采购价" Width="120"
                                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Transparent" Margin="4,0,0,8"
                                                   Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                                       ToolTip="重建图片地址"
                                                       ToolTipService.HasDropShadow="True"
                                                       ToolTipService.Placement="Top"
                                                       ToolTipService.InitialShowDelay="200"
                                                       Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>


    </Grid>
</UserControl>
