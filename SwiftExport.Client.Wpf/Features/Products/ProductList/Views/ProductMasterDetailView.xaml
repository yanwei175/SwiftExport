<UserControl xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductMasterDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" d:Height="820" d:Width="1280">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Stretch">
            <StackPanel  DockPanel.Dock="Left" Orientation="Horizontal" 
                         VerticalAlignment="Center">
                <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}"  Margin="0,0,4,0" MinWidth="70"/>
                <ui:Button Content="放弃" Command="{Binding RejectDetailChangesCommand}"  Margin="0,0,4,0" MinWidth="70"/>
                <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,4,0" MinWidth="70"/>
            </StackPanel>

            <StackPanel Panel.ZIndex="999" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock Text="{Binding DocumentTitle}" 
                           TextAlignment="Center"
                           Style="{StaticResource SubtitleTextBlock}" 
                           Foreground="{DynamicResource UserSystemAccentColorPrimaryBrush}"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}" 
                           TextAlignment="Center"
                           Style="{StaticResource SecondaryTextBlock}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right">
                <ui:Button Content="关闭页签" 
                           Appearance="Primary" 
                           Command="{Binding CloseDocumentCommand}" />
            </StackPanel>

        </Grid>

        <ui:Card Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0" IsEnabled="{Binding CanEditHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Column="0" Grid.Row="0" Text="主型号编码: *" VerticalAlignment="Center"  />
                    <ui:TextBox Grid.Column="2" Grid.Row="0" 
                                    Text="{Binding Header.MasterSku, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="4" Grid.Row="0" Text="中文描述:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="6" Grid.Row="0" Grid.ColumnSpan="5" 
                                    Text="{Binding Header.DefaultDescriptionZh, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="12" Grid.Row="0" 
                               Text="产品分类:" VerticalAlignment="Center" />
                    <productComponents:ProductCategoryLookupTextBox Grid.Column="14" Grid.Row="0"
                                                                    Placeholder="产品分类"
                                                                    Text="{Binding Header.CategoryName, Mode=OneWay}"
                                                                    ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                                                                    SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}"
                                                                    RefreshCommand="{Binding RefreshProductCategoriesCommand}"
                                                                    IsRefreshing="{Binding RefreshProductCategoriesCommand.IsRunning, Mode=OneWay}"
                                                                    SelectionCommittedCommand="{Binding CommitCategoryCommand}"
                                                                    SelectionClearedCommand="{Binding ClearCategoryCommand}" />

                    <TextBlock Grid.Column="12" Grid.Row="2" Text="属性模板:" VerticalAlignment="Center" />
                    <productComponents:ProductAttributeProfileLookupTextBox Grid.Column="14" Grid.Row="2"
                                            Text="{Binding Header.ProductAttributeProfileName, Mode=OneWay}"
                                            ItemsSource="{Binding ProfileCandidates}" SelectedProfile="{Binding SelectedProfile, Mode=TwoWay}"
                                            SelectionCommittedCommand="{Binding CommitProfileCommand}"
                                            SelectionClearedCommand="{Binding ClearProfileCommand}"
                                            AutomationProperties.Name="主型号属性模板" />

                    <TextBlock Grid.Column="0" Grid.Row="2" Text="默认供应商:" VerticalAlignment="Center" />
                    <supplierComponents:SupplierAutoSuggestComboBox Grid.Column="2" Grid.Row="2" StretchToHost="True"
                                            ItemsSource="{Binding SupplierOptions}" 
                                            SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                                            SelectionCommittedCommand="{Binding CommitSupplierCommand}"
                                            SelectionClearedCommand="{Binding ClearSupplierCommand}"
                                            Placeholder="{Binding SupplierPlaceholder}"
                                            ToolTip="{Binding Header.DefaultSupplierName}"
                                            AutomationProperties.Name="默认供应商" />
 
                    <TextBlock Grid.Column="4" Grid.Row="2" Text="英文描述:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="6" Grid.Row="2" Grid.ColumnSpan="5" 
                                Text="{Binding Header.DefaultDescriptionEn, UpdateSourceTrigger=PropertyChanged}" />

                    
                    <TextBlock  Grid.Column="0" Grid.Row="4" Text="每箱数量:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="2" Grid.Row="4" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Header.DefaultPcsPerPackage, UpdateSourceTrigger=LostFocus, TargetNullValue='', StringFormat=N0}" />
                    
                    <TextBlock Grid.Column="4" Grid.Row="4" Text="净重:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="6" Grid.Row="4"
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Header.DefaultNetWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                    
                    <TextBlock Grid.Column="8" Grid.Row="4" Text="中文配置:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="10" Grid.Row="4" Grid.RowSpan="6"
                                FontSize="12"
                                Text="{Binding Header.DefaultFeaturesZh, UpdateSourceTrigger=PropertyChanged}"                                     
                                TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Grid.Column="12" Grid.Row="4" Text="英文配置:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="14" Grid.Row="4" Grid.RowSpan="5"
                                FontSize="12"
                                Text="{Binding Header.DefaultFeaturesEn, UpdateSourceTrigger=PropertyChanged}"                                    
                                TextWrapping="Wrap" AcceptsReturn="True"/>
                    
                    <TextBlock Grid.Column="0" Grid.Row="6" Text="毛重:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="2" Grid.Row="6" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  Text="{Binding Header.DefaultGrossWeight, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                    
                    <TextBlock  Grid.Column="4" Grid.Row="6" Text="体积:" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="6" Grid.Row="6" 
                                  ClearButtonEnabled="False"
                                  SpinButtonPlacementMode="Compact"
                                  PlaceholderText="0.000"
                                  Text="{Binding Header.DefaultCbm, UpdateSourceTrigger=LostFocus, StringFormat=N3}" />

                    <TextBlock Grid.Column="0" Grid.Row="8" Text="产品系列:" VerticalAlignment="Center" />
                    
                    <Grid Grid.Column="2" Grid.Row="8" ColumnDefinitions="*,Auto">
                        <productComponents:ProductSeriesAutoSuggestComboBox 
                                            Text="{Binding Header.ProductSeriesName, Mode=OneWay}"
                                            ItemsSource="{Binding SeriesCandidates}"
                                            SelectedSeries="{Binding SelectedSeries, Mode=TwoWay}"
                                            SelectionCommittedCommand="{Binding CommitSeriesCommand}"
                                            SelectionClearedCommand="{Binding ClearSeriesCommand}"
                                            Placeholder="产品系列（可空）"
                                            AutomationProperties.Name="主型号产品系列" />
                        
                        <ui:Button x:Name="管理系列" Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Settings24}" Margin="4,0,0,0"
                                   Command="{Binding ManageSeriesCommand}" ToolTip="管理产品系列"
                                   AutomationProperties.Name="管理产品系列" VerticalAlignment="Stretch"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <ui:Card Width="240" MinHeight="240"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <controls:CachedImage Style="{StaticResource SwiftExportCachedImage}"
                                          Width="Auto"
                                          Height="Auto"
                                          DecodePixelWidth="800"
                                          SourcePath="{Binding MainImagePath}"
                                          Stretch="Uniform" />
                    </ui:Card>

                </Grid>
            </Grid>
        </ui:Card>

        <TabControl Grid.Row="4">
            <TabItem Header="中性产品" AutomationProperties.Name="中性产品页签">
        <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="新增行" Command="{Binding AddNeutralCommand}" Margin="0,0,4,0" MinWidth="70"/>
                        <ui:Button Content="删除行" Command="{Binding DeleteNeutralCommand}" Margin="0,0,4,0" MinWidth="70"/>
                <ui:ToggleSwitch Margin="0,0,4,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Neutrals.Items}"
                          SelectedItem="{Binding SelectedNeutral, Mode=TwoWay}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                          FontSize="{StaticResource SwiftExportDefaltFontSize}"
                          RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="{Binding IsReadOnly}"
                          SelectionMode="Extended" 
                          SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                          gridCore:GridRowHeader.ShowRowNumber="True" 
                          AutomationProperties.Name="中性产品可编辑列表">
                    <i:Interaction.Behaviors>
                        <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                    </i:Interaction.Behaviors>
                <DataGrid.Columns>
                    <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.Neutrals.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn ClipboardContentBinding="{Binding IsMainImage, Mode=OneWay}" Header="默认主图" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          IsChecked="{Binding IsMainImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.SetMainImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          AutomationProperties.Name="设为默认主图" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="164" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="48" Height="48"
                                                      Style="{StaticResource SwiftExportCachedImage}" 
                                                      DecodePixelWidth="96"
                                                      SourcePath="{Binding ImagePath}" Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" 
                                         Style="{StaticResource SwiftExportDataGridTextBox}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="产品编码" Width="160" 
                                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />

                    <DataGridTemplateColumn ClipboardContentBinding="{Binding ColorName, Mode=OneWay}" Header="颜色" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ColorName}" 
                                           Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductColorLookupTextBox Text="{Binding ColorName, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultSalesPriceUsd" Header="美元销售价" Width="110"
                                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultExchangeRate" Header="计算汇率" Width="100"
                                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="ProfitMargin" Header="利润率" Width="90" Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                    <DataGridTextColumn fill:DataGridFillDownBehavior.Field="DefaultPurchasePriceCny" Header="人民币采购价" Width="120"
                                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
            </TabItem>
            <TabItem Header="标签属性" AutomationProperties.Name="标签属性页签">
                <productComponents:ProductAttributeEditor Workspace="{Binding Tags}" CanEdit="{Binding CanEditTags}"
                                                          RefreshCommand="{Binding RefreshProductAttributesCommand}"
                                                          IsEnabled="{Binding IsNotBusy}" />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="6" Text="{Binding ValidationSummary}" Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                   Style="{StaticResource CaptionTextBlock}" />
    </Grid>
</UserControl>
