<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductPackagingEditorView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:products="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:selection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <proxies:BindingProxy x:Key="PackagingEditorProxy" Data="{Binding}"/>
        <selection:GridSelectionUnitConverter x:Key="SelectionUnitConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="新增包装" Command="{Binding AddRowCommand}" Margin="0,0,8,0"/>
            <Button Content="删除包装" Command="{Binding DeleteRowsCommand}" Margin="0,0,8,0"/>
            <Button Content="撤销包装修改" Command="{Binding RejectChangesCommand}" Margin="0,0,16,0"/>
            <ui:ToggleSwitch Content="单元格选择" IsChecked="{Binding IsCellSelectionMode}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"/>
        </WrapPanel>

        <DataGrid x:Name="PackageGrid" Grid.Row="1" ItemsSource="{Binding Rows.Items}" SelectedItem="{Binding SelectedRow}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                    SelectionUnit="{Binding IsCellSelectionMode, Converter={StaticResource SelectionUnitConverter}}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="物料包装规格列表">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource SwiftExportDataGrid}">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanEdit}" Value="False">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Header="勾选" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn ClipboardContentBinding="{Binding PackageType, Mode=OneWay}" Header="包装类型" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox VerticalContentAlignment="Center" SelectedValuePath="DataNameEn"
                                      SelectedValue="{Binding PackageType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Data.CanEdit, Source={StaticResource PackagingEditorProxy}}"
                                      ItemsSource="{Binding Data.PackageTypes, Source={StaticResource PackagingEditorProxy}}" AutomationProperties.Name="包装类型代码">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DataNameZh}"/>
                                            <TextBlock Text="{Binding DataNameEn}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding PackagingMaterialSku, Mode=OneWay}" Header="包材" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PackagingMaterialSku}" VerticalAlignment="Center" ToolTip="{Binding MaterialStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <products:ProductLookupTextBox Text="{Binding PackagingMaterialSku, Mode=OneWay}"
                                                           ItemsSource="{Binding DataContext.MaterialCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           SelectedProduct="{Binding DataContext.SelectedMaterial, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                           SearchCommand="{Binding DataContext.SearchMaterialsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           SelectionCommittedCommand="{Binding DataContext.CommitMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionCommittedCommandParameter="{Binding}"
                                                           SelectionClearedCommand="{Binding DataContext.ClearMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionClearedCommandParameter="{Binding}"
                                                           AutomationProperties.Name="包装包材选择"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="包材描述" Width="200" IsReadOnly="True" Binding="{Binding PackagingMaterialDescription, Mode=OneWay}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTextColumn Header="包材单位" Width="80" IsReadOnly="True" Binding="{Binding PackagingMaterialUnit, Mode=OneWay}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTextColumn Header="引用状态" Width="180" IsReadOnly="True" Binding="{Binding MaterialStatus, Mode=OneWay}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTextColumn Header="成品装率" Width="90" Binding="{Binding PcsPerPackage, StringFormat=N0, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="长 CM" Width="90" Binding="{Binding Length_CM, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                <DataGridTextColumn Header="宽 CM" Width="90" Binding="{Binding Width_CM, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                <DataGridTextColumn Header="高 CM" Width="90" Binding="{Binding Height_CM, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                <DataGridTextColumn Header="净重 KG" Width="100" Binding="{Binding Nw_KG, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                <DataGridTextColumn Header="毛重 KG" Width="100" Binding="{Binding Gw_KG, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                <DataGridTextColumn Header="体积 CBM" Width="110" Binding="{Binding Cbm, StringFormat=N3, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                <DataGridTextColumn Header="备注" Width="220" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding SelectedRow.MaterialStatus}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.Name="包装规格反馈"/>
        </StackPanel>
    </Grid>
</UserControl>
