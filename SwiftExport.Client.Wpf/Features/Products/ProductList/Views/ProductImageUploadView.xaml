<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductImageUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,8" MaxWidth="672">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding Items.Count}" Value="{Binding Completed}"
                     Height="8" Margin="0,0,0,12" AutomationProperties.Name="已处理图片数量"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  EnableRowVirtualization="True" AutomationProperties.Name="图片上传结果">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="处理结果" Binding="{Binding Status}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="选择图片…" Click="SelectFiles_Click" IsEnabled="{Binding CanSelectFiles}" Padding="12,6" Appearance="Info"/>
            <ui:Button Content="开始上传（同名覆盖）" Command="{Binding StartCommand}" Margin="8,0,0,0" Padding="12,6" Appearance="Primary"/>
            <ui:Button Content="停止后续上传" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="12,6" Appearance="Caution"/>
        </StackPanel>
    </Grid>
</UserControl>
