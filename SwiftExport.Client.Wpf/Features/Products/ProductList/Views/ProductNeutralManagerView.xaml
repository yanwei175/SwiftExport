<UserControl
    x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductNeutralManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Height="760"
    d:Width="1280"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
        <Style
            x:Key="SelectionCheckMenuItem"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="产品管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="搜索中性产品编码、主型号或主型号描述"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding AddRowCommand}"
                            Content="新增"
                            ToolTip="新增产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Success"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            ToolTip="保存产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除"
                            ToolTip="删除产品" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding RejectListChangesCommand}"
                            Content="放弃修改"
                            ToolTip="放弃产品修改" />

                        <productComponents:ProductCategoryMutiSelectButton
                            x:Name="CategoryFilterPicker"
                            Width="120"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="中性产品分类多选筛选"
                            Header="分类"
                            ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                            SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                            SelectionCommittedCommand="{Binding ApplySelectedCategoriesCommand}"
                            ShowUncategorizedOption="True" />

                        <filter:MultiSelectLookupButton
                            Width="120"
                            Margin="0,0,8,0"
                            DisplayMemberPath="ColorNameZh"
                            FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                            Header="颜色"
                            ItemsSource="{Binding ReferenceDataCache.ProductColors}"
                            SelectedItems="{Binding FilterColorList, Mode=OneWay}"
                            SelectedValuePath="Uid"
                            SelectionCommittedCommand="{Binding SearchCommand}"
                            ShowSearchBox="True" />


                        <ui:DropDownButton Margin="0,0,4,0" Content="更多功能">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding OpenImportCommand}" Header="批量导入" />
                                    <MenuItem Command="{Binding ReBuildCheckedImagePathsCommand}" Header="重建勾选产品图片路径" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ToggleButton
                            x:Name="OptionsToggleButton"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Content="更多条件" />
                        <ui:ToggleSwitch
                            AutomationProperties.Name="中性产品选择模式"
                            IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                            OffContent="整行模式"
                            OnContent="格子模式" />
                    </WrapPanel>


                </DockPanel>

                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">
                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton
                                MinWidth="70"
                                VerticalAlignment="Top"
                                Content="关闭"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}" />

                            <StackPanel MinHeight="120" Orientation="Horizontal">
                                <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto,Auto" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid
                x:Name="NeutralGrid"
                gridCore:GridRowHeader.ShowRowNumber="True"
                AutoGenerateColumns="False"
                AutomationProperties.Name="中性产品可编辑列表"
                Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                FontSize="{StaticResource SwiftExportDefaltFontSize}"
                FrozenColumnCount="1"
                ItemsSource="{Binding Lines.Items}"
                RowHeight="{StaticResource DataGridRowHeightMedium}"
                RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                SelectionMode="Extended"
                SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                Style="{StaticResource SwiftExportDataGrid}">
                <i:Interaction.Behaviors>
                    <gridCore:DataGridColumnVisibilityBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.ContextMenu>
                    <ContextMenu AutomationProperties.Name="中性产品当前页列表操作" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem
                            Command="{Binding CheckSelectionCommand}"
                            Header="勾选(选区)"
                            Style="{StaticResource SelectionCheckMenuItem}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding UncheckSelectionCommand}"
                            Header="取消勾选(选区)"
                            Style="{StaticResource SelectionCheckMenuItem}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Square24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding InvertSelectionCommand}"
                            Header="反选(选区)"
                            Style="{StaticResource SelectionCheckMenuItem}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowSwap24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding CheckVisibleCommand}"
                            Header="全选(当前显示行)"
                            ToolTip="仅操作本表当前显示行">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SelectAllOn24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding InvertVisibleCommand}"
                            Header="反选(当前显示行)"
                            ToolTip="仅操作本表当前显示行">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SelectAllOff24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding DeleteSelectedCommand}" Header="删除">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="表格模式"
                            IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                            Style="{StaticResource ToggleMenuItemStyle}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Table24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="45"
                        CanUserSort="False"
                        ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                        HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="勾选中性产品当前页显示行"
                                    Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                    IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="68"
                        CanUserSort="False"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="48"
                                    Height="48"
                                    DecodePixelWidth="96"
                                    SourcePath="{Binding ImagePath}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource SwiftExportDataGridTextBox}" Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="120"
                        ClipboardContentBinding="{Binding MasterSku, Mode=OneWay}"
                        Header="主型号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding MasterSku}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductMasterLookupTextBox
                                    IsBusy="{Binding DataContext.IsProductMasterLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    ItemsSource="{Binding DataContext.ProductMasterCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SearchCommand="{Binding DataContext.SearchProductMastersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedProductMaster="{Binding DataContext.EditProductMaster, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionClearedCommand="{Binding DataContext.ClearProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    Text="{Binding MasterSku, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="产品编码" />

                    <DataGridTemplateColumn
                        Width="140"
                        ClipboardContentBinding="{Binding ColorName, Mode=OneWay}"
                        Header="颜色">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding ColorName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductColorLookupTextBox
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionClearedCommand="{Binding DataContext.ClearColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    Text="{Binding ColorName, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="美元销售价" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="计算汇率" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="利润率" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="人民币采购价" />

                    <DataGridTemplateColumn Width="60" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="4,0,0,8"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                        ToolTip="重建图片地址"
                                        ToolTipService.HasDropShadow="True"
                                        ToolTipService.InitialShowDelay="200"
                                        ToolTipService.Placement="Top" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding CategoryName}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="产品分类"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding ProductMasterDescriptionZh}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="中文描述"
                        IsReadOnly="True" />


                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding ResultSummary}" />
                <TextBlock
                    Margin="12,0,0,0"
                    Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="{Binding ValidationSummary}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="12,0"
                VerticalAlignment="Center"
                Text="{Binding PageStatus}" />
            <controls:PageNavigator
                Grid.Column="2"
                PageChangeCommand="{Binding PageChangeCommand}"
                PageSize="{Binding PageSize}"
                TotalCount="{Binding TotalCount}"
                PageIndex="{Binding PageIndex}" />
        </Grid>
    </Grid>
</UserControl>
