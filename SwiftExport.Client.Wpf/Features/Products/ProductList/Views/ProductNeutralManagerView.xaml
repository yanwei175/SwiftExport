<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductNeutralManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d" d:Height="760" d:Width="1280">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter"/>
        <Style x:Key="SelectionCheckMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="产品管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="搜索中性产品编码、主型号或主型号描述">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Command="{Binding AddRowCommand}"
                                   Content="新增"
                                   ToolTip="新增产品">
                        </ui:Button>

                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Appearance="Success"
                                   Content="保存"
                                   Command="{Binding SaveCommand}"
                                   ToolTip="保存产品">
                        </ui:Button>

                        <ui:Button Margin="0,0,8,0" MinWidth="70"
                                   Content="删除"
                                   Command="{Binding DeleteSelectedCommand}"
                                   ToolTip="删除产品"/>

                        <ui:Button Content="放弃修改" Margin="0,0,8,0" MinWidth="70"
                                Command="{Binding RejectListChangesCommand}" 
                                ToolTip="放弃产品修改"/>

                        <productComponents:ProductCategoryMutiSelectButton x:Name="CategoryFilterPicker"
                                                        Width="120" Margin="0,0,8,0" Header="分类"
                                                        ShowUncategorizedOption="True"
                                                        ItemsSource="{Binding ReferenceDataCache.ProductCategoryTree}"
                                                        SelectedItems="{Binding FilterCategories, Mode=OneWay}"
                                                        SelectionCommittedCommand="{Binding ApplySelectedCategoriesCommand}"
                                                        AutomationProperties.Name="中性产品分类多选筛选" />

                        <filter:MultiSelectLookupButton Width="120" Margin="0,0,8,0" Header="颜色"
                                                        ShowSearchBox="True"
                                                        ItemsSource="{Binding ReferenceDataCache.ProductColors}"
                                                        DisplayMemberPath="ColorNameZh"
                                                        FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                                                        SelectionCommittedCommand="{Binding SearchCommand}"
                                                        SelectedValuePath="Uid" 
                                                        SelectedItems="{Binding FilterColorList, Mode=OneWay}"/>
                        

                        <ui:DropDownButton Content="更多功能" Margin="0,0,4,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="批量导入" Command="{Binding OpenImportCommand}" />
                                    <MenuItem Header="重建勾选产品图片路径"
                                      Command="{Binding ReBuildCheckedImagePathsCommand}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        
                        <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />
                        <ui:ToggleSwitch OffContent="整行模式" OnContent="格子模式" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" AutomationProperties.Name="中性产品选择模式"/>
                    </WrapPanel>


                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top"
                                              Content="关闭" MinWidth="70"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"/>

                            <StackPanel Orientation="Horizontal" MinHeight="120">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid x:Name="NeutralGrid"
                      ItemsSource="{Binding Lines.Items}"
                      Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{StaticResource SwiftExportDefaltFontSize}"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                      FrozenColumnCount="1"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutomationProperties.Name="中性产品可编辑列表">
                <i:Interaction.Behaviors><gridCore:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="中性产品当前页列表操作">
                    <MenuItem Header="勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding CheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkSquare24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="取消勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding UncheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Square24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding InvertSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="全选(当前显示行)" Command="{Binding CheckVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(当前显示行)" Command="{Binding InvertVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOff24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="删除" Command="{Binding DeleteSelectedCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" Margin="0" Padding="0" AutomationProperties.Name="勾选中性产品当前页显示行"
                                          IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                          Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="68" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="48" Height="48"
                                    Style="{StaticResource SwiftExportCachedImage}"
                                    DecodePixelWidth="96" SourcePath="{Binding ImagePath}" Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource SwiftExportDataGridTextBox}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn ClipboardContentBinding="{Binding MasterSku, Mode=OneWay}" Header="主型号" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MasterSku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductMasterLookupTextBox
                                    Text="{Binding MasterSku, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ProductMasterCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedProductMaster="{Binding DataContext.EditProductMaster, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SearchCommand="{Binding DataContext.SearchProductMastersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    IsBusy="{Binding DataContext.IsProductMasterLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="产品编码" Width="160"
                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                    
                    <DataGridTemplateColumn ClipboardContentBinding="{Binding ColorName, Mode=OneWay}" Header="颜色" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ColorName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductColorLookupTextBox
                                    Text="{Binding ColorName, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="美元销售价" Width="110"
                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                    <DataGridTextColumn Header="计算汇率" Width="100"
                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                    <DataGridTextColumn Header="利润率" Width="90"
                        Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                    <DataGridTextColumn Header="人民币采购价" Width="120"
                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                    
                    <DataGridTemplateColumn Header="操作" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Transparent" Margin="4,0,0,8"
                                               Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                               ToolTip="重建图片地址"
                                               ToolTipService.HasDropShadow="True"
                                               ToolTipService.Placement="Top"
                                               ToolTipService.InitialShowDelay="200"
                                               Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="产品分类" Width="130" IsReadOnly="True"
                        Binding="{Binding CategoryName}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
                    
                    <DataGridTextColumn Header="中文描述" Width="*" IsReadOnly="True"
                        Binding="{Binding ProductMasterDescriptionZh}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />


                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding ValidationSummary}" Margin="12,0,0,0"
                           Foreground="{DynamicResource UserBusinessTextWarningBrush}" Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Margin="12,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
