<UserControl x:Class="SwiftExportClient.Features.Products.ProductList.Views.ProductNeutralManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d" d:Height="760" d:Width="1280">
    <Grid Margin="12,8" IsEnabled="{Binding IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:TextBox PlaceholderText="搜索中性产品编码、主型号或主型号描述"
                        Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Grid.Column="1" Margin="4,0,0,0" Content="查询" Appearance="Primary"
                       Command="{Binding SearchCommand}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="新增行" Command="{Binding AddRowCommand}" Margin="0,0,4,0" />
                <ui:Button Content="删除行" Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0" />
                <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,4,0" />
                <ui:Button Content="放弃修改" Command="{Binding RejectListChangesCommand}" Margin="0,0,4,0" />
                <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,4,0"/>
                <ui:DropDownButton Content="更多功能" Margin="0,0,4,0">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="重建勾选产品图片路径"
                                      Command="{Binding ReBuildCheckedImagePathsCommand}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200" MaxWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="产品颜色" 
                               Grid.Row="0" 
                               Style="{StaticResource BodyStrongTextBlock}"/>
                    
                    <productComponents:ProductColorFilterList Grid.Row="2"
                                      Colors="{Binding ReferenceDataCache.ProductColors}"
                                      Selection="{Binding ColorFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="中性产品颜色多选筛选" />

                    <TextBlock Text="产品分类" Grid.Row="4" Style="{StaticResource BodyStrongTextBlock}"/>
                    
                    <productComponents:ProductCategoryFilterTreeView Grid.Row="6"
                                        Categories="{Binding ReferenceDataCache.ProductCategoryTree}"
                                        Selection="{Binding CategoryFilter, Mode=TwoWay}"
                                        SelectionChangedCommand="{Binding ApplyCategoryFilterCommand}"
                                        AutomationProperties.Name="中性产品分类筛选" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" />

            <DataGrid x:Name="NeutralGrid" Grid.Column="2"
                      ItemsSource="{Binding Lines.Items}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{StaticResource SwiftExportDefaltFontSize}"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      FrozenColumnCount="1"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridCore:GridVirtualization.IsEnabled="True"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      gridOperations:GridOperations.IsEnabled="True"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="False"
                      AutomationProperties.Name="中性产品可编辑列表">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="45" CanUserSort="False"
                                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.Lines.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="图片" Width="68" CanUserSort="False"
                                            gridColumns:GridColumn.Key="neutral-manager-image"
                                            gridColumns:GridColumn.FieldPath="ImagePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="48" Height="48"
                                    Style="{StaticResource SwiftExportCachedImage}"
                                    DecodePixelWidth="96" SourcePath="{Binding ImagePath}" Stretch="Uniform" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource SwiftExportDataGridTextBox}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="主型号" Width="120"
                                            gridColumns:GridColumn.Key="neutral-manager-product-master"
                                            gridColumns:GridColumn.FieldPath="ProductMasterId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MasterSku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductMasterLookupTextBox
                                    Text="{Binding MasterSku, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ProductMasterCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedProductMaster="{Binding DataContext.EditProductMaster, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SearchCommand="{Binding DataContext.SearchProductMastersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    IsBusy="{Binding DataContext.IsProductMasterLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearProductMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="产品编码" Width="160"
                        Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                        gridColumns:GridColumn.Key="neutral-manager-product-code"
                        gridColumns:GridColumn.FieldPath="ProductCode" />
                    
                    <DataGridTextColumn Header="中文描述" Width="190" IsReadOnly="True"
                        Binding="{Binding ProductMasterDescriptionZh}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        gridColumns:GridColumn.Key="neutral-manager-master-description"
                        gridColumns:GridColumn.FieldPath="ProductMasterDescriptionZh" />
                    
                    <DataGridTextColumn Header="产品分类" Width="130" IsReadOnly="True"
                        Binding="{Binding CategoryName}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        gridColumns:GridColumn.Key="neutral-manager-category"
                        gridColumns:GridColumn.FieldPath="CategoryName" />
                    


                    <DataGridTemplateColumn Header="颜色" Width="140"
                                            gridColumns:GridColumn.Key="neutral-manager-color"
                                            gridColumns:GridColumn.FieldPath="ColorId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ColorName}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <productComponents:ProductColorLookupTextBox
                                    Text="{Binding ColorName, Mode=OneWay}"
                                    ItemsSource="{Binding DataContext.ReferenceDataCache.ProductColors, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedColor="{Binding DataContext.EditColor, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                    SelectionCommittedCommand="{Binding DataContext.CommitColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionCommittedCommandParameter="{Binding}"
                                    SelectionClearedCommand="{Binding DataContext.ClearColorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectionClearedCommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="美元销售价" Width="110"
                        Binding="{Binding DefaultSalesPriceUsd, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        gridColumns:GridColumn.Key="neutral-manager-sales-price"
                        gridColumns:GridColumn.FieldPath="DefaultSalesPriceUsd" />
                    <DataGridTextColumn Header="计算汇率" Width="100"
                        Binding="{Binding DefaultExchangeRate, UpdateSourceTrigger=LostFocus, StringFormat=N4, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        gridColumns:GridColumn.Key="neutral-manager-exchange-rate"
                        gridColumns:GridColumn.FieldPath="DefaultExchangeRate" />
                    <DataGridTextColumn Header="利润率" Width="90"
                        Binding="{Binding ProfitMargin, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        gridColumns:GridColumn.Key="neutral-manager-profit-margin"
                        gridColumns:GridColumn.FieldPath="ProfitMargin" />
                    <DataGridTextColumn Header="人民币采购价" Width="120"
                        Binding="{Binding DefaultPurchasePriceCny, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        gridColumns:GridColumn.Key="neutral-manager-purchase-price"
                        gridColumns:GridColumn.FieldPath="DefaultPurchasePriceCny" />
                    
                    <DataGridTemplateColumn Header="操作" Width="*"
                                            gridColumns:GridColumn.Key="rebuild-image-path"
                                            gridColumns:GridColumn.FieldPath="ReBuildImagePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Transparent" Margin="4,0,0,8"
                                                   Icon="{ui:SymbolIcon Symbol=ImageArrowCounterclockwise24}"
                                                       ToolTip="重建图片地址"
                                                       ToolTipService.HasDropShadow="True"
                                                       ToolTipService.Placement="Top"
                                                       ToolTipService.InitialShowDelay="200"
                                                       Command="{Binding DataContext.ReBuildImagePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding ValidationSummary}" Margin="12,0,0,0"
                           Foreground="{DynamicResource SwiftExportBrush.Error}" Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Margin="12,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
