<UserControl
    x:Class="SwiftExportClient.Features.Products.Categories.Views.ProductCategoryManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:categoryModels="clr-namespace:SwiftExportClient.Features.Products.Categories.Models"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:imageControls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <HierarchicalDataTemplate
            x:Key="ProductCategoryTreeTemplate"
            DataType="{x:Type categoryModels:ProductCategoryTreeItemModel}"
            ItemsSource="{Binding Children}">

            <Border
                x:Name="NodeSurface"
                Margin="0,8"
                Padding="0,0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                CornerRadius="{StaticResource SwiftExportCornerRadius}">

                <Grid HorizontalAlignment="Stretch" Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Foreground="{DynamicResource UserTextFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlock}"
                            Text="{Binding FakeName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlock}"
                            Text="{Binding CategoryName}" />
                    </Grid>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <Style
            x:Key="ProductCategoryTreeViewItem"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="{x:Type TreeViewItem}">

            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />

            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Padding" Value="0,2,20,2" />

            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem
                            Command="{Binding AddSiblingCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="新建同级分类" />
                        <MenuItem
                            Command="{Binding AddChildCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="新建子分类" />
                        <Separator />
                        <MenuItem
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Foreground="#B42318"
                            Header="删除此分类" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                MinWidth="96"
                Appearance="Primary"
                Command="{Binding AddSiblingCommand}"
                CommandParameter="{Binding CurrentCategory}"
                Content="新增同级" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding AddChildCommand}"
                CommandParameter="{Binding CurrentCategory}"
                Content="新增子级" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Command="{Binding DeleteCommand}"
                CommandParameter="{Binding CurrentCategory}"
                Content="删除" />
            <ui:Button
                MinWidth="96"
                Margin="8,0,0,0"
                Appearance="Success"
                Command="{Binding SaveCommand}"
                Content="保存分类" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="7*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ui:Card
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyTextBlock}"
                            Text="分类结构" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Command="{Binding AddRootCommand}"
                                ToolTip="新增一级分类">
                                <ui:SymbolIcon Symbol="Add24" />
                            </Button>
                            <Button
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="0"
                                Command="{Binding RefreshCommand}"
                                ToolTip="刷新">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TreeView
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.DropTargetAdornerBrush="{DynamicResource UserSystemAccentColorPrimaryBrush}"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        BorderThickness="0"
                        IsEnabled="{Binding IsInteractionEnabled}"
                        ItemContainerStyle="{StaticResource ProductCategoryTreeViewItem}"
                        ItemTemplate="{StaticResource ProductCategoryTreeTemplate}"
                        ItemsSource="{Binding CategoryTree}"
                        PreviewMouseRightButtonDown="OnTreeViewPreviewMouseRightButtonDown"
                        SelectedItemChanged="OnSelectedItemChanged" />
                </Grid>
            </ui:Card>

            <GridSplitter
                Grid.Column="1"
                Width="2"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <ui:Card
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource BodyTextBlock}"
                                Text="类目基础属性" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlock}"
                                Text="修改后点击顶部保存分类，变更会批量提交。" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Padding="12,4"
                            VerticalAlignment="Top"
                            Command="{Binding Assignment.OpenAssignmentPanelCommand}"
                            Content="快速归类">
                            <ui:Button.ToolTip>
                                <TextBlock Text="打开后才会加载待归类主型号" />
                            </ui:Button.ToolTip>
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="2" IsEnabled="{Binding CanEditCategories}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextBlock}"
                            Text="分类名称" />
                        <TextBox
                            x:Name="CategoryNameInput"
                            Grid.Column="1"
                            Text="{Binding CurrentCategory.CategoryName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextBlock}"
                            Text="假名" />
                        <TextBox
                            x:Name="CategoryFakeNameInput"
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding CurrentCategory.FakeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextBlock}"
                            Text="分类代码" />
                        <TextBox
                            x:Name="CategoryCodeInput"
                            Grid.Row="4"
                            Grid.Column="1"
                            Text="{Binding CurrentCategory.CategoryCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="6"
                            VerticalAlignment="Center"
                            Style="{StaticResource LabelTextBlock}"
                            Text="排序号" />
                        <ui:TextBox
                            x:Name="CategorySortInput"
                            Grid.Row="6"
                            Grid.Column="1"
                            MinWidth="90"
                            HorizontalAlignment="Left"
                            Text="{Binding CurrentCategory.SortNo, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Border
                        Grid.Row="4"
                        Padding="8"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource SwiftExportCornerRadius}"
                        Visibility="{Binding Assignment.IsAssignmentPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid DataContext="{Binding Assignment}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextBlock}"
                                        Text="主型号快速归类到：" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                                        Style="{StaticResource BodyTextBlock}"
                                        Text="{Binding TargetCategoryName}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    MinWidth="70"
                                    Command="{Binding CloseAssignmentPanelCommand}"
                                    Content="关闭" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Margin="0,0,8,0"
                                    PlaceholderText="输入主型号、描述或中性产品编码"
                                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>

                                <ui:Button
                                    Grid.Column="1"
                                    MinWidth="70"
                                    Margin="0,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding SearchCommand}"
                                    Content="查询" />

                                <ui:Button
                                    Grid.Column="2"
                                    MinWidth="70"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshCommand}"
                                    Content="刷新" />

                                <ui:Button
                                    Grid.Column="3"
                                    MinWidth="70"
                                    Margin="0,0,8,0"
                                    Appearance="Info"
                                    Command="{Binding AssignSelectedCommand}">
                                    <TextBlock Text="{Binding CheckedCount, StringFormat=归类 {0} 个主型号}" />
                                </ui:Button>

                                <TextBlock
                                    Grid.Column="4"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlock}"
                                    Text="{Binding StatusMessage}" />

                            </Grid>

                            <DataGrid
                                Grid.Row="4"
                                AutoGenerateColumns="False"
                                EnableColumnVirtualization="True"
                                EnableRowVirtualization="True"
                                GridLinesVisibility="Horizontal"
                                IsReadOnly="True"
                                ItemsSource="{Binding Lines}"
                                RowHeight="{DynamicResource DataGridRowHeightMedium}"
                                SelectionMode="Extended"
                                SelectionUnit="FullRow"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn
                                        Width="47"
                                        CanUserSort="False"
                                        ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                                        HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn
                                        Width="65"
                                        CanUserSort="False"
                                        Header="图片"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <imageControls:CachedImage
                                                    Width="40"
                                                    Height="40"
                                                    DecodePixelWidth="96"
                                                    SourcePath="{Binding MainImagePath}"
                                                    Stretch="Uniform"
                                                    Style="{StaticResource SwiftExportCachedImage}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Width="200"
                                        Binding="{Binding MasterSku}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        Header="主型号" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding DefaultDescriptionZh}"
                                        ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"
                                        Header="中文描述" />
                                    <DataGridTextColumn
                                        Width="220"
                                        Binding="{Binding OriginalCategoryName}"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        Header="当前分类" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="#B42318"
                                    Style="{StaticResource CaptionTextBlock}"
                                    Text="{Binding ValidationSummary}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlock}"
                                    Text="{Binding PageStatus}" />
                                <controls:PageNavigator
                                    Grid.Column="2"
                                    PageChangeCommand="{Binding PageChangeCommand}"
                                    PageSize="{Binding PageSize}"
                                    PageSizeOptions="{Binding PageSizeOptions}"
                                    TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <StackPanel
            Grid.Row="4"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding StatusMessage}" />
            <TextBlock Style="{StaticResource CaptionTextBlock}" Text="  " />
            <TextBlock
                Foreground="#B42318"
                Style="{StaticResource CaptionTextBlock}"
                Text="{Binding ValidationSummary}" />
        </StackPanel>
    </Grid>
</UserControl>
