<UserControl x:Class="SwiftExportClient.Features.Products.Categories.Views.ProductCategoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:categoryModels="clr-namespace:SwiftExportClient.Features.Products.Categories.Models"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:imageControls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <HierarchicalDataTemplate x:Key="ProductCategoryTreeTemplate"
                                  DataType="{x:Type categoryModels:ProductCategoryTreeItemModel}"
                                  ItemsSource="{Binding Children}">
            
            <Border x:Name="NodeSurface"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="0,0"
                    Margin="0,8"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">

                <Grid Background="Transparent" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FakeName}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Foreground="{DynamicResource SwiftExportBrush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CategoryName}"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Margin="4,0,0,0"
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    </Grid>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <Style x:Key="ProductCategoryTreeViewItem"
               TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            
            <Setter Property="Padding" Value="0,2,20,2" />
            
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="新建同级分类"
                                  Command="{Binding AddSiblingCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="新建子分类"
                                  Command="{Binding AddChildCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <Separator />
                        <MenuItem Header="删除此分类"
                                  Foreground="#B42318"
                                  Command="{Binding DeleteCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <ui:Button Content="新增同级" Appearance="Primary"
                    Command="{Binding AddSiblingCommand}"
                    CommandParameter="{Binding CurrentCategory}"
                    MinWidth="96" />
            <ui:Button Content="新增子级" 
                    Command="{Binding AddChildCommand}"
                    CommandParameter="{Binding CurrentCategory}"
                    MinWidth="96"
                    Margin="8,0,0,0" />
            <ui:Button Content="删除"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding CurrentCategory}"
                    MinWidth="96"
                    Margin="8,0,0,0" />
            <ui:Button Content="保存" Appearance="Success"
                    Command="{Binding SaveCommand}"
                    MinWidth="96"
                    Margin="8,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SubFillColorSecondaryBrush}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="分类结构"
                                   Style="{StaticResource BodyTextBlock}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Command="{Binding AddRootCommand}"
                                    ToolTip="新增一级分类"
                                    Width="32"
                                    Height="32"
                                    Padding="0">
                                <ui:SymbolIcon Symbol="Add24" />
                            </Button>
                            <Button Command="{Binding RefreshCommand}"
                                    ToolTip="刷新"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="8,0,0,0">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TreeView Grid.Row="2" HorizontalContentAlignment="Stretch"
                              ItemsSource="{Binding CategoryTree}"
                              ItemTemplate="{StaticResource ProductCategoryTreeTemplate}"
                              ItemContainerStyle="{StaticResource ProductCategoryTreeViewItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DropTargetAdornerBrush="{DynamicResource SwiftExportBrush.AccentHover}"
                              PreviewMouseRightButtonDown="OnTreeViewPreviewMouseRightButtonDown"
                              SelectedItemChanged="OnSelectedItemChanged" />
                </Grid>
            </Border>
            
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="2" Background="Transparent"/>
            
            <Border Grid.Column="2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="类目基础属性"
                                       Style="{StaticResource BodyTextBlock}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="修改后点击顶部保存，变更会批量提交。"
                                       Style="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                Content="快速归类"
                                Command="{Binding Assignment.OpenAssignmentPanelCommand}"
                                Padding="12,4"
                                VerticalAlignment="Top">
                            <ui:Button.ToolTip>
                                <TextBlock Text="打开后才会加载待归类主型号" />
                            </ui:Button.ToolTip>
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="分类名称"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentCategory.CategoryName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2"
                                   Text="假名"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding CurrentCategory.FakeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4"
                                   Text="分类代码"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding CurrentCategory.CategoryCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6"
                                   Text="排序号"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Width="140"
                                 HorizontalAlignment="Left"
                                 Text="{Binding CurrentCategory.SortNo, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Border Grid.Row="4"
                            Visibility="{Binding Assignment.IsAssignmentPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SwiftExportCornerRadius}"
                            Padding="8">
                        <Grid DataContext="{Binding Assignment}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="主型号快速归类到：" Style="{StaticResource BodyTextBlock}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TargetCategoryName}"
                                               Style="{StaticResource BodyTextBlock}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SwiftExportBrush.Accent}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="关闭"
                                        Command="{Binding CloseAssignmentPanelCommand}"
                                        Padding="10,3" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="输入主型号、描述或中性产品编码">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                
                                <ui:Button Grid.Column="1"
                                        Content="查询"
                                           Appearance="Primary"
                                        Command="{Binding SearchCommand}"
                                        Margin="4,0,0,0"
                                        Padding="12,4" />
                                
                                <ui:Button Grid.Column="2"
                                        Content="刷新"
                                        Command="{Binding RefreshCommand}"
                                        Margin="4,0,0,0"
                                        Padding="12,4" />

                                <ui:Button Grid.Column="3" Appearance="Info"
                                           Margin="4,0,0,0"
                                           Padding="12,4"   
                                           Command="{Binding AssignSelectedCommand}">
                                    <TextBlock Text="{Binding CheckedCount, StringFormat=归类 {0} 个主型号}"/>
                                </ui:Button>
                                
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusMessage}"
                                           Style="{StaticResource CaptionTextBlock}"
                                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />

                            </Grid>

                            <DataGrid Grid.Row="4"
                                      ItemsSource="{Binding Lines}"
                                      Style="{StaticResource SwiftExportDataGrid}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      RowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="45" IsReadOnly="True" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox IsChecked="{Binding DataContext.IsAllChecked,
                                                                         RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                                         Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="图片" Width="65" IsReadOnly="True" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <imageControls:CachedImage Width="40"
                                                                           Height="40"
                                                                           Style="{StaticResource SwiftExportCachedImage}"
                                                                           DecodePixelWidth="96"
                                                                           SourcePath="{Binding MainImagePath}"
                                                                           Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="主型号" Width="200" Binding="{Binding MasterSku}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"/>
                                    <DataGridTextColumn Header="中文描述" Width="*" Binding="{Binding DefaultDescriptionZh}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}"/>
                                    <DataGridTextColumn Header="当前分类" Width="220" Binding="{Binding OriginalCategoryName}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ValidationSummary}"
                                           Style="{StaticResource CaptionTextBlock}"
                                           Foreground="#B42318"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PageStatus}"
                                           Style="{StaticResource CaptionTextBlock}"
                                           Margin="12,0"
                                           VerticalAlignment="Center" />
                                <controls:PageNavigator Grid.Column="2"
                                                        TotalCount="{Binding TotalCount}"
                                                        PageIndex="{Binding PageIndex}"
                                                        PageSize="{Binding PageSize}"
                                                        PageSizeOptions="{Binding PageSizeOptions}"
                                                        PageChangeCommand="{Binding PageChangeCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource CaptionTextBlock}" />
            <TextBlock Text="  "
                       Style="{StaticResource CaptionTextBlock}" />
            <TextBlock Text="{Binding ValidationSummary}"
                       Style="{StaticResource CaptionTextBlock}"
                       Foreground="#B42318" />
        </StackPanel>
    </Grid>
</UserControl>
