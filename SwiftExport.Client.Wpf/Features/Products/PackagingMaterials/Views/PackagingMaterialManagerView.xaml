<UserControl
    x:Class="SwiftExportClient.Features.Products.PackagingMaterials.Views.PackagingMaterialManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
    xmlns:selection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:suppliers="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Height="980"
    d:Width="1620"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SelectionCheckMenuItem"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </Style>
        <proxies:BindingProxy x:Key="PackagingManagerProxy" Data="{Binding}" />
        <selection:GridSelectionUnitConverter x:Key="SelectionUnitConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="包材管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="包材搜索"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="按编号、中英文描述或规格搜索"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Data.SearchCommand, Source={StaticResource PackagingManagerProxy}}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding ResetCommand}"
                        Content="重置" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding AddRowCommand}"
                            Content="新增" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="保存" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除" />

                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding RejectCommand}"
                            Content="撤销" />

                        <Button
                            MinWidth="70"
                            Margin="0,0,8,0"
                            Command="{Binding OpenDetailCommand}"
                            Content="物料详情" />

                        <Button
                            MinWidth="70"
                            Margin="0,0,16,0"
                            Command="{Binding UploadImagesCommand}"
                            Content="上传图片" />

                        <ui:DropDownButton Margin="0,0,8,0" Content="更多功能">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="占位" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ToggleButton
                            x:Name="OptionsToggleButton"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Content="更多条件" />


                        <ui:ToggleSwitch
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                            OffContent="整行模式"
                            OnContent="格子模式" />

                    </WrapPanel>
                </DockPanel>

                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">
                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton
                                MinWidth="70"
                                VerticalAlignment="Top"
                                Content="关闭"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, ElementName=OptionsToggleButton}" />

                            <StackPanel MinHeight="120" Orientation="Horizontal">
                                <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto,Auto" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <DataGrid
            x:Name="PackageGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            AutomationProperties.Name="包材档案列表"
            BeginningEdit="OnBeginningEdit"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            IsEnabled="{Binding IsNotBusy}"
            IsReadOnly="{Binding IsGridReadOnly}"
            ItemsSource="{Binding Products.Items}"
            RowHeight="{DynamicResource DataGridRowHeightMedium}"
            SelectedItem="{Binding SelectedLine}"
            SelectionMode="Extended"
            SelectionUnit="{Binding IsCellSelectionMode, Converter={StaticResource SelectionUnitConverter}}"
            Style="{StaticResource SwiftExportDataGrid}">
            <i:Interaction.Behaviors>
                <gridCore:DataGridColumnVisibilityBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu AutomationProperties.Name="包材当前页列表操作" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem
                        Command="{Binding CheckSelectionCommand}"
                        Header="勾选(选区)"
                        Style="{StaticResource SelectionCheckMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding UncheckSelectionCommand}"
                        Header="取消勾选(选区)"
                        Style="{StaticResource SelectionCheckMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Square24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding InvertSelectionCommand}"
                        Header="反选(选区)"
                        Style="{StaticResource SelectionCheckMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Command="{Binding CheckVisibleCommand}"
                        Header="全选(当前显示行)"
                        ToolTip="仅操作本表当前显示行">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="SelectAllOn24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding InvertVisibleCommand}"
                        Header="反选(当前显示行)"
                        ToolTip="仅操作本表当前显示行">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="SelectAllOff24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding OpenDetailCommand}" Header="物料详情">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Edit24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding DeleteSelectedCommand}" Header="删除">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Header="表格模式"
                        IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                        Style="{StaticResource ToggleMenuItemStyle}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Table24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>

                <DataGridTemplateColumn
                    Width="48"
                    CanUserResize="False"
                    CanUserSort="False"
                    ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                    Header="勾选">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="勾选包材当前页显示行"
                                Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="64"
                    Header="状态"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}" TargetType="TextBlock">
                                        <Setter Property="Text" Value="已保存" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                <Setter Property="Text" Value="新增" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Text" Value="已修改" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="编号" />

                <DataGridTemplateColumn Width="64" Header="图片">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage
                                Width="48"
                                Height="48"
                                SourcePath="{Binding MainImage}"
                                Style="{StaticResource SwiftExportCachedImage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox AutomationProperties.Name="包材图片地址" Text="{Binding MainImage, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="中文描述" />

                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="英文描述" />

                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding FeaturesZh, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="中文规格" />

                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="英文规格" />

                <DataGridTemplateColumn
                    Width="100"
                    ClipboardContentBinding="{Binding Unit, Mode=OneWay}"
                    Header="基础单位">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding Unit}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="包材基础单位"
                                DisplayMemberPath="DataNameEn"
                                ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedValue="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="DataNameEn" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="100"
                    ClipboardContentBinding="{Binding SupplyType, Mode=OneWay}"
                    Header="供货方式">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding SupplyType}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="包材供货方式"
                                ItemsSource="{Binding DataContext.SupplyTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding SupplyType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="180"
                    ClipboardContentBinding="{Binding DefaultSupplierCode, Mode=OneWay}"
                    Header="默认供应商">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding DefaultSupplierCode}"
                                ToolTip="{Binding SupplierName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <suppliers:SupplierLookupTextBox
                                AutomationProperties.Name="包材默认供应商"
                                ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}"
                                SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                Text="{Binding DefaultSupplierCode, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding UnitWeight, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="单件自重(KG)" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding CnyPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="人民币参考价" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding UsdPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="美元参考价" />

                <DataGridTextColumn
                    Width="240"
                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="备注" />

            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <controls:PageNavigator
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsNotBusy}"
                PageChangeCommand="{Binding PageChangeCommand}"
                PageSize="{Binding PageSize}"
                TotalCount="{Binding TotalCount}"
                PageIndex="{Binding PageIndex}" />
            <StackPanel>
                <TextBlock
                    AutomationProperties.Name="包材操作结果"
                    Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                    Text="{Binding ResultSummary}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource CaptionTextBlock}" Text="{Binding PageStatus}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
