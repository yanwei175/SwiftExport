<UserControl x:Class="SwiftExportClient.Features.Products.PackagingMaterials.Views.PackagingMaterialManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="1620" d:Height="980"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
            xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
            xmlns:suppliers="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
            xmlns:selection="clr-namespace:SwiftExportClient.Resources.Converters"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
            Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Style x:Key="SelectionCheckMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>
        <proxies:BindingProxy x:Key="PackagingManagerProxy" Data="{Binding}"/>
        <selection:GridSelectionUnitConverter x:Key="SelectionUnitConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="包材管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="按编号、中英文描述或规格搜索" AutomationProperties.Name="包材搜索">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding Data.SearchCommand, Source={StaticResource PackagingManagerProxy}}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="重置" Command="{Binding ResetCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>

            </Grid>


            <StackPanel Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <WrapPanel HorizontalAlignment="Left">

                        <ui:Button Content="新增" MinWidth="70"  Command="{Binding AddRowCommand}" Margin="0,0,8,0" />

                        <ui:Button Content="保存" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="70"/>

                        <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" MinWidth="70" />

                        <ui:Button Content="撤销" Command="{Binding RejectCommand}" Margin="0,0,8,0" MinWidth="70"/>

                        <Button Content="物料详情" Command="{Binding OpenDetailCommand}" Margin="0,0,8,0" MinWidth="70"/>

                        <Button Content="上传图片" Command="{Binding UploadImagesCommand}" Margin="0,0,16,0" MinWidth="70"/>

                        <ui:DropDownButton Content="更多功能" Margin="0,0,8,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="占位"/>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Margin="0,0,8,0" HorizontalAlignment="Left" />


                        <ui:ToggleSwitch Margin="0,0,12,0" VerticalAlignment="Center" OffContent="整行模式" OnContent="格子模式"
                                         IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />

                    </WrapPanel>
                </DockPanel>

                <Popup IsOpen="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top"
                                              Content="关闭" MinWidth="70"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay,ElementName=OptionsToggleButton}"/>

                            <StackPanel Orientation="Horizontal" MinHeight="120">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>

        <DataGrid x:Name="PackageGrid" Grid.Row="2" ItemsSource="{Binding Products.Items}" SelectedItem="{Binding SelectedLine}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  RowHeight="{DynamicResource DataGridRowHeightMedium}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="{Binding IsGridReadOnly}"
                  IsEnabled="{Binding IsNotBusy}"
                  SelectionUnit="{Binding IsCellSelectionMode, Converter={StaticResource SelectionUnitConverter}}"
                  SelectionMode="Extended"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  BeginningEdit="OnBeginningEdit" AutomationProperties.Name="包材档案列表">
            <i:Interaction.Behaviors><gridCore:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="包材当前页列表操作">
                    <MenuItem Header="勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding CheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkSquare24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="取消勾选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding UncheckSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Square24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(选区)" Style="{StaticResource SelectionCheckMenuItem}" Command="{Binding InvertSelectionCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="全选(当前显示行)" Command="{Binding CheckVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="反选(当前显示行)" Command="{Binding InvertVisibleCommand}" ToolTip="仅操作本表当前显示行"><MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOff24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="物料详情" Command="{Binding OpenDetailCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Edit24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="删除" Command="{Binding DeleteSelectedCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Delete24"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Header="勾选" Width="48" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" Margin="0" Padding="0" AutomationProperties.Name="勾选包材当前页显示行"
                                      IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                      Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="状态" Width="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridWarpTextBlock}">
                                        <Setter Property="Text" Value="已保存"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                <Setter Property="Text" Value="新增"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Text" Value="已修改"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="编号" Width="140" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTemplateColumn Header="图片" Width="64">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="48" Height="48" SourcePath="{Binding MainImage}" Style="{StaticResource SwiftExportCachedImage}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MainImage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="包材图片地址"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="中文描述" Width="200" Binding="{Binding DescriptionZh, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTextColumn Header="英文描述" Width="220" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"/>

                <DataGridTextColumn Header="中文规格" Width="200" Binding="{Binding FeaturesZh, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="英文规格" Width="200" Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding Unit, Mode=OneWay}" Header="基础单位" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Unit}" Style="{StaticResource SwiftExportDataGridTextBlock}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox VerticalContentAlignment="Center"
                        ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        DisplayMemberPath="DataNameEn" SelectedValuePath="DataNameEn" SelectedValue="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="包材基础单位"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding SupplyType, Mode=OneWay}" Header="供货方式" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SupplyType}" Style="{StaticResource SwiftExportDataGridTextBlock}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox VerticalContentAlignment="Center"
                        ItemsSource="{Binding DataContext.SupplyTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        SelectedItem="{Binding SupplyType, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="包材供货方式"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn ClipboardContentBinding="{Binding DefaultSupplierCode, Mode=OneWay}" Header="默认供应商" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DefaultSupplierCode}" VerticalAlignment="Center" ToolTip="{Binding SupplierName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <suppliers:SupplierLookupTextBox
                        Text="{Binding DefaultSupplierCode, Mode=OneWay}" AutomationProperties.Name="包材默认供应商"
                        ItemsSource="{Binding DataContext.SupplierCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        SelectedSupplier="{Binding DataContext.EditSupplier, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                        SearchCommand="{Binding DataContext.SearchSuppliersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        SelectionCommittedCommand="{Binding DataContext.CommitSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionCommittedCommandParameter="{Binding}"
                        SelectionClearedCommand="{Binding DataContext.ClearSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectionClearedCommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="单件自重(KG)" Width="120" Binding="{Binding UnitWeight, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="人民币参考价" Width="120" Binding="{Binding CnyPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="美元参考价" Width="120" Binding="{Binding UsdPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="备注" Width="240" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <controls:PageNavigator DockPanel.Dock="Right" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" IsEnabled="{Binding IsNotBusy}"/>
            <StackPanel>
                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                           AutomationProperties.Name="包材操作结果"/>
                <TextBlock Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
