<UserControl x:Class="SwiftExportClient.Features.Products.ProductMasterImport.Views.ProductMasterImportView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="1920" d:Height="680"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductMasterImport.ViewModels"
             d:DataContext="{d:DesignInstance vm:ProductMasterImportViewModel}"
            MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <WrapPanel Margin="0,0,0,12">
            <Button Content="下载导入模板" Click="OnDownloadTemplate" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0"/>
            <Button Content="加载文件" Click="OnChooseFile" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedSheet}" IsEnabled="{Binding CanUseFiles}" MinWidth="140" Margin="0,0,8,0" AutomationProperties.Name="导入工作表"/>
            <Button Content="读取工作表" Command="{Binding ReadSheetCommand}" Margin="0,0,8,0"/>
            <Button Content="开始导入" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
            <Button Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
            <Button Content="下载未成功数据及原因" Click="OnDownloadErrors" IsEnabled="{Binding CanDownloadResults}"/>
        </WrapPanel>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding UploadPermissionHint}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding BatchSource}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        
        <ProgressBar Grid.Row="2" Minimum="0" 
                     Maximum="{Binding TotalCount}" 
                     Value="{Binding CompletedCount}" 
                     Height="6" Margin="0,0,0,12" 
                     AutomationProperties.Name="已收到保存回执的行数"/>
        
        <DataGrid x:Name="ImportGrid" Grid.Row="3" 
                  ItemsSource="{Binding VisibleRows}" 
                  IsReadOnly="True" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  EnableRowVirtualization="True" 
                  EnableColumnVirtualization="True" 
                  RowHeight="32" 
                  AutomationProperties.Name="父级型号导入队列">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原行号" Binding="{Binding SourceRowNumber}" Width="72"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="主型号" Binding="{Binding Input.MasterSku}" Width="150"/>
                <DataGridTextColumn Header="中文描述" Binding="{Binding Input.DefaultDescriptionZh}" Width="150"/>
                <DataGridTextColumn Header="英文描述" Binding="{Binding Input.DefaultDescriptionEn}" Width="150"/>
                <DataGridTextColumn Header="中文配置" Binding="{Binding Input.DefaultFeaturesZh}" Width="150"/>
                <DataGridTextColumn Header="英文配置" Binding="{Binding Input.DefaultFeaturesEn}" Width="150"/>
                <DataGridTextColumn Header="每箱装率" Binding="{Binding Input.DefaultPcsPerPackage}" Width="150"/>
                <DataGridTextColumn Header="每箱净重(KG)" Binding="{Binding Input.DefaultNetWeight}" Width="150"/>
                <DataGridTextColumn Header="每箱毛重(KG)" Binding="{Binding Input.DefaultGrossWeight}" Width="150"/>
                <DataGridTextColumn Header="每箱体积(CBM)" Binding="{Binding Input.DefaultCbm}" Width="150"/>
                <DataGridTextColumn Header="分类路径" Binding="{Binding Input.CategoryPath}" Width="150"/>
                <DataGridTextColumn Header="默认供应商编码" Binding="{Binding Input.DefaultSupplierCode}" Width="150"/>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="400"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="8,0,0,0"/>
                <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
