<UserControl x:Class="SwiftExportClient.Features.Products.ProductCategoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:products="clr-namespace:SwiftExportClient.Features.Products"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="920"
             Height="600">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="ProductCategoryTreeTemplate"
                                  DataType="{x:Type products:ProductCategoryTreeItemModel}"
                                  ItemsSource="{Binding Children}">
            <Border x:Name="NodeSurface"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="8,4"
                    Margin="0,4"
                    Background="Transparent">
                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="新建同级分类"
                                      Command="{Binding AddSiblingCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="新建子分类"
                                      Command="{Binding AddChildCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="删除此分类"
                                      Foreground="#B42318"
                                      Command="{Binding DeleteCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Folder24"
                                   Width="20"
                                   Height="20"
                                   FontSize="16"
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CategoryName}"
                               Style="{StaticResource BodyTextBlock}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding FakeName}"
                               Style="{StaticResource CaptionTextBlock}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                </Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="NodeSurface"
                            Property="Background"
                            Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="NodeSurface"
                            Property="Background"
                            Value="{DynamicResource SwiftExportBrush.SurfaceMuted}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="ProductCategoryTreeViewItem"
               TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource TitleTextBlock}" />
            <TextBlock Text="维护产品分类树、分类编码、假名和排序号。"
                       Style="{StaticResource SecondaryTextBlock}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="分类结构"
                                   Style="{StaticResource BodyTextBlock}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Command="{Binding AddRootCommand}"
                                    ToolTip="新增一级分类"
                                    Width="32"
                                    Height="32"
                                    Padding="0">
                                <ui:SymbolIcon Symbol="Add24" />
                            </Button>
                            <Button Command="{Binding RefreshCommand}"
                                    ToolTip="刷新"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="8,0,0,0">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding CategoryTree}"
                              ItemTemplate="{StaticResource ProductCategoryTreeTemplate}"
                              ItemContainerStyle="{StaticResource ProductCategoryTreeViewItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DropTargetAdornerBrush="{DynamicResource SwiftExportBrush.Accent}"
                              SelectedItemChanged="OnSelectedItemChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SwiftExportBrush.Surface}"
                    BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                    BorderThickness="{StaticResource SwiftExportBorderThickness}"
                    CornerRadius="{StaticResource SwiftExportCornerRadius}"
                    Padding="24">
                <Grid DataContext="{Binding CurrentCategory}">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="类目基础属性"
                                   Style="{StaticResource BodyTextBlock}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="修改后点击底部保存，变更会批量提交。"
                                   Style="{StaticResource CaptionTextBlock}"
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="分类名称"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2"
                                   Text="假名"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding FakeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4"
                                   Text="分类代码"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6"
                                   Text="排序号"
                                   Style="{StaticResource LabelTextBlock}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Width="140"
                                 HorizontalAlignment="Left"
                                 Text="{Binding SortNo, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="  "
                           Style="{StaticResource CaptionTextBlock}" />
                <TextBlock Text="{Binding ValidationSummary}"
                           Style="{StaticResource CaptionTextBlock}"
                           Foreground="#B42318" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="新增同级"
                        Command="{Binding AddSiblingCommand}"
                        CommandParameter="{Binding CurrentCategory}"
                        MinWidth="96" />
                <Button Content="新增子级"
                        Command="{Binding AddChildCommand}"
                        CommandParameter="{Binding CurrentCategory}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="删除"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding CurrentCategory}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
