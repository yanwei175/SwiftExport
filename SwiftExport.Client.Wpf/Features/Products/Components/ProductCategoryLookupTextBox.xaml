<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductCategoryLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             x:Name="Root"
             MinHeight="30">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type components:ProductCategoryLookupNode}"
                                  ItemsSource="{Binding Children}">
            <Grid MinWidth="280" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CategoryName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,4,0"
                           Text="{Binding CategoryCode}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="ProductCategoryLookupTreeItem"
               TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedCategory, ElementName=Root, Mode=TwoWay}"
                            SelectedValue="{Binding SelectedCategoryId, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            IsBusy="{Binding IsRefreshing, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="CategoryName"
                            FilterMemberPaths="CategoryName,CategoryCode,FakeName"
                            SelectedValuePath="Uid"
                            ClearSelectionOnEdit="False"
                            RequireItemMatch="True">
        <controls:LookupTextBox.CustomDropDownContent>
            <Grid MinWidth="360" MaxHeight="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="8,6,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="产品分类"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            MinWidth="56"
                            MinHeight="26"
                            Padding="8,2"
                            Content="刷新"
                            Command="{Binding RefreshCommand}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Separator Grid.Row="1" />

                <TreeView Grid.Row="2"
                          ItemsSource="{Binding FilteredRoots}"
                          ItemContainerStyle="{StaticResource ProductCategoryLookupTreeItem}"
                          HorizontalContentAlignment="Stretch"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItemChanged="CategoryTree_SelectedItemChanged"
                          PreviewMouseLeftButtonUp="CategoryTree_PreviewMouseLeftButtonUp" />
            </Grid>
        </controls:LookupTextBox.CustomDropDownContent>
    </controls:LookupTextBox>
</UserControl>
