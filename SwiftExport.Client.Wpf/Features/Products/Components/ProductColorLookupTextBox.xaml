<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductColorLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:products="clr-namespace:SwiftExport.Contracts.DTOs.Products;assembly=SwiftExport.Contracts"
             x:Name="Root"
             FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSize}"
             MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="ProductColorLookupItemTemplate"
                      DataType="{x:Type products:ProductColorDto}">
            <Grid MinWidth="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ColorNameZh}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1" Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ColorCodeUnique}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding ColorCode}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding ColorNameEn}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor" StretchToHost="True"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedColor, ElementName=Root, Mode=TwoWay}"
                            SelectedValue="{Binding SelectedColorId, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="ColorNameZh"
                            FilterMemberPaths="ColorCodeUnique,ColorCode,ColorNameZh,ColorNameEn"
                            SelectedValuePath="Uid"
                            ClearSelectionOnEdit="False"
                            RequireItemMatch="True"
                            ItemTemplate="{StaticResource ProductColorLookupItemTemplate}" />
</UserControl>
