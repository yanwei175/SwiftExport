<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductColorAutoSuggestComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:products="clr-namespace:SwiftExport.Contracts.DTOs.Products;assembly=SwiftExport.Contracts"
             x:Name="Root" FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSizeInTitle}" MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="ProductColorItemTemplate" DataType="{x:Type products:ProductColorDto}">
            <Grid MinWidth="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock FontWeight="SemiBold" Text="{Binding ColorNameZh}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="1" Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" 
                               Text="{Binding ColorCodeUnique}" />
                    <TextBlock Margin="8,0,0,0" 
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" 
                               Text="{Binding ColorCode}" />
                    <TextBlock Margin="8,0,0,0" 
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" 
                               Text="{Binding ColorNameEn}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <controls:LookupTextBox x:Name="LookupEditor"
                            automation:AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedColor, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            SearchMode="Local" 
                            DisplayMemberPath="ColorNameZh" 
                            FilterMemberPaths="ColorNameZh,ColorCode,ColorNameEn"
                            SelectedValuePath="Uid" 
                            RequireItemMatch="True" 
                            ClearSelectionOnEdit="False"
                            ShowDropDownButton="True" 
                            MatchSuggestionFontSize="True"
                            ItemTemplate="{StaticResource ProductColorItemTemplate}" />
</UserControl>
