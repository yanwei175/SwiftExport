<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductCategoryMutiSelectButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:filter="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
             x:Name="Root" MinHeight="30">
    <filter:MultiSelectLookupButton x:Name="CategoryPicker"
                                   Header="{Binding Header, ElementName=Root}"
                                   SelectedItems="{Binding SelectedItems, ElementName=Root, Mode=TwoWay}"
                                   SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                                   SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                                   Placeholder="搜索产品分类"
                                   DisplayMemberPath="FakeName"
                                   FilterMemberPaths="FakeName,CategoryName,CategoryCode"
                                   SelectedValuePath="Uid"
                                   ChildrenMemberPath="Children" />
</UserControl>
