<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductCategoryFilterTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="120"
             MinHeight="80">
    <UserControl.Resources>
        <Style x:Key="ProductCategoryFilterTreeItem"
               TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{DynamicResource ContentControlFontSize}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="2" />
        </Style>
    </UserControl.Resources>

    <TreeView x:Name="CategoryTree"
              ItemContainerStyle="{StaticResource ProductCategoryFilterTreeItem}"
              BorderThickness="0"
              HorizontalContentAlignment="Stretch"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              PreviewMouseLeftButtonDown="CategoryTree_PreviewMouseLeftButtonDown"
              PreviewKeyDown="CategoryTree_PreviewKeyDown">
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <Grid MinHeight="26" Margin="0,2"
                      Background="Transparent"
                      AutomationProperties.Name="{Binding DisplayName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Margin="-4,0,0,0"
                              Padding="0,0,12,0"
                              VerticalAlignment="Center"
                              Focusable="False"
                              IsThreeState="True"
                              IsChecked="{Binding IsChecked, Mode=OneWay}"
                              Click="CategoryCheckBox_Click" >
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
