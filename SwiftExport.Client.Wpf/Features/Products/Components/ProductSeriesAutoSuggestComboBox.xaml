<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductSeriesAutoSuggestComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             x:Name="Root"
             FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSize}"
             MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="ProductSeriesLookupItemTemplate">
            <StackPanel MinWidth="240">
                <TextBlock Text="{Binding DataNameZh}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DataNameEn}"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor" StretchToHost="True" ShowDropDownButton="True"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedSeries, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="DataNameZh"
                            FilterMemberPaths="DataNameZh,DataNameEn"
                            SelectedValuePath="Uid"
                            ClearSelectionOnEdit="False"
                            RequireItemMatch="True"
                            ItemTemplate="{StaticResource ProductSeriesLookupItemTemplate}" />
</UserControl>
