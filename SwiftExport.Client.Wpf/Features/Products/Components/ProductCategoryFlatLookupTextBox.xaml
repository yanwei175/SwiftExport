<UserControl x:Class="SwiftExportClient.Features.Products.Components.ProductCategoryFlatLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:caching="clr-namespace:SwiftExportClient.Services.Caching"
             x:Name="Root"
             FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSize}"
             MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="ProductCategoryFlatLookupItemTemplate"
                      DataType="{x:Type caching:ProductCategoryCacheNode}">
            <Grid MinWidth="340">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CategoryPath}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CategoryPath}" />
                <StackPanel Grid.Row="1" Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding CategoryCode}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding FakeName}"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedCategory, ElementName=Root, Mode=TwoWay}"
                            SelectedValue="{Binding SelectedCategoryId, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="CategoryName"
                            FilterMemberPaths="CategoryName,CategoryCode,FakeName,CategoryPath"
                            SelectedValuePath="Uid"
                            ClearSelectionOnEdit="False"
                            RequireItemMatch="True"
                            ItemTemplate="{StaticResource ProductCategoryFlatLookupItemTemplate}" />
</UserControl>
