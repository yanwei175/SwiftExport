<UserControl x:Class="SwiftExportClient.Features.Products.ProductNeutralImport.Views.ProductNeutralImportView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="1920" d:Height="680"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Products.ProductNeutralImport.ViewModels"
             d:DataContext="{d:DesignInstance vm:ProductNeutralImportViewModel}"
            MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <WrapPanel Margin="0,0,0,12">
            <Button Content="下载导入模板" Click="OnDownloadTemplate" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0"/>
            <Button Content="加载文件" Click="OnChooseFile" IsEnabled="{Binding CanUseFiles}" Margin="0,0,8,0"/>

            <ComboBox MinWidth="140" Margin="0,0,8,0" 
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding Worksheets}" 
                      SelectedItem="{Binding SelectedSheet}" 
                      IsEnabled="{Binding CanUseFiles}"                       
                      AutomationProperties.Name="导入工作表"/>
            
            <Button Content="读取工作表" Command="{Binding ReadSheetCommand}" Margin="0,0,8,0"/>
            <Button Content="开始导入" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
            <Button Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,0" MinWidth="70"/>
            <Button Content="下载未成功数据及原因" Click="OnDownloadErrors" IsEnabled="{Binding CanDownloadResults}"/>
        </WrapPanel>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding UploadPermissionHint}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding BatchSource}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        
        <ProgressBar Grid.Row="2" Minimum="0" 
                     Maximum="{Binding TotalCount}" 
                     Value="{Binding CompletedCount}" 
                     Height="6" Margin="0,0,0,12" 
                     AutomationProperties.Name="已收到保存回执的行数"/>
        
        <DataGrid x:Name="ImportGrid" Grid.Row="3" 
                  ItemsSource="{Binding VisibleRows}" 
                  IsReadOnly="True" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  EnableRowVirtualization="True" 
                  EnableColumnVirtualization="True" 
                  RowHeight="32" 
                  AutomationProperties.Name="中性产品导入队列">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原行号" Binding="{Binding SourceRowNumber}" Width="72"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="主型号" Binding="{Binding Input.MasterSku}" Width="150"/>
                <DataGridTextColumn Header="中性产品编码" Binding="{Binding Input.ProductCode}" Width="150"/>
                <DataGridTextColumn Header="颜色唯一编码" Binding="{Binding Input.ColorCodeUnique}" Width="150"/>
                <DataGridTextColumn Header="默认人民币采购价" Binding="{Binding Input.DefaultPurchasePriceCny}" Width="150"/>
                <DataGridTextColumn Header="默认美元销售价" Binding="{Binding Input.DefaultSalesPriceUsd}" Width="150"/>
                <DataGridTextColumn Header="默认汇率" Binding="{Binding Input.DefaultExchangeRate}" Width="150"/>
                <DataGridTextColumn Header="利润率" Binding="{Binding Input.ProfitMargin}" Width="150"/>
                <DataGridTextColumn Header="图片地址" Binding="{Binding Input.ImagePath}" Width="150"/>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="400"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="8,0,0,0"/>
                <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
