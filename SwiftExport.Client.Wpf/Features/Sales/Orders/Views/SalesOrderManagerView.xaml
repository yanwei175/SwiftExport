<UserControl x:Class="SwiftExportClient.Features.Sales.Orders.Views.SalesOrderManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:salesComponents="clr-namespace:SwiftExportClient.Features.Sales.Orders.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:images="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GrossDemandWorkspaceViewModel}"
             d:Width="1500"
             d:Height="900">
    <UserControl.Resources>
        <salesComponents:SalesOrderStateTextConverter x:Key="SalesOrderStateTextConverter" />
        <salesComponents:SalesOrderDueAlertConverter x:Key="SalesOrderDueAlertConverter" />
        <Style x:Key="SalesOrderToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="70" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*" HorizontalAlignment="Stretch">
                <TextBlock Text="销售订单管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1" VerticalAlignment="Stretch"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="订单号、客户、客户PO、发票号">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" 
                               VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>
            </Grid>
            
            <StackPanel Grid.Row="2">
                <DockPanel Grid.Row="2" >
                    <Button Content="新建订单" Command="{Binding OpenNewCommand}" Style="{StaticResource SalesOrderToolbarButton}"/>

                    <ui:Button Content="打开订单" Command="{Binding OpenSelectedCommand}" Style="{StaticResource SalesOrderToolbarButton}"  />

                    <Button Content="履约详情" Command="{Binding OpenFulfillmentDetailCommand}" Style="{StaticResource SalesOrderToolbarButton}" />

                    <Button Content="确认订单" Command="{Binding ConfirmSelectedCommand}" Style="{StaticResource SalesOrderToolbarButton}" />
                    <Button Content="重试待确认" Command="{Binding RetryPendingConfirmationCommand}" Style="{StaticResource SalesOrderToolbarButton}" />
                    <Button Content="重试待处理" Command="{Binding RetryPendingActionCommand}" Style="{StaticResource SalesOrderToolbarButton}" />

                    <ui:Button Content="取消确认"  Command="{Binding CancelConfirmationCommand}" Style="{StaticResource SalesOrderToolbarButton}"/>

                    <ui:Button Content="关闭订单"  Command="{Binding CloseSelectedCommand}" Margin="0,0,8,0" MinWidth="70"
                           Foreground="{DynamicResource UserTextFillColorInverseBrush}"
                           Appearance="Danger"/>

                    <Button Command="{Binding DeleteDraftCommand}" Style="{StaticResource SalesOrderToolbarButton}" Content="删除草稿" />
                    
                    <Separator Margin="0,0,8,0"/>
                    
                    <!--待换成CustomerAutoSuggestComboBox-->
                    <ui:AutoSuggestBox Grid.Column="0" Margin="0,0,8,0" Width="130"
                                   ToolTip="客户代码"
                                   PlaceholderText="客户代码"
                                   ClearButtonEnabled="True"
                                   UpdateTextOnSelect="True"
                                   MaxSuggestionListHeight="280"
                                   OriginalItemsSource="{Binding CustomerCodeOptions}"
                                   Text="{Binding CustomerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <controls:DropDownCheckBox Grid.Column="6" Margin="0,0,8,0"
                                           ToolTip="确认状态"
                                           Placeholder="确认状态"
                                           DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding ConfirmationStatusOptions}"
                                           SelectedItems="{Binding SelectedConfirmationStatuses, Mode=OneWay}" />
                    <controls:DropDownCheckBox Grid.Column="8" Margin="0,0,8,0"
                                           ToolTip="单据状态"
                                           Placeholder="单据状态"
                                           DisplayMemberPath="DisplayText"
                                           ItemsSource="{Binding DocumentStatusOptions}"
                                           SelectedItems="{Binding SelectedDocumentStatuses, Mode=OneWay}" />
                    
                    <ComboBox Width="130" Margin="0,0,8,0" ToolTip="快捷视图" VerticalContentAlignment="Center"
                              ItemsSource="{Binding QuickViewOptions}"
                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                              SelectedValue="{Binding QuickView, Mode=TwoWay}" />
                    
                    <ToggleButton x:Name="OptionsToggleButton" Content="更多条件" Grid.Column="10"
                              Margin="0,0,8,0"
                              IsChecked="{Binding IsAdvancedFilterOpen, Mode=TwoWay}"
                              HorizontalAlignment="Left" />

                </DockPanel>


                <Popup IsOpen="{Binding IsAdvancedFilterOpen, Mode=TwoWay}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    
                    <Border Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" MinHeight="120">

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,130,Auto,Auto">

                                <TextBlock Grid.Row="0" Grid.Column="0" Text=" 订单日期起 : " Margin="0,0,8,0"/>

                                <DatePicker Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"  VerticalAlignment="Top" 
                                        SelectedDateFormat="Short"
                                        SelectedDate="{Binding OrderDateFrom}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text=" 订单日期至 : " Margin="0,0,8,0"/>
                                <DatePicker Grid.Row="0" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Top" 
                                        SelectedDateFormat="Short"  
                                        SelectedDate="{Binding OrderDateTo}" />


                                <TextBlock Grid.Row="1" Grid.Column="0" Text=" 有效交期起 : " Margin="0,0,8,0"/>
                                <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top"
                                        SelectedDateFormat="Short"  
                                        SelectedDate="{Binding EffectiveDeliveryDateFrom}" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text=" 有效交期至 : " Margin="0,0,8,0"/>
                                <DatePicker Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Top" 
                                        SelectedDateFormat="Short" 
                                        SelectedDate="{Binding EffectiveDeliveryDateTo}" />
                            </Grid>
                            <ui:TextBox  Width="140" Margin="0,0,8,0"
                                    PlaceholderText="订单号" VerticalAlignment="Top"
                                    Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox  Width="140" Margin="0,0,8,0"
                                    PlaceholderText="客户PO" VerticalAlignment="Top"
                                    Text="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox  Width="140" Margin="0,0,8,0"
                                    PlaceholderText="发票号" VerticalAlignment="Top"
                                    Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox  Width="220" Margin="0,0,8,0"
                                    PlaceholderText="多行客户型号"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            <!--主数据-->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <DataGrid x:Name="OrdersGrid" Grid.Row="0"
                  IsEnabled="{Binding CanBrowse}"
                  RowHeight="35"
                  FontSize="12"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  gridCore:GridRowHeader.ShowRowNumber="True"
                  SelectionChanged="OrdersGrid_OnSelectionChanged"
                  MouseDoubleClick="OrdersGrid_OnMouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridTextBlock}">

                        </Style>

                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="确认" Width="72" 
                                    Binding="{Binding ConfirmationStatus}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="单据" Width="72" 
                                    Binding="{Binding DocumentStatus, Converter={StaticResource SalesOrderStateTextConverter}}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="执行" Width="82" 
                                    Binding="{Binding FulfillmentStatus, Converter={StaticResource SalesOrderStateTextConverter}}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="订单号" Width="135" 
                                    Binding="{Binding OrderNo}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="订单日期" Width="96" 
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" />
                        
                        <DataGridTextColumn Header="客户" Width="105" 
                                    Binding="{Binding CustomerCode}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="客户名称" Width="150" 
                                    Binding="{Binding CustomerName}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="发票号" Width="110" 
                                            Binding="{Binding InvoiceNo}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        
                        <DataGridTextColumn Header="未完成最早交期" Width="118"
                                            Binding="{Binding EarliestOpenDueDate, StringFormat=yyyy-MM-dd}"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" />
                        
                        <DataGridTextColumn Header="交期提醒" Width="178"
                                            Binding="{Binding Converter={StaticResource SalesOrderDueAlertConverter}}"
                                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" />
                        
                        <DataGridTextColumn Header="数量" Width="80" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding TotalQty, StringFormat=N0, TargetNullValue=查看明细}" />
                        
                        <DataGridTextColumn Header="已交" Width="80"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding TotalShippedQty, StringFormat=N0, TargetNullValue=查看明细}" />
                        
                        <DataGridTextColumn Header="未交" Width="80"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            Binding="{Binding TotalUnshippedQty, StringFormat=N0, TargetNullValue=查看明细}" />
                        
                        <DataGridTextColumn Header="单位" Width="66"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding UnitSnapshot, TargetNullValue=—}" />
                        
                        <DataGridTextColumn Header="需核实原因" Width="170"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding ReviewReason}" />
                        
                    </DataGrid.Columns>
                </DataGrid>

                <!--分页控件-->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
                    <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
                </Grid>
            </Grid>


            <GridSplitter Grid.Row="1" Height="6" 
                          Background="Transparent"
                          HorizontalAlignment="Stretch" />

            <!--从表-->
            <DataGrid Grid.Row="2"
                  RowHeight="{StaticResource DataGridRowHeightMedium}"
                  FontSize="{StaticResource SwiftExportDefaltFontSize}"
                  ItemsSource="{Binding SelectedOrderLines}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="行" Width="35" Binding="{Binding LineNumber}"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"/>

                    <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <images:CachedImage Width="48" Height="48" Margin="2"
                                                Style="{StaticResource SwiftExportCachedImage}"
                                                Stretch="Uniform"
                                                SourcePath="{Binding MainImage}" 
                                                DecodePixelWidth="72"  />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn Header="类型" Width="58"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding IsNonStandard, Converter={StaticResource SalesOrderStateTextConverter}}" />

                    <DataGridTextColumn Header="客户货号" Width="130"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding CustomerSku}" />
                    
                    <DataGridTextColumn Header="SKU" Width="150"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding Sku}" />
                    
                    <DataGridTextColumn Header="描述" Width="220"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding DescriptionEn}" />
                    
                    <DataGridTextColumn Header="颜色" Width="110"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding ColorNameEn}" />
                    
                    <DataGridTextColumn Header="数量" Width="80"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding Qty, StringFormat=N2}" />
                    
                    <DataGridTextColumn Header="已交" Width="80"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding ShippedQty, StringFormat=N0, TargetNullValue=未知}" />
                    
                    <DataGridTextColumn Header="未交" Width="80"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding UnshippedQty, StringFormat=N0, TargetNullValue=未知}" />
                    
                    <DataGridTextColumn Header="单位" Width="65"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding UnitSnapshot}" />
                    
                    <DataGridTextColumn Header="核实提示" Width="130"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding ReviewReason}" />
                    
                    <DataGridTextColumn Header="USD单价" Width="88" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding UsdPrice, StringFormat=N2}" />
                    
                    <DataGridTextColumn Header="CNY单价" Width="88" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding CnyPrice, StringFormat=N2}" />
                    
                    <DataGridTextColumn Header="预计交期" Width="96" 
                                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                                    Binding="{Binding ExpectedDeliveryDate, StringFormat=yyyy-MM-dd}" />
                    
                    <DataGridTextColumn Header="备注" Width="*" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    Binding="{Binding SubNote}" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>


    </Grid>
</UserControl>
