<UserControl
    x:Class="SwiftExportClient.Features.Sales.Orders.Views.SalesOrderManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:images="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:salesComponents="clr-namespace:SwiftExportClient.Features.Sales.Orders.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.DemandPlanning.GrossDemand.ViewModels"
    d:DataContext="{d:DesignInstance vm:GrossDemandWorkspaceViewModel}"
    d:Height="900"
    d:Width="1500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <salesComponents:SalesOrderDeliveryDateConverter x:Key="SalesOrderDeliveryDateConverter" />
        <salesComponents:SalesOrderStateTextConverter x:Key="SalesOrderStateTextConverter" />
        <Style
            x:Key="SalesOrderToolbarButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="70" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid HorizontalAlignment="Stretch" ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="销售订单管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="订单号、客户、客户PO、发票号"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <DockPanel Grid.Row="2">
                    <Button
                        Command="{Binding OpenNewCommand}"
                        Content="新建订单"
                        Style="{StaticResource SalesOrderToolbarButton}" />

                    <ui:Button
                        Command="{Binding OpenSelectedCommand}"
                        Content="打开订单"
                        Style="{StaticResource SalesOrderToolbarButton}" />


                    <Button
                        Command="{Binding ConfirmSelectedCommand}"
                        Content="确认订单"
                        Style="{StaticResource SalesOrderToolbarButton}" />
                    <Button
                        Command="{Binding RetryPendingConfirmationCommand}"
                        Content="重试待确认"
                        Style="{StaticResource SalesOrderToolbarButton}" />
                    <Button
                        Command="{Binding RetryPendingActionCommand}"
                        Content="重试待处理"
                        Style="{StaticResource SalesOrderToolbarButton}" />

                    <ui:Button
                        Command="{Binding CancelConfirmationCommand}"
                        Content="取消确认"
                        Style="{StaticResource SalesOrderToolbarButton}" />

                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Appearance="Danger"
                        Command="{Binding CloseSelectedCommand}"
                        Content="关闭订单"
                        Foreground="{DynamicResource UserTextFillColorInverseBrush}" />

                    <Button
                        Command="{Binding DeleteDraftCommand}"
                        Content="删除草稿"
                        Style="{StaticResource SalesOrderToolbarButton}" />

                    <Separator Margin="0,0,8,0" />

                    <lookup:MultiSelectLookupButton
                        x:Name="CustomerCodesSelector"
                        MinWidth="130"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="客户代码多选"
                        Header="客户代码"
                        IsEnabled="{Binding CanBrowse}"
                        ItemsSource="{Binding CustomerCodeOptions}"
                        SelectedItems="{Binding SelectedCustomerCodes, Mode=OneWay}" />

                    <controls:DropDownCheckBox
                        Grid.Column="6"
                        Margin="0,0,8,0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding ConfirmationStatusOptions}"
                        Placeholder="确认状态"
                        SelectedItems="{Binding SelectedConfirmationStatuses, Mode=OneWay}"
                        ToolTip="确认状态" />
                    <controls:DropDownCheckBox
                        Grid.Column="8"
                        Margin="0,0,8,0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding DocumentStatusOptions}"
                        Placeholder="单据状态"
                        SelectedItems="{Binding SelectedDocumentStatuses, Mode=OneWay}"
                        ToolTip="单据状态" />

                    <ToggleButton
                        x:Name="OptionsToggleButton"
                        Grid.Column="10"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        Content="更多条件"
                        IsChecked="{Binding IsAdvancedFilterOpen, Mode=TwoWay}" />

                </DockPanel>


                <Popup
                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsAdvancedFilterOpen, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="4">

                    <Border
                        Padding="8"
                        Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel MinHeight="120" Orientation="Horizontal">

                            <Grid ColumnDefinitions="Auto,130,Auto,Auto" RowDefinitions="Auto,Auto">

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Text=" 订单日期起 : " />

                                <DatePicker
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Top"
                                    SelectedDate="{Binding OrderDateFrom}"
                                    SelectedDateFormat="Short" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    Text=" 订单日期至 : " />
                                <DatePicker
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    SelectedDate="{Binding OrderDateTo}"
                                    SelectedDateFormat="Short" />


                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Text=" 有效交期起 : " />
                                <DatePicker
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    SelectedDate="{Binding EffectiveDeliveryDateFrom}"
                                    SelectedDateFormat="Short" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    Text=" 有效交期至 : " />
                                <DatePicker
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    SelectedDate="{Binding EffectiveDeliveryDateTo}"
                                    SelectedDateFormat="Short" />
                            </Grid>
                            <ui:TextBox
                                Width="140"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                PlaceholderText="订单号"
                                Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox
                                Width="140"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                PlaceholderText="客户PO"
                                Text="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox
                                Width="140"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                PlaceholderText="发票号"
                                Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:TextBox
                                Width="220"
                                Margin="0,0,8,0"
                                AcceptsReturn="True"
                                PlaceholderText="多行客户型号"
                                Text="{Binding CustomerSkusText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="7*" />
            </Grid.RowDefinitions>
            <!--  主数据  -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    x:Name="OrdersGrid"
                    Grid.Row="0"
                    gridCore:GridRowHeader.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    FontSize="12"
                    IsEnabled="{Binding CanBrowse}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Orders}"
                    MouseDoubleClick="OrdersGrid_OnMouseDoubleClick"
                    RowHeight="35"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                    SelectionChanged="OrdersGrid_OnSelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock" />

                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="72"
                            Binding="{Binding ConfirmationStatus}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="确认" />

                        <DataGridTextColumn
                            Width="72"
                            Binding="{Binding DocumentStatus, Converter={StaticResource SalesOrderStateTextConverter}}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单据" />



                        <DataGridTextColumn
                            Width="135"
                            Binding="{Binding OrderNo}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="订单号" />

                        <DataGridTextColumn
                            Width="96"
                            Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                            Header="订单日期" />

                        <DataGridTextColumn
                            Width="105"
                            Binding="{Binding CustomerCode}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户" />

                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding CustomerName}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户名称" />

                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding InvoiceNo}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="发票号" />





                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding TotalQty, StringFormat=N0, TargetNullValue=—}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="数量" />





                        <DataGridTemplateColumn
                            Width="140"
                            ClipboardContentBinding="{Binding UnitSnapshot}"
                            Header="单位"
                            SortMemberPath="UnitSnapshot">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding UnitSnapshot, TargetNullValue=—}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMixedUnits}" Value="True">
                                                            <Setter Property="Text" Value="多单位" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" Text="缺少单位">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource SwiftExportDataGridTextBlock}" TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingUnit}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding CustomerPoNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                            Header="客户PO" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding DeliveryDate, StringFormat=yyyy-MM-dd}"
                            ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                            Header="订单交期" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Currency}"
                            ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                            Header="币种" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding TotalAmountOriginalCurrency, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="原币金额" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding TotalAmountLocalCurrency, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="本币金额" />
                    </DataGrid.Columns>
                </DataGrid>

                <!--  分页控件  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding ResultSummary}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding PageStatus}" />
                    <controls:PageNavigator
                        Grid.Column="2"
                        PageChangeCommand="{Binding PageChangeCommand}"
                        PageSize="{Binding PageSize}"
                        TotalCount="{Binding TotalCount}"
                        PageIndex="{Binding PageIndex}" />
                </Grid>
            </Grid>


            <GridSplitter
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <!--  从表  -->
            <DataGrid
                Grid.Row="2"
                AutoGenerateColumns="False"
                FontSize="{StaticResource SwiftExportDefaltFontSize}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding SelectedOrderLines}"
                RowHeight="{StaticResource DataGridRowHeightMedium}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource SwiftExportDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="35"
                        Binding="{Binding LineNumber}"
                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                        Header="行" />

                    <DataGridTemplateColumn
                        Width="60"
                        CanUserSort="False"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <images:CachedImage
                                    Width="48"
                                    Height="48"
                                    Margin="2"
                                    DecodePixelWidth="72"
                                    SourcePath="{Binding MainImage}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn
                        Width="58"
                        Binding="{Binding IsNonStandard, Converter={StaticResource SalesOrderStateTextConverter}}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="类型" />

                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding CustomerSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户货号" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Sku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="SKU" />

                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding LinkSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="中性型号" />
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding DescriptionEn}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="描述" />

                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding ColorNameEn}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="颜色" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Qty, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="数量" />





                    <DataGridTextColumn
                        Width="65"
                        Binding="{Binding UnitSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="单位" />



                    <DataGridTextColumn
                        Width="88"
                        Binding="{Binding UsdPrice, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="USD单价" />

                    <DataGridTextColumn
                        Width="88"
                        Binding="{Binding CnyPrice, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="CNY单价" />

                    <DataGridTemplateColumn
                        Width="100"
                        ClipboardContentBinding="{Binding ExpectedDeliveryDate}"
                        Header="预计交期"
                        SortMemberPath="ExpectedDeliveryDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SwiftExportDataGridDateTextBlock}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SalesOrderDeliveryDateConverter}" StringFormat="yyyy-MM-dd">
                                            <Binding Path="ExpectedDeliveryDate" />
                                            <Binding Path="DataContext.SelectedOrderDeliveryDate" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding SubNote}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="备注" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding FeaturesEn}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="规格" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding UsdAmount, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="USD金额" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding CnyAmount, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="CNY金额" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding PcsOfCarton, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="每箱数量" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding NwOfCarton, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="每箱净重" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding GwOfCarton, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="每箱毛重" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding CbmOfCarton, StringFormat=N3}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="每箱体积" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>


    </Grid>
</UserControl>
