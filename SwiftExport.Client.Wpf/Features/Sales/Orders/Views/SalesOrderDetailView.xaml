<UserControl x:Class="SwiftExportClient.Features.Sales.Orders.Views.SalesOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:salesComponents="clr-namespace:SwiftExportClient.Features.Sales.Orders.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"
             d:Width="1500"
             d:Height="900">
    <UserControl.Resources>
        <salesComponents:SalesOrderStateTextConverter x:Key="SalesOrderStateTextConverter" />
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />

        <Style x:Key="SalesOrderDetailToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <DataTemplate x:Key="SalesOrderCustomerLookupTemplate">
            <StackPanel Margin="4" Orientation="Horizontal">
                <TextBlock Text="{Binding CustomerCode}" FontWeight="SemiBold" Width="100" />
                <TextBlock Text="{Binding CustomerName}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SalesOrderDictionaryOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DataNameEn}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding DataNameZh}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SalesOrderCurrencyOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CurrencyCode}" />
                <TextBlock Margin="6,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding CurrencyNameZh}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12,8" RowDefinitions="Auto,4,*,4,Auto,4">
        <!--title-->
        <Grid Grid.Row="0" >
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="保存订单"
                               Icon="{ui:SymbolIcon Symbol=Save24}"
                                Command="{Binding SaveCommand}" 
                               Appearance="Primary" Margin="0,0,4,0"/>

                    <ui:Button Margin="0,0,4,0" 
                               Command="{Binding ConfirmCommand}" 
                                Content="确认订单" />

                    <ui:Button Margin="0,0,4,0" Command="{Binding CancelConfirmationCommand}"
                            Content="取消确认" />

                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Padding="8,4" Margin="0,0,4,0"  CornerRadius="4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="确认：" />
                            <TextBlock Text="{Binding Header.ConfirmationStatus}" FontWeight="SemiBold" />
                            <TextBlock Margin="12,0,0,0" Text="单据：" />
                            <TextBlock Text="{Binding Header.DocumentStatus, Converter={StaticResource SalesOrderStateTextConverter}}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <ui:Button Appearance="Primary" 
                               Command="{Binding CloseDocumentCommand}"  
                               Content="关闭页签" />
                </StackPanel>
            </Grid>
        </Grid>
        <!--内容-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" MinHeight="60"/>
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--单头-->
            <Border Grid.Row="0"
                    Padding="8"
                    BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsEnabled="{Binding IsEditable}">
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>-->
                    <TextBlock Grid.Column="0" Text="客户代码:" VerticalAlignment="Center" />
                    <controls:LookupTextBox Grid.Column="2"
                                            Placeholder="客户代码或名称"
                                            Text="{Binding Header.CustomerCode, Mode=OneWay}"
                                            FontSize="14"
                                            ItemsSource="{Binding CustomerCandidates}"
                                            SelectedItem="{Binding SelectedCustomerCandidate, Mode=OneWayToSource}"
                                            DisplayMemberPath="CustomerCode"
                                            FilterMemberPaths="CustomerCode,CustomerName"
                                            ItemTemplate="{StaticResource SalesOrderCustomerLookupTemplate}"
                                            SearchMode="Remote"
                                            SearchCommand="{Binding SearchCustomersCommand}"
                                            SelectionCommittedCommand="{Binding CommitCustomerCommand}"
                                            IsBusy="{Binding IsCustomerLookupBusy}" />

                    <TextBlock Grid.Column="4" Text="订单号:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="6" Text="{Binding Header.OrderNo}" IsReadOnly="True" ToolTip="新订单保存时由服务端生成" />

                    <TextBlock Grid.Column="8" Text="订单日期:" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="10"  SelectedDateFormat="Short" SelectedDate="{Binding Header.OrderDate}" />

                    <TextBlock Grid.Row="0" Grid.Column="12" Text="订单交期:" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="0" Grid.Column="14" 
                            ToolTip="订单交期"
                            SelectedDateFormat="Short" SelectedDate="{Binding Header.DeliveryDate}" />

                    <TextBlock Grid.Row="0" Grid.Column="16" Text="回复日期:" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="0" Grid.Column="18"   
                            ToolTip="回复日期"
                            SelectedDateFormat="Short" SelectedDate="{Binding Header.ReplyDate}" />

                    <TextBlock Grid.Row="0" Grid.Column="20" Text="币种:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="22"
                             ItemsSource="{Binding CurrencyOptions}"
                             ItemTemplate="{StaticResource SalesOrderCurrencyOptionTemplate}"
                             Text="{Binding Header.Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextSearch.TextPath="CurrencyCode" />

                    <TextBlock Grid.Row="0" Grid.Column="24" Text="汇率:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="26" 
                            Text="{Binding Header.ExchangeRate, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="0" Grid.Column="28" Text="付款方式:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="30"
                             ItemsSource="{Binding PaymentMethodOptions}"
                             ItemTemplate="{StaticResource SalesOrderDictionaryOptionTemplate}"
                             Text="{Binding Header.PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextSearch.TextPath="DataNameEn" />

                    <TextBlock Grid.Row="0" Grid.Column="32" Text="贸易术语:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="34"
                             ItemsSource="{Binding IncotermOptions}"
                             ItemTemplate="{StaticResource SalesOrderDictionaryOptionTemplate}"
                             Text="{Binding Header.Incoterm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextSearch.TextPath="DataNameEn" />

                </Grid>
            </Border>
            
            <Border Grid.Row="2"
                    Padding="8"
                    BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsEnabled="{Binding IsEditable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ship-To"/>

                        <ui:TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    PlaceholderText="客户联系人..."
                                    Text="{Binding Header.ShipToName, UpdateSourceTrigger=PropertyChanged}" />
                        
                        <ui:TextBox Grid.Row="4" Grid.ColumnSpan="3" 
                                    PlaceholderText="客户地址..."
                                 Text="{Binding Header.ShipToAddress, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="6" Text="Phone:" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="6" Grid.Column="2"
                                    Text="{Binding Header.ShipToPhone, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="联系方式:"/>

                        <TextBlock Grid.Row="8" Text="Terms:" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="8" Grid.Column="2" 
                                    Text="{Binding Header.IncotermSortRemark,UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="IncotermSortRemark:"
                                    TextAlignment="Left" TextWrapping="Wrap"/>


                        <TextBlock Grid.Column="4" Text="PO No" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Column="6" Grid.ColumnSpan="8"
                                    PlaceholderText="客户Po号"
                                Text="{Binding Header.CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="InvoiceNo" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="8" 
                                    PlaceholderText="发票号"
                                    Text="{Binding Header.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                        
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Date:" VerticalAlignment="Center" />
                        <DatePicker Grid.Row="4" Grid.Column="6" Style="{StaticResource SwiftExportDatePicker}"
                                    ToolTip="发票日期"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="8" Text="UpdateDate:" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="4" Grid.Column="10" SelectedDateFormat="Short"
                                ToolTip="发票更新日期"/>
                        
                        <TextBlock Grid.Row="6" Grid.Column="4" Text="ETD:" VerticalAlignment="Center" />
                        <DatePicker SelectedDateFormat="Short" Grid.Row="6" Grid.Column="6"
                                    ToolTip="ETD"/>
                    
                        <TextBlock Grid.Row="6" Grid.Column="8" Text="ETA:" VerticalAlignment="Center" />
                        <DatePicker SelectedDateFormat="Short" Grid.Row="6" Grid.Column="10" Grid.ColumnSpan="6"
                                    ToolTip="ETA"/>

                        <TextBlock Grid.Row="8" Grid.Column="4" Text="Shipped By:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="8" Grid.Column="6" Grid.ColumnSpan="6"
                                  ItemsSource="{Binding ShippedByOptions}"
                                  ItemTemplate="{StaticResource SalesOrderDictionaryOptionTemplate}"
                                  Text="{Binding Header.ShippedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextSearch.TextPath="DataNameEn" />



                        

                </Grid>
            </Border>

            <GridSplitter Grid.Row="3"/>

            <!--DataGrid操作-->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,4">
                <ui:Button Margin="0,0,4,0" Appearance="Primary" 
                           Command="{Binding AddStandardLineCommand}"  Content="添加产品" />
                <ui:Button Margin="0,0,4,0"  Command="{Binding AddNonStandardLineCommand}"  Content="添加非标件" />
                <ui:Button Margin="0,0,4,0"  Command="{Binding DeleteSelectedLineCommand}"  Content="删除行" />
                <ui:Button Margin="0,0,4,0" Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=OrderLinesGrid}" Content="撤销" ToolTip="Ctrl+Z" />
                <ui:ToggleSwitch Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
            </StackPanel>

            <DataGrid x:Name="OrderLinesGrid" Grid.Row="6"                  
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{StaticResource SwiftExportDefaltFontSize}"
                      ItemsSource="{Binding Lines.Items}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="{Binding IsReadOnly}"
                      SelectionMode="Extended"
                      SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridCore:GridVirtualization.IsEnabled="True"
                      gridCore:GridRowHeader.ShowRowNumber="True"
                      gridOperations:GridOperations.IsEnabled="True"
                      gridOperations:DataGridLineReorder.IsEnabled="True"
                      gridOperations:DataGridLineReorder.MoveUpCommand="{Binding MoveLineUpCommand}"
                      gridOperations:DataGridLineReorder.MoveDownCommand="{Binding MoveLineDownCommand}"
                      gridOperations:DataGridLineReorder.ShowWhenReadOnly="False"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False" gridColumns:GridColumn.Key="image">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56" Height="56" Margin="2"
                                                    Style="{StaticResource SwiftExportCachedImage}"
                                                    Stretch="Uniform"
                                                    SourcePath="{Binding MainImage}" 
                                                    DecodePixelWidth="72"  />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="类型" Width="58" IsReadOnly="True"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        Binding="{Binding LineTypeText}" 
                                        gridColumns:GridColumn.Key="line-type" />

                    <DataGridTemplateColumn Header="SKU" Width="155" SortMemberPath="Sku" gridColumns:GridColumn.Key="sku">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Sku}" 
                                           Style="{StaticResource SwiftExportDataGridTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <salesComponents:SalesProductLookupTextBox
                                        x:Name="ProductLookup"
                                        Text="{Binding Sku, Mode=OneWay}"
                                        FontSize="10"
                                        ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedProduct="{Binding DataContext.SelectedProductCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                        SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectionCommittedCommandParameter="{Binding}"
                                        SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectionClearedCommandParameter="{Binding}"
                                        IsBusy="{Binding DataContext.IsProductLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                    <TextBlock x:Name="NonStandardSku" Text="{Binding Sku}" FontSize="6" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNonStandard}" Value="True">
                                        <Setter TargetName="ProductLookup" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NonStandardSku" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="客户型号" Width="125"
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="customer-sku" 
                                        gridColumns:GridColumn.FieldPath="CustomerSku" />

                    <DataGridTextColumn Header="英文描述" Width="210" 
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="description" 
                                        gridColumns:GridColumn.FieldPath="DescriptionEn" />

                    <DataGridTextColumn Header="英文颜色" Width="105" 
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="color" gridColumns:GridColumn.FieldPath="ColorNameEn" />

                    <DataGridTextColumn Header="英文配置" Width="150" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                        Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="features" 
                                        gridColumns:GridColumn.FieldPath="FeaturesEn" />

                    <DataGridTextColumn Header="数量" Width="78" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="qty" 
                                        gridColumns:GridColumn.FieldPath="QtyText" />

                    <DataGridTextColumn Header="USD单价" Width="88" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding UsdPriceText, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="usd-price" 
                                        gridColumns:GridColumn.FieldPath="UsdPriceText" />

                    <DataGridTextColumn Header="CNY单价" Width="88" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding CnyPriceText, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="cny-price" 
                                        gridColumns:GridColumn.FieldPath="CnyPriceText" />

                    <DataGridTextColumn Header="USD金额" Width="92" IsReadOnly="True" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding UsdAmount, StringFormat=N2}" 
                                        gridColumns:GridColumn.Key="usd-amount" />

                    <DataGridTextColumn Header="CNY金额" Width="92" IsReadOnly="True" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding CnyAmount, StringFormat=N2}" 
                                        gridColumns:GridColumn.Key="cny-amount" />

                    <DataGridTemplateColumn Header="预计交期" Width="112"
                                            SortMemberPath="ExpectedDeliveryDate"
                                            gridColumns:GridColumn.Key="expected-date"
                                            gridColumns:GridColumn.FieldPath="ExpectedDeliveryDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExpectedDeliveryDate, StringFormat=yyyy-MM-dd}"
                                           Style="{StaticResource SwiftExportDataGridDateTextBlock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource SwiftExportDataGridDatePicker}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="备注" Width="*" 
                                        ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                        Binding="{Binding SubNote, UpdateSourceTrigger=PropertyChanged}"
                                        gridColumns:GridColumn.Key="note" 
                                        gridColumns:GridColumn.FieldPath="SubNote" />
                </DataGrid.Columns>
            </DataGrid>

            <!--汇总-->
            <DockPanel Grid.Row="8">
                <Grid Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="820"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock  Grid.Column="0" Text="备注:" VerticalAlignment="Top" />
                    <ui:TextBox Grid.Column="2" 
                                FontSize="10" 
                                Text="{Binding Header.Remark, UpdateSourceTrigger=PropertyChanged}" 
                                TextWrapping="Wrap" 
                                AcceptsReturn="True" />
                </Grid>
                <Grid DockPanel.Dock="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="数量：" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="48,0,0,0" Text="{Binding TotalQty, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="USD：" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Margin="42,0,0,0" Text="{Binding TotalUsdAmount, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="CNY：" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Margin="42,0,0,0" Text="{Binding TotalCnyAmount, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
                
            </DockPanel>
        </Grid>
        <!--状态-->
        <ui:InfoBar Grid.Row="4"
                        Title="请检查销售订单"
                        Message="{Binding ValidationSummary}"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{Binding HasValidationError}" />
    </Grid>
</UserControl>
