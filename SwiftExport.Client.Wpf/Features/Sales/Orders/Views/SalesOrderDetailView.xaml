<UserControl x:Class="SwiftExportClient.Features.Sales.Orders.Views.SalesOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:salesComponents="clr-namespace:SwiftExportClient.Features.Sales.Orders.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d"
             d:Width="1500"
             d:Height="900">
    <UserControl.Resources>
        <salesComponents:SalesOrderStateTextConverter x:Key="SalesOrderStateTextConverter" />
        <Style x:Key="SalesOrderDetailToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <DataTemplate x:Key="SalesOrderProductLookupTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Sku}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding CustomerSku}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
                <TextBlock Grid.Column="2" Text="{Binding DescriptionEn}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SalesOrderCustomerLookupTemplate">
            <StackPanel Margin="4" Orientation="Horizontal">
                <TextBlock Text="{Binding CustomerCode}" FontWeight="SemiBold" Width="100" />
                <TextBlock Text="{Binding CustomerName}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Padding="8,4">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" /><TextBlock Margin="6,0,0,0" Text="保存" /></StackPanel>
                </Button>
                <Button Command="{Binding ConfirmCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="确认" />
                <Button Command="{Binding CancelConfirmationCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="取消确认" />
                <Separator Margin="4,0" />
                <Button Command="{Binding AddStandardLineCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="添加产品" />
                <Button Command="{Binding AddNonStandardLineCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="添加非标件" />
                <Button Command="{Binding DeleteSelectedLineCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="删除行" />
                <Button Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=OrderLinesGrid}"
                        Style="{StaticResource SalesOrderDetailToolbarButton}" Content="撤销" ToolTip="Ctrl+Z" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource SwiftExportBrush.SurfaceMuted}" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="确认：" />
                        <TextBlock Text="{Binding Header.ConfirmationStatus}" FontWeight="SemiBold" />
                        <TextBlock Margin="12,0,0,0" Text="单据：" />
                        <TextBlock Text="{Binding Header.DocumentStatus, Converter={StaticResource SalesOrderStateTextConverter}}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button Command="{Binding CloseDocumentCommand}" Style="{StaticResource SalesOrderDetailToolbarButton}" Content="关闭页签" />
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="2"
                    Title="请检查销售订单"
                    Message="{Binding ValidationSummary}"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{Binding HasValidationError}" />

        <Border Grid.Row="4"
                Padding="8"
                BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                BorderThickness="1"
                CornerRadius="4"
                IsEnabled="{Binding IsEditable}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" /><ColumnDefinition Width="180" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="140" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="140" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" /><RowDefinition Height="4" />
                    <RowDefinition Height="32" /><RowDefinition Height="4" />
                    <RowDefinition Height="32" /><RowDefinition Height="4" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="客户" VerticalAlignment="Center" />
                <controls:LookupTextBox Grid.Column="1"
                                        Placeholder="客户代码或名称"
                                        Text="{Binding Header.CustomerCode, Mode=OneWay}"
                                        ItemsSource="{Binding CustomerCandidates}"
                                        SelectedItem="{Binding SelectedCustomerCandidate, Mode=OneWayToSource}"
                                        DisplayMemberPath="CustomerCode"
                                        FilterMemberPaths="CustomerCode,CustomerName"
                                        ItemTemplate="{StaticResource SalesOrderCustomerLookupTemplate}"
                                        SearchMode="Remote"
                                        SearchCommand="{Binding SearchCustomersCommand}"
                                        SelectionCommittedCommand="{Binding CommitCustomerCommand}"
                                        IsBusy="{Binding IsCustomerLookupBusy}" />
                <TextBlock Grid.Column="3" Text="订单号" VerticalAlignment="Center" />
                <TextBox Grid.Column="4" Text="{Binding Header.OrderNo}" IsReadOnly="True" ToolTip="新订单保存时由服务端生成" />
                <TextBlock Grid.Column="6" Text="订单日期" VerticalAlignment="Center" />
                <DatePicker Grid.Column="7" SelectedDate="{Binding Header.OrderDate}" />
                <TextBlock Grid.Column="9" Text="客户PO" VerticalAlignment="Center" />
                <TextBox Grid.Column="10" Text="{Binding Header.CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="发票号" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Header.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="订单交期" VerticalAlignment="Center" />
                <DatePicker Grid.Row="2" Grid.Column="4" SelectedDate="{Binding Header.DeliveryDate}" />
                <TextBlock Grid.Row="2" Grid.Column="6" Text="回复日期" VerticalAlignment="Center" />
                <DatePicker Grid.Row="2" Grid.Column="7" SelectedDate="{Binding Header.ReplyDate}" />
                <TextBlock Grid.Row="2" Grid.Column="9" Text="运输方式" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="10" Text="{Binding Header.ShippedBy, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="币种" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Header.Currency, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="3" Text="汇率" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding Header.ExchangeRate, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Row="4" Grid.Column="6" Text="付款方式" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="7" Text="{Binding Header.PaymentMethod, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="9" Text="贸易术语" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="10" Text="{Binding Header.Incoterm, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ship-To" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Header.ShipToName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="6" Grid.Column="3" Text="地址" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="4" Text="{Binding Header.ShipToAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock Grid.Row="6" Grid.Column="9" Text="备注" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="6" Grid.Column="10" Grid.ColumnSpan="2" Text="{Binding Header.Remark, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" />
            </Grid>
        </Border>

        <DataGrid x:Name="OrderLinesGrid"
                  Grid.Row="6"
                  RowHeight="45"
                  FontSize="12"
                  ItemsSource="{Binding Lines.Items}"
                  Style="{StaticResource SwiftExportDataGrid}"
                  RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="{Binding IsReadOnly}"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  gridCore:EnterpriseGrid.IsEnabled="True"
                  gridCore:GridVirtualization.IsEnabled="True"
                  gridCore:GridRowHeader.ShowRowNumber="True"
                  gridOperations:GridOperations.IsEnabled="True"
                  gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                  gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                  gridValidation:GridValidation.IsEnabled="True">
            <DataGrid.Columns>
                
                <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="40" Height="40" Margin="0"
                                                Style="{StaticResource SwiftExportCachedImage}"
                                                Stretch="Uniform"
                                                SourcePath="{Binding MainImage}" 
                                                DecodePixelWidth="72"  />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="类型" Width="58" IsReadOnly="True"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    Binding="{Binding LineTypeText}" 
                                    gridColumns:GridColumn.Key="line-type" />
                
                <DataGridTemplateColumn Header="SKU" Width="155" SortMemberPath="Sku" gridColumns:GridColumn.Key="sku">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                        <Grid>
                            <controls:LookupTextBox x:Name="ProductLookup"
                                                    Text="{Binding Sku, Mode=OneWay}"
                                                    ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectedItem="{Binding DataContext.SelectedProductCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                                    DisplayMemberPath="Sku"
                                                    FilterMemberPaths="Sku,CustomerSku,DescriptionEn,LinkSku"
                                                    ItemTemplate="{StaticResource SalesOrderProductLookupTemplate}"
                                                    SearchMode="Remote"
                                                    SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionCommittedCommandParameter="{Binding}"
                                                    SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    SelectionClearedCommandParameter="{Binding}"
                                                    IsBusy="{Binding DataContext.IsProductLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <TextBlock x:Name="NonStandardSku" Text="{Binding Sku}" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNonStandard}" Value="True">
                                <Setter TargetName="ProductLookup" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NonStandardSku" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="客户货号" Width="125"
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="customer-sku" gridColumns:GridColumn.FieldPath="CustomerSku" />
                <DataGridTextColumn Header="描述" Width="210" 
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="description" gridColumns:GridColumn.FieldPath="DescriptionEn" />
                
                <DataGridTextColumn Header="颜色" Width="105" 
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                    Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="color" gridColumns:GridColumn.FieldPath="ColorNameEn" />
                
                <DataGridTextColumn Header="配置" Width="150" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                    Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="features" gridColumns:GridColumn.FieldPath="FeaturesEn" />
                
                <DataGridTextColumn Header="数量" Width="78" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                    Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="qty" 
                                    gridColumns:GridColumn.FieldPath="QtyText" />
                
                <DataGridTextColumn Header="USD单价" Width="88" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                    Binding="{Binding UsdPriceText, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="usd-price" 
                                    gridColumns:GridColumn.FieldPath="UsdPriceText" />
                
                <DataGridTextColumn Header="CNY单价" Width="88" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                    Binding="{Binding CnyPriceText, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="cny-price" 
                                    gridColumns:GridColumn.FieldPath="CnyPriceText" />
                
                <DataGridTextColumn Header="USD金额" Width="92" IsReadOnly="True" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding UsdAmount, StringFormat=N2}" 
                                    gridColumns:GridColumn.Key="usd-amount" />
                
                <DataGridTextColumn Header="CNY金额" Width="92" IsReadOnly="True" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Binding="{Binding CnyAmount, StringFormat=N2}" 
                                    gridColumns:GridColumn.Key="cny-amount" />
                
                <DataGridTemplateColumn Header="预计交期" Width="112"
                                        SortMemberPath="ExpectedDeliveryDate"
                                        gridColumns:GridColumn.Key="expected-date"
                                        gridColumns:GridColumn.FieldPath="ExpectedDeliveryDateText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ExpectedDeliveryDateDisplayText}"
                                       Style="{StaticResource SwiftExportDataGridDateTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:SoftInputDatePicker RawText="{Binding ExpectedDeliveryDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource SwiftExportDataGridDatePicker}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="备注" Width="*" 
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                    Binding="{Binding SubNote, UpdateSourceTrigger=PropertyChanged}"
                                    gridColumns:GridColumn.Key="note" 
                                    gridColumns:GridColumn.FieldPath="SubNote" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="数量：" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Margin="48,0,0,0" Text="{Binding TotalQty, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="USD：" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Margin="42,0,0,0" Text="{Binding TotalUsdAmount, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="CNY：" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Margin="42,0,0,0" Text="{Binding TotalCnyAmount, StringFormat=N2}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
