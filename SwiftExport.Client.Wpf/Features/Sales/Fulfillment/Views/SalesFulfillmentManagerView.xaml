<UserControl x:Class="SwiftExportClient.Features.Sales.Fulfillment.Views.SalesFulfillmentManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls">
    <Grid Margin="12,8" RowDefinitions="Auto,8,*,4,Auto">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="销售履约查询" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="已发量采用 SO-003 正式客户出库兼容口径" Style="{StaticResource CaptionTextBlock}" Foreground="Gray"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="履约详情" Command="{Binding OpenDetailCommand}" Margin="4,0,0,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="4,0,0,0"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,*">
            <Grid ColumnDefinitions="2*,8,160,8,160,8,150,8,Auto,4,Auto">
                <ui:TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="订单号、客户名称或代码"/>
                <ui:TextBox Grid.Column="2" Text="{Binding OrderNo}" PlaceholderText="销售订单号"/>
                <ui:TextBox Grid.Column="4" Text="{Binding CustomerCode}" PlaceholderText="客户代码"/>
                <controls:DropDownCheckBox Grid.Column="6" Placeholder="履约状态"
                                           ItemsSource="{Binding FulfillmentStatusOptions}" DisplayMemberPath="DisplayText"
                                           SelectedItems="{Binding SelectedFulfillmentStatuses,Mode=OneWay}"/>
                <Button Grid.Column="8" Content="查询" Command="{Binding SearchCommand}"/>
                <Button Grid.Column="10" Content="清空筛选" Command="{Binding ClearFiltersCommand}"/>
            </Grid>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}"
                      RowHeight="{StaticResource DataGridRowHeightSmall}" FontSize="{StaticResource SwiftExportDefaltFontSize}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDetailCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="销售订单" Binding="{Binding OrderNo}" Width="145"/>
                    <DataGridTextColumn Header="客户代码" Binding="{Binding CustomerCode}" Width="110"/>
                    <DataGridTextColumn Header="客户名称" Binding="{Binding CustomerName}" Width="180"/>
                    <DataGridTextColumn Header="订单日期" Binding="{Binding OrderDate,StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="交期" Binding="{Binding DeliveryDate,StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="行数" Binding="{Binding LineCount}" Width="60"/>
                    <DataGridTextColumn Header="需求数量" Binding="{Binding DemandQty,StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="正式已发" Binding="{Binding ShippedQty,StringFormat=N2,TargetNullValue=未知}" Width="95"/>
                    <DataGridTextColumn Header="未发" Binding="{Binding UnshippedQty,StringFormat=N2,TargetNullValue=未知}" Width="95"/>
                    <DataGridTextColumn Header="异常数" Binding="{Binding AnomalyCount}" Width="75"/>
                    <DataGridTextColumn Header="来源需求数" Binding="{Binding SourceDemandCount}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,12,Auto">
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}"/>
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}"/>
            <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}"
                                    PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}"/>
        </Grid>
    </Grid>
</UserControl>
