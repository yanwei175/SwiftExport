<UserControl x:Class="SwiftExportClient.Features.Sales.Fulfillment.Views.SalesFulfillmentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12,8" RowDefinitions="Auto,Auto,*">


        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button Content="刷新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Appearance="Primary" MinWidth="70"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DocumentTitle}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="   发票号：" Style="{StaticResource SubtitleTextBlock}"/>
                    <TextBlock Text="{Binding Detail.InvoiceNo}" Style="{StaticResource SubtitleTextBlock}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="客户：" />
                    <TextBlock Text="{Binding Detail.CustomerName}" />
                    <TextBlock Text="   单据：" />
                    <TextBlock Text="{Binding Detail.DocumentStatus}" />
                    <TextBlock Text="   确认：" />
                    <TextBlock Text="{Binding Detail.ConfirmationStatus}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="DarkOrange"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="2" ColumnDefinitions="2*,8,3*">

            <DataGrid Grid.Column="0" ItemsSource="{Binding Detail.Lines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="30" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                    <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku}" Width="110" />
                    <DataGridTextColumn Header="订购" Binding="{Binding OrderedQty,StringFormat=N0}" Width="60" />
                    <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="55" />
                    <DataGridTextColumn Header="已交" Binding="{Binding ShippedQty,StringFormat=N0,  TargetNullValue=未知}" Width="60" />
                    <DataGridTextColumn Header="未交" Binding="{Binding UnshippedQty,StringFormat=N0, TargetNullValue=未知}" Width="60" />
                    <DataGridTextColumn Header="有效交期" Binding="{Binding EffectiveDueDate, StringFormat=yyyy-MM-dd, TargetNullValue=无交期}" Width="100" />
                    <DataGridTextColumn Header="来源" Binding="{Binding SourceState}" Width="60" />
                    <DataGridTextColumn Header="需核实" Binding="{Binding ReviewReason}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent"/>


            <Grid Grid.Column="2" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5*" MinHeight="230"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="5*" MinHeight="230"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Margin="0,0,0,8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel>

                        <TextBlock Text="销售行追踪" FontSize="16" FontWeight="SemiBold" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="成品需求：" />
                            <TextBlock Text="{Binding SelectedLine.SourceState}" FontWeight="SemiBold" />

                            <TextBlock Text="   成品需求单位：" />
                            <TextBlock Text="{Binding SelectedLine.GrossDemandUnitSnapshot}" />

                            <TextBlock Text="   成品需求行Uid：" />
                            <TextBlock Text="{Binding SelectedLine.GrossDemandId, TargetNullValue=未知}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="   成品需求数量：" />
                            <TextBlock Text="{Binding SelectedLine.GrossDemandQty,StringFormat=N0, TargetNullValue=未知}" />

                            <TextBlock Text="    未出数量：" />
                            <TextBlock Text="{Binding SelectedLine.UnshippedQty,StringFormat=N0, TargetNullValue=未知}" />

                            <TextBlock Text="   关闭后可继续交付：" />
                            <TextBlock Text="{Binding SelectedLine.AllowedFurtherDeliveryQty,StringFormat=N0, TargetNullValue=未知}" />

                            <TextBlock Text="   单位：" />
                            <TextBlock Text="{Binding SelectedLine.UnitSnapshot}" />

                        </StackPanel>

                        <TextBlock Text="{Binding SelectedLine.ReviewReason}" Foreground="DarkOrange" TextWrapping="Wrap" />


                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="1"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*">

                        <StackPanel VerticalAlignment="Stretch">
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="打开采购详情" DockPanel.Dock="Right" Command="{Binding OpenPurchaseCommand}" />
                                <TextBlock Text="有效采购关联与采购行货好数量" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="货好属于整条采购行；共享采购行不向销售行分摊。" Foreground="Gray" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedLine.PurchaseState}" Foreground="Gray" />
                            <TextBlock Text="{Binding SelectedLine.PurchaseReviewReason}" Foreground="DarkOrange" />

                        </StackPanel>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding SelectedLine.Purchases}" 
                                  SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource UserCardStrokeColorDefaultBrush}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="采购单" Binding="{Binding PurchaseOrderNo}" Width="105" />

                                <DataGridTextColumn Header="行" Binding="{Binding PurchaseLineNumber}" Width="40" />

                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />

                                <DataGridTextColumn Header="关联贡献" Binding="{Binding LinkedQty,StringFormat=N0}" Width="70" />

                                <DataGridTextColumn Header="需核实" Binding="{Binding ReviewReason}" Width="100" />

                                <DataGridTextColumn Header="采购数量" Binding="{Binding PurchaseLineQty,StringFormat=N0}" Width="65" />

                                <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="50" />

                                <DataGridTextColumn Header="采购确认" Binding="{Binding ConfirmationStatus}" Width="75" />

                                <DataGridTextColumn Header="采购状态" Binding="{Binding LifecycleStatus}" Width="75" />

                                <DataGridTextColumn Header="备好数量" Binding="{Binding PurchaseLineReadyQty,StringFormat=N0, TargetNullValue=未反馈}" Width="95" />

                                <DataGridCheckBoxColumn Header="共享行" Binding="{Binding IsSharedPurchaseLine}" Width="65"
                                                    ElementStyle="{StaticResource SwiftExportDataGridCheckBoxElementStyle}"/>

                                <DataGridTextColumn Header="预计货好时间" Binding="{Binding ExpectedReadyDate, StringFormat=yyyy-MM-dd}" Width="95" />

                                <DataGridTextColumn Header="反馈时间" Binding="{Binding SupplierReportedDate, StringFormat=yyyy-MM-dd}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Row="2"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent"/>

                <ui:Card Grid.Row="3" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid RowDefinitions="Auto,*">

                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="打开装箱详情 / Trace" DockPanel.Dock="Right" Command="{Binding OpenPackingListCommand}" />
                                <TextBlock Text="装箱交付历史" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SelectedLine.Deliveries}" 
                                  SelectedItem="{Binding SelectedDelivery, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource UserCardStrokeColorDefaultBrush}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="箱单号" Binding="{Binding PackingListNo}" Width="110" />

                                <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="40" />

                                <DataGridTextColumn Header="数量" Binding="{Binding Qty,StringFormat=N0}" Width="70" />

                                <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="55" />

                                <DataGridCheckBoxColumn Header="计入已交" Binding="{Binding CountsTowardDelivery}" Width="75"
                                                        ElementStyle="{StaticResource SwiftExportDataGridCheckBoxElementStyle}"/>

                                <DataGridTextColumn Header="过账时间" Binding="{Binding PostedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="125" />

                                <DataGridTextColumn Header="反向时间" Binding="{Binding ReversedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
