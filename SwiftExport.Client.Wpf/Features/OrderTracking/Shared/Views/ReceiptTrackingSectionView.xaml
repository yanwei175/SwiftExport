<UserControl
    x:Class="SwiftExportClient.Features.OrderTracking.Shared.Views.ReceiptTrackingSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.Client.Wpf;component/Features/OrderTracking/Shared/TrackingSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,8"
            Text="关联采购行整行收货进度与记录；不是当前成品需求或物料的实收份额。"
            TextWrapping="Wrap" />
        <ContentControl
            Grid.Row="1"
            Content="{Binding}"
            ContentTemplate="{StaticResource SectionFeedback}" />
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,4"
            FontWeight="SemiBold"
            Text="采购整行进度 · 按采购行去重，不跨行或单位汇总" />
        <DataGrid
            x:Name="ReceiptProgressGrid"
            Grid.Row="3"
            AutomationProperties.Name="采购整行收货进度"
            IsEnabled="{Binding CanRead}"
            ItemsSource="{Binding Data.PurchaseLines, NotifyOnTargetUpdated=True}"
            Style="{StaticResource TrackingSectionGrid}">
            <i:Interaction.Behaviors>
                <behaviors:DataGridColumnVisibilityBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="ApplicationCommands.Copy"
                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="复制" />
                    <MenuItem
                        Command="{x:Static commands:DataGridFilterCommands.Clear}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="清除列筛选" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PurchaseOrderNo}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="采购单号" />
                <DataGridTextColumn
                    Width="80"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PurchaseLineNumber}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="行号" />
                <DataGridTextColumn
                    Width="130"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Sku}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="型号" />
                <DataGridTextColumn
                    Width="120"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PurchaseLineQty, StringFormat=N2, TargetNullValue=待核实}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="整行数量" />
                <DataGridTextColumn
                    Width="120"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding ReceivedQty, StringFormat=N2, TargetNullValue=待核实}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="整行已收" />
                <DataGridTextColumn
                    Width="120"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding RemainingQty, StringFormat=N2, TargetNullValue=待核实}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="整行未收" />
                <DataGridTextColumn
                    Width="80"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Unit}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="单位" />
                <DataGridTextColumn
                    Width="130"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding IsSharedPurchaseLine, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Shared}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="共享状态" />
                <DataGridTextColumn
                    Width="230"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding ReviewReason}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="待核实原因" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock
            Grid.Row="4"
            Margin="0,8,0,4"
            FontWeight="SemiBold"
            Text="关联采购行收货记录 · 一行一条入库行证据" />
        <DataGrid
            x:Name="ReceiptsGrid"
            Grid.Row="5"
            AutomationProperties.Name="关联采购行收货记录"
            IsEnabled="{Binding CanRead}"
            ItemsSource="{Binding Data.Items, NotifyOnTargetUpdated=True}"
            Style="{StaticResource TrackingSectionGrid}">
            <i:Interaction.Behaviors>
                <behaviors:DataGridColumnVisibilityBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="ApplicationCommands.Copy"
                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="复制" />
                    <MenuItem
                        Command="{x:Static commands:DataGridFilterCommands.Clear}"
                        CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="清除列筛选" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="130"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding InboundDocumentNo}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="入库单号" />
                <DataGridTextColumn
                    Width="80"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding LineNumber}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="行号" />
                <DataGridTextColumn
                    Width="125"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PurchaseOrderNo}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="采购单号" />
                <DataGridTextColumn
                    Width="105"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PurchaseLineNumber}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="采购行号" />
                <DataGridTextColumn
                    Width="100"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Sku}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="型号" />
                <DataGridTextColumn
                    Width="125"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Qty, StringFormat=N2}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="收货行数量" />
                <DataGridTextColumn
                    Width="80"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Unit}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="单位" />
                <DataGridTextColumn
                    Width="110"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=ReceiptPosting}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="过账状态" />
                <DataGridTextColumn
                    Width="110"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}"
                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                    Header="收货日期" />
                <DataGridTextColumn
                    Width="170"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding CountsTowardReceipt, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Receipt}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="计入说明" />
                <DataGridTextColumn
                    Width="220"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding ReviewReason}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="待核实原因" />
                <DataGridTextColumn
                    Width="150"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding PostedDate, StringFormat=yyyy-MM-dd HH:mm}"
                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                    Header="过账时间"
                    Visibility="Collapsed" />
                <DataGridTextColumn
                    Width="150"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding ReversedDate, StringFormat=yyyy-MM-dd HH:mm}"
                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                    Header="反向时间"
                    Visibility="Collapsed" />
                <DataGridTextColumn
                    Width="120"
                    dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                    Binding="{Binding IsSharedPurchaseLine, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Shared}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="采购行共享"
                    Visibility="Collapsed" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
