<UserControl x:Class="SwiftExportClient.Features.OrderTracking.Shared.Views.ReceiptTrackingSectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
 xmlns:dgx="urn:tom-englert.de/DataGridExtensions" xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SwiftExport.Client.Wpf;component/Features/OrderTracking/Shared/TrackingSectionResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <TextBlock Text="关联采购行整行收货进度与记录；不是当前成品需求或物料的实收份额。" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource SectionFeedback}"/>
  <TextBlock Grid.Row="2" Text="采购整行进度 · 按采购行去重，不跨行或单位汇总" FontWeight="SemiBold" Margin="0,0,0,4"/>
  <DataGrid x:Name="ReceiptProgressGrid" Grid.Row="3" ItemsSource="{Binding Data.PurchaseLines, NotifyOnTargetUpdated=True}" IsEnabled="{Binding CanRead}" Style="{StaticResource TrackingSectionGrid}" AutomationProperties.Name="采购整行收货进度">
   <i:Interaction.Behaviors><behaviors:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
   <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="清除列筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
   <DataGrid.Columns>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购单号" Width="140" Binding="{Binding PurchaseOrderNo}"/>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="行号" Width="80" Binding="{Binding PurchaseLineNumber}"/>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="型号" Width="130" Binding="{Binding Sku}"/>
    <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="整行数量" Width="120" Binding="{Binding PurchaseLineQty, StringFormat=N2, TargetNullValue=待核实}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
    <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="整行已收" Width="120" Binding="{Binding ReceivedQty, StringFormat=N2, TargetNullValue=待核实}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
    <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="整行未收" Width="120" Binding="{Binding RemainingQty, StringFormat=N2, TargetNullValue=待核实}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="单位" Width="80" Binding="{Binding Unit}"/>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="共享状态" Width="130" Binding="{Binding IsSharedPurchaseLine, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Shared}"/>
    <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="待核实原因" Width="230" Binding="{Binding ReviewReason}"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="关联采购行收货记录 · 一行一条入库行证据" FontWeight="SemiBold" Margin="0,8,0,4"/>
  <DataGrid x:Name="ReceiptsGrid" Grid.Row="5" ItemsSource="{Binding Data.Items, NotifyOnTargetUpdated=True}" IsEnabled="{Binding CanRead}" Style="{StaticResource TrackingSectionGrid}" AutomationProperties.Name="关联采购行收货记录">
   <i:Interaction.Behaviors><behaviors:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
   <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="清除列筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
   <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="入库单号" Binding="{Binding InboundDocumentNo}" Width="130"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="行号" Binding="{Binding LineNumber}" Width="80"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购单号" Binding="{Binding PurchaseOrderNo}" Width="125"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购行号" Binding="{Binding PurchaseLineNumber}" Width="105"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="型号" Binding="{Binding Sku}" Width="100"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="收货行数量" Binding="{Binding Qty, StringFormat=N2}" Width="125"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="单位" Binding="{Binding Unit}" Width="80"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="过账状态" Binding="{Binding Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=ReceiptPosting}" Width="110"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="收货日期" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}" Width="110"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="计入说明" Binding="{Binding CountsTowardReceipt, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Receipt}" Width="170"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="待核实原因" Binding="{Binding ReviewReason}" Width="220"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="过账时间" Binding="{Binding PostedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150" Visibility="Collapsed"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="反向时间" Binding="{Binding ReversedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150" Visibility="Collapsed"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购行共享" Binding="{Binding IsSharedPurchaseLine, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Shared}" Width="120" Visibility="Collapsed"/></DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
