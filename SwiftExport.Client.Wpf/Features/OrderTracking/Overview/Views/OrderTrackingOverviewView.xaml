<UserControl x:Class="SwiftExportClient.Features.OrderTracking.Overview.Views.OrderTrackingOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls" xmlns:sections="clr-namespace:SwiftExportClient.Features.OrderTracking.DemandDetail.Models" xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter" xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands" xmlns:dgx="urn:tom-englert.de/DataGridExtensions" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
  <UserControl.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="OptionalMessage" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CompactExplanation" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton HorizontalAlignment="Left" Padding="4,0" Content="口径说明" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <ContentPresenter x:Name="Explanation" Visibility="Collapsed" Margin="4,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Explanation" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="FilterLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="210" />
      <RowDefinition Height="8" />
      <RowDefinition Height="3*" MinHeight="260" />
    </Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8" IsEnabled="{Binding CanView}">
      <TextBlock Text="跟踪总览" Style="{StaticResource SubtitleTextBlock}" Margin="0,0,16,0" VerticalAlignment="Center" />
      <TextBox x:Name="KeywordSearchBox" Width="300" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="来源单号、客户PO、发票号、产品编码、客户型号、中性型号" AutomationProperties.Name="统一关键词搜索">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Content="查询" Command="{Binding SearchCommand}" MinWidth="70" Margin="0,0,8,0" />
      <Button Content="刷新已应用查询" Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="保留输入；只刷新已查询条件和当前页。" />
      <Button Content="清空并查询" Click="OnClearFilters" />
    </WrapPanel>
    <WrapPanel Grid.Row="1" IsEnabled="{Binding CanView}">
      <TextBlock Text="来源" Style="{StaticResource FilterLabel}" />
      <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="DisplayText" SelectedValuePath="Value" SelectedValue="{Binding SelectedSourceType}" VerticalContentAlignment="Center" AutomationProperties.Name="来源类型" />
      <lookup:MultiSelectLookupButton x:Name="CustomerCodesSelector" Header="客户代码" MinWidth="130" Margin="0,0,8,8" ItemsSource="{Binding CustomerCodeOptions}" SelectedItems="{Binding SelectedCustomerCodes, Mode=OneWay}" AutomationProperties.Name="客户代码多选" />
      <lookup:MultiSelectLookupButton Header="生命周期" MinWidth="120" Margin="0,0,8,8" DisplayMemberPath="DisplayText" ItemsSource="{Binding LifecycleOptions}" SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" AutomationProperties.Name="成品需求生命周期多选" />
      <lookup:MultiSelectLookupButton x:Name="AttentionSelector" Header="关注事项（任一项）" ToolTip="所选关注事项满足任一项；再与其他条件共同匹配。" ItemsSource="{Binding AttentionOptions}" DisplayMemberPath="DisplayText" SelectedItems="{Binding SelectedAttentions, Mode=OneWay}" MinWidth="140" Margin="0,0,8,8" AutomationProperties.Name="关注事项多选" />
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="要求交期起" Style="{StaticResource FilterLabel}" />
        <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding RequiredDateFrom}" AutomationProperties.Name="要求交期开始" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="至" Style="{StaticResource FilterLabel}" />
        <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding RequiredDateTo}" AutomationProperties.Name="要求交期结束" />
      </StackPanel>
    </WrapPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding QueryStateText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding ValidationSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding CustomerLoadError}" TextWrapping="Wrap" />
      <Expander Header="口径说明" Style="{StaticResource CompactExplanation}">
        <TextBlock Text="关注事项满足任一项，再与其他条件共同匹配。来源摘要覆盖整个来源的活动需求；子表保留全部非删除成品需求，命中仅作标记。摘要与匹配各自读取当前事实，与来源查询并非同一快照。采购承接不等于采购确认；收货为关联采购整行事实，不代表本需求实收份额。" TextWrapping="Wrap" />
      </Expander>
    </StackPanel>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,4">
        <DockPanel>
          <TextBlock Text="来源 · 整个来源活动需求摘要" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Summaries.SourceActionText}" ToolTip="独立刷新来源摘要；失败时可重试。" Command="{Binding Summaries.RefreshSourcesCommand}" Margin="0,0,8,0" />
            <Button Content="清除本页来源筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding ElementName=SourcesGrid}" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Summaries.SourceStamp}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding Summaries.SourceError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <DataGrid x:Name="SourcesGrid" Grid.Row="1" ItemsSource="{Binding Sources, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" RowHeight="56" ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}" dgx:DataGridFilter.IsAutoFilterEnabled="True" dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15" SelectionChanged="OnSourceSelectionChanged" AutomationProperties.Name="订单跟踪来源当前页">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource SwiftExportDataGridRow}">
            <Setter Property="ToolTip" Value="{Binding SummaryInfo}" />
          </Style>
        </DataGrid.RowStyle>
        <i:Interaction.Behaviors>
          <behaviors:DataGridColumnVisibilityBehavior />
        </i:Interaction.Behaviors>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="复制当前来源" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源单号" Width="125" Binding="{Binding SourceNo}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户" Width="80" Binding="{Binding CustomerCode}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户 PO" Width="110" Binding="{Binding CustomerPo}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="需求条数" Width="100" Binding="{Binding DemandCountText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关注事项" Width="140" Binding="{Binding AttentionBrief}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="交付条数" Width="130" Binding="{Binding DeliveryBrief}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="逾期" Width="100" Binding="{Binding OverdueText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="物料需求" Width="130" Binding="{Binding MaterialBrief}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购承接" Width="110" Binding="{Binding PurchaseBrief}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购整行收货" Width="150" Binding="{Binding ReceiptBrief}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="类型" Width="80" Binding="{Binding SourceType}" Visibility="Collapsed" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="发票号" Width="140" Binding="{Binding InvoiceNo}" Visibility="Collapsed" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="全部需求数" Width="110" Binding="{Binding TotalDemandCount}" Visibility="Collapsed" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="命中需求数" Width="110" Binding="{Binding MatchedDemandCount}" Visibility="Collapsed" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源核实原因" Width="240" Binding="{Binding ReviewReason}" Visibility="Collapsed" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户名称" Width="160" Binding="{Binding CustomerName}" Visibility="Collapsed" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Row="2" Margin="0,4,0,0">
        <TextBlock Text="{Binding SourceSummary}" VerticalAlignment="Center" />
        <controls:PageNavigator HorizontalAlignment="Right" TotalCount="{Binding SourceTotalCount}" PageIndex="{Binding SourcePageIndex}" PageSize="{Binding SourcePageSize}" PageChangeCommand="{Binding SourcePageChangeCommand}" />
      </DockPanel>
      <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoadingSources, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
    <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,4">
        <TextBlock Text="{Binding DemandTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Content="当前行明细" Command="{Binding OpenSelectedCommand}" ToolTip="{Binding DetailHint}" Margin="0,4,8,0" />
          <Button Content="交付明细" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Deliveries}" ToolTip="{Binding DeliveryHint}" Margin="0,4,8,0" />
          <Button Content="物料需求" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Materials}" ToolTip="{Binding MaterialHint}" Margin="0,4,8,0" />
          <Button Content="采购关联" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Purchases}" ToolTip="{Binding PurchaseHint}" Margin="0,4,8,0" />
          <Button Content="整行收货" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Receipts}" ToolTip="{Binding ReceiptHint}" Margin="0,4,8,0" />
          <Button Content="重新加载成品需求" Command="{Binding LoadSelectedSourceCommand}" ToolTip="基础表读取失败时单独重试，保留已应用查询。" Margin="0,4,8,0" />
          <Button Content="清除成品需求列筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding ElementName=TrackingGrid}" Margin="0,4,8,0" />
        </WrapPanel>
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding DemandStateText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding DemandLoadError}" TextWrapping="Wrap" />
        <WrapPanel>
          <TextBlock Text="{Binding Matches.StatusText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="定位下一命中" Command="{Binding Matches.LocateNextCommand}" Margin="0,0,8,4" />
          <Button Content="刷新命中" Command="{Binding Matches.RefreshCommand}" Margin="0,0,8,4" />
          <Button Content="{Binding Summaries.DemandActionText}" ToolTip="{Binding Summaries.DemandStamp}" Command="{Binding Summaries.RefreshDemandsCommand}" Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding Matches.ErrorMessage}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding Matches.LocationMessage}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource OptionalMessage}" Text="{Binding Summaries.DemandError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <DataGrid x:Name="TrackingGrid" FrozenColumnCount="4" Grid.Row="2" ItemsSource="{Binding Items, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" RowHeight="48" behaviors:GridRowHeader.ShowRowNumber="True" ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}" dgx:DataGridFilter.IsAutoFilterEnabled="True" dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15" MouseDoubleClick="OnMouseDoubleClick" PreviewMouseRightButtonDown="OnMouseRightButtonDown" AutomationProperties.Name="来源全部成品需求">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource SwiftExportDataGridRow}">
            <Setter Property="ToolTip" Value="{Binding SummaryInfo}" />
          </Style>
        </DataGrid.RowStyle>
        <i:Interaction.Behaviors>
          <behaviors:DataGridColumnVisibilityBehavior />
        </i:Interaction.Behaviors>
        <DataGrid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="查看当前行明细" Command="{Binding OpenSelectedCommand}" ToolTip="{Binding DetailHint}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="交付明细" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Deliveries}" ToolTip="{Binding DeliveryHint}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="物料需求" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Materials}" ToolTip="{Binding MaterialHint}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="采购关联" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Purchases}" ToolTip="{Binding PurchaseHint}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="整行收货" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Receipts}" ToolTip="{Binding ReceiptHint}" ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="复制所选行（可多选）" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn dgx:DataGridFilterColumn.IsFilterVisible="False" Header="图片" Width="64" ClipboardContentBinding="{Binding ImagePath}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <controls:CachedImage Width="40" Height="40" SourcePath="{Binding ImagePath}" Style="{StaticResource SwiftExportCachedImage}" Stretch="Uniform" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="产品编码" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户型号" Binding="{Binding CustomerSku}" Width="130" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="中性型号" Binding="{Binding LinkSku}" Width="130" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn Header="查询命中" Binding="{Binding MatchText}" Width="90" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关注事项" Width="140" Binding="{Binding AttentionBrief}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="要求交期" Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未指定}" Width="110" ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="已交" Width="130" Binding="{Binding DeliveredText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="剩余未交" Width="130" Binding="{Binding RemainingText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="逾期" Width="110" Binding="{Binding OverdueText}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="生命周期" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="90" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="需求数量" Binding="{Binding DemandQty, StringFormat=N2}" Width="100" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="单位" Binding="{Binding Unit, TargetNullValue=—}" Width="80" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="物料需求" Width="170" Binding="{Binding MaterialText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购承接" Width="150" Binding="{Binding PurchaseText}" />
          <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关联采购整行" Width="260" Binding="{Binding ReceiptText}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户" Binding="{Binding CustomerCode}" Width="90" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Visibility="Collapsed" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源单号" Binding="{Binding SourceNo}" Width="125" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Visibility="Collapsed" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户名称" Binding="{Binding CustomerName}" Width="150" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源类型" Binding="{Binding SourceType}" Width="80" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户 PO" Binding="{Binding CustomerPo}" Width="130" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="发票号" Binding="{Binding InvoiceNo}" Width="130" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源行号" Binding="{Binding SourceLineNumber}" Width="80" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="描述" Binding="{Binding Description}" Width="220" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="颜色" Binding="{Binding Color}" Width="100" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
          <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="规格" Binding="{Binding Specification}" Width="150" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" />
        </DataGrid.Columns>
      </DataGrid>
      <ProgressBar Grid.Row="2" VerticalAlignment="Top" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <DockPanel Grid.Row="3" Margin="0,4,0,0">
        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" MaxWidth="650" VerticalAlignment="Center" />
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
