<UserControl x:Class="SwiftExportClient.Features.OrderTracking.Overview.Views.OrderTrackingOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls" xmlns:sections="clr-namespace:SwiftExportClient.Features.OrderTracking.DemandDetail.Models" xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
 xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
 xmlns:dgx="urn:tom-englert.de/DataGridExtensions" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
 Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="FilterLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="8"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8" IsEnabled="{Binding CanView}">
   <TextBlock Text="跟踪总览" Style="{StaticResource SubtitleTextBlock}" Margin="0,0,16,0" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal">
    <TextBox x:Name="KeywordSearchBox" Width="420" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
      ToolTip="来源单号、客户PO、发票号、产品编码、客户型号、中性型号" AutomationProperties.Name="统一关键词搜索">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
    </TextBox>
    <Button Content="查询" Command="{Binding SearchCommand}" MinWidth="70" Margin="0,0,8,0"/>
    <Button Content="刷新" Command="{Binding RefreshCommand}" MinWidth="70" Margin="0,0,8,0"/>
    <Button Content="清空" Click="OnClearFilters" MinWidth="70"/>
   </StackPanel>
  </DockPanel>
  <WrapPanel Grid.Row="1" IsEnabled="{Binding CanView}">
   <TextBlock Text="来源" Style="{StaticResource FilterLabel}"/>
   <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="DisplayText" SelectedValuePath="Value" SelectedValue="{Binding SelectedSourceType}" VerticalContentAlignment="Center" AutomationProperties.Name="来源类型"/>
   <lookup:MultiSelectLookupButton x:Name="CustomerCodesSelector" Header="客户代码" MinWidth="130" Margin="0,0,8,8" ItemsSource="{Binding CustomerCodeOptions}" SelectedItems="{Binding SelectedCustomerCodes, Mode=OneWay}" AutomationProperties.Name="客户代码多选"/>
   <lookup:MultiSelectLookupButton Header="生命周期" MinWidth="120" Margin="0,0,8,8" DisplayMemberPath="DisplayText" ItemsSource="{Binding LifecycleOptions}" SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" AutomationProperties.Name="成品需求生命周期多选"/>
   <lookup:MultiSelectLookupButton x:Name="AttentionSelector" Header="关注事项" ItemsSource="{Binding AttentionOptions}" DisplayMemberPath="DisplayText" SelectedItems="{Binding SelectedAttentions, Mode=OneWay}" MinWidth="140" Margin="0,0,8,8" AutomationProperties.Name="关注事项多选"/><TextBlock Text="要求交期起" Style="{StaticResource FilterLabel}"/><DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding RequiredDateFrom}" AutomationProperties.Name="要求交期开始"/>
   <TextBlock Text="至" Style="{StaticResource FilterLabel}"/><DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding RequiredDateTo}" AutomationProperties.Name="要求交期结束"/>
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="统一搜索：来源单号、客户PO、发票号及产品型号。来源筛选按关注码并集匹配；来源摘要覆盖整个来源活动需求。子表完整加载，列筛选仅改变显示。采购承接不等于确认；整行收货不代表本需求实收份额。" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding CustomerLoadError}" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,4"><DockPanel><TextBlock Text="来源 · 整个来源活动需求摘要" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="重试来源摘要" Command="{Binding Summaries.RefreshSourcesCommand}" Margin="0,0,8,0"/><Button Content="清除本页来源筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding ElementName=SourcesGrid}"/></StackPanel></DockPanel><TextBlock Text="{Binding Summaries.SourceStamp}" TextWrapping="Wrap"/><TextBlock Text="{Binding Summaries.SourceError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <DataGrid x:Name="SourcesGrid" Grid.Row="1" ItemsSource="{Binding Sources, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
     Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
     SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" RowHeight="72"
     ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}" dgx:DataGridFilter.IsAutoFilterEnabled="True" dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
     SelectionChanged="OnSourceSelectionChanged" AutomationProperties.Name="订单跟踪来源当前页">
    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource SwiftExportDataGridRow}"><Setter Property="ToolTip" Value="{Binding SummaryInfo}"/></Style></DataGrid.RowStyle><i:Interaction.Behaviors><behaviors:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源单号" Width="125" Binding="{Binding SourceNo}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户" Width="80" Binding="{Binding CustomerCode}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="需求条数" Width="100" Binding="{Binding DemandCountText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关注事项" Width="175" Binding="{Binding AttentionText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="交付条数" Width="155" Binding="{Binding DeliveryText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="逾期" Width="100" Binding="{Binding OverdueText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="物料需求" Width="150" Binding="{Binding MaterialText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购承接" Width="130" Binding="{Binding PurchaseText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购整行收货" Width="170" Binding="{Binding ReceiptText}"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="类型" Width="80" Binding="{Binding SourceType}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户 PO" Width="150" Binding="{Binding CustomerPo}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="发票号" Width="140" Binding="{Binding InvoiceNo}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="全部需求数" Width="110" Binding="{Binding TotalDemandCount}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="命中需求数" Width="110" Binding="{Binding MatchedDemandCount}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源核实原因" Width="240" Binding="{Binding ReviewReason}" Visibility="Collapsed"/>
 <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户名称" Width="160" Binding="{Binding CustomerName}" Visibility="Collapsed"/>
</DataGrid.Columns>
   </DataGrid>
   <DockPanel Grid.Row="2" Margin="0,4,0,0"><TextBlock Text="{Binding SourceSummary}" VerticalAlignment="Center"/><controls:PageNavigator HorizontalAlignment="Right" TotalCount="{Binding SourceTotalCount}" PageIndex="{Binding SourcePageIndex}" PageSize="{Binding SourcePageSize}" PageChangeCommand="{Binding SourcePageChangeCommand}"/></DockPanel>
   <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoadingSources, Converter={StaticResource BooleanToVisibilityConverter}}"/>
  </Grid>
  <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
  <Grid Grid.Row="5">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,4"><TextBlock Text="全部成品需求 · 当前来源" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="查看跟踪明细" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,0"/><Button Content="交付明细" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Deliveries}" Margin="0,0,8,0"/>
<Button Content="物料明细" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Materials}" Margin="0,0,8,0"/>
<Button Content="采购关联" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Purchases}" Margin="0,0,8,0"/>
<Button Content="整行收货" Command="{Binding OpenDemandSectionCommand}" CommandParameter="{x:Static sections:DemandTrackingSection.Receipts}" Margin="0,0,8,0"/><Button Content="清除成品需求列筛选" Command="{x:Static commands:DataGridFilterCommands.Clear}" CommandParameter="{Binding ElementName=TrackingGrid}"/></StackPanel></DockPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="{Binding DemandLoadError}" TextWrapping="Wrap"/><DockPanel><Button Content="重试需求摘要" Command="{Binding Summaries.RefreshDemandsCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Summaries.DemandStamp}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Summaries.DemandError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <DataGrid x:Name="TrackingGrid" Grid.Row="2" ItemsSource="{Binding Items, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
     Style="{StaticResource SwiftExportDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
     SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" RowHeight="48" behaviors:GridRowHeader.ShowRowNumber="True"
     ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}" dgx:DataGridFilter.IsAutoFilterEnabled="True" dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
     MouseDoubleClick="OnMouseDoubleClick" PreviewMouseRightButtonDown="OnMouseRightButtonDown" AutomationProperties.Name="来源全部成品需求">
    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource SwiftExportDataGridRow}"><Setter Property="ToolTip" Value="{Binding SummaryInfo}"/></Style></DataGrid.RowStyle><i:Interaction.Behaviors><behaviors:DataGridColumnVisibilityBehavior/></i:Interaction.Behaviors>
    <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="查看跟踪明细" Command="{Binding OpenSelectedCommand}"/><MenuItem Header="复制" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
                <DataGridTemplateColumn dgx:DataGridFilterColumn.IsFilterVisible="False" Header="图片" Width="64" ClipboardContentBinding="{Binding ImagePath}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><controls:CachedImage Width="40" Height="40" SourcePath="{Binding ImagePath}"
                        Style="{StaticResource SwiftExportCachedImage}" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户" Binding="{Binding CustomerCode}" Width="90" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源单号" Binding="{Binding SourceNo}" Width="125" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="产品编码" Binding="{Binding Sku}" Width="120" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户型号" Binding="{Binding CustomerSku}" Width="130" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="中性型号" Binding="{Binding LinkSku}" Width="130" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="需求数量" Binding="{Binding DemandQty, StringFormat=N2}" Width="100" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="单位" Binding="{Binding Unit, TargetNullValue=—}" Width="80" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="要求交期" Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未指定}" Width="110" ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="生命周期" Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="90" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户名称" Binding="{Binding CustomerName}" Width="150" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源类型" Binding="{Binding SourceType}" Width="80" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="客户 PO" Binding="{Binding CustomerPo}" Width="130" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="发票号" Binding="{Binding InvoiceNo}" Width="130" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="来源行号" Binding="{Binding SourceLineNumber}" Width="80" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="描述" Binding="{Binding Description}" Width="220" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关注事项" Width="175" Binding="{Binding AttentionText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="摘要已交" Width="130" Binding="{Binding DeliveredText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="摘要未交" Width="130" Binding="{Binding RemainingText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="逾期" Width="110" Binding="{Binding OverdueText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="物料条数" Width="170" Binding="{Binding MaterialText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="采购承接" Width="150" Binding="{Binding PurchaseText}"/>
<DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="关联采购整行" Width="260" Binding="{Binding ReceiptText}"/><DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="颜色" Binding="{Binding Color}" Width="100" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>
                <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="规格" Binding="{Binding Specification}" Width="150" Visibility="Collapsed" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>

    </DataGrid.Columns>
   </DataGrid>
   <ProgressBar Grid.Row="2" VerticalAlignment="Top" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <DockPanel Grid.Row="3" Margin="0,4,0,0"><TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" MaxWidth="650" VerticalAlignment="Center"/></DockPanel>
  </Grid>
 </Grid>
</UserControl>
