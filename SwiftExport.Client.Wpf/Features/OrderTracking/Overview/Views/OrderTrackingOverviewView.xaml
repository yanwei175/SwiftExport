<UserControl
    x:Class="SwiftExportClient.Features.OrderTracking.Overview.Views.OrderTrackingOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:sections="clr-namespace:SwiftExportClient.Features.OrderTracking.DemandDetail.Models"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style
            x:Key="OptionalMessage"
            BasedOn="{StaticResource {x:Type TextBlock}}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactExplanation" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton
                                Padding="4,0"
                                HorizontalAlignment="Left"
                                Content="口径说明"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter
                                x:Name="Explanation"
                                Margin="4,4,0,0"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Explanation" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="210" />
            <RowDefinition Height="8" />
            <RowDefinition Height="3*" MinHeight="260" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8" IsEnabled="{Binding CanView}">
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlock}"
                Text="跟踪总览" />
            <TextBox
                x:Name="KeywordSearchBox"
                Width="300"
                Margin="0,0,8,0"
                AutomationProperties.Name="统一关键词搜索"
                Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="来源单号、客户PO、发票号、产品编码、客户型号、中性型号">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button
                MinWidth="70"
                Margin="0,0,8,0"
                Command="{Binding SearchCommand}"
                Content="查询" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding RefreshCommand}"
                Content="刷新已应用查询"
                ToolTip="保留输入；只刷新已查询条件和当前页。" />
            <Button Click="OnClearFilters" Content="清空并查询" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" IsEnabled="{Binding CanView}">
            <TextBlock Style="{StaticResource FilterLabel}" Text="来源" />
            <ComboBox
                Width="150"
                Margin="0,0,8,8"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="来源类型"
                DisplayMemberPath="DisplayText"
                ItemsSource="{Binding SourceOptions}"
                SelectedValue="{Binding SelectedSourceType}"
                SelectedValuePath="Value" />
            <lookup:MultiSelectLookupButton
                x:Name="CustomerCodesSelector"
                MinWidth="130"
                Margin="0,0,8,8"
                AutomationProperties.Name="客户代码多选"
                Header="客户代码"
                ItemsSource="{Binding CustomerCodeOptions}"
                SelectedItems="{Binding SelectedCustomerCodes, Mode=OneWay}" />
            <lookup:MultiSelectLookupButton
                MinWidth="120"
                Margin="0,0,8,8"
                AutomationProperties.Name="成品需求生命周期多选"
                DisplayMemberPath="DisplayText"
                Header="生命周期"
                ItemsSource="{Binding LifecycleOptions}"
                SelectedItems="{Binding SelectedLifecycleStatuses, Mode=OneWay}" />
            <lookup:MultiSelectLookupButton
                x:Name="AttentionSelector"
                MinWidth="140"
                Margin="0,0,8,8"
                AutomationProperties.Name="关注事项多选"
                DisplayMemberPath="DisplayText"
                Header="关注事项（任一项）"
                ItemsSource="{Binding AttentionOptions}"
                SelectedItems="{Binding SelectedAttentions, Mode=OneWay}"
                ToolTip="所选关注事项满足任一项；再与其他条件共同匹配。" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FilterLabel}" Text="要求交期起" />
                <DatePicker
                    Width="140"
                    Margin="0,0,8,8"
                    AutomationProperties.Name="要求交期开始"
                    SelectedDate="{Binding RequiredDateFrom}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FilterLabel}" Text="至" />
                <DatePicker
                    Width="140"
                    Margin="0,0,8,8"
                    AutomationProperties.Name="要求交期结束"
                    SelectedDate="{Binding RequiredDateTo}" />
            </StackPanel>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource OptionalMessage}"
                Text="{Binding QueryStateText}"
                TextWrapping="Wrap" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource OptionalMessage}"
                Text="{Binding ValidationSummary}"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{StaticResource OptionalMessage}"
                Text="{Binding CustomerLoadError}"
                TextWrapping="Wrap" />
            <Expander Header="口径说明" Style="{StaticResource CompactExplanation}">
                <TextBlock Text="关注事项满足任一项，再与其他条件共同匹配。来源摘要覆盖整个来源的活动需求；子表保留全部非删除成品需求，命中仅作标记。摘要与匹配各自读取当前事实，与来源查询并非同一快照。采购承接不等于采购确认；收货为关联采购整行事实，不代表本需求实收份额。" TextWrapping="Wrap" />
            </Expander>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,4">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="来源 · 整个来源活动需求摘要" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding Summaries.RefreshSourcesCommand}"
                            Content="{Binding Summaries.SourceActionText}"
                            ToolTip="独立刷新来源摘要；失败时可重试。" />
                        <Button
                            Command="{x:Static commands:DataGridFilterCommands.Clear}"
                            CommandParameter="{Binding ElementName=SourcesGrid}"
                            Content="清除本页来源筛选" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Summaries.SourceStamp}" TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding Summaries.SourceError}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <DataGrid
                x:Name="SourcesGrid"
                Grid.Row="1"
                dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
                dgx:DataGridFilter.IsAutoFilterEnabled="True"
                AutoGenerateColumns="False"
                AutomationProperties.Name="订单跟踪来源当前页"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                ClipboardCopyMode="IncludeHeader"
                ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                IsReadOnly="True"
                ItemsSource="{Binding Sources, NotifyOnTargetUpdated=True}"
                RowHeight="56"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                SelectionChanged="OnSourceSelectionChanged"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Style="{StaticResource SwiftExportDataGrid}">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource SwiftExportDataGridRow}" TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding SummaryInfo}" />
                    </Style>
                </DataGrid.RowStyle>
                <i:Interaction.Behaviors>
                    <behaviors:DataGridColumnVisibilityBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="ApplicationCommands.Copy"
                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="复制当前来源" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="125"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源单号" />
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerCode}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerPo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户 PO" />
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DemandCountText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="需求条数" />
                    <DataGridTextColumn
                        Width="140"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding AttentionBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="关注事项" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DeliveryBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="交付条数" />
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding OverdueText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="逾期" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding MaterialBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="物料需求" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding PurchaseBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="采购承接" />
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ReceiptBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="采购整行收货" />
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceType}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="类型"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="140"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding InvoiceNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="发票号"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding TotalDemandCount}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="全部需求数"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding MatchedDemandCount}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="命中需求数"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="240"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ReviewReason}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源核实原因"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="160"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerName}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户名称"
                        Visibility="Collapsed" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <TextBlock VerticalAlignment="Center" Text="{Binding SourceSummary}" />
                <controls:PageNavigator
                    HorizontalAlignment="Right"
                    PageChangeCommand="{Binding SourcePageChangeCommand}"
                    PageSize="{Binding SourcePageSize}"
                    TotalCount="{Binding SourceTotalCount}"
                    PageIndex="{Binding SourcePageIndex}" />
            </DockPanel>
            <ProgressBar
                Grid.Row="1"
                Height="4"
                VerticalAlignment="Top"
                IsIndeterminate="True"
                Visibility="{Binding IsLoadingSources, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        <GridSplitter
            Grid.Row="4"
            Height="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,4">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding DemandTitle}"
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding OpenSelectedCommand}"
                        Content="当前行明细"
                        ToolTip="{Binding DetailHint}" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding OpenDemandSectionCommand}"
                        CommandParameter="{x:Static sections:DemandTrackingSection.Deliveries}"
                        Content="交付明细"
                        ToolTip="{Binding DeliveryHint}" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding OpenDemandSectionCommand}"
                        CommandParameter="{x:Static sections:DemandTrackingSection.Materials}"
                        Content="物料需求"
                        ToolTip="{Binding MaterialHint}" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding OpenDemandSectionCommand}"
                        CommandParameter="{x:Static sections:DemandTrackingSection.Purchases}"
                        Content="采购关联"
                        ToolTip="{Binding PurchaseHint}" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding OpenDemandSectionCommand}"
                        CommandParameter="{x:Static sections:DemandTrackingSection.Receipts}"
                        Content="整行收货"
                        ToolTip="{Binding ReceiptHint}" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{Binding LoadSelectedSourceCommand}"
                        Content="重新加载成品需求"
                        ToolTip="基础表读取失败时单独重试，保留已应用查询。" />
                    <Button
                        Margin="0,4,8,0"
                        Command="{x:Static commands:DataGridFilterCommands.Clear}"
                        CommandParameter="{Binding ElementName=TrackingGrid}"
                        Content="清除成品需求列筛选" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding DemandStateText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding DemandLoadError}"
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="{Binding Matches.StatusText}" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding Matches.LocateNextCommand}"
                        Content="定位下一命中" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding Matches.RefreshCommand}"
                        Content="刷新命中" />
                    <Button
                        Margin="0,0,8,4"
                        Command="{Binding Summaries.RefreshDemandsCommand}"
                        Content="{Binding Summaries.DemandActionText}"
                        ToolTip="{Binding Summaries.DemandStamp}" />
                </WrapPanel>
                <TextBlock
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding Matches.ErrorMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding Matches.LocationMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource OptionalMessage}"
                    Text="{Binding Summaries.DemandError}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <DataGrid
                x:Name="TrackingGrid"
                Grid.Row="2"
                behaviors:GridRowHeader.ShowRowNumber="True"
                dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
                dgx:DataGridFilter.IsAutoFilterEnabled="True"
                AutoGenerateColumns="False"
                AutomationProperties.Name="来源全部成品需求"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                ClipboardCopyMode="IncludeHeader"
                ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}"
                FrozenColumnCount="4"
                IsReadOnly="True"
                ItemsSource="{Binding Items, NotifyOnTargetUpdated=True}"
                MouseDoubleClick="OnMouseDoubleClick"
                PreviewMouseRightButtonDown="OnMouseRightButtonDown"
                RowHeight="48"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource SwiftExportDataGrid}">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource SwiftExportDataGridRow}" TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding SummaryInfo}" />
                    </Style>
                </DataGrid.RowStyle>
                <i:Interaction.Behaviors>
                    <behaviors:DataGridColumnVisibilityBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem
                            Command="{Binding OpenSelectedCommand}"
                            Header="查看当前行明细"
                            ToolTip="{Binding DetailHint}"
                            ToolTipService.ShowOnDisabled="True" />
                        <MenuItem
                            Command="{Binding OpenDemandSectionCommand}"
                            CommandParameter="{x:Static sections:DemandTrackingSection.Deliveries}"
                            Header="交付明细"
                            ToolTip="{Binding DeliveryHint}"
                            ToolTipService.ShowOnDisabled="True" />
                        <MenuItem
                            Command="{Binding OpenDemandSectionCommand}"
                            CommandParameter="{x:Static sections:DemandTrackingSection.Materials}"
                            Header="物料需求"
                            ToolTip="{Binding MaterialHint}"
                            ToolTipService.ShowOnDisabled="True" />
                        <MenuItem
                            Command="{Binding OpenDemandSectionCommand}"
                            CommandParameter="{x:Static sections:DemandTrackingSection.Purchases}"
                            Header="采购关联"
                            ToolTip="{Binding PurchaseHint}"
                            ToolTipService.ShowOnDisabled="True" />
                        <MenuItem
                            Command="{Binding OpenDemandSectionCommand}"
                            CommandParameter="{x:Static sections:DemandTrackingSection.Receipts}"
                            Header="整行收货"
                            ToolTip="{Binding ReceiptHint}"
                            ToolTipService.ShowOnDisabled="True" />
                        <Separator />
                        <MenuItem
                            Command="ApplicationCommands.Copy"
                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="复制所选行（可多选）" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="64"
                        dgx:DataGridFilterColumn.IsFilterVisible="False"
                        ClipboardContentBinding="{Binding ImagePath}"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="40"
                                    Height="40"
                                    SourcePath="{Binding ImagePath}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="120"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Sku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="产品编码" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户型号" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding LinkSku}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="中性型号" />
                    <DataGridTextColumn
                        Width="90"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding MatchText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="查询命中" />
                    <DataGridTextColumn
                        Width="140"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding AttentionBrief}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="关注事项" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未指定}"
                        ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                        Header="要求交期" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DeliveredText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="已交" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding RemainingText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="剩余未交" />
                    <DataGridTextColumn
                        Width="110"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding OverdueText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="逾期" />
                    <DataGridTextColumn
                        Width="90"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="生命周期" />
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding DemandQty, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="需求数量" />
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Unit, TargetNullValue=—}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="单位" />
                    <DataGridTextColumn
                        Width="170"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding MaterialText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="物料需求" />
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding PurchaseText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="采购承接" />
                    <DataGridTextColumn
                        Width="260"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding ReceiptText}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="关联采购整行" />
                    <DataGridTextColumn
                        Width="90"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerCode}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="125"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源单号"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerName}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户名称"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceType}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源类型"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding CustomerPo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户 PO"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="130"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding InvoiceNo}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="发票号"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="80"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding SourceLineNumber}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="来源行号"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="220"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Description}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="描述"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="100"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Color}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="颜色"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="150"
                        dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                        Binding="{Binding Specification}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="规格"
                        Visibility="Collapsed" />
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar
                Grid.Row="2"
                Height="4"
                VerticalAlignment="Top"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <DockPanel Grid.Row="3" Margin="0,4,0,0">
                <TextBlock
                    MaxWidth="650"
                    VerticalAlignment="Center"
                    Text="{Binding ResultSummary}"
                    TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
