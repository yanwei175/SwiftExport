<UserControl
    x:Class="SwiftExportClient.Features.OrderTracking.MaterialDetail.Views.MaterialTrackingDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:commands="clr-namespace:SwiftExportClient.Resources.Commands"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:shared="clr-namespace:SwiftExportClient.Features.OrderTracking.Shared.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwiftExport.Client.Wpf;component/Features/OrderTracking/Shared/TrackingSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ReturnToDemandCommand}"
                    Content="返回成品需求" />
                <Button Command="{Binding ReturnToOverviewCommand}" Content="返回总览" />
            </StackPanel>
            <TextBlock Style="{StaticResource SubtitleTextBlock}" Text="物料跟踪详情" />
        </DockPanel>
        <TabControl
            x:Name="SectionsTabs"
            Grid.Row="1"
            SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
            SelectionChanged="OnSectionChanged">
            <TabItem Header="物料快照">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ContentControl Content="{Binding Header}" ContentTemplate="{StaticResource SectionFeedback}" />
                        <UniformGrid Columns="3">
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="来源类型" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.SourceType, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="来源单号" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.SourceNo, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="来源行号" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.SourceLineNumber, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="物料编码" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.Sku, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="客户型号" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.CustomerSku, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="父物料编码" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.ParentSku, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="修订号" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.DecompositionRevision, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="生命周期" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.LifecycleStatus, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="历史标记" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.IsDeleted, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Deleted, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="采用组成数量" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.GrossQty, StringFormat=N2, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="物料需求量" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.NetQty, StringFormat=N2, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="单位快照" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.Unit, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="要求交期" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.RequiredDate, StringFormat=yyyy-MM-dd, TargetNullValue=未指定, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="物料类型" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.MaterialType, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="供货方式" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.SupplyType, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="颜色" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Color, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="规格" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Specification, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="采用BOM标记" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.BomVersion, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="回退时间" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.RolledBackAt, StringFormat=yyyy-MM-dd HH:mm:ss, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="回退人" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.RolledBackBy, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Fact}">
                                <TextBlock Style="{StaticResource FactLabel}" Text="客户代码（当前）" />
                                <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.CustomerCode, Mode=OneWay}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Style="{StaticResource Fact}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="描述快照" />
                            <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Material.Description, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Fact}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="采用BOM路径" />
                            <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.BomPath, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Fact}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="物料备注" />
                            <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.Remark, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Fact}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="回退原因" />
                            <TextBox Style="{StaticResource FactValue}" Text="{Binding Header.Data.RolledBackReason, Mode=OneWay}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="采购承接">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="本物料采购承接与活动、历史关联；采购整行数量不等于本物料份额。"
                        TextWrapping="Wrap" />
                    <ContentControl
                        Grid.Row="1"
                        Content="{Binding Purchases}"
                        ContentTemplate="{StaticResource SectionFeedback}" />
                    <WrapPanel
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        Visibility="{Binding Purchases.IsLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="物料需求量：" />
                        <TextBlock Text="{Binding Purchases.Data.NetQty, StringFormat=N2}" />
                        <TextBlock Text="　已采购：" />
                        <TextBlock Text="{Binding Purchases.Data.PurchasedQty, StringFormat=N2, TargetNullValue=待核实}" />
                        <TextBlock Text="　草稿占用：" />
                        <TextBlock Text="{Binding Purchases.Data.DraftOccupiedQty, StringFormat=N2, TargetNullValue=待核实}" />
                        <TextBlock Text="　未采购：" />
                        <TextBlock Text="{Binding Purchases.Data.UnpurchasedQty, StringFormat=N2, TargetNullValue=待核实}" />
                        <TextBlock Text="　可创建：" />
                        <TextBlock Text="{Binding Purchases.Data.CreatableQty, StringFormat=N2, TargetNullValue=待核实}" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Purchases.Data.Unit}" />
                    </WrapPanel>
                    <DataGrid
                        x:Name="PurchasesGrid"
                        Grid.Row="3"
                        AutomationProperties.Name="本物料采购承接关联"
                        IsEnabled="{Binding Purchases.CanRead}"
                        ItemsSource="{Binding Purchases.Data.Items, NotifyOnTargetUpdated=True}"
                        Style="{StaticResource TrackingSectionGrid}">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridColumnVisibilityBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="ApplicationCommands.Copy"
                                    CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="复制" />
                                <MenuItem
                                    Command="{x:Static commands:DataGridFilterCommands.Clear}"
                                    CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="清除列筛选" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="130"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding PurchaseOrderNo}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="采购单号" />
                            <DataGridTextColumn
                                Width="80"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding PurchaseLineNumber}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="行号" />
                            <DataGridTextColumn
                                Width="120"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding SupplierName}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="供应商" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Sku}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="型号" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding LinkedQty, StringFormat=N2}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="采购总占用" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding PurchasedQty, StringFormat=N2}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="已采购" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding DraftOccupiedQty, StringFormat=N2}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="草稿占用" />
                            <DataGridTextColumn
                                Width="80"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Unit}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="单位" />
                            <DataGridTextColumn
                                Width="140"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding PurchaseLineQty, StringFormat=N2, TargetNullValue=待核实}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="采购整行数量" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=PurchaseConfirmation}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="确认状态" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=PurchaseLifecycle}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="生命周期" />
                            <DataGridTextColumn
                                Width="220"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding ReviewReason}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="待核实原因" />
                            <DataGridTextColumn
                                Width="100"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding AllocatedQty, StringFormat=N2}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="原始分配"
                                Visibility="Collapsed" />
                            <DataGridTextColumn
                                Width="100"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding ReleasedQty, StringFormat=N2}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="已释放"
                                Visibility="Collapsed" />
                            <DataGridTextColumn
                                Width="90"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding DecompositionRevision}"
                                ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                Header="物料修订"
                                Visibility="Collapsed" />
                            <DataGridTextColumn
                                Width="110"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding IsActiveLink, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=ActiveLink}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="关联状态"
                                Visibility="Collapsed" />
                            <DataGridTextColumn
                                Width="120"
                                dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                Binding="{Binding IsSharedPurchaseLine, Converter={StaticResource TrackingEvidenceTextConverter}, ConverterParameter=Shared}"
                                ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                Header="采购行共享"
                                Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="关联采购行收货">
                <shared:ReceiptTrackingSectionView DataContext="{Binding Receipts}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
