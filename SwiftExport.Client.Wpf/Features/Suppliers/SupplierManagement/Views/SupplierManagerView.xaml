<UserControl x:Class="SwiftExportClient.Features.Suppliers.SupplierManagement.Views.SupplierManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:drawerViews="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierProducts.Views"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <UserControl.Resources>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="*" />
            <RowDefinition Height="4" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:LookupTextBox Placeholder="供应商代码、名称、单据号或联系人"
                                    MinimumSearchLength="0" Text="{Binding Keyword, Mode=TwoWay}"
                                    QueryCommand="{Binding SearchCommand}" />
            <Button Grid.Column="2" Width="36" Command="{Binding SearchCommand}"  ToolTip="查询">
                <ui:SymbolIcon Symbol="Search24" />
            </Button>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddRowCommand}" Margin="0,0,4,0" Content="新增" />
                <Button Command="{Binding SaveCommand}" Margin="0,0,4,0" Content="保存" />
                <Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0" Content="删除" />
                <Button Command="{Binding RejectCommand}" Margin="0,0,4,0" Content="放弃" />
                <Button Command="{Binding RefreshCommand}" Content="刷新" />
            </StackPanel>
            <StackPanel Grid.Column="6" Orientation="Horizontal">
                <ui:ToggleSwitch Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 OffContent="整行模式"
                                 OnContent="格子模式"
                                 IsEnabled="{Binding CanChangeSelectionMode}"
                                 IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" />
                <ui:ToggleSwitch VerticalAlignment="Center"
                                 Content="管理供应商产品"
                                 IsChecked="{Binding SupplierProducts.IsOpen, Mode=OneWay}"
                                 Command="{Binding ToggleSupplierProductsCommand}" />
            </StackPanel>
        </Grid>

        <controls:RightDrawerHost Grid.Row="2" DisplayMode="Overlay" DrawerWidth="960" MinDrawerWidth="520"
                                  IsResizable="True" DrawerContent="{Binding SupplierProducts}"
                                  IsOpen="{Binding SupplierProducts.IsOpen, Mode=OneWay}"
                                  CloseCommand="{Binding SupplierProducts.CloseCommand}">
            <controls:RightDrawerHost.MainContent>
                <DataGrid ItemsSource="{Binding Suppliers.Items}"
                          Style="{StaticResource SwiftExportDataGrid}" RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                          RowHeight="{StaticResource DataGridRowHeightSmall}"
                          FontSize="12"
                          SelectionMode="Extended"
                          SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                          FrozenColumnCount="3"
                          gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True" gridOperations:GridOperations.IsEnabled="True"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                          gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="43" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox HorizontalAlignment="Left" IsChecked="{Binding DataContext.Suppliers.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Margin="4,0" HorizontalAlignment="Left" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="供应商代码" Width="120" Binding="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="供应商名称" Width="180" Binding="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="单据关联号" Width="110" Binding="{Binding DocRelateNo, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="联系人" Width="100" Binding="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="电话" Width="120" Binding="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="邮箱" Width="170" Binding="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="地址" Width="220" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn Header="折扣" Width="80" Binding="{Binding Discount, UpdateSourceTrigger=LostFocus, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        <DataGridTextColumn Header="币种" Width="70" Binding="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn Header="税率" Width="75" Binding="{Binding TaxRate, UpdateSourceTrigger=LostFocus, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        <DataGridTextColumn Header="默认交期" Width="80" Binding="{Binding DefaultLeadTimeDays, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                        <DataGridTextColumn Header="付款条款" Width="150" Binding="{Binding PaymentTerms, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn Header="折扣备注" Width="180" Binding="{Binding DiscountRemark, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:RightDrawerHost.MainContent>
            <controls:RightDrawerHost.DrawerContentTemplate>
                <DataTemplate><drawerViews:SupplierProductManagerView /></DataTemplate>
            </controls:RightDrawerHost.DrawerContentTemplate>
        </controls:RightDrawerHost>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
