<UserControl x:Class="SwiftExportClient.Features.Suppliers.SupplierManagement.Views.SupplierManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:suppliers="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors" xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
             xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Style x:Key="SelectionMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter"/>
        <DataTemplate x:Key="SupplierCurrencyOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CurrencyCode}"/>
                <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" Text="{Binding CurrencyNameZh}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12" RowDefinitions="Auto,8,*,8,Auto" IsEnabled="{Binding IsInteractionEnabled}">
        <DockPanel>
            <ui:Button Content="刷新" Command="{Binding RefreshCommand}" MinWidth="70" Margin="0,0,8,0"/>
            <ui:Button Content="新增" Command="{Binding AddRowCommand}" MinWidth="70" Margin="0,0,8,0"/>
            <ui:Button Content="保存" Command="{Binding SaveCommand}" MinWidth="70" Margin="0,0,8,0" Appearance="Primary"/>
            <ui:Button Content="删除" Command="{Binding DeleteSelectedCommand}" MinWidth="70" Margin="0,0,8,0"/>
            <ui:Button Content="放弃" Command="{Binding RejectCommand}" MinWidth="70" Margin="0,0,8,0"/>
            <ui:ToggleSwitch OffContent="整行模式" OnContent="格子模式" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ToggleButton x:Name="IsFilterEnabled" IsChecked="True" Content="筛选器" VerticalAlignment="Center"/>
        </DockPanel>
        <DataGrid x:Name="SupplierGrid" Grid.Row="2" ItemsSource="{Binding Suppliers.Items}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  Style="{StaticResource SwiftExportDataGrid}" RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  RowHeight="{StaticResource DataGridRowHeightSmall}" FontSize="{StaticResource SwiftExportDefaltFontSize}"
                  IsReadOnly="{Binding IsGridReadOnly}" BeginningEdit="OnBeginningEdit"
                  ColumnHeaderStyle="{StaticResource SwiftExportFilterColumnHeader}" dgx:DataGridFilter.IsAutoFilterEnabled="{Binding IsChecked, ElementName=IsFilterEnabled}" dgx:DataGridFilter.FilterEvaluationDelay="0:0:0.15"
                  SelectionMode="Extended" SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
                  FrozenColumnCount="3" gridCore:GridRowHeader.ShowRowNumber="True" AutomationProperties.Name="供应商全量管理列表">
            <i:Interaction.Behaviors>
                <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}"/>
                <fill:DataGridColumnVisibilityBehavior/>
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>

                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                    RelativeSource={RelativeSource Self}}"
                             AutomationProperties.Name="供应商批量勾选">

                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="勾选(选区)" Command="{Binding CheckSelectionCommand}"
                          Style="{StaticResource SelectionMenuItem}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="CheckmarkSquare24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="取消勾选(选区)" Command="{Binding UncheckSelectionCommand}"
                          Style="{StaticResource SelectionMenuItem}">
                    <MenuItem.Icon>
                              <ui:SymbolIcon Symbol="Square24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="反选(选区)" Command="{Binding InvertSelectionCommand}"
                          Style="{StaticResource SelectionMenuItem}">
                    <MenuItem.Icon>
                              <ui:SymbolIcon Symbol="ArrowSwap24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator/>

                <MenuItem Header="全选(当前筛选结果)" Command="{Binding CheckVisibleCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="SelectAllOn24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="反选(当前筛选结果)" Command="{Binding InvertVisibleCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="SelectAllOff24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator/>



                <MenuItem Header="删除" Command="{Binding DeleteSelectedCommand}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Delete24"/>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator/>

                    <MenuItem Header="表格模式" Style="{StaticResource ToggleMenuItemStyle}" IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Table24"/>
                        </MenuItem.Icon>
                    </MenuItem>

                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                        <DataGridTemplateColumn ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}" Width="45" CanUserSort="False" dgx:DataGridFilterColumn.IsFilterVisible="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox Margin="0" Padding="0" HorizontalAlignment="Center" AutomationProperties.Name="勾选当前筛选供应商"
                            IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                            Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0"
                                              HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" Header="供应商代码" Width="120" Binding="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="SupplierName" Header="供应商名称" Width="180" Binding="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="DocRelateNo" Header="单据关联号" Width="110" Binding="{Binding DocRelateNo, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="ContactPerson" Header="联系人" Width="100" Binding="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="ContactPhone" Header="电话" Width="120" Binding="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="ContactEmail" Header="邮箱" Width="170" Binding="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="Address" Header="地址" Width="220" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="Discount" Header="折扣" Width="80" Binding="{Binding Discount, UpdateSourceTrigger=LostFocus, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                        <DataGridTemplateColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}"
                                                fill:DataGridFillDownBehavior.Field="Currency" Header="币种" Width="140"
                                                SortMemberPath="Currency" ClipboardContentBinding="{Binding Currency, Mode=OneWay}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Currency}" Style="{StaticResource SwiftExportDataGridTextBlock}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4,0" VerticalContentAlignment="Center"
                                              ItemsSource="{Binding DataContext.CurrencyOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              ItemTemplate="{StaticResource SupplierCurrencyOptionTemplate}"
                                              SelectedValuePath="CurrencyCode"
                                              SelectedValue="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="CurrencyCode"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="TaxRate" Header="税率" Width="75" Binding="{Binding TaxRate, UpdateSourceTrigger=LostFocus, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="DefaultLeadTimeDays" Header="默认交期" Width="80" Binding="{Binding DefaultLeadTimeDays, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="PaymentTerms" Header="付款条款" Width="150" Binding="{Binding PaymentTerms, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                        <DataGridTextColumn dgx:DataGridFilterColumn.Template="{StaticResource SwiftExportColumnFilter}" fill:DataGridFillDownBehavior.Field="DiscountRemark" Header="折扣备注" Width="180" Binding="{Binding DiscountRemark, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                    </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding ResultSummary}" Style="{StaticResource CaptionTextBlock}" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
