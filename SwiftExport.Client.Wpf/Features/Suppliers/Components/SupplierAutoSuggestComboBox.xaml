<UserControl x:Class="SwiftExportClient.Features.Suppliers.Components.SupplierAutoSuggestComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:suppliers="clr-namespace:SwiftExport.Contracts.DTOs.Suppliers;assembly=SwiftExport.Contracts"
             x:Name="Root" FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSizeInTitle}" MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="SupplierItemTemplate" DataType="{x:Type suppliers:SupplierDto}">
            <Grid MinWidth="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding SupplierCode}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding SupplierName}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <controls:LookupTextBox x:Name="LookupEditor"
                            automation:AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedSupplier, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            SearchMode="Local" DisplayMemberPath="SupplierCode" FilterMemberPaths="SupplierCode"
                            SelectedValuePath="Uid" RequireItemMatch="True" ClearSelectionOnEdit="False"
                            ShowDropDownButton="True" MatchSuggestionFontSize="True"
                            ItemTemplate="{StaticResource SupplierItemTemplate}" />
</UserControl>
