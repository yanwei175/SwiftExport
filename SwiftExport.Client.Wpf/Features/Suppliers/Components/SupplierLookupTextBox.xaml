<UserControl x:Class="SwiftExportClient.Features.Suppliers.Components.SupplierLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:suppliers="clr-namespace:SwiftExport.Contracts.DTOs.Suppliers;assembly=SwiftExport.Contracts"
             x:Name="Root"
             MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="SupplierLookupItemTemplate"
                      DataType="{x:Type suppliers:SupplierDto}">
            <Grid MinWidth="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SupplierCode}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Margin="0,2,0,0"
                           Text="{Binding SupplierName}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedSupplier, ElementName=Root, Mode=TwoWay}"
                            SelectedValue="{Binding SelectedSupplierId, ElementName=Root, Mode=TwoWay}"
                            SearchCommand="{Binding SearchCommand, ElementName=Root}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            IsBusy="{Binding IsBusy, ElementName=Root}"
                            SearchDelay="{Binding SearchDelay, ElementName=Root}"
                            MinimumSearchLength="{Binding MinimumSearchLength, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            SearchMode="Remote"
                            DisplayMemberPath="SupplierCode"
                            FilterMemberPaths="SupplierCode,SupplierName"
                             SelectedValuePath="Uid"
                             RequireItemMatch="True"
                             ClearSelectionOnEdit="False"
                             ItemTemplate="{StaticResource SupplierLookupItemTemplate}" />
</UserControl>
