<controls:CachedAutoSuggestBoxBase x:Class="SwiftExportClient.Features.Suppliers.Components.SupplierAutoSuggestBox"
                                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                      xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
                                      xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
                                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                                      x:Name="Root"
                                      FontSize="{DynamicResource SwiftExport.LookUpTextBoxFontSize}"
                                      MinHeight="30">
    <controls:CommittedAutoSuggestBox x:Name="SuggestEditor"
                                      automation:AutomationProperties.Name="{Binding PlaceholderText, ElementName=Root}"
                                      ClearButtonEnabled="{Binding ClearButtonEnabled, ElementName=Root}"
                                      FontSize="{Binding FontSize, ElementName=Root}"
                                      IsSuggestionListOpen="{Binding IsSuggestionListOpen, ElementName=Root, Mode=TwoWay}"
                                      MaxSuggestionListHeight="{Binding MaxSuggestionListHeight, ElementName=Root}"
                                      PlaceholderText="{Binding PlaceholderText, ElementName=Root}"
                                      Style="{DynamicResource {x:Type ui:AutoSuggestBox}}"
                                      UpdateTextOnSelect="False">
        <controls:CommittedAutoSuggestBox.ItemTemplate>
            <DataTemplate>
                <Grid MinWidth="240">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding SupplierCode}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource SwiftExportBrush.TextSecondary}"
                               Text="{Binding SupplierName}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </controls:CommittedAutoSuggestBox.ItemTemplate>
    </controls:CommittedAutoSuggestBox>
</controls:CachedAutoSuggestBoxBase>
