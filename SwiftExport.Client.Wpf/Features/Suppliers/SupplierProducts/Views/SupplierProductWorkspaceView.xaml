<UserControl x:Class="SwiftExportClient.Features.Suppliers.SupplierProducts.Views.SupplierProductWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suppliers="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:supplierProductViews="clr-namespace:SwiftExportClient.Features.Suppliers.SupplierProducts.Views"
             x:Name="Root">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="当前供应商" />
            <suppliers:SupplierAutoSuggestComboBox Grid.Column="2"
                                                   Placeholder="输入供应商代码"
                                                   ItemsSource="{Binding SupplierOptions}"
                                                   SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                                                   SelectionCommittedCommand="{Binding CommitSupplierCommand}"
                                                   SelectionClearedCommand="{Binding ClearSupplierCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <supplierProductViews:SupplierProductManagerView
                DataContext="{Binding Editor}"
                IsEnabled="{Binding DataContext.Editor.IsOpen, ElementName=Root}" />

            <Border Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="请先选择供应商" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                               Text="选择一个已保存供应商后，才能管理该供应商的产品。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
