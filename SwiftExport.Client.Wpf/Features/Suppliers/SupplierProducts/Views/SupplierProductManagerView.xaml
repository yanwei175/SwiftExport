<UserControl
    x:Class="SwiftExportClient.Features.Suppliers.SupplierProducts.Views.SupplierProductManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
    xmlns:fill="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
    xmlns:suppliers="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style
            x:Key="SelectionMenuItem"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="CommandParameter" Value="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </Style>
        <gridSelection:GridSelectionUnitConverter x:Key="GridSelectionUnitConverter" />
    </UserControl.Resources>
    <Grid Margin="12" RowDefinitions="Auto,8,*,8,Auto">
        <Grid RowDefinitions="Auto,8,Auto">
            <Grid x:Name="SupplierSearchGrid" ColumnDefinitions="3*,3*,3*">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlock}"
                        Text="供应商产品管理" />
                    <suppliers:SupplierAutoSuggestComboBox
                        x:Name="SupplierSelector"
                        Width="160"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="选择供应商产品所属供应商"
                        IsEnabled="{Binding CanChangeSupplier}"
                        ItemsSource="{Binding SupplierOptions}"
                        Placeholder="输入供应商代码或名称"
                        SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                        SelectionClearedCommand="{Binding ClearSupplierCommand}"
                        SelectionCommittedCommand="{Binding CommitSupplierCommand}" />
                </StackPanel>
                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="1"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    IsEnabled="{Binding CanEditProducts}"
                    PlaceholderText="供应商料号、SKU、描述或规格"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding ClearSupplierCommand}"
                        Content="清空" />
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="2" IsEnabled="{Binding CanEditProducts}">
                <ui:Button
                    MinWidth="70"
                    Margin="0,0,8,0"
                    Command="{Binding AddItemCommand}"
                    Content="新增" />
                <ui:Button
                    MinWidth="70"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="保存" />
                <ui:Button
                    MinWidth="70"
                    Margin="0,0,8,0"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="删除" />
                <ui:Button
                    MinWidth="70"
                    Margin="0,0,8,0"
                    Command="{Binding RejectCommand}"
                    Content="放弃" />
                <ui:ToggleSwitch
                    Margin="0,0,8,0"
                    IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                    OffContent="整行模式"
                    OnContent="格子模式" />
                <ui:Button
                    MinWidth="70"
                    Margin="0,0,8,0"
                    Command="{Binding SetProductDefaultSupplierCommand}"
                    Content="设为产品默认供应商" />
            </WrapPanel>
        </Grid>
        <DataGrid
            x:Name="ProductGrid"
            Grid.Row="2"
            gridCore:GridRowHeader.ShowRowNumber="True"
            AutomationProperties.Name="供应商产品管理列表"
            BeginningEdit="OnBeginningEdit"
            FontSize="{StaticResource SwiftExportDefaltFontSize}"
            FrozenColumnCount="4"
            IsEnabled="{Binding CanEditProducts}"
            IsReadOnly="{Binding IsGridReadOnly}"
            ItemsSource="{Binding Products.Items}"
            RowHeight="{StaticResource DataGridRowHeightMedium}"
            RowStyle="{StaticResource SwiftExportStateDataGridRow}"
            SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
            SelectionMode="Extended"
            SelectionUnit="{Binding IsCellSelectionMode, Mode=TwoWay, Converter={StaticResource GridSelectionUnitConverter}}"
            Style="{StaticResource SwiftExportDataGrid}">
            <i:Interaction.Behaviors>
                <fill:DataGridFillDownBehavior Command="{Binding FillDownCommand}" />
                <fill:DataGridColumnVisibilityBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.ContextMenu>
                <ContextMenu AutomationProperties.Name="供应商产品批量勾选" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem
                        Command="{Binding CheckSelectionCommand}"
                        Header="勾选(选区)"
                        Style="{StaticResource SelectionMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="CheckmarkSquare24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding UncheckSelectionCommand}"
                        Header="取消勾选(选区)"
                        Style="{StaticResource SelectionMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Square24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding InvertSelectionCommand}"
                        Header="反选(选区)"
                        Style="{StaticResource SelectionMenuItem}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding CheckVisibleCommand}" Header="全选(当前页)">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="SelectAllOn24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding InvertVisibleCommand}" Header="反选(当前页)">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="SelectAllOff24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding DeleteSelectedCommand}" Header="删除">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Header="表格模式"
                        IsChecked="{Binding IsCellSelectionMode, Mode=TwoWay}"
                        Style="{StaticResource ToggleMenuItemStyle}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Table24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>

                <DataGridTemplateColumn
                    Width="45"
                    CanUserSort="False"
                    ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                    HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="勾选当前页供应商产品"
                                Command="{Binding DataContext.SetVisibleChecksCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                IsChecked="{Binding DataContext.IsAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="56"
                    Header="图片"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage
                                Width="54"
                                Height="54"
                                DecodePixelWidth="96"
                                SourcePath="{Binding MainImage}"
                                Stretch="Uniform"
                                Style="{StaticResource SwiftExportCachedImage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="62"
                    Binding="{Binding IsProductDefaultSupplier, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToChineseConverter}}"
                    ElementStyle="{StaticResource SwiftExportDataGridDateTextBlock}"
                    Header="默认"
                    IsReadOnly="True" />


                <DataGridTemplateColumn
                    Width="150"
                    ClipboardContentBinding="{Binding ProductSku, Mode=OneWay}"
                    Header="标准 SKU"
                    SortMemberPath="ProductSku">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding ProductSku}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <productComponents:ProductLookupTextBox
                                FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                                IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                                SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionClearedCommandParameter="{Binding}"
                                SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectionCommittedCommandParameter="{Binding}"
                                Text="{Binding ProductSku, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn
                    Width="150"
                    fill:DataGridFillDownBehavior.Field="SupplierSku"
                    Binding="{Binding SupplierSku, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                    Header="供应商料号" />

                <DataGridTextColumn
                    Width="200"
                    fill:DataGridFillDownBehavior.Field="SupplierSkuDescriptionZh"
                    Binding="{Binding SupplierSkuDescriptionZh, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="供应商中文描述" />

                <DataGridTextColumn
                    Width="200"
                    fill:DataGridFillDownBehavior.Field="SupplierSkuFeaturesZh"
                    Binding="{Binding SupplierSkuFeaturesZh, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="供应商中文规格" />

                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding Currency}"
                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                    Header="币种"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    Width="95"
                    fill:DataGridFillDownBehavior.Field="UnitPrice"
                    Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="未税价" />

                <DataGridTextColumn
                    Width="95"
                    fill:DataGridFillDownBehavior.Field="TaxPrice"
                    Binding="{Binding TaxPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="含税价" />

                <DataGridTextColumn
                    Width="75"
                    Binding="{Binding TaxRate, StringFormat=P0}"
                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                    Header="税率"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding LinkSku}"
                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                    Header="Link SKU"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding DescriptionZh}"
                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                    Header="标准中文描述"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding CategoryName}"
                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}"
                    Header="分类"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,Auto,Auto"
            IsEnabled="{Binding CanEditProducts}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlock}"
                Text="{Binding StatusText}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0"
                VerticalAlignment="Center"
                Text="{Binding PageStatus}" />
            <controls:PageNavigator
                Grid.Column="2"
                PageChangeCommand="{Binding PageChangeCommand}"
                PageSize="{Binding PageSize}"
                TotalCount="{Binding TotalCount}"
                PageIndex="{Binding PageIndex}" />
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource UserCardBackgroundFillColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="请选择供应商后维护供应商产品。" />
        </Border>
    </Grid>
</UserControl>
