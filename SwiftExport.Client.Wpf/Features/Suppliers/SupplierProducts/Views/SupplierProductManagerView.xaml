<UserControl x:Class="SwiftExportClient.Features.Suppliers.SupplierProducts.Views.SupplierProductManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:productComponents="clr-namespace:SwiftExportClient.Features.Products.Components"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" />
            <RowDefinition Height="4" /><RowDefinition Height="*" /><RowDefinition Height="4" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:LookupTextBox Placeholder="供应商料号、SKU、描述或规格" MinimumSearchLength="0"
                                    Text="{Binding Keyword, Mode=TwoWay}" QueryCommand="{Binding SearchCommand}" />
            <Button Grid.Column="2" Width="36" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" ToolTip="查询"><ui:SymbolIcon Symbol="Search24" /></Button>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddItemCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Content="新增" />
                <Button Command="{Binding SaveCommand}" Margin="0,0,4,0" Content="保存" />
                <Button Command="{Binding DeleteSelectedCommand}" Margin="0,0,4,0" Content="删除" />
                <Button Command="{Binding RejectCommand}" Margin="0,0,4,0" Content="放弃" />
                <Button Command="{Binding RefreshCommand}" Content="刷新" />
            </StackPanel>
            <Button Grid.Column="5" Command="{Binding CloseCommand}" Content="关闭" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
        <DataGrid Grid.Row="4" ItemsSource="{Binding Products.Items}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  Style="{StaticResource SwiftExportDataGrid}" RowStyle="{StaticResource SwiftExportStateDataGridRow}"
                  SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="4" RowHeight="48"
                  gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True"
                  gridCore:GridRowHeader.ShowRowNumber="True" gridOperations:GridOperations.IsEnabled="True"
                  gridValidation:GridValidation.IsEnabled="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="43" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox HorizontalAlignment="Left" IsChecked="{Binding DataContext.Products.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Margin="4,0" HorizontalAlignment="Left" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="图片" Width="56" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><controls:CachedImage Width="40" Height="40" Style="{StaticResource SwiftExportCachedImage}" DecodePixelWidth="96" SourcePath="{Binding MainImage}" Stretch="Uniform" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="标准 SKU" Width="150" SortMemberPath="ProductSku">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProductSku}" Style="{StaticResource SwiftExportDataGridTextBlock}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                        <productComponents:ProductLookupTextBox
                            Text="{Binding ProductSku, Mode=OneWay}"
                            ItemsSource="{Binding DataContext.ProductCandidates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectedProduct="{Binding DataContext.SelectedCandidate, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWayToSource}"
                            SearchCommand="{Binding DataContext.SearchProductsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionCommittedCommand="{Binding DataContext.CommitProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionCommittedCommandParameter="{Binding}"
                            SelectionClearedCommand="{Binding DataContext.ClearProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectionClearedCommandParameter="{Binding}"
                            IsBusy="{Binding DataContext.IsLookupBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="供应商料号" Width="150" Binding="{Binding SupplierSku, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" />
                <DataGridTextColumn Header="供应商中文描述" Width="200" Binding="{Binding SupplierSkuDescriptionZh, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                <DataGridTextColumn Header="供应商中文规格" Width="200" Binding="{Binding SupplierSkuFeaturesZh, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" />
                <DataGridTextColumn Header="币种" Width="70" IsReadOnly="True" Binding="{Binding Currency}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
                <DataGridTextColumn Header="未税价" Width="95" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="含税价" Width="95" Binding="{Binding TaxPrice, UpdateSourceTrigger=LostFocus, StringFormat=N2}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="税率" Width="75" IsReadOnly="True" Binding="{Binding TaxRate, StringFormat=P0}" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" />
                <DataGridTextColumn Header="Link SKU" Width="120" IsReadOnly="True" Binding="{Binding LinkSku}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
                <DataGridTextColumn Header="标准中文描述" Width="180" IsReadOnly="True" Binding="{Binding DescriptionZh}" ElementStyle="{StaticResource SwiftExportDataGridLongTextBlock}" />
                <DataGridTextColumn Header="分类" Width="120" IsReadOnly="True" Binding="{Binding CategoryName}" ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageStatus}" Style="{StaticResource CaptionTextBlock}" Margin="16,0" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="2" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
