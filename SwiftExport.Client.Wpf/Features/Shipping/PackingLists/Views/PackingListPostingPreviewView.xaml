<UserControl x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListPostingPreviewView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12" MinWidth="800" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding BusinessDate, StringFormat=库存业务日期：{0:yyyy-MM-dd}}" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Actions}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="图片" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}" Width="48" Height="48"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="动作" Binding="{Binding ActionKind}"/>
                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku}"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=0.####}"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}"/>
                <DataGridTextColumn Header="仓库" Binding="{Binding WarehouseName}"/>
                <DataGridTextColumn Header="采购单" Binding="{Binding PurchaseOrderNo}"/>
                <DataGridTextColumn Header="采购行" Binding="{Binding PurchaseLineNumber}"/>
                <DataGridTextColumn Header="根需求量" Binding="{Binding RootQty}"/>
                <DataGridTextColumn Header="子需求量" Binding="{Binding ComponentQty}"/>
                <DataGridTextColumn Header="本次来源出货" Binding="{Binding ShippedQty}"/>
                <DataGridTextColumn Header="说明" Binding="{Binding Explanation}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Blockers}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="错误码" Binding="{Binding Code}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding GrossDemandId}"/>
                <DataGridTextColumn Header="缺口" Binding="{Binding ShortfallQty}"/>
                <DataGridTextColumn Header="阻断原因" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
