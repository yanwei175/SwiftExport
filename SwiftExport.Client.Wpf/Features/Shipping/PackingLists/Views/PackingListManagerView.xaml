<UserControl
    x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:local="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.Views"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.ViewModels"
    d:DataContext="{d:DesignInstance vm:PackingListManagerViewModel}"
    d:DesignHeight="850"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="箱单管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    AutomationProperties.Name="箱单搜索关键词"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="搜索箱单号、发票号、客户、SKU"
                    Text="{Binding Search.Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,3*,8,8*,Auto">
            <!--  单头操作区域  -->
            <Grid ColumnDefinitions="80,8,Auto,8,*">
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlock}"
                    Text="筛选条件:" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="过账:" />

                    <lookup:MultiSelectLookupButton
                        x:Name="PostingStatusesFilter"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="过账状态筛选"
                        Header="过账状态"
                        ItemsSource="{x:Static staticEnums:PackingListPostingStatusList.All}"
                        Placeholder="搜索过账状态"
                        SelectedItems="{Binding Search.PostingStatuses, Mode=OneWay}"
                        SelectionCommittedCommand="{Binding SearchCommand}">
                        <lookup:MultiSelectLookupButton.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </lookup:MultiSelectLookupButton.ItemTemplate>
                    </lookup:MultiSelectLookupButton>

                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="客户:" />
                    <lookup:MultiSelectLookupButton
                        x:Name="CustomersFilter"
                        Width="120"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="客户筛选"
                        DisplayMemberPath="CustomerCode"
                        FilterMemberPaths="CustomerCode,CustomerName"
                        Header="客户"
                        ItemsSource="{Binding Customers}"
                        Placeholder="搜索客户编码或名称"
                        SelectedItems="{Binding Search.SelectedCustomers, Mode=OneWay}"
                        SelectedValuePath="Uid"
                        SelectionCommittedCommand="{Binding SearchCommand}" />
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="单据日期起:" />
                    <DatePicker
                        Width="120"
                        Margin="0,0,8,0"
                        SelectedDate="{Binding Search.InvoiceDateFrom}"
                        SelectedDateFormat="Short"
                        ToolTip="单据日期起" />
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="单据日期至:" />
                    <DatePicker
                        Width="120"
                        Margin="0,0,8,0"
                        SelectedDate="{Binding Search.InvoiceDateTo}"
                        SelectedDateFormat="Short"
                        ToolTip="单据日期至" />

                </StackPanel>

                <StackPanel
                    Grid.Column="4"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding IsNotBusy}"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding AddNewCommand}"
                        Content="新增" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding EditCommand}"
                        Content="编辑" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding DeleteCommand}"
                        Content="删除" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding PostCommand}"
                        Content="过账"
                        ToolTip="待开发" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Appearance="Danger"
                        Command="{Binding ReverseCommand}"
                        Content="反过账"
                        ToolTip="待开发" />
                </StackPanel>
            </Grid>

            <!--  单头  -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <DataGrid
                    x:Name="HeaderGrid"
                    Grid.Row="0"
                    gridCore:GridRowHeader.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Headers.Items}"
                    RowHeight="{DynamicResource DataGridRowHeightSmall}"
                    SelectedItem="{Binding SelectedHeader}"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding PackingListNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="箱单号" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding CustomerNameSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding InvoiceDate, StringFormat=d}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单据日期" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding InvoiceNosSummary}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="发票号" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding PostingStatus, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="过账状态" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding ContainerNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="柜号" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding SealNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="封条号" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Etd, StringFormat=d}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="ETD" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Eta, StringFormat=d}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="ETA" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    ColumnDefinitions="*,12,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding PageStatus}" />
                    <controls:PageNavigator
                        Grid.Column="2"
                        PageChangeCommand="{Binding PageChangeCommand}"
                        PageSize="{Binding Search.PageSize, Mode=OneWay}"
                        PageSizeOptions="{Binding PageSizeOptions}"
                        TotalCount="{Binding TotalCount}"
                        PageIndex="{Binding Search.PageIndex, Mode=OneWay}" />
                </Grid>
            </Grid>


            <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}" />

            <Grid Grid.Row="4" RowDefinitions="Auto,8,*">
                <!--  汇总  -->
                <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlock}"
                        Text="汇总信息:" />
                    <TextBlock Grid.Column="2" Text="数量:" />
                    <TextBlock Grid.Column="4" Text="{Binding Lines.QtySummary, Mode=OneWay}" />

                    <TextBlock Grid.Column="6" Text="总净重:" />
                    <TextBlock Grid.Column="8" Text="{Binding Lines.NetWeightSummary, Mode=OneWay}" />

                    <TextBlock Grid.Column="10" Text="总毛重:" />
                    <TextBlock Grid.Column="12" Text="{Binding Lines.GrossWeightSummary, Mode=OneWay}" />

                    <TextBlock Grid.Column="14" Text="总箱数:" />
                    <TextBlock Grid.Column="16" Text="{Binding Lines.CartonSummary, Mode=OneWay}" />

                    <TextBlock Grid.Column="18" Text="总体积:" />
                    <TextBlock Grid.Column="20" Text="{Binding Lines.CbmSummary, Mode=OneWay}" />

                </Grid>

                <!--  单行  -->
                <DataGrid
                    x:Name="LineGrid"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    CurrentItem="{Binding Lines.SelectedItem, Mode=TwoWay}"
                    FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Lines.Items}"
                    RowHeight="{StaticResource DataGridRowHeightMedium}"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding PackingGroupId}"
                            Header="拼箱归属"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="40"
                            Binding="{Binding LineNumber}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="行号"
                            IsReadOnly="True" />

                        <DataGridTemplateColumn
                            Width="64"
                            CanUserSort="False"
                            Header="图片">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage
                                        Width="48"
                                        Height="48"
                                        Margin="2"
                                        DecodePixelWidth="96"
                                        SourcePath="{Binding ImagePath}"
                                        Stretch="Uniform"
                                        Style="{StaticResource SwiftExportCachedImage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding SkuSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="SKU" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding LinkSkuSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="Link SKU" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding CustomerSkuSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户SKU" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding DescriptionEnSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="英文描述" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding ColorNameEnSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="英文颜色" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Qty, StringFormat=N0}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="数量" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding PcsPerPackage, StringFormat=N0}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="每箱数量" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding PackageCount, StringFormat=N1}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="箱数" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding SubTotalNw, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="净重小计" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding SubTotalGw, StringFormat=N2}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="毛重小计" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding SubTotalCbm, StringFormat=N3}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="体积小计" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding CustomerPoNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="客户PO" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding InvoiceNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="发票号" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding UnitSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单位" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


            <!--  提示信息  -->
            <StackPanel Grid.Row="5">
                <TextBlock Foreground="{DynamicResource UserBusinessTextWarningBrush}" Text="{Binding ValidationSummary}" />
                <TextBlock Foreground="{DynamicResource UserSystemFillColorCautionBrush}" Text="{Binding ResultSummary}" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
