<UserControl x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:local="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.Views"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PackingListManagerViewModel}"
             d:DesignHeight="850" d:DesignWidth="1400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="箱单管理" 
                          Style="{StaticResource SubtitleTextBlock}"
                          VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                           Text="{Binding Search.Keyword,UpdateSourceTrigger=PropertyChanged}"
                           Icon="{ui:SymbolIcon Symbol=Search24}"
                           AutomationProperties.Name="箱单搜索关键词"
                           PlaceholderText="搜索箱单号、发票号、客户、SKU">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch" 
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>

                    <ui:Button Content="清空" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0"
                               VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,3*,8,8*,Auto">
            <!--单头操作区域-->
            <Grid ColumnDefinitions="80,8,Auto,8,*">
                <TextBlock Grid.Column="0" Text="筛选条件:"
                           Style="{StaticResource BodyStrongTextBlock}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <TextBlock Text="过账:" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ComboBox  MinWidth="120" Margin="0,0,8,0"
                              ItemsSource="{x:Static staticEnums:PackingListPostingStatusList.All}"
                              SelectedItem="{Binding Search.PostingStatus, Mode=TwoWay}"
                              AutomationProperties.Name="过账状态筛选"
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="客户:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="120" Margin="0,0,8,0"
                              ItemsSource="{Binding Customers}" 
                              DisplayMemberPath="CustomerCode" 
                              SelectedValuePath="Uid"
                              SelectedValue="{Binding Search.CustomerId, Mode=TwoWay}"/>

                    <DatePicker SelectedDate="{Binding Search.InvoiceDateFrom}" Width="120" Margin="0,0,8,0"
                                controls:DatePickerAssist.PlaceholderText="单据日期起"
                                Style="{StaticResource SwiftExportDatePicker}"/>

                    <DatePicker SelectedDate="{Binding Search.InvoiceDateTo}" Width="120" Margin="0,0,8,0" 
                                controls:DatePickerAssist.PlaceholderText="单据日期至"
                                Style="{StaticResource SwiftExportDatePicker}"/>

                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" IsEnabled="{Binding IsNotBusy}">
                    <ui:Button Content="新增" MinWidth="70"  Margin="0,0,6,0" Command="{Binding AddNewCommand}" VerticalAlignment="Stretch"/>
                    <ui:Button Content="编辑" MinWidth="70"   Margin="0,0,6,0" Command="{Binding EditCommand}" VerticalAlignment="Stretch"/>
                    <ui:Button Content="删除" MinWidth="70"   Margin="0,0,6,0"  Command="{Binding DeleteCommand}" VerticalAlignment="Stretch"/>
                    <ui:Button Content="过账" MinWidth="70" Margin="0,0,6,0" Command="{Binding PostCommand}" ToolTip="待开发" Appearance="Primary" VerticalAlignment="Stretch"/>
                    <ui:Button Content="反过账" MinWidth="70" Margin="0,0,6,0" Command="{Binding ReverseCommand}" ToolTip="待开发" Appearance="Danger" VerticalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <!--单头-->
            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <DataGrid x:Name="HeaderGrid" Grid.Row="0"
                          IsEnabled="{Binding IsNotBusy}"
                          Style="{StaticResource SwiftExportDataGrid}"
                          FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                          RowHeight="{DynamicResource DataGridRowHeightSmall}"
                          ItemsSource="{Binding Headers.Items}" 
                          IsReadOnly="True"
                          SelectedItem="{Binding SelectedHeader}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="箱单号" Binding="{Binding PackingListNo}" Width="150"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="客户" Binding="{Binding CustomerNameSnapshot}" Width="180"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="单据日期" Binding="{Binding InvoiceDate, StringFormat=d}" Width="110"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="发票号" Binding="{Binding InvoiceNosSummary}" Width="180"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="过账状态" Binding="{Binding PostingStatus, Converter={StaticResource EnumDescriptionConverter}}" Width="100"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="柜号" Binding="{Binding ContainerNo}" Width="130"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="封条号" Binding="{Binding SealNo}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="ETD" Binding="{Binding Etd, StringFormat=d}" Width="110"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                            Header="ETA" Binding="{Binding Eta, StringFormat=d}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,12,Auto">
                    <TextBlock Grid.Column="0" 
                               Text="{Binding PageStatus}" 
                               Style="{StaticResource CaptionTextBlock}"/>
                    <controls:PageNavigator Grid.Column="2" 
                                            TotalCount="{Binding TotalCount}"
                                            PageIndex="{Binding Search.PageIndex, Mode=OneWay}"
                                            PageSize="{Binding Search.PageSize, Mode=OneWay}"
                                            PageSizeOptions="{Binding PageSizeOptions}"
                                            PageChangeCommand="{Binding PageChangeCommand}"/>
                </Grid>
            </Grid>


            <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}"/>

            <Grid Grid.Row="4" RowDefinitions="Auto,8,*">
                <!--汇总-->
                <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80">
                    <TextBlock Text="汇总信息:" 
                               Style="{StaticResource BodyStrongTextBlock}"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="数量:"/>
                    <TextBlock Grid.Column="4" Text="{Binding Lines.QtySummary,Mode=OneWay}"/>

                    <TextBlock Grid.Column="6" Text="总净重:"/>
                    <TextBlock Grid.Column="8" Text="{Binding Lines.NetWeightSummary,Mode=OneWay}"/>

                    <TextBlock Grid.Column="10" Text="总毛重:"/>
                    <TextBlock Grid.Column="12" Text="{Binding Lines.GrossWeightSummary,Mode=OneWay}"/>

                    <TextBlock Grid.Column="14" Text="总箱数:"/>
                    <TextBlock Grid.Column="16" Text="{Binding Lines.CartonSummary,Mode=OneWay}"/>

                    <TextBlock Grid.Column="18" Text="总体积:"/>
                    <TextBlock Grid.Column="20" Text="{Binding Lines.CbmSummary,Mode=OneWay}"/>

                </Grid>

                <!--单行-->
                <DataGrid x:Name="LineGrid" Grid.Row="2"
                          IsReadOnly="True"
                          ItemsSource="{Binding Lines.Items}" 
                          SelectedItem="{Binding Lines.SelectedItem}" 
                          Style="{StaticResource SwiftExportDataGrid}"
                          FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                          RowHeight="{StaticResource DataGridRowHeightMedium}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridVirtualization.IsEnabled="True"
                          gridOperations:GridOperations.IsEnabled="False"
                          gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                          gridSelection:GridSelection.CurrentRow="{Binding Lines.SelectedItem,Mode=TwoWay}"
                          gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="行号" 
                                            Binding="{Binding LineNumber}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            IsReadOnly="True" Width="40"/>

                        <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage Width="48" Height="48" Margin="2"
                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                  Stretch="Uniform" DecodePixelWidth="96"
                                                  SourcePath="{Binding ImagePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="SKU" Binding="{Binding SkuSnapshot}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="Link SKU" Binding="{Binding LinkSkuSnapshot}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客户SKU" Binding="{Binding CustomerSkuSnapshot}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="英文描述" Binding="{Binding DescriptionEnSnapshot}" Width="200"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="英文颜色" Binding="{Binding ColorNameEnSnapshot}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="数量" Binding="{Binding Qty,StringFormat=N0}" Width="70"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="每箱数量" Binding="{Binding PcsPerPackage,StringFormat=N0}" Width="70"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="箱数" Binding="{Binding PackageCount,StringFormat=N1}" Width="90"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="净重小计" Binding="{Binding SubTotalNw,StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="毛重小计" Binding="{Binding SubTotalGw,StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" Header="体积小计" Binding="{Binding SubTotalCbm,StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="客户PO" Binding="{Binding CustomerPoNo}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="发票号" Binding="{Binding InvoiceNo}" Width="120"/>
                        <DataGridTextColumn ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" Header="单位" Binding="{Binding UnitSnapshot}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


            <!--提示信息-->
            <StackPanel Grid.Row="5">
                <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource SwiftExportBrush.ErrorText}"/>
                <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource SwiftExportBrush.WarningText}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
