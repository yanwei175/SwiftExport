<UserControl x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListSourcePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400" Language="zh-CN">

    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,*,8,Auto,8,Auto">
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="出货来源" 
                          Style="{StaticResource SubtitleTextBlock}"
                          VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                           Text="{Binding Search.Keyword,UpdateSourceTrigger=PropertyChanged}"
                           Icon="{ui:SymbolIcon Symbol=Search24}"
                           PlaceholderText="待交付来源关键词">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ui:Button Content="查询" Appearance="Primary" MinWidth="70"
                    Command="{Binding SearchCommand}" Margin="8,0"/>
            <ui:Button Content="清空勾选" Command="{Binding ClearSelectionCommand}"/>
        </StackPanel>
        
        <DataGrid x:Name="CandidatesGrid" Grid.Row="4" 
                  ItemsSource="{Binding Items}" 
                  GridLinesVisibility="Horizontal"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  IsReadOnly="True" 
                  EnableRowVirtualization="True" 
                  EnableColumnVirtualization="True"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" 
                  AutomationProperties.Name="待交付来源列表">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="选入来源"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="图片" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="56" Height="56" SourcePath="{Binding ImagePath}" DecodePixelWidth="96" Stretch="Uniform" Style="{StaticResource SwiftExportCachedImage}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="140"/>
                <DataGridTextColumn Header="来源类型" Binding="{Binding SourceType}" Width="90"/>
                <DataGridCheckBoxColumn Header="非标" Binding="{Binding IsNonStandard}" Width="56"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding SkuSnapshot}" Width="130"/>
                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSkuSnapshot}" Width="130"/>
                <DataGridTextColumn Header="产品型号" Binding="{Binding LinkSkuSnapshot}" Width="130"/>
                <DataGridTextColumn Header="英文描述" Binding="{Binding DescriptionEnSnapshot}" Width="180"/>
                <DataGridTextColumn Header="颜色" Binding="{Binding ColorNameEnSnapshot}" Width="90"/>
                <DataGridTextColumn Header="单位" Binding="{Binding UnitSnapshot}" Width="70"/>
                <DataGridTextColumn Header="来源数量" Binding="{Binding DemandQty}" Width="90"/>
                <DataGridTextColumn Header="关联来源已交付" Binding="{Binding DeliveredQty, TargetNullValue=未知}" Width="120"/>
                <DataGridTextColumn Header="关联来源待交付" Binding="{Binding RemainingQty, TargetNullValue=未知}" Width="120"/>
                <DataGridTemplateColumn Header="本次数量" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding SelectedQty, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="本次选入数量"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="不可用原因" Binding="{Binding DeliveryUnavailableReason}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <controls:PageNavigator Grid.Row="6" 
                                TotalCount="{Binding TotalCount}" 
                                PageIndex="{Binding Search.PageIndex, Mode=OneWay}"
                                PageSize="{Binding Search.PageSize, Mode=OneWay}" 
                                PageSizeOptions="{Binding PageSizeOptions}"
                                PageChangeCommand="{Binding PageChangeCommand}"/>
        <TextBlock Grid.Row="8" Text="{Binding StatusText}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
