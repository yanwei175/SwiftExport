<UserControl x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid">
    <Grid Margin="12" RowDefinitions="Auto,8,2*,8,*,Auto">
        <Grid ColumnDefinitions="280,8,Auto,8,Auto,8,Auto,*">
            <TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="PackingList、Invoice、客户、销售单、供应商或 SKU"/>
            <Button Grid.Column="2" Content="查询" Command="{Binding SearchCommand}" />
            <Button Grid.Column="4" Content="打开详情" Command="{Binding OpenDetailCommand}"/>
            <Button Grid.Column="6" Content="加载可发货来源" Command="{Binding LoadSourcesCommand}"/>
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}" gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PackingList" Binding="{Binding PackingListNo}" Width="150"/>
                <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="180"/>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="140"/>
                <DataGridTextColumn Header="发货日期" Binding="{Binding ShipmentDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                <DataGridTextColumn Header="状态" Binding="{Binding PostingStatus}" Width="90"/>
                <DataGridTextColumn Header="来源行" Binding="{Binding LineCount}" Width="75"/>
                <DataGridTextColumn Header="数量" Binding="{Binding TotalQuantity,StringFormat=N4}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" RowDefinitions="Auto,4,*">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="可发货 Allocation 来源" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="用所选来源新建草稿" Command="{Binding CreateDraftCommand}" Margin="12,0,0,0"/>
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}" gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="160"/>
                    <DataGridTextColumn Header="销售单" Binding="{Binding SalesOrderNo}" Width="140"/>
                    <DataGridTextColumn Header="销售行" Binding="{Binding SalesOrderLineNumber}" Width="70"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                    <DataGridTextColumn Header="可发货" Binding="{Binding ShippableRemainingQty,StringFormat=N4}" Width="100"/>
                    <DataGridTextColumn Header="来源入库" Binding="{Binding SourceInboundNetQty,StringFormat=N4}" Width="100"/>
                    <DataGridTextColumn Header="供应商" Binding="{Binding SourceSupplierName}" Width="160"/>
                    <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock Grid.Row="5" Text="{Binding Summary}" Foreground="Gray"/>
    </Grid>
</UserControl>
