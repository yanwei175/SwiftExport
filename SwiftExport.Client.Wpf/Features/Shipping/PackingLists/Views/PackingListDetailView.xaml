<UserControl
    x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:customerComponents="clr-namespace:SwiftExportClient.Features.Customers.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rowDrag="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.ViewModels"
    d:DataContext="{d:DesignInstance vm:PackingListDetailViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,6*,8,Auto">
        <!--  Title  -->
        <Grid ColumnDefinitions="Auto,8,*,8,Auto">
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Grid.Column="0"
                    MinWidth="70"
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="保存箱单" />

                <ui:Button
                    MinWidth="70"
                    Margin="8,0,0,0"
                    Command="{Binding UndoCommand}"
                    Content="撤销" />
                <ui:Button
                    MinWidth="70"
                    Margin="8,0,0,0"
                    Command="{Binding ReloadCommand}"
                    Content="重新加载" />
                <ui:Button
                    MinWidth="70"
                    Margin="8,0,0,0"
                    Command="{Binding PostCommand}"
                    Content="过账" />
                <ui:Button
                    MinWidth="70"
                    Margin="8,0,0,0"
                    Command="{Binding ReverseCommand}"
                    Content="反过账" />
                <ui:Button
                    MinWidth="70"
                    Margin="8,0,0,0"
                    Command="{Binding TraceCommand}"
                    Content="执行追踪" />
            </StackPanel>

            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="10"
                HorizontalAlignment="Center"
                IsHitTestVisible="False"
                Style="{DynamicResource TitleTextBlock}"
                Text="PackingList" />

            <ui:Button
                Grid.Column="4"
                MinWidth="70"
                Appearance="Primary"
                Command="{Binding CloseCommand}"
                Content="关闭页签" />
        </Grid>

        <!--  Header  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="35" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="客户代码:" />
                <customerComponents:CustomerAutoSuggestComboBox
                    Grid.Column="2"
                    IsEnabled="{Binding CanEditFacts}"
                    ItemsSource="{Binding Customers}"
                    SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="系统箱单号:" />
                <ui:TextBox
                    Grid.Column="6"
                    IsReadOnly="True"
                    Text="{Binding Header.PackingListNo, Mode=OneWay}"
                    ToolTip="新订单保存时由服务端生成" />

                <TextBlock
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    Text="创建日期:" />
                <ui:TextBox
                    Grid.Column="10"
                    IsReadOnly="True"
                    Text="{Binding Header.CreatedDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" />


                <TextBlock
                    Grid.Column="12"
                    VerticalAlignment="Center"
                    Text="状态:" />
                <ui:TextBox
                    Grid.Column="14"
                    IsReadOnly="True"
                    Text="{Binding Header.LifecycleStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}" />

                <TextBlock
                    Grid.Column="16"
                    VerticalAlignment="Center"
                    Text="过账:" />
                <ui:TextBox
                    Grid.Column="18"
                    IsReadOnly="True"
                    Text="{Binding Header.PostingStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}" />

            </Grid>

            <Border
                Grid.Row="2"
                Padding="8"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                IsEnabled="{Binding IsEditable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Ship-To" />

                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        PlaceholderText="客户联系人..."
                        Text="{Binding Header.CustomerNameSnapshot, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:TextBox
                        Grid.Row="4"
                        Grid.RowSpan="3"
                        Grid.ColumnSpan="3"
                        PlaceholderText="客户地址..."
                        Text="{Binding Header.CustomerAddressSnapshot, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />


                    <TextBlock
                        Grid.Row="8"
                        VerticalAlignment="Top"
                        Text="Attention: :" />
                    <ui:TextBox
                        Grid.Row="8"
                        Grid.Column="2"
                        PlaceholderText="备注"
                        Text="{Binding Header.AttentionSnapshot, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Text="InvoiceNo" />
                    <ui:TextBox
                        Grid.Row="0"
                        Grid.Column="6"
                        Grid.ColumnSpan="8"
                        IsReadOnly="True"
                        PlaceholderText="发票号汇总"
                        Text="{Binding Header.InvoiceNosSummary, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Text="InvoiceDate:" />
                    <DatePicker
                        Grid.Row="2"
                        Grid.Column="6"
                        SelectedDate="{Binding Header.InvoiceDate, Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        ToolTip="发票日期" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Text="Container:" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="6"
                        Grid.ColumnSpan="8"
                        PlaceholderText="集装箱号"
                        Text="{Binding Header.ContainerNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Text="Seal:" />
                    <ui:TextBox
                        Grid.Row="6"
                        Grid.Column="6"
                        Grid.ColumnSpan="8"
                        PlaceholderText="铅封号"
                        Text="{Binding Header.SealNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="8"
                        VerticalAlignment="Center"
                        Text="出货地点:" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="10"
                        Grid.ColumnSpan="4"
                        MaxLength="200"
                        Text="{Binding Header.ShippingLocationSnapshot, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Text="ETD:" />
                    <DatePicker
                        Grid.Row="8"
                        Grid.Column="6"
                        SelectedDate="{Binding Header.Etd, Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        ToolTip="ETD" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="8"
                        VerticalAlignment="Center"
                        Text="ETA:" />
                    <DatePicker
                        Grid.Row="8"
                        Grid.Column="10"
                        SelectedDate="{Binding Header.Eta, Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        ToolTip="ETA" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}" />

        <!--  LineDataGrid  -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,3*,8,2*,8,Auto">
            <TextBlock
                Grid.Row="1"
                Margin="0,4,0,4"
                Style="{StaticResource BodyStrongTextBlock}"
                Text="包装明细 · 多选普通产品后右键拼箱；拖动手柄排序" />
            <!--  汇总  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80">
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding AssociateSourcesCommand}"
                        Content="关联来源 / 重试" />
                    <ui:Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SelectSourcesCommand}"
                        Content="获取" />
                    <ui:Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding DeletePackageProductCommand}"
                        Content="删除行" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="总数量:" />
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="{Binding Lines.QtySummary, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Text="总净重:" />
                <TextBlock
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    Text="{Binding Lines.NetWeightSummary, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="10"
                    VerticalAlignment="Center"
                    Text="总毛重:" />
                <TextBlock
                    Grid.Column="12"
                    VerticalAlignment="Center"
                    Text="{Binding Lines.GrossWeightSummary, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="14"
                    VerticalAlignment="Center"
                    Text="总箱数:" />
                <TextBlock
                    Grid.Column="16"
                    VerticalAlignment="Center"
                    Text="{Binding Lines.CartonSummary, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="18"
                    VerticalAlignment="Center"
                    Text="总体积:" />
                <TextBlock
                    Grid.Column="20"
                    VerticalAlignment="Center"
                    Text="{Binding Lines.CbmSummary, Mode=OneWay}" />

            </Grid>

            <DataGrid
                x:Name="OrderLinesGrid"
                Grid.Row="2"
                rowDrag:RowDragReorder.IsEnabled="{Binding CanReorderPackages}"
                rowDrag:RowDragReorder.MoveCommand="{Binding ReorderPackageCommand}"
                AutoGenerateColumns="False"
                AutomationProperties.Name="包装明细"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                FontSize="{StaticResource SwiftExportDefaltFontSize}"
                IsEnabled="{Binding CanInteractWithLines}"
                IsReadOnly="{Binding IsReadOnly, FallbackValue=True}"
                ItemsSource="{Binding Lines.PackageView}"
                PreviewMouseRightButtonDown="OnGridRightClick"
                RowHeight="{StaticResource DataGridRowHeightMedium}"
                SelectedItem="{Binding SelectedPackage, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                SelectionChanged="OnPackageSelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource SwiftExportDataGrid}"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding PackProductsCommand}" Header="选中产品新建拼箱" />
                        <MenuItem Header="选中产品加入已有拼箱" ItemsSource="{Binding Lines.PackingGroups}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Title}" />
                                    <Setter Property="Command" Value="{Binding DataContext.PackProductsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem
                            Command="{Binding SplitTailCommand}"
                            CommandParameter="{Binding SelectedPackage.Product}"
                            Header="拆尾箱" />
                        <Separator />
                        <MenuItem Command="{Binding DissolvePackageCommand}" Header="解散拼箱 / 删除空箱" />
                        <MenuItem Command="{Binding DeletePackageProductCommand}" Header="删除普通产品行" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Title}"
                        Header="包装"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn
                        Width="48"
                        CanUserSort="False"
                        Header="排序"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    rowDrag:RowDragReorder.IsHandle="True"
                                    AutomationProperties.Name="拖动调整行顺序"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    FontSize="20"
                                    IsEnabled="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Text="≡"
                                    TextAlignment="Center"
                                    ToolTip="拖动调整顺序；Alt+↑ / Alt+↓ 移动当前行，保存后生效" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="40"
                        Header="拆箱"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SplitTailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding Product}"
                                    Icon="{ui:SymbolIcon Symbol=ArrowSplit24}"
                                    ToolTip="拆分尾数箱"
                                    ToolTipService.InitialShowDelay="150">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Product.CanSplitTail}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource UserBusinessBackgroundWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="40"
                        Binding="{Binding Product.LineNumber}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="序号"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="40"
                        Binding="{Binding Product.SourceTypeSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源"
                        IsReadOnly="True"
                        Visibility="Collapsed" />

                    <DataGridTextColumn
                        Width="85"
                        Binding="{Binding Product.AssociationStatus}"
                        Header="关联状态"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.SourceInvoiceNo}"
                        Header="来源 InvoiceNo"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Product.SourceDocumentNoSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="来源单号"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn
                        Width="60"
                        CanUserSort="False"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="56"
                                    Height="56"
                                    Margin="2"
                                    DecodePixelWidth="72"
                                    SourcePath="{Binding Product.ImagePath}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="88" Header="唛头">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Product.Marks}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Marks}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="拼箱唛头">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Product.Marks, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Marks, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.SkuSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="Sku"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.CustomerSkuSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="客户型号"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.LinkSkuSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="产品型号"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.DescriptionEnSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="描述"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.ColorNameEnSnapshot}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="颜色"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Product.Qty, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="数量" />

                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding Product.PcsPerPackage, UpdateSourceTrigger=LostFocus, StringFormat=N1}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="每箱数量" />

                    <DataGridTemplateColumn Width="88" Header="每箱净重">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Product.NwPerPackage, StringFormat=N2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding NetWeight, StringFormat=N2}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="拼箱每箱净重">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Product.NwPerPackage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding NetWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="88" Header="每箱毛重">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Product.GwPerPackage, StringFormat=N2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding GrossWeight, StringFormat=N2}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="拼箱每箱毛重">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Product.GwPerPackage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding GrossWeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="88" Header="每箱体积">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Product.CbmPerPackage, StringFormat=N3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Volume, StringFormat=N3}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="拼箱每箱体积">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Product.CbmPerPackage, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="60"
                        Header="箱数"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Product.PackageCount, StringFormat=N1}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMixed}" Value="True">
                                                    <Setter Property="Text" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Product.CanSplitTail}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Product.SubTotalNw, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="小计净重"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Product.SubTotalGw, StringFormat=N2}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="小计毛重"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Product.SubTotalCbm, StringFormat=N3}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="小计体积"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Product.CustomerPoNo, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="PoNo" />

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Product.InvoiceNo, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="InvoiceNo" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Product.Note, UpdateSourceTrigger=PropertyChanged}"
                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="SubNote" />



                    <DataGridTemplateColumn ClipboardContentBinding="{Binding Product.IsNonStandardSnapshot, Mode=OneWay}" Header="非标">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Focusable="False"
                                    IsChecked="{Binding Product.IsNonStandardSnapshot, Mode=OneWay}"
                                    IsHitTestVisible="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Row="3"
                AutomationProperties.Name="调整产品行与拼箱明细高度"
                Style="{StaticResource SwiftExportGridSplitterHorizontal}" />
            <Grid Grid.Row="4" RowDefinitions="Auto,*">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlock}" Text="{Binding SelectedPackingGroup.Title, TargetNullValue=选择上方拼箱查看箱内产品}" />
                    <TextBlock Margin="12,0,0,0" Text="箱内拖动手柄排序 · 右键移出或删除产品" />
                </DockPanel>
                <DataGrid
                    x:Name="PackingMembersGrid"
                    Grid.Row="1"
                    rowDrag:RowDragReorder.IsEnabled="{Binding CanReorderMembers}"
                    rowDrag:RowDragReorder.MoveCommand="{Binding ReorderMemberCommand}"
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="当前拼箱明细"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    IsEnabled="{Binding CanInteractWithLines}"
                    IsReadOnly="{Binding IsReadOnly, FallbackValue=True}"
                    ItemsSource="{Binding SelectedPackingGroup.Members}"
                    PreviewMouseRightButtonDown="OnGridRightClick"
                    RowHeight="{StaticResource DataGridRowHeightMedium}"
                    SelectedItem="{Binding SelectedPackingLine, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding MoveOutOfPackingGroupCommand}" Header="移出拼箱，保留产品" />
                            <MenuItem Command="{Binding DeletePackingMemberCommand}" Header="从箱单删除产品" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="48"
                            Header="排序"
                            IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        rowDrag:RowDragReorder.IsHandle="True"
                                        AutomationProperties.Name="拖动调整箱内顺序"
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        FontSize="20"
                                        Text="≡"
                                        TextAlignment="Center"
                                        ToolTip="拖动调整箱内顺序；Alt+↑ / Alt+↓" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="56"
                            Binding="{Binding LineNumber, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="序号"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding SkuSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="Sku"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding CustomerSkuSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="客户型号"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding LinkSkuSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="产品型号"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding DescriptionEnSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="描述"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="96"
                            Binding="{Binding ColorNameEnSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="颜色"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="88"
                            Binding="{Binding Qty, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="本箱数量"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="64"
                            Binding="{Binding UnitSnapshot, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="单位"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding InvoiceNo, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="InvoiceNo"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding CustomerPoNo, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="PoNo"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Note, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                            Header="备注"
                            IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="6" ColumnDefinitions="Auto,8,*">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Text="备注:" />
                <ui:TextBox
                    Grid.Column="2"
                    Height="60"
                    AcceptsReturn="True"
                    IsEnabled="{Binding IsEditable}"
                    Text="{Binding Header.Note, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <!--  Message  -->
        <Grid Grid.Row="6">
            <StackPanel>
                <TextBlock
                    Foreground="{DynamicResource UserBusinessTextWarningBrush}"
                    Text="{Binding ValidationSummary}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AssociationSummary}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
