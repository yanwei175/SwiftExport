<UserControl x:Class="SwiftExportClient.Features.Shipping.PackingLists.Views.PackingListDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.Views"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:customerComponents="clr-namespace:SwiftExportClient.Features.Customers.Components"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Shipping.PackingLists.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:PackingListDetailViewModel}">

    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,6*,8,Auto">
        <!--Title-->
        <Grid ColumnDefinitions="Auto,8,*,8,Auto">
            <StackPanel Orientation="Horizontal">
                <ui:Button Grid.Column="0" Content="保存箱单" Command="{Binding SaveCommand}" MinWidth="70" VerticalAlignment="Stretch" Appearance="Primary"/>

                <ui:Button Content="撤销" Command="{Binding UndoCommand}" Margin="8,0,0,0" MinWidth="70" />
                <ui:Button Content="重新加载" Command="{Binding ReloadCommand}" Margin="8,0,0,0" MinWidth="70"/>
                <ui:Button Content="过账" Command="{Binding PostCommand}" Margin="8,0,0,0" MinWidth="70"/>
                <ui:Button Content="反过账" Command="{Binding ReverseCommand}" Margin="8,0,0,0" MinWidth="70"/>
                <ui:Button Content="执行追踪" Command="{Binding TraceCommand}" Margin="8,0,0,0" MinWidth="70"/>
            </StackPanel>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="10"
                       IsHitTestVisible="False" HorizontalAlignment="Center"
                       Text="PackingList" Style="{DynamicResource TitleTextBlock}" />

            <ui:Button Grid.Column="4" Content="关闭页签" Command="{Binding CloseCommand}" MinWidth="70" VerticalAlignment="Stretch" Appearance="Primary"/>
        </Grid>

        <!--Header-->
        <Grid Grid.Row="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="35"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="客户代码:" VerticalAlignment="Center"/>
                <customerComponents:CustomerAutoSuggestComboBox Grid.Column="2"
                          ItemsSource="{Binding Customers}"
                          SelectedCustomer="{Binding SelectedCustomer,Mode=TwoWay}"
                          IsEnabled="{Binding CanEditFacts}"/>

                <TextBlock Grid.Column="4" Text="系统箱单号:" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="6" Text="{Binding Header.PackingListNo,Mode=OneWay}" IsReadOnly="True" ToolTip="新订单保存时由服务端生成" />

                <TextBlock Grid.Column="8" Text="创建日期:" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="10" Text="{Binding Header.CreatedDate,Mode=OneWay,StringFormat=yyyy-MM-dd}" 
                            IsReadOnly="True"/>
                

                <TextBlock Grid.Column="12" Text="状态:" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="14" Text="{Binding Header.LifecycleStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True"/>

                <TextBlock Grid.Column="16" Text="过账:" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="18" Text="{Binding Header.PostingStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True"/>

            </Grid>

            <Border Grid.Row="2"
                    Padding="8"
                    BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsEnabled="{Binding IsEditable}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ship-To"/>

                    <ui:TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            PlaceholderText="客户联系人..."
                            Text="{Binding Header.CustomerNameSnapshot, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:TextBox Grid.Row="4" Grid.ColumnSpan="3"  Grid.RowSpan="3"
                            PlaceholderText="客户地址..."
                            Text="{Binding Header.CustomerAddressSnapshot, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"/>


                    <TextBlock Grid.Row="8" Text="Attention: :" VerticalAlignment="Top" />
                    <ui:TextBox Grid.Row="8" Grid.Column="2"
                                    Text="{Binding Header.AttentionSnapshot,UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="备注"
                                    TextAlignment="Left" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="InvoiceNo" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="8"
                                    PlaceholderText="发票号汇总"
                                    IsReadOnly="True" Text="{Binding Header.InvoiceNosSummary, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="InvoiceDate:" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="2" Grid.Column="6" 
                                    SelectedDate="{Binding Header.InvoiceDate, Mode=TwoWay}" ToolTip="发票日期"/>

                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Container:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="8"
                                    PlaceholderText="集装箱号"
                                    Text="{Binding Header.ContainerNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="4" Text="Seal:" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="6" Grid.Column="6" Grid.ColumnSpan="8"
                                    PlaceholderText="铅封号"
                                    Text="{Binding Header.SealNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="8" Text="出货地点:" VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Row="2" Grid.Column="10" Grid.ColumnSpan="4" MaxLength="200"
                            Text="{Binding Header.ShippingLocationSnapshot, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="8" Grid.Column="4" Text="ETD:" VerticalAlignment="Center" />
                    <DatePicker  Grid.Row="8" Grid.Column="6" 
                                    SelectedDate="{Binding Header.Etd, Mode=TwoWay}" ToolTip="ETD"/>

                    <TextBlock Grid.Row="8" Grid.Column="8" Text="ETA:" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="8" Grid.Column="10"
                                    SelectedDate="{Binding Header.Eta, Mode=TwoWay}" ToolTip="ETA"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}"/>

        <!--LineDataGrid-->
        <Grid Grid.Row="4" RowDefinitions="Auto,8,*,8,Auto,8,Auto">
            <!--汇总-->
            <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80,8,Auto,8,80">
                <StackPanel Orientation="Horizontal">
                    <ui:Button MinWidth="88" Margin="0,0,8,0" Content="获取" Command="{Binding SelectSourcesCommand}"  VerticalAlignment="Stretch" Appearance="Primary"/>
                    <ui:Button MinWidth="88" Margin="0,0,8,0" Content="删除行" Command="{Binding DeleteLineCommand}"  VerticalAlignment="Stretch"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="总数量:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Lines.QtySummary,Mode=OneWay}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="总净重:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="{Binding Lines.NetWeightSummary,Mode=OneWay}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="10" Text="总毛重:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="12" Text="{Binding Lines.GrossWeightSummary,Mode=OneWay}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="14" Text="总箱数:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="16" Text="{Binding Lines.CartonSummary,Mode=OneWay}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="18" Text="总体积:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="20" Text="{Binding Lines.CbmSummary,Mode=OneWay}" VerticalAlignment="Center"/>

            </Grid>

            <DataGrid Grid.Row="2" x:Name="OrderLinesGrid"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      FontSize="{StaticResource SwiftExportDefaltFontSize}"
                      ItemsSource="{Binding Lines.Items}"
                      Style="{StaticResource SwiftExportDataGrid}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="{Binding IsReadOnly, FallbackValue=True}"
                      IsEnabled="{Binding CanInteractWithLines}"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridCore:GridVirtualization.IsEnabled="True"
                      gridOperations:GridOperations.IsEnabled="True"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding SelectedLine, Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="True">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="移动" Width="40" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ChevronUp24}" Foreground="{DynamicResource UserSystemFillColorCautionBrush}"
                                               Appearance="Secondary" HorizontalAlignment="Stretch"
                                               Command="{Binding DataContext.MoveLineUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               BorderThickness="0.5" Height="30"/>
                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ChevronDown24}" Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                                               Appearance="Secondary" HorizontalAlignment="Stretch"
                                               Command="{Binding DataContext.MoveLineDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               BorderThickness="0.5" Height="30"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="拆箱" Width="40" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSplit24}" 
                                           Command="{Binding DataContext.SplitTailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           BorderThickness="0"
                                           ToolTip="拆分尾数箱" ToolTipService.InitialShowDelay="150"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanSplitTail}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource UserBusinessBackgroundWarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="40" Header="序号" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding LineNumber}"  IsReadOnly="True"/>

                    <DataGridTextColumn Width="40" Header="来源" Visibility="Collapsed"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding SourceTypeSnapshot}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="100" Header="来源单号" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding SourceDocumentNoSnapshot}" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="图片" Width="60" CanUserSort="False" gridColumns:GridColumn.Key="image">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="56" Height="56" Margin="2"
                                                    Style="{StaticResource SwiftExportCachedImage}"
                                                    Stretch="Uniform"
                                                    SourcePath="{Binding ImagePath}"
                                                    DecodePixelWidth="72"  />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="50" Header="唛头" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding Marks}" />

                    <DataGridTextColumn Width="120" Header="Sku" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding SkuSnapshot}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="120" Header="客户型号" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding CustomerSkuSnapshot}"  IsReadOnly="True"/>

                    <DataGridTextColumn Width="120" Header="产品型号" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding LinkSkuSnapshot}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="120" Header="描述" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding DescriptionEnSnapshot}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="120" Header="颜色" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding ColorNameEnSnapshot}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="60" Header="数量" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding Qty, UpdateSourceTrigger=LostFocus,StringFormat=N0}"/>

                    <DataGridTextColumn Width="70" Header="每箱数量" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding PcsPerPackage, UpdateSourceTrigger=LostFocus,StringFormat=N1}"/>

                    <DataGridTextColumn Width="70" Header="每箱净重" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding NwPerPackage, UpdateSourceTrigger=LostFocus,StringFormat=N2}"/>

                    <DataGridTextColumn Width="70" Header="每箱毛重" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding GwPerPackage, UpdateSourceTrigger=LostFocus,StringFormat=N2}"/>

                    <DataGridTextColumn Width="70" Header="每箱体积" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        Binding="{Binding CbmPerPackage, UpdateSourceTrigger=LostFocus,StringFormat=N3}"/>

                    <DataGridTextColumn Width="60" Header="箱数"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                        IsReadOnly="True" 
                                        Binding="{Binding PackageCount, Mode=OneWay,StringFormat=N1}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSplitTail}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextWarningBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Width="80" Header="小计净重" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding SubTotalNw,StringFormat=N2}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="80" Header="小计毛重" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding SubTotalGw,StringFormat=N2}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="80" Header="小计体积" ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding SubTotalCbm,StringFormat=N3}" IsReadOnly="True"/>

                    <DataGridTextColumn Width="80" Header="PoNo" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Width="80" Header="InvoiceNo" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}"
                                        Binding="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Width="120" Header="SubNote" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                        Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>



                    <DataGridTemplateColumn Header="非标">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsNonStandardSnapshot,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,8,*">
                <TextBlock Grid.Column="0" Text="备注:" VerticalAlignment="Top"/>
                <ui:TextBox Grid.Column="2" Height="60"
                        TextWrapping="Wrap" 
                        AcceptsReturn="True"
                        Text="{Binding Header.Note, UpdateSourceTrigger=PropertyChanged}" 
                       IsEnabled="{Binding IsEditable}"/>
            </Grid>
        </Grid>

        <!--Message-->
        <Grid Grid.Row="6">
            <StackPanel>
                <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Foreground="{DynamicResource UserBusinessTextWarningBrush}"/>
                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
