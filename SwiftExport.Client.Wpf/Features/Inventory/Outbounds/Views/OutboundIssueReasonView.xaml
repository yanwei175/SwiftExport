<UserControl x:Class="SwiftExportClient.Features.Inventory.Outbounds.Views.OutboundIssueReasonView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="4" FocusManager.FocusedElement="{Binding ElementName=ReasonBox}">
  <TextBlock Text="{Binding DocumentNo}" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Text="请说明本次手工出库的用途。确认后继续保存草稿，不会扣减库存。" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Label Content="出库原因（必填，最多 500 字）" Target="{Binding ElementName=ReasonBox}"/>
  <TextBox x:Name="ReasonBox" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
   MinHeight="96" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="出库原因"/>
 </StackPanel>
</UserControl>
