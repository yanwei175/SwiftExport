<UserControl x:Class="SwiftExportClient.Features.Inventory.Outbounds.Views.OutboundWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid">
 <Grid Margin="12" RowDefinitions="Auto,8,2*,8,*,Auto">
  <Grid ColumnDefinitions="260,8,Auto,8,Auto,*"><TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="出库单、PackingList、销售单或 SKU"/><Button Grid.Column="2" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/><Button Grid.Column="4" Content="查看明细" Command="{Binding LoadDetailCommand}"/></Grid>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}" gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True">
   <DataGrid.Columns><DataGridTextColumn Header="出库单号" Binding="{Binding DocumentNo}" Width="150"/><DataGridTextColumn Header="类型" Binding="{Binding DocumentType}" Width="160"/><DataGridTextColumn Header="状态" Binding="{Binding PostingStatus}" Width="90"/><DataGridTextColumn Header="日期" Binding="{Binding ShipmentDate,StringFormat=yyyy-MM-dd}" Width="105"/><DataGridTextColumn Header="PackingList" Binding="{Binding PackingListNo}" Width="150"/><DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="180"/><DataGridTextColumn Header="数量" Binding="{Binding TotalQuantity,StringFormat=N4}" Width="100"/></DataGrid.Columns>
  </DataGrid>
  <DataGrid Grid.Row="4" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}" gridCore:EnterpriseGrid.IsEnabled="True" gridCore:GridVirtualization.IsEnabled="True">
   <DataGrid.Columns><DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="55"/><DataGridTextColumn Header="销售单" Binding="{Binding SalesOrderNo}" Width="150"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/><DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity,StringFormat=N4}" Width="100"/><DataGridTextColumn Header="Allocation" Binding="{Binding NetDemandAllocationId}" Width="240"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="5" Text="{Binding Summary}" Foreground="Gray"/>
 </Grid>
</UserControl>
