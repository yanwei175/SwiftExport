<UserControl x:Class="SwiftExportClient.Features.Inventory.Outbounds.Views.OutboundDeleteDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Outbounds.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:OutboundDeleteDialogViewModel}">
    <StackPanel Margin="4">
        <TextBlock Text="删除仅标记草稿失效，不会删除历史审计。未保存的编辑也将放弃。" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Label Content="删除原因（必填，最多 500 字）" Target="{Binding ElementName=ReasonBox}"/>
        <TextBox x:Name="ReasonBox" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="500" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap"
                 AutomationProperties.Name="删除原因" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</UserControl>
