<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Views.WarehousePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="1440" d:DesignHeight="560">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="选择仓库" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlock}"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="输入仓库代码、名称或供应商后查询">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <Grid Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="查询" Command="{Binding SearchCommand}" MinWidth="72" Margin="8,0,8,0" VerticalAlignment="Stretch" Appearance="Primary"/>
                        <ui:Button Content="刷新" Command="{Binding RefreshCommand}" MinWidth="72" Margin="0,0,0,0" VerticalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="*,Auto">
            
            <DataGrid x:Name="WarehouseGrid" Grid.Row="0" 
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserAddRows="False"
                      SelectionMode="Single" 
                      SelectionUnit="FullRow"
                      MouseDoubleClick="WarehouseGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="仓库代码" Binding="{Binding Code}" Width="130" />
                    <DataGridTextColumn Header="仓库名称" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="供应商代码" Binding="{Binding SupplierCode}" Width="140" />
                    <DataGridTextColumn Header="供应商名称" Binding="{Binding SupplierName}" Width="2*" />
                    <DataGridTextColumn Header="类型" Binding="{Binding SiteType,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,12,Auto">
                <TextBlock Grid.Column="0" 
                           Text="{Binding PageStatus}" 
                           Style="{StaticResource CaptionTextBlock}"/>
                <controls:PageNavigator Grid.Column="2" 
                                        TotalCount="{Binding TotalCount}" 
                                        PageIndex="{Binding PageIndex}" 
                                        PageSize="{Binding PageSize}" 
                                        PageChangeCommand="{Binding PageChangeCommand}"/>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
