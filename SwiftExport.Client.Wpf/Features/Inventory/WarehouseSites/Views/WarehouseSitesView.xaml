<UserControl
    x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Views.WarehouseSitesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridSelection="clr-namespace:SwiftExportClient.Resources.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.ViewModels"
    xmlns:views="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Views"
    d:DataContext="{d:DesignInstance viewModels:WarehouseSitesViewModel}"
    d:Height="720"
    d:Width="1080"
    mc:Ignorable="d">
    <UserControl.Resources>
        <proxies:BindingProxy x:Key="WarehousePageProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="虚拟仓库管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="仓库代码,名称,供应商代码或名称"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding RefreshActionText}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,8,*,8,Auto">

            <Grid Grid.Row="2" ColumnDefinitions="180,8,180,8,*">

                <supplierComponents:SupplierAutoSuggestComboBox
                    Grid.Column="0"
                    ItemsSource="{Binding SupplierOptions}"
                    Placeholder="按供应商精确筛选"
                    SelectedSupplier="{Binding SearchSupplier, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="2"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="DisplayText"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatus}" />

                <StackPanel
                    Grid.Column="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <ui:Button
                        MinWidth="70"
                        Margin="12,0,0,0"
                        Command="{Binding OpenCreateCommand}"
                        Content="新增" />

                    <ui:Button
                        MinWidth="70"
                        Margin="4,0,0,0"
                        Command="{Binding OpenEditCommand}"
                        Content="编辑" />

                    <ui:Button
                        MinWidth="70"
                        Margin="4,0,0,0"
                        Appearance="Success"
                        Command="{Binding ActivateCommand}"
                        Content="启用" />

                    <ui:Button
                        MinWidth="70"
                        Margin="4,0,0,0"
                        Appearance="Caution"
                        Command="{Binding DeactivateCommand}"
                        Content="停用" />

                    <ui:Button
                        MinWidth="70"
                        Margin="4,0,0,0"
                        Appearance="Danger"
                        Command="{Binding DeleteCommand}"
                        Content="删除" />

                </StackPanel>
            </Grid>

            <controls:RightDrawerHost
                Grid.Row="4"
                CloseCommand="{Binding CloseDrawerCommand}"
                CloseOnEscape="True"
                DisplayMode="Overlay"
                DrawerWidth="520"
                IsOpen="{Binding IsDrawerOpen, Mode=OneWay}"
                IsResizable="True"
                MaxDrawerWidth="720"
                MinDrawerWidth="440">
                <controls:RightDrawerHost.MainContent>
                    <DataGrid
                        Padding="2,0"
                        gridCore:GridRowHeader.ShowRowNumberInColumn="True"
                        AutoGenerateColumns="False"
                        BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Items}"
                        RowHeight="{DynamicResource DataGridRowHeightSmall}"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionChanged="WarehouseGrid_OnSelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.InputBindings>
                            <MouseBinding Command="{Binding OpenEditCommand}" MouseAction="LeftDoubleClick" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Code}"
                                Header="代码" />

                            <DataGridTextColumn
                                Width="220"
                                Binding="{Binding Name}"
                                Header="名称" />

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding SupplierCode}"
                                Header="供应商代码" />

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding SupplierName}"
                                FontWeight="Bold"
                                Header="供应商名称" />

                            <DataGridTemplateColumn
                                Width="80"
                                ClipboardContentBinding="{Binding IsActive, Mode=OneWay}"
                                Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="停用" />
                                                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="活动" />
                                                            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding UpdatedDate, StringFormat=yyyy-MM-dd HH:mm}"
                                Header="更新时间" />

                            <DataGridTextColumn Width="*" Header="PlaceHolder" />

                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RightDrawerHost.MainContent>

                <controls:RightDrawerHost.DrawerContent>
                    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" DataContext="{Binding EditModel}">
                            <DockPanel LastChildFill="True">
                                <Button
                                    MinWidth="70"
                                    Command="{Binding Data.CloseDrawerCommand, Source={StaticResource WarehousePageProxy}}"
                                    Content="取消"
                                    DockPanel.Dock="Right" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}" />
                            </DockPanel>

                            <TextBlock
                                Margin="0,16,0,4"
                                FontWeight="SemiBold"
                                Text="供应商 *" />
                            <supplierComponents:SupplierAutoSuggestComboBox
                                ItemsSource="{Binding Data.SupplierOptions, Source={StaticResource WarehousePageProxy}}"
                                Placeholder="选择供应商"
                                SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                StretchToHost="True">
                                <supplierComponents:SupplierAutoSuggestComboBox.Style>
                                    <Style TargetType="supplierComponents:SupplierAutoSuggestComboBox">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCreateMode}" Value="True" />
                                                    <Condition Binding="{Binding Data.CanEditInputs, Source={StaticResource WarehousePageProxy}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="True" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </supplierComponents:SupplierAutoSuggestComboBox.Style>
                            </supplierComponents:SupplierAutoSuggestComboBox>

                            <TextBlock
                                Margin="0,12,0,4"
                                FontWeight="SemiBold"
                                Text="仓库代码 *" />
                            <TextBox
                                IsEnabled="{Binding Data.CanEditInputs, Source={StaticResource WarehousePageProxy}}"
                                MaxLength="100"
                                Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                        <Setter Property="IsReadOnly" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                                <Setter Property="IsReadOnly" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock
                                Margin="0,12,0,4"
                                FontWeight="SemiBold"
                                Text="仓库名称 *" />
                            <TextBox
                                AutomationProperties.Name="仓库名称"
                                IsEnabled="{Binding Data.CanEditInputs, Source={StaticResource WarehousePageProxy}}"
                                MaxLength="300"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                                Text="编辑模式只允许改名；仓库代码和供应商归属保持不变。"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <ui:Button
                                    MinWidth="70"
                                    Appearance="Primary"
                                    Command="{Binding Data.SaveCommand, Source={StaticResource WarehousePageProxy}}"
                                    Content="{Binding Data.SaveActionText, Source={StaticResource WarehousePageProxy}}" />
                                <Button
                                    MinWidth="70"
                                    Margin="8,0,0,0"
                                    Command="{Binding Data.CloseDrawerCommand, Source={StaticResource WarehousePageProxy}}"
                                    Content="取消" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </controls:RightDrawerHost.DrawerContent>
            </controls:RightDrawerHost>

            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,16,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                    Text="{Binding ResultSummary}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding PageSummary}" />
                <controls:PageNavigator
                    Grid.Column="3"
                    PageChangeCommand="{Binding PageChangeCommand}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageIndex="{Binding PageIndex}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
