<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Views.WarehouseSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid" 
             xmlns:views="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="1080" d:Height="720"
             d:DataContext="{d:DesignInstance viewModels:WarehouseSitesViewModel}"
>
    <UserControl.Resources>
        <proxies:BindingProxy x:Key="WarehousePageProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="虚拟仓库管理" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center" />
                    <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="仓库代码,名称,供应商代码或名称">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,8,*,8,Auto">

            <Grid Grid.Row="2" ColumnDefinitions="180,8,180,8,*">

                <supplierComponents:SupplierAutoSuggestComboBox Grid.Column="0"
                                                             ItemsSource="{Binding SupplierOptions}"
                                                             SelectedSupplier="{Binding SearchSupplier,Mode=TwoWay}"
                                                             Placeholder="按供应商精确筛选" />
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" 
                          DisplayMemberPath="DisplayText"/>
                
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <ui:Button Margin="12,0,0,0" Content="新增" Command="{Binding OpenCreateCommand}" MinWidth="70"/>
                    
                    <ui:Button Margin="4,0,0,0" Content="编辑" Command="{Binding OpenEditCommand}" MinWidth="70"/>

                    <ui:Button Margin="4,0,0,0" Content="启用" Command="{Binding ActivateCommand}" MinWidth="70" Appearance="Success"/>
                    
                    <ui:Button Margin="4,0,0,0" Content="停用" Command="{Binding DeactivateCommand}" MinWidth="70" Appearance="Caution"/>

                    <ui:Button Margin="4,0,0,0" Content="删除" Command="{Binding DeleteCommand}" MinWidth="70" Appearance="Danger"/>
                    
                </StackPanel>
            </Grid>

            <controls:RightDrawerHost Grid.Row="4" IsOpen="{Binding IsDrawerOpen,Mode=OneWay}"
                                  CloseCommand="{Binding CloseDrawerCommand}" CloseOnEscape="True"
                                  DisplayMode="Overlay" 
                                  DrawerWidth="520" 
                                  MinDrawerWidth="440" 
                                  MaxDrawerWidth="720"
                                  IsResizable="True">
                <controls:RightDrawerHost.MainContent>
                    <DataGrid ItemsSource="{Binding Items}" 
                          Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                          SelectedItem="{Binding SelectedItem}"
                          SelectionChanged="WarehouseGrid_OnSelectionChanged"
                          RowHeight="{DynamicResource DataGridRowHeightSmall}"
                          FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                          Padding="2,0"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          EnableRowVirtualization="True" 
                          EnableColumnVirtualization="True"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumberInColumn="True">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenEditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="130" />
                            
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" />
                            
                            <DataGridTextColumn Header="供应商代码" Binding="{Binding SupplierCode}" Width="120" />
                            
                            <DataGridTextColumn Header="供应商名称" Binding="{Binding SupplierName}" FontWeight="Bold" Width="120" />
                            
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="停用" />
                                                    <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="活动" />
                                                            <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                            
                            <DataGridTextColumn Header="PlaceHolder" Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RightDrawerHost.MainContent>

                <controls:RightDrawerHost.DrawerContent>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <StackPanel Margin="16" DataContext="{Binding EditModel}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="取消"
                                    Command="{Binding Data.CloseDrawerCommand,Source={StaticResource WarehousePageProxy}}" />
                                <TextBlock Text="{Binding Title}" 
                                       FontSize="18"
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Margin="0,16,0,4" Text="供应商 *" FontWeight="SemiBold" />
                            <supplierComponents:SupplierAutoSuggestComboBox StretchToHost="True" ItemsSource="{Binding Data.SupplierOptions,Source={StaticResource WarehousePageProxy}}"
                                                                        SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay,ValidatesOnNotifyDataErrors=True}"
                                                                        Placeholder="选择供应商">
                                <supplierComponents:SupplierAutoSuggestComboBox.Style>
                                    <Style TargetType="supplierComponents:SupplierAutoSuggestComboBox">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </supplierComponents:SupplierAutoSuggestComboBox.Style>
                            </supplierComponents:SupplierAutoSuggestComboBox>

                            <TextBlock Margin="0,12,0,4" Text="仓库代码 *" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" MaxLength="100">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="IsReadOnly" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                                <Setter Property="IsReadOnly" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Margin="0,12,0,4" Text="仓库名称 *" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="300" AutomationProperties.Name="仓库名称" />
                            <TextBlock Margin="0,8,0,0" Text="编辑模式只允许改名；仓库代码和供应商归属保持不变。"
                                   Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="保存" 
                                       Appearance="Primary"
                                       Command="{Binding Data.SaveCommand,Source={StaticResource WarehousePageProxy}}" />
                                <Button Margin="8,0,0,0" Content="取消"
                                    Command="{Binding Data.CloseDrawerCommand,Source={StaticResource WarehousePageProxy}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </controls:RightDrawerHost.DrawerContent>
            </controls:RightDrawerHost>

            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,16,Auto">
                <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center"
                       Foreground="{DynamicResource UserTextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding PageSummary}" VerticalAlignment="Center" />
                <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
