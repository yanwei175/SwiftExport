<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Views.WarehouseSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Views"
             xmlns:viewModels="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:WarehouseSitesViewModel}"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:proxies="clr-namespace:SwiftExportClient.Resources.Proxies"
             xmlns:warehouse="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Components">
    <UserControl.Resources>
        <proxies:BindingProxy x:Key="WarehousePageProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="12,8" RowDefinitions="Auto,8,Auto,8,*,8,Auto">
        <DockPanel LastChildFill="True">
            <StackPanel>
                <TextBlock Text="供应商虚拟仓" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="管理供应商所在地仓库；库存数量与流水在独立只读页面维护。"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            </StackPanel>

        </DockPanel>

        <Grid Grid.Row="2" ColumnDefinitions="240,8,280,8,140,8,Auto,*">
            <ui:TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="仓库代码,名称,供应商代码或名称"
                     AutomationProperties.Name="虚拟仓关键词" />
            <warehouse:WarehouseSupplierLookupTextBox Grid.Column="2"
                                                      ItemsSource="{Binding FilterSupplierCandidates}"
                                                      SearchCommand="{Binding SearchFilterSupplierCommand}"
                                                      IsBusy="{Binding IsFilterSupplierBusy}"
                                                      SelectedSupplier="{Binding SearchSupplier,Mode=TwoWay}"
                                                      Placeholder="按供应商精确筛选" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="DisplayText"
                      AutomationProperties.Name="虚拟仓状态筛选" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="查询" Command="{Binding SearchCommand}" AutomationProperties.Name="查询虚拟仓" />
                <Button Margin="4,0,0,0" Content="刷新" Command="{Binding RefreshCommand}" 
                        AutomationProperties.Name="刷新虚拟仓" />
                <Button Margin="12,0,0,0" Content="新增" Command="{Binding OpenCreateCommand}" />
                <Button Margin="4,0,0,0" Content="编辑" Command="{Binding OpenEditCommand}" />
                <Button Margin="4,0,0,0" Content="停用" Command="{Binding DeactivateCommand}" />
                <Button Margin="4,0,0,0" Content="删除" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <controls:RightDrawerHost Grid.Row="4" IsOpen="{Binding IsDrawerOpen,Mode=OneWay}"
                                  CloseCommand="{Binding CloseDrawerCommand}" CloseOnEscape="True"
                                  DisplayMode="Overlay" DrawerWidth="520" MinDrawerWidth="440" MaxDrawerWidth="720"
                                  IsResizable="True">
            <controls:RightDrawerHost.MainContent>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenEditCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="130" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="供应商代码" Binding="{Binding SupplierCode}" Width="130" />
                        <DataGridTextColumn Header="供应商名称" Binding="{Binding SupplierName}" Width="220" />
                        <DataGridTemplateColumn Header="状态" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="停用" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="活动" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:RightDrawerHost.MainContent>

            <controls:RightDrawerHost.DrawerContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="16" DataContext="{Binding EditModel}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="取消"
                                    Command="{Binding Data.CloseDrawerCommand,Source={StaticResource WarehousePageProxy}}" />
                            <TextBlock Text="{Binding Title}" 
                                       FontSize="18"
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Margin="0,16,0,4" Text="供应商 *" FontWeight="SemiBold" />
                        <warehouse:WarehouseSupplierLookupTextBox ItemsSource="{Binding Data.EditSupplierCandidates,Source={StaticResource WarehousePageProxy}}"
                                                                 SearchCommand="{Binding Data.SearchEditSupplierCommand,Source={StaticResource WarehousePageProxy}}"
                                                                 IsBusy="{Binding Data.IsEditSupplierBusy,Source={StaticResource WarehousePageProxy}}"
                                                                 SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay,ValidatesOnNotifyDataErrors=True}"
                                                                 Placeholder="选择活动供应商">
                            <warehouse:WarehouseSupplierLookupTextBox.Style>
                                <Style TargetType="warehouse:WarehouseSupplierLookupTextBox">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </warehouse:WarehouseSupplierLookupTextBox.Style>
                        </warehouse:WarehouseSupplierLookupTextBox>

                        <TextBlock Margin="0,12,0,4" Text="仓库代码 *" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" MaxLength="100">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsReadOnly" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                            <Setter Property="IsReadOnly" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Margin="0,12,0,4" Text="仓库名称 *" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="300" AutomationProperties.Name="仓库名称" />
                        <TextBlock Margin="0,8,0,0" Text="编辑模式只允许改名；仓库代码和供应商归属保持不变。"
                                   Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" TextWrapping="Wrap" />

                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="保存" 
                                       Appearance="Primary"
                                       Command="{Binding Data.SaveCommand,Source={StaticResource WarehousePageProxy}}" />
                            <Button Margin="8,0,0,0" Content="取消"
                                    Command="{Binding Data.CloseDrawerCommand,Source={StaticResource WarehousePageProxy}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </controls:RightDrawerHost.DrawerContent>
        </controls:RightDrawerHost>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,16,Auto">
            <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center"
                       Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" />
            <TextBlock Grid.Column="1" Text="{Binding PageSummary}" VerticalAlignment="Center" />
            <controls:PageNavigator Grid.Column="3" TotalCount="{Binding TotalCount}"
                                    PageIndex="{Binding PageIndex}" PageSize="{Binding PageSize}"
                                    PageChangeCommand="{Binding PageChangeCommand}" />
        </Grid>
    </Grid>
</UserControl>
