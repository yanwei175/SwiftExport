<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Views.WarehouseSitesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,*,Auto">
  <TextBlock Text="供应商虚拟仓" Style="{StaticResource TitleTextBlock}"/>
  <Grid Grid.Row="2" ColumnDefinitions="180,8,220,8,Auto,*,Auto"><TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="仓库、供应商"/><TextBox Grid.Column="2" Text="{Binding SupplierIdText}" ToolTip="供应商 Uid（精确选择）"/><Button Grid.Column="4" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/><Button Grid.Column="6" Content="停用所选" Command="{Binding DeactivateCommand}"/></Grid>
  <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}"><DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="130"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="220"/><DataGridTextColumn Header="状态" Binding="{Binding IsActive}" Width="70"/><DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="5" Margin="0,8,0,0"><TextBlock Text="创建供应商虚拟仓" FontWeight="SemiBold"/><WrapPanel Margin="0,4,0,0"><TextBox Width="220" Text="{Binding NewSupplierId}" ToolTip="供应商 Uid"/><TextBox Width="140" Margin="8,0,0,0" Text="{Binding NewCode}" ToolTip="仓库代码"/><TextBox Width="180" Margin="8,0,0,0" Text="{Binding NewName}" ToolTip="仓库名称"/><Button Margin="8,0,0,0" Content="创建" Command="{Binding CreateCommand}" Style="{StaticResource AccentButton}"/></WrapPanel><TextBlock Text="{Binding ResultSummary}" Margin="0,4,0,0" Foreground="Gray"/></StackPanel>
 </Grid>
</UserControl>
