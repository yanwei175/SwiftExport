<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Components.WarehouseAutoSuggestComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:warehouses="clr-namespace:SwiftExport.Contracts.DTOs.Inventory.WareHouseSite.Picker;assembly=SwiftExport.Contracts"
             FontSize="{DynamicResource ContentControlFontSize}"
             mc:Ignorable="d" d:DesignHeight="30" d:DesignWidth="160"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="WarehouseItemTemplate" DataType="{x:Type warehouses:WarehouseSitePickerDto}">
            <Grid MinWidth="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding Code}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                           Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                               Text="供应商：" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                               Text="{Binding SupplierCode}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0"
                               Foreground="{DynamicResource UserTextFillColorSecondaryBrush}"
                               Text="{Binding SupplierName}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:LookupTextBox x:Name="LookupEditor"
                            Text="{Binding Text, ElementName=Root, Mode=OneWay}"
                            automation:AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedWarehouse, ElementName=Root, Mode=TwoWay}"
                            SelectionCommittedCommand="{Binding SelectionCommittedCommand, ElementName=Root}"
                            SelectionCommittedCommandParameter="{Binding SelectionCommittedCommandParameter, ElementName=Root}"
                            SelectionClearedCommand="{Binding SelectionClearedCommand, ElementName=Root}"
                            SelectionClearedCommandParameter="{Binding SelectionClearedCommandParameter, ElementName=Root}"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            FontSize="{Binding FontSize, ElementName=Root}"
                            SearchMode="Local"
                            DisplayMemberPath="Code"
                            FilterMemberPaths="Code,Name,SupplierCode,SupplierName"
                            SelectedValuePath="Uid"
                            RequireItemMatch="True"
                            ClearSelectionOnEdit="False"
                            ShowDropDownButton="True"
                            MatchSuggestionFontSize="True"
                            ItemTemplate="{StaticResource WarehouseItemTemplate}" />
</UserControl>
