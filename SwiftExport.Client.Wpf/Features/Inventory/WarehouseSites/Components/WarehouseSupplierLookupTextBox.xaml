<UserControl x:Class="SwiftExportClient.Features.Inventory.WarehouseSites.Components.WarehouseSupplierLookupTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:inventory="clr-namespace:SwiftExport.Contracts.DTOs.Inventory;assembly=SwiftExport.Contracts"
             x:Name="Root" MinHeight="30">
    <UserControl.Resources>
        <DataTemplate x:Key="WarehouseSupplierItemTemplate" DataType="{x:Type inventory:WarehouseSupplierLookupDto}">
            <Grid MinWidth="300" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding SupplierCode}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Margin="0,2,0,0" Text="{Binding SupplierName}"
                           Foreground="{DynamicResource SwiftExportBrush.TextSecondary}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <controls:LookupTextBox Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                            ItemsSource="{Binding ItemsSource, ElementName=Root}"
                            SelectedItem="{Binding SelectedSupplier, ElementName=Root, Mode=TwoWay}"
                            SearchCommand="{Binding SearchCommand, ElementName=Root}"
                            IsBusy="{Binding IsBusy, ElementName=Root}"
                            SearchDelay="0:0:0.3" 
                            MinimumSearchLength="0"
                            Placeholder="{Binding Placeholder, ElementName=Root}"
                            SearchMode="Remote" DisplayMemberPath="SupplierCode"
                            FilterMemberPaths="SupplierCode,SupplierName" SelectedValuePath="Uid"
                            RequireItemMatch="True" 
                            ClearSelectionOnEdit="False"
                            ItemTemplate="{StaticResource WarehouseSupplierItemTemplate}" />
</UserControl>
