<UserControl x:Class="SwiftExportClient.Features.Inventory.Inbounds.Views.InboundSourcePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:supplierControls="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Inbounds.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=vm:InboundSourcePickerDesignViewModel, IsDesignTimeCreatable=True}"
             Language="zh-CN">
    <Grid Margin="12" RowDefinitions="Auto,8,*,8,Auto">
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="选择入库来源" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="按回车执行搜索">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <!--来源筛选的条件(客供件,采购)默认客供件-->
                <ComboBox Width="144" Margin="0,0,8,0"
                          ItemsSource="{Binding PurchaseCategories}"
                          SelectedItem="{Binding PurchaseCategory, Mode=TwoWay}"
                          IsEnabled="{Binding IsPurchase}" 
                          AutomationProperties.Name="采购来源分类">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPurchase}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!--供应商筛选使用会话全量缓存，不请求有效采购供应商子集。-->
                <supplierControls:SupplierAutoSuggestComboBox Width="240" Margin="0,0,8,0"
                    ItemsSource="{Binding Suppliers}" SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                    IsEnabled="{Binding IsPurchase}"/>
                <ui:Button Content="查询" Appearance="Info" VerticalAlignment="Stretch" MinWidth="80"
                        Command="{Binding SearchCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsPurchase}"/>
                <Button Content="清空勾选" VerticalAlignment="Stretch" MinWidth="80"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0"/>

                <Button DockPanel.Dock="Right" VerticalAlignment="Stretch" MinWidth="80"
                        Content="反选" Command="{Binding InvertSelectionCommand}" IsEnabled="{Binding CanSelect}"
                    AutomationProperties.Name="反选" Padding="12,4"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Items}" 
                  FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                  IsEnabled="{Binding CanSelect}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  RowHeight="{StaticResource DataGridRowHeightMedium}" 
                  AutomationProperties.Name="入库来源候选列表">
            <DataGrid.Columns>

                <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      AutomationProperties.Name="全选或取消当前页" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0" Padding="0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="勾选入库来源"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:CachedImage Width="48" Height="48" Margin="2"
                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                  Stretch="Uniform" DecodePixelWidth="96"
                                                  SourcePath="{Binding ImagePath}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceNo}" Width="152"/>
                <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="56"/>
                <DataGridTextColumn Header="自定义采购单号" Binding="{Binding BoNo}" Width="144"/>
                <DataGridTextColumn Header="Sku" Binding="{Binding Sku}" Width="128"/>
                <DataGridTextColumn Header="产品型号" Binding="{Binding LinkSku}" Width="128"/>
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="原数量" Binding="{Binding OriginalQty, StringFormat=N4}" Width="104"/>
                <DataGridTextColumn Header="待入库数量" Binding="{Binding RemainingReceivableQty, StringFormat=N4}" Width="112"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="64"/>
                <DataGridTextColumn Header="采购供应商" Binding="{Binding SupplierName}" Width="144"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CheckedCount, StringFormat=已选 {0} 行}"/>
            </StackPanel>
            <controls:PageNavigator Grid.Column="1" TotalCount="{Binding TotalCount}" PageIndex="{Binding PageIndex}"
                                    PageSize="{Binding PageSize}" PageChangeCommand="{Binding PageChangeCommand}"/>
        </Grid>
    </Grid>
</UserControl>
