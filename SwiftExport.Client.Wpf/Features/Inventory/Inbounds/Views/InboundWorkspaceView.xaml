<UserControl x:Class="SwiftExportClient.Features.Inventory.Inbounds.Views.InboundWorkspaceView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12" RowDefinitions="Auto,8,2*,8,*,Auto">
        <Grid ColumnDefinitions="220,8,180,8,Auto,8,*">
            <TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="入库单、采购单、销售单或 SKU"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}"/>
            
            <ui:Button Grid.Column="4" Content="查询" 
                    Appearance="Primary"
                    Command="{Binding SearchCommand}"/>
            
            
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="加载来源" Command="{Binding LoadSourcesCommand}" Margin="0,0,4,0"/>
                <Button Content="创建草稿" Command="{Binding CreateDraftCommand}" Margin="0,0,4,0"/>
                <Button Content="过账预览" Command="{Binding PreviewPostCommand}" Margin="0,0,4,0"/>
                <Button Content="提交过账" Command="{Binding PostCommand}" Margin="0,0,4,0"/>
                <Button Content="反过账预览" Command="{Binding PreviewReverseCommand}" Margin="0,0,4,0"/>
                <Button Content="反过账" Command="{Binding ReverseCommand}"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="入库单号" Binding="{Binding DocumentNo}" Width="150"/>
                <DataGridTextColumn Header="类型" Binding="{Binding DocumentType}" Width="130"/>
                <DataGridTextColumn Header="状态" Binding="{Binding PostingStatusText}" Width="80"/>
                <DataGridTextColumn Header="收货日期" Binding="{Binding ReceiptDate,StringFormat=yyyy-MM-dd}" Width="105"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="160"/>
                <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="160"/>
                <DataGridTextColumn Header="数量" Binding="{Binding TotalQuantity,StringFormat=N4}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="采购单" Binding="{Binding PurchaseOrderNo}" Width="140"/>
                <DataGridTextColumn Header="销售单" Binding="{Binding SalesOrderNo}" Width="140"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                <DataGridTextColumn Header="可收货" Binding="{Binding RemainingReceivableQty,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="目标虚拟仓" Binding="{Binding WarehouseName}" Width="170"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5">
            <TextBlock Text="{Binding PreviewSummary}" Foreground="DarkOrange"/>
            <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</UserControl>
