<UserControl x:Class="SwiftExportClient.Features.Inventory.Inbounds.Views.InboundManagerView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Inbounds.ViewModels"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid" 
             xmlns:gridNumeric="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns.Numeric;assembly=SwiftExport.Wpf.EnterpriseGrid"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=vm:InboundManagerViewModel}">

    <Grid Margin="12" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--条件筛选区域-->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="入库单管理" 
                           Style="{StaticResource SubtitleTextBlock}"
                           VerticalAlignment="Center"/>
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="入库单号,来源单号,自定义采购单号,Sku,LinkSku搜索">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>

                    <ui:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,3*,8,8*,Auto">
            <!--单头操作区域-->
            <Grid ColumnDefinitions="80,8,120,8,120,8,Auto,8,*">
                <TextBlock Grid.Column="0" Text="筛选条件:"
                           Style="{StaticResource BodyStrongTextBlock}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"/>
                <ComboBox Grid.Column="2" Height="{DynamicResource SwiftExportControlHeight}"
                          ItemsSource="{x:Static staticEnums:InboundDocumentTypes.All}"
                          SelectedItem="{Binding SelectedDocumentType, Mode=TwoWay}">
                    
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <ComboBox Grid.Column="4" Height="{DynamicResource SwiftExportControlHeight}"
                          ItemsSource="{x:Static staticEnums:InboundPostingStatusList.All}"
                          SelectedItem="{Binding SelectedPostingStatus, Mode=TwoWay}">
                    
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                

                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Content="新增" MinWidth="70"  Margin="0,0,6,0" Command="{Binding AddNewHeaderRowCommand}" VerticalAlignment="Stretch"/>
                    <ui:Button Content="保存" MinWidth="70"   Margin="0,0,6,0"  Command="{Binding SaveCommand}" Appearance="Success" VerticalAlignment="Stretch"/>
                    <ui:Button Content="删除" MinWidth="70"   Margin="0,0,6,0"  Command="{Binding DeleteSelectedCommand}" VerticalAlignment="Stretch"/>
                    <ui:Button Content="过账" MinWidth="70"   Margin="0,0,6,0" Command="{Binding PostCommand}" Appearance="Primary" VerticalAlignment="Stretch"/>
                    <ui:Button Content="反过账" MinWidth="70" Margin="0,0,6,0" Command="{Binding ReverseCommand}" Appearance="Danger" VerticalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <!--单头-->
            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <DataGrid x:Name="HeaderGrid" Grid.Row="0"
                          Style="{StaticResource SwiftExportDataGrid}"
                          FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                          RowHeight="{DynamicResource DataGridRowHeightSmall}"
                          ItemsSource="{Binding Headers.Items}" IsReadOnly="{Binding HeaderReadOnly}"
                          SelectedItem="{Binding SelectedItem}" 
                          SelectionChanged="OnHeaderSelectionChanged"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          gridCore:EnterpriseGrid.IsEnabled="True"
                          gridCore:GridRowHeader.ShowRowNumber="True">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="False"
                                          IsChecked="{Binding DataContext.Headers.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                          IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0" Padding="0"
                                    HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="入库单号" Binding="{Binding DocumentNo}"
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Width="120" IsReadOnly="True"/>
                    
                    <DataGridTextColumn Header="建立方式" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        Binding="{Binding CreationMode, Converter={StaticResource EnumDescriptionConverter}}" 
                                        Width="100" 
                                        IsReadOnly="True"/>
                        <DataGridTextColumn Header="过账状态" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding PostingStatus,Mode=OneWay,Converter={StaticResource EnumDescriptionConverter}}" 
                                            Width="100" 
                                            IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="入库类型" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox 
                                          FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                                          ItemsSource="{x:Static staticEnums:InboundDocumentTypes.All}"
                                          IsEnabled="{Binding CanChangeDocumentType}"
                                          SelectedItem="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn Header="收货日期" Width="125"
                                            SortMemberPath="ReceiptDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker VerticalAlignment="Stretch"
                                                Margin="2,0,0,0"
                                                FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                                                SelectedDate="{Binding ReceiptDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanEdit}" 
                                                Style="{StaticResource SwiftExportDataGridDatePicker}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="目标仓库" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,20">
                                    <TextBlock Text="{Binding WarehouseNameSnapshot}" 
                                               Style="{StaticResource SwiftExportDataGridTextBlock}"/>
                                    <ui:Button Grid.Column="1" 
                                               Style="{StaticResource MoreVerticalButtonStyleInDataGrid}"
                                               Icon="{ui:SymbolIcon Symbol=MoreVertical24}"
                                               Command="{Binding DataContext.OpenWarehousePickerCommand, 
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                        <DataGridTextColumn Header="入库数量" 
                                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                        Binding="{Binding TotalQuantity,StringFormat=N1}" 
                                        Width="80" 
                                        IsReadOnly="True"/>
                    

                        <DataGridTextColumn Header="备注" 
                                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                        EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                        Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="*"/>


                </DataGrid.Columns>
            </DataGrid>

                <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,12,Auto">
                    <TextBlock Grid.Column="0" 
                               Text="{Binding PageStatus}" 
                               Style="{StaticResource CaptionTextBlock}"/>
                    <controls:PageNavigator Grid.Column="2" 
                                            TotalCount="{Binding TotalCount}"
                                            PageIndex="{Binding PageIndex, Mode=OneWay}"
                                            PageSize="{Binding PageSize}"
                                            PageSizeOptions="{Binding PageSizeOptions}"
                                            PageChangeCommand="{Binding PageChangeCommand}"/>
                </Grid>
            </Grid>

            
            <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}"/>

            <Grid Grid.Row="4" RowDefinitions="Auto,8,*">
                <!--单行操作区域-->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="获取" MinWidth="70"  Margin="0,0,6,0" Command="{Binding OpenInboundSourceDialogCommand}" VerticalAlignment="Stretch" Appearance="Primary"/>
                        <ui:Button Content="新增行" MinWidth="70"  Margin="0,0,6,0" Command="{Binding AddNewLineRowCommand}" VerticalAlignment="Stretch"/>
                        <ui:Button Content="删除行" MinWidth="70"   Margin="0,0,6,0"  Command="{Binding DeleteSelectedLineCommand}" VerticalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
                <!--单行-->
                <DataGrid x:Name="LineGrid" Grid.Row="2"
                      IsReadOnly="{Binding LinesReadOnly}" 
                      ItemsSource="{Binding Lines.Items}" 
                      SelectedItem="{Binding Lines.SelectedItem}" 
                      Style="{StaticResource SwiftExportDataGrid}"
                      FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                      RowHeight="{StaticResource DataGridRowHeightMedium}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      gridCore:EnterpriseGrid.IsEnabled="True"
                      gridCore:GridVirtualization.IsEnabled="True"
                      gridOperations:GridOperations.IsEnabled="True"
                      gridSelection:GridSelection.IsCellClickSelectionEnabled="True"
                      gridSelection:GridSelection.CurrentRow="{Binding Lines.SelectedItem,Mode=TwoWay}"
                      gridValidation:GridValidation.IsEnabled="True">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="行号" 
                                            Binding="{Binding LineNumber}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            IsReadOnly="True" Width="40"/>

                        <DataGridTemplateColumn Width="45" CanUserSort="False" HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox  IsChecked="{Binding DataContext.Lines.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                           HorizontalAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0" Padding="0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage Width="48" Height="48" Margin="2"
                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                  Stretch="Uniform" DecodePixelWidth="96"
                                                  SourcePath="{Binding ImagePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="来源单号" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding SourceNo}" 
                                            Width="120" 
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="自定义单号" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding BoNo}" Width="144" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Sku" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding SkuSnapshot}" Width="150" IsReadOnly="True"/>

                        <DataGridTextColumn Header="产品型号" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding LinkSku}" Width="150" IsReadOnly="True"/>

                        <DataGridTextColumn Header="原数量" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            Binding="{Binding OriginalQty, StringFormat=N0}" 
                                            Width="80" 
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="待入库" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            Binding="{Binding RemainingReceivableQty, StringFormat=N0}" 
                                            Width="80" 
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="本次入库" 
                                            gridColumns:GridColumn.Key="Quantity"
                                            gridColumns:GridColumn.FieldPath="Quantity"
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            Foreground="{DynamicResource SwiftExportBrush.Accent}"
                                            Binding="{Binding Quantity, TargetNullValue='', StringFormat=0.####, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnNotifyDataErrors=False, NotifyOnValidationError=True}"
                                            Width="80"/>

                        <DataGridTextColumn Header="草稿提醒" Binding="{Binding OtherDraftWarning}" Width="230" IsReadOnly="True"/>

                        <DataGridTextColumn Header="描述" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding DescriptionSnapshot}" Width="*" MinWidth="180" IsReadOnly="True"/>

                        <DataGridTextColumn Header="单位" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            Binding="{Binding UnitSnapshot}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


            <!--提示信息-->
            <StackPanel Grid.Row="5">
                <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource SwiftExportBrush.ErrorText}"/>
                <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource SwiftExportBrush.WarningText}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
