<UserControl
    x:Class="SwiftExportClient.Features.Inventory.Inbounds.Views.InboundManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:gridValidation="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:lookup="clr-namespace:SwiftExportClient.Resources.Controls.Filter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:staticEnums="clr-namespace:SwiftExport.Contracts.SysEnums.StaticEnums;assembly=SwiftExport.Contracts"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Inbounds.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InboundManagerViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1440"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  条件筛选区域  -->
        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="入库单管理" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="入库单号,来源单号,自定义采购单号,Sku,LinkSku搜索"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />

                    <ui:Button
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,3*,8,8*,Auto">
            <!--  单头操作区域  -->
            <Grid ColumnDefinitions="80,8,120,8,120,8,Auto,8,*">
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlock}"
                    Text="筛选条件:" />
                <lookup:MultiSelectLookupButton
                    x:Name="DocumentTypesFilter"
                    Grid.Column="2"
                    Height="{DynamicResource SwiftExportControlHeight}"
                    Header="入库类型"
                    ItemsSource="{x:Static staticEnums:InboundDocumentTypes.All}"
                    Placeholder="搜索入库类型"
                    SelectedItems="{Binding SelectedDocumentTypes, Mode=OneWay}">
                    <lookup:MultiSelectLookupButton.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </lookup:MultiSelectLookupButton.ItemTemplate>
                </lookup:MultiSelectLookupButton>

                <lookup:MultiSelectLookupButton
                    x:Name="PostingStatusesFilter"
                    Grid.Column="4"
                    Height="{DynamicResource SwiftExportControlHeight}"
                    Header="过账状态"
                    ItemsSource="{x:Static staticEnums:InboundPostingStatusList.All}"
                    Placeholder="搜索过账状态"
                    SelectedItems="{Binding SelectedPostingStatuses, Mode=OneWay}">
                    <lookup:MultiSelectLookupButton.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </lookup:MultiSelectLookupButton.ItemTemplate>
                </lookup:MultiSelectLookupButton>


                <StackPanel
                    Grid.Column="6"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding AddNewHeaderRowCommand}"
                        Content="新增" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Appearance="Success"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding DeleteSelectedCommand}"
                        Content="删除" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding PostCommand}"
                        Content="过账" />
                    <ui:Button
                        MinWidth="70"
                        Margin="0,0,6,0"
                        VerticalAlignment="Stretch"
                        Appearance="Danger"
                        Command="{Binding ReverseCommand}"
                        Content="反过账" />
                </StackPanel>
            </Grid>

            <!--  单头  -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <DataGrid
                    x:Name="HeaderGrid"
                    Grid.Row="0"
                    gridCore:GridRowHeader.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                    IsEnabled="{Binding CanSelectHeaders}"
                    IsReadOnly="{Binding HeaderReadOnly}"
                    ItemsSource="{Binding Headers.Items}"
                    RowHeight="{DynamicResource DataGridRowHeightSmall}"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionChanged="OnHeaderSelectionChanged"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn
                            Width="45"
                            CanUserSort="False"
                            ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        IsChecked="{Binding DataContext.Headers.IsAllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        IsThreeState="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding DocumentNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="入库单号"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding CreationMode, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="建立方式"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding PostingStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="过账状态"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding LifecycleStatus, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单据状态"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding EditingStatus, Mode=OneWay}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="编辑状态"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding DocumentType, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="入库类型"
                            IsReadOnly="True" />


                        <DataGridTemplateColumn
                            Width="125"
                            ClipboardContentBinding="{Binding ReceiptDate, Mode=OneWay}"
                            Header="收货日期"
                            SortMemberPath="ReceiptDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Stretch"
                                        FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                                        IsEnabled="{Binding CanEditInPage}"
                                        SelectedDate="{Binding ReceiptDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource SwiftExportDataGridDatePicker}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="140"
                            ClipboardContentBinding="{Binding WarehouseNameSnapshot, Mode=OneWay}"
                            Header="目标仓库">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,20">
                                        <TextBlock Style="{StaticResource SwiftExportDataGridTextBlock}" Text="{Binding WarehouseNameSnapshot}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Command="{Binding DataContext.OpenWarehousePickerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Symbol=MoreVertical24}"
                                            Style="{StaticResource MoreVerticalButtonStyleInDataGrid}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding TotalQuantity, StringFormat=N1}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="入库数量"
                            IsReadOnly="True" />


                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="备注" />


                    </DataGrid.Columns>
                </DataGrid>

                <Grid
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    ColumnDefinitions="*,12,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource CaptionTextBlock}"
                        Text="{Binding PageStatus}" />
                    <controls:PageNavigator
                        Grid.Column="2"
                        PageChangeCommand="{Binding PageChangeCommand}"
                        PageSize="{Binding PageSize}"
                        PageSizeOptions="{Binding PageSizeOptions}"
                        TotalCount="{Binding TotalCount}"
                        PageIndex="{Binding PageIndex, Mode=OneWay}" />
                </Grid>
            </Grid>


            <GridSplitter Grid.Row="3" Style="{StaticResource SwiftExportGridSplitterHorizontal}" />

            <Grid Grid.Row="4" RowDefinitions="Auto,8,*">
                <!--  单行操作区域  -->
                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,6,0"
                            VerticalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding OpenInboundSourceDialogCommand}"
                            Content="获取" />
                        <ui:Button
                            MinWidth="70"
                            Margin="0,0,6,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding DeleteSelectedLineCommand}"
                            Content="删除行" />
                    </StackPanel>
                </Grid>
                <!--  单行  -->
                <DataGrid
                    x:Name="LineGrid"
                    Grid.Row="2"
                    gridValidation:GridValidation.IsEnabled="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    CurrentItem="{Binding Lines.SelectedItem, Mode=TwoWay}"
                    FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                    HeadersVisibility="Column"
                    IsReadOnly="{Binding LinesReadOnly}"
                    ItemsSource="{Binding Lines.Items}"
                    RowHeight="{StaticResource DataGridRowHeightMedium}"
                    Style="{StaticResource SwiftExportDataGrid}">
                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="40"
                            Binding="{Binding LineNumber}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="行号"
                            IsReadOnly="True" />

                        <DataGridTemplateColumn
                            Width="45"
                            CanUserSort="False"
                            ClipboardContentBinding="{Binding IsChecked, Mode=OneWay}"
                            HeaderStyle="{StaticResource SwiftExport.DataGridColumnHeaderNoResize}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Left" IsChecked="{Binding DataContext.Lines.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="64"
                            CanUserSort="False"
                            Header="图片">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CachedImage
                                        Width="48"
                                        Height="48"
                                        Margin="2"
                                        DecodePixelWidth="96"
                                        SourcePath="{Binding ImagePath}"
                                        Stretch="Uniform"
                                        Style="{StaticResource SwiftExportCachedImage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding SourceNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="来源单号"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="144"
                            Binding="{Binding BoNo}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="自定义单号"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding SkuSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="Sku"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding LinkSku}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="产品型号"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding OriginalQty, StringFormat=N0}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="原数量"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding RemainingReceivableQty, StringFormat=N0}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Header="待入库"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Quantity, TargetNullValue='', StringFormat=0.####, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False, ValidatesOnNotifyDataErrors=False}"
                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                            Foreground="{DynamicResource UserBusinessTextAccentBrush}"
                            Header="本次入库" />

                        <DataGridTextColumn
                            Width="230"
                            Binding="{Binding OtherDraftWarning}"
                            Header="草稿提醒"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="*"
                            MinWidth="180"
                            Binding="{Binding DescriptionSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="描述"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding UnitSnapshot}"
                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                            Header="单位"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


            <!--  提示信息  -->
            <StackPanel Grid.Row="5">
                <TextBlock Foreground="{DynamicResource UserBusinessTextWarningBrush}" Text="{Binding ValidationSummary}" />
                <TextBlock Foreground="{DynamicResource UserSystemFillColorCautionBrush}" Text="{Binding ResultSummary}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
