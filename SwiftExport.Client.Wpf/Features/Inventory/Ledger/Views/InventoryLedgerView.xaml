<UserControl x:Class="SwiftExportClient.Features.Inventory.Ledger.Views.InventoryLedgerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components">
    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,*,Auto">
        <TextBlock Text="库存流水" Style="{StaticResource TitleTextBlock}"/>
        <Grid Grid.Row="2" ColumnDefinitions="180,8,200,8,160,8,180,8,160,8,120,8,120,8,Auto">
            <TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU、仓库、来源单据"/>
            <supplierComponents:SupplierAutoSuggestComboBox Grid.Column="2" ItemsSource="{Binding SupplierOptions}" SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" Placeholder="全部供应商" AutomationProperties.Name="库存流水供应商筛选"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" ToolTip="全部活动虚拟仓"/>
            <ComboBox Grid.Column="6" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding TransactionType}"/>
            <TextBox Grid.Column="8" Text="{Binding SourceDocumentNo,UpdateSourceTrigger=PropertyChanged}" ToolTip="业务单号"/>
            <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="10" SelectedDate="{Binding DateFrom}"/>
            <DatePicker Style="{StaticResource SwiftExportDatePicker}" Grid.Column="12" SelectedDate="{Binding DateTo}"/>
            <Button Grid.Column="14" Content="查询" Command="{Binding SearchCommand}"/>
        </Grid>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="90"/>
                <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseCode}" Width="120"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                <DataGridTextColumn Header="类型" Binding="{Binding TransactionType}" Width="190"/>
                <DataGridTextColumn Header="变化" Binding="{Binding QuantityDelta,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="余额" Binding="{Binding BalanceAfter,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="来源类型" Binding="{Binding SourceDocumentType}" Width="140"/>
                <DataGridTextColumn Header="来源单号" Binding="{Binding SourceDocumentNo}" Width="160"/>
                <DataGridTextColumn Header="反向原流水" Binding="{Binding ReversalOfLedgerId}" Width="150"/>
                <DataGridTextColumn Header="替代原流水" Binding="{Binding ReplacementOfLedgerId}" Width="150"/>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="5" Margin="0,8,0,0" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
            <Button Grid.Column="1" Content="上一页" Command="{Binding PreviousPageCommand}"/>
            <Button Grid.Column="3" Content="下一页" Command="{Binding NextPageCommand}"/>
        </Grid>
    </Grid>
</UserControl>
