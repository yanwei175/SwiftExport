<UserControl
    x:Class="SwiftExportClient.Features.Inventory.Ledger.Views.InventoryLedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ledgerConverters="clr-namespace:SwiftExportClient.Features.Inventory.Ledger.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Height="1080"
    d:Width="1920"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ledgerConverters:InventorySourceDocumentTypeDisplayConverter x:Key="InventorySourceDocumentTypeDisplayConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="库存流水" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="SKU、仓库、来源单据"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,8,*,Auto">
            <Grid Grid.Row="2" ColumnDefinitions="200,8,160,8,180,8,160,8,120,8,120,8,Auto">
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="业务单号"
                    Text="{Binding SourceDocumentNo, UpdateSourceTrigger=PropertyChanged}" />

                <supplierComponents:SupplierAutoSuggestComboBox
                    Grid.Column="2"
                    AutomationProperties.Name="库存流水供应商筛选"
                    ItemsSource="{Binding SupplierOptions}"
                    Placeholder="全部供应商"
                    SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"
                    StretchToHost="True" />

                <ComboBox
                    Grid.Column="4"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding WarehouseOptions}"
                    SelectedItem="{Binding SelectedWarehouse}"
                    ToolTip="全部活动虚拟仓" />

                <ComboBox
                    Grid.Column="6"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding TransactionTypes}"
                    SelectedValue="{Binding TransactionType, Mode=TwoWay}"
                    SelectedValuePath="Value">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Value, Converter={StaticResource EnumDescriptionConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                                <Setter Property="Text" Value="全部" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <DatePicker
                    Grid.Column="8"
                    SelectedDate="{Binding DateFrom}"
                    SelectedDateFormat="Short" />
                <DatePicker
                    Grid.Column="10"
                    SelectedDate="{Binding DateTo}"
                    SelectedDateFormat="Short" />
            </Grid>
            <DataGrid
                Grid.Row="4"
                Padding="2,0"
                AutoGenerateColumns="False"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                RowHeight="{DynamicResource DataGridRowHeightSmall}">
                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Sequence}"
                        Header="序号" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding OccurredDate, StringFormat=yyyy-MM-dd HH:mm}"
                        Header="时间" />

                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding WarehouseCode}"
                        Header="虚拟仓" />

                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Sku}"
                        Header="SKU" />

                    <DataGridTextColumn
                        Width="190"
                        Binding="{Binding TransactionType, Converter={StaticResource EnumDescriptionConverter}}"
                        Header="类型" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding QuantityDelta, StringFormat=N1}"
                        Header="变化">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource UserBusinessTextAccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuantityDelta, Converter={StaticResource RealNumberSignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding QuantityDelta, Converter={StaticResource RealNumberSignConverter}}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding BalanceAfter, StringFormat=N1}"
                        Header="余额">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource UserBusinessTextAccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BalanceAfter, Converter={StaticResource RealNumberSignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding BalanceAfter, Converter={StaticResource RealNumberSignConverter}}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding SourceDocumentType, Converter={StaticResource InventorySourceDocumentTypeDisplayConverter}}"
                        Header="来源类型" />

                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding SourceDocumentNo}"
                        Header="来源单号" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding ReversalOfLedgerId}"
                        Header="反向原流水" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding ReplacementOfLedgerId}"
                        Header="替代原流水" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Reason}"
                        Header="原因" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid
                Grid.Row="5"
                Margin="0,8,0,0"
                ColumnDefinitions="*,12,Auto">
                <TextBlock Foreground="Gray" Text="{Binding ResultSummary}" />
                <controls:PageNavigator
                    Grid.Column="2"
                    PageChangeCommand="{Binding PageChangeCommand}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageIndex="{Binding PageIndex}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
