<UserControl x:Class="SwiftExportClient.Features.Inventory.Ledger.Views.InventoryLedgerView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:ledgerConverters="clr-namespace:SwiftExportClient.Features.Inventory.Ledger.Converters"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid" 
             xmlns:gridNumeric="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns.Numeric;assembly=SwiftExport.Wpf.EnterpriseGrid"             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Width="1920" d:Height="1080">

    <UserControl.Resources>
        <ledgerConverters:InventorySourceDocumentTypeDisplayConverter x:Key="InventorySourceDocumentTypeDisplayConverter"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="库存流水" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center" />
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="SKU、仓库、来源单据">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,8,*,Auto">
            <Grid Grid.Row="2" ColumnDefinitions="200,8,160,8,180,8,160,8,120,8,120,8,Auto">
                <ui:TextBox Grid.Column="0" 
                         Text="{Binding SourceDocumentNo,UpdateSourceTrigger=PropertyChanged}" 
                         PlaceholderText="业务单号"/>
                
                <supplierComponents:SupplierAutoSuggestComboBox 
                                    StretchToHost="True"
                                    Grid.Column="2" ItemsSource="{Binding SupplierOptions}" 
                                    SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" 
                                    Placeholder="全部供应商" 
                                    AutomationProperties.Name="库存流水供应商筛选"/>
                
                <ComboBox Grid.Column="4" 
                          ItemsSource="{Binding WarehouseOptions}" 
                          SelectedItem="{Binding SelectedWarehouse}" 
                          DisplayMemberPath="Name" VerticalContentAlignment="Center"
                          ToolTip="全部活动虚拟仓"/>
                
                <ComboBox Grid.Column="6" 
                          ItemsSource="{Binding TransactionTypes}" 
                          SelectedItem="{Binding TransactionType}" 
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Text" Value="全部"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <DatePicker Grid.Column="8" SelectedDateFormat="Short" SelectedDate="{Binding DateFrom}"/>
                <DatePicker Grid.Column="10" SelectedDateFormat="Short"  SelectedDate="{Binding DateTo}"/>
            </Grid>
            <DataGrid Grid.Row="4" 
                      ItemsSource="{Binding Items}" 
                      GridLinesVisibility="Horizontal"
                      RowHeight="{DynamicResource DataGridRowHeightSmall}"
                      FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                      Padding="2,0"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="50"/>

                    <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>

                    <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseCode}" Width="120"/>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160"/>

                    <DataGridTextColumn Header="类型" Binding="{Binding TransactionType,Converter={StaticResource EnumDescriptionConverter}}" Width="190"/>

                    <DataGridTextColumn Header="变化" 
                                        Binding="{Binding QuantityDelta,StringFormat=N1}" 
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource UserBusinessTextAccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuantityDelta, Converter={StaticResource RealNumberSignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding QuantityDelta,  Converter={StaticResource RealNumberSignConverter}}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="余额" 
                                    Binding="{Binding BalanceAfter,StringFormat=N1}" 
                                    Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource UserBusinessTextAccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BalanceAfter, Converter={StaticResource RealNumberSignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextCriticalBrush}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding BalanceAfter,  Converter={StaticResource RealNumberSignConverter}}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource UserBusinessTextSuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="来源类型" Binding="{Binding SourceDocumentType,Converter={StaticResource InventorySourceDocumentTypeDisplayConverter}}" Width="160"/>

                    <DataGridTextColumn Header="来源单号" Binding="{Binding SourceDocumentNo}" Width="160"/>

                    <DataGridTextColumn Header="反向原流水" Binding="{Binding ReversalOfLedgerId}" Width="150"/>

                    <DataGridTextColumn Header="替代原流水" Binding="{Binding ReplacementOfLedgerId}" Width="150"/>

                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5" Margin="0,8,0,0" ColumnDefinitions="*,12,Auto">
                <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
                <controls:PageNavigator Grid.Column="2"
                                        TotalCount="{Binding TotalCount}"
                                        PageIndex="{Binding PageIndex}"
                                        PageSize="{Binding PageSize}"
                                        PageChangeCommand="{Binding PageChangeCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
