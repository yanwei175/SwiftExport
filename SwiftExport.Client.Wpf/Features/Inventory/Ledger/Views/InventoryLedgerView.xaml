<UserControl x:Class="SwiftExportClient.Features.Inventory.Ledger.Views.InventoryLedgerView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:gridColumns="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridCore="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Core;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridOperations="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Operations;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridSelection="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Selection;assembly=SwiftExport.Wpf.EnterpriseGrid"
             xmlns:gridValidation="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Validation;assembly=SwiftExport.Wpf.EnterpriseGrid" 
             xmlns:gridNumeric="clr-namespace:SwiftExport.Wpf.EnterpriseGrid.Columns.Numeric;assembly=SwiftExport.Wpf.EnterpriseGrid"             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Width="1920" d:Height="1080">

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="库存流水" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center" />
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="SKU、仓库、来源单据">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,Auto,8,*,Auto">
            <Grid Grid.Row="2" ColumnDefinitions="200,8,160,8,180,8,160,8,120,8,120,8,Auto">
                <ui:TextBox Grid.Column="0" 
                         Text="{Binding SourceDocumentNo,UpdateSourceTrigger=PropertyChanged}" 
                         PlaceholderText="业务单号"/>
                
                <supplierComponents:SupplierAutoSuggestComboBox Grid.Column="2" ItemsSource="{Binding SupplierOptions}" SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" Placeholder="全部供应商" AutomationProperties.Name="库存流水供应商筛选"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" ToolTip="全部活动虚拟仓"/>
                <ComboBox Grid.Column="6" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding TransactionType}"/>
                <DatePicker Grid.Column="8"  Style="{StaticResource SwiftExportDatePicker}" SelectedDate="{Binding DateFrom}"/>
                <DatePicker Grid.Column="10" Style="{StaticResource SwiftExportDatePicker}"  SelectedDate="{Binding DateTo}"/>
                <ui:Button Grid.Column="12" Content="查询" Command="{Binding SearchCommand}" Appearance="Primary"/>
            </Grid>
            <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding Items}" 
                  Background="{DynamicResource MicaControlBrush}"
                  RowHeight="{DynamicResource DataGridRowHeightSmall}"
                  FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SwiftExportBrush.Border}"
                  Padding="2,0"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="50"/>

                    <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>

                    <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseCode}" Width="120"/>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160"/>

                    <DataGridTextColumn Header="类型" Binding="{Binding TransactionType}" Width="190"/>

                    <DataGridTextColumn Header="变化" 
                                    Binding="{Binding QuantityDelta,StringFormat=N1}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>

                    <DataGridTextColumn Header="余额" 
                                    Binding="{Binding BalanceAfter,StringFormat=N1}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>

                    <DataGridTextColumn Header="来源类型" Binding="{Binding SourceDocumentType}" Width="140"/>

                    <DataGridTextColumn Header="来源单号" Binding="{Binding SourceDocumentNo}" Width="160"/>

                    <DataGridTextColumn Header="反向原流水" Binding="{Binding ReversalOfLedgerId}" Width="150"/>

                    <DataGridTextColumn Header="替代原流水" Binding="{Binding ReplacementOfLedgerId}" Width="150"/>

                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5" Margin="0,8,0,0" ColumnDefinitions="*,Auto,8,Auto">
                <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
                <Button Grid.Column="1" Content="上一页" Command="{Binding PreviousPageCommand}"/>
                <Button Grid.Column="3" Content="下一页" Command="{Binding NextPageCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
