<UserControl
    x:Class="SwiftExportClient.Features.Inventory.Balances.Views.InventoryBalancesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Balances.ViewModels"
    xmlns:warehouseComponents="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Components"
    d:DataContext="{d:DesignInstance vm:InventoryBalancesViewModel}"
    d:Height="800"
    d:Width="1000"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlock}"
                    Text="库存余额" />
                <!--  搜索框  -->
                <ui:TextBox
                    Grid.Column="1"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="供应商、仓库、SKU、产品"
                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button
                        Grid.Column="2"
                        MinWidth="70"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding SearchCommand}"
                        Content="查询" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,2*,8,*,8,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="220,8,220,8,Auto,8,Auto,*,Auto">

                <supplierComponents:SupplierAutoSuggestComboBox
                    Grid.Column="0"
                    AutomationProperties.Name="库存余额供应商筛选"
                    ItemsSource="{Binding SupplierOptions}"
                    Placeholder="全部供应商"
                    SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}" />

                <warehouseComponents:WarehouseAutoSuggestComboBox
                    Grid.Column="2"
                    ItemsSource="{Binding WarehouseOptions}"
                    Placeholder="全部仓库"
                    SelectedWarehouse="{Binding SelectedWarehouse, Mode=TwoWay}"
                    ToolTip="清空选择可查询全部仓库" />

                <CheckBox
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Content="仅非零"
                    IsChecked="{Binding NonZeroOnly}" />

                <ui:Button
                    Grid.Column="6"
                    Appearance="Primary"
                    Command="{Binding LoadTraceCommand}"
                    Content="加载追踪" />
            </Grid>
            <DataGrid
                Grid.Row="2"
                Padding="2,0"
                gridCore:GridRowHeader.ShowRowNumberInColumn="True"
                AutoGenerateColumns="False"
                Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                RowHeight="{DynamicResource DataGridRowHeightMedium}"
                SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>

                    <DataGridTemplateColumn
                        Width="64"
                        CanUserSort="False"
                        Header="图片">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage
                                    Width="48"
                                    Height="48"
                                    Margin="2"
                                    DecodePixelWidth="96"
                                    SourcePath="{Binding ImagePath}"
                                    Stretch="Uniform"
                                    Style="{StaticResource SwiftExportCachedImage}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding WarehouseName}"
                        Header="虚拟仓" />

                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding SupplierName}"
                        Header="供应商" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Sku}"
                        Header="SKU" />

                    <DataGridTextColumn
                        Width="250"
                        Binding="{Binding ProductName}"
                        Header="描述" />

                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding Unit}"
                        Header="单位" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding OnHandQty, StringFormat=N1}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="账面数量" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding AvailableQty, StringFormat=N1}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="可用数量" />

                    <DataGridTextColumn Width="*" Header="PlaceHolder" />

                </DataGrid.Columns>
            </DataGrid>
            <DataGrid
                Grid.Row="4"
                Padding="2,0"
                AutoGenerateColumns="False"
                Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                ItemsSource="{Binding TraceItems}"
                RowHeight="{DynamicResource DataGridRowHeightSmall}">
                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding OccurredDate, StringFormat=yyyy-MM-dd HH:mm}"
                        Header="时间" />

                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding TransactionType, Converter={StaticResource EnumDescriptionConverter}}"
                        Header="类型" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding QuantityDelta, StringFormat=N1}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="变化" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding BalanceAfter, StringFormat=N1}"
                        ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                        Header="余额" />

                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding SourceDocumentNo}"
                        Header="来源单据" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Reason}"
                        ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                        Header="原因" />

                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,8,Auto,24,Auto,8,Auto">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="{Binding ResultSummary}" />
                    <TextBlock Foreground="Gray" Text="{Binding ReconciliationSummary}" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Appearance="Secondary"
                    Command="{Binding PreviousPageCommand}"
                    Content="上一页" />
                <ui:Button
                    Grid.Column="3"
                    Appearance="Secondary"
                    Command="{Binding NextPageCommand}"
                    Content="下一页" />
                <ui:Button
                    Grid.Column="5"
                    Appearance="Secondary"
                    Command="{Binding PreviousTracePageCommand}"
                    Content="Trace 上一页" />
                <ui:Button
                    Grid.Column="7"
                    Appearance="Secondary"
                    Command="{Binding NextTracePageCommand}"
                    Content="Trace 下一页" />
            </Grid>
        </Grid>

    </Grid>
</UserControl>
