<UserControl x:Class="SwiftExportClient.Features.Inventory.Balances.Views.InventoryBalancesView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftExportClient.Resources.Controls"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:warehouseComponents="clr-namespace:SwiftExportClient.Features.Inventory.WarehouseSites.Components"
             xmlns:gridCore="clr-namespace:SwiftExportClient.Resources.Behaviors"
             xmlns:vm="clr-namespace:SwiftExportClient.Features.Inventory.Balances.ViewModels"
             mc:Ignorable="d" d:Width="1000" d:Height="800" d:DataContext="{d:DesignInstance vm:InventoryBalancesViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid RowDefinitions="Auto,8, *">
            <Grid ColumnDefinitions="3*,3*,3*">
                <TextBlock Text="库存余额" Style="{StaticResource SubtitleTextBlock}" VerticalAlignment="Center" />
                <!--搜索框-->
                <ui:TextBox Grid.Column="1"
                            Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            PlaceholderText="供应商、仓库、SKU、产品">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <ui:Button Grid.Column="2"  Appearance="Primary" Margin="8,0,0,0"
                            Content="查询" VerticalAlignment="Stretch"
                            Command="{Binding SearchCommand}" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,8,2*,8,*,8,Auto">
            
            <Grid Grid.Row="0" ColumnDefinitions="220,8,220,8,Auto,8,Auto,*,Auto">

                <supplierComponents:SupplierAutoSuggestComboBox 
                        Grid.Column="0" 
                        ItemsSource="{Binding SupplierOptions}" 
                        SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" 
                        Placeholder="全部供应商" 
                        AutomationProperties.Name="库存余额供应商筛选"/>

                <warehouseComponents:WarehouseAutoSuggestComboBox Grid.Column="2"
                          ItemsSource="{Binding WarehouseOptions}" 
                          SelectedWarehouse="{Binding SelectedWarehouse,Mode=TwoWay}"
                          Placeholder="全部仓库"
                          ToolTip="清空选择可查询全部仓库"/>

                <CheckBox Grid.Column="4" 
                          IsChecked="{Binding NonZeroOnly}" 
                          Content="仅非零" 
                          VerticalAlignment="Center"/>

                <ui:Button Grid.Column="6" 
                       Content="加载追踪" 
                       Appearance="Primary"
                       Command="{Binding LoadTraceCommand}"/>
            </Grid>
            <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Items}" 
                  SelectedItem="{Binding SelectedItem}" 
                  Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"                  
                  FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                  RowHeight="{DynamicResource DataGridRowHeightMedium}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                  Padding="2,0"
                  GridLinesVisibility="Horizontal"
                  AutoGenerateColumns="False"
                  gridCore:GridRowHeader.ShowRowNumberInColumn="True"
                  IsReadOnly="True" >
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="图片" Width="64" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:CachedImage Width="48" Height="48" Margin="2"
                                                  Style="{StaticResource SwiftExportCachedImage}"
                                                  Stretch="Uniform" DecodePixelWidth="96"
                                                  SourcePath="{Binding ImagePath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="140"/>

                    <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="110"/>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/>

                    <DataGridTextColumn Header="描述" Binding="{Binding ProductName}" Width="250"/>

                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>

                    <DataGridTextColumn Header="账面数量" 
                                    Binding="{Binding OnHandQty,StringFormat=N1}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>
                    <DataGridTextColumn Header="可用数量" 
                                    Binding="{Binding AvailableQty,StringFormat=N1}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>

                    <DataGridTextColumn Header="PlaceHolder" Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="4" 
                  ItemsSource="{Binding TraceItems}"
                  Background="{DynamicResource UserLayerOnMicaBaseAltFillColorDefaultBrush}"
                  FontSize="{DynamicResource SwiftExportDefaltFontSize}"
                  RowHeight="{DynamicResource DataGridRowHeightSmall}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource UserControlStrokeColorDefaultBrush}"
                  Padding="2,0"
                  GridLinesVisibility="Horizontal"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  >
                <DataGrid.Columns>

                    <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>

                    <DataGridTextColumn Header="类型" Binding="{Binding TransactionType,Converter={StaticResource EnumDescriptionConverter}}" Width="220"/>

                    <DataGridTextColumn Header="变化" 
                                    Binding="{Binding QuantityDelta,StringFormat=N1}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>

                    <DataGridTextColumn Header="余额" Binding="{Binding BalanceAfter,StringFormat=N1}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    Width="100"/>

                    <DataGridTextColumn Header="来源单据" Binding="{Binding SourceDocumentNo}" Width="160"/>

                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,8,Auto,24,Auto,8,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
                    <TextBlock Text="{Binding ReconciliationSummary}" Foreground="Gray"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="上一页" Command="{Binding PreviousPageCommand}" Appearance="Secondary"/>
                <ui:Button Grid.Column="3" Content="下一页" Command="{Binding NextPageCommand}" Appearance="Secondary"/>
                <ui:Button Grid.Column="5" Content="Trace 上一页" Command="{Binding PreviousTracePageCommand}" Appearance="Secondary"/>
                <ui:Button Grid.Column="7" Content="Trace 下一页" Command="{Binding NextTracePageCommand}" Appearance="Secondary"/>
            </Grid>
        </Grid>
        
    </Grid>
</UserControl>
