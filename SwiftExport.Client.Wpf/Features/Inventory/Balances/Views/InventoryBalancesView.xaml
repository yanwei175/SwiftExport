<UserControl x:Class="SwiftExportClient.Features.Inventory.Balances.Views.InventoryBalancesView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:supplierComponents="clr-namespace:SwiftExportClient.Features.Suppliers.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,2*,8,*,8,Auto">
        <TextBlock Text="库存余额" Style="{StaticResource TitleTextBlock}"/>
        <Grid Grid.Row="2" ColumnDefinitions="220,8,220,8,180,8,90,8,Auto,*,Auto">
            <TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="供应商、仓库、SKU、产品"/>
            <supplierComponents:SupplierAutoSuggestComboBox Grid.Column="2" ItemsSource="{Binding SupplierOptions}" SelectedSupplier="{Binding SelectedSupplier,Mode=TwoWay}" Placeholder="全部供应商" AutomationProperties.Name="库存余额供应商筛选"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding WarehouseOptions}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" ToolTip="全部活动虚拟仓"/>
            <CheckBox Grid.Column="6" IsChecked="{Binding NonZeroOnly}" Content="仅非零" VerticalAlignment="Center"/>
            <ui:Button Grid.Column="8"
                       Content="查询" 
                       Command="{Binding SearchCommand}"
                       Appearance="Primary"/>
            <ui:Button Grid.Column="10" Content="加载 Trace" Command="{Binding LoadTraceCommand}" Appearance="Secondary"/>
        </Grid>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="150"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding SupplierName}" Width="150"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="220"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                <DataGridTextColumn Header="账面数量" Binding="{Binding OnHandQty,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="可用数量" Binding="{Binding AvailableQty,StringFormat=N4}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="6" ItemsSource="{Binding TraceItems}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                <DataGridTextColumn Header="类型" Binding="{Binding TransactionType}" Width="170"/>
                <DataGridTextColumn Header="变化" Binding="{Binding QuantityDelta,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="余额" Binding="{Binding BalanceAfter,StringFormat=N4}" Width="100"/>
                <DataGridTextColumn Header="来源单据" Binding="{Binding SourceDocumentNo}" Width="160"/>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="8" ColumnDefinitions="*,Auto,8,Auto,24,Auto,8,Auto">
            <StackPanel>
                <TextBlock Text="{Binding ResultSummary}" Foreground="Gray"/>
                <TextBlock Text="{Binding ReconciliationSummary}" Foreground="Gray"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="上一页" Command="{Binding PreviousPageCommand}" Appearance="Secondary"/>
            <ui:Button Grid.Column="3" Content="下一页" Command="{Binding NextPageCommand}" Appearance="Secondary"/>
            <ui:Button Grid.Column="5" Content="Trace 上一页" Command="{Binding PreviousTracePageCommand}" Appearance="Secondary"/>
            <ui:Button Grid.Column="7" Content="Trace 下一页" Command="{Binding NextTracePageCommand}" Appearance="Secondary"/>
        </Grid>
    </Grid>
</UserControl>
