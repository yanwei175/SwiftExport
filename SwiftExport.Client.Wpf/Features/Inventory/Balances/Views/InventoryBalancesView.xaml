<UserControl x:Class="SwiftExportClient.Features.Inventory.Balances.Views.InventoryBalancesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12" RowDefinitions="Auto,8,Auto,8,2*,8,*,8,Auto">
  <TextBlock Text="库存余额" Style="{StaticResource TitleTextBlock}"/>
  <Grid Grid.Row="2" ColumnDefinitions="260,8,110,8,Auto,*,Auto"><TextBox Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="供应商、仓库、SKU、产品"/><CheckBox Grid.Column="2" IsChecked="{Binding NonZeroOnly}" Content="仅非零" VerticalAlignment="Center"/><Button Grid.Column="4" Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}"/><Button Grid.Column="6" Content="加载 Trace" Command="{Binding LoadTraceCommand}"/></Grid>
  <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}"><DataGrid.Columns><DataGridTextColumn Header="虚拟仓" Binding="{Binding WarehouseName}" Width="150"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="220"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="账面数量" Binding="{Binding OnHandQty,StringFormat=N4}" Width="100"/><DataGridTextColumn Header="可用数量" Binding="{Binding AvailableQty,StringFormat=N4}" Width="100"/></DataGrid.Columns></DataGrid>
  <DataGrid Grid.Row="6" ItemsSource="{Binding TraceItems}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource SwiftExportDataGrid}"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding OccurredDate,StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="类型" Binding="{Binding TransactionType}" Width="170"/><DataGridTextColumn Header="变化" Binding="{Binding QuantityDelta,StringFormat=N4}" Width="100"/><DataGridTextColumn Header="余额" Binding="{Binding BalanceAfter,StringFormat=N4}" Width="100"/><DataGridTextColumn Header="来源单据" Binding="{Binding SourceDocumentNo}" Width="160"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="8"><TextBlock Text="管理员期初余额（必须先预览再过账）" FontWeight="SemiBold"/><WrapPanel Margin="0,4,0,0"><TextBox Width="220" Text="{Binding OpeningWarehouseId}" ToolTip="仓库 Uid"/><TextBox Width="220" Margin="8,0,0,0" Text="{Binding OpeningProductId}" ToolTip="产品 Uid"/><TextBox Width="100" Margin="8,0,0,0" Text="{Binding OpeningQuantity}" ToolTip="数量"/><TextBox Width="220" Margin="8,0,0,0" Text="{Binding OpeningReason}" ToolTip="原因"/><Button Margin="8,0,0,0" Content="预览" Command="{Binding PreviewOpeningCommand}"/><Button Margin="4,0,0,0" Content="强确认过账" Command="{Binding PostOpeningCommand}" Style="{StaticResource AccentButton}"/></WrapPanel><TextBlock Text="{Binding ResultSummary}" Margin="0,4,0,0" Foreground="Gray"/></StackPanel>
 </Grid>
</UserControl>
