<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwiftExport.Client.Wpf\SwiftExport.Client.Wpf.csproj" />
    <ProjectReference Include="..\SwiftExport.WebApi\SwiftExport.WebApi.csproj" />
    <!-- 后端命名空间仅供 HTTP 夹具通过别名使用，避免影响既有 WPF Application 引用。 -->
    <ProjectReference Include="..\SwiftExport.Application\SwiftExport.Application.csproj" Aliases="backendApplication" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="..\SwiftExport.Client.Wpf\App.xaml" LogicalName="DatePickerTests.App.xaml" />
    <EmbeddedResource Include="Services\Files\**\Fixtures\*.xlsx" />
    <EmbeddedResource Include="..\模板\Excel导出\purchase-order-vsto-demo\v1\模板.xlsx"
                      LogicalName="PurchaseOrderVstoDemo.Template.xlsx" />
  </ItemGroup>
</Project>
