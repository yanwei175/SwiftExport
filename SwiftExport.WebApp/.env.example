# 开发服务器使用的后端代理目标，不进入客户端包。
API_PROXY_TARGET=https://localhost:7286
# npm run dev 自动复用受信任 .NET 开发证书，入口 https://localhost:5173。
# 验收入口 https://localhost:4173；证书/私钥仅放忽略 .artifacts/https，不提交。
# 未有可信证书时由用户执行 dotnet dev-certs https --trust，脚本不自动改变信任。
# 骨架验收页仅由明确启用的开发/验收构建提供；默认关闭。
VITE_ENABLE_WORKSPACE_PROBES=false
