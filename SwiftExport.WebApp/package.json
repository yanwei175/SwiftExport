{
  "name": "swiftexport-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "node scripts/静态预览.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check app tests scripts *.ts *.js *.mjs *.json",
    "generate": "orval --config orval.config.mjs",
    "generate:check": "node scripts/核对生成产物.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:paths": "node scripts/核对工程边界.mjs",
    "verify:static": "node scripts/核对静态发布.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@tanstack/react-query": "5.104.1",
    "antd": "6.6.5",
    "dayjs": "1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "orval": "8.40.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.13.0"
}
