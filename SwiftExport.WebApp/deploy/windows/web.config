<?xml version="1.0" encoding="utf-8"?>
<!-- IIS + URL Rewrite/ARR 模板；独立站点提供 build/client，不修改既有 API 站点。 -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="API根禁止页面回退" stopProcessing="true">
          <match url="^api$" /><action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="同源API代理" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:5057/api/{R:1}" />
        </rule>
        <rule name="文件服务需另按既有部署接线" stopProcessing="true">
          <match url="^files(/.*)?$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="资源禁止SPA回退" stopProcessing="true">
          <match url=".*\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|json|map)$" />
          <action type="None" />
        </rule>
        <rule name="SPA页面导航" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol><customHeaders><add name="Cache-Control" value="no-cache" /></customHeaders></httpProtocol>
  </system.webServer>
  <location path="assets"><system.webServer><httpProtocol><customHeaders><remove name="Cache-Control" /><add name="Cache-Control" value="public, max-age=31536000, immutable" /></customHeaders></httpProtocol></system.webServer></location>
</configuration>
