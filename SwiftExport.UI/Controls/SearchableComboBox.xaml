<UserControl x:Class="SwiftExport.UI.Controls.SearchableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="uc">
    <ComboBox x:Name="MainComboBox"
              ItemsSource="{Binding FilteredView, ElementName=uc}" 
              SelectedItem="{Binding SelectedItem, ElementName=uc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              
              IsEditable="True"
              StaysOpenOnEdit="True"
              IsTextSearchEnabled="False"
              
              Text="{Binding SearchText, ElementName=uc, UpdateSourceTrigger=PropertyChanged}"
              
              DropDownClosed="MainComboBox_DropDownClosed"
              PreviewKeyUp="MainComboBox_PreviewKeyUp"
              
              Height="28" VerticalContentAlignment="Center">
    </ComboBox>
</UserControl>