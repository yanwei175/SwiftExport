<UserControl x:Class="MateWpfThemes.FW.Controls.SearchableListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl">

    <Border Background="White" BorderBrush="{DynamicResource Brush_Border_Light}" BorderThickness="1" CornerRadius="4" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Margin="5" Padding="5,4" 
                     TextChanged="SearchBox_TextChanged" 
                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                     VerticalContentAlignment="Center" />

            <ListBox x:Name="ResultListBox" Grid.Row="1" Margin="5,0,5,5" MinHeight="200" MaxHeight="300"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewKeyDown="ResultListBox_PreviewKeyDown"
                     PreviewMouseLeftButtonUp="ResultListBox_PreviewMouseLeftButtonUp"
                     ItemsSource="{Binding ItemsSource, ElementName=RootControl, IsAsync=True}"
                     DisplayMemberPath="{Binding DisplayMemberPath, ElementName=RootControl}">
                <ListBox.Background>
                    <SolidColorBrush Color="White" Opacity="1"/>
                </ListBox.Background>

                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
        </Grid>
    </Border>
</UserControl>