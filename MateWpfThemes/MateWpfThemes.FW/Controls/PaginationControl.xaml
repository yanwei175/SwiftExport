<UserControl x:Class="MateWpfThemes.FW.Controls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              mc:Ignorable="d"
             x:Name="Root">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">

        <TextBlock Text="共 " Foreground="{DynamicResource Brush_Txt_Primary}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalCount, ElementName=Root, Mode=OneWay}" Foreground="{DynamicResource Brush_Txt_Primary}" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text=" 条数据" Foreground="{DynamicResource Brush_Txt_Primary}" VerticalAlignment="Center" Margin="0,0,15,0"/>

        <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush_Txt_Secondary}" Margin="0,0,15,0" VerticalAlignment="Center"/>

        <TextBlock Text="每页 " VerticalAlignment="Center" Foreground="{DynamicResource Brush_Txt_Primary}"/>

        <ComboBox Style="{DynamicResource BaseComboBox}" Background="Transparent" Width="55" Margin="5,0" Padding="4,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                  ItemsSource="{Binding PageSizeOptions, ElementName=Root, Mode=OneWay}"
                  SelectedItem="{Binding PageSize, ElementName=Root, Mode=TwoWay}"/>
        
        <TextBlock Text="条" VerticalAlignment="Center" Foreground="{DynamicResource Brush_Txt_Primary}" Margin="0,0,15,0"/>

        <Button Content="首页" Style="{DynamicResource ButtonText}" 
                IsEnabled="{Binding CanGoBack, ElementName=Root, Mode=OneWay}" 
                Command="{Binding FirstPageCommand, ElementName=Root}"/>

        <Button Content="上一页" Style="{DynamicResource ButtonText}" 
                IsEnabled="{Binding CanGoBack, ElementName=Root, Mode=OneWay}" 
                Command="{Binding PrevPageCommand, ElementName=Root}"/>

        <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Brush_Txt_Primary}">
            <Run Text="{Binding PageIndex, ElementName=Root, Mode=OneWay}"/>
            <Run Text="/" Foreground="{DynamicResource Brush_Txt_Secondary}"/>
            <Run Text="{Binding TotalPages, ElementName=Root, Mode=OneWay}"/>
        </TextBlock>

        <Button Content="下一页" Style="{DynamicResource ButtonText}" 
                IsEnabled="{Binding CanGoForward, ElementName=Root, Mode=OneWay}" 
                Command="{Binding NextPageCommand, ElementName=Root}"/>

        <Button Content="尾页" Style="{DynamicResource ButtonText}" 
                IsEnabled="{Binding CanGoForward, ElementName=Root, Mode=OneWay}" 
                Command="{Binding LastPageCommand, ElementName=Root}"/>
        
        <Rectangle Width="1" Height="14" Fill="{DynamicResource Neutral1Brush}" Margin="15,0,15,0" VerticalAlignment="Center"/>

        <TextBlock Text="当前第 " VerticalAlignment="Center" Foreground="{DynamicResource Brush_Txt_Primary}"/>

        <ComboBox Style="{DynamicResource  BaseComboBox}" Background="Transparent" Width="60" Margin="5,0" Padding="4,2"
                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                  ItemsSource="{Binding PageNumbers, ElementName=Root, Mode=OneWay}"
                  SelectedItem="{Binding PageIndex, ElementName=Root, Mode=TwoWay}"/>

        <TextBlock Text="页" VerticalAlignment="Center" Foreground="{DynamicResource Brush_Txt_Primary}"/>
    </StackPanel>
</UserControl>