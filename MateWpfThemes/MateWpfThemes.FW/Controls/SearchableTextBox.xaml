<UserControl x:Class="MateWpfThemes.FW.Controls.SearchableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assist="clr-namespace:MateWpfThemes.FW.AttachedProperties"
             Name="uc">
    <Grid>
        <Grid>
            <TextBox x:Name="InputTextBox"
             Text="{Binding Text, ElementName=uc, UpdateSourceTrigger=PropertyChanged}"
             PreviewKeyDown="InputTextBox_PreviewKeyDown"
             TextChanged="InputTextBox_TextChanged"
             LostKeyboardFocus="InputTextBox_LostKeyboardFocus"
             VerticalContentAlignment="Center"
             Padding="4,0,25,0" 
             assist:TextBoxAssist.Placeholder="{Binding Placeholder, ElementName=uc}"
             Height="{Binding ActualHeight, ElementName=uc}"/>

            <Button x:Name="BtnClear"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,6,0"
            Width="16" Height="16"
            Focusable="False"
            Cursor="Hand"
            Background="Transparent"
            BorderThickness="0"
            Click="BtnClear_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Path Data="M0,0 L8,8 M8,0 L0,8" 
                                      Stroke="#C0C4CC" 
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="8" Height="8"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Popup x:Name="DropdownPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=InputTextBox}"
               Placement="Bottom"
               Width="{Binding ActualWidth, ElementName=InputTextBox}"
               MaxHeight="250"
               Focusable="False"
               PopupAnimation="Fade">

            <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2" Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                </Border.Effect>

                <ListBox x:Name="ResultList"
                         ItemsSource="{Binding FilteredView, ElementName=uc}"
                         DisplayMemberPath="{Binding DisplayMemberPath, ElementName=uc}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         BorderThickness="0"
                         Focusable="False"
                         PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F7FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>