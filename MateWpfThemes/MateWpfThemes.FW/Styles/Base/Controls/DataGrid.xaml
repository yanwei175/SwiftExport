<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"

                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

                    xmlns:conv="clr-namespace:MateWpfThemes.FW.Converters"
                    xmlns:assist="clr-namespace:MateWpfThemes.FW.AttachedProperties"
                    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MateWpfThemes.FW;component/Styles/Base/Controls/CheckBox.xaml" >
            <x:Array x:Key="PlaceholderArray" Type="{x:Type sys:String}">
                <sys:String>RowHolder</sys:String>
            </x:Array>
        </ResourceDictionary>

    </ResourceDictionary.MergedDictionaries>


    <conv:ImgPathToImgConverter x:Key="PathToImage"/>
    <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <conv:CellDirtyConverter x:Key="CellDirtyConverter"/>

    <Style x:Key="DataGridCheckBoxColumnStyle"
         TargetType="{x:Type CheckBox}"
         BasedOn="{StaticResource BaseCheckBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="DataGridCheckBoxColumnEditingStyle"
         TargetType="{x:Type CheckBox}"
         BasedOn="{StaticResource BaseCheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--TextBlock-->
    <Style x:Key="DataGridTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <!-- 中文注释：DataGrid 错误提示统一交给 DataGridCell，不再让 TextBlock 自己再画一层验证样式。 -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
    </Style>

    <Style x:Key="MultiLineDataGridTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <!-- 中文注释：DataGrid 错误提示统一交给 DataGridCell，不再让 TextBlock 自己再画一层验证样式。 -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
    </Style>


    <!--TextBox-->
    <Style x:Key="DataGridTextBoxStyle" TargetType="TextBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>

        <!-- 去除TextBox由于Binding验证产生的默认红色边框等视觉阻碍 -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="4" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MultiLineDataGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="assist:TextBoxAssist.AllowAltEnterNewline" Value="True"/>
    </Style>



    <!-- DataGrid模板列专用 ComboBox 样式 (实现单击即用、无缝填充高度) -->
    <Style x:Key="DataGridCellComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Padding" Value="4,0"/>
        <!-- 默认不占边距，让背景铺满单元格 -->
        <Setter Property="Margin" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_Control_Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ★ 魔法注入区 ★：利用 WPF 的 ComponentResourceKey 覆盖默认列的底层静态资源
         所有未指定样式的 DataGridTextColumn 等，都会自动使用我们前面定义的无缝拉伸 TextBox 样式！-->
    <Style x:Key="{ComponentResourceKey ResourceId=DefaultElementStyle, TypeInTargetAssembly={x:Type controls:DataGridTextColumn}}" 
           TargetType="TextBlock" BasedOn="{StaticResource MultiLineDataGridTextBlockStyle}" />

    <Style x:Key="{ComponentResourceKey ResourceId=DefaultEditingElementStyle, TypeInTargetAssembly={x:Type controls:DataGridTextColumn}}" 
           TargetType="TextBox" BasedOn="{StaticResource DataGridTextBoxStyle}" />

    <Style x:Key="{ComponentResourceKey ResourceId=DefaultElementStyle, TypeInTargetAssembly={x:Type controls:DataGridComboBoxColumn}}" 
           TargetType="ComboBox" BasedOn="{StaticResource DataGridCellComboBoxStyle}" />

    <Style x:Key="{ComponentResourceKey ResourceId=DefaultEditingElementStyle, TypeInTargetAssembly={x:Type controls:DataGridComboBoxColumn}}" 
           TargetType="ComboBox" BasedOn="{StaticResource DataGridCellComboBoxStyle}" />

    <!-- ★ DataGridCheckBox 列修正展示与居中编辑 ★ -->
    <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="DataGridCheckBoxEditingStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="{ComponentResourceKey ResourceId=DefaultElementStyle, TypeInTargetAssembly={x:Type controls:DataGridCheckBoxColumn}}" 
           TargetType="CheckBox" BasedOn="{StaticResource DataGridCheckBoxStyle}" />

    <Style x:Key="{ComponentResourceKey ResourceId=DefaultEditingElementStyle, TypeInTargetAssembly={x:Type controls:DataGridCheckBoxColumn}}" 
           TargetType="CheckBox" BasedOn="{StaticResource DataGridCheckBoxEditingStyle}" />


    <!--左上角角标-->
    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="{x:Type Button}">
        <Setter Property="BorderBrush" Value="{Binding HorizontalGridLinesBrush, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Setter Property="BorderThickness" Value="{Binding GridLinesVisibility, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={x:Static conv:GridLinesVisibilityBorderToThicknessConverter.Instance}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
                        <Polygon x:Name="Arrow"
                     Margin="8,8,3,3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Fill="{DynamicResource  Brush_Control_Background}"
                     Opacity="0.5"
                     Points="0,10 10,10 10,0"
                     Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush_Control_Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush_Control_Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--修改默认表头-->
 
    <Style x:Key="BaseDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush_DataGridHeaderBck}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="1,5"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridMouseOver}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0" 
                            Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BaseDataGridColumnHeader}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" 
                               TextWrapping="WrapWithOverflow"
                               TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--修改默认行头-->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource Brush_DataGridHeaderBck}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="2,0,0,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridMouseOver}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--修改默认行-->
    <Style x:Key="BaseDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridMouseOver}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style TargetType="DataGridRow" BasedOn="{StaticResource BaseDataGridRow}">

        <Style.Triggers>
            <!-- 业务层行级状态变更反馈样式 (Added / Modified / Deleted) -->
            <DataTrigger Binding="{Binding State, FallbackValue=None}" Value="Added">
                <Setter Property="Background" Value="#E8F5E9"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State, FallbackValue=None}" Value="Modified">
                <Setter Property="Background" Value="#FFF8E1"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State, FallbackValue=None}" Value="Deleted">
                <Setter Property="Background" Value="#FFEBEE"/>
                <Setter Property="Foreground" Value="#9E9E9E"/>
                <Setter Property="Opacity" Value="0.75"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>
    
    <Style x:Key="ReadOnlyDataGridRow" TargetType="DataGridRow" >
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridMouseOver}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
            </Trigger>
        </Style.Triggers>

    </Style>
    <!--重写默认单元格样式-->

    <Style x:Key="ReadOnlyDataGridCell" TargetType="DataGridCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ToolTip" Value="{x:Null}"/>
        <Setter Property="ToolTipService.Placement" Value="{Binding RelativeSource={RelativeSource Self}, Path=(assist:ValidationAssist.PopupPlacement)}" />
        <Setter Property="ToolTipService.HorizontalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=(assist:ValidationAssist.PopupHorizontalOffset)}" />
        <Setter Property="ToolTipService.VerticalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=(assist:ValidationAssist.PopupVerticalOffset)}" />

        <!-- 去除 WPF 验证失败默认提供的红色边框，通过我们的触发器来显示验证样式 -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="cellBorder" Padding="{TemplateBinding Padding}" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 错误触发器区 -->
        <Style.Triggers>
            <!-- 中文注释：统一改为监听 WPF 原生 Validation.HasError，确保错误出现与清除都能即时同步。 -->
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Error}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource InputValidationUnderlineThickness}"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent, FallbackValue={x:Null}}"/>
            </Trigger>

            <!-- 只有在 SelectionUnit = FullRow 时改变背景色 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="FullRow"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
            </MultiDataTrigger>
            <!-- 只有在 SelectionUnit = Cell 时改变边框色 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Cell"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}"/>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
            </MultiDataTrigger>

            <!-- SelectionUnit = CellOrRowHeader 时改变边框色 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="CellOrRowHeader"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}"/>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
            </MultiDataTrigger>

            <!-- 中文注释：当单元格既处于选中态又有校验错误时，优先保证选中视觉（背景/边框）可见，错误信息继续通过 Tooltip 呈现。 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="FullRow"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
            </MultiDataTrigger>

            <!-- 中文注释：Cell 选择模式下，错误态不再压住选中态边框颜色。 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Cell"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}"/>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </MultiDataTrigger>

            <!-- 中文注释：CellOrRowHeader 选择模式下，同步保证选中态视觉优先。 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="CellOrRowHeader"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}"/>
                <Setter Property="Background" Value="{DynamicResource Brush_DataGridSelectionCell}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--特殊单元格样式,0内边距,适合放图片-->
    <Style x:Key="ZeroPaddingCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            BorderThickness="0">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--图片模板-->
    <DataTemplate x:Key="ImageCellTemplate">
        <Border CornerRadius="4" BorderThickness="0" BorderBrush="Transparent" Margin="1" ClipToBounds="True">
            <Image Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Source="{Binding MainImage, Converter={StaticResource PathToImage}, IsAsync=True}">

                <Image.ToolTip>
                    <ToolTip Background="{DynamicResource Brush_Bck_Card}" 
                             BorderThickness="0" 
                             HasDropShadow="True" 
                             Padding="4"
                             Placement="Mouse">
                        <Image Source="{Binding MainImage, Converter={StaticResource PathToImage}, IsAsync=True}"
                               Stretch="Uniform"
                               MaxWidth="500" MaxHeight="500" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ToolTip>
                </Image.ToolTip>
            </Image>
        </Border>
    </DataTemplate>

    <!--修改默认DataGrid-->
    <Style x:Key="BaseDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Strong}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush_Control_Hover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="All"/>
        <Setter Property="RowHeaderWidth" Value="30"/>
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        
        <Setter Property="assist:DataGridAssist.ApplyMateThemeColumnStyles" Value="True" />
        <!-- 启用一键编辑交互：ComboBox 和 CheckBox 列支持单击直接编辑，TextBox 列不支持 -->
        <Setter Property="assist:DataGridAssist.EnableEditBoxAssist" Value="True"/>
        <!-- 中文注释：统一 DataGrid 内错误 Tooltip 的默认位置，必要时外部可在 DataGrid 上整体覆盖。 -->
        <Setter Property="assist:ValidationAssist.PopupPlacement" Value="Bottom" />
        <Setter Property="assist:ValidationAssist.PopupHorizontalOffset" Value="0" />
        <Setter Property="assist:ValidationAssist.PopupVerticalOffset" Value="6" />


        <Setter Property="assist:DataGridAssist.AutoGeneratedCheckBoxStyle" Value="{StaticResource DataGridCheckBoxColumnStyle}" />
        <Setter Property="assist:DataGridAssist.AutoGeneratedEditingCheckBoxStyle" Value="{StaticResource DataGridCheckBoxColumnEditingStyle}" />
        <Setter Property="assist:DataGridAssist.AutoGeneratedTextStyle" Value="{StaticResource MultiLineDataGridTextBlockStyle}" />
        <Setter Property="assist:DataGridAssist.AutoGeneratedEditingTextStyle" Value="{StaticResource DataGridTextBoxStyle}" />
        
        <!--如果没有数据就显示一个占位字符-->
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Background">
                    <Setter.Value>
                        <VisualBrush Stretch="None">
                            <VisualBrush.Visual>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource Icon.Attention}"
                                          Fill="#CCCCCC" Width="40" Height="40" Stretch="Uniform" Margin="0,0,0,10"/>
                                    <TextBlock Text="暂无数据" Foreground="{DynamicResource Brush_Txt_Disabled}" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>

    </Style>

    <Style x:Key="FullRowDataGrid" TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Extended"/>
    </Style>

    
    <Style x:Key="ReadOnlyDataGrid" TargetType="DataGrid">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource  DataGridTextBlockStyle}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DataGridCheckBoxStyle}"/>
        </Style.Resources>
        
        <Setter Property="CellStyle" Value="{StaticResource ReadOnlyDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ReadOnlyDataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReadOnlyDataGridColumnHeader}"/>
        
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>

        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush_Border_Light}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="30"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="assist:DataGridAssist.AutoGeneratedTextStyle" Value="{StaticResource DataGridTextBlockStyle}" />

    </Style>

    <!-- 汇总表专用样式 -->
    <Style x:Key="SummaryDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ReadOnlyDataGrid}">
        <!--在该 DataGrid 的作用域内重置隐式 Row 样式 -->
        <Style.Resources>
            <!-- 
            这个不带 x:Key 的 Style 会覆盖掉全局那个带 State 触发器的 Style。
            BasedOn 指向你的只读行样式（确保背景、选中色等基础属性存在）。
        -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource ReadOnlyDataGridRow}" />
            <Style TargetType="DataGridCell" BasedOn="{StaticResource ReadOnlyDataGridCell}" />
        </Style.Resources>
        <!-- 默认绑定这个占位符 -->
        <Setter Property="ItemsSource" Value="{StaticResource PlaceholderArray}" />
        <Setter Property="HeadersVisibility" Value="None" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Brush_Control_Background}" />
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- 解决只有一行时可能出现的滚动条空白 -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>




    <Style TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">

    </Style>

</ResourceDictionary>
