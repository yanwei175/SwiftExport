<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================= -->
    <!--   鸿蒙 CheckBox 模板       -->
    <!-- ========================= -->
    <ControlTemplate x:Key="CheckBoxTemplate" TargetType="CheckBox">
        <Grid Margin="2"
              RenderTransformOrigin="0.1,0.1">

            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 复选框外框 -->
            <Border x:Name="Box"
                    Width="16" Height="16"
                    CornerRadius="2"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource Brush_Border_Light}"
                    Background="{DynamicResource Brush_Control_Background}"
                    VerticalAlignment="Center" />

            <!-- 勾选图标 -->
            <Viewbox Grid.Column="0" Width="14" Height="14">
                <Path x:Name="CheckMark"
                      Data="{DynamicResource Icon.Check}"
                      StrokeThickness="2"
                      Stroke="{DynamicResource Brush_Primary}"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                </Path>
            </Viewbox>


            <!-- 文本 -->
            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
        </Grid>

        <ControlTemplate.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Opacity" Value="0.92" />
            </Trigger>

            <!-- Checked -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush_Control_Background}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush_Primary_Focus}" />

                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="Opacity" 
                                 To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                 To="1" Duration="0:0:0.25" 
                                 EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                 To="1" Duration="0:0:0.25" 
                                 EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>

                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="Opacity" 
                                 To="0" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                 To="0" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="CheckMark" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                 To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Indeterminate（中间状态） -->
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource Brush_Primary_Focus}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource Brush_Primary_Focus}" />
                <Setter TargetName="CheckMark" Property="Data"
                        Value="M 4 9 L 14 9" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckMark" Property="Stroke"
                        Value="{DynamicResource Neutral1Brush}" />
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource Brush_Control_Disabled}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource Brush_Control_Border_Disabled}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush_Control_Border_Disabled}" />
            </Trigger>

            <!-- 点击动效 -->
            <EventTrigger RoutedEvent="CheckBox.PreviewMouseLeftButtonDown">
                <BeginStoryboard Storyboard="{StaticResource ClickRippleStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 CheckBox 样式       -->
    <!-- ========================= -->
    <Style x:Key="BaseCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource CheckBoxTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBox}"/>

</ResourceDictionary>
