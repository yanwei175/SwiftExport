<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ast="clr-namespace:MateWpfThemes.FW.AttachedProperties"
                    xmlns:mt="clr-namespace:MateWpfThemes.FW.Common"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">

    <!--
    轻量版 DatePicker：
    目标是替换系统默认那套又丑又不顺手的样式，
    但不再依赖 MaterialDesign 那种很长的样式链和大量辅助属性。
    这里保留三个核心能力：
    1. 好看的输入框外观；
    2. 明确可见的日历按钮；
    3. 稳定弹出的 Calendar。
  -->

    <!-- DatePicker 内部文本框模板：只保留文本宿主，边框由外层 DatePicker 统一绘制 -->
    <ControlTemplate x:Key="DatePickerTextBoxLiteTemplate" TargetType="{x:Type DatePickerTextBox}">
        <ScrollViewer x:Name="PART_ContentHost"
                  Margin="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch" />
    </ControlTemplate>

    <!-- DatePicker 内部文本框样式：透明背景、无边框，让外层容器负责视觉效果 -->
    <Style x:Key="DatePickerNestedTextBoxLiteStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- 中文注释：DatePicker 内部输入框关闭系统默认验证红框，统一由外层 DatePicker 边框承担错误提示。 -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,6,0,6" />
        <Setter Property="Template" Value="{DynamicResource DatePickerTextBoxLiteTemplate}" />
    </Style>

    <!-- 右侧日历按钮模板：使用普通 Button，而不是 ToggleButton，尽量贴近 WPF DatePicker 默认模板契约 -->
    <ControlTemplate x:Key="DatePickerCalendarButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="ButtonBorder"
            Background="Transparent"
            CornerRadius="4">
            <Viewbox Width="16" Height="16" Stretch="Uniform">
                <Path Fill="{TemplateBinding Foreground}"
              Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" />
            </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 中文注释：Calendar 外观直接复用 Calendar.xaml 中定义的轻量 CalendarLite，不在这里重复声明同名样式 -->

    <!-- 轻量轮廓版 DatePicker：这是外部最推荐直接使用的样式 -->
    <Style x:Key="OutlinedDatePicker" TargetType="{x:Type DatePicker}">
        <Setter Property="Background" Value="{DynamicResource Brush_Input_Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush_Txt_Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Light}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{x:Null}" />
        <Setter Property="ToolTipService.Placement" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ast:ValidationAssist.PopupPlacement)}" />
        <Setter Property="ToolTipService.HorizontalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ast:ValidationAssist.PopupHorizontalOffset)}" />
        <Setter Property="ToolTipService.VerticalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ast:ValidationAssist.PopupVerticalOffset)}" />
        <!-- 中文注释：明确指定弹出层使用轻量 Calendar 样式，避免回退到系统默认 Calendar -->
        <Setter Property="CalendarStyle" Value="{DynamicResource CalendarLite}" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Grid>
                        <!-- 外层边框：统一控制输入框外观 -->
                        <Border x:Name="OuterBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent},
                               Path=(ast:DatePickerAssist.CornerRadius)}"
                    SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <!-- 输入文本区域 -->
                                <DatePickerTextBox x:Name="PART_TextBox"
                                   Grid.Column="0"
                                   Margin="0"
                                   Focusable="{TemplateBinding Focusable}"
                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Style="{DynamicResource DatePickerNestedTextBoxLiteStyle}" />

                                <!-- 日历按钮：保持为 Button，交给 WPF DatePicker 内部去驱动 Popup -->
                                <Button x:Name="PART_Button"
                        Grid.Column="1"
                        Margin="0"
                        Focusable="False"
                        Foreground="{TemplateBinding Foreground}"
                        Template="{DynamicResource DatePickerCalendarButtonTemplate}"
                        />
                            </Grid>
                        </Border>

                        <!-- Popup 内必须放 PART_Calendar，并显式指定为轻量 Calendar 样式 -->
                        <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=OuterBorder}"
                   PopupAnimation="None"
                   StaysOpen="False">
                            <Grid Margin="0,6,0,0" SnapsToDevicePixels="True">
                                <Calendar x:Name="PART_Calendar"
                          Style="{DynamicResource CalendarLite}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}" />
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停时轻微高亮边框 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush_Border_Default}" />
                        </Trigger>

                        <!-- 获得焦点时高亮主色边框 -->
                        <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush_Primary}" />
                        </Trigger>

                        <!-- 中文注释：DatePicker 自身绑定错误时，统一显示错误边框与 Tooltip。 -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush_Error}" />
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(Validation.Errors)[0].ErrorContent}" />
                        </Trigger>

                        <!-- 中文注释：DatePicker 内部文本框解析/格式错误时，也要把外层边框切成错误色，并给出错误 Tooltip。 -->
                        <Trigger SourceName="PART_TextBox" Property="Validation.HasError" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush_Error}" />
                            <Setter Property="ToolTip" Value="{Binding ElementName=PART_TextBox, Path=(Validation.Errors)[0].ErrorContent}" />
                        </Trigger>

                        <!-- 禁用态统一降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnderLineDatePicker"       TargetType="DatePicker"       BasedOn="{StaticResource OutlinedDatePicker}">
        <Setter Property="ast:DatePickerAssist.CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!--
    中文注释：隐式 DatePicker 样式不再通过 BasedOn 引用，
    避免设计器再次因为 StaticResource 继承链报错。
    这里直接提供一个与 OutlinedDatePicker 等价的默认样式入口。
  -->
    <Style TargetType="DatePicker" BasedOn="{StaticResource OutlinedDatePicker}" />

</ResourceDictionary>
