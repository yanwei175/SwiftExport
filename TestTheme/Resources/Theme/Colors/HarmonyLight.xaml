<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary 蓝色系 -->
    <Color x:Key="HarmonyPrimary1">#E8F3FF</Color>
    <Color x:Key="HarmonyPrimary2">#BEDAFF</Color>
    <Color x:Key="HarmonyPrimary3">#94C2FF</Color>
    <Color x:Key="HarmonyPrimary4">#6AA9FF</Color>
    <Color x:Key="HarmonyPrimary5">#408FFF</Color>
    <!-- 主色 -->
    <Color x:Key="HarmonyPrimary6">#1676FF</Color>

    <!-- 中性色 -->
    <Color x:Key="HarmonyNeutral1">#FFFFFF</Color>
    <Color x:Key="HarmonyNeutral2">#F7F8FA</Color>
    <Color x:Key="HarmonyNeutral3">#F2F3F5</Color>
    <Color x:Key="HarmonyNeutral4">#E5E6EB</Color>
    <Color x:Key="HarmonyNeutral5">#C9CDD4</Color>
    <Color x:Key="HarmonyNeutral6">#86909C</Color>
    <Color x:Key="HarmonyNeutral7">#4E5969</Color>
    <Color x:Key="HarmonyNeutral8">#272E3B</Color>

    <!-- 状态色 -->
    <Color x:Key="HarmonySuccess">#00B578</Color>
    <Color x:Key="HarmonyWarning">#FF7D00</Color>
    <Color x:Key="HarmonyError">#F53F3F</Color>

</ResourceDictionary>
