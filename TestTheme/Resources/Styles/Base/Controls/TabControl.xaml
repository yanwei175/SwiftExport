<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   鸿蒙 TabItem 样式        -->
    <!-- ========================= -->
    <Style x:Key="HarmonyTabItem" TargetType="TabItem">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource HarmonyPrimaryTextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource HarmonyNeutral3Brush}" />
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource HarmonyPrimary1Brush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HarmonyPrimary5Brush}" />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource HarmonyNeutral3Brush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HarmonyNeutral7Brush}" />
                        </Trigger>

                        <!-- 加载动效 -->
                        <EventTrigger RoutedEvent="TabItem.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
                        </EventTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================= -->
    <!--   鸿蒙 TabControl 样式     -->
    <!-- ========================= -->
    <Style TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab Header 区域 -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0"
                                    Margin="4"
                                    Background="Transparent">
                            <ItemsPresenter />
                        </StackPanel>

                        <!-- 内容区域 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource HarmonyNeutral1Brush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource HarmonyNeutral4Brush}"
                                BorderThickness="1"
                                Padding="16">
                            <ContentPresenter />
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle" Value="{StaticResource HarmonyTabItem}" />
    </Style>

</ResourceDictionary>
