<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   鸿蒙 CheckBox 模板       -->
    <!-- ========================= -->
    <ControlTemplate x:Key="HarmonyCheckBoxTemplate" TargetType="CheckBox">
        <Grid Margin="2"
              RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 复选框外框 -->
            <Border x:Name="Box"
                    Width="18" Height="18"
                    CornerRadius="4"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource HarmonyNeutral6Brush}"
                    Background="{DynamicResource HarmonyNeutral1Brush}"
                    VerticalAlignment="Center" />

            <!-- 勾选图标 -->
            <Path x:Name="CheckMark"
                  Grid.Column="0"
                  Data="M 4 9 L 8 13 L 14 5"
                  StrokeThickness="2"
                  Stroke="{DynamicResource HarmonyPrimary5Brush}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Visibility="Collapsed"
                  VerticalAlignment="Center" />

            <!-- 文本 -->
            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
        </Grid>

        <ControlTemplate.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Opacity" Value="0.92" />
            </Trigger>

            <!-- Checked -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckMark" Property="Stroke" 
                        Value="{DynamicResource HarmonyNeutral1Brush}" />
            </Trigger>

            <!-- Indeterminate（中间状态） -->
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
                <Setter TargetName="CheckMark" Property="Data"
                        Value="M 4 9 L 14 9" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckMark" Property="Stroke"
                        Value="{DynamicResource HarmonyNeutral1Brush}" />
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource HarmonyNeutral3Brush}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource HarmonyNeutral5Brush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource HarmonyNeutral7Brush}" />
            </Trigger>

            <!-- 点击动效 -->
            <EventTrigger RoutedEvent="CheckBox.PreviewMouseLeftButtonDown">
                <BeginStoryboard Storyboard="{StaticResource ClickRippleStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 CheckBox 样式       -->
    <!-- ========================= -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource HarmonyCheckBoxTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource HarmonyPrimaryTextBrush}" />
    </Style>

</ResourceDictionary>
