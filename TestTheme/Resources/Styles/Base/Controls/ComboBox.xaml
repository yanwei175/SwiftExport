<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   下拉项样式（ListBoxItem） -->
    <!-- ========================= -->
    <Style x:Key="HarmonyComboBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">

                        <ContentPresenter />
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource HarmonyNeutral3Brush}" />
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource HarmonyPrimary1Brush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HarmonyPrimary5Brush}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================= -->
    <!--   ComboBox 主体模板        -->
    <!-- ========================= -->
    <ControlTemplate x:Key="HarmonyComboBoxTemplate" TargetType="ComboBox">
        <Grid>

            <!-- 主体边框 -->
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">

                <DockPanel>

                    <!-- 显示内容 -->
                    <ContentPresenter Margin="4,0,0,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />

                    <!-- 下拉箭头 -->
                    <Path x:Name="Arrow"
                          DockPanel.Dock="Right"
                          Margin="6"
                          Data="M 0 0 L 8 0 L 4 4 Z"
                          Fill="{DynamicResource HarmonyPrimaryTextBrush}"
                          Width="8" Height="4"
                          VerticalAlignment="Center" />

                </DockPanel>
            </Border>

            <!-- Popup 下拉列表 -->
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">

                <Border Background="{DynamicResource HarmonyNeutral1Brush}"
                        BorderBrush="{DynamicResource HarmonyNeutral4Brush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4"
                        SnapsToDevicePixels="True">

                    <ScrollViewer>
                        <ItemsPresenter />
                    </ScrollViewer>

                </Border>
            </Popup>

        </Grid>

        <ControlTemplate.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Opacity" Value="0.96" />
            </Trigger>

            <!-- Focus -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Border" Property="BorderBrush"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Background"
                        Value="{DynamicResource HarmonyNeutral3Brush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource HarmonyNeutral7Brush}" />
            </Trigger>

            <!-- 加载动效 -->
            <EventTrigger RoutedEvent="ComboBox.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 ComboBox 样式覆盖   -->
    <!-- ========================= -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource HarmonyNeutral2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HarmonyNeutral4Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HarmonyComboBoxItem}" />
        <Setter Property="Template" Value="{StaticResource HarmonyComboBoxTemplate}" />
    </Style>

</ResourceDictionary>
