<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   鸿蒙 ProgressBar 模板    -->
    <!-- ========================= -->
    <ControlTemplate x:Key="HarmonyProgressBarTemplate" TargetType="ProgressBar">
        <Grid Height="6" Margin="4,8">

            <!-- 背景轨道 -->
            <Border x:Name="Track"
                    Background="{DynamicResource HarmonyNeutral4Brush}"
                    CornerRadius="3" />

            <!-- 进度条 -->
            <Border x:Name="Indicator"
                    Background="{DynamicResource HarmonyPrimary5Brush}"
                    CornerRadius="3"
                    HorizontalAlignment="Left"
                    Width="0" />

        </Grid>

        <ControlTemplate.Triggers>

            <!-- 正常进度 -->
            <Trigger Property="IsIndeterminate" Value="False">
                <Setter TargetName="Indicator" Property="Width"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth, Converter={StaticResource ProgressWidthConverter}, ConverterParameter={TemplateBinding Value}}" />
            </Trigger>

            <!-- 不确定状态（Indeterminate） -->
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="Indicator" Property="Width" Value="40" />
                <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Left" />

                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Indicator"
                                             Storyboard.TargetProperty="(Canvas.Left)"
                                             From="-40" To="300"
                                             Duration="0:0:1.2"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Background"
                        Value="{DynamicResource HarmonyNeutral3Brush}" />
                <Setter TargetName="Indicator" Property="Background"
                        Value="{DynamicResource HarmonyNeutral5Brush}" />
            </Trigger>

            <!-- 加载动效 -->
            <EventTrigger RoutedEvent="ProgressBar.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 ProgressBar 样式    -->
    <!-- ========================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Template" Value="{StaticResource HarmonyProgressBarTemplate}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="6" />
    </Style>

</ResourceDictionary>
