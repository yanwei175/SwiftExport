<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   鸿蒙 Slider 模板         -->
    <!-- ========================= -->
    <ControlTemplate x:Key="HarmonySliderTemplate" TargetType="Slider">
        <Grid Margin="4,8">

            <!-- 轨道 -->
            <Border x:Name="TrackBackground"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource HarmonyNeutral4Brush}"
                    VerticalAlignment="Center" />

            <!-- 已选部分 -->
            <Border x:Name="TrackFill"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource HarmonyPrimary5Brush}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Width="0" />

            <!-- 滑块 -->
            <Thumb x:Name="Thumb" Width="20" Height="20" VerticalAlignment="Center">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource HarmonyPrimary5Brush}"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource HarmonyNeutral1Brush}"
                            RenderTransformOrigin="0.5,0.5"
                            BorderThickness="2" >
                            <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>


        </Grid>

        <ControlTemplate.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Thumb" Property="Background"
                        Value="{DynamicResource HarmonyPrimary4Brush}" />
            </Trigger>

            <!-- Dragging -->
            <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                <Setter TargetName="Thumb" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                    </Setter.Value>
                </Setter>
            </Trigger>


            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TrackBackground" Property="Background"
                        Value="{DynamicResource HarmonyNeutral3Brush}" />
                <Setter TargetName="TrackFill" Property="Background"
                        Value="{DynamicResource HarmonyNeutral5Brush}" />
                <Setter TargetName="Thumb" Property="Background"
                        Value="{DynamicResource HarmonyNeutral4Brush}" />
            </Trigger>

            <!-- 加载动效 -->
            <EventTrigger RoutedEvent="Slider.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 Slider 样式覆盖     -->
    <!-- ========================= -->
    <Style TargetType="Slider">
        <Setter Property="Template" Value="{StaticResource HarmonySliderTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource HarmonyPrimaryTextBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="TickPlacement" Value="None" />
    </Style>

</ResourceDictionary>
