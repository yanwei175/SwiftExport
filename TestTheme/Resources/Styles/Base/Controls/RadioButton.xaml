<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!--   鸿蒙 RadioButton 模板    -->
    <!-- ========================= -->
    <ControlTemplate x:Key="HarmonyRadioButtonTemplate" TargetType="RadioButton">
        <Grid Margin="2"
              RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 外圈 -->
            <Border x:Name="OuterCircle"
                    Width="18" Height="18"
                    CornerRadius="9"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource HarmonyNeutral6Brush}"
                    Background="{DynamicResource HarmonyNeutral1Brush}"
                    VerticalAlignment="Center" />

            <!-- 内圈（选中时显示） -->
            <Ellipse x:Name="InnerCircle"
                     Width="10" Height="10"
                     Fill="{DynamicResource HarmonyPrimary5Brush}"
                     Visibility="Collapsed"
                     VerticalAlignment="Center"
                     Margin="4" />

            <!-- 文本 -->
            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
        </Grid>

        <ControlTemplate.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OuterCircle" Property="Opacity" Value="0.92" />
            </Trigger>

            <!-- Checked -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="OuterCircle" Property="BorderBrush"
                        Value="{DynamicResource HarmonyPrimary5Brush}" />
                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OuterCircle" Property="Background"
                        Value="{DynamicResource HarmonyNeutral3Brush}" />
                <Setter TargetName="OuterCircle" Property="BorderBrush"
                        Value="{DynamicResource HarmonyNeutral5Brush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource HarmonyNeutral7Brush}" />
            </Trigger>

            <!-- 点击动效 -->
            <EventTrigger RoutedEvent="RadioButton.PreviewMouseLeftButtonDown">
                <BeginStoryboard Storyboard="{StaticResource ClickRippleStoryboard}" />
            </EventTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- ========================= -->
    <!--   默认 RadioButton 样式    -->
    <!-- ========================= -->
    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource HarmonyRadioButtonTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource HarmonyPrimaryTextBrush}" />
    </Style>

</ResourceDictionary>
