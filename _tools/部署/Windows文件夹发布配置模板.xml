<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio 本地文件夹发布：服务器配置由部署工具保留或首次单独提供。 -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
    <PublishDir>$(MSBuildProjectDirectory)\bin\Release\net10.0\win-x64\publish\</PublishDir>
    <PublishUrl>$(MSBuildProjectDirectory)\bin\Release\net10.0\win-x64\publish\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
