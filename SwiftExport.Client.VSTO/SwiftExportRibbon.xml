<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
 <ribbon><tabs><tab id="swiftExportTab" label="SwiftExport">
  <group id="accountGroup" label="账号">
   <labelControl id="accountStatus" getLabel="GetStatus"/>
   <button id="login" label="登录" onAction="OnLogin" getVisible="GetLoginVisible" getEnabled="GetAccountEnabled"/>
   <button id="switchAccount" label="切换登录" onAction="OnLogin" getVisible="GetAccountVisible" getEnabled="GetAccountEnabled" screentip="新账号验证成功后才替换原账号"/>
   <button id="logout" label="退出登录" onAction="OnLogout" getVisible="GetAccountVisible" getEnabled="GetAccountEnabled"/>
  </group>
  <group id="settingsGroup" label="设置">
   <button id="excelReadProfile" label="Excel 读取配置" onAction="OnExcelReadProfile" getVisible="GetReadProfileSettingsVisible" getEnabled="GetReadProfileSettingsEnabled" screentip="在右侧栏设置读取地址，可同时操作工作表"/>
  </group>
  <group id="documentGroup" label="单据">
   <button id="salesOrderList" label="销售订单" onAction="OnSalesOrderList" getEnabled="GetSalesOrderListEnabled" screentip="在右侧栏查询销售订单；Excel 生成待实现"/>
   <button id="purchaseOrderList" label="采购订单" onAction="OnPurchaseOrderList" getEnabled="GetPurchaseOrderListEnabled" screentip="在右侧栏查询采购订单；Excel 生成待实现"/>
  </group>
  <group id="importGroup" label="数据导入">
   <button id="salesOrderImport" label="销售订单导入" onAction="OnSalesImport" getEnabled="GetSalesImportEnabled" screentip="本地编辑预览，暂不保存至服务器"/>
   <button id="purchaseOrderImportPreview" label="采购订单导入" onAction="OnPurchaseImportPreview" getEnabled="GetPurchaseImportPreviewEnabled" screentip="按地址读取、检验后创建无来源采购草稿"/>
   <button id="packingListImport" label="PackingList 导入" onAction="OnPackingListImport" getEnabled="GetPackingListImportEnabled" screentip="保存未关联草稿，随后到系统分配来源数量"/>
  </group>
 </tab></tabs></ribbon>
</customUI>
