<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/Themes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- 仅供设计器：运行时由官方强调色管理器填充颜色，不合并本字典。 -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentColorPrimary">#0067B5</Color>
    <Color x:Key="SystemAccentColorSecondary">#005A9E</Color>
    <Color x:Key="SystemAccentColorTertiary">#004578</Color>
    <Color x:Key="AccentFillColorDefault">#0067B5</Color>
    <Color x:Key="AccentFillColorSecondary">#E50067B5</Color>
    <Color x:Key="AccentFillColorTertiary">#CC0067B5</Color>
</ResourceDictionary>
