<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 缩略图视觉；普通 Image 的 Source 由页面提供，HttpsImage 以同一样式显示直接下载的 HTTPS 图片。 -->
    <ToolTip x:Key="SwiftExportImageToolTip" x:Shared="False" Placement="Mouse" Padding="0" HasDropShadow="True">
        <Image MaxWidth="500" MaxHeight="500" Stretch="Uniform"
               Source="{Binding PlacementTarget.Source, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"/>
    </ToolTip>
    <Style x:Key="SwiftExportImage" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ToolTip" Value="{StaticResource SwiftExportImageToolTip}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        <Style.Triggers>
            <Trigger Property="Source" Value="{x:Null}">
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
