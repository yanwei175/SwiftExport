<UserControl x:Class="SwiftExport.Client.VSTO.Resources.Controls.ExcelCellAddressBox"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox Text="{Binding Address, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="80" AutomationProperties.Name="单元格地址"/>
  <Button Grid.Column="1" Content="获取" Margin="4,0,0,0" Command="{Binding PickCommand, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}"/>
  <Button Grid.Column="2" Content="清除" Margin="4,0,0,0" Command="{Binding ClearCommand, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}"/>
 </Grid>
</UserControl>