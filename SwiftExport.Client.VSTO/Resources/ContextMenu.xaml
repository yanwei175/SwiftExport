<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/ContextMenu/ContextMenu.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource UiContextMenu}">
        <Setter Property="FontSize" Value="{DynamicResource ContentControlFontSize}"/>
    </Style>
</ResourceDictionary>