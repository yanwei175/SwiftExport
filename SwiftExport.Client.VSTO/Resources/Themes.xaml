<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light"/>
        <ui:ControlsDictionary/>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Variables.xaml"/>
        <ResourceDictionary Source="UserWpfUiThemeResources.xaml"/>
        <ResourceDictionary Source="Borders.xaml"/>
        <ResourceDictionary Source="Button.xaml"/>
        <ResourceDictionary Source="ContextMenu.xaml"/>
        <ResourceDictionary Source="Grids.xaml"/>
        <ResourceDictionary Source="ListBox.xaml"/>
        <ResourceDictionary Source="DatePicker.xaml"/>
        <!-- DatePicker 的官方依赖包含 TextBox；项目覆盖必须在它之后合并。 -->
        <ResourceDictionary Source="TextBoxes.xaml"/>
        <ResourceDictionary Source="DataGrid.xaml"/>
        <ResourceDictionary Source="TabControl.xaml"/>
        <ResourceDictionary Source="Image.xaml"/>
        <!-- 部分控件字典重新合并官方文字样式，统一字体必须在它们之后生效。 -->
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
