<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="SwiftExportFont">Microsoft YaHei, 微软雅黑, Microsoft YaHei UI, 微软雅黑 UI, Segoe UI, Arial</FontFamily>
  <!-- 兼容已有字体资源键，统一回退顺序；页面和宿主以 SwiftExportFont 为主入口。 -->
  <FontFamily x:Key="SwiftExportFontFamily">Microsoft YaHei, 微软雅黑, Microsoft YaHei UI, 微软雅黑 UI, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="UserFontOrder">Microsoft YaHei, 微软雅黑, Microsoft YaHei UI, 微软雅黑 UI, Segoe UI, Arial</FontFamily>
  <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource SwiftExportFont}" />
  </Style>
  <Style x:Key="CaptionTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}" />
  </Style>
  <Style x:Key="SecondaryTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="LabelTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource SwiftExportDefaltFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource UserTextFillColorPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="BodyStrongTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SubtitleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TitleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="TitleLargeTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DisplayTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="68" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</ResourceDictionary>
