<UserControl
             x:Class="SwiftExport.Client.VSTO.Features.Shipping.PackingLists.Views.PackingListImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SwiftExport.Client.VSTO.Resources.Converters"
             xmlns:customers="clr-namespace:SwiftExport.Client.VSTO.Features.Customers.Components"
             xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls">
    <UserControl.Resources>
        <converters:ImportHeaderMaxHeightConverter x:Key="ImportHeaderMaxHeight" />
        <BooleanToVisibilityConverter x:Key="ExtraFieldsVisibility" />
        <Style x:Key="ImportStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox Width="230" ItemsSource="{Binding ReadProfiles}" SelectedItem="{Binding SelectedReadProfile}" DisplayMemberPath="ConfigName" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8" />
            <ui:Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,8" />
            <ui:Button Content="读取明细" Command="{Binding ReadLinesCommand}" Margin="0,0,8,8" />
            <ui:Button Content="检查" Command="{Binding CheckCommand}" Margin="0,0,8,8" />
            <ui:Button Content="保存草稿 / 重试" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
            <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,8">
                <MenuItem Header="更多">
                    <MenuItem Header="加载 / 刷新配置" Command="{Binding InitializeCommand}" />
                    <MenuItem Header="设计读取配置" Command="{Binding DesignCommand}" />
                    <MenuItem Header="新导入" Command="{Binding NewCommand}" />
                </MenuItem>
            </Menu>
        </WrapPanel>
        <ScrollViewer x:Name="HeaderScroll" Grid.Row="1" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImportHeaderMaxHeight}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="HeaderStackPanel">
                <ui:Card Margin="0,0,0,8">
                    <WrapPanel IsEnabled="{Binding CanEdit}">
                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="客户（必须选择）" />
                            <customers:CustomerAutoSuggestComboBox ItemsSource="{Binding ReferenceData.Customers}" SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="Excel 单据编号（写入备注）" />
                            <ui:TextBox Text="{Binding Header.ExcelDocumentNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="单据日期" />
                            <DatePicker SelectedDate="{Binding Header.InvoiceDate, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                </ui:Card>
                <ToggleButton x:Name="OtherToggleButton" IsChecked="False" Margin="0,0,8,8"
                              AutomationProperties.Name="其他表头资料" Content="其他表头资料" HorizontalAlignment="Left" />
                <controls:ImportHeaderPopup x:Name="OtherPopup"
                    IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=OtherToggleButton}"
                    EntryButton="{Binding ElementName=OtherToggleButton}"
                    Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderStackPanel}"
                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                    Width="{Binding ActualWidth, ElementName=HeaderStackPanel}"
                    VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None"
                    TextElement.FontFamily="{Binding PlacementTarget.FontFamily, RelativeSource={RelativeSource Self}}"
                    TextElement.FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}">
                    <Border Padding="12" Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}" BorderThickness="1"
                            KeyboardNavigation.TabNavigation="Cycle">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="关闭" DockPanel.Dock="Right" Command="{x:Static ApplicationCommands.Close}" />
                                <TextBlock Text="其他表头资料" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel IsEnabled="{Binding CanEdit}">
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="收货名称" />
                                        <ui:TextBox Text="{Binding Header.CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="收货地址" />
                                        <ui:TextBox Text="{Binding Header.CustomerAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="联系人" />
                                        <ui:TextBox Text="{Binding Header.Attention, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="集装箱号" />
                                        <ui:TextBox Text="{Binding Header.ContainerNo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="封条号" />
                                        <ui:TextBox Text="{Binding Header.SealNo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="出货地点" />
                                        <ui:TextBox Text="{Binding Header.ShippingLocation, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="备注" />
                                        <ui:TextBox Text="{Binding Header.Note, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="ETD" />
                                        <DatePicker SelectedDate="{Binding Header.Etd, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Text="ETA" />
                                        <DatePicker SelectedDate="{Binding Header.Eta, Mode=TwoWay}" />
                                    </StackPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </controls:ImportHeaderPopup>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,8,0,8">
            <ui:Button Content="添加行" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
            <ui:Button Content="删除当前行" Command="{Binding DeleteLineCommand}" />
            <ui:ToggleSwitch x:Name="ExtraFieldsSwitch" Content="显示更多字段" IsChecked="False" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="显示或隐藏次要明细字段；不清除已有数据" AutomationProperties.Name="显示更多明细字段" />
        </WrapPanel>
        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="3" x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEdit}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="非标" Binding="{Binding IsNonStandard, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Excel 中性型号" Binding="{Binding OriginalLinkSku, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="系统 SKU" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <DataGridTextColumn Header="系统中性型号" Binding="{Binding LinkSku, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <DataGridTextColumn Header="描述" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="颜色" Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Header="多候选选择">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Width="180" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="Sku" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="确认型号差异" Binding="{Binding AcceptLinkSkuMismatch, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Header="单位">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Width="60" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNonStandard}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="数量" Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="每箱数量" Binding="{Binding PcsPerPackageText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="每箱净重" Binding="{Binding NwPerPackageText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="每箱毛重" Binding="{Binding GwPerPackageText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="每箱体积" Binding="{Binding CbmPerPackageText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="PO 原文" Binding="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Invoice 原文" Binding="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="箱唛" Binding="{Binding Marks, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" Header="备注" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="检查反馈" Binding="{Binding MatchMessage, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ImportStatusText}" Foreground="Firebrick" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>