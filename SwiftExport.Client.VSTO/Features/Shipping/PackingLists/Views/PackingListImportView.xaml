<UserControl x:Class="SwiftExport.Client.VSTO.Features.Shipping.PackingLists.Views.PackingListImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:customers="clr-namespace:SwiftExport.Client.VSTO.Features.Customers.Components"
             xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls"
             xmlns:vm="clr-namespace:SwiftExport.Client.VSTO.Features.Shipping.PackingLists.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1960" d:DesignHeight="820"
             d:DataContext="{d:DesignInstance Type=vm:PackingListImportDesignViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- VSTO 设计器不执行 Excel 启动；仅预览时显式取得主题及转换器。 -->
                <d:ResourceDictionary Source="../../../../Properties/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ExtraFieldsVisibility" />
            <Style x:Key="ImportStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="HeaderLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="QuantityText" TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsQuantityNonPositive}" Value="True">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="QuantityEditor" TargetType="TextBox" BasedOn="{StaticResource SwiftExportDataGridNumberTextBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsQuantityNonPositive}" Value="True">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox Width="200" ItemsSource="{Binding ReadProfiles}" SelectedItem="{Binding SelectedReadProfile}" DisplayMemberPath="ConfigName" IsEnabled="{Binding CanEdit}" Margin="0,0,8,4" />
            <ui:Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,4" />
            <ui:Button Content="检验与匹配" Command="{Binding CheckCommand}" Margin="0,0,8,4" />
            <ui:Button Content="保存草稿 / 重试" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,4" />
            <ui:DropDownButton Content="更多" VerticalAlignment="Center" Margin="0,0,8,4">
                <ui:DropDownButton.Flyout>
                    <ContextMenu Style="{StaticResource UiContextMenu}">
                        <ui:MenuItem Header="加载 / 刷新配置" Command="{Binding InitializeCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}" />
                        <ui:MenuItem Header="设计读取配置" Command="{Binding DesignCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}" />
                        <ui:MenuItem Header="新导入" Command="{Binding NewCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </WrapPanel>
        <StackPanel x:Name="HeaderStackPanel" Grid.Row="1" IsEnabled="{Binding CanEdit}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="客户代码 *" Foreground="Red" Style="{StaticResource HeaderLabel}" />
                <customers:CustomerAutoSuggestComboBox Grid.Column="1" ItemsSource="{Binding ReferenceData.Customers}"
                    SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionCommittedCommand="{Binding CustomerSelectedCommand}" SelectionClearedCommand="{Binding CustomerClearedCommand}" />
                <TextBlock Grid.Column="3" Text="系统箱单号" Style="{StaticResource HeaderLabel}" />
                <ui:TextBox Grid.Column="4" Text="{Binding PackingListNo, Mode=OneWay}" IsReadOnly="True" />
            </Grid>
            <Border Padding="8" BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ship-To" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Header.CustomerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="收货名称" />
                    <TextBlock Grid.Column="3" Text="相关发票号" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Column="4" Grid.ColumnSpan="4" Text="{Binding InvoiceNosSummary, Mode=OneWay}" IsReadOnly="True" PlaceholderText="由明细 InvoiceNo 自动汇总" />
                    <TextBlock Grid.Row="2" Text="地址" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Grid.RowSpan="3" Text="{Binding Header.CustomerAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="单据日期 *" Foreground="Red" Style="{StaticResource HeaderLabel}" />
                    <DatePicker Grid.Row="2" Grid.Column="4" SelectedDate="{Binding Header.InvoiceDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Text="装货地点" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Row="2" Grid.Column="7" Text="{Binding Header.ShippingLocation, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="集装箱号" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Row="4" Grid.Column="4" Text="{Binding Header.ContainerNo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="6" Text="封条号" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Row="4" Grid.Column="7" Text="{Binding Header.SealNo, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="联系人" Style="{StaticResource HeaderLabel}" />
                    <ui:TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Header.Attention, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="ETD" Style="{StaticResource HeaderLabel}" />
                    <DatePicker Grid.Row="6" Grid.Column="4" SelectedDate="{Binding Header.Etd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"/>
                    <TextBlock Grid.Row="6" Grid.Column="6" Text="ETA" Style="{StaticResource HeaderLabel}" />
                    <DatePicker Grid.Row="6" Grid.Column="7" SelectedDate="{Binding Header.Eta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"/>
                </Grid>
            </Border>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="备注" Style="{StaticResource HeaderLabel}" />
                <ui:TextBox Text="{Binding Header.Note, UpdateSourceTrigger=PropertyChanged}" Height="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,8,0,4">
            <WrapPanel>
                <ui:Button Content="读取明细" Command="{Binding ReadLinesCommand}" Appearance="Primary" Margin="0,0,8,4" />
                <ui:Button Content="匹配全部 SKU" Command="{Binding MatchAllSkusCommand}" Margin="0,0,8,4" ToolTip="仅匹配产品；保存前仍须整单检验" />
                <ui:Button Content="添加标准行" Command="{Binding AddStandardLineCommand}" Margin="0,0,8,4" />
                <ui:Button Content="添加非标行" Command="{Binding AddNonStandardLineCommand}" Margin="0,0,8,4" />
                <ui:Button Content="删除选中行" Command="{Binding DeleteLineCommand}" Margin="0,0,8,4" />
                <ui:ToggleSwitch x:Name="ExtraFieldsSwitch" Content="显示更多字段" IsChecked="True" Margin="8,0,0,4" VerticalAlignment="Center" AutomationProperties.Name="显示更多明细字段" />
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="LinesGrid" Grid.Row="3" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                  Style="{StaticResource SwiftExportDataGrid}" 
                  RowHeight="{DynamicResource DataGridRowHeightMedium}"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged" RowHeaderWidth="0" FontSize="10"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEdit}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                
                <DataGridTemplateColumn Header="行号" Width="80" IsReadOnly="True" SortMemberPath="LineNumber" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" ToolTip="{Binding CheckLabel}" AutomationProperties.Name="{Binding CheckLabel}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckPassed}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LineNumber}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="校验 / 处理" Width="140" IsReadOnly="True" SortMemberPath="IsCheckPassed" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CheckLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ui:Button Content="匹配 SKU" Padding="4" FontSize="10" Command="{Binding DataContext.MatchLineSkuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged" />
                                <StackPanel Margin="4,0,0,0">
                                    <ToggleButton x:Name="RowMatchToggleButton" Content="处理" Padding="4" FontSize="10" />
                                    <controls:ImportHeaderPopup x:Name="RowMatchPopup" Width="420" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                                    PlacementTarget="{Binding ElementName=RowMatchToggleButton}" EntryButton="{Binding ElementName=RowMatchToggleButton}"
                                    IsOpen="{Binding IsChecked, ElementName=RowMatchToggleButton, Mode=TwoWay}"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    TextElement.FontFamily="{Binding PlacementTarget.FontFamily, RelativeSource={RelativeSource Self}}"
                                    TextElement.FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}">
                                        <Border Padding="12" Background="{DynamicResource UserLayerOnMicaBaseAltFillColorTertiaryBrush}" BorderBrush="{DynamicResource UserCardStrokeColorDefaultSolidBrush}" BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button Content="关闭" DockPanel.Dock="Right" Command="{x:Static ApplicationCommands.Close}" />
                                                    <TextBlock Text="匹配处理" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CustomerSku, StringFormat='客户型号：{0}'}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding OriginalLinkSku, StringFormat='Excel 中性型号：{0}'}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LinkSku, StringFormat='系统中性型号：{0}'}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <StackPanel IsEnabled="{Binding Tag.CanEdit, ElementName=RowMatchPopup}">
                                                            <TextBlock Text="候选 SKU" />
                                                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="产品匹配候选">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Sku}" />
                                                                            <TextBlock Text="{Binding LinkSku, StringFormat=' / {0}'}" />
                                                                            <TextBlock Text="{Binding IsUsable, StringFormat=' / 可用：{0}'}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Content="已核对 Excel 与系统中性型号，确认差异" IsChecked="{Binding AcceptLinkSkuMismatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" />
                                                            <ui:Button Content="匹配本行 SKU" Command="{Binding Tag.MatchLineSkuCommand, ElementName=RowMatchPopup}" CommandParameter="{Binding}" Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MatchMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                        <TextBlock Text="选择候选或确认差异后重新匹配；保存前仍须整单检验。" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </controls:ImportHeaderPopup>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="非标件" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsNonStandard, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.ToggleNonStandardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="非标件" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="系统图片" Width="72" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:HttpsImage SourcePath="{Binding MainImage}" Width="64" Height="64" Stretch="Uniform" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="系统 SKU" Width="120" Binding="{Binding Sku, Mode=OneWay}" IsReadOnly="True"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="系统中性型号" Width="120" Binding="{Binding LinkSku, Mode=OneWay}" IsReadOnly="True" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="箱唛" Width="100" Binding="{Binding Marks, UpdateSourceTrigger=PropertyChanged}" 
                                    Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                
                <DataGridTextColumn Header="客户型号" Width="120" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="Excel中性型号" Width="120" Binding="{Binding OriginalLinkSku, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="描述" Width="180" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="颜色" Width="100" Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}" 
                                    Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                
                <DataGridTextColumn Header="数量" Width="80" Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource QuantityText}" 
                                    EditingElementStyle="{StaticResource QuantityEditor}"/>

                <DataGridTemplateColumn Header="单位" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox FontSize="10" IsEditable="True" IsEnabled="{Binding IsNonStandard}" 
                                  ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                  Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  AutomationProperties.Name="装箱行单位" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="每箱数量" Width="60" Binding="{Binding PcsPerPackageText, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>
                
                <DataGridTextColumn Header="每箱净重" Width="60" Binding="{Binding NwPerPackageText, UpdateSourceTrigger=PropertyChanged}" 
                                    Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}"  
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="每箱毛重" Width="60" Binding="{Binding GwPerPackageText, UpdateSourceTrigger=PropertyChanged}" 
                                    Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}"  
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"/>

                <DataGridTextColumn Header="每箱体积" Width="60" Binding="{Binding CbmPerPackageText, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" />

                <DataGridTextColumn Header="PoNo" Width="90" Binding="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="InvoiceNo" Width="90" Binding="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>

                <DataGridTextColumn Header="备注" Width="160" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                    Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"/>
                


            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer x:Name="StatusScroll" Grid.Row="4" MaxHeight="84" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ImportStatusText}" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
