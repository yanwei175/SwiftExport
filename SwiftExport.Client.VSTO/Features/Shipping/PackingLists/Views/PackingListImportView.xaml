<UserControl x:Class="SwiftExport.Client.VSTO.Features.Shipping.PackingLists.Views.PackingListImportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:customers="clr-namespace:SwiftExport.Client.VSTO.Features.Customers.Components">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <WrapPanel>
   <ui:Button Content="加载 / 刷新配置" Command="{Binding InitializeCommand}" Margin="0,0,8,8"/>
   <ComboBox Width="230" ItemsSource="{Binding ReadProfiles}" SelectedItem="{Binding SelectedReadProfile}" DisplayMemberPath="ConfigName" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8"/>
   <ui:Button Content="设计读取配置" Command="{Binding DesignCommand}" Margin="0,0,8,8"/>
   <ui:Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,8"/>
   <ui:Button Content="读取明细" Command="{Binding ReadLinesCommand}" Margin="0,0,8,8"/>
   <ui:Button Content="新导入" Command="{Binding NewCommand}" Margin="0,0,8,8"/>
  </WrapPanel>
  <WrapPanel IsEnabled="{Binding CanEdit}">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="客户（必须选择）"/><customers:CustomerAutoSuggestComboBox Width="290" ItemsSource="{Binding ReferenceData.Customers}" SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Excel 单据编号（写入备注）"/><ui:TextBox Width="230" Text="{Binding Header.ExcelDocumentNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="收货名称"/><ui:TextBox Width="230" Text="{Binding Header.CustomerName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="收货地址"/><ui:TextBox Width="230" Text="{Binding Header.CustomerAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="联系人"/><ui:TextBox Width="230" Text="{Binding Header.Attention, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="集装箱号"/><ui:TextBox Width="230" Text="{Binding Header.ContainerNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="封条号"/><ui:TextBox Width="230" Text="{Binding Header.SealNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="出货地点"/><ui:TextBox Width="230" Text="{Binding Header.ShippingLocation, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="备注"/><ui:TextBox Width="230" Text="{Binding Header.Note, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="单据日期"/><DatePicker Width="180" SelectedDate="{Binding Header.InvoiceDate, Mode=TwoWay}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="ETD"/><DatePicker Width="180" SelectedDate="{Binding Header.Etd, Mode=TwoWay}"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="ETA"/><DatePicker Width="180" SelectedDate="{Binding Header.Eta, Mode=TwoWay}"/></StackPanel>
  </WrapPanel>
 </StackPanel>
 <WrapPanel Grid.Row="1" Margin="0,4,0,8">
  <ui:Button Content="添加行" Command="{Binding AddLineCommand}" Margin="0,0,8,0"/>
  <ui:Button Content="删除当前行" Command="{Binding DeleteLineCommand}" Margin="0,0,8,0"/>
  <ui:Button Content="检查" Command="{Binding CheckCommand}" Margin="0,0,8,0"/>
  <ui:Button Content="保存草稿 / 重试" Appearance="Primary" Command="{Binding SaveCommand}"/>
 </WrapPanel>
 <DataGrid Grid.Row="2" x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEdit}">
  <DataGrid.Columns>
   <DataGridCheckBoxColumn Header="非标" Binding="{Binding IsNonStandard, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="客户型号" Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="Excel 中性型号" Binding="{Binding OriginalLinkSku, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="系统 SKU" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
   <DataGridTextColumn Header="系统中性型号" Binding="{Binding LinkSku, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
   <DataGridTextColumn Header="描述" Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="颜色" Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTemplateColumn Header="多候选选择"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Width="180" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="Sku"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridCheckBoxColumn Header="确认型号差异" Binding="{Binding AcceptLinkSkuMismatch, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTemplateColumn Header="单位"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:TextBox Width="60" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNonStandard}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="数量" Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="每箱数量" Binding="{Binding PcsPerPackageText, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="每箱净重" Binding="{Binding NwPerPackageText, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="每箱毛重" Binding="{Binding GwPerPackageText, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="每箱体积" Binding="{Binding CbmPerPackageText, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="PO 原文" Binding="{Binding CustomerPoNo, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="Invoice 原文" Binding="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="箱唛" Binding="{Binding Marks, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="备注" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
   <DataGridTextColumn Header="检查反馈" Binding="{Binding MatchMessage, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
  </DataGrid.Columns>
 </DataGrid>
 <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding Summary}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</UserControl>
