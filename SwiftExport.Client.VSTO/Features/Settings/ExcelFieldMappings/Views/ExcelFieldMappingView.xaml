<!-- 已淘汰：旧表头别名映射链路，仅保留历史兼容；新导入使用 ExcelReadProfile／ExcelReadField 地址配置。 -->
<UserControl x:Class="SwiftExport.Client.VSTO.Features.Settings.ExcelFieldMappings.Views.ExcelFieldMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei, Segoe UI, Arial, sans-serif"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SwiftExportBackground}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Width="180" Margin="0,0,12,0">
                <TextBlock Text="分组" Margin="0,0,0,4"/>
                <ComboBox x:Name="GroupSelector" ItemsSource="{Binding Groups}"
                          Padding="0"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="DisplayName" SelectedValuePath="GroupCode"
                          SelectedValue="{Binding CurrentGroup, Mode=OneWay}"
                          SelectionChanged="OnGroupSelectionChanged"/>
            </StackPanel>
            <StackPanel Width="250">
                <TextBlock Text="搜索关键词" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Content="重新加载 / 重试" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="新增表头别名" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="保存当前分组" Command="{Binding SaveCommand}" Appearance="Primary"/>
        </WrapPanel>
        
        <DataGrid Grid.Row="2" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                  Style="{StaticResource SwiftExportDataGrid}"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  IsReadOnly="{Binding IsBusy}" MinWidth="610">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Excel 表头" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding ExcelHeader, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!--<DataGridTextColumn Header="Excel 表头" Width="170" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource DefaultDataGridTextEditingElementStyle}"
                                    Binding="{Binding ExcelHeader, UpdateSourceTrigger=PropertyChanged}"/>-->
                
                <DataGridTemplateColumn Header="目标字段" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Fields, ElementName=Root}"
                                      SelectedValuePath="FieldKey"
                                      SelectedValue="{Binding TargetFieldKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FieldKey}">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                            
                                            <TextBlock Text="  创建" Foreground="Gray"
                                                       Visibility="{Binding SupportsCreate, Converter={StaticResource VisibleWhenTrue}}"/>
                                            
                                            <TextBlock Text="  更新" Foreground="Gray"
                                                       Visibility="{Binding SupportsUpdate, Converter={StaticResource VisibleWhenTrue}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="启用" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled,Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="备注" Width="220" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                    Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
                
                <DataGridTemplateColumn Header="操作" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="删除" Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
