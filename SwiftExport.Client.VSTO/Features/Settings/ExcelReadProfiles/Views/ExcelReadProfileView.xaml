<UserControl x:Class="SwiftExport.Client.VSTO.Features.Settings.ExcelReadProfiles.Views.ExcelReadProfileView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="850"
             FontSize="{DynamicResource ControlContentThemeFontSize}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel>
                <ComboBox x:Name="GroupSelector" Width="140" ItemsSource="{Binding Groups}" DisplayMemberPath="DisplayName" SelectedValuePath="GroupCode" SelectedValue="{Binding CurrentGroupCode, Mode=OneWay}" IsEnabled="{Binding CanChangeFields}" SelectionChanged="GroupChanged" Margin="0,0,8,8"/>
                <ComboBox x:Name="ProfileSelector" IsEnabled="{Binding CanChangeFields}" Width="140" ItemsSource="{Binding Profiles}" DisplayMemberPath="ConfigName" SelectedValuePath="Uid" SelectedValue="{Binding CurrentUid, Mode=OneWay}" SelectionChanged="ProfileChanged" Margin="0,0,8,8"/>
                <Button Content="重新加载" Command="{Binding ReloadCommand}" Margin="0,0,8,8"/>
                <Button Content="新建空配置" Command="{Binding CreateCommand}" Margin="0,0,8,8"/>
                <ui:Button Content="保存配置" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
                <Button Content="删除配置" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/>
                <Button Content="预览已保存配置" Command="{Binding PreviewCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <WrapPanel IsEnabled="{Binding CanChangeFields}">
                <StackPanel Width="140" Margin="0,0,12,8">
                    <TextBlock Text="配置名称"/>
                    <TextBox Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,12,8">
                    <TextBlock Text="参考工作表名称（可空）"/>
                    <TextBox Text="{Binding WorksheetName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="读取使用当前活动工作表；参考名称不限定来源。单头选择存放值的单元格，明细选择第一条数据，不选表头。" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource SwiftExportBackground}">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Margin="0,0,0,8" IsEnabled="{Binding CanChangeFields}">
                    <StackPanel>
                        <TextBlock Text="单头地址配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="HeaderFieldsControl" ItemsSource="{Binding HeaderFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="220" Margin="0,0,8,8" IsEnabled="{Binding IsKnown}">
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FieldKey}" Margin="0,0,0,4"/>
                                        <controls:ExcelCellAddressBox Address="{Binding CellAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                      CommandParameter="{Binding}"
                                                                PickCommand="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                  ClearCommand="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource SwiftExportForeground}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding CanChangeFields}">
                    <StackPanel>
                        <TextBlock Text="明细第一条数据地址（不是表头）" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="Red"/>
                        <TextBlock Text="例如第 7 行是表头、第 8 行是第一条数据：客户型号选 C8，数量选 K8。所有明细字段必须从同一行开始，读取包含这一行。"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="单头合并单元格读取左上角的值；明细允许同一行内横向合并。销售净重、毛重、体积的跨行合并合计留空提示，其余字段继续读取；PackingList 的可选箱唛及每箱包装数值跨行合并也留空提示。数量、型号等其他字段仍不能跨行合并，请让一行对应一条明细。"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <DataGrid x:Name="FieldGrid" 
                              FontSize="{DynamicResource ControlContentThemeFontSize}"
                              ItemsSource="{Binding LineFields}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              MinHeight="260" 
                              MaxHeight="420">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="映射字段" Width="2*" MinWidth="120" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FieldKey}" TextWrapping="Wrap" FontSize="11" Opacity="0.6"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="第一条数据地址" Width="2*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4" VerticalAlignment="Center">
                                                <TextBox Text="{Binding CellAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="填写第一条明细数据的单元格地址，不填表头；所有明细字段的行号须一致。"
                                                     IsEnabled="{Binding IsKnown}"/>
                                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.6"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="向下读取" Width="75" MinWidth="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDownward, Mode=TwoWay}" IsEnabled="{Binding IsKnown}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="明细必须向下读取，保存时校验"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="操作" Width="130" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <Button Content="获取" ToolTip="选择第一条明细数据的单元格，不选表头或整列。" Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                <Button Content="清除" Margin="4,0,0,0" Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="2" IsEnabled="{Binding CanChangeFields}">
                    <StackPanel>
                        <TextBlock Text="明细结束边界" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding EndMode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
                            <ComboBoxItem Content="未设置">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>0</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="指定列最后一个非空且未合并的单元格">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>1</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="指定汇总单元格所在行之前">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>2</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                        <WrapPanel>
                            <TextBlock Text="末行判断列" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="60" Text="{Binding LastRowColumn, UpdateSourceTrigger=PropertyChanged}" ToolTip="建议选客户型号等未合并的明细列；从底部跳过空白及合并单元格，定位最后一条数据。"/>
                            <Button Content="获取列" Command="{Binding PickLastColumnCommand}" Margin="4,0,16,0"/>

                            <TextBlock Text="汇总单元格" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="60" Text="{Binding SummaryCellAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="获取地址" Command="{Binding PickSummaryCommand}" Margin="4,0,0,0"/>

                        </WrapPanel>
                        <TextBlock Text="按列判断末行时跳过合并单元格（包括横向合并），仍包含隐藏行。未合并的合计或备注不会自动排除；判断列应选明细专用列，或改用汇总单元格所在行之前。"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="备注" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="Red"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
