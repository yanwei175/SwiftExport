<UserControl x:Class="SwiftExport.Client.VSTO.Features.Settings.ExcelReadProfiles.Views.ExcelReadProfileView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SwiftExportBackground}">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Margin="0,0,0,8">
  <WrapPanel>
   <ComboBox x:Name="ProfileSelector" IsEnabled="{Binding CanChangeFields}" Width="220" ItemsSource="{Binding Profiles}" DisplayMemberPath="ConfigName" SelectedValuePath="Uid" SelectedValue="{Binding CurrentUid, Mode=OneWay}" SelectionChanged="ProfileChanged" Margin="0,0,8,8"/>
   <Button Content="重新加载" Command="{Binding ReloadCommand}" Margin="0,0,8,8"/>
   <Button Content="新建空配置" Command="{Binding CreateCommand}" Margin="0,0,8,8"/>
   <ui:Button Content="保存配置" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
   <Button Content="删除配置" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/>
   <Button Content="预览已保存配置" Command="{Binding PreviewCommand}" Margin="0,0,8,8"/>
  </WrapPanel>
  <WrapPanel IsEnabled="{Binding CanChangeFields}">
   <StackPanel Width="240" Margin="0,0,12,8"><TextBlock Text="配置名称"/><TextBox Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Width="240" Margin="0,0,12,8"><TextBlock Text="参考工作表名称（可空）"/><TextBox Text="{Binding WorksheetName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  </WrapPanel>
  <TextBlock Text="读取使用当前活动工作表；参考名称不限定来源。单头读取一次，明细地址选择首条明细。" TextWrapping="Wrap"/>
 </StackPanel>
 <ui:Card Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding CanChangeFields}">
  <StackPanel><TextBlock Text="单头地址配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <ItemsControl ItemsSource="{Binding HeaderFields}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,0,0,8" IsEnabled="{Binding IsKnown}">
     <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FieldKey}" Margin="0,0,0,4"/>
     <controls:ExcelCellAddressBox Address="{Binding CellAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding}"
      PickCommand="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ClearCommand="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
     <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource SwiftExportForeground}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></StackPanel>
 </ui:Card>
 <ui:Card Grid.Row="2" Margin="0,0,0,8" IsEnabled="{Binding CanChangeFields}">
  <StackPanel><TextBlock Text="明细首行地址配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <DataGrid x:Name="FieldGrid" ItemsSource="{Binding LineFields}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="260" MaxHeight="420">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="映射字段" Width="2*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/><TextBlock Text="{Binding FieldKey}" TextWrapping="Wrap" FontSize="11" Opacity="0.6"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="单元格地址" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBox Text="{Binding CellAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsKnown}"/><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="向下读取" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsDownward, Mode=TwoWay}" IsEnabled="{Binding IsKnown}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="明细必须向下读取，保存时校验"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="操作" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4"><Button Content="获取" Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="清除" Margin="4,0,0,0" Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
 </ui:Card>
 <ui:Card Grid.Row="3" IsEnabled="{Binding CanChangeFields}"><StackPanel>
  <TextBlock Text="明细结束边界" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <ComboBox SelectedValue="{Binding EndMode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,8">
   <ComboBoxItem Content="未设置"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
   <ComboBoxItem Content="指定列的最后有值行"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
   <ComboBoxItem Content="指定汇总单元格所在行之前"><ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
  </ComboBox>
  <WrapPanel>
   <TextBlock Text="末行判断列" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="100" Text="{Binding LastRowColumn, UpdateSourceTrigger=PropertyChanged}"/><Button Content="获取列" Command="{Binding PickLastColumnCommand}" Margin="4,0,16,0"/>
   <TextBlock Text="汇总单元格" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="100" Text="{Binding SummaryCellAddress, UpdateSourceTrigger=PropertyChanged}"/><Button Content="获取地址" Command="{Binding PickSummaryCommand}" Margin="4,0,0,0"/>
  </WrapPanel>
  <TextBlock Text="备注" Margin="0,8,0,4"/><TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
 </StackPanel></ui:Card>
 <StackPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="Red"/></StackPanel>
 </Grid></ScrollViewer>
</UserControl>