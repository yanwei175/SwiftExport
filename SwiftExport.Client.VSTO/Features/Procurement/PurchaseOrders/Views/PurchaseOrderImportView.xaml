<UserControl
             x:Class="SwiftExport.Client.VSTO.Features.Procurement.PurchaseOrders.Views.PurchaseOrderImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls"
             xmlns:customers="clr-namespace:SwiftExport.Client.VSTO.Features.Customers.Components"
             xmlns:suppliers="clr-namespace:SwiftExport.Client.VSTO.Features.Suppliers.Components"
             xmlns:vm="clr-namespace:SwiftExport.Client.VSTO.Features.Procurement.PurchaseOrders.ViewModels"
             mc:Ignorable="d"
             d:Width="1980"
             d:Height="1020"
             d:DataContext="{d:DesignInstance vm:PurchaseOrderImportViewModel}"
             Background="{DynamicResource SwiftExportBackground}"
             Foreground="{DynamicResource SwiftExportForeground}"
             FontSize="{DynamicResource ControlContentThemeFontSize}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ExtraFieldsVisibility" />
        <Style x:Key="ImportStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="Red" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="120"/>
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <WrapPanel Margin="0,0,0,8">
                <ui:Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,8" Appearance="Info"/>

                <ComboBox Width="220" 
                          ItemsSource="{Binding ReadProfiles}" 
                          DisplayMemberPath="ConfigName" 
                          SelectedItem="{Binding SelectedReadProfile, Mode=TwoWay}" 
                          IsEnabled="{Binding CanSelectReadProfile}" Margin="0,0,8,8" />

                <ui:Button Content="读取明细" Command="{Binding ReadLinesCommand}" Margin="0,0,8,8" Appearance="Info"/>
                <ui:Button Content="检验与匹配" Command="{Binding CheckImportCommand}" Margin="0,0,8,8" />
                <ui:Button Content="保存草稿" Appearance="Primary" Command="{Binding SaveDraftCommand}" Margin="0,0,8,8" />

                <ui:DropDownButton Content="更多功能" Margin="0,0,8,8">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu Style="{StaticResource  UiContextMenu}">
                            <ui:MenuItem Header="刷新读取配置" Command="{Binding RefreshReadProfilesCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="设计读取配置" Command="{Binding DesignReadProfileCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="加载基础资料 / 重试" Command="{Binding InitializeCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="重新获取客户采购配置" Command="{Binding RefreshDefaultsCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <Separator />
                            <ui:MenuItem Header="重试原保存请求" Command="{Binding RetrySaveCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="开始新导入" Command="{Binding NewImportCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </WrapPanel>
            <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding SubmissionMessage}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DefaultsMessage}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ParseMessage}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
            <Grid IsEnabled="{Binding IsEditable}">
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="客户 *" Foreground="Red" FontWeight="Bold" />
                <customers:CustomerAutoSuggestComboBox Grid.Column="2" Grid.Row="0" ItemsSource="{Binding ReferenceData.Customers}" SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}" SelectionCommittedCommand="{Binding CustomerSelectedCommand}" SelectionClearedCommand="{Binding CustomerClearedCommand}" />
                <TextBlock Grid.Column="0" Grid.Row="2" Text="客户 PO" />
                <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding Header.CustomerPoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="0" Grid.Row="4" Text="BONO" />
                <TextBox Grid.Column="2" Grid.Row="4" Text="{Binding Header.BoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="0" Grid.Row="6" Text="业务员" />
                <TextBox Grid.Column="2" Grid.Row="6" Text="{Binding Header.SalesPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="0" Grid.Row="8" Grid.RowSpan="3" Text="特殊要求" />
                <TextBox Grid.Column="2" Grid.Row="8" Grid.RowSpan="3" Text="{Binding Header.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Column="4" Grid.Row="0" Text="订单日期 *" Foreground="Red" FontWeight="Bold" />
                <DatePicker Grid.Column="6" Grid.Row="0" SelectedDate="{Binding Header.OrderDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" SelectedDateFormat="Short" />
                <TextBlock Grid.Column="4" Grid.Row="2" Text="预计交期" />
                <DatePicker Grid.Column="6" Grid.Row="2" SelectedDate="{Binding Header.DeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" SelectedDateFormat="Short" />
                <TextBlock Grid.Column="4" Grid.Row="4" Text="回复交期" />
                <DatePicker Grid.Column="6" Grid.Row="4" SelectedDate="{Binding Header.ReplyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" SelectedDateFormat="Short" />
                <TextBlock Grid.Column="4" Grid.Row="6" Text="跟单员" />
                <TextBox Grid.Column="6" Grid.Row="6" Text="{Binding Header.PurchasePerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="4" Grid.Row="8" Text="系统单号" />
                <TextBox Grid.Column="6" Grid.Row="8" Text="{Binding OrderNo, Mode=OneWay}" IsReadOnly="True" />
                <TextBlock Grid.Column="4" Grid.Row="10" Text="匹配客户" />
                <TextBlock Grid.Column="6" Grid.Row="10" Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header.CustomerCode}" />

                <TextBlock Grid.Column="8" Grid.Row="0" Text="实际供应商 *" Foreground="Red" FontWeight="Bold" />
                <suppliers:SupplierAutoSuggestComboBox Grid.Column="10" Grid.Row="0" ItemsSource="{Binding ReferenceData.Suppliers}" SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}" />
                <TextBlock Grid.Column="8" Grid.Row="2" Text="进水管" />
                <TextBox Grid.Column="10" Grid.Row="2" Text="{Binding Header.InletHoseType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="8" Grid.Row="4" Text="起泡器" />
                <TextBox Grid.Column="10" Grid.Row="4" Text="{Binding Header.AeratorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="8" Grid.Row="6" Text="托盘" />
                <TextBox Grid.Column="10" Grid.Row="6" Text="{Binding Header.PalletType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="8" Grid.Row="8" Text="币种" />
                <TextBox Grid.Column="10" Grid.Row="8" Text="CNY" IsReadOnly="True" />
                <TextBlock Grid.Column="12" Grid.Row="8" Text="折扣倍率" />
                <TextBox Grid.Column="14" Grid.Row="8" x:Name="DiscountRateBox" Text="{Binding Header.DiscountRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="12" Grid.Row="10" Text="整单折扣金额" />
                <TextBox Grid.Column="14" Grid.Row="10" x:Name="DiscountAmountBox" Text="{Binding Header.DiscountAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />


                <TextBlock Grid.Column="12" Grid.Row="0" Text="内盒" />
                <TextBox Grid.Column="14" Grid.Row="0" Text="{Binding Header.BoxType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="12" Grid.Row="2" Text="标贴" />
                <TextBox Grid.Column="14" Grid.Row="2" Text="{Binding Header.LabelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="12" Grid.Row="4" Text="说明书" />
                <TextBox Grid.Column="14" Grid.Row="4" Text="{Binding Header.InstructionManualType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="12" Grid.Row="6" Text="外箱" />
                <TextBox Grid.Column="14" Grid.Row="6" Text="{Binding Header.CartonType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <TextBlock Grid.Column="16" Grid.Row="0" Text="光标" Grid.RowSpan="7" />
                <TextBox Grid.Column="18" Grid.Row="0" Grid.RowSpan="7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         FontWeight="Bold" FontSize="24"
                         Text="{Binding Header.LogoType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <TextBlock Grid.Column="16" Grid.Row="8" Grid.RowSpan="3" Text="折扣备注" />
                <TextBox Grid.Column="18" Grid.Row="8" Grid.RowSpan="3" Text="{Binding Header.DiscountRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </ui:Card>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

        <ui:Card Grid.Row="3" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    
                    <ui:Button Content="添加标准行" Command="{Binding AddStandardLineCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="添加非标行" Command="{Binding AddNonStandardLineCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="删除选中行" Command="{Binding DeleteSelectedLineCommand}" />
                    <ui:Button Content="匹配全部 SKU" Command="{Binding MatchAllSkusCommand}" Margin="8,0,0,0" />
                    

                    
                    <ui:ToggleSwitch x:Name="ExtraFieldsSwitch" Content="显示更多字段" IsChecked="False" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="显示或隐藏次要明细字段；不清除已有数据" AutomationProperties.Name="显示更多明细字段" />
                    
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="明细：" />
                        <TextBlock Text="{Binding Lines.Count}" Margin="0,0,20,0" />
                        <TextBlock Text="输入数量统计：" />
                        <TextBlock Text="{Binding TotalQuantity}" Margin="0,0,20,0" />
                        <TextBlock Text="CNY 未税行金额：" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" />
                    </StackPanel>
                </WrapPanel>
                <DataGrid x:Name="OrderLinesGrid" Grid.Row="1" 
                          FrozenColumnCount="5"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          RowHeight="{DynamicResource DataGridRowHeightMedium}"
                          ItemsSource="{Binding Lines}" 
                          Style="{StaticResource SwiftExportDataGrid}" 
                          FontSize="10"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          RowHeaderWidth="24"
                          CanUserSortColumns="True"
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow" 
                          IsReadOnly="{Binding IsReadOnly}" 
                          SelectionChanged="OnSelectionChanged">
                    
                    <DataGrid.RowHeaderTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10"
                                     ToolTip="{Binding DataContext.CheckStatusText, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                     AutomationProperties.Name="{Binding DataContext.CheckStatusText, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsCheckPassed, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGrid.RowHeaderTemplate>
                    
                    <DataGrid.Columns>
                        
                        <DataGridTemplateColumn Header="校验" Width="130" IsReadOnly="True"
                                        SortMemberPath="IsCheckPassed" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        
                                        <TextBlock Text="{Binding CheckStatusText}" ToolTip="{Binding MatchMessage}" />
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            
                                            <ui:Button Content="匹配 SKU" Padding="6,2"
                                                       Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged"
                                                       CommandParameter="{Binding}"
                                                       Command="{Binding DataContext.MatchLineSkuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="只匹配本行；保存前仍须整单检验"
                                                       AutomationProperties.Name="匹配本行 SKU" />
                                            
                                            <ToggleButton x:Name="MatchActionsEntry" Content="处理" Margin="4,0,0,0" Padding="6,2"
                                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          ToolTip="查看匹配反馈、选择候选并确认型号差异"
                                                          AutomationProperties.Name="本行匹配处理" />
                                            
                                            <controls:ImportHeaderPopup x:Name="RowMatchPopup"
                                                                        EntryButton="{Binding ElementName=MatchActionsEntry}"
                                                                        PlacementTarget="{Binding ElementName=MatchActionsEntry}"
                                                                        IsOpen="{Binding IsChecked, ElementName=MatchActionsEntry, Mode=TwoWay}"
                                                                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                        Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                                        Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                
                                                <Border Width="420" Padding="12" CornerRadius="4"
                                                        Background="{DynamicResource SwiftExportBackground}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                        TextElement.Foreground="{DynamicResource SwiftExportForeground}"
                                                        TextElement.FontFamily="{Binding PlacementTarget.FontFamily, ElementName=RowMatchPopup}"
                                                        TextElement.FontSize="{DynamicResource ControlContentThemeFontSize}">
                                                    
                                                    <StackPanel>
                                                        
                                                        <DockPanel Margin="0,0,0,8">
                                                            
                                                            <Button DockPanel.Dock="Right" Content="关闭" Command="{x:Static ApplicationCommands.Close}" />
                                                            
                                                            <TextBlock Text="本行匹配处理" FontWeight="Bold" VerticalAlignment="Center" />
                                                            
                                                        </DockPanel>
                                                        
                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                            
                                                            <StackPanel>
                                                                
                                                                <TextBlock Text="{Binding CustomerSku, StringFormat='客户型号：{0}'}" TextWrapping="Wrap" />
                                                                
                                                                <TextBlock Text="{Binding OriginalLinkSku, StringFormat='Excel 中性型号：{0}'}" TextWrapping="Wrap" />
                                                                
                                                                <TextBlock Text="{Binding LinkSku, StringFormat='系统中性型号：{0}'}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                                
                                                                <StackPanel IsEnabled="{Binding Tag.IsEditable, ElementName=RowMatchPopup}">
                                                                    
                                                                    <TextBlock Text="候选 SKU" />
                                                                    
                                                                    <ComboBox ItemsSource="{Binding MatchCandidates}"
                                                                              SelectedItem="{Binding SelectedMatchCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              AutomationProperties.Name="产品匹配候选">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Sku}" />
                                                                                    <TextBlock Text="{Binding LinkSku, StringFormat=' / {0}'}" />
                                                                                    <TextBlock Text="{Binding IsUsable, StringFormat=' / 可用：{0}'}" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    
                                                                    <ui:Button Content="应用候选（需重新匹配）" HorizontalAlignment="Left" Margin="0,8,0,8"
                                                                               Command="{Binding Tag.ChooseMatchCommand, ElementName=RowMatchPopup}"
                                                                               CommandParameter="{Binding}" />
                                                                    
                                                                    <CheckBox Content="已核对 Excel 与系统中性型号，确认差异"
                                                                                IsChecked="{Binding AcceptLinkSkuMismatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    
                                                                    <ui:Button Content="匹配本行 SKU" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                               Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged"
                                                                               Command="{Binding Tag.MatchLineSkuCommand, ElementName=RowMatchPopup}"
                                                                               CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                
                                                                <TextBlock Text="{Binding MatchMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="Red"/>
                                                                
                                                                <TextBlock Text="行匹配通过后，保存前仍须执行顶部整单检验。" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                                
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </controls:ImportHeaderPopup>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="非标件" Width="60" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsNonStandard, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Command="{Binding DataContext.ToggleNonStandardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                              CommandParameter="{Binding}" AutomationProperties.Name="非标件" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="系统图片" Width="64" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HttpsImage SourcePath="{Binding MainImage}" Width="64" Height="64" Stretch="Uniform" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="系统SKU" Width="120" 
                                            Binding="{Binding Sku, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="客户型号" Width="120" 
                                            Binding="{Binding CustomerSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="Excel本司型号" Width="120" 
                                            Binding="{Binding OriginalLinkSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="系统LinkSku" Width="120" 
                                            Binding="{Binding LinkSku, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="工厂型号" Width="120"  
                                            Binding="{Binding SupplierSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="中文描述" Width="160" 
                                            Binding="{Binding DescriptionZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="表面处理" Width="100" 
                                            Binding="{Binding FinishZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="配置" Width="160"
                                            Binding="{Binding FeaturesZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />
                        
                        <DataGridTextColumn Header="未税单价" Width="80" 
                                            Binding="{Binding UnitPriceText, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            FontWeight="Bold"
                                            IsReadOnly="False" />
                        
                        
                        <DataGridTextColumn Header="数量" Width="80" Binding="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuantityNonPositive}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuantityNonPositive}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="单位" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEnabled="{Binding CanEditUnit}" 
                                              IsEditable="True" 
                                              ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                              Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="未税金额" Width="80" 
                                            Binding="{Binding Amount, StringFormat=N2}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            FontWeight="Bold"
                                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="客供件送至供应商" Width="160" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="4,2,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />                                            
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" IsEnabled="{Binding CanChooseDeliverySupplier}" Margin="0,0,4,0"
                                                  ItemsSource="{Binding DataContext.ReferenceData.Suppliers, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  DisplayMemberPath="SupplierName" 
                                                  SelectedValuePath="Uid" 
                                                  SelectedValue="{Binding DeliverySupplierId, Mode=TwoWay}" />

                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Delete24}" BorderThickness="0" 
                                                   Command="{Binding DataContext.ClearDeliverySupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="计划交期" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding PlannedDeliveryDate, Mode=TwoWay}" SelectedDateFormat="Short" Margin="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>                        
                        
                        <DataGridTextColumn Header="行备注" Width="220"  Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                            Binding="{Binding SubNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="False" />

                        <DataGridTextColumn Header="物料类型" Width="100"  
                                            Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                            Binding="{Binding MaterialType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="供货方式" Width="90"  
                                            Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                            Binding="{Binding SupplyType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="含税单价（可空）" Width="140" 
                                            Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}"  
                                            Binding="{Binding TaxPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                            ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}"
                                            EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}"
                                            FontWeight="Bold"
                                            IsReadOnly="False" />                     
                        
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </ui:Card>


    </Grid>
</UserControl>
