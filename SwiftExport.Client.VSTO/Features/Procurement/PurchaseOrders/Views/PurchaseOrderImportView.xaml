<UserControl x:Class="SwiftExport.Client.VSTO.Features.Procurement.PurchaseOrders.Views.PurchaseOrderImportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls"
 xmlns:suppliers="clr-namespace:SwiftExport.Client.VSTO.Features.Suppliers.Components">
 <Grid Margin="16" Background="Transparent">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="3*"/>
   <RowDefinition Height="2*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
  <TextBlock Text="采购订单导入" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="读取 Excel → 手工修正 → 检验并匹配 → 新建无来源草稿。币种固定 CNY，单价为未税价。" Margin="0,4,0,12"/>
  <WrapPanel Margin="0,0,0,12">
   <ComboBox Width="220" ItemsSource="{Binding ReadProfiles}" DisplayMemberPath="ConfigName" SelectedItem="{Binding SelectedReadProfile, Mode=TwoWay}" IsEnabled="{Binding CanSelectReadProfile}" Margin="0,0,8,8"/>
   <Button Content="刷新读取配置" Command="{Binding RefreshReadProfilesCommand}" Margin="0,0,8,8"/>
   <Button Content="设计读取配置" Command="{Binding DesignReadProfileCommand}" Margin="0,0,8,8"/>
   <Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,8"/>
   <Button Content="读取明细" Command="{Binding ReadLinesCommand}" Margin="0,0,8,8"/>
   <Button Content="加载基础资料 / 重试" Command="{Binding InitializeCommand}" Margin="0,0,8,8"/>
   <Button Content="检验采购订单" Command="{Binding CheckImportCommand}" Margin="0,0,8,8"/>
   <ui:Button Content="保存草稿" Appearance="Primary" Command="{Binding SaveDraftCommand}" Margin="0,0,8,8"/>
   <Button Content="重试原保存请求" Command="{Binding RetrySaveCommand}" Margin="0,0,8,8"/>
   <Button Content="开始新导入" Command="{Binding NewImportCommand}" Margin="0,0,8,8"/>
  </WrapPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
  <ui:Card Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="单头资料" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <WrapPanel IsEnabled="{Binding IsEditable}">
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="客户代码" Margin="0,0,0,4"/><TextBox Text="{Binding Header.CustomerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="实际供应商" Margin="0,0,0,4"/><suppliers:SupplierAutoSuggestComboBox ItemsSource="{Binding ReferenceData.Suppliers}" SelectedSupplier="{Binding SelectedSupplier, Mode=TwoWay}"/></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="Excel采购单号" Margin="0,0,0,4"/><TextBox Text="{Binding Header.BoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="客户PO" Margin="0,0,0,4"/><TextBox Text="{Binding Header.CustomerPoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="业务员" Margin="0,0,0,4"/><TextBox Text="{Binding Header.SalesPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="跟单员" Margin="0,0,0,4"/><TextBox Text="{Binding Header.PurchasePerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="订单日期" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding Header.OrderDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="新行默认交期" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding Header.DeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="供应商回复交期" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding Header.ReplyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
    </WrapPanel>
    <WrapPanel><TextBlock Text="匹配客户：" /><TextBlock Text="{Binding CustomerName}" Margin="0,0,24,0"/><TextBlock Text="系统采购号："/><TextBlock Text="{Binding OrderNo}"/></WrapPanel>
   </StackPanel>
  </ui:Card>
  <ui:Card Margin="0,0,0,12" IsEnabled="{Binding IsEditable}">
   <StackPanel><TextBlock Text="包装、配置及优惠记录" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <WrapPanel><StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="进水管" Margin="0,0,0,4"/><TextBox Text="{Binding Header.InletHoseType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="起泡器" Margin="0,0,0,4"/><TextBox Text="{Binding Header.AeratorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="托盘" Margin="0,0,0,4"/><TextBox Text="{Binding Header.PalletType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="内盒" Margin="0,0,0,4"/><TextBox Text="{Binding Header.BoxType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="标贴" Margin="0,0,0,4"/><TextBox Text="{Binding Header.LabelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="说明书" Margin="0,0,0,4"/><TextBox Text="{Binding Header.InstructionManualType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="外箱" Margin="0,0,0,4"/><TextBox Text="{Binding Header.CartonType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="商标" Margin="0,0,0,4"/><TextBox Text="{Binding Header.LogoType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="优惠备注" Margin="0,0,0,4"/><TextBox Text="{Binding Header.DiscountRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="优惠倍率" Margin="0,0,0,4"/><TextBox Text="{Binding Header.DiscountRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel>
<StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="整单优惠金额" Margin="0,0,0,4"/><TextBox Text="{Binding Header.DiscountAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" /></StackPanel></WrapPanel>
    <TextBlock Text="优惠倍率与整单优惠金额只记录，不改变下方行金额汇总。" Margin="0,0,0,8"/>
    <TextBlock Text="特殊要求（Remark）" Margin="0,0,0,4"/><TextBox Text="{Binding Header.Remark, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
   </StackPanel>
  </ui:Card>
  </StackPanel>
  </ScrollViewer>
  <ui:Card Grid.Row="2">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
    <Button Content="添加标准行" Command="{Binding AddStandardLineCommand}" Margin="0,0,8,0"/>
    <Button Content="添加非标行" Command="{Binding AddNonStandardLineCommand}" Margin="0,0,8,0"/>
    <Button Content="删除选中行" Command="{Binding DeleteSelectedLineCommand}"/>
   </WrapPanel>
   <DataGrid x:Name="OrderLinesGrid" Grid.Row="1" ItemsSource="{Binding Lines}" Style="{StaticResource SwiftExportDataGrid}"
    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
    IsReadOnly="{Binding IsReadOnly}" SelectionChanged="OnSelectionChanged">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="行类型" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"><CheckBox Content="非标产品" IsChecked="{Binding IsNonStandard, Mode=OneWay}" Command="{Binding DataContext.ToggleNonStandardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="系统图片" Width="80" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:HttpsImage SourcePath="{Binding MainImage}" Width="64" Height="64" Stretch="Uniform"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="系统SKU" Width="150" Binding="{Binding Sku, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
     <DataGridTextColumn Header="客户型号" Width="140" Binding="{Binding CustomerSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="Excel本司型号" Width="160" Binding="{Binding OriginalLinkSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="系统LinkSku" Width="150" Binding="{Binding LinkSku, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
     <DataGridTextColumn Header="工厂型号" Width="140" Binding="{Binding SupplierSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="中文描述" Width="220" Binding="{Binding DescriptionZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="表面处理" Width="140" Binding="{Binding FinishZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="配置" Width="230" Binding="{Binding FeaturesZh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="物料类型" Width="100" Binding="{Binding MaterialType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
     <DataGridTextColumn Header="供货方式" Width="90" Binding="{Binding SupplyType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="单位" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Unit}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox IsEnabled="{Binding CanEditUnit}" IsEditable="True" ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="数量" Width="100" Binding="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="未税单价" Width="120" Binding="{Binding UnitPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="含税单价（可空）" Width="140" Binding="{Binding TaxPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTextColumn Header="未税金额" Width="140" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="计划交期" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PlannedDeliveryDate, StringFormat=yyyy-MM-dd}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><DatePicker SelectedDate="{Binding PlannedDeliveryDate, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="客供件送至供应商" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"><ComboBox IsEnabled="{Binding CanChooseDeliverySupplier}" ItemsSource="{Binding DataContext.ReferenceData.Suppliers, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="SupplierName" SelectedValuePath="Uid" SelectedValue="{Binding DeliverySupplierId, Mode=TwoWay}"/><Button Content="清除送达供应商" Command="{Binding DataContext.ClearDeliverySupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="行备注" Width="220" Binding="{Binding SubNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsReadOnly="False"/>
     <DataGridTemplateColumn Header="检验 / 候选 / 型号确认" Width="330"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel><TextBlock Text="{Binding MatchMessage}" TextWrapping="Wrap"/>
       <StackPanel IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}">
        <ComboBox ItemsSource="{Binding MatchCandidates}" SelectedItem="{Binding SelectedMatchCandidate, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Sku}"/><TextBlock Text="{Binding LinkSku}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <Button Content="使用所选候选" Command="{Binding DataContext.ChooseMatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
        <CheckBox Content="确认 Excel 本司型号与系统型号差异" IsChecked="{Binding AcceptLinkSkuMismatch, Mode=TwoWay}"/>
       </StackPanel>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <WrapPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="明细：" /><TextBlock Text="{Binding Lines.Count}" Margin="0,0,20,0"/><TextBlock Text="输入数量统计：" /><TextBlock Text="{Binding TotalQuantity}" Margin="0,0,20,0"/><TextBlock Text="CNY 未税行金额：" /><TextBlock Text="{Binding TotalAmount, StringFormat=N2}"/></WrapPanel>
   </Grid>
  </ui:Card>
  <StackPanel Grid.Row="3">
  <TextBlock Text="{Binding ParseMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <TextBlock Text="{Binding SubmissionMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,8,0,0"/>
  <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="Red" Margin="0,8,0,0"/>
 </StackPanel>
 </Grid>
</UserControl>
