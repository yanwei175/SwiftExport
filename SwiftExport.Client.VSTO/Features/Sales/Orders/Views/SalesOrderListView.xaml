<UserControl x:Class="SwiftExport.Client.VSTO.Features.Sales.Orders.Views.SalesOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="850"
             Background="{DynamicResource SwiftExportBackground}" Foreground="{DynamicResource SwiftExportForeground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Excel 工具栏" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="OutputPathBox" Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="输出路径" AutomationProperties.Name="Excel 输出路径"/>
            <WrapPanel Margin="0,8,0,0">
                <ui:Button x:Name="GenerateSelectedButton" Content="生成选中订单成 Excel（待实现）" IsEnabled="False" Margin="0,0,8,4"/>
                <ui:Button x:Name="GenerateCheckedButton" Content="批量生成勾选订单成 Excel（待实现）" IsEnabled="False" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CheckedCount, StringFormat=本页已勾选：{0}}" VerticalAlignment="Center" Margin="0,0,8,4"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" IsEnabled="{Binding CanBrowse}" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="Keyword" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="关键词" AutomationProperties.Name="销售订单关键词">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,0,8">
                <TextBlock Text="客户代码" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空查询全部客户" AutomationProperties.Name="客户代码"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,8,8">
                <TextBlock Text="确认状态" Margin="0,0,0,4"/>
                <ComboBox x:Name="ConfirmationSelector" ItemsSource="{Binding ConfirmationOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding Confirmation, Mode=TwoWay}" AutomationProperties.Name="确认状态"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                <TextBlock Text="快捷视图" Margin="0,0,0,4"/>
                <ComboBox x:Name="QuickViewSelector" ItemsSource="{Binding QuickViewOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding QuickView, Mode=TwoWay}" AutomationProperties.Name="快捷视图"/>
            </StackPanel>
            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
                <ui:Button Content="查询" Command="{Binding SearchCommand}" Appearance="Primary" Margin="0,0,8,0"/>
                <ui:Button Content="刷新" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SwiftExportError}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            <TextBlock Text="数量为 — 表示无法汇总；数量单位见行提示。" FontSize="12" Opacity="0.7"/>
        </StackPanel>
        <DataGrid x:Name="OrdersGrid" Grid.Row="3" 
                  ItemsSource="{Binding Orders}" 
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                  FontSize="{DynamicResource ControlContentThemeFontSize}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  SelectionMode="Single" 
                  SelectionUnit="FullRow" 
                  IsEnabled="{Binding CanBrowse}"
                  EnableRowVirtualization="True" 
                  EnableColumnVirtualization="True" 
                  AutomationProperties.Name="销售订单列表">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Order.UnitSnapshot, StringFormat=数量单位：{0}}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="勾选" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="勾选订单"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="确认" Binding="{Binding ConfirmationText}" IsReadOnly="True" Width="64"/>
                <DataGridTextColumn Header="单据" Binding="{Binding DocumentText}" IsReadOnly="True" Width="64"/>
                <DataGridTextColumn Header="执行" Binding="{Binding FulfillmentText}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="订单号" Binding="{Binding Order.OrderNo}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="发票号" Binding="{Binding Order.InvoiceNo}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Order.TotalQty, StringFormat={}{0:N2}, TargetNullValue=—}" IsReadOnly="True" Width="72"/>
                <DataGridTextColumn Header="已交" Binding="{Binding Order.TotalShippedQty, StringFormat={}{0:N2}, TargetNullValue=—}" IsReadOnly="True" Width="72"/>
                <DataGridTextColumn Header="未交" Binding="{Binding Order.TotalUnshippedQty, StringFormat={}{0:N2}, TargetNullValue=—}" IsReadOnly="True" Width="72"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ui:Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="下一页" Command="{Binding NextPageCommand}" DockPanel.Dock="Right"/>
            <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
