<UserControl
             x:Class="SwiftExport.Client.VSTO.Features.Sales.Orders.Views.SalesOrderImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SwiftExport.Client.VSTO.Resources.Converters"
             xmlns:custromers="clr-namespace:SwiftExport.Client.VSTO.Features.Customers.Components"
             xmlns:sales="clr-namespace:SwiftExport.Client.VSTO.Features.Sales.Orders.Components"
             xmlns:vm="clr-namespace:SwiftExport.Client.VSTO.Features.Sales.Orders.ViewModels"
             mc:Ignorable="d"
             d:Width="1980"
             d:Height="1020"
             d:DataContext="{d:DesignInstance vm:SalesOrderImportViewModel}"
             Background="{DynamicResource SwiftExportBackground}"
             Foreground="{DynamicResource SwiftExportForeground}"
             FontSize="{DynamicResource ControlContentThemeFontSize}"
             xmlns:controls="clr-namespace:SwiftExport.Client.VSTO.Resources.Controls">
    <UserControl.Resources>
        <converters:ImportHeaderMaxHeightConverter x:Key="ImportHeaderMaxHeight" />
        <BooleanToVisibilityConverter x:Key="ExtraFieldsVisibility" />
        <Style x:Key="ImportQtyText" TargetType="TextBlock" BasedOn="{StaticResource SwiftExportDataGridNumberTextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQtyNonPositive}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImportQtyEditor" TargetType="TextBox" BasedOn="{StaticResource SwiftExportDataGridNumberTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQtyNonPositive}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImportStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBlock Text="选择客户 * : " Margin="0,0,0,4" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold"/>
                    <custromers:CustomerAutoSuggestComboBox Width="150"
                        ItemsSource="{Binding ReferenceData.Customers}" 
                        SelectedCustomer="{Binding SelectedCustomer, Mode=TwoWay}" 
                        SelectionCommittedCommand="{Binding CustomerSelectedCommand}"
                        SelectionClearedCommand="{Binding CustomerClearedCommand}" />
                </StackPanel>
                
                <TextBlock Text=" ===>  " VerticalAlignment="Center"/>
                
                <TextBlock Text="选择映射配置 : " VerticalAlignment="Center"/>
                
                <ComboBox Width="160" IsEnabled="{Binding CanSelectReadProfile}" 
                          ItemsSource="{Binding ReadProfiles}" DisplayMemberPath="ConfigName" 
                          SelectedItem="{Binding SelectedReadProfile, Mode=TwoWay}" Margin="0,0,8,0" />

                <TextBlock Text="  ===>  " VerticalAlignment="Center"/>

                <ui:Button Content="读取单头" Command="{Binding ReadHeaderCommand}" Margin="0,0,8,0" 
                           Appearance="Primary"
                           AutomationProperties.Name="按地址配置读取 Excel 单头" />



                <ui:Button Content="检验与匹配" Command="{Binding CheckImportCommand}" Margin="0,0,8,0" />

                <ui:Button Content="保存草稿" ToolTip="需要销售订单维护权限，且当前编辑版本已通过检验" 
                           Command="{Binding SaveDraftCommand}" 
                           Appearance="Primary" Margin="0,0,8,0" />

                <ui:DropDownButton Content="更多功能" VerticalAlignment="Center" Margin="0,0,8,0" >
                    <ui:DropDownButton.Flyout>
                        <ContextMenu Style="{StaticResource  UiContextMenu}">
                            <ui:MenuItem Header="刷新读取配置" Command="{Binding RefreshReadProfilesCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="设计读取配置" Command="{Binding DesignReadProfileCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="加载基础资料 / 重试" Command="{Binding InitializeCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <Separator />
                            <ui:MenuItem Header="重试原保存请求" Command="{Binding RetrySaveCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                            <ui:MenuItem Header="开始新导入" Command="{Binding NewImportCommand}" FontSize="{DynamicResource ControlContentThemeFontSize}"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </WrapPanel>
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SubmissionMessage}" Foreground="{DynamicResource UserBusinessTextCriticalBrush}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" AutomationProperties.Name="检查与保存结果" />
                    <TextBlock Text="{Binding ParseMessage}" Style="{StaticResource ImportStatusText}" TextWrapping="Wrap" AutomationProperties.Name="Excel 解析结果" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        
        <ScrollViewer x:Name="HeaderScroll" Grid.Row="1" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImportHeaderMaxHeight}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="HeaderStackPanel">

                <ui:Card IsEnabled="{Binding IsEditable}" Margin="0,0,0,8" Padding="8">
                    <WrapPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="订单号" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Header.OrderNo}" IsReadOnly="True" PlaceholderText="新订单服务端生成" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="订单日期 *" Foreground="Red" Margin="0,0,0,4" />
                            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Header.OrderDate, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="订单交期" Margin="0,0,0,4" />
                            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Header.DeliveryDate, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,12,0">
                            <TextBlock Text="币种 *" Foreground="Red" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CurrencyOptions}" Padding="8,2,0,2" VerticalContentAlignment="Center"
                                      DisplayMemberPath="CurrencyCode" SelectedValuePath="CurrencyCode" SelectedValue="{Binding Header.Currency, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="回复日期" Margin="0,0,0,4" />
                            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Header.ReplyDate, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="付款方式" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="DataNameEn" SelectedValuePath="DataNameEn" SelectedValue="{Binding Header.PaymentMethod, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="贸易术语" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding IncotermOptions}" DisplayMemberPath="DataNameEn" SelectedValuePath="DataNameEn" SelectedValue="{Binding Header.Incoterm, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Width="260" Margin="0,0,12,0">
                            <TextBlock Grid.Column="0" Text="备注:" VerticalAlignment="Top" />
                            <ui:TextBox Grid.Column="2" FontSize="10" IsEnabled="{Binding IsEditable}" Height="40"
                                        Text="{Binding Header.Remark, UpdateSourceTrigger=PropertyChanged}" 
                                        TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                    </WrapPanel>
                </ui:Card>

                <ui:Card Grid.Row="2" IsEnabled="{Binding IsEditable}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ship-To"/>

                        <ui:TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    PlaceholderText="客户联系人..."
                                    Text="{Binding Header.ShipToName, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBox Grid.Row="4" Grid.ColumnSpan="3" 
                                    PlaceholderText="客户地址..."
                                 Text="{Binding Header.ShipToAddress, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="6" Text="Phone:" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="6" Grid.Column="2"
                                    Text="{Binding Header.ShipToPhone, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="联系方式:"/>

                        <TextBlock Grid.Row="8" Text="Terms:" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="8" Grid.Column="2" 
                                    Text="{Binding Header.IncotermSortRemark,UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="IncotermSortRemark:"
                                    TextAlignment="Left" TextWrapping="Wrap"/>

                        <TextBlock Grid.Column="4" Text="PO No" VerticalAlignment="Center" />
                        <ui:TextBox Grid.Column="6" Grid.ColumnSpan="8"
                                    PlaceholderText="客户Po号"
                                Text="{Binding Header.CustomerPoNo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="InvoiceNo * " Foreground="Red"  VerticalAlignment="Center" />
                        <ui:TextBox Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="8" 
                                    PlaceholderText="发票号" 
                                    Text="{Binding Header.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Date *:" Foreground="Red" VerticalAlignment="Center" />
                        <DatePicker Grid.Row="4" Grid.Column="6" SelectedDate="{Binding Header.OrderDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    ToolTip="发票日期"/>

                        <TextBlock Grid.Row="4" Grid.Column="8" Text="UpdateDate:" VerticalAlignment="Center" />
                        <DatePicker Grid.Row="4" Grid.Column="10" 
                                    SelectedDate="{Binding Header.InvoiceUpdateDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    ToolTip="发票更新日期"/>

                        <TextBlock Grid.Row="6" Grid.Column="4" Text="ETD:" VerticalAlignment="Center" />
                        <DatePicker SelectedDateFormat="Short" Grid.Row="6" Grid.Column="6"
                                    SelectedDate="{Binding Header.Etd, Mode=TwoWay}"
                                    ToolTip="ETD"/>

                        <TextBlock Grid.Row="6" Grid.Column="8" Text="ETA:" VerticalAlignment="Center" />
                        <DatePicker SelectedDateFormat="Short" Grid.Row="6" Grid.Column="10" Grid.ColumnSpan="6"
                                    SelectedDate="{Binding Header.Eta, Mode=TwoWay}"
                                    ToolTip="ETA"/>

                        <TextBlock Grid.Row="8" Grid.Column="4" Text="Shipped By:" VerticalAlignment="Center" />

                        <ui:TextBox Grid.Row="8" Grid.Column="6" Grid.ColumnSpan="6"
                                    PlaceholderText="ShippedBy"
                                    Text="{Binding Header.ShippedBy, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,8,0,8">
            <ui:Button Content="读取明细" Command="{Binding ReadLinesCommand}" Appearance="Primary"
                       AutomationProperties.Name="按地址配置读取 Excel 明细" Margin="0,0,8,0"
                       ToolTip="按已保存配置，从第一条数据向下读取至结束边界（包含隐藏行）。地址不能选表头；净重、毛重、体积的跨行合并合计留空提示，数量与型号等其他字段须逐行填写。" />
            
            <ui:Button Content="匹配全部 SKU" Command="{Binding MatchAllSkusCommand}" Margin="0,0,8,0" ToolTip="按客户代码匹配全部明细，保存前仍需整单检验" />


            
            <ui:Button Content="添加产品" Command="{Binding AddStandardLineCommand}" Margin="0,0,8,0" />
            <ui:Button Content="添加非标件" Command="{Binding AddNonStandardLineCommand}" Margin="0,0,8,0" />
            <ui:Button Content="删除行" Command="{Binding DeleteSelectedLineCommand}" Margin="0,0,8,0" />
            

            <ui:ToggleSwitch x:Name="ExtraFieldsSwitch" 
                             Content="显示更多字段" 
                             IsChecked="False" 
                             Margin="16,0,0,0" 
                             VerticalAlignment="Center" 
                             ToolTip="显示或隐藏次要明细字段；不清除已有数据" 
                             AutomationProperties.Name="显示更多明细字段" />
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="总数量：" /><TextBlock Text="{Binding TotalQty, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Text="总箱数：" /><TextBlock Text="{Binding TotalCartons, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Text="总毛重 (kg)：" /><TextBlock Text="{Binding TotalGrossWeight, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Text="总体积 (m³)：" /><TextBlock Text="{Binding TotalVolume, StringFormat=N3}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Text="USD：" /><TextBlock Text="{Binding TotalUsdAmount, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCnyCurrency, Converter={StaticResource ExtraFieldsVisibility}}">
                    <TextBlock Text="CNY：" /><TextBlock Text="{Binding TotalCnyAmount, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,12,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding PackingSummaryWarning}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BusyMessage}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </WrapPanel>
        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  x:Name="OrderLinesGrid" Grid.Row="3" 
                  RowHeight="{StaticResource DataGridRowHeightMedium}" 
                  Style="{StaticResource SwiftExportDataGrid}"
                  FontSize="10"
                  ItemsSource="{Binding Lines}" 
                  SelectionChanged="OnSelectionChanged" CanUserDeleteRows="False" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserSortColumns="True" 
                  IsReadOnly="{Binding IsReadOnly}" 
                  SelectionMode="Single" 
                  SelectionUnit="FullRow">
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <Ellipse Width="10" Height="10"
                             ToolTip="{Binding DataContext.CheckStatusText, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             AutomationProperties.Name="{Binding DataContext.CheckStatusText, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource UserBusinessTextCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCheckPassed, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource UserBusinessTextSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>

            <DataGrid.Columns>
 
                <DataGridTemplateColumn Header="匹配处理" Width="170" IsReadOnly="True"
                                        SortMemberPath="IsCheckPassed" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CheckStatusText}" ToolTip="{Binding MatchMessage}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Content="匹配 SKU" Padding="6,2"
                                               Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged"
                                               CommandParameter="{Binding}"
                                               Command="{Binding DataContext.MatchLineSkuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="只匹配本行；保存前仍须整单检验"
                                               AutomationProperties.Name="匹配本行 SKU" />
                                    <ToggleButton x:Name="MatchActionsEntry" Content="处理" Margin="4,0,0,0" Padding="6,2"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="查看匹配反馈、选择候选并确认型号差异"
                                                  AutomationProperties.Name="本行匹配处理" />
                                    <controls:ImportHeaderPopup x:Name="RowMatchPopup"
                                        EntryButton="{Binding ElementName=MatchActionsEntry}"
                                        PlacementTarget="{Binding ElementName=MatchActionsEntry}"
                                        IsOpen="{Binding IsChecked, ElementName=MatchActionsEntry, Mode=TwoWay}"
                                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                        Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                        Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="420" Padding="12" CornerRadius="4"
                                                Background="{DynamicResource SwiftExportBackground}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                TextElement.Foreground="{DynamicResource SwiftExportForeground}"
                                                TextElement.FontFamily="{Binding PlacementTarget.FontFamily, ElementName=RowMatchPopup}"
                                                TextElement.FontSize="{DynamicResource ControlContentThemeFontSize}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right" Content="关闭" Command="{x:Static ApplicationCommands.Close}" />
                                                    <TextBlock Text="本行匹配处理" FontWeight="Bold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CustomerSku, StringFormat='客户型号：{0}'}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding OriginalLinkSku, StringFormat='Excel 中性型号：{0}'}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LinkSku, StringFormat='系统中性型号：{0}'}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <StackPanel IsEnabled="{Binding Tag.IsEditable, ElementName=RowMatchPopup}">
                                                            <TextBlock Text="候选 SKU" />
                                                            <ComboBox ItemsSource="{Binding MatchCandidates}"
                                                                      SelectedItem="{Binding SelectedMatchCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      AutomationProperties.Name="产品匹配候选">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Sku}" />
                                                                            <TextBlock Text="{Binding LinkSku, StringFormat=' / {0}'}" />
                                                                            <TextBlock Text="{Binding IsUsable, StringFormat=' / 可用：{0}'}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ui:Button Content="应用候选（需重新匹配）" HorizontalAlignment="Left" Margin="0,8,0,8"
                                                                       Command="{Binding Tag.ChooseMatchCommand, ElementName=RowMatchPopup}"
                                                                       CommandParameter="{Binding}" />
                                                            <CheckBox Content="已核对 Excel 与系统中性型号，确认差异"
                                                                      IsChecked="{Binding AcceptLinkSkuMismatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ui:Button Content="匹配本行 SKU" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                       Loaded="OnMatchButtonLoaded" DataContextChanged="OnMatchButtonDataContextChanged"
                                                                       Command="{Binding Tag.MatchLineSkuCommand, ElementName=RowMatchPopup}"
                                                                       CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MatchMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                        <TextBlock Text="行匹配通过后，保存前仍须执行顶部整单检验。" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </controls:ImportHeaderPopup>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="非标件" Width="72" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsNonStandard, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Command="{Binding DataContext.ToggleNonStandardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" AutomationProperties.Name="非标件" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="图片" Width="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:HttpsImage SourcePath="{Binding MainImage}"
                                                 Style="{StaticResource SwiftExportImage}"
                                                 AutomationProperties.Name="产品图片" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="SKU" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sku}" Style="{StaticResource SwiftExportDataGridTextBlock}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <sales:SalesProductLookupTextBox x:Name="ProductEditor" 
                                                                 SelectedProduct="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                 ItemsSource="{Binding ProductCandidates}" 
                                                                 SearchCommand="{Binding SearchCommand}" 
                                                                 SelectionCommittedCommand="{Binding CommitProductCommand}" 
                                                                 SelectionClearedCommand="{Binding ClearProductCommand}" 
                                                                 IsBusy="{Binding IsSearchBusy}" />
                                <TextBlock x:Name="NonStandardSku" Text="{Binding Sku}" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsNonStandard}" Value="True">
                                    <Setter TargetName="ProductEditor" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="NonStandardSku" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="客户型号" Width="125" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" 
                                    Binding="{Binding CustomerSku, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="Excel中性型号" Width="150" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" 
                                    Binding="{Binding OriginalLinkSku, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="英文描述" Width="180" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" 
                                    Binding="{Binding DescriptionEn, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="英文颜色" Width="105" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridTextBox}" 
                                    Binding="{Binding ColorNameEn, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="英文配置" Width="150" 
                                    ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" 
                                    Binding="{Binding FeaturesEn, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="数量" Width="60" 
                                    ElementStyle="{StaticResource ImportQtyText}"
                                    EditingElementStyle="{StaticResource ImportQtyEditor}"
                                    Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTemplateColumn Header="单位" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UnitSnapshot}" VerticalAlignment="Center"
                                       ToolTip="标准产品单位由后端确定；本期查询未提供单位" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEnabled="{Binding IsNonStandard}" 
                                      ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                      DisplayMemberPath="DataNameEn" 
                                      SelectedValuePath="DataNameEn" 
                                      SelectedValue="{Binding UnitSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="USD单价" Width="60" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding UsdPriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTextColumn Header="CNY单价" Width="60" 
                                    Visibility="{Binding DataContext.IsCnyCurrency, Source={x:Reference HeaderStackPanel}, Converter={StaticResource ExtraFieldsVisibility}}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding CnyPriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTextColumn Header="USD金额" Width="92" IsReadOnly="True" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    Binding="{Binding UsdAmount, StringFormat=N2}" />

                <DataGridTextColumn Header="CNY金额" Width="92" IsReadOnly="True" 
                                    Visibility="{Binding DataContext.IsCnyCurrency, Source={x:Reference HeaderStackPanel}, Converter={StaticResource ExtraFieldsVisibility}}"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    Binding="{Binding CnyAmount, StringFormat=N2}" />

                <DataGridTextColumn Header="PCS/CTN" Width="85"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding PcsOfCartonText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    Header="NW/CTN" Width="85" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding NwOfCartonText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    Header="GW/CTN" Width="85" 
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding GwOfCartonText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTextColumn Header="M3/CTN" Width="85"
                                    ElementStyle="{StaticResource SwiftExportDataGridNumberTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridNumberTextBox}" 
                                    Binding="{Binding CbmOfCartonText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                <DataGridTemplateColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                        Header="预计交期" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ExpectedDeliveryDate, StringFormat=yyyy-MM-dd}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Visibility="{Binding IsChecked, Source={x:Reference ExtraFieldsSwitch}, Converter={StaticResource ExtraFieldsVisibility}}" 
                                    Header="行备注" Width="160" 
                                    ElementStyle="{StaticResource SwiftExportDataGridTextBlock}" 
                                    EditingElementStyle="{StaticResource SwiftExportDataGridWarpTextBox}" 
                                    Binding="{Binding SubNote, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="系统中性型号" Binding="{Binding LinkSku}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource SwiftExportDataGridWarpTextBlock}"/>


            </DataGrid.Columns>


        </DataGrid>

        <ScrollViewer x:Name="ValidationDetailsScroll" Grid.Row="5" MaxHeight="120"
                      Visibility="{Binding HasValidationError, Converter={StaticResource ExtraFieldsVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" AutomationProperties.Name="销售订单校验详情">

            <ui:InfoBar Title="请检查销售订单" Message="{Binding ValidationSummary}"
                        Severity="Warning" IsClosable="False" IsOpen="{Binding HasValidationError}" />

        </ScrollViewer>
    </Grid>
</UserControl>
