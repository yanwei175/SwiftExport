<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MateWpfThemes.FW.Converters">

    <conv:ImgPathToImgConverter x:Key="PathToImage"/>


    <Style x:Key="BaseImage" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Background="{DynamicResource Brush_Bck_Card}" 
                             BorderThickness="0" 
                             HasDropShadow="True" 
                             Padding="4"
                             Placement="Mouse">
                    <Image Source="{Binding MainImage, Converter={StaticResource PathToImage},IsAsync=True}"
                               Stretch="Uniform"
                               MaxWidth="500" MaxHeight="500" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>
    
    
    
</ResourceDictionary>