<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BaseScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <DockPanel x:Name="Bg" Background="Transparent" LastChildFill="True">

                        <RepeatButton x:Name="TopLeftBtn" DockPanel.Dock="Top"  Height="24"  Command="{x:Static ScrollBar.ScrollToTopCommand}" Focusable="False" BorderThickness="0">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border x:Name="BtnBg1" Background="Transparent" Cursor="Hand" Opacity="0.6">
                                        <Path x:Name="Icon" Data="M 0,0 L 10,0 L 10,2 L 0,2 Z M 5,4 L 10,9 L 0,9 Z" 
                                              Fill="{DynamicResource Brush_Txt_Secondary}" Stretch="Uniform" Width="10" Height="10"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg1" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush_Txt_Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <RepeatButton x:Name="BottomRightBtn" DockPanel.Dock="Bottom" Height="24"  Command="{x:Static ScrollBar.ScrollToBottomCommand}" Focusable="False" BorderThickness="0">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border x:Name="BtnBg2" Background="Transparent" Cursor="Hand" Opacity="0.6">
                                        <Path x:Name="Icon" Data="M 0,8 L 10,8 L 10,10 L 0,10 Z M 0,1 L 10,1 L 5,6 Z" 
                                              Fill="{DynamicResource Brush_Txt_Secondary}" Stretch="Uniform" Width="10" Height="10"                                            
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg2" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush_Txt_Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Cursor="Hand"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Cursor="Hand"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" CornerRadius="4"
                                                    Opacity="0.6"
                                                    Background="{DynamicResource Brush_Border_Strong}" 
                                                    Margin="0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Brush_Txt_Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>

                            <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>

                            <Setter TargetName="TopLeftBtn" Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="TopLeftBtn" Property="Command" Value="{x:Static ScrollBar.ScrollToLeftEndCommand}"/>
                            <Setter TargetName="TopLeftBtn" Property="Height" Value="24"/>
                            <Setter TargetName="TopLeftBtn" Property="Width" Value="NaN"/>
                            <Setter TargetName="TopLeftBtn" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90"/>
                                </Setter.Value>
                            </Setter>

                            <Setter TargetName="BottomRightBtn" Property="DockPanel.Dock" Value="Right"/>
                            <Setter TargetName="BottomRightBtn" Property="Command" Value="{x:Static ScrollBar.ScrollToRightEndCommand}"/>
                            <Setter TargetName="BottomRightBtn" Property="Height" Value="24"/>
                            <Setter TargetName="BottomRightBtn" Property="Width" Value="NaN"/>
                            <Setter TargetName="BottomRightBtn" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinHeight" Value="20"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinWidth" Value="20"/>
            </Trigger>
            
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Orientation" Value="Vertical"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="8"/>
            </MultiTrigger>
            
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Orientation" Value="Horizontal"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Height" Value="8"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource BaseScrollBar}">
    </Style>
    
    
    
</ResourceDictionary>