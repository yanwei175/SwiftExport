<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary 蓝色系 -->
    <Color x:Key="Primary1">#E8F3FF</Color>
    <Color x:Key="Primary2">#BEDAFF</Color>
    <Color x:Key="Primary3">#94C2FF</Color>
    <Color x:Key="Primary4">#6AA9FF</Color>
    <Color x:Key="Primary5">#408FFF</Color>
    <!-- 主色 -->
    <Color x:Key="Primary6">#1676FF</Color>

    <!-- 中性色 -->
    <Color x:Key="Neutral1">#FFFFFF</Color>
    <Color x:Key="Neutral2">#F7F8FA</Color>
    <Color x:Key="Neutral3">#F2F3F5</Color>
    <Color x:Key="Neutral4">#E5E6EB</Color>
    <Color x:Key="Neutral5">#C9CDD4</Color>
    <Color x:Key="Neutral6">#86909C</Color>
    <Color x:Key="Neutral7">#4E5969</Color>
    <Color x:Key="Neutral8">#272E3B</Color>

    <!-- 状态色 -->
    <Color x:Key="Success">#00B578</Color>
    <Color x:Key="Warning">#FF7D00</Color>
    <Color x:Key="Error">#F53F3F</Color>

</ResourceDictionary>
